CARGO_HOME=/cache/cargo
CARGO_BUILD_BUILD_DIR=/cache/build
CARGO_INCREMENTAL=0
CARGO_TARGET_DIR=/cache/target
CARGO_TERM_COLOR=never
CARGO_TERM_PROGRESS_WHEN=never
CODEX_HARNESS=/harness
HOME=/home/codex
GST_PLUGIN_PATH_1_0=/toolchain/voice/runtime/lib/gstreamer-1.0
GST_PLUGIN_SCANNER=/toolchain/voice/runtime/libexec/gstreamer-1.0/gst-plugin-scanner
GST_PLUGIN_SYSTEM_PATH_1_0=
GST_REGISTRY_1_0=/tmp/gstreamer-registry.bin
LANG=C.UTF-8
LC_ALL=C.UTF-8
LD_LIBRARY_PATH=/toolchain/voice/runtime/lib
PATH=/toolchain/bin:/toolchain/rust/bin:/usr/bin
PKG_CONFIG=/usr/bin/pkg-config
PKG_CONFIG_LIBDIR=/toolchain/voice/sdk/lib/pkgconfig:/usr/lib64/pkgconfig:/usr/share/pkgconfig
PKG_CONFIG_PATH=
RUSTC=/toolchain/rust/bin/rustc
RUSTC_BOOTSTRAP=1
RUSTC_WRAPPER=/toolchain/bin/sccache
RUSTFLAGS=-Zallow-features=
RUST_MIN_STACK=16777216
RUSTY_V8_ARCHIVE=/toolchain/rusty_v8/x86_64-unknown-linux-gnu/librusty_v8_ptrcomp_sandbox_release_x86_64-unknown-linux-gnu.a.gz
RUSTY_V8_SRC_BINDING_PATH=/toolchain/rusty_v8/x86_64-unknown-linux-gnu/src_binding_ptrcomp_sandbox_release_x86_64-unknown-linux-gnu.rs
SCCACHE_BASEDIR=/workspace
SCCACHE_CACHE_SIZE=40G
SCCACHE_DIR=/cache/sccache
SCCACHE_IDLE_TIMEOUT=0
SCCACHE_SERVER_UDS=/result/sccache.sock
TERM=xterm-256color
TMPDIR=/tmp
TZ=UTC
