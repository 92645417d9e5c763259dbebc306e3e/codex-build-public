+    .await?;
+
+    clear_expired_manual_pairing(&path).await?;
+    let contents: serde_json::Value = serde_json::from_slice(&tokio::fs::read(&path).await?)?;
+    assert_eq!(
+        contents,
+        serde_json::json!({"remoteControlEnabled": true, "futureSetting": 42})
+    );
+
+    tokio::fs::write(
+        &path,
+        serde_json::to_vec(&serde_json::json!({
+            "remoteControlEnabled": true,
+            "futureSetting": 42,
+            "manualPairing": {"code": "BROKEN", "expiresAt": "invalid"},
+        }))?,
+    )
+    .await?;
+    clear_expired_manual_pairing(&path).await?;
+    let contents: serde_json::Value = serde_json::from_slice(&tokio::fs::read(&path).await?)?;
+    assert_eq!(
+        contents,
+        serde_json::json!({"remoteControlEnabled": true, "futureSetting": 42})
+    );
+
+    store_manual_pairing(
+        &path,
+        "CURRENT",
+        unix_now()? + 60,
+        /*background*/ false,
+    )
+    .await?;
+    clear_manual_pairing(&path).await?;
+    let contents: serde_json::Value = serde_json::from_slice(&tokio::fs::read(&path).await?)?;
+    assert_eq!(
+        contents,
+        serde_json::json!({"remoteControlEnabled": true, "futureSetting": 42})
+    );
+    Ok(())
+}
