+++ b/codex-rs/app-server/src/request_processors/stored_thread_settings.rs
@@ -0,0 +1,373 @@
+use super::*;
+use codex_models_manager::manager::RefreshStrategy;
+use codex_thread_store::LiveThread;
+use codex_thread_store::LiveThreadInitGuard;
+use codex_thread_store::ThreadPersistenceMetadata;
+
+pub(super) struct ResumeConfigInputs {
+    pub(super) state: ResumeConfigState,
+    request_overrides: Option<HashMap<String, serde_json::Value>>,
+    typesafe_overrides: ConfigOverrides,
+    clear_reasoning_effort: bool,
+}
+
+impl ResumeConfigInputs {
+    pub(super) async fn load(
+        self,
+        manager: &ConfigManager,
+    ) -> Result<PreparedResumeConfig, JSONRPCErrorError> {
+        let mut config = manager
+            .load_for_cwd(
+                self.request_overrides,
+                self.typesafe_overrides,
+                self.state.history_cwd.clone(),
+            )
+            .await
+            .map_err(|err| config_load_error(&err))?;
+        if self.clear_reasoning_effort {
+            config.model_reasoning_effort = None;
+        }
+        Ok(PreparedResumeConfig {
+            state: self.state,
+            config,
+        })
+    }
+}
+
+impl ThreadRequestProcessor {
+    /// Unloaded model/cwd/effort edits own persistence only, never session startup.
+    /// Other requests retain the loaded-thread API and its existing validation.
+    pub(crate) async fn try_update_stored_thread_settings(
+        &self,
+        params: &ThreadSettingsUpdateParams,
+    ) -> Result<Option<ThreadSettingsUpdateResponse>, JSONRPCErrorError> {
+        if params.disabled_plugin_ids.is_some()
+            || params.approval_policy.is_some()
+            || params.approvals_reviewer.is_some()
+            || params.sandbox_policy.is_some()
+            || params.permissions.is_some()
+            || params.service_tier.is_some()
+            || params.summary.is_some()
+            || params.collaboration_mode.is_some()
+            || params.personality.is_some()
+            || (params.model.is_none() && params.cwd.is_none() && params.effort.is_none())
+        {
+            return Ok(None);
+        }
+        let thread_id = ThreadId::from_string(&params.thread_id)
+            .map_err(|err| invalid_request(format!("invalid thread id: {err}")))?;
+        if self.thread_manager.get_thread(thread_id).await.is_ok() {
+            return Ok(None);
+        }
+        let cwd = resolve_request_cwd(params.cwd.clone())?;
+        let resume_params = ThreadResumeParams {
+            thread_id: params.thread_id.clone(),
+            ..Default::default()
+        };
+        let mut prepared_config: Option<PreparedResumeConfig> = None;
+        loop {
+            let list_guard = self.acquire_thread_list_state_permit().await?;
+            let resume_guard = self.thread_state_manager.lock_goal_resume(thread_id).await;
+            if self.thread_manager.get_thread(thread_id).await.is_ok() {
+                return Ok(None);
+            }
+            if self
+                .pending_thread_unloads
+                .lock()
+                .await
+                .contains_key(&thread_id)
+            {
+                return Err(invalid_request(format!("thread {thread_id} is closing")));
+            }
+            let stored = self
+                .read_stored_thread_for_resume(&params.thread_id, None, false)
+                .await?;
+            let (mut history, stored) = self
+                .load_resume_initial_history_from_stored_thread(stored)
+                .await?;
+            if let Some((source, _)) = history.get_resumed_session_sources()
+                && !can_accept_direct_input(history.get_multi_agent_version(), &source)
+            {
+                return Err(invalid_request(
+                    super::super::thread_input::DIRECT_INPUT_TO_MULTI_AGENT_V2_SUBAGENT_ERROR,
+                ));
+            }
+            let inputs = self.resume_config_inputs(&history, &resume_params).await?;
+            let config = match prepared_config.take() {
+                Some(prepared) if prepared.state == inputs.state => prepared.config,
+                _ => {
+                    // Config loading may call the host. Recheck state after releasing both locks.
+                    drop(resume_guard);
+                    drop(list_guard);
+                    prepared_config = Some(inputs.load(&self.config_manager).await?);
+                    continue;
+                }
+            };
+            let InitialHistory::Resumed(resumed) = &history else {
+                return Err(internal_error("stored thread has no resume history"));
+            };
+            let persistence_params = codex_thread_store::ResumeThreadParams {
+                thread_id,
+                rollout_path: stored.rollout_path,
+                history: Some(Arc::clone(&resumed.history)),
+                history_revision: resumed.history_revision.clone(),
+                include_archived: true,
+                metadata: ThreadPersistenceMetadata {
+                    cwd: Some(config.cwd.to_path_buf()),
+                    model_provider: config.model_provider_id.clone(),
+                    memory_mode: if config.memories.generate_memories {
+                        codex_protocol::protocol::ThreadMemoryMode::Enabled
+                    } else {
+                        codex_protocol::protocol::ThreadMemoryMode::Disabled
+                    },
+                },
+            };
+            let mut writer = LiveThreadInitGuard::default();
+            let store = Arc::clone(&self.thread_store);
+            let (context_tx, context_rx) = oneshot::channel();
+            let live = writer
+                .acquire(async move {
+                    let (live, context) = LiveThread::resume(
+                        store,
+                        stored.history_mode,
+                        persistence_params,
+                        /*resume_preparation*/ None,
+                    )
+                    .await?;
+                    // The native guard retains acquisition and cleanup if the request is cancelled.
+                    let _ = context_tx.send(context);
+                    Ok(live)
+                })
+                .await
+                .map_err(thread_store_resume_read_error)?;
+            if let InitialHistory::Resumed(resumed) = &mut history {
+                resumed.history = context_rx
+                    .await
+                    .map_err(|_| internal_error("missing writer resume context"))?;
+                resumed.history_revision = None;
+            }
+            // Another process may have committed between configuration loading and writer acquisition.
+            if self
+                .resume_config_inputs(&history, &resume_params)
+                .await?
+                .state
+                != inputs.state
+            {
+                writer
+                    .discard()
+                    .await
+                    .map_err(thread_store_resume_read_error)?;
+                continue;
+            }
+            let models = self.thread_manager.get_models_manager();
+            let model = models
+                .get_default_model(
+                    &config.model,
+                    false,
+                    RefreshStrategy::Offline,
+                    config.http_client_factory(),
+                )
+                .await;
+            if model.trim().is_empty() {
+                return Err(invalid_request(
+                    "No models are available. Set `model` explicitly or check your model catalog configuration.",
+                ));
+            }
+            let settings = codex_core::prepare_stored_thread_settings(
+                config,
+                &history,
+                models.as_ref(),
+                model,
+                params.model.clone(),
+                params.effort.clone(),
+                cwd.clone(),
+            )
+            .await
+            .map_err(|err| invalid_request(format!("invalid thread settings override: {err}")))?;
+            let environments = self.thread_manager.default_environment_requests(
+                &settings.cwd,
+                settings
+                    .runtime_workspace_roots
+                    .as_deref()
+                    .unwrap_or_default(),
+            );
+            codex_core::validate_environment_ids_and_cwds(
+                self.thread_manager.environment_manager().as_ref(),
+                environments
+                    .iter()
+                    .map(|environment| (environment.environment_id.as_str(), &environment.cwd)),
+            )
+            .map_err(|err| invalid_request(format!("invalid thread settings override: {err}")))?;
+            live.append_items(&[RolloutItem::EventMsg(EventMsg::ThreadSettingsApplied(
+                codex_protocol::protocol::ThreadSettingsAppliedEvent {
+                    thread_id: Some(thread_id),
+                    thread_settings: settings,
+                },
+            ))])
+            .await
+            .map_err(thread_store_resume_read_error)?;
+            live.flush().await.map_err(thread_store_resume_read_error)?;
+            live.shutdown()
+                .await
+                .map_err(thread_store_resume_read_error)?;
+            writer.commit();
+            return Ok(Some(ThreadSettingsUpdateResponse {}));
+        }
+    }
+
+    pub(super) async fn resume_config_inputs(
+        &self,
+        thread_history: &InitialHistory,
+        params: &ThreadResumeParams,
+    ) -> Result<ResumeConfigInputs, JSONRPCErrorError> {
+        let ThreadResumeParams {
+            model,
+            model_provider,
+            service_tier,
+            cwd,
+            runtime_workspace_roots,
+            approval_policy,
+            approvals_reviewer,
+            sandbox,
+            permissions,
+            config: mut request_overrides,
+            base_instructions,
+            developer_instructions,
+            personality,
+            ..
+        } = params.clone();
+        // Referenced history may contain settings owned by another logical thread.
+        let history_settings = if let InitialHistory::Resumed(resumed) = thread_history {
+            resumed.history.iter().rev().find_map(|item| match item {
+                RolloutItem::EventMsg(EventMsg::ThreadSettingsApplied(event))
+                    if event.thread_id == Some(resumed.conversation_id) =>
+                {
+                    Some(&event.thread_settings)
+                }
+                _ => None,
+            })
+        } else {
+            None
+        };
+        let history_cwd = history_settings
+            .map(|settings| settings.cwd.to_path_buf())
+            .or_else(|| thread_history.session_cwd());
+        let mut runtime_workspace_roots =
+            runtime_workspace_roots.map(resolve_runtime_workspace_roots);
+        if runtime_workspace_roots.is_none() {
+            let saved_workspaces: Option<(&Path, Vec<&Path>)> = match history_settings {
+                Some(settings) => settings.runtime_workspace_roots.as_ref().map(|roots| {
+                    (
+                        settings.cwd.as_path(),
+                        roots.iter().map(AbsolutePathBuf::as_path).collect(),
+                    )
+                }),
+                None => {
+                    if let InitialHistory::Resumed(resumed) = thread_history
+                        && let Some(RolloutItem::SessionMeta(meta)) = resumed.history.first()
+                        && meta.meta.id == resumed.conversation_id
+                        && let Some(roots) = &meta.meta.runtime_workspace_roots
+                    {
+                        Some((
+                            meta.meta.cwd.as_path(),
+                            roots.iter().map(PathBuf::as_path).collect(),
+                        ))
+                    } else {
+                        None
+                    }
+                }
+            };
+            if let Some((saved_cwd, saved_roots)) = saved_workspaces {
+                let resume_cwd = resolve_request_cwd(cwd.as_ref().map(PathBuf::from))?;
+                // Retarget before validating paths recorded by another host.
+                let restored_roots = path_utils::replace_path_and_deduplicate(
+                    saved_roots,
+                    saved_cwd,
+                    resume_cwd.as_ref().map_or(saved_cwd, AbsolutePathBuf::as_path),
+                )
+                .into_iter()
+                .map(|root| {
+                    AbsolutePathBuf::from_absolute_path_checked(root).map_err(|err| {
+                        invalid_params(format!(
+                            "cannot restore workspace root `{}` on this host: {err}. Pass `runtimeWorkspaceRoots` with valid local paths or an empty list.",
+                            root.display()
+                        ))
+                    })
+                })
+                .collect::<Result<Vec<_>, _>>()?;
+                runtime_workspace_roots = Some(resolve_runtime_workspace_roots(restored_roots));
+            }
+        }
+        let mut typesafe_overrides = self.build_thread_config_overrides(
+            model,
+            model_provider,
+            service_tier,
+            cwd,
+            runtime_workspace_roots,
+            approval_policy,
+            approvals_reviewer,
+            sandbox,
+            permissions,
+            base_instructions,
+            developer_instructions,
+            personality,
+        );
+        if typesafe_overrides.approval_policy.is_none()
+            && let Some(value) = request_overrides
+                .as_mut()
+                .and_then(|overrides| overrides.remove("approval_policy"))
+        {
+            typesafe_overrides.approval_policy =
+                Some(serde_json::from_value(value).map_err(|err| {
+                    invalid_params(format!("invalid `approval_policy` config override: {err}"))
+                })?);
+        }
+        let has_explicit_model_resume_override =
+            has_model_resume_override(request_overrides.as_ref(), &typesafe_overrides);
+        typesafe_overrides.persisted_permission_profile = history_settings
+            .filter(|settings| {
+                settings.active_permission_profile.is_none()
+                    && !has_permission_override(request_overrides.as_ref(), &typesafe_overrides)
+                    && !request_overrides.as_ref().is_some_and(|overrides| {
+                        overrides.keys().any(|key| {
+                            key == "sandbox_workspace_write"
+                                || key.starts_with("sandbox_workspace_write.")
+                        })
+                    })
+            })
+            .map(|settings| settings.permission_profile.clone());
+        let mut persisted_settings = match thread_history {
+            InitialHistory::Resumed(resumed) => latest_persisted_resume_settings(&resumed.history),
+            InitialHistory::New | InitialHistory::Cleared | InitialHistory::Forked(_) => None,
+        };
+        if let (Some(settings), Some(snapshot)) = (&mut persisted_settings, history_settings) {
+            settings.active_permission_profile = snapshot.active_permission_profile.clone();
+        }
+        let persisted_metadata = self
+            .load_and_apply_persisted_resume_metadata(
+                thread_history,
+                persisted_settings.as_ref(),
+                &mut request_overrides,
+                &mut typesafe_overrides,
+            )
+            .await;
+        let clear_reasoning_effort = !has_explicit_model_resume_override
+            && persisted_metadata
+                .as_ref()
+                .is_some_and(|metadata| metadata.reasoning_effort.is_none());
+        Ok(ResumeConfigInputs {
+            state: ResumeConfigState {
+                history_cwd,
+                workspace_roots: typesafe_overrides.workspace_roots.clone(),
+                persisted_metadata,
+                persisted_settings,
+                persisted_permission_profile: typesafe_overrides
+                    .persisted_permission_profile
+                    .clone(),
+            },
+            request_overrides,
+            typesafe_overrides,
+            clear_reasoning_effort,
+        })
+    }
+}
