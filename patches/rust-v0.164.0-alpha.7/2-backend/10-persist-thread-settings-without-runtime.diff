+//! Prepare a durable settings checkpoint without creating a session or its services.
+
+use super::step_settings::StepSettings;
+use super::step_settings::StepSettingsConstraints;
+use super::step_settings::StepSettingsUpdate;
+use crate::config::Config;
+use crate::config::ConstraintResult;
+use crate::path_utils;
+use codex_features::Feature;
+use codex_history::InitialHistory;
+use codex_history::RolloutItem;
+use codex_models_manager::manager::ModelsManager;
+use codex_protocol::config_types::CollaborationMode;
+use codex_protocol::config_types::ModeKind;
+use codex_protocol::config_types::Settings;
+use codex_protocol::openai_models::ReasoningEffort;
+use codex_protocol::protocol::EventMsg;
+use codex_protocol::protocol::ThreadSettingsSnapshot;
+use codex_utils_absolute_path::AbsolutePathBuf;
+
+/// Applies model, effort and cwd changes to resolved stored-thread configuration.
+/// The caller owns the thread's writer and supplies its authoritative replay context.
+pub async fn prepare_stored_thread_settings(
+    mut config: Config,
+    history: &InitialHistory,
+    models_manager: &dyn ModelsManager,
+    model: String,
+    model_override: Option<String>,
+    effort: Option<ReasoningEffort>,
+    cwd: Option<AbsolutePathBuf>,
+) -> ConstraintResult<ThreadSettingsSnapshot> {
+    let items = history.get_rollout_items();
+    let owner = match history {
+        InitialHistory::Resumed(resumed) => Some(resumed.conversation_id),
+        InitialHistory::New | InitialHistory::Cleared | InitialHistory::Forked(_) => None,
+    };
+    let saved = items.iter().rev().find_map(|item| match item {
+        RolloutItem::EventMsg(EventMsg::ThreadSettingsApplied(event))
+            if event.thread_id == owner =>
+        {
+            Some(&event.thread_settings)
+        }
+        _ => None,
+    });
+    let collaboration_mode = saved
+        .map(|settings| settings.collaboration_mode.clone())
+        .or_else(|| {
+            items.iter().rev().find_map(|item| match item {
+                RolloutItem::TurnContext(context) => context.collaboration_mode.clone(),
+                _ => None,
+            })
+        })
+        .unwrap_or(CollaborationMode {
+            mode: ModeKind::Default,
+            settings: Settings {
+                model: model.clone(),
+                reasoning_effort: config.model_reasoning_effort.clone(),
+                developer_instructions: None,
+            },
+        })
+        .with_updates(
+            Some(model.clone()),
+            Some(config.model_reasoning_effort.clone()),
+            None,
+        );
+    let model_info = models_manager
+        .get_model_info(&model, &config.to_models_manager_config())
+        .await;
+    let selected = StepSettings {
+        collaboration_mode,
+        reasoning_summary: config.model_reasoning_summary,
+        service_tier: super::get_service_tier(
+            config.service_tier.clone(),
+            &config.features,
+            &model_info,
+        ),
+        personality: config.personality,
+        approval_policy: config.permissions.approval_policy.clone(),
+        approvals_reviewer: config.approvals_reviewer,
+    };
+    let cwd = cwd.unwrap_or_else(|| config.cwd.clone());
+    config.workspace_roots = path_utils::replace_path_and_deduplicate(
+        config.workspace_roots,
+        config.cwd.as_path(),
+        cwd.clone(),
+    );
+    config.cwd = cwd;
+    let permission_profile = config
+        .permissions
+        .permission_profile()
+        .clone()
+        .materialize_project_roots_with_path_uris(&config.effective_workspace_roots());
+    let selected = selected.apply(
+        &StepSettingsUpdate {
+            model: model_override,
+            effort: effort.map(Some),
+            ..Default::default()
+        },
+        &StepSettingsConstraints {
+            requirements: config.config_layer_stack.requirements(),
+            guardian_approval_enabled: config.features.enabled(Feature::GuardianApproval),
+            trusted_guardian_reviewer: false,
+            has_full_disk_write_access: permission_profile
+                .file_system_sandbox_policy()
+                .has_full_disk_write_access(),
+        },
+    )?;
+    Ok(ThreadSettingsSnapshot {
+        model: selected.collaboration_mode.model().to_owned(),
+        model_provider_id: config.model_provider_id,
+        service_tier: selected.service_tier,
+        approval_policy: selected.approval_policy.value(),
+        approvals_reviewer: selected.approvals_reviewer,
+        permission_profile,
+        active_permission_profile: config.permissions.active_permission_profile(),
+        cwd: config.cwd,
+        runtime_workspace_roots: Some(config.workspace_roots),
+        reasoning_effort: selected.collaboration_mode.reasoning_effort(),
+        reasoning_summary: selected.reasoning_summary,
+        personality: selected.personality,
+        collaboration_mode: selected.collaboration_mode,
+        disabled_plugin_ids: owner
+            .and_then(|id| codex_history::latest_disabled_plugin_ids(items, id))
+            .map(<[String]>::to_vec)
+            .unwrap_or_default(),
+    })
+}
