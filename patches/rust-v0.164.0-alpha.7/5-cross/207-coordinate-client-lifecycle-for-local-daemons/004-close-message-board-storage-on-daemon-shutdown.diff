diff --git a/codex-rs/ext/agent-message-board/src/local/pool.rs b/codex-rs/ext/agent-message-board/src/local/pool.rs
--- a/codex-rs/ext/agent-message-board/src/local/pool.rs
+++ b/codex-rs/ext/agent-message-board/src/local/pool.rs
@@ -20,6 +20,24 @@ pub(super) const DATABASE_FILE: &str = "agent_message_board_1.sqlite";
 pub(super) static POOLS: LazyLock<Mutex<HashMap<PathBuf, Weak<SqlitePool>>>> =
     LazyLock::new(Mutex::default);
 
+/// Retain the initialized local pool before the host releases its thread handles.
+/// After stopping board producers, the host must await `close` on this pool.
+/// This does not open a database or change other homes' pools.
+pub async fn local_message_board_pool_for_shutdown(
+    sqlite: &SqliteConfig,
+) -> Result<Option<Arc<SqlitePool>>> {
+    let home = match tokio::fs::canonicalize(sqlite.home()).await {
+        Ok(home) => home,
+        Err(error) if error.kind() == std::io::ErrorKind::NotFound => return Ok(None),
+        Err(error) => return Err(error.into()),
+    };
+    Ok(POOLS
+        .lock()
+        .await
+        .get(&home.join(DATABASE_FILE))
+        .and_then(Weak::upgrade))
+}
+
