+const BUSY_RETRY_DELAYS: [Duration; 2] = [Duration::from_millis(100), Duration::from_millis(200)];
+
+/// Apply the shared admission retry budget to an already-acquired connection.
+/// The zero-based retry index advances only after a received BUSY error. Retry
+/// only BEGIN IMMEDIATE, before any transaction body or external effects.
+pub fn sqlite_busy_retry_delay(error: &sqlx::Error, retry_index: usize) -> Option<Duration> {
+    BUSY_RETRY_DELAYS
+        .get(retry_index)
+        .copied()
+        .filter(|_| is_busy(error))
+}
+
