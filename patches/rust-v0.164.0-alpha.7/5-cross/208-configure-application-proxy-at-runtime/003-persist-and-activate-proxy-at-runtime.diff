+use std::process::Command;
+use std::time::Duration;
+
+use codex_http_client::HttpClientFactory;
+use codex_http_client::OutboundProxyPolicy;
+use codex_http_client::RuntimeProxyConfig;
+use codex_http_client::RuntimeProxyDefinition;
+use codex_http_client::runtime_proxy_generation;
+use codex_http_client::set_runtime_proxy_config;
+use futures::SinkExt;
+use futures::StreamExt;
+use pretty_assertions::assert_eq;
+use tokio::io::AsyncReadExt;
+use tokio::io::AsyncWriteExt;
+use tokio::net::TcpListener;
+use tokio::time::timeout;
+use tokio_tungstenite::accept_async;
+use tokio_tungstenite::tungstenite::Message;
+use tokio_tungstenite::tungstenite::client::IntoClientRequest;
+use tokio_tungstenite::tungstenite::protocol::WebSocketConfig;
+
+use crate::WebSocketConnector;
+
+#[test]
+fn runtime_proxy_connects_websockets_and_preserves_local_direct_connections() {
+    let output = Command::new(std::env::current_exe().expect("test executable"))
+        .args([
+            "--exact",
+            "runtime_proxy_tests::runtime_proxy_websocket_probe",
+            "--nocapture",
+        ])
+        .env("CODEX_TEST_WEBSOCKET_RUNTIME_PROXY", "1")
+        .output()
+        .expect("isolated proxy test");
+    assert!(
+        output.status.success(),
+        "{}\n{}",
+        String::from_utf8_lossy(&output.stdout),
+        String::from_utf8_lossy(&output.stderr)
+    );
+}
+
+#[tokio::test]
+async fn runtime_proxy_websocket_probe() {
+    if std::env::var_os("CODEX_TEST_WEBSOCKET_RUNTIME_PROXY").is_none() {
+        return;
+    }
+    timeout(Duration::from_secs(10), async {
+        let factory = HttpClientFactory::new(OutboundProxyPolicy::ReqwestDefault);
+        let connector = WebSocketConnector::new(&factory).expect("connector");
+        for message in ["first", "second"] {
+            let proxy = TcpListener::bind("127.0.0.1:0").await.expect("proxy");
+            let config = RuntimeProxyConfig {
+                enabled: true,
+                selected: Some("lan".to_string()),
+                entries: vec![RuntimeProxyDefinition {
+                    alias: "lan".to_string(),
+                    url: format!("http://{}", proxy.local_addr().expect("proxy address")),
+                }],
+            };
+            let selected = set_runtime_proxy_config(config).expect("select proxy");
+            let server = tokio::spawn(async move {
+                let (mut socket, _) = proxy.accept().await.expect("CONNECT request");
+                let mut header = Vec::new();
+                while !header.ends_with(b"\r\n\r\n") {
+                    assert!(header.len() < 8192);
+                    header.push(socket.read_u8().await.expect("CONNECT header"));
+                }
+                assert!(
+                    String::from_utf8(header)
+                        .expect("header text")
+                        .starts_with("CONNECT origin.invalid:80 HTTP/1.1\r\n")
+                );
+                socket
+                    .write_all(b"HTTP/1.1 200 Connection Established\r\n\r\n")
+                    .await
+                    .expect("tunnel");
+                let mut websocket = accept_async(socket).await.expect("WebSocket handshake");
+                websocket
+                    .send(Message::Text(message.into()))
+                    .await
+                    .expect("payload");
+            });
+            let request = "ws://origin.invalid/responses"
+                .into_client_request()
+                .expect("request");
+            let (mut websocket, _) = connector
+                .connect(request, WebSocketConfig::default())
+                .await
+                .expect("proxied WebSocket");
+            assert_eq!(websocket.runtime_proxy_generation(), selected.generation);
+            assert_eq!(
+                websocket.next().await.expect("frame").expect("message"),
+                Message::Text(message.into())
+            );
+            server.await.expect("proxy finished");
+        }
+        for bind_address in ["127.0.0.1:0", "[::1]:0"] {
+            let local = TcpListener::bind(bind_address)
+                .await
+                .expect("local service");
+            let request = format!("ws://{}/local", local.local_addr().expect("address"))
+                .into_client_request()
+                .expect("request");
+            let service = tokio::spawn(async move {
+                let (socket, _) = local.accept().await.expect("local connection");
+                let mut websocket = accept_async(socket).await.expect("handshake");
+                websocket
+                    .send(Message::Text("bypassed".into()))
+                    .await
+                    .expect("payload");
+            });
+            let (mut websocket, _) = connector
+                .connect(request, WebSocketConfig::default())
+                .await
+                .expect("reserved destination bypasses selected proxy");
+            assert_eq!(
+                websocket.next().await.expect("frame").expect("message"),
+                Message::Text("bypassed".into())
+            );
+            service.await.expect("local service finished");
+        }
+        // An explicit local connection remains direct even with an application proxy selected.
+        let local = TcpListener::bind("127.0.0.1:0")
+            .await
+            .expect("local service");
+        let request = format!("ws://{}/local", local.local_addr().expect("local address"))
+            .into_client_request()
+            .expect("local request");
+        let service = tokio::spawn(async move {
+            let (socket, _) = local.accept().await.expect("local connection");
+            let mut websocket = accept_async(socket).await.expect("local handshake");
+            websocket
+                .send(Message::Text("local".into()))
+                .await
+                .expect("local payload");
+        });
+        let (mut websocket, _) = connector
+            .connect_loopback_direct(request, WebSocketConfig::default())
+            .await
+            .expect("local direct connection");
+        let generation = websocket.runtime_proxy_generation();
+        assert_eq!(
+            websocket
+                .next()
+                .await
+                .expect("local frame")
+                .expect("local message"),
+            Message::Text("local".into())
+        );
+        set_runtime_proxy_config(RuntimeProxyConfig::default()).expect("disable");
+        assert!(runtime_proxy_generation() > generation);
+        assert_eq!(websocket.runtime_proxy_generation(), generation);
+        service.await.expect("local service finished");
+    })
+    .await
+    .expect("bounded WebSocket test");
+}
