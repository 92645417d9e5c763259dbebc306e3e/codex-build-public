new file mode 100644
--- /dev/null
+++ b/codex-rs/app-server/src/request_processors/proxy_processor.rs
@@ -0,0 +1,186 @@
+use std::io;
+use std::sync::Arc;
+
+use codex_app_server_protocol::JSONRPCErrorError;
+use codex_app_server_protocol::ProxyConfig;
+use codex_app_server_protocol::ProxyDefinition;
+use codex_app_server_protocol::ProxyReadResponse;
+use codex_app_server_protocol::ProxyUpdatedNotification;
+use codex_app_server_protocol::ProxyWriteParams;
+use codex_app_server_protocol::ProxyWriteResponse;
+use codex_app_server_protocol::ServerNotification;
+use codex_http_client::RuntimeProxyConfig;
+use codex_http_client::RuntimeProxyDefinition;
+use codex_http_client::RuntimeProxySnapshot;
+use codex_http_client::runtime_proxy_generation;
+use codex_http_client::runtime_proxy_snapshot;
+use codex_http_client::set_runtime_proxy_config;
+use codex_http_client::validate_runtime_proxy_config;
+use url::Url;
+
+use crate::error_code::internal_error;
+use crate::error_code::invalid_params;
+use crate::integrations::IntegrationsStore;
+use crate::outgoing_message::OutgoingMessageSender;
+
+/// Load before authentication, cloud configuration, or remote-control startup can send requests.
+pub(crate) fn initialize_runtime_proxy(integrations: &IntegrationsStore) -> io::Result<()> {
+    set_runtime_proxy_config(runtime_config(integrations.proxy()))
+        .map(|_| ())
+        .map_err(|error| {
+            io::Error::new(
+                error.kind(),
+                format!("invalid integrations.json proxy: {error}"),
+            )
+        })
+}
+
+pub(crate) struct ProxyProcessor {
+    integrations: Arc<IntegrationsStore>,
+    outgoing: Arc<OutgoingMessageSender>,
+}
+
+impl ProxyProcessor {
+    pub(crate) fn new(
+        integrations: Arc<IntegrationsStore>,
+        outgoing: Arc<OutgoingMessageSender>,
+    ) -> Self {
+        Self {
+            integrations,
+            outgoing,
+        }
+    }
+
+    pub(crate) fn read(&self) -> ProxyReadResponse {
+        response_from_snapshot(runtime_proxy_snapshot())
+    }
+
+    pub(crate) async fn write(
+        &self,
+        params: ProxyWriteParams,
+    ) -> Result<ProxyWriteResponse, JSONRPCErrorError> {
+        let config = validate_runtime_proxy_config(runtime_config(params.config))
+            .map_err(|error| invalid_params(error.to_string()))?;
+        self.integrations
+            .set_proxy(protocol_config(config.clone()))
+            .await
+            .map_err(|error| {
+                internal_error(format!("failed to write integrations.json: {error}"))
+            })?;
+        let previous_generation = runtime_proxy_generation();
+        let snapshot =
+            set_runtime_proxy_config(config).map_err(|error| internal_error(error.to_string()))?;
+        let response = response_from_snapshot(snapshot);
+        if response.generation != previous_generation {
+            self.outgoing
+                .send_server_notification(ServerNotification::ProxyUpdated(
+                    ProxyUpdatedNotification {
+                        generation: response.generation,
+                        active_alias: response.active_alias.clone(),
+                        active_address: response.active_address.clone(),
+                    },
+                ))
+                .await;
+        }
+        Ok(ProxyWriteResponse {
+            config: response.config,
+            generation: response.generation,
+            active_alias: response.active_alias,
+            active_address: response.active_address,
+        })
+    }
+}
+
+fn runtime_config(config: ProxyConfig) -> RuntimeProxyConfig {
+    RuntimeProxyConfig {
+        enabled: config.enabled,
+        selected: config.selected,
+        entries: config
+            .entries
+            .into_iter()
+            .map(|proxy| RuntimeProxyDefinition {
+                alias: proxy.alias,
+                url: proxy.url,
+            })
+            .collect(),
+    }
+}
+
+fn protocol_config(config: RuntimeProxyConfig) -> ProxyConfig {
+    ProxyConfig {
+        enabled: config.enabled,
+        selected: config.selected,
+        entries: config
+            .entries
+            .into_iter()
+            .map(|proxy| ProxyDefinition {
+                alias: proxy.alias,
+                url: proxy.url,
+            })
+            .collect(),
+    }
+}
+
+fn response_from_snapshot(snapshot: RuntimeProxySnapshot) -> ProxyReadResponse {
+    let config = snapshot.config;
+    let active_alias = config.active_alias().map(str::to_owned);
+    let active_address = active_alias.as_ref().map(|alias| {
+        let proxy = config
+            .entries
+            .iter()
+            .find(|entry| &entry.alias == alias)
+            .expect("validated active proxy");
+        let url = Url::parse(&proxy.url).expect("validated proxy origin");
+        format!(
+            "{}:{}",
+            url.host().expect("proxy host"),
+            url.port_or_known_default().expect("HTTP(S) proxy port")
+        )
+    });
+    ProxyReadResponse {
+        config: protocol_config(config),
+        generation: snapshot.generation,
+        active_alias,
+        active_address,
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use pretty_assertions::assert_eq;
+
+    #[test]
+    fn proxy_observations_show_host_and_port_without_credentials() {
+        for (url, address) in [
+            ("https://user:secret@proxy.test:8443", "proxy.test:8443"),
+            ("http://user:secret@proxy.test", "proxy.test:80"),
+            ("https://user:secret@[::1]", "[::1]:443"),
+        ] {
+            let config = validate_runtime_proxy_config(RuntimeProxyConfig {
+                enabled: true,
+                selected: Some("lan".into()),
+                entries: vec![RuntimeProxyDefinition {
+                    alias: "lan".into(),
+                    url: url.into(),
+                }],
+            })
+            .unwrap();
+            let enabled = response_from_snapshot(RuntimeProxySnapshot {
+                config: config.clone(),
+                generation: 1,
+            });
+            assert_eq!(enabled.active_alias.as_deref(), Some("lan"));
+            assert_eq!(enabled.active_address.as_deref(), Some(address));
+            let disabled = response_from_snapshot(RuntimeProxySnapshot {
+                config: RuntimeProxyConfig {
+                    enabled: false,
+                    ..config
+                },
+                generation: 2,
+            });
+            assert_eq!(disabled.active_alias, None);
+            assert_eq!(disabled.active_address, None);
+        }
+    }
+}
