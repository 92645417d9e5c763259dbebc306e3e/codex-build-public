@@ -0,0 +1,248 @@
+use std::os::unix::fs::PermissionsExt;
+use std::time::Duration;
+
+use anyhow::Result;
+use app_test_support::ChatGptAuthFixture;
+use app_test_support::TestAppServer;
+use app_test_support::write_chatgpt_auth;
+use codex_app_server_protocol::ProxyConfig;
+use codex_app_server_protocol::ProxyDefinition;
+use codex_app_server_protocol::ProxyReadResponse;
+use codex_app_server_protocol::ProxyUpdatedNotification;
+use codex_app_server_protocol::ProxyWriteResponse;
+use codex_app_server_protocol::RequestId;
+use codex_config::types::AuthCredentialsStoreMode;
+use pretty_assertions::assert_eq;
+use serde_json::json;
+use tempfile::TempDir;
+use tokio::time::timeout;
+use wiremock::Mock;
+use wiremock::MockServer;
+use wiremock::ResponseTemplate;
+use wiremock::matchers::method;
+use wiremock::matchers::path;
+
+const READ_TIMEOUT: Duration = Duration::from_secs(30);
+
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn startup_and_proxy_rpc_use_persisted_global_routing() -> Result<()> {
+    let proxy = MockServer::start().await;
+    let bundle_path = "/backend-api/wham/config/bundle";
+    Mock::given(method("GET"))
+        .and(path(bundle_path))
+        .respond_with(ResponseTemplate::new(200).set_body_json(json!({})))
+        .expect(1..)
+        .mount(&proxy)
+        .await;
+    let home = TempDir::new()?;
+    let path = home.path().join("integrations.json");
+    write_chatgpt_auth(
+        home.path(),
+        ChatGptAuthFixture::new("proxy-test-token")
+            .account_id("proxy-account")
+            .plan_type("enterprise"),
+        AuthCredentialsStoreMode::File,
+    )?;
+    let config = ProxyConfig {
+        enabled: true,
+        selected: Some("lan".to_string()),
+        entries: vec![ProxyDefinition {
+            alias: "lan".to_string(),
+            url: proxy.uri(),
+        }],
+    };
+    std::fs::write(
+        home.path().join("config.toml"),
+        "chatgpt_base_url = 'http://origin.invalid/backend-api/'\ncli_auth_credentials_store = 'file'\n",
+    )?;
+    let telegram = json!({
+        "bot_token": "test-bot-token", "chat_id": "123", "notifications": [],
+        "completion_min_duration_ms": 30_000,
+    });
+    std::fs::write(
+        &path,
+        serde_json::to_vec_pretty(&json!({"proxy": config, "telegram": telegram}))?,
+    )?;
+    let mut app = TestAppServer::builder()
+        .with_codex_home(home.path())
+        .with_env_overrides(&[("OPENAI_API_KEY", None), ("CODEX_API_KEY", None)])
+        .build_initialized_with_timeout(READ_TIMEOUT)
+        .await?;
+    assert!(
+        proxy
+            .received_requests()
+            .await
+            .expect("requests")
+            .iter()
+            .any(|request| request.url.path() == bundle_path)
+    );
+    let id = app.send_request("proxy/read", None).await?;
+    let initial: ProxyReadResponse = timeout(READ_TIMEOUT, app.read_response(id)).await??;
+    assert_eq!(initial.config, config);
+    assert_eq!(initial.active_alias.as_deref(), Some("lan"));
+    let address = proxy.address().to_string();
+    assert_eq!(initial.active_address.as_deref(), Some(address.as_str()));
+
+    let mut updated = config.clone();
+    updated.entries[0].alias = "stable-lan".to_string();
+    updated.selected = Some("stable-lan".to_string());
+    let id = app
+        .send_request("proxy/write", Some(json!({"config": updated})))
+        .await?;
+    let notification: ProxyUpdatedNotification =
+        timeout(READ_TIMEOUT, app.read_notification("proxy/updated")).await??;
+    let written: ProxyWriteResponse = timeout(READ_TIMEOUT, app.read_response(id)).await??;
+    assert_eq!(written.config, updated);
+    assert_eq!(
+        notification,
+        ProxyUpdatedNotification {
+            generation: written.generation,
+            active_alias: Some("stable-lan".to_string()),
+            active_address: Some(address.clone()),
+        }
+    );
+    assert!(written.generation > initial.generation);
+    let persisted = std::fs::read_to_string(&path)?;
+    let document: serde_json::Value = serde_json::from_str(&persisted)?;
+    assert_eq!(
+        serde_json::from_value::<ProxyConfig>(document["proxy"].clone())?,
+        updated
+    );
+    assert_eq!(document["telegram"], telegram);
+    assert_eq!(written.active_address.as_deref(), Some(address.as_str()));
+    assert_eq!(
+        std::fs::metadata(&path)?.permissions().mode() & 0o777,
+        0o600
+    );
+
+    let mut invalid = updated.clone();
+    invalid.selected = Some("absent".to_string());
+    let id = app
+        .send_request("proxy/write", Some(json!({"config": invalid})))
+        .await?;
+    let error = timeout(
+        READ_TIMEOUT,
+        app.read_stream_until_error_message(RequestId::Integer(id)),
+    )
