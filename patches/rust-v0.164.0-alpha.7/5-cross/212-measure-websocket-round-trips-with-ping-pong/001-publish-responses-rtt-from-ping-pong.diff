+#[tokio::test]
+async fn websocket_rtt_stops_on_plan_or_owner_change() {
+    let home = TempDir::new().unwrap();
+    let initial = rtt_chatgpt_auth("plus");
+    let token = initial.get_token().unwrap();
+    let manager = AuthManager::from_auth_for_testing_with_home(initial, home.path().to_path_buf());
+    let (sender, receiver) = async_channel::bounded(1);
+    let telemetry = ApiTelemetry::new(
+        test_session_telemetry(),
+        AuthRequestTelemetryContext::default(),
+        RequestRouteTelemetry::for_endpoint("/responses"),
+        AuthEnvTelemetry::default(),
+    )
+    .with_responses_stream_connection_status(ResponsesStreamConnectionStatusSink::new(
+        ThreadId::new(),
+        Some(sender),
+        Some(&manager),
+        Some(0),
+    ));
+    for (account, plan, expected) in [
+        ("rtt-account", "business", false),
+        ("rtt-account", "pro", true),
+        ("replacement-account", "plus", false),
+    ] {
+        codex_login::auth::login_with_chatgpt_auth_tokens(home.path(), &token, account, Some(plan))
+            .unwrap();
+        // Reload retains the auth mode while refreshing its credentials and owner revision.
+        assert!(!manager.reload().await);
