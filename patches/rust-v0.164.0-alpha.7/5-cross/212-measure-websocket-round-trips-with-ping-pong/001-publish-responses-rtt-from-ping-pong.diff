+fn notify_ws_disconnected(
+    telemetry: &Option<Arc<dyn WebsocketTelemetry>>,
+    disconnected: &AtomicBool,
+) {
+    if !disconnected.swap(true, Ordering::AcqRel)
+        && let Some(telemetry) = telemetry.as_ref()
+    {
+        telemetry.on_ws_disconnected();
+    }
