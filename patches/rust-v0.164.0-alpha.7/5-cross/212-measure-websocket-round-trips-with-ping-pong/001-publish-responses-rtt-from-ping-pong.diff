+struct ResponsesStreamConnectionStatusSink {
+    thread_id: ThreadId,
+    event_sender: Sender<ProtocolEvent>,
+    auth_manager: Weak<AuthManager>,
+    auth_owner_generation: u64,
+}
+
+impl ResponsesStreamConnectionStatusSink {
+    fn new(
+        thread_id: ThreadId,
+        event_sender: Option<Sender<ProtocolEvent>>,
+        auth_manager: Option<&Arc<AuthManager>>,
+        auth_owner_generation: Option<u64>,
+    ) -> Option<Self> {
+        Some(Self {
+            thread_id,
+            event_sender: event_sender?,
+            auth_manager: Arc::downgrade(auth_manager?),
+            auth_owner_generation: auth_owner_generation?,
+        })
+    }
+
+    fn is_current_personal_account(&self) -> bool {
+        let Some(manager) = self.auth_manager.upgrade() else {
+            return false;
+        };
+        let auth = manager.auth_cached();
+        manager
+            .auth_change_state_receiver()
+            .borrow()
+            .owner_generation
+            == self.auth_owner_generation
+            && auth.is_some_and(|auth| {
+                auth.is_chatgpt_auth()
+                    && matches!(
+                        auth.account_plan_type(),
+                        Some(PlanType::Plus | PlanType::Pro | PlanType::ProLite)
+                    )
+            })
+    }
 }
 
