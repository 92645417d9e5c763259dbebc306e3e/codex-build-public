+#[tokio::test]
+async fn chatgpt_websocket_rtt_publishes_connection_status() {
+    let manager = AuthManager::from_auth_for_testing(rtt_chatgpt_auth("plus"));
+    let thread_id = ThreadId::new();
+    let (sender, receiver) = async_channel::bounded(2);
+    let auth_context = AuthRequestTelemetryContext::new(
+        Some(AuthMode::Chatgpt),
+        &BearerAuthProvider::for_test(Some("access-token"), Some("account-123")),
+        /*agent_identity_telemetry*/ None,
+        PendingUnauthorizedRetry::default(),
+    );
+    let telemetry = ApiTelemetry::new(
+        test_session_telemetry(),
+        auth_context,
+        RequestRouteTelemetry::for_endpoint("/responses"),
+        AuthEnvTelemetry::default(),
+    )
+    .with_responses_stream_connection_status(ResponsesStreamConnectionStatusSink::new(
+        thread_id,
+        Some(sender),
+        Some(&manager),
+        Some(0),
+    ));
+
+    assert!(telemetry.should_measure_ws_rtt());
+    telemetry.on_ws_ping_rtt(Duration::from_millis(42));
+    let event = receiver.recv().await.expect("connected event");
+    let EventMsg::ResponsesStreamConnectionStatus(connected) = event.msg else {
+        panic!("expected Responses WebSocket status");
+    };
+    assert_eq!(connected.thread_id, thread_id);
+    assert!(connected.connected);
+    assert_eq!(connected.rtt_ms, Some(42));
+
+    telemetry.on_ws_disconnected();
+    let event = receiver.recv().await.expect("disconnected event");
+    let EventMsg::ResponsesStreamConnectionStatus(disconnected) = event.msg else {
+        panic!("expected Responses WebSocket status");
+    };
+    assert!(!disconnected.connected);
+    assert_eq!(disconnected.rtt_ms, None);
+}
