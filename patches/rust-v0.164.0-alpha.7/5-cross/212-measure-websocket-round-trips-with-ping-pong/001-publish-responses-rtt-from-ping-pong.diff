+fn take_matching_ping_rtt(
+    pending_ping: &mut Option<([u8; 8], Instant)>,
+    payload: &[u8],
+) -> Option<Duration> {
+    if !pending_ping
+        .as_ref()
+        .is_some_and(|(pending_payload, _)| pending_payload.as_slice() == payload)
+    {
+        return None;
+    }
+    pending_ping.take().map(|(_, sent_at)| sent_at.elapsed())
+}
