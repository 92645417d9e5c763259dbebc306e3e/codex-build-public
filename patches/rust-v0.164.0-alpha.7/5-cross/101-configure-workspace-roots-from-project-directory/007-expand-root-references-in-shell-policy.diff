@@ -0,0 +1,152 @@
+use codex_protocol::config_types::ShellEnvironmentPolicy;
+use std::io;
+
+/// Expands a local execution snapshot, leaving the configured templates reusable for another cwd.
+pub(crate) fn expand_published_root_references(
+    policy: &mut ShellEnvironmentPolicy,
+) -> io::Result<()> {
+    for value in policy.r#set.values_mut() {
+        *value = expand_value(value, &mut |name| {
+            if matches!(name, "CODEX_HOME" | "CODEX_HARNESS" | "TMPDIR") {
+                return match std::env::var(name) {
+                    Ok(value) if !value.is_empty() => Ok(value),
+                    Ok(_) | Err(std::env::VarError::NotPresent) => Err(io::Error::new(
+                        io::ErrorKind::InvalidInput,
+                        format!("published root environment variable {name} is missing or empty"),
+                    )),
+                    Err(std::env::VarError::NotUnicode(_)) => Err(io::Error::new(
+                        io::ErrorKind::InvalidInput,
+                        format!("published root environment variable {name} is not valid UTF-8"),
+                    )),
+                };
+            }
+            policy
+                .inherited_environment
+                .get(name)
+                .cloned()
+                .ok_or_else(|| {
+                    io::Error::new(
+                        io::ErrorKind::InvalidInput,
+                        format!("project root environment variable {name} was not prepared"),
+                    )
+                })
+        })?;
+    }
+    Ok(())
+}
+
+fn expand_value(
+    input: &str,
+    variable: &mut impl FnMut(&str) -> io::Result<String>,
+) -> io::Result<String> {
+    let bytes = input.as_bytes();
+    let mut output = String::with_capacity(input.len());
+    let mut copied_until = 0;
+    let mut index = 0;
+    while index < bytes.len() {
+        if bytes[index] != b'$'
+            || bytes
+                .get(index + 1)
+                .copied()
+                .is_none_or(|byte| !is_variable_start(byte))
+        {
+            index += 1;
+            continue;
+        }
+        let start = index + 1;
+        let mut end = start + 1;
+        while bytes.get(end).copied().is_some_and(is_variable_continue) {
+            end += 1;
+        }
+        let name = &input[start..end];
+        if !matches!(
+            name,
+            "CODEX_HOME"
+                | "CODEX_HARNESS"
+                | "TMPDIR"
+                | "PROJECT_SCRATCH_ROOT"
+                | "PROJECT_RUNTIME_ROOT"
+                | "PROJECT_PERSISTENT_ROOT"
+                | "REPOS_ROOT"
+                | "SKILLS_ROOT"
+                | "SKILLS_SCRATCH_ROOT"
+        ) {
+            return Err(io::Error::new(
+                io::ErrorKind::InvalidInput,
+                format!("unknown shell_environment_policy root reference ${name}"),
+            ));
+        }
+        output.push_str(&input[copied_until..index]);
+        output.push_str(&variable(name)?);
+        copied_until = end;
+        index = end;
+    }
+    output.push_str(&input[copied_until..]);
+    Ok(output)
+}
+
+fn is_variable_start(byte: u8) -> bool {
+    byte == b'_' || byte.is_ascii_uppercase()
+}
+
+fn is_variable_continue(byte: u8) -> bool {
+    is_variable_start(byte) || byte.is_ascii_digit()
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::collections::HashMap;
+
+    #[test]
+    fn expands_root_references_with_suffixes_nonrecursively() {
+        let mut policy = ShellEnvironmentPolicy {
+            r#set: HashMap::from([("GOPATH".into(), "$PROJECT_SCRATCH_ROOT/go".into())]),
+            inherited_environment: HashMap::from([(
+                "PROJECT_SCRATCH_ROOT".into(),
+                "/selected/$CODEX_HOME".into(),
+            )]),
+            ..Default::default()
+        };
+        expand_published_root_references(&mut policy).unwrap();
+        assert_eq!(policy.r#set["GOPATH"], "/selected/$CODEX_HOME/go");
+        assert_eq!(
+            expand_value("$CODEX_HOME/config.toml:$TMPDIR/cache", &mut |name| {
+                Ok(match name {
+                    "CODEX_HOME" => "/codex",
+                    "TMPDIR" => "/tmp",
+                    _ => unreachable!(),
+                }
+                .into())
+            })
+            .unwrap(),
+            "/codex/config.toml:/tmp/cache"
+        );
+    }
+
+    #[test]
+    fn rejects_unknown_or_unprepared_root_references() {
+        for (reference, diagnostic) in [
+            ("$HOME/cache", "unknown"),
+            ("$SKILLS_ROOT/cache", "not prepared"),
+        ] {
+            let mut policy = ShellEnvironmentPolicy {
+                r#set: HashMap::from([("VALUE".into(), reference.into())]),
+                ..Default::default()
+            };
+            let error = expand_published_root_references(&mut policy).unwrap_err();
+            assert_eq!(error.kind(), io::ErrorKind::InvalidInput);
+            assert!(error.to_string().contains(diagnostic));
+        }
+    }
+
+    #[test]
+    fn leaves_nonreference_dollar_signs_literal() {
+        for literal in ["literal", "cost$-literal", "$not_a_root"] {
+            assert_eq!(
+                expand_value(literal, &mut |_| unreachable!()).unwrap(),
+                literal
+            );
+        }
+    }
+}
