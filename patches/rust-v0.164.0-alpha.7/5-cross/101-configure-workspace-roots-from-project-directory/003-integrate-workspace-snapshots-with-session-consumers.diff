+#[tokio::test]
+async fn session_workspace_permissions_follow_cwd_without_changing_network_or_approval() {
+    let mut configuration = make_session_configuration_for_tests().await;
+    let workspace = tempfile::tempdir().unwrap();
+    let first = workspace.path().join("first").abs();
+    let second = workspace.path().join("second").abs();
+    let extra = workspace.path().join("remote-extra").abs();
+    configuration.legacy_fallback_cwd = first.clone();
+    let configuration = configuration
+        .apply(
+            &SessionSettingsUpdate {
+                permission_profile: Some(PermissionProfile::workspace_write_with(
+                    std::slice::from_ref(&extra),
+                    NetworkSandboxPolicy::Restricted,
+                    false,
+                    false,
+                )),
+                ..Default::default()
+            },
+            &[],
+        )
+        .unwrap();
+    let original = configuration.permission_profile_state.snapshot();
+    let first_snapshot = configuration.thread_settings_snapshot(&[]);
+    assert!(
+        first_snapshot
+            .permission_profile
+            .file_system_sandbox_policy()
+            .can_write_local_path_with_cwd(&first.join(".git/config"), &first)
+    );
+    let configuration = configuration
+        .apply(
+            &SessionSettingsUpdate {
+                permission_profile: Some(first_snapshot.permission_profile),
+                active_permission_profile: first_snapshot.active_permission_profile,
+                ..Default::default()
+            },
+            &[],
+        )
+        .unwrap();
+    assert_eq!(configuration.permission_profile_state.snapshot(), original);
+    let approval = configuration.step_settings.approval_policy.value();
+    let updated = configuration
+        .apply(
+            &SessionSettingsUpdate {
+                environments: Some(TurnEnvironmentSelections::new(second.clone(), Vec::new())),
+                ..Default::default()
+            },
+            &[],
+        )
+        .unwrap();
+    let policy = updated.file_system_sandbox_policy(&[]);
+    assert!(policy.can_write_local_path_with_cwd(&second.join(".git/config"), &second));
+    assert!(!policy.can_write_local_path_with_cwd(&first.join("file"), &second));
+    assert!(!policy.can_write_local_path_with_cwd(&extra.join("file"), &second));
+    assert_eq!(updated.permission_profile_state.snapshot(), original);
+    assert_eq!(
+        updated
+            .restorable_thread_settings(Vec::new())
+            .permission_profile,
+        Some(original.permission_profile().clone())
+    );
+    let roots = crate::config::storage_roots::StorageRoots::for_cwd(
+        &second,
+        &updated.codex_home,
+        &updated.original_config_do_not_use.codex_harness,
+    )
+    .unwrap();
+    for root in roots.directories() {
+        assert!(policy.can_write_local_path_with_cwd(&root.join(".aws/config"), &second));
+    }
+    assert_eq!(
+        updated.network_sandbox_policy(),
+        NetworkSandboxPolicy::Restricted
+    );
+    assert_eq!(updated.step_settings.approval_policy.value(), approval);
+    assert_eq!(configuration.cwd(), &first);
+
+    let returned = updated
+        .apply(
+            &SessionSettingsUpdate {
+                environments: Some(TurnEnvironmentSelections::new(first.clone(), Vec::new())),
+                ..Default::default()
+            },
+            &[],
+        )
+        .unwrap();
+    let returned_policy = returned.file_system_sandbox_policy(&[]);
+    assert!(returned_policy.can_write_local_path_with_cwd(&first.join(".git/config"), &first));
+    assert!(!returned_policy.can_write_local_path_with_cwd(&second.join("file"), &first));
+    assert!(policy.can_write_local_path_with_cwd(&second.join(".git/config"), &second));
+    assert_eq!(
+        returned.network_sandbox_policy(),
+        NetworkSandboxPolicy::Restricted
+    );
+    assert_eq!(returned.step_settings.approval_policy.value(), approval);
+    assert_eq!(returned.active_permission_profile(), None);
+    let read_only = returned
+        .apply(
+            &SessionSettingsUpdate {
+                permission_profile: Some(PermissionProfile::read_only()),
+                ..Default::default()
+            },
+            &[],
+        )
+        .unwrap();
+    assert_eq!(
+        read_only.permission_profile(),
+        PermissionProfile::read_only()
+    );
+}
