--- /dev/null
+++ b/codex-rs/core/src/environment_selection_storage_tests.rs
@@ -0,0 +1,364 @@
+use super::*;
+use codex_exec_server::LOCAL_ENVIRONMENT_ID;
+use codex_exec_server::REMOTE_ENVIRONMENT_ID;
+use codex_protocol::sandbox::SandboxType;
+use pretty_assertions::assert_eq;
+
+#[tokio::test]
+async fn storage_roots_follow_selected_cwd_and_preserve_captured_environments() {
+    const CHILD_ROOT: &str = "CODEX_STORAGE_ENVIRONMENT_TEST_ROOT";
+    let Some(root) = std::env::var_os(CHILD_ROOT) else {
+        // Isolate inherited root overrides without mutating a concurrent test process.
+        let root = tempfile::tempdir().unwrap();
+        for directory in ["home", "tmp", "codex", "harness"] {
+            std::fs::create_dir_all(root.path().join(directory)).unwrap();
+        }
+        let mut child = std::process::Command::new(std::env::current_exe().unwrap());
+        child.args([
+            "--exact",
+            "environment_selection::storage_tests::storage_roots_follow_selected_cwd_and_preserve_captured_environments",
+            "--nocapture",
+        ]);
+        for name in [
+            "PROJECT_SCRATCH_ROOT",
+            "PROJECT_RUNTIME_ROOT",
+            "PROJECT_PERSISTENT_ROOT",
+            "REPOS_ROOT",
+            "SKILLS_ROOT",
+            "SKILLS_SCRATCH_ROOT",
+        ] {
+            child.env_remove(name);
+        }
+        let output = child
+            .env(CHILD_ROOT, root.path())
+            .env("HOME", root.path().join("home"))
+            .env("TMPDIR", root.path().join("tmp"))
+            .env("CODEX_HOME", root.path().join("codex"))
+            .env("CODEX_HARNESS", root.path().join("harness"))
+            .output()
+            .unwrap();
+        assert!(
+            output.status.success(),
+            "{}\n{}",
+            String::from_utf8_lossy(&output.stdout),
+            String::from_utf8_lossy(&output.stderr)
+        );
+        return;
+    };
+    let root = AbsolutePathBuf::from_absolute_path_checked(root).unwrap();
+    let first_cwd = root.join("work/first");
+    let second_cwd = root.join("work/second");
+    std::fs::create_dir_all(&first_cwd).unwrap();
+    std::fs::create_dir_all(&second_cwd).unwrap();
+    let manager = Arc::new(EnvironmentManager::default_for_tests());
+    let workspace_config = EnvironmentConfig {
+        permission_profile: codex_protocol::models::PermissionProfileSnapshot::active(
+            codex_protocol::models::PermissionProfile::workspace_write(),
+            codex_protocol::models::ActivePermissionProfile {
+                id: codex_protocol::models::BUILT_IN_PERMISSION_PROFILE_WORKSPACE.into(),
+                extends: None,
+            },
+        ),
+        ..tests::test_environment_config()
+    };
+    let environments = ThreadEnvironments::new(
+        Arc::clone(&manager),
+        crate::shell::default_user_shell(),
+        ThreadEnvironmentDefaults::for_tests(workspace_config.clone(), SandboxType::None),
+        ShellSnapshot::disabled(),
+        TurnEnvironmentSnapshot::default(),
+        false,
+    );
+    let mut selection = TurnEnvironmentSelection {
+        environment_id: LOCAL_ENVIRONMENT_ID.into(),
+        cwd: PathUri::from_abs_path(&first_cwd),
+        workspace_roots: Vec::new(),
+        selected_capability_roots: Default::default(),
+        config: EnvironmentConfigState::FromThread,
+    };
+    environments.update_selections(std::slice::from_ref(&selection));
+    let first = environments.snapshot().await;
+    let first_environment = first.local().expect("first project is ready");
+    assert_eq!(
+        first_environment
+            .shell_environment_policy()
+            .inherited_environment,
+        HashMap::from([
+            (
+                "PROJECT_SCRATCH_ROOT".into(),
+                root.join("harness/work/first").display().to_string()
+            ),
+            (
+                "PROJECT_RUNTIME_ROOT".into(),
+                root.join("tmp/first").display().to_string()
+            ),
+            (
+                "PROJECT_PERSISTENT_ROOT".into(),
+                root.join("home/first").display().to_string()
+            ),
+            (
+                "REPOS_ROOT".into(),
+                root.join("home/repos").display().to_string()
+            ),
+            (
+                "SKILLS_ROOT".into(),
+                root.join("codex/skills").display().to_string()
+            ),
+            (
+                "SKILLS_SCRATCH_ROOT".into(),
+                root.join("harness/skills").display().to_string()
+            ),
+        ])
+    );
+    assert!(!root.join("harness/work/second").exists());
+    selection.cwd = PathUri::from_abs_path(&second_cwd);
+    environments.update_selections(std::slice::from_ref(&selection));
+    let second = environments.snapshot().await;
+    let second_environment = second.local().expect("second project is ready");
+    let second_roots = &second_environment
+        .shell_environment_policy()
+        .inherited_environment;
+    assert_eq!(
+        second_roots["PROJECT_SCRATCH_ROOT"],
+        root.join("harness/work/second").display().to_string()
+    );
+    assert_eq!(
+        second_roots["PROJECT_RUNTIME_ROOT"],
+        root.join("tmp/second").display().to_string()
+    );
+    assert_eq!(
+        second_roots["PROJECT_PERSISTENT_ROOT"],
+        root.join("home/second").display().to_string()
+    );
+    let second_permissions = second_environment
+        .permission_profile_with_workspace_roots()
+        .file_system_sandbox_policy();
+    for path in std::iter::once(second_cwd.join(".git/config").to_path_buf()).chain(
+        second_roots
+            .values()
+            .map(|path| std::path::Path::new(path).join(".aws/config")),
+    ) {
+        assert!(
+            second_permissions.can_write_local_path_with_cwd(&path, &second_cwd),
+            "{path:?}"
+        );
+    }
+    for path in [
+        first_cwd.join("file"),
+        root.join("tmp/first/file"),
+        root.join("home/first/file"),
+    ] {
+        assert!(
+            !second_permissions.can_write_local_path_with_cwd(&path, &second_cwd),
+            "{path:?}"
+        );
+    }
+    let first_permissions = first_environment
+        .permission_profile_with_workspace_roots()
+        .file_system_sandbox_policy();
+    assert!(
+        first_permissions.can_write_local_path_with_cwd(&first_cwd.join(".git/config"), &first_cwd)
+    );
+    assert!(!first_permissions.can_write_local_path_with_cwd(&second_cwd.join("file"), &first_cwd));
+    for language in ["python", "go", "rust"] {
+        assert!(
+            root.join(format!("harness/work/second/{language}"))
+                .is_dir()
+        );
+    }
+    assert_eq!(
+        first_environment
+            .shell_environment_policy()
+            .inherited_environment["PROJECT_SCRATCH_ROOT"],
+        root.join("harness/work/first").display().to_string()
+    );
+    assert!(std::env::var_os("PROJECT_SCRATCH_ROOT").is_none());
+
+    let child = ThreadEnvironments::new(
+        Arc::clone(&manager),
+        crate::shell::default_user_shell(),
+        ThreadEnvironmentDefaults::for_tests(workspace_config.clone(), SandboxType::None),
+        ShellSnapshot::disabled(),
+        second.clone(),
+        false,
+    );
+    assert_eq!(
+        child
+            .snapshot()
+            .await
+            .local()
+            .unwrap()
