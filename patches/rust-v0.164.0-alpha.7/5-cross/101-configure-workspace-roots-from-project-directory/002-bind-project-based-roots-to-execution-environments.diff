+            ),
+            ..Default::default()
+        })
+        .build()
+        .await
+        .unwrap();
+    let source_profile = loaded_config
+        .permissions
+        .permission_profile_state()
+        .snapshot();
+    assert_eq!(source_profile, workspace_config.permission_profile);
+    // Native callers may choose the execution cwd after loading Config.
+    loaded_config.cwd = second_cwd.clone();
+    let prepared = loaded_config.prepare_local_permissions().unwrap();
+    assert!(
+        prepared
+            .file_system_sandbox_policy()
+            .can_write_local_path_with_cwd(&second_cwd.join(".git/config"), &second_cwd)
+    );
+    assert!(
+        !prepared
+            .file_system_sandbox_policy()
+            .can_write_local_path_with_cwd(&first_cwd.join("file"), &second_cwd)
+    );
+    let mut loaded_defaults =
+        ThreadEnvironmentDefaults::for_tests(workspace_config.clone(), SandboxType::None);
+    loaded_defaults.permission_profile_state =
+        loaded_config.permissions.permission_profile_state().clone();
+    let local_config = loaded_defaults
+        .for_selection(&TurnEnvironmentSelection {
+            environment_id: LOCAL_ENVIRONMENT_ID.into(),
+            cwd: second_cwd.clone().into(),
+            workspace_roots: vec![second_cwd.clone().into()],
+            config: EnvironmentConfigState::FromThread,
+            ..selection.clone()
+        })
+        .unwrap();
+    assert_eq!(
+        local_config.permission_profile.permission_profile(),
+        prepared.permission_profile()
+    );
+    let foreign_cwd = PathUri::parse("file:///C:/workspace").unwrap();
+    let foreign = TurnEnvironmentSelection {
+        environment_id: REMOTE_ENVIRONMENT_ID.into(),
+        cwd: foreign_cwd.clone(),
+        workspace_roots: vec![foreign_cwd],
+        config: EnvironmentConfigState::FromThread,
+        ..selection.clone()
+    };
+    let remote_config = loaded_defaults.for_selection(&foreign).unwrap();
+    assert_eq!(
+        remote_config.permission_profile,
+        workspace_config.permission_profile
+    );
+    assert_eq!(remote_config.workspace_roots, foreign.workspace_roots);
+    assert!(
+        remote_config
+            .shell_environment_policy
+            .inherited_environment
+            .is_empty()
+    );
+    assert_eq!(
+        loaded_config
+            .permissions
+            .permission_profile_state()
+            .snapshot(),
+        source_profile
+    );
+
+    let remote = TurnEnvironmentSelection {
+        environment_id: REMOTE_ENVIRONMENT_ID.into(),
+        config: EnvironmentConfigState::FromThread,
+        ..selection
+    };
+    let defaults =
+        ThreadEnvironmentDefaults::for_tests(first_environment.config().clone(), SandboxType::None);
+    let (remote, origin) = resolve_selection_config(remote, &defaults);
+    assert_eq!(origin, EnvironmentConfigOrigin::Thread);
+    let EnvironmentConfigState::Ready(remote_config) = remote.config else {
+        panic!("remote configuration must not initialize host project directories");
+    };
+    assert!(
+        remote_config
+            .shell_environment_policy
+            .inherited_environment
+            .is_empty()
+    );
+}
