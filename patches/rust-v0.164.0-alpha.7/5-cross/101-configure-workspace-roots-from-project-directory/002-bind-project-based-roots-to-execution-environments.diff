+#[test]
+fn exec_env_policy_preserves_scoped_inheritance_filtering() {
+    use codex_protocol::config_types::EnvironmentVariablePattern;
+    use codex_protocol::config_types::ShellEnvironmentPolicyInherit;
+
+    let mut policy = ShellEnvironmentPolicy {
+        inherited_environment: HashMap::from([
+            ("PROJECT_SCRATCH_ROOT".into(), "/selected/scratch".into()),
+            ("PROJECT_RUNTIME_ROOT".into(), "/selected/runtime".into()),
+        ]),
+        exclude: vec![EnvironmentVariablePattern::new("PROJECT_RUNTIME_ROOT")],
+        ..Default::default()
+    };
+    assert_eq!(
+        exec_env_policy_from_shell_policy(&policy).r#set,
+        HashMap::from([("PROJECT_SCRATCH_ROOT".into(), "/selected/scratch".into()),])
+    );
+    policy.inherit = ShellEnvironmentPolicyInherit::None;
+    assert!(exec_env_policy_from_shell_policy(&policy).r#set.is_empty());
+    policy
+        .r#set
+        .insert("PROJECT_RUNTIME_ROOT".into(), "/explicit/runtime".into());
+    assert_eq!(
+        exec_env_policy_from_shell_policy(&policy).r#set,
+        policy.r#set
+    );
