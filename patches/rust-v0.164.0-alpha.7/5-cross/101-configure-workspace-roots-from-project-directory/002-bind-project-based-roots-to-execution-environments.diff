+    assert_eq!(
+        child
+            .snapshot()
+            .await
+            .local()
+            .unwrap()
+            .shell_environment_policy()
+            .inherited_environment,
+        first_environment
+            .shell_environment_policy()
+            .inherited_environment
+    );
+    assert_eq!(
+        environments
+            .snapshot()
+            .await
+            .local()
+            .unwrap()
+            .shell_environment_policy()
+            .inherited_environment,
+        *second_roots
+    );
+
+    let first_config = first_environment.config();
+    let mut constrained_defaults =
+        ThreadEnvironmentDefaults::for_tests(first_config.clone(), SandboxType::None);
+    constrained_defaults.permission_profile_state =
+        crate::config::PermissionProfileState::from_constrained_active_profile(
+            codex_config::Constrained::allow_only(
+                first_config.permission_profile.permission_profile().clone(),
+            ),
+            first_config.permission_profile.active_permission_profile(),
+            Vec::new(),
+        )
+        .unwrap();
+    assert!(constrained_defaults.for_selection(&selection).is_ok());
+    let constrained_selection = TurnEnvironmentSelection {
+        cwd: PathUri::from_abs_path(&second_cwd),
+        ..selection.clone()
+    };
+    let (constrained_selection, origin) =
+        resolve_selection_config(constrained_selection, &constrained_defaults);
+    assert_eq!(origin, EnvironmentConfigOrigin::Thread);
+    assert!(
+        matches!(constrained_selection.config, EnvironmentConfigState::Failed(error) if error.contains("allowed set"))
+    );
+
+    std::fs::write(root.join("harness/work/blocked"), "occupied").unwrap();
+    selection.cwd = PathUri::from_abs_path(&root.join("work/blocked"));
+    environments.update_selections(std::slice::from_ref(&selection));
+    let failed = environments.snapshot().await;
+    assert!(
+        matches!(&failed.environments[..], [TurnEnvironmentState::Failed { error, .. }] if error.contains("PROJECT_SCRATCH_ROOT") && error.contains("blocked"))
+    );
+    assert!(child.snapshot().await.local().is_some());
+    assert_eq!(
+        second_environment
+            .shell_environment_policy()
+            .inherited_environment,
+        *second_roots
+    );
+
+    let mut owner_config = tests::test_environment_config();
+    owner_config
+        .shell_environment_policy
+        .inherited_environment
+        .insert("OWNER_ROOT".into(), "/owned/root".into());
+    selection.config = EnvironmentConfigState::Ready(owner_config.clone());
+    environments.update_selections(std::slice::from_ref(&selection));
+    assert_eq!(
+        environments.snapshot().await.local().unwrap().config(),
+        &owner_config
+    );
