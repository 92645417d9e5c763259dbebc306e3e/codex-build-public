+#[tokio::test]
+async fn failed_host_mcp_preparation_blocks_stale_bindings_and_remains_pending() {
+    const CHILD_ROOT: &str = "CODEX_MCP_PREPARATION_TEST_ROOT";
+    let Some(root) = std::env::var_os(CHILD_ROOT) else {
+        // Root overrides belong to this child process, not concurrent tests.
+        let root = tempfile::tempdir().unwrap();
+        let mut child = std::process::Command::new(std::env::current_exe().unwrap());
+        child.args([
+            "--exact",
+            "session::tests::failed_host_mcp_preparation_blocks_stale_bindings_and_remains_pending",
+            "--nocapture",
+        ]);
+        for name in [
+            "PROJECT_SCRATCH_ROOT",
+            "PROJECT_RUNTIME_ROOT",
+            "PROJECT_PERSISTENT_ROOT",
+            "REPOS_ROOT",
+            "SKILLS_ROOT",
+            "SKILLS_SCRATCH_ROOT",
+        ] {
+            child.env(name, root.path().join(name));
+        }
+        let output = child.env(CHILD_ROOT, root.path()).output().unwrap();
+        assert!(
+            output.status.success(),
+            "{}\n{}",
+            String::from_utf8_lossy(&output.stdout),
+            String::from_utf8_lossy(&output.stderr),
+        );
+        return;
+    };
+    let root = PathBuf::from(root);
+    let (session, turn) = make_session_and_context().await;
+    let session = Arc::new(session);
+    let turn = Arc::new(turn);
+    let old_step = session
+        .capture_step_context(Arc::clone(&turn), &CancellationToken::new())
+        .await
+        .expect("publish initial runtime");
+    let mut config = session.get_config().await.as_ref().clone();
+    let mut server: McpServerConfig = serde_json::from_value(json!({
+        "command": "must-not-start-before-host-preparation",
+    }))
+    .unwrap();
+    config
+        .mcp_servers
+        .set(HashMap::from([("host".to_owned(), server.clone())]))
+        .unwrap();
+    session
+        .state
+        .lock()
+        .await
+        .session_configuration
+        .original_config_do_not_use = Arc::new(config.clone());
+    let scratch = root.join("PROJECT_SCRATCH_ROOT");
+    std::fs::rename(&scratch, root.join("saved-scratch")).unwrap();
+    std::fs::write(&scratch, "a file cannot be a storage directory").unwrap();
+    session.mark_mcp_runtime_dirty();
+
+    let Err(error) = session
+        .capture_step_context(Arc::clone(&turn), &CancellationToken::new())
+        .await
+    else {
+        panic!("a failed host preparation must not admit the previous MCP binding");
+    };
+    assert!(
+        error.to_string().contains("PROJECT_SCRATCH_ROOT"),
+        "{error}"
+    );
+    assert!(session.mcp_refresh.is_pending());
+    assert!(Arc::ptr_eq(
+        old_step.mcp.config(),
+        &session
+            .services
+            .mcp_runtime
+            .current_config()
+            .expect("retain previous publication"),
+    ));
+    assert!(
+        session
+            .runtime_mcp_config_and_context(&config)
+            .await
+            .is_err()
+    );
+
+    // A disabled host server must not make unused host storage a prerequisite.
+    server.enabled = false;
+    config
+        .mcp_servers
+        .set(HashMap::from([("host".to_owned(), server)]))
+        .unwrap();
+    session
+        .state
+        .lock()
+        .await
+        .session_configuration
+        .original_config_do_not_use = Arc::new(config);
+    let step = session
+        .capture_step_context(turn, &CancellationToken::new())
+        .await
+        .expect("disabled server needs no host preparation");
+    assert!(!session.mcp_refresh.is_pending());
+    assert!(!codex_mcp::configured_mcp_servers(step.mcp.config())["host"].enabled);
+}
