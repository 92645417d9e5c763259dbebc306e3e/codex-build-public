+#[tokio::test]
+async fn published_workspace_roots_survive_start_resume_and_permission_selection() -> Result<()> {
+    use app_test_support::MockResponsesConfig;
+    use app_test_support::create_fake_rollout;
+    use codex_app_server_protocol::CommandExecParams;
+    use codex_app_server_protocol::CommandExecResponse;
+    use codex_app_server_protocol::ThreadResumeParams;
+    use codex_app_server_protocol::ThreadResumeResponse;
+    use codex_app_server_protocol::ThreadSettingsUpdateParams;
+    use codex_app_server_protocol::ThreadSettingsUpdateResponse;
+    use codex_app_server_protocol::ThreadSettingsUpdatedNotification;
+    use codex_utils_absolute_path::AbsolutePathBuf;
+
+    let fixture = TempDir::new()?;
+    let codex_home = fixture.path().join("home");
+    let cwd = fixture.path().join("workspace");
+    std::fs::create_dir_all(&codex_home)?;
+    std::fs::create_dir_all(&cwd)?;
+    let variables = [
+        "PROJECT_SCRATCH_ROOT",
+        "PROJECT_RUNTIME_ROOT",
+        "PROJECT_PERSISTENT_ROOT",
+        "REPOS_ROOT",
+        "SKILLS_ROOT",
+        "SKILLS_SCRATCH_ROOT",
+    ];
+    let roots = variables.map(|name| fixture.path().join(name));
+    for root in std::iter::once(&cwd).chain(&roots) {
+        std::fs::create_dir_all(root)?;
+        for name in [".git", ".agents", ".codex", ".aws"] {
+            std::fs::create_dir(root.join(name))?;
+        }
+    }
+    let env_overrides: Vec<_> = variables
+        .iter()
+        .zip(&roots)
+        .map(|(name, root)| (*name, root.to_str()))
+        .collect();
+    let server = create_mock_responses_server_repeating_assistant("Done").await;
+    MockResponsesConfig::new(&server.uri())
+        .with_sandbox_mode("workspace-write")
+        .with_extra_config("[sandbox_workspace_write]\nnetwork_access = true")
+        .write(&codex_home)?;
+    let mut app = TestAppServer::builder()
+        .with_codex_home(&codex_home)
+        .without_auto_env()
+        .with_env_overrides(&env_overrides)
+        .build_initialized()
+        .await?;
+    let cwd = AbsolutePathBuf::from_absolute_path(cwd)?;
+    let assert_storage = |policy: &SandboxPolicy| {
+        let SandboxPolicy::WorkspaceWrite {
+            writable_roots,
+            exclude_tmpdir_env_var,
+            exclude_slash_tmp,
+            ..
+        } = policy
+        else {
+            panic!("expected Workspace, got {policy:?}");
+        };
+        for root in &roots {
+            assert!(writable_roots.iter().any(|path| path.as_path() == root));
+        }
+        assert!(*exclude_tmpdir_env_var);
+        assert!(*exclude_slash_tmp);
+    };
+    for params in [
+        ThreadStartParams::default(),
+        ThreadStartParams {
+            sandbox: Some(SandboxMode::WorkspaceWrite),
+            ..Default::default()
+        },
+        ThreadStartParams {
+            permissions: Some(":workspace".to_string()),
+            ..Default::default()
+        },
+    ] {
+        let expected_network = params.permissions.is_none();
+        let response: ThreadStartResponse = app
+            .request(|request_id| ClientRequest::ThreadStart {
+                request_id,
+                params: ThreadStartParams {
+                    cwd: Some(cwd.as_path().to_string_lossy().into_owned()),
+                    runtime_workspace_roots: Some(vec![cwd.clone()]),
+                    approval_policy: Some(AskForApproval::Never),
+                    ..params
+                },
+            })
+            .await?;
+        assert_storage(&response.sandbox);
+        assert_eq!(response.approval_policy, AskForApproval::Never);
+        let SandboxPolicy::WorkspaceWrite { network_access, .. } = response.sandbox else {
+            unreachable!();
+        };
+        assert_eq!(network_access, expected_network);
+    }
+
+    let writable_files = std::iter::once(cwd.as_path())
+        .chain(roots.iter().map(PathBuf::as_path))
+        .flat_map(|root| {
+            [
+                "write-probe",
+                ".git/write-probe",
+                ".agents/write-probe",
+                ".codex/write-probe",
+                ".aws/write-probe",
+            ]
+            .map(|path| root.join(path))
+        })
+        .collect::<Vec<_>>();
+    let command = std::iter::once("/usr/bin/touch".to_string())
+        .chain(
+            writable_files
+                .iter()
+                .map(|path| path.to_string_lossy().into_owned()),
+        )
+        .collect();
+    let request = CommandExecParams {
+        command,
+        process_id: None,
+        tty: false,
+        stream_stdin: false,
+        stream_stdout_stderr: false,
+        output_bytes_cap: None,
+        disable_output_cap: false,
+        disable_timeout: false,
+        timeout_ms: None,
+        cwd: Some(cwd.to_path_buf()),
+        env: None,
+        size: None,
+        sandbox_policy: None,
+        // command/exec is thread-independent; selecting the profile binds its roots to this cwd.
+        permission_profile: Some(":workspace".to_string()),
+    };
+    let request_id = app.send_command_exec_request(request.clone()).await?;
+    let written: CommandExecResponse = app.read_response(request_id).await?;
+    assert_eq!(written.exit_code, 0, "{}", written.stderr);
+    assert!(writable_files.iter().all(|path| path.is_file()));
+
+    let outside = fixture.path().join("outside-workspace");
+    let request_id = app
+        .send_command_exec_request(CommandExecParams {
+            command: vec![
+                "/usr/bin/touch".into(),
+                outside.to_string_lossy().into_owned(),
+            ],
+            ..request
+        })
+        .await?;
+    let denied: CommandExecResponse = app.read_response(request_id).await?;
+    assert_ne!(denied.exit_code, 0);
+    assert!(!outside.exists());
+
+    let thread_id = create_fake_rollout(
+        &codex_home,
+        "2026-01-01T12-00-00",
+        "2026-01-01T12:00:00Z",
+        "saved prompt",
+        Some("mock_provider"),
+        /*git_info*/ None,
+    )?;
+    let resumed: ThreadResumeResponse = app
+        .request(|request_id| ClientRequest::ThreadResume {
+            request_id,
+            params: ThreadResumeParams {
+                thread_id: thread_id.clone(),
+                cwd: Some(cwd.as_path().to_string_lossy().into_owned()),
+                runtime_workspace_roots: Some(vec![cwd.clone()]),
+                ..Default::default()
+            },
+        })
+        .await?;
+    assert_storage(&resumed.sandbox);
+    let _: ThreadSettingsUpdateResponse = app
+        .request(|request_id| ClientRequest::ThreadSettingsUpdate {
+            request_id,
+            params: ThreadSettingsUpdateParams {
+                thread_id,
+                permissions: Some(":workspace".to_string()),
+                approval_policy: Some(AskForApproval::Never),
+                ..Default::default()
+            },
+        })
+        .await?;
+    let notification = timeout(
+        DEFAULT_READ_TIMEOUT,
+        app.read_stream_until_notification_message("thread/settings/updated"),
+    )
+    .await??;
+    let notification: ThreadSettingsUpdatedNotification =
+        serde_json::from_value(notification.params.context("settings notification")?)?;
+    assert_storage(&notification.thread_settings.sandbox_policy);
+    assert_eq!(
+        notification.thread_settings.approval_policy,
+        AskForApproval::Never
+    );
+    Ok(())
+}
