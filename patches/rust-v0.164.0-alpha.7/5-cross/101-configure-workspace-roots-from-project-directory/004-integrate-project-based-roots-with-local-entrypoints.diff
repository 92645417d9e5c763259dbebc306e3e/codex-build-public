+#[tokio::test]
+async fn slash_cd_rebinds_project_roots_and_workspace_permissions() -> Result<()> {
+    let (mut app, mut events, _op_rx) = make_test_app_with_channels().await;
+    let home = tempdir()?;
+    let source = home.path().join("source");
+    let destination = home.path().join("destination");
+    for cwd in [&source, &destination] {
+        std::fs::create_dir(cwd)?;
+        crate::legacy_core::config::set_project_trust_level(
+            home.path(),
+            cwd,
+            codex_protocol::config_types::TrustLevel::Trusted,
+        )
+        .map_err(|error| color_eyre::eyre::eyre!(error.to_string()))?;
+    }
+    app.config.codex_home = home.path().to_path_buf().abs();
+    app.harness_overrides.default_permissions = Some(":workspace".to_string());
+    app.config = app.rebuild_config_for_cwd(source.clone()).await?;
+    app.local_settings = crate::local_settings::LocalSettings::from(&app.config);
+    let (mut server, requests, proxy) = start_recording_app_server(
+        &app.config,
+        /*blocked_thread_list*/ None,
+        /*failed_thread_name*/ None,
+    )
+    .await?;
+    let mut tui = crate::tui::test_support::make_test_tui()?;
+    let started = server.start_thread(&app.config).await?;
+    app.replace_chat_widget_with_app_server_thread(
+        &mut tui,
+        started,
+        crate::app::session_lifecycle::ThreadAttachPresentation::Fresh,
+        /*initial_user_message*/ None,
+    )
+    .await?;
+    assert_eq!(app.chat_widget.config_ref().cwd, source.clone().abs());
+    let original = app.chat_widget.thread_id().expect("source thread");
+    let item = serde_json::from_value(serde_json::json!({
+        "type": "message",
+        "role": "assistant",
+        "content": [{"type": "output_text", "text": "saved history"}],
+    }))?;
+    server.thread_inject_items(original, vec![item]).await?;
+    requests.lock().expect("request recorder lock").clear();
+
+    app.chat_widget.insert_str("/cd ../destination");
+    app.chat_widget
+        .handle_key_event(KeyEvent::from(KeyCode::Enter));
+    let event = std::iter::from_fn(|| events.try_recv().ok())
+        .find(|event| matches!(event, AppEvent::ChangeWorkingDirectory { .. }))
+        .expect("slash command requests a directory change");
+    // Match the live event loop's heap-pinned dispatch instead of embedding its future here.
+    Box::pin(app.handle_event(&mut tui, &mut server, event)).await?;
+    let pending = app
+        .pending_working_directory_change
+        .take()
+        .expect("directory change is queued");
+    Box::pin(app.finish_working_directory_change(&mut tui, &mut server, pending)).await;
+
+    let configured = app.primary_session_configured.as_ref().expect("session");
+    assert_ne!(configured.thread_id, original);
+    assert_eq!(configured.cwd, destination.clone().abs());
+    assert_eq!(app.config.cwd, configured.cwd);
+    assert_eq!(app.chat_widget.config_ref().cwd, configured.cwd);
+    assert_eq!(recorded_params(&requests, "thread/fork").len(), 1);
+    assert!(recorded_params(&requests, "thread/start").is_empty());
+
+    let roots = app
+        .config
+        .local_storage_environment()
+        .map_err(|error| color_eyre::eyre::eyre!(error.to_string()))?;
+    assert_eq!(roots.len(), 6);
+    for root in roots.values() {
+        assert!(Path::new(root).is_dir(), "root was not prepared: {root}");
+    }
+    for language in ["go", "rust", "python"] {
+        assert!(
+            Path::new(&roots["PROJECT_SCRATCH_ROOT"])
+                .join(language)
+                .is_dir()
+        );
+    }
+    for profile in [
+        app.config.permissions.permission_profile(),
+        app.chat_widget
+            .config_ref()
+            .permissions
+            .permission_profile(),
+        &configured.permission_profile,
+    ] {
+        let policy = profile.file_system_sandbox_policy();
+        for root in std::iter::once(destination.as_path()).chain(roots.values().map(Path::new)) {
+            assert!(
+                policy.can_write_local_path_with_cwd(
+                    &root.join(".codex/config.toml"),
+                    &configured.cwd
+                ),
+                "root is not fully writable after /cd: {}",
+                root.display()
+            );
+        }
+        // The old cwd is writable only if an explicit storage root still contains it.
+        let source_is_storage = roots.values().any(|root| source.starts_with(root));
+        assert_eq!(
+            policy.can_write_local_path_with_cwd(&source.join("file"), &configured.cwd),
+            source_is_storage,
+        );
+    }
+    assert_eq!(
+        server
+            .thread_read(original, /*include_turns*/ false)
+            .await?
+            .cwd,
+        source.abs().canonicalize()?,
+    );
+    server.shutdown().await?;
+    proxy.await??;
+    Ok(())
+}
