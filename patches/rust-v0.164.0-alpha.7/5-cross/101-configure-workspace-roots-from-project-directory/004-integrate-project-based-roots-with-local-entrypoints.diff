+#[tokio::test]
+async fn workspace_roots_follow_selected_project_in_settings_and_standalone_commands() -> Result<()>
+{
+    use app_test_support::MockResponsesConfig;
+    use codex_app_server_protocol::CommandExecParams;
+    use codex_app_server_protocol::CommandExecResponse;
+    use codex_app_server_protocol::ThreadSettingsUpdateParams;
+    use codex_app_server_protocol::ThreadSettingsUpdateResponse;
+    use codex_app_server_protocol::ThreadSettingsUpdatedNotification;
+
+    let fixture = TempDir::new()?;
+    let home = fixture.path().join("codex");
+    let user_home = fixture.path().join("home");
+    let temporary = fixture.path().join("tmp");
+    let harness = fixture.path().join("harness");
+    let first = fixture.path().join("work/first");
+    let second = fixture.path().join("work/second");
+    for path in [&home, &user_home, &temporary, &harness, &first, &second] {
+        std::fs::create_dir_all(path)?;
+    }
+    let overrides = [
+        ("HOME", user_home.to_str()),
+        ("TMPDIR", temporary.to_str()),
+        ("CODEX_HARNESS", harness.to_str()),
+        ("PROJECT_SCRATCH_ROOT", None),
+        ("PROJECT_RUNTIME_ROOT", None),
+        ("PROJECT_PERSISTENT_ROOT", None),
+        ("REPOS_ROOT", None),
+        ("SKILLS_ROOT", None),
+        ("SKILLS_SCRATCH_ROOT", None),
+    ];
+    let server = create_mock_responses_server_repeating_assistant("Done").await;
+    MockResponsesConfig::new(&server.uri()).write(&home)?;
+    let mut app = TestAppServer::builder()
+        .with_codex_home(&home)
+        .without_auto_env()
+        .with_env_overrides(&overrides)
+        .build_initialized()
+        .await?;
+    let started: ThreadStartResponse = app
+        .request(|request_id| ClientRequest::ThreadStart {
+            request_id,
+            params: ThreadStartParams {
+                cwd: Some(first.to_string_lossy().into_owned()),
+                permissions: Some(":workspace".into()),
+                approval_policy: Some(AskForApproval::Never),
+                ..Default::default()
+            },
+        })
+        .await?;
+    let SandboxPolicy::WorkspaceWrite { writable_roots, .. } = &started.sandbox else {
+        panic!("Workspace policy required");
+    };
+    assert!(
+        writable_roots
+            .iter()
+            .any(|path| path.as_path() == harness.join("work/first"))
+    );
+
+    let _: ThreadSettingsUpdateResponse = app
+        .request(|request_id| ClientRequest::ThreadSettingsUpdate {
+            request_id,
+            params: ThreadSettingsUpdateParams {
+                thread_id: started.thread.id,
+                cwd: Some(second.clone()),
+                ..Default::default()
+            },
+        })
+        .await?;
+    let notification = timeout(
+        DEFAULT_READ_TIMEOUT,
+        app.read_stream_until_notification_message("thread/settings/updated"),
+    )
+    .await??;
+    let updated: ThreadSettingsUpdatedNotification =
+        serde_json::from_value(notification.params.context("settings notification")?)?;
+    let SandboxPolicy::WorkspaceWrite { writable_roots, .. } =
+        &updated.thread_settings.sandbox_policy
+    else {
+        panic!("Workspace policy required");
+    };
+    for expected in [
+        harness.join("work/second"),
+        temporary.join("second"),
+        user_home.join("second"),
+    ] {
+        assert!(
+            writable_roots.iter().any(|path| path.as_path() == expected),
+            "missing {expected:?}"
+        );
+    }
+    for previous in [
+        &first,
+        &harness.join("work/first"),
+        &temporary.join("first"),
+        &user_home.join("first"),
+    ] {
+        assert!(
+            !writable_roots.iter().any(|path| path.as_path() == previous),
+            "retained {previous:?}"
+        );
+    }
+    assert_eq!(updated.thread_settings.cwd.as_path(), second);
+    assert_eq!(
+        updated.thread_settings.approval_policy,
+        AskForApproval::Never
+    );
+
+    let request_id = app
+        .send_command_exec_request(CommandExecParams {
+            command: vec!["/usr/bin/env".into()],
+            process_id: None,
+            tty: false,
+            stream_stdin: false,
+            stream_stdout_stderr: false,
+            output_bytes_cap: None,
+            disable_output_cap: false,
+            disable_timeout: false,
+            timeout_ms: None,
+            cwd: Some(second.clone()),
+            env: None,
+            size: None,
+            sandbox_policy: None,
+            permission_profile: Some(":workspace".into()),
+        })
+        .await?;
+    let output: CommandExecResponse = app.read_response(request_id).await?;
+    assert_eq!(output.exit_code, 0, "{}", output.stderr);
+    for (name, path) in [
+        ("PROJECT_SCRATCH_ROOT", harness.join("work/second")),
+        ("PROJECT_RUNTIME_ROOT", temporary.join("second")),
+        ("PROJECT_PERSISTENT_ROOT", user_home.join("second")),
+        ("REPOS_ROOT", user_home.join("repos")),
+        ("SKILLS_ROOT", home.join("skills")),
+        ("SKILLS_SCRATCH_ROOT", harness.join("skills")),
+    ] {
+        let expected = format!("{name}={}", path.display());
+        assert!(
+            output.stdout.lines().any(|line| line == expected),
+            "missing {expected}: {}",
+            output.stdout
+        );
+        assert!(path.is_dir(), "missing {path:?}");
+    }
+    Ok(())
+}
