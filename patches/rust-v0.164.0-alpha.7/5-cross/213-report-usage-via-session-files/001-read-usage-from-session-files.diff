+    let parsed = parse_values(&[response, snapshot(), next_context, next_snapshot]);
+    assert_eq!(parsed.events.len(), 2);
+    assert_eq!(parsed.models[parsed.events[0].model], "unknown model");
+    assert_eq!(parsed.events[0].tokens.total, 150);
+    assert_eq!(parsed.models[parsed.events[1].model], "gpt-5.4");
+    assert_eq!(parsed.events[1].tokens.total, 150);
