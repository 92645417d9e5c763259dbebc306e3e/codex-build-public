+use super::types::CreditObservation;
+use super::types::Diagnostics;
+use super::types::Observation;
+use super::wire::Event;
+use super::wire::ParsedFile;
+use super::wire::intern_model;
+use super::wire::read_lines;
+use super::wire::timestamp;
+use serde_json::Value;
+use std::collections::BTreeMap;
+use std::fs;
+use std::io::BufRead;
+use std::io::BufReader;
+use std::path::Path;
+use std::path::PathBuf;
+use std::sync::Mutex;
+use std::thread;
+
+pub(super) struct Events {
+    pub(super) events: Vec<Event>,
+    pub(super) models: Vec<String>,
+    pub(super) observations: Vec<Observation>,
+    pub(super) credits: Vec<CreditObservation>,
+    pub(super) diagnostics: Diagnostics,
+}
+
+struct Rollout {
+    id: String,
+    parent: Option<String>,
+    referenced_history: bool,
+    forked_at: Option<i64>,
+    parsed: ParsedFile,
+}
+
+fn collect_files(
+    entries: fs::ReadDir,
+    base: &Path,
+    files: &mut BTreeMap<PathBuf, PathBuf>,
+) -> std::io::Result<()> {
+    for entry in entries {
+        let entry = entry?;
+        let path = entry.path();
+        let kind = entry.file_type()?;
+        if kind.is_dir() {
+            collect_files(fs::read_dir(&path)?, base, files)?;
+        } else if kind.is_file()
+            && path
+                .extension()
+                .is_some_and(|extension| extension == "jsonl")
+        {
+            let relative = path
+                .strip_prefix(base)
+                .expect("discovered under session root");
+            files.entry(relative.to_path_buf()).or_insert(path);
+        }
+    }
+    Ok(())
+}
+
+fn read_rollout(
+    mut reader: impl BufRead,
+    diagnostics: &mut Diagnostics,
+) -> Result<Option<Rollout>, super::Error> {
+    let mut header = String::new();
+    reader.read_line(&mut header)?;
+    let value: Value = match serde_json::from_str(&header) {
+        Ok(value) => value,
+        Err(_) => {
+            diagnostics.malformed_records += 1;
+            return Ok(None);
+        }
+    };
+    let payload = &value["payload"];
+    if value["type"] != "session_meta" || payload["history_mode"] != "paginated" {
+        diagnostics.skipped_non_paginated += 1;
+        return Ok(None);
+    }
+    let parent = ["forked_from_id", "parent_thread_id"]
+        .into_iter()
+        .filter_map(|key| payload.get(key))
+        .chain(payload.pointer("/source/subagent/thread_spawn/parent_thread_id"))
+        .find_map(Value::as_str)
+        .filter(|id| !id.is_empty())
+        .map(str::to_owned);
+    let id = payload["id"].as_str().unwrap_or("").to_owned();
+    let mut parsed = read_lines(reader, &id)?;
+    parsed.incomplete += usize::from(!header.ends_with('\n'));
+    Ok(Some(Rollout {
+        id,
+        parent,
+        // Referenced forks store only their own suffix. Subagent projection boundaries
+        // in migrated logs can extend past real spending and are not billing evidence.
+        referenced_history: payload
+            .pointer("/history_base/end_ordinal_exclusive")
+            .and_then(Value::as_u64)
+            .is_some(),
+        forked_at: value["timestamp"].as_str().and_then(timestamp),
+        parsed,
+    }))
+}
+
+/// Read each file once for all report dimensions, bounded to its observed byte length.
+/// Compact records keep copied-prefix comparison off the filesystem and UI thread.
+pub(super) fn load(home: &Path) -> Result<Events, super::Error> {
+    // A relative-path collision prefers active over archived records.
+    let mut paths = BTreeMap::new();
+    for name in [
+        codex_rollout::SESSIONS_SUBDIR,
+        codex_rollout::ARCHIVED_SESSIONS_SUBDIR,
+    ] {
+        let root = home.join(name);
+        match fs::read_dir(&root) {
+            Ok(entries) => collect_files(entries, &root, &mut paths)?,
+            Err(error) if error.kind() == std::io::ErrorKind::NotFound => {}
+            Err(error) => return Err(error.into()),
+        }
+    }
+    let mut diagnostics = Diagnostics::default();
+    let workers = thread::available_parallelism()
+        .map_or(1, usize::from)
+        .min(16)
+        .min(paths.len().max(1));
+    // Hold the shared iterator only while assigning a file, never during I/O or parsing.
+    let pending = Mutex::new(paths.into_iter());
+    let files = thread::scope(|scope| -> Result<_, super::Error> {
+        let mut handles = Vec::with_capacity(workers);
+        for _ in 0..workers {
+            handles.push(scope.spawn(|| -> Result<_, super::Error> {
+                let mut diagnostics = Diagnostics::default();
+                let mut files = Vec::new();
+                loop {
+                    let next = pending
+                        .lock()
+                        .map_err(|_| "usage reader work queue poisoned")?
+                        .next();
+                    let Some((relative, path)) = next else { break };
+                    let file = fs::File::open(path)?;
+                    let bytes = file.metadata()?.len();
+                    let reader =
+                        BufReader::with_capacity(128 * 1024, std::io::Read::take(file, bytes));
+                    if let Some(rollout) = read_rollout(reader, &mut diagnostics)? {
+                        files.push((relative, rollout));
+                    }
+                }
+                Ok((files, diagnostics))
+            }));
+        }
+        let mut files = BTreeMap::new();
+        for handle in handles {
+            let (loaded, local) = handle
+                .join()
+                .map_err(|_| "usage reader worker panicked")??;
+            files.extend(loaded);
+            diagnostics.malformed_records += local.malformed_records;
+            diagnostics.skipped_non_paginated += local.skipped_non_paginated;
+        }
+        Ok(files.into_values().collect::<Vec<_>>())
+    })?;
+    diagnostics.files = files.len();
+    let mut by_id = BTreeMap::new();
+    for (index, file) in files.iter().enumerate() {
+        by_id.entry(file.id.as_str()).or_insert(index);
+    }
+    let cuts: Vec<_> = files
+        .iter()
+        .enumerate()
+        .map(|(index, file)| {
+            if file.referenced_history {
+                return 0;
+            }
+            let parent = file
+                .parent
+                .as_deref()
+                .and_then(|id| by_id.get(id))
+                .filter(|&&parent| parent != index)
+                .map(|&parent| files[parent].parsed.events.as_slice())
+                .unwrap_or(&[]);
+            let limit = file.forked_at.map_or(parent.len(), |forked| {
+                parent
+                    .iter()
+                    .position(|event| event.millis > forked)
+                    .unwrap_or(parent.len())
+            });
+            replayed_prefix_length(file.parent.is_some(), &parent[..limit], &file.parsed)
+        })
+        .collect();
+    let capacity = files
+        .iter()
+        .zip(&cuts)
+        .map(|(file, cut)| file.parsed.events.len() - cut)
+        .sum();
+    let mut events = Vec::with_capacity(capacity);
+    let mut models = Vec::new();
+    let mut observations = Vec::new();
+    let mut credits = Vec::new();
+    for (rollout, cut) in files.into_iter().zip(cuts) {
+        let file = rollout.parsed;
+        diagnostics.malformed_records += file.malformed;
+        diagnostics.incomplete_tails += file.incomplete;
+        diagnostics.replayed_events += cut + file.inherited_events;
+        let model_ids: Vec<_> = file
+            .models
+            .into_iter()
+            .map(|model| intern_model(&mut models, model.into()))
+            .collect();
+        events.extend(file.events.into_iter().skip(cut).map(|mut event| {
+            event.model = model_ids[event.model];
+            event
+        }));
+        observations.extend(
+            file.observations
+                .into_iter()
+                .filter_map(|(index, sample)| (index >= cut).then_some(sample)),
+        );
+        credits.extend(
+            file.credits
+                .into_iter()
+                .filter_map(|(index, sample)| (index >= cut).then_some(sample)),
+        );
+    }
+    Ok(Events {
+        events,
+        models,
+        observations,
+        credits,
+        diagnostics,
+    })
+}
+
+fn replayed_prefix_length(has_parent: bool, parent: &[Event], child: &ParsedFile) -> usize {
+    if !has_parent {
+        return 0;
+    }
+    // Native response records already identify the owning thread. Only the leading
+    // unidentified legacy snapshots need parent matching or rewritten-burst inference.
+    let legacy_end = child
+        .events
+        .iter()
+        .position(|event| event.response.is_some())
+        .unwrap_or(child.events.len());
+    let events = &child.events[..legacy_end];
+    let matched = parent
+        .iter()
+        .zip(events)
+        .take_while(|(parent, child)| parent.tokens == child.tokens)
+        .count();
+    if matched > 0 {
+        return matched;
+    }
+    let [first, second] = child.first_usage_times.as_slice() else {
+        return 0;
+    };
+    if !(0..=1_000).contains(&(second - first)) {
+        return 0;
+    }
+    let mut previous = *first;
+    events
+        .iter()
+        .take_while(|event| {
+            let copied = (0..=1_000).contains(&(event.millis - previous));
+            previous = event.millis;
+            copied
+        })
+        .count()
+}
+
