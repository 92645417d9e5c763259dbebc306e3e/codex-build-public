+#[test]
+fn large_unrelated_rollout_payloads_preserve_accounting() {
+    let body = "retained conversation content with quoted \"text\" and a newline\n".repeat(4096);
+    for (case, item) in [
+        (
+            "plain response",
+            json!({"type":"response_item","payload":{"type":"message","role":"assistant",
+                "content":[{"type":"output_text","text":body}]}}),
+        ),
+        (
+            "response with accounting words",
+            json!({"type":"response_item","payload":{"type":"message","role":"assistant",
+                "content":[{"type":"output_text","text":format!("{body} token_usage_record")}]}}),
+        ),
+        (
+            "compacted with accounting words",
+            json!({"type":"compacted","payload":{"message":format!("{body} token_usage_record")}}),
+        ),
+        (
+            "UTF-8 response with accounting words",
+            json!({"type":"response_item","payload":{"type":"message","role":"assistant",
+                "content":[{"type":"output_text","text":format!("{} token_usage_record",
+                    "保留的用户请求和模型回复包含双引号 \"内容\" 以及换行\n".repeat(16_384))}]}}),
+        ),
+    ] {
+        let line = codex_rollout::RolloutLine {
+            timestamp: "2026-09-29T01:00:00.000Z".into(),
+            ordinal: Some(1),
+            item: serde_json::from_value(item).unwrap(),
+        };
+        let line = format!("{}\n", serde_json::to_string(&line).unwrap());
+        let text = format!("{}\n{line}{}\n", context(), snapshot());
+        let parsed = read_lines(std::io::Cursor::new(&text), "thread").unwrap();
+        assert_eq!(parsed.events.len(), 1, "{case}");
+        assert_eq!(parsed.events[0].tokens.total, 150, "{case}");
+        assert_eq!(parsed.malformed, 0, "{case}");
+        assert_eq!(parsed.incomplete, 0, "{case}");
+    }
+}
