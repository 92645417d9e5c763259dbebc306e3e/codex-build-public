+#[test]
+fn initial_snapshot_uses_ccusage_last_or_cumulative_fallback_and_retains_model() {
+    for (last, later_last, increment) in [
+        (
+            Some(json!({"total_tokens":8763})),
+            Some(json!({"total_tokens":8763})),
+            25,
+        ),
+        (None, None, 25),
+        (
+            Some(json!({"total_tokens":8203})),
+            Some(json!({"total_tokens":12872})),
+            0,
+        ),
+    ] {
+        let initial_total = if last.is_none() { 163_701 } else { 0 };
+        let mut initial = snapshot();
+        initial["payload"]["info"] = json!({
+            "total_token_usage": reported_usage(161_874, 1_827),
+            "last_token_usage": last,
+        });
+        let mut later = initial.clone();
+        initial["payload"]["model"] = json!("recorded-model");
+        later["timestamp"] = json!("2026-09-29T01:01:00.001Z");
+        later["payload"]["info"]["total_token_usage"] = reported_usage(161_894, 1_832);
+        later["payload"]["info"]["last_token_usage"] = json!(later_last);
+        let parsed = parse_values(&[initial, later.clone(), later]);
+        assert_eq!(
+            parsed.events.len(),
+            usize::from(initial_total > 0) + usize::from(increment > 0)
+        );
+        assert_eq!(
+            parsed
+                .events
+                .iter()
+                .map(|event| event.tokens.total)
+                .sum::<u64>(),
+            initial_total + increment
+        );
+        if increment > 0 {
+            let latest = parsed.events.last().unwrap();
+            assert_eq!(latest.tokens.input, 20);
+            assert_eq!(latest.tokens.output, 5);
+            assert_eq!(parsed.models[latest.model], "recorded-model");
+        }
+        assert_eq!(parsed.credits.len(), parsed.events.len());
+        assert!(parsed.observations.is_empty());
+        assert_eq!(parsed.malformed, 0);
+    }
+}
