+        assert_eq!(parsed.events.len(), if previous_completion { 2 } else { 1 });
+        assert_eq!(parsed.events.last().unwrap().tokens.total, 25);
+        assert_eq!(
+            parsed
+                .events
+                .iter()
+                .map(|event| event.tokens.total)
+                .sum::<u64>(),
+            if previous_completion { 175 } else { 25 },
+        );
+    }
