+#[test]
+fn native_rollout_order_preserves_response_records_and_deferred_snapshots() {
+    let mut response = response_record("response", usage(), "2026-09-29T01:00:00.000Z");
+    let payload = &mut response["payload"];
+    payload["thread_id"] = json!("00000000-0000-0000-0000-000000000001");
+    payload["session_id"] = json!("00000000-0000-0000-0000-000000000002");
+    payload["turn_id"] = json!("turn");
+    payload["root_turn_id"] = json!("turn");
+    payload["turn_token_usage"] = usage();
+    payload["thread_token_usage"] = usage();
+    for ordinal in [None, Some(4)] {
+        for prefix in ["", " "] {
+            let mut text = format!("{}\n", context());
+            for value in [response.clone(), snapshot()] {
+                let line = codex_rollout::RolloutLine {
+                    timestamp: value["timestamp"].as_str().unwrap().to_owned(),
+                    ordinal,
+                    item: serde_json::from_value(value).unwrap(),
+                };
+                let line = serde_json::to_string(&line).unwrap();
+                assert_eq!(native_accounting_record(line.as_bytes()), Some(true));
+                text.push_str(&format!("{prefix}{line}\n"));
+            }
+            let parsed = read_lines(
+                std::io::Cursor::new(text),
+                "00000000-0000-0000-0000-000000000001",
+            )
+            .unwrap();
+            assert_eq!(parsed.events.len(), 1);
+            assert_eq!(parsed.events[0].tokens.total, 150);
+            assert_eq!(parsed.events[0].millis, 1_790_643_600_000);
+            assert_eq!(parsed.events[0].quota_millis, 1_790_643_600_001);
+            assert_eq!(parsed.malformed, 0);
+        }
+    }
+}
