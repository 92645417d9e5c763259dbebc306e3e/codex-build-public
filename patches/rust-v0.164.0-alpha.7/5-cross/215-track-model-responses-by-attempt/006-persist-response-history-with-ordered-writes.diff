+//! One ordered writer keeps disk work outside response generation.
+
+use super::RECENT_RESPONSE_LIMIT;
+use super::ResponseHistory;
+use codex_protocol::response_metrics::ResponseAttempt;
+use codex_state::ResponseHistoryStore;
+use std::sync::Weak;
+use std::time::Duration;
+use tokio::sync::mpsc;
+use tokio::sync::oneshot;
+use tokio::sync::watch;
+
+// Each attempt already includes the native SQLite busy timeout. Keep retries
+// finite so flush and shutdown can report a persistent lock instead of hanging.
+const WRITE_RETRY_DELAYS: [Duration; 3] = [
+    Duration::from_millis(250),
+    Duration::from_millis(500),
+    Duration::from_secs(1),
+];
+
+#[derive(Debug)]
+pub(super) struct Backup {
+    sender: mpsc::UnboundedSender<Command>,
+    status: watch::Receiver<Option<Result<ResponseHistoryStore, String>>>,
+}
+
+enum Command {
+    Write(ResponseAttempt),
+    Flush(oneshot::Sender<Result<(), String>>),
+}
+
+impl Backup {
+    pub(super) fn start(
+        store: Option<ResponseHistoryStore>,
+        history: Weak<ResponseHistory>,
+    ) -> Self {
+        let (sender, mut receiver) = mpsc::unbounded_channel();
+        let (status_tx, status) = watch::channel(None);
+        tokio::spawn(async move {
+            let store = async {
+                let store =
+                    store.ok_or_else(|| anyhow::anyhow!("native response storage unavailable"))?;
+                let page = store
+                    .page(None, None, None, None, RECENT_RESPONSE_LIMIT)
+                    .await?;
+                let models = store.models().await?;
+                let last_generations = store.last_generations().await?;
+                if let Some(history) = history.upgrade() {
+                    history.restore(page, models, last_generations);
+                }
+                anyhow::Ok(store)
+            }
+            .await;
+            let mut failure = store.as_ref().err().map(|error| format!("{error:#}"));
+            if let Some(error) = &failure {
+                tracing::warn!(%error, "response history unavailable");
+            }
+            status_tx.send_replace(Some(match &store {
+                Ok(store) => Ok(store.clone()),
+                Err(error) => Err(format!("{error:#}")),
+            }));
+            while let Some(command) = receiver.recv().await {
+                match command {
+                    Command::Write(record) => {
+                        if let Ok(store) = &store {
+                            let mut delays = WRITE_RETRY_DELAYS.into_iter();
+                            loop {
+                                let Err(error) = store.write(&record).await else {
+                                    if status_tx.borrow().as_ref().is_some_and(Result::is_err) {
+                                        // Clear only a recovered write's transient error. A
+                                        // different record cannot repair a terminal failure.
+                                        status_tx.send_replace(Some(
+                                            failure.clone().map_or_else(|| Ok(store.clone()), Err),
+                                        ));
+                                    }
+                                    break;
+                                };
+                                let delay = is_sqlite_busy(&error).then(|| delays.next()).flatten();
+                                let error = format!("{error:#}");
+                                status_tx.send_replace(Some(Err(error.clone())));
+                                if let Some(delay) = delay {
+                                    // Retain this exact revision ahead of all later writes
+                                    // and barriers; response publication remains independent.
+                                    tokio::time::sleep(delay).await;
+                                } else {
+                                    tracing::warn!(
+                                        %error,
+                                        attempt_id = %record.attempt_id,
+                                        revision = record.revision,
+                                        "could not persist response history"
+                                    );
+                                    failure = Some(error);
+                                    break;
+                                }
+                            }
+                        }
+                    }
+                    Command::Flush(reply) => {
+                        let _ = reply.send(failure.clone().map_or(Ok(()), Err));
+                    }
+                }
+            }
+        });
+        Self { sender, status }
+    }
+
+    pub(super) fn write(&self, record: ResponseAttempt) {
+        // Dropping the last sender lets the worker drain accepted writes.
+        if self.sender.send(Command::Write(record)).is_err() {
+            tracing::warn!("response history writer stopped");
+        }
+    }
+
+    pub(super) fn error(&self) -> Option<String> {
+        if self.sender.is_closed() {
+            return Some("response history writer stopped".into());
+        }
+        self.status
+            .borrow()
+            .as_ref()
+            .and_then(|status| status.as_ref().err())
+            .cloned()
+    }
+
+    pub(super) fn is_ready(&self) -> bool {
+        self.status.borrow().is_some()
+    }
+
+    pub(super) async fn ready(&self) -> Result<ResponseHistoryStore, String> {
+        let mut status = self.status.clone();
+        status
+            .wait_for(Option::is_some)
+            .await
+            .map_err(|_| "response history writer stopped".to_owned())?
+            .as_ref()
+            .expect("initialized response history")
+            .clone()
+    }
+
+    pub(super) async fn flush(&self) -> Result<(), String> {
+        let (reply, done) = oneshot::channel();
+        self.sender
+            .send(Command::Flush(reply))
+            .map_err(|_| "response history writer stopped".to_owned())?;
+        done.await
+            .map_err(|_| "response history writer stopped".to_owned())?
+    }
+}
+
+fn is_sqlite_busy(error: &anyhow::Error) -> bool {
+    error
+        .downcast_ref::<sqlx::Error>()
+        .and_then(sqlx::Error::as_database_error)
+        .and_then(|error| error.code())
+        .and_then(|code| code.parse::<i32>().ok())
+        // SQLite's low byte is the primary result code, including BUSY extensions.
+        .is_some_and(|code| code & 0xff == 5)
+}
