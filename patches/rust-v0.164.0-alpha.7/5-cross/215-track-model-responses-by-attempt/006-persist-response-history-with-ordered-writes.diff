+use std::time::Duration;
+
+#[tokio::test]
+async fn live_and_restored_history_exclude_expired_records_before_maintenance() {
+    let home = tempfile::tempdir().unwrap();
+    let (metrics, history, _runtime) = recording(home.path()).await;
+    let now = chrono::Utc::now().timestamp();
+    let mut expired_context = context();
+    expired_context.requested_model = "expired-model".into();
+    let expired = metrics.start(
+        expired_context,
+        Instant::now(),
+        now - DIAGNOSTIC_RETENTION_SECONDS - 1,
+    );
+    expired.ended(ResponseAttemptEnd::Completed, Instant::now());
+    let current = metrics.start(context(), Instant::now(), now);
+    current.ended(ResponseAttemptEnd::Completed, Instant::now());
+    history.flush().await.unwrap();
+    let expected = history.notification_snapshot();
+    assert_eq!(expected.len(), 1);
+    let reopened = Arc::new(ResponseHistory::new(history.store.clone()));
+    for source in [&history, &reopened] {
+        let page = source.page(None, None, None, None, 100).await;
+        assert_eq!(page.persistence_error, None);
+        assert_eq!(page.data, expected);
+        assert_eq!(page.models, vec!["model"]);
+        assert_eq!(
+            page.last_generation.unwrap().attempt_id,
+            expected[0].attempt_id
+        );
+        assert_eq!(source.notification_snapshot(), expected);
+    }
+}
+
+#[tokio::test]
+async fn ordered_backup_preserves_final_tokens_and_freezes_unfinished_records() {
+    let home = tempfile::tempdir().unwrap();
+    let (metrics, history, _runtime) = recording(home.path()).await;
+    let attempt = metrics.start(context(), Instant::now(), chrono::Utc::now().timestamp());
+    attempt.sent(Instant::now());
+    attempt.received(
+        ResponseObservation {
+            usage: Some(json!({"input_tokens": 80, "input_tokens_details": {
+            "cached_tokens": 40, "cache_write_tokens": 10}, "output_tokens": 30,
+            "output_tokens_details": {"reasoning_tokens": 20}})),
+            terminal: Some(ResponseAttemptEnd::Failed),
+            ..Default::default()
+        },
+        Instant::now(),
+    );
+    let unfinished = metrics.start(context(), Instant::now(), chrono::Utc::now().timestamp());
+    unfinished.sent(Instant::now());
+    // No yield: the response writer has not run, but the consumer already owns
+    // the final accounting and live record independently of storage readiness.
+    let finished = history.notification_snapshot()[1].clone();
+    assert_eq!(finished.tokens.reasoning, Some(20));
+    history.flush().await.unwrap();
+    assert!(
+        SqliteConfig::new_for_testing(home.path().abs())
+            .logs_db_path()
+            .is_file()
+    );
+    let reopened = Arc::new(ResponseHistory::new(history.store.clone()));
+    let page = reopened.page(None, None, None, None, 100).await;
+    assert!(page.persistence_error.is_none());
+    assert_eq!(page.data[1], finished);
+    assert_eq!(page.data[0].end_reason, None);
+    assert!(page.active_attempt_ids.is_empty());
+    assert_eq!(
+        page.last_generation.unwrap().attempt_id,
+        finished.attempt_id
+    );
+    assert_eq!(reopened.notification_snapshot(), vec![finished]);
+    let working = reopened
+        .page(None, None, Some(ResponseAttemptStatus::Working), None, 100)
+        .await;
+    assert!(working.data.is_empty());
+    assert_eq!(working.next_cursor, None);
+    let retained_unfinished = reopened
+        .page(
+            None,
+            None,
+            Some(ResponseAttemptStatus::Unfinished),
+            None,
+            100,
+        )
+        .await;
+    assert_eq!(retained_unfinished.data, page.data[..1]);
+    // Restored records have no live tracker or synthetic monotonic clock.
+    tokio::time::pause();
+    tokio::time::advance(Duration::from_secs(60)).await;
+    assert_eq!(
+        reopened.page(None, None, None, None, 100).await.data,
+        page.data
+    );
+    tokio::time::resume();
+    drop(unfinished);
+    history.flush().await.unwrap();
+}
+
+#[tokio::test]
+async fn filtered_history_survives_eviction_restart_and_newer_insertions() {
+    let home = tempfile::tempdir().unwrap();
+    let (metrics, history, runtime) = recording(home.path()).await;
+    let selected = context();
+    let thread_id = selected.thread_id;
+    let oldest = metrics.start(selected, Instant::now(), chrono::Utc::now().timestamp());
+    oldest.ended(ResponseAttemptEnd::Completed, Instant::now());
+    let expected = history.notification_snapshot()[0].clone();
+    for _ in 0..RECENT_RESPONSE_LIMIT {
+        let mut context = context();
+        context.requested_model = "other-model".into();
+        let attempt = metrics.start(context, Instant::now(), chrono::Utc::now().timestamp());
+        attempt.ended(ResponseAttemptEnd::Completed, Instant::now());
+    }
+    history.flush().await.unwrap();
+    runtime.close().await;
+    let (reopened_metrics, reopened, _reopened_runtime) = recording(home.path()).await;
+    let first = reopened
+        .page(
+            thread_id,
+            Some("model"),
+            Some(ResponseAttemptStatus::Completed),
+            None,
+            100,
+        )
+        .await;
+    assert!(first.data.is_empty());
+    assert_eq!(first.models, vec!["model", "other-model"]);
+    assert_eq!(
+        first.last_generation.unwrap().attempt_id,
+        expected.attempt_id
+    );
+    let cursor = Uuid::parse_str(&first.next_cursor.unwrap()).unwrap();
+    let new = reopened_metrics.start(context(), Instant::now(), chrono::Utc::now().timestamp());
+    let older = reopened
+        .page(
+            thread_id,
+            Some("model"),
+            Some(ResponseAttemptStatus::Completed),
+            Some(cursor),
+            100,
+        )
+        .await;
+    assert_eq!(older.data, vec![expected]);
+    assert_eq!(older.next_cursor, None);
+    assert_eq!(older.active_attempt_ids.len(), 1);
+    drop(new);
+    reopened.flush().await.unwrap();
+}
+
+#[tokio::test]
+async fn storage_failure_is_visible_without_losing_live_records() {
+    let home = tempfile::tempdir().unwrap();
+    let (metrics, history, runtime) = recording(home.path()).await;
+    runtime.close().await;
+    let attempt = metrics.start(context(), Instant::now(), chrono::Utc::now().timestamp());
+    attempt.ended(ResponseAttemptEnd::Canceled, Instant::now());
+    assert!(history.flush().await.is_err());
+    let page = history.page(None, None, None, None, 100).await;
+    assert_eq!(page.data, history.notification_snapshot());
+    assert!(page.persistence_error.unwrap().contains("closed"));
+}
+
+#[tokio::test]
+async fn unavailable_native_storage_preserves_live_records_and_reports_failure() {
+    let history = Arc::new(ResponseHistory::new(None));
+    let retained = Arc::clone(&history);
+    let metrics = Arc::new(crate::ResponseMetrics::new(move |record| {
+        retained.record(record)
+    }));
+    let attempt = metrics.start(context(), Instant::now(), chrono::Utc::now().timestamp());
+    attempt.ended(ResponseAttemptEnd::Completed, Instant::now());
+    assert!(history.flush().await.is_err());
+    let page = history.page(None, None, None, None, 100).await;
+    assert_eq!(page.data, history.notification_snapshot());
+    assert_eq!(
+        page.persistence_error.as_deref(),
+        Some("native response storage unavailable")
+    );
+}
