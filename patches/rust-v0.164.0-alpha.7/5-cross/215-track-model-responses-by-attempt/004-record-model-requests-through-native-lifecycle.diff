--- /dev/null
+++ b/codex-rs/core/tests/suite/client_websockets_recording_tests.rs
@@ -0,0 +1,287 @@
+use super::*;
+use codex_protocol::response_metrics::ResponseAttemptEnd;
+use core_test_support::responses::ev_output_text_delta;
+use core_test_support::responses::ev_reasoning_item;
+use core_test_support::responses::ev_reasoning_item_added;
+use core_test_support::responses::ev_reasoning_summary_text_delta;
+use core_test_support::responses::mount_response_sequence;
+use core_test_support::responses::sse;
+use core_test_support::responses::sse_response;
+use core_test_support::responses::start_mock_server;
+use pretty_assertions::assert_eq;
+use serde_json::Value;
+
+fn personal_auth(plan: &str) -> CodexAuth {
+    CodexAuth::from_external_chatgpt_tokens("header.e30.signature", "selected-account", Some(plan))
+        .unwrap()
+}
+
+#[tokio::test]
+async fn incomplete_responses_preserve_reported_usage_and_the_original_error() {
+    skip_if_no_network!();
+    for auth in [personal_auth("plus"), CodexAuth::from_api_key("dummy")] {
+        for usage in [
+            json!({
+                "input_tokens": 100,
+                "input_tokens_details": {"cached_tokens": 60},
+                "output_tokens": 20,
+                "output_tokens_details": {"reasoning_tokens": 15},
+                "total_tokens": 120
+            }),
+            Value::Null,
+        ] {
+            let server = start_websocket_server(vec![vec![vec![
+                ev_response_created("incomplete"),
+                ev_output_text_delta("partial answer"),
+                json!({"type": "response.incomplete", "response": {
+                    "id": "incomplete", "model": "served-model", "usage": usage,
+                    "incomplete_details": {"reason": "max_output_tokens"}
+                }}),
+            ]]])
+            .await;
+            let harness = websocket_harness_with_provider_options_and_auth(
+                websocket_provider(&server),
+                false,
+                false,
+                &[],
+                Some(auth.clone()),
+            )
+            .await;
+            let mut session = harness.client.new_session();
+            let mut stream = session
+                .stream(
+                    &prompt_with_input(vec![message_item("hello")]),
+                    &harness.model_info,
+                    &harness.session_telemetry,
+                    harness.effort.clone(),
+                    harness.summary,
+                    None,
+                    &turn_metadata(&harness, Some("turn-incomplete")),
+                    &InferenceTraceContext::disabled(),
+                )
+                .await
+                .unwrap();
+            let mut failure = None;
+            while let Some(event) = stream.next().await {
+                match event {
+                    Ok(ResponseEvent::Completed { .. }) => panic!("incomplete response completed"),
+                    Ok(_) => {}
+                    Err(error) => {
+                        failure = Some(error);
+                        break;
+                    }
+                }
+            }
+            let error = failure.expect("native incomplete error");
+            let codex_protocol::error::CodexErrorDetails::ResponseIncomplete(incomplete) =
+                error.details()
+            else {
+                panic!("unexpected error: {error:?}");
+            };
+            assert_eq!(incomplete.reason, "max_output_tokens");
+            assert_eq!(incomplete.response_id.as_deref(), Some("incomplete"));
+            assert_eq!(
+                incomplete
+                    .token_usage
+                    .as_ref()
+                    .map(|usage| usage.total_tokens),
+                usage.is_object().then_some(120)
+            );
+            let rows = harness.response_attempts();
+            assert_eq!(rows.len(), 1);
+            assert_eq!(rows[0].response_id.as_deref(), Some("incomplete"));
+            assert_eq!(rows[0].end_reason, Some(ResponseAttemptEnd::Incomplete));
+            assert_eq!(rows[0].served_model.as_deref(), Some("served-model"));
+            assert_eq!(rows[0].tokens.input, usage.is_object().then_some(100));
+            assert_eq!(rows[0].tokens.cache_read, usage.is_object().then_some(60));
+            assert_eq!(rows[0].tokens.output, usage.is_object().then_some(20));
+            assert_eq!(rows[0].tokens.reasoning, usage.is_object().then_some(15));
+            assert!(rows[0].sent_payload_bytes.is_some());
+            assert!(rows[0].received_payload_bytes > 0);
+            server.shutdown().await;
+        }
+    }
+}
+
+#[tokio::test]
+async fn http_retries_do_not_create_response_records() {
+    skip_if_no_network!();
+    let server = start_mock_server().await;
+    let mut completed = ev_completed("http-response");
+    completed["response"]["usage"] = json!({
+        "input_tokens": 100, "input_tokens_details": {"cached_tokens": 60, "cache_write_tokens": 10},
+        "output_tokens": 20, "output_tokens_details": {"reasoning_tokens": 15}, "total_tokens": 120
+    });
+    let events = vec![
+        ev_response_created("http-response"),
+        ev_output_text_delta("answer"),
+        completed,
+    ];
+    let requests = mount_response_sequence(
+        &server,
+        vec![
+            wiremock::ResponseTemplate::new(503),
+            sse_response(sse(events)),
+        ],
+    )
+    .await;
+    let mut provider =
+        ModelProviderInfo::create_openai_provider(Some(format!("{}/v1", server.uri())));
+    provider.supports_websockets = false;
+    provider.request_max_retries = Some(1);
+    let harness = websocket_harness_with_provider_options_and_auth(
+        provider,
+        false,
+        false,
+        &[],
+        Some(CodexAuth::from_api_key("dummy")),
+    )
+    .await;
+    let mut session = harness.client.new_session();
+    let mut stream = session
+        .stream(
+            &prompt_with_input(vec![message_item("private input")]),
+            &harness.model_info,
+            &harness.session_telemetry,
+            harness.effort.clone(),
+            harness.summary,
+            None,
+            &turn_metadata(&harness, Some("turn-http")),
+            &InferenceTraceContext::disabled(),
+        )
+        .await
+        .unwrap();
+    let mut output = String::new();
+    while let Some(event) = stream.next().await {
+        if let ResponseEvent::OutputTextDelta(delta) = event.unwrap() {
+            output.push_str(&delta);
+        }
+    }
+    assert_eq!(output, "answer");
+    assert_eq!(requests.requests().len(), 2);
+    assert!(harness.response_attempts().is_empty());
+}
+
+#[tokio::test]
