+//! Per-response transport and accounting facts shared by history and presentation.
+
+use crate::ThreadId;
+use schemars::JsonSchema;
+use serde::Deserialize;
+use serde::Serialize;
+use ts_rs::TS;
+use uuid::Uuid;
+
+/// Counts reported by the provider, measured in tokens rather than content bytes.
+/// Missing or invalid usage is unknown, distinct from a reported zero.
+#[derive(Debug, Clone, Default, PartialEq, Eq, Serialize, Deserialize, JsonSchema, TS)]
+#[serde(rename_all = "camelCase")]
+pub struct ResponseTokenCounts {
+    #[ts(type = "number | null")]
+    pub input: Option<u64>,
+    #[ts(type = "number | null")]
+    pub cache_read: Option<u64>,
+    #[ts(type = "number | null")]
+    pub cache_write: Option<u64>,
+    #[ts(type = "number | null")]
+    pub output: Option<u64>,
+    #[ts(type = "number | null")]
+    pub reasoning: Option<u64>,
+}
+
+#[derive(
+    Debug,
+    Clone,
+    Copy,
+    PartialEq,
+    Eq,
+    Serialize,
+    Deserialize,
+    JsonSchema,
+    TS,
+    strum_macros::AsRefStr,
+    strum_macros::EnumString,
+)]
+#[serde(rename_all = "camelCase")]
+#[ts(rename_all = "camelCase")]
+#[strum(serialize_all = "camelCase")]
+pub enum ResponseAttemptEnd {
+    Completed,
+    Incomplete,
+    Failed,
+    Interrupted,
+    Canceled,
+    SetupFailed,
+    SendFailed,
+    TransportClosed,
+    ProgressTimeout,
+    ProtocolError,
+}
+
+/// Current query status, derived from a record and its live-process ownership.
+#[derive(
+    Debug,
+    Clone,
+    Copy,
+    PartialEq,
+    Eq,
+    Serialize,
+    Deserialize,
+    JsonSchema,
+    TS,
+    strum_macros::AsRefStr,
+)]
+#[serde(rename_all = "camelCase")]
+#[ts(rename_all = "camelCase")]
+#[strum(serialize_all = "camelCase")]
+pub enum ResponseAttemptStatus {
+    Working,
+    Received,
+    Unfinished,
+    Completed,
+    Incomplete,
+    Failed,
+    Interrupted,
+    Canceled,
+    SetupFailed,
+    SendFailed,
+    TransportClosed,
+    ProgressTimeout,
+    ProtocolError,
+}
+
+/// One actual request attempt. Transport time excludes buffered output delivery.
+#[derive(Debug, Clone, PartialEq, Serialize, Deserialize, JsonSchema, TS)]
+#[serde(rename_all = "camelCase")]
+pub struct ResponseAttempt {
+    /// Internal time-ordered key for snapshots, storage, and pagination.
+    #[schemars(with = "String")]
+    pub attempt_id: Uuid,
+    /// Orders snapshots and notifications of the same attempt.
+    #[ts(type = "number")]
+    pub revision: u64,
+    /// Existing session identity, absent for requests made outside a session.
+    pub thread_id: Option<ThreadId>,
+    /// Existing turn identity used to isolate live progress from other turns.
+    pub turn_id: Option<String>,
+    /// Official provider response ID, absent before the provider supplies it.
+    pub response_id: Option<String>,
+    pub request_kind: String,
+    pub requested_model: String,
+    pub served_model: Option<String>,
+    pub reasoning_effort: Option<String>,
+    /// Unix seconds; elapsed fields use the monotonic transport clock.
+    #[ts(type = "number")]
+    pub started_at: i64,
+    /// Dispatch to the first nonempty model-protocol payload.
+    #[ts(type = "number | null")]
+    pub ttfb_ms: Option<u64>,
+    /// Send to the first nonempty model-content field.
+    #[ts(type = "number | null")]
+    pub ttfc_ms: Option<u64>,
+    #[ts(type = "number | null")]
+    pub terminal_observed_offset_ms: Option<u64>,
+    /// Setup plus receipt time, frozen at the response boundary.
+    #[ts(type = "number")]
+    pub elapsed_ms: u64,
+    /// Model-protocol UTF-8 payload bytes, excluding transport overhead.
+    #[ts(type = "number | null")]
+    pub sent_payload_bytes: Option<u64>,
+    /// Model-protocol UTF-8 payload bytes, excluding transport overhead.
+    #[ts(type = "number")]
+    pub received_payload_bytes: u64,
+    /// None also represents an unfinished record retained from an earlier process.
+    pub end_reason: Option<ResponseAttemptEnd>,
+    pub tokens: ResponseTokenCounts,
+    /// Reported output tokens per send-to-usage second, including upstream waiting.
+    pub tps: Option<f64>,
+}
+
+impl ResponseAttempt {
+    /// Only the process currently observing an attempt may classify it as working.
+    pub fn status(&self, active: bool) -> ResponseAttemptStatus {
+        match self.end_reason {
+            Some(ResponseAttemptEnd::Completed) => ResponseAttemptStatus::Completed,
+            Some(ResponseAttemptEnd::Incomplete) => ResponseAttemptStatus::Incomplete,
+            Some(ResponseAttemptEnd::Failed) => ResponseAttemptStatus::Failed,
+            Some(ResponseAttemptEnd::Interrupted) => ResponseAttemptStatus::Interrupted,
+            Some(ResponseAttemptEnd::Canceled) => ResponseAttemptStatus::Canceled,
+            Some(ResponseAttemptEnd::SetupFailed) => ResponseAttemptStatus::SetupFailed,
+            Some(ResponseAttemptEnd::SendFailed) => ResponseAttemptStatus::SendFailed,
+            Some(ResponseAttemptEnd::TransportClosed) => ResponseAttemptStatus::TransportClosed,
+            Some(ResponseAttemptEnd::ProgressTimeout) => ResponseAttemptStatus::ProgressTimeout,
+            Some(ResponseAttemptEnd::ProtocolError) => ResponseAttemptStatus::ProtocolError,
+            None if self.terminal_observed_offset_ms.is_some() => ResponseAttemptStatus::Received,
+            None if active => ResponseAttemptStatus::Working,
+            None => ResponseAttemptStatus::Unfinished,
+        }
+    }
+}
+
+/// Timing facts retained after a full record leaves the recent queue.
+#[derive(Debug, Clone, PartialEq, Serialize, Deserialize, JsonSchema, TS)]
+#[serde(rename_all = "camelCase")]
+pub struct ResponsePerformance {
+    #[schemars(with = "String")]
+    pub attempt_id: Uuid,
+    pub thread_id: Option<ThreadId>,
+    #[ts(type = "number | null")]
+    pub ttfb_ms: Option<u64>,
+    #[ts(type = "number | null")]
+    pub ttfc_ms: Option<u64>,
+    pub tps: Option<f64>,
+}
+
+/// Typical and slow-end percentiles of the known values of one metric.
+/// Percentiles linearly interpolate the sorted samples at `(count - 1) * fraction`.
+#[derive(Debug, Clone, PartialEq, Serialize, Deserialize, JsonSchema, TS)]
+#[serde(rename_all = "camelCase")]
+pub struct ResponseTimingSummary {
+    #[ts(type = "number")]
+    pub sample_count: u64,
+    pub p50: f64,
+    /// P05 for throughput, P95 for time to first content.
+    pub slow: f64,
+}
+
+/// One requested model's latest ended generation and rolling 24-hour percentiles.
+/// Percentiles include ended generation attempts started in the window, omit unknown
+/// values and retain zero. Latest-generation metrics remain available outside the
+/// statistical window until the 36-hour diagnostic retention window expires.
+#[derive(Debug, Clone, PartialEq, Serialize, Deserialize, JsonSchema, TS)]
+#[serde(rename_all = "camelCase")]
+pub struct ResponseModelTiming {
+    pub requested_model: String,
+    /// Completed generation attempts started in the rolling 24-hour window.
+    #[ts(type = "number")]
+    pub successful_attempts: u64,
+    /// All generation attempts started in that window, including unfinished attempts.
+    #[ts(type = "number")]
+    pub total_attempts: u64,
+    pub last_tps: Option<f64>,
+    #[ts(type = "number | null")]
+    pub last_ttfc_ms: Option<u64>,
+    /// Throughput P50/P05 and the count of known TPS samples.
+    pub tps: Option<ResponseTimingSummary>,
+    /// Time-to-first-content P50/P95 and the count of known TTFC samples.
+    pub ttfc_ms: Option<ResponseTimingSummary>,
+}
+
+/// Shared generation timing facts grouped by the verbatim requested model identifier.
+#[derive(Debug, Clone, Default, PartialEq, Serialize, Deserialize, JsonSchema, TS)]
+#[serde(rename_all = "camelCase")]
+pub struct ResponseTimingReadResponse {
+    pub models: Vec<ResponseModelTiming>,
+    /// Completed generation attempts across all models in the rolling 24-hour window.
+    #[ts(type = "number")]
+    pub successful_attempts: u64,
+    /// All generation attempts across all models in that window.
+    #[ts(type = "number")]
+    pub total_attempts: u64,
+    /// Live samples remain available when the historical backup is unavailable.
+    pub persistence_error: Option<String>,
+}
+
+impl From<&ResponseAttempt> for ResponsePerformance {
+    fn from(row: &ResponseAttempt) -> Self {
+        Self {
+            attempt_id: row.attempt_id,
+            thread_id: row.thread_id,
+            ttfb_ms: row.ttfb_ms,
+            ttfc_ms: row.ttfc_ms,
+            tps: row.tps,
+        }
+    }
+}
