+#[tokio::test]
+async fn interleaved_reasoning_keeps_its_call_positions_when_parallel_tools_finish() {
+    use codex_app_server_protocol::McpToolCallStatus;
+    let (mut chat, mut events, _ops) = make_chatwidget_manual(None).await;
+    chat.local_settings.tui.fullscreen_transcript = true;
+    chat.on_mcp_tool_call_started(computer_item("first", McpToolCallStatus::InProgress));
+    chat.on_reasoning_item_started("reasoning-first".into());
+    chat.on_agent_reasoning_delta("Between the two calls".into());
+    chat.on_agent_reasoning_final();
+    for raw in [false, true] {
+        chat.set_raw_output_mode(raw);
+        for tools_visible in [false, true] {
+            for expanded in [false, true] {
+                let live = chat
+                    .active_cell_owned_transcript_lines(80, expanded, tools_visible)
+                    .unwrap();
+                let text = lines_to_single_string(&crate::terminal_hyperlinks::visible_lines(
+                    live.activity.into_iter().chain(live.auxiliary).collect(),
+                ));
+                assert_eq!(text.matches("Between the two calls").count(), 1);
+            }
+        }
+    }
+    chat.set_raw_output_mode(false);
+    chat.on_mcp_tool_call_started(computer_item("second", McpToolCallStatus::InProgress));
+    chat.on_mcp_tool_call_completed(computer_item("second", McpToolCallStatus::Completed));
+    chat.on_reasoning_item_started("reasoning-second".into());
+    chat.on_agent_reasoning_delta("After both calls".into());
+    chat.on_agent_reasoning_final();
+    assert!(drain_insert_history(&mut events).is_empty());
+    chat.on_mcp_tool_call_completed(computer_item("first", McpToolCallStatus::Completed));
+    let rendered = drain_insert_history(&mut events)
+        .iter()
+        .map(|lines| lines_to_single_string(lines))
+        .collect::<String>();
+    let first = rendered.find("Inspect page first").unwrap();
+    let between = rendered.find("Between the two calls").unwrap();
+    let second = rendered.find("Inspect page second").unwrap();
+    let after = rendered.find("After both calls").unwrap();
+    assert!(first < between && between < second && second < after);
+    assert_eq!(rendered.matches("Between the two calls").count(), 1);
+    insta::assert_snapshot!(rendered);
+}
