+
+    /// Pending calls retain one mutable owner until completion. Publication moves
+    /// calls into their original reasoning-delimited groups for independent visibility.
+    pub(crate) fn into_history_parts(
+        self,
+        wrap: impl Fn(Self) -> Box<dyn HistoryCell>,
+    ) -> Vec<Box<dyn HistoryCell>> {
+        let mut parts = Vec::new();
+        let mut calls = self.calls.into_iter();
+        let mut group = Self::new(Vec::new());
+        let mut preceding = 0;
+        for (position, detail) in self.details.entries {
+            group
+                .calls
+                .extend(calls.by_ref().take(position - preceding));
+            preceding = position;
+            if let Some(reasoning) = detail.as_any().downcast_ref::<ReasoningSummaryCell>()
+                && !reasoning.is_transcript_only()
+            {
+                if !group.calls.is_empty() || !group.details.entries.is_empty() {
+                    parts.push(wrap(group));
+                    group = Self::new(Vec::new());
+                }
+                // Retained pages can share detail cells. The native history event
+                // requires independent ownership without losing the Markdown source.
+                parts.push(Box::new(reasoning.clone()));
+            } else {
+                group.push_detail(detail);
+            }
+        }
+        group.calls.extend(calls);
+        if !group.calls.is_empty() || !group.details.entries.is_empty() {
+            parts.push(wrap(group));
+        }
+        parts
+    }
 }
