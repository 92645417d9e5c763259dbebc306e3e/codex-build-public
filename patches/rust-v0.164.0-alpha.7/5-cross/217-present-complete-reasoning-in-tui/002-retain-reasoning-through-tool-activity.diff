+        let (mut chat, mut events, _ops) = make_chatwidget_manual(None).await;
+        chat.local_settings.tui.fullscreen_transcript = true;
+        let item = begin_exec(&mut chat, "pending-command", command);
+        chat.on_reasoning_item_started("pending-reasoning".into());
+        chat.on_agent_reasoning_delta("Preserved reasoning".into());
+        chat.on_agent_reasoning_final();
+        assert!(drain_insert_history(&mut events).is_empty());
+        for raw in [false, true] {
+            chat.set_raw_output_mode(raw);
+            for tools_visible in [false, true] {
+                for expanded in [false, true] {
+                    let live = chat
+                        .active_cell_owned_transcript_lines(80, expanded, tools_visible)
+                        .unwrap();
+                    let text = lines_to_single_string(&crate::terminal_hyperlinks::visible_lines(
+                        live.activity.into_iter().chain(live.auxiliary).collect(),
+                    ));
+                    assert_eq!(text.matches("Preserved reasoning").count(), 1);
+                }
+            }
+        }
+        chat.set_raw_output_mode(false);
+        end_exec(&mut chat, item, "Complete command output\n", "", 0);
+        let cells = drain_insert_history_transcript(&mut events);
+        assert_eq!(cells.len(), 2);
+        let command_text = lines_to_single_string(&cells[0]);
+        assert!(command_text.contains(command));
+        assert!(command_text.contains("Complete command output"));
+        assert_eq!(
+            lines_to_single_string(&cells[1])
+                .matches("Preserved reasoning")
+                .count(),
+            1
+        );
+    }
+}
