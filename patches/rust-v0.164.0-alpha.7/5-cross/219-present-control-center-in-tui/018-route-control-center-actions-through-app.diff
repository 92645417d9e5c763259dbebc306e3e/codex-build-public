+    assert!(fixture.events.try_recv().is_err());
+    fixture.dispatch(event).await?;
+    let event = tokio::time::timeout(Duration::from_secs(10), fixture.events.recv())
+        .await?
+        .expect("confirmed notification result");
+    let saved_config = match &event {
+        AppEvent::TelegramCommandFinished {
+            kind: TelegramCommandKind::SetNotification,
+            result: Ok(config),
+        } => config.clone(),
+        _ => panic!("expected successful notification write"),
+    };
+    assert!(
+        saved_config
+            .notifications
+            .contains(&TelegramNotificationKind::NeedsInput)
+    );
+    fixture.dispatch(event).await?;
+    let saved = std::fs::read(&path)?;
+    assert_ne!(saved, original);
+    fixture.key(KeyCode::Enter).await?;
+    let event = fixture.events.try_recv()?;
+    assert!(matches!(event, AppEvent::OpenTelegramNotifications));
+    fixture.dispatch(event).await?;
+    assert!(fixture.text().contains("[x] Input needed"));
+    fixture.key(KeyCode::Down).await?;
+    fixture.key(KeyCode::Char(' ')).await?;
+    fixture.key(KeyCode::Esc).await?;
+    assert!(fixture.events.try_recv().is_err());
+    assert_eq!(std::fs::read(&path)?, saved);
+    assert_eq!(
+        fixture.center().dialogs.last().unwrap().selected_index(),
+        Some(0)
+    );
+    fixture.key(KeyCode::Down).await?;
+    fixture.key(KeyCode::Enter).await?;
+    let event = fixture.events.try_recv()?;
+    assert!(matches!(
+        event,
+        AppEvent::TelegramCommand {
+            params: TelegramCommandParams::Disable {}
+        }
+    ));
+    fixture.dispatch(event).await?;
+    let event = tokio::time::timeout(Duration::from_secs(10), fixture.events.recv())
+        .await?
+        .expect("disabled Telegram result");
+    assert!(matches!(
+        event,
+        AppEvent::TelegramCommandFinished {
+            kind: TelegramCommandKind::Disable,
+            result: Ok(_)
+        }
+    ));
+    fixture.dispatch(event).await?;
+    assert!(fixture.text().contains("Telegram notifications disabled."));
+    let document: serde_json::Value = serde_json::from_slice(&std::fs::read(&path)?)?;
+    assert!(document["telegram"].is_null());
+    fixture.key(KeyCode::Esc).await?;
+    fixture
+        .dispatch(AppEvent::TelegramCommandFinished {
