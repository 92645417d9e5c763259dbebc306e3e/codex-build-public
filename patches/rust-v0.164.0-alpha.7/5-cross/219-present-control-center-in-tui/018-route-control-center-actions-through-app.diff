+#[tokio::test]
+async fn quit_dialog_cancels_by_default_and_rechecks_before_exiting() -> crate::app::Result<()> {
+    let mut fixture = Fixture::new().await?;
+    fixture.app.chat_widget.insert_str("Preserved draft");
+    fixture.app.open_control_center(&mut fixture.tui);
+    while fixture.events.try_recv().is_ok() {}
+    while fixture.commands.try_recv().is_ok() {}
+    fixture.app.reconnect.offline = true;
+    fixture.key(KeyCode::Char('q')).await?;
+    assert!(fixture.text().contains("Cannot quit"));
+    fixture.key(KeyCode::Esc).await?;
+    assert!(!fixture.center().has_dialog());
+    // The daemon protocol tests own each eligibility outcome. An earlier Ok is no reservation.
+    fixture
+        .app
+        .show_control_center_quit_dialog(&mut fixture.tui, Ok(()));
+    fixture.key(KeyCode::Enter).await?;
+    assert!(
+        fixture.events.try_recv().is_err(),
+        "default dismissal cannot request shutdown"
+    );
+    assert!(!fixture.center().has_dialog());
+    fixture
+        .app
+        .show_control_center_quit_dialog(&mut fixture.tui, Ok(()));
+    fixture.key(KeyCode::Up).await?;
+    fixture.key(KeyCode::Enter).await?;
+    let event = fixture.events.try_recv()?;
+    assert!(matches!(event, AppEvent::ConfirmControlCenterQuit));
+    assert!(matches!(
+        fixture.dispatch(event).await?,
+        AppRunControl::Continue
+    ));
+    assert!(
+        fixture.text().contains("Cannot quit"),
+        "the current embedded connection is ineligible"
+    );
+    assert_eq!(
+        fixture.app.chat_widget.composer_text_with_pending(),
+        "Preserved draft"
+    );
+    assert!(
+        fixture.commands.try_recv().is_err(),
+        "shutdown never interrupts a thread"
+    );
+    fixture.key(KeyCode::Esc).await?;
+    fixture.key(KeyCode::Esc).await?;
+    assert!(fixture.app.overlay.is_none());
+    assert!(matches!(
+        fixture.dispatch(AppEvent::ConfirmControlCenterQuit).await?,
+        AppRunControl::Continue
+    ));
+    fixture.finish().await
+}
