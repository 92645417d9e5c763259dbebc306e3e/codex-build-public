+    assert!(text.contains("[x] Turn completion"), "{text}");
+    assert!(text.contains("[x] Input needed"), "{text}");
+    assert!(text.contains("[ ] Codex prereleases"), "{text}");
+    fixture.key(KeyCode::Char(' ')).await?;
+    assert!(fixture.text().contains("[ ] Input needed"));
+    fixture.key(KeyCode::Char(' ')).await?;
+    assert!(fixture.events.try_recv().is_err());
+    fixture.key(KeyCode::Enter).await?;
+    let event = fixture.events.try_recv()?;
+    assert!(matches!(
