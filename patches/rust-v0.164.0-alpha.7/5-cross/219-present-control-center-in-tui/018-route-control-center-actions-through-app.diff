+//! One entry and contextual actions consume native settings and guarded shutdown.
+
+use super::App;
+use super::AppRunControl;
+use crate::app_event::AppEvent;
+use crate::app_server_session::AppServerSession;
+use crate::bottom_pane::BottomPaneView;
+use crate::bottom_pane::SelectionItem;
+use crate::bottom_pane::SelectionViewParams;
+use crate::dialog::DialogResources;
+use crate::key_hint;
+use crate::pager_overlay::CenterScreen;
+use crate::pager_overlay::Overlay;
+use crate::tui;
+use crate::tui::TuiEvent;
+use crossterm::event::KeyCode;
+use crossterm::event::KeyEvent;
+
+pub(super) fn control_center_shortcut(key: KeyEvent) -> bool {
+    key_hint::alt(KeyCode::Char('`')).is_press(key)
+}
+
+impl App {
+    pub(super) async fn handle_control_center_input(
+        &mut self,
+        tui: &mut tui::Tui,
+        app_server: &mut AppServerSession,
+        event: &TuiEvent,
+    ) -> Option<AppRunControl> {
+        let Some(Overlay::ControlCenter(center)) = &mut self.overlay else {
+            return None;
+        };
+        if center.has_dialog() {
+            match event {
+                TuiEvent::Key(key) => {
+                    if key_hint::ctrl(KeyCode::Char('c')).is_press(*key) {
+                        center.dialogs.on_ctrl_c();
+                    } else {
+                        center
+                            .dialogs
+                            .handle_key_event(*key, self.routed_key_activation.take());
+                    }
+                }
+                TuiEvent::Paste(text) => {
+                    center
+                        .dialogs
+                        .handle_paste(text.replace("\r\n", "\n").replace('\r', "\n"));
+                }
+                // The dialog owns input; a covered table must not copy or scroll.
+                TuiEvent::Mouse(_) => {}
+                _ => return None,
+            }
+            return Some(AppRunControl::Continue);
+        }
+        let TuiEvent::Key(key) = event else {
+            return None;
+        };
+        let settings = if center.screen == CenterScreen::Summary {
+            if key_hint::plain(KeyCode::Char('p')).is_press(*key) {
+                Some(AppEvent::OpenProxy)
+            } else if key_hint::plain(KeyCode::Char('t')).is_press(*key) {
+                Some(AppEvent::OpenTelegram)
+            } else {
+                None
+            }
+        } else {
+            None
+        };
+        if let Some(settings) = settings {
+            self.app_event_tx.send(settings);
+            return Some(AppRunControl::Continue);
+        }
+        if key_hint::plain(KeyCode::Char('q')).is_press(*key) {
+            let eligibility = self.check_idle_daemon_shutdown(app_server).await;
+            self.show_control_center_quit_dialog(tui, eligibility);
+            return Some(AppRunControl::Continue);
+        }
+        None
+    }
+
+    pub(super) fn show_settings_view(&mut self, view: Box<dyn BottomPaneView>) {
+        if let Some(Overlay::ControlCenter(center)) = &mut self.overlay {
+            center.dialogs.push(view);
+        } else {
+            self.chat_widget.show_bottom_pane_view(view);
+        }
+    }
+
+    pub(super) fn show_settings_selection(
+        &mut self,
+        tui: &tui::Tui,
+        mut params: SelectionViewParams,
+    ) {
+        if let Some(Overlay::ControlCenter(center)) = &mut self.overlay {
+            let resources = DialogResources {
+                app_event_tx: &self.app_event_tx,
+                keymap: &self.keymap,
+                frame_requester: &tui.frame_requester(),
+                vim_enabled: self.chat_widget.composer_is_vim_enabled(),
+            };
+            if let Some(view_id) = params.view_id
+                && let Some(selected) = center
+                    .dialogs
+                    .iter()
+                    .rev()
+                    .find(|view| view.view_id() == Some(view_id))
+                    .and_then(|view| view.selected_index())
+            {
+                params.initial_selected_idx = Some(selected);
+                center
+                    .dialogs
+                    .replace_selection_if_present(view_id, params, resources);
+            } else {
+                center
+                    .dialogs
+                    .push(Box::new(resources.selection_view(params)));
+            }
+        } else if let Some(view_id) = params.view_id
+            && let Some(selected) = self.chat_widget.selected_index_for_present_view(view_id)
+        {
+            params.initial_selected_idx = Some(selected);
+            self.chat_widget
+                .replace_selection_view_if_present(view_id, params);
+        } else {
+            self.chat_widget.show_selection_view(params);
+        }
+    }
+
+    pub(super) fn show_control_center_settings_notice(
+        &mut self,
+        tui: &tui::Tui,
+        title: &str,
+        message: &str,
+    ) {
+        if matches!(self.overlay, Some(Overlay::ControlCenter(_))) {
+            self.show_settings_selection(
+                tui,
+                SelectionViewParams {
+                    title: Some(title.to_owned()),
+                    subtitle: Some(message.to_owned()),
+                    items: vec![SelectionItem {
+                        name: "Close".into(),
+                        dismiss_on_select: true,
+                        ..Default::default()
+                    }],
+                    ..SelectionViewParams::picker()
+                },
+            );
+        }
+    }
+}
