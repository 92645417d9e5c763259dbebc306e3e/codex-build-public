+#[tokio::test]
+async fn response_filters_keep_arrow_ownership_over_global_bindings() -> crate::app::Result<()> {
+    use codex_protocol::response_metrics::ResponseAttemptStatus;
+
+    let mut fixture = Fixture::new().await?;
+    fixture.app.open_control_center(&mut fixture.tui);
+    let Some(Overlay::ControlCenter(center)) = &mut fixture.app.overlay else {
+        unreachable!()
+    };
+    center.responses.history.models.insert("model-a".into());
+    while fixture.events.try_recv().is_ok() {}
+    fixture
+        .key(KeyEvent::new(KeyCode::BackTab, KeyModifiers::SHIFT))
+        .await?;
+    assert!(
+        fixture
+            .app
+            .active_keymap_contexts()
+            .contains(KeymapContext::List)
+    );
+    fixture.key(KeyCode::Char('r')).await?;
+    assert!(fixture.events.try_recv().is_err());
+    // A valid configured chord must not steal the response filter's fixed arrow.
+    let config = toml::from_str("[list]\nmove_left = []\nmove_down = 'left x'")?;
+    fixture.app.keymap = crate::keymap::RuntimeKeymap::from_config(&config).expect("valid keymap");
+    fixture.key(KeyCode::Left).await?;
+    assert!(!fixture.app.key_chord_matcher.is_pending());
+    assert_eq!(fixture.center().responses.history.model(), Some("model-a"));
+    fixture.key(KeyCode::Right).await?;
+    assert_eq!(
+        fixture.center().responses.history.status(),
+        Some(ResponseAttemptStatus::Working)
+    );
+    for (key, offset) in [
+        (KeyEvent::new(KeyCode::Right, KeyModifiers::CONTROL), 8),
+        (KeyEvent::new(KeyCode::Left, KeyModifiers::SHIFT), 0),
+    ] {
+        fixture.key(key).await?;
+        assert_eq!(fixture.center().table_interaction.column_offset, offset);
+        assert_eq!(fixture.center().screen, CenterScreen::Responses);
+        assert!(!fixture.center().has_dialog());
+    }
+    fixture.key(KeyCode::Esc).await?;
+    assert!(fixture.app.overlay.is_none());
+    fixture.finish().await
+}
