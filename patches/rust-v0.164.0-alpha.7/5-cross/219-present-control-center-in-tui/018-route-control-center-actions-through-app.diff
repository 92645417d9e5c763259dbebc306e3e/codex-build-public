+    let event = fixture.events.try_recv()?;
+    assert!(matches!(event, AppEvent::OpenTelegram));
+    fixture.dispatch(event).await?;
+    let event = fixture.events.try_recv()?;
+    assert!(matches!(
+        event,
+        AppEvent::TelegramCommand {
+            params: TelegramCommandParams::Read {}
+        }
