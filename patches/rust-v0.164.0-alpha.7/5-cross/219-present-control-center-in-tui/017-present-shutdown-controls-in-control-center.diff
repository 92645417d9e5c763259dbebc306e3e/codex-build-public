diff --git a/codex-rs/tui/src/app/control_center_shutdown.rs b/codex-rs/tui/src/app/control_center_shutdown.rs
new file mode 100644
--- /dev/null
+++ b/codex-rs/tui/src/app/control_center_shutdown.rs
@@ -0,0 +1,46 @@
+//! Confirm control-center shutdown through the existing daemon eligibility checks.
+
+use super::App;
+use super::AppRunControl;
+use crate::app_server_session::AppServerSession;
+use crate::pager_overlay::Overlay;
+use crate::tui;
+
+impl App {
+    pub(super) async fn confirm_control_center_quit(
+        &mut self,
+        tui: &mut tui::Tui,
+        app_server: &mut AppServerSession,
+    ) -> AppRunControl {
+        if !matches!(&self.overlay, Some(Overlay::ControlCenter(center)) if !center.is_done()) {
+            return AppRunControl::Continue;
+        }
+        // The daemon checks current eligibility again when confirmation is consumed.
+        match self.request_idle_daemon_shutdown(app_server).await {
+            Ok(reason) => AppRunControl::Exit(reason),
+            Err(error) => {
+                self.show_control_center_quit_dialog(tui, Err(error));
+                AppRunControl::Continue
+            }
+        }
+    }
+
+    pub(super) fn show_control_center_quit_dialog(
+        &mut self,
+        tui: &mut tui::Tui,
+        eligibility: Result<(), String>,
+    ) {
+        if let Some(Overlay::ControlCenter(center)) = &mut self.overlay {
+            center.show_quit_dialog(
+                eligibility,
+                crate::dialog::DialogResources {
+                    app_event_tx: &self.app_event_tx,
+                    keymap: &self.keymap,
+                    frame_requester: &tui.frame_requester(),
+                    vim_enabled: self.chat_widget.composer_is_vim_enabled(),
+                },
+            );
+            tui.frame_requester().schedule_frame();
+        }
+    }
+}
