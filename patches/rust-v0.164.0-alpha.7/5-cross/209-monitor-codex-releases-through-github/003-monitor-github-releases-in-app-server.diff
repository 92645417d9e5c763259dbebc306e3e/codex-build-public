@@ -0,0 +1,163 @@
+use super::*;
+use codex_http_client::OutboundProxyPolicy;
+use pretty_assertions::assert_eq;
+use serde_json::json;
+use std::sync::atomic::AtomicUsize;
+use std::sync::atomic::Ordering;
+use url::Url;
+use wiremock::Mock;
+use wiremock::MockServer;
+use wiremock::Respond;
+use wiremock::ResponseTemplate;
+use wiremock::matchers::method;
+use wiremock::matchers::path;
+
+fn config() -> GithubConfig {
+    GithubConfig {
+        token: "github-token".into(),
+        check_interval_hours: 20,
+    }
+}
+
+fn http(server: &MockServer) -> GithubHttp {
+    GithubHttp::with_url(
+        HttpClientFactory::new(OutboundProxyPolicy::ReqwestDefault),
+        Url::parse(&server.uri()).expect("mock URL"),
+    )
+}
+
+fn release_response() -> ResponseTemplate {
+    ResponseTemplate::new(200)
+        .insert_header("x-ratelimit-remaining", "4999")
+        .set_body_json(json!({
+            "data": { "repository": { "releases": { "nodes": [
+                {"tagName": "rust-v1.0.0", "url": "https://example.invalid/stable", "isDraft": false},
+                {"tagName": "rust-v1.1.0-alpha.1", "url": "https://example.invalid/alpha", "isDraft": false}
+            ] } } }
+        }))
+}
+
+struct FailureSequence(AtomicUsize);
+
+impl Respond for FailureSequence {
+    fn respond(&self, _request: &wiremock::Request) -> ResponseTemplate {
+        if self.0.fetch_add(1, Ordering::SeqCst) == 1 {
+            ResponseTemplate::new(503)
+        } else {
+            release_response()
+        }
+    }
+}
+
+#[tokio::test]
+async fn checks_publish_observations_clear_failures_and_throttle_every_attempt() {
+    let server = MockServer::start().await;
+    Mock::given(method("POST"))
+        .and(path("/graphql"))
+        .respond_with(FailureSequence(AtomicUsize::new(0)))
+        .expect(3)
+        .mount(&server)
+        .await;
+    let inner = Inner {
+        config: Some(config()),
+        http: http(&server),
+        last_attempt: Mutex::new(None),
+        status: watch::channel(None).0,
+    };
+    let mut observations = inner.status.subscribe();
+    let first = inner.check(MANUAL_CHECK_MIN_INTERVAL).await.unwrap();
+    assert!(first.performed);
+    let status = first.status.unwrap();
+    assert_eq!(status.latest_release.unwrap().version, "1.0.0");
+    assert_eq!(status.latest_prerelease.unwrap().version, "1.1.0-alpha.1");
+    assert_eq!(status.remaining, Some(4999));
+    assert!(status.checked_at > 0);
+    assert!(observations.has_changed().unwrap());
+    let cached = observations.borrow_and_update().clone();
+    assert_eq!(
+        inner.check(MANUAL_CHECK_MIN_INTERVAL).await.unwrap(),
+        GithubCheckResponse {
+            performed: false,
+            status: cached,
+        }
+    );
+    assert!(!observations.has_changed().unwrap());
+
+    *inner.last_attempt.lock().await = Some(Instant::now() - Duration::from_secs(31));
+    assert!(inner.check(MANUAL_CHECK_MIN_INTERVAL).await.is_err());
+    assert!(observations.has_changed().unwrap());
+    assert_eq!(*observations.borrow_and_update(), None);
+    assert_eq!(
+        inner.check(MANUAL_CHECK_MIN_INTERVAL).await.unwrap(),
+        GithubCheckResponse {
+            performed: false,
+            status: None,
+        }
+    );
+
+    *inner.last_attempt.lock().await = Some(Instant::now() - Duration::from_secs(31));
+    let recovered = inner.check(MANUAL_CHECK_MIN_INTERVAL).await.unwrap();
+    assert!(recovered.performed);
+    assert!(observations.has_changed().unwrap());
+    assert_eq!(*observations.borrow_and_update(), recovered.status);
+}
+
+#[tokio::test]
+async fn unconfigured_github_has_no_background_worker_or_network_check() {
+    let server = MockServer::start().await;
+    let processor = GithubProcessor::with_http(None, http(&server));
+    assert_eq!(processor.read(), GithubReadResponse::default());
+    assert!(processor._task.is_none());
+    assert_eq!(
+        processor.check().await.unwrap_err().message,
+        "GitHub is not configured"
+    );
+    assert!(server.received_requests().await.unwrap().is_empty());
+}
+
+#[tokio::test]
+async fn shutdown_cancels_inflight_checks_without_blocking_cached_reads() {
+    let server = MockServer::start().await;
+    Mock::given(method("POST"))
+        .and(path("/graphql"))
+        .respond_with(release_response().set_delay(Duration::from_secs(60)))
+        .expect(1)
+        .mount(&server)
+        .await;
+    let mut processor = GithubProcessor::with_http(Some(config()), http(&server));
+    tokio::time::timeout(Duration::from_secs(5), async {
+        while server.received_requests().await.unwrap().is_empty() {
+            tokio::time::sleep(Duration::from_millis(10)).await;
+        }
+    })
+    .await
+    .expect("scheduled check started without a Telegram configuration");
+    assert_eq!(
+        processor.read(),
+        GithubReadResponse {
+            configured: true,
+            status: None,
+        }
+    );
+    assert_eq!(*processor.subscribe().borrow(), None);
+    processor.shutdown();
+    tokio::time::timeout(Duration::from_secs(5), processor._task.as_mut().unwrap())
+        .await
+        .expect("worker stopped before HTTP timeout")
+        .expect("worker joined");
+}
+
+#[tokio::test]
+async fn dropping_github_processor_releases_its_background_owner() {
+    let server = MockServer::start().await;
+    let processor = GithubProcessor::with_http(Some(config()), http(&server));
+    let inner = Arc::downgrade(&processor.inner);
+    drop(processor);
+    tokio::time::timeout(Duration::from_secs(5), async {
+        while inner.upgrade().is_some() {
+            tokio::time::sleep(Duration::from_millis(10)).await;
+        }
+    })
+    .await
+    .expect("worker released its owner");
+}
