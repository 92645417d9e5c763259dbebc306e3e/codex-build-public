+            serde_json::from_value(json!({
+                "id": 1, "method": "initialize", "params": {
+                    "clientInfo": {"name": "github-status-test", "version": "1"}
+                }
+            }))?,
+            &AppServerTransport::Stdio,
+            Arc::clone(&session),
+        )
+        .await;
+    let _: InitializeResponse = read_response(&mut outgoing, 1).await;
+
+    let check = ClientRequest::GithubCheck {
+        request_id: RequestId::Integer(10),
+        params: None,
+    };
+    let (key, access) = RequestSerializationQueueKey::from_scope(
+        TEST_CONNECTION_ID,
+        check.serialization_scope().expect("serialized checks"),
+    );
+    let (started_tx, started_rx) = oneshot::channel();
+    let (release_tx, release_rx) = oneshot::channel();
+    processor
+        .request_serialization_queues
+        .enqueue_background(key, access, async move {
+            started_tx.send(()).unwrap();
+            release_rx.await.unwrap();
+        })
+        .await;
+    timeout(Duration::from_secs(1), started_rx).await??;
+
+    processor
+        .process_request(
+            TEST_CONNECTION_ID,
+            serde_json::from_value(json!({"id": 2, "method": "github/read"}))?,
+            &AppServerTransport::Stdio,
+            Arc::clone(&session),
+        )
+        .await;
+    let read: GithubReadResponse =
+        timeout(Duration::from_secs(1), read_response(&mut outgoing, 2)).await?;
+    assert_eq!(read, GithubReadResponse::default());
+    processor
+        .process_client_request(
+            TEST_CONNECTION_ID,
+            ClientRequest::GithubRead {
+                request_id: RequestId::Integer(3),
+                params: None,
