+use codex_app_server_protocol::GithubCheckResponse;
+use codex_app_server_protocol::GithubReadResponse;
+use codex_app_server_protocol::GithubStatus;
+use codex_app_server_protocol::JSONRPCErrorError;
+use codex_http_client::HttpClientFactory;
+use std::sync::Arc;
+use std::time::Duration;
+use tokio::sync::Mutex;
+use tokio::sync::watch;
+use tokio::task::JoinHandle;
+use tokio::time::Instant;
+use tokio_util::sync::CancellationToken;
+
+use crate::error_code::internal_error;
+use crate::error_code::invalid_params;
+use crate::github_http::GithubHttp;
+use crate::integrations::GithubConfig;
+
+const MANUAL_CHECK_MIN_INTERVAL: Duration = Duration::from_secs(30);
+
+pub(crate) struct GithubProcessor {
+    inner: Arc<Inner>,
+    cancel: CancellationToken,
+    _task: Option<JoinHandle<()>>,
+}
+
+struct Inner {
+    config: Option<GithubConfig>,
+    http: GithubHttp,
+    last_attempt: Mutex<Option<Instant>>,
+    status: watch::Sender<Option<GithubStatus>>,
+}
+
+impl GithubProcessor {
+    pub(crate) fn new(config: Option<GithubConfig>, factory: HttpClientFactory) -> Self {
+        Self::with_http(config, GithubHttp::new(factory))
+    }
+
+    fn with_http(config: Option<GithubConfig>, http: GithubHttp) -> Self {
+        let inner = Arc::new(Inner {
+            config,
+            http,
+            last_attempt: Mutex::new(None),
+            status: watch::channel(None).0,
+        });
+        let cancel = CancellationToken::new();
+        let task = inner.config.as_ref().map(|config| {
+            let interval = Duration::from_secs(u64::from(config.check_interval_hours) * 60 * 60);
+            let inner = Arc::clone(&inner);
+            let cancel = cancel.clone();
+            tokio::spawn(async move {
+                loop {
+                    let delay = tokio::select! {
+                        _ = cancel.cancelled() => break,
+                        last = inner.last_attempt.lock() => last.map_or(Duration::ZERO, |last| {
+                            interval.saturating_sub(last.elapsed())
+                        }),
+                    };
+                    tokio::select! {
+                        _ = cancel.cancelled() => break,
+                        _ = tokio::time::sleep(delay) => {},
+                    }
+                    tokio::select! {
+                        _ = cancel.cancelled() => break,
+                        result = inner.check(interval) => {
+                            if result.is_err() {
+                                tracing::warn!("GitHub release check failed");
+                            }
+                        },
+                    }
+                }
+            })
+        });
+        Self {
+            inner,
+            cancel,
+            _task: task,
+        }
+    }
+
+    pub(crate) fn read(&self) -> GithubReadResponse {
+        GithubReadResponse {
+            configured: self.inner.config.is_some(),
+            status: self.inner.status.borrow().clone(),
+        }
+    }
+
+    pub(crate) fn subscribe(&self) -> watch::Receiver<Option<GithubStatus>> {
+        self.inner.status.subscribe()
+    }
+
+    pub(crate) async fn check(&self) -> Result<GithubCheckResponse, JSONRPCErrorError> {
+        self.inner.check(MANUAL_CHECK_MIN_INTERVAL).await
+    }
+
+    pub(crate) fn shutdown(&self) {
+        self.cancel.cancel();
+    }
+}
+
+impl Drop for GithubProcessor {
+    fn drop(&mut self) {
+        self.shutdown();
+    }
+}
+
+impl Inner {
+    async fn check(
+        &self,
+        minimum_interval: Duration,
+    ) -> Result<GithubCheckResponse, JSONRPCErrorError> {
+        let config = self
+            .config
+            .as_ref()
+            .ok_or_else(|| invalid_params("GitHub is not configured"))?;
+        // Serialize scheduled and manual requests without blocking cached reads.
+        let mut last_attempt = self.last_attempt.lock().await;
+        if last_attempt.is_some_and(|last| last.elapsed() < minimum_interval) {
+            return Ok(GithubCheckResponse {
+                performed: false,
+                status: self.status.borrow().clone(),
+            });
+        }
+        *last_attempt = Some(Instant::now());
+        match self.http.releases(&config.token).await {
+            Ok(status) => {
+                // Publish each successful check, including unchanged versions, so
+                // subscribers can retry delivery without owning another GitHub poller.
+                self.status.send_replace(Some(status.clone()));
+                Ok(GithubCheckResponse {
+                    performed: true,
+                    status: Some(status),
+                })
+            }
+            Err(()) => {
+                self.status.send_replace(None);
+                Err(internal_error("GitHub release check failed"))
+            }
+        }
+    }
+}
