+    for paths in [json!([]), json!(["/workspace", "/linked-workspace"])] {
+        let cwd = json!({ "exclude": paths });
+        let params = serde_json::from_value::<ThreadListParams>(json!({ "cwd": cwd }))
+            .expect("cwd exclusion should deserialize");
+        assert!(matches!(
+            params.cwd,
+            Some(ThreadListCwdFilter::Exclude { .. })
+        ));
+        assert_eq!(serde_json::to_value(params).unwrap()["cwd"], cwd);
+    }
+}
