+#[tokio::test]
+async fn thread_list_excludes_cwds_before_pagination_in_both_statuses() -> Result<()> {
+    let codex_home = TempDir::new()?;
+    create_minimal_config(codex_home.path())?;
+    let current = codex_home.path().join("current");
+    let linked = codex_home.path().join("linked");
+    let other = codex_home.path().join("other");
+    for cwd in [&current, &linked, &other] {
+        fs::create_dir_all(cwd)?;
+    }
+    let archived_directory = codex_home.path().join(ARCHIVED_SESSIONS_SUBDIR);
+    fs::create_dir_all(&archived_directory)?;
+    let mut expected = [Vec::new(), Vec::new()];
+    for archived in [false, true] {
+        for index in 0..6 {
+            let timestamp = format!("2025-01-02T{index:02}:00:00Z");
+            let filename = format!("2025-01-02T{index:02}-00-00");
+            let id = create_fake_rollout(
+                codex_home.path(),
+                &filename,
+                &timestamp,
+                "eligible session",
+                Some(if index == 5 {
+                    "other_provider"
+                } else {
+                    "mock_provider"
+                }),
+                None,
+            )?;
+            let path = rollout_path(codex_home.path(), &filename, &id);
+            let cwd = match index {
+                1 | 4 => &current,
+                3 => &linked,
+                _ => &other,
+            };
+            set_rollout_cwd(&path, cwd)?;
+            if archived {
+                fs::rename(&path, archived_directory.join(path.file_name().unwrap()))?;
+            }
+            if index == 0 || index == 2 {
+                expected[usize::from(archived)].insert(0, id);
+            }
+        }
+    }
+    let mut mcp = init_mcp(codex_home.path()).await?;
+    for (archived, use_state_db_only) in
+        [(false, false), (true, false), (false, true), (true, true)]
+    {
+        let mut cursor = None;
+        let mut actual = Vec::new();
+        loop {
+            let response: ThreadListResponse = mcp
+                .request(|request_id| ClientRequest::ThreadList {
+                    request_id,
+                    params: codex_app_server_protocol::ThreadListParams {
+                        cursor: cursor.clone(),
+                        limit: Some(1),
+                        excluded_thread_ids: None,
+                        sort_key: Some(ThreadSortKey::CreatedAt),
+                        sort_direction: None,
+                        model_providers: Some(vec!["mock_provider".into()]),
+                        source_kinds: None,
+                        originators: None,
+                        archived: Some(archived),
+                        section_id: None,
+                        project_id: None,
+                        cwd: Some(ThreadListCwdFilter::Exclude {
+                            exclude: vec![
+                                current.to_string_lossy().into_owned(),
+                                linked.to_string_lossy().into_owned(),
+                            ],
+                        }),
+                        use_state_db_only,
+                        search_term: Some("eligible".into()),
+                        parent_thread_id: None,
+                        ancestor_thread_id: None,
+                    },
+                })
+                .await?;
+            assert!(response.data.len() <= 1);
+            for thread in response.data {
+                assert_eq!(thread.cwd.as_path(), other.as_path());
+                assert!(!actual.contains(&thread.id));
+                actual.push(thread.id);
+            }
+            if response.next_cursor.is_none() {
+                break;
+            }
+            assert_ne!(response.next_cursor, cursor);
+            cursor = response.next_cursor;
+            assert!(actual.len() <= 2);
+        }
+        assert_eq!(actual, expected[usize::from(archived)]);
+    }
+    Ok(())
+}
