+#[test]
+fn resume_header_progress_reclaims_one_list_row_and_preserves_gray() {
+    use crate::custom_terminal::Terminal;
+    use crate::test_backend::VT100Backend;
+
+    let mut state = PickerState::new(
+        crate::backend_id::BackendId::new(),
+        FrameRequester::test_dummy(),
+        Arc::new(|_| {}),
+        ProviderFilter::Any,
+        true,
+        None,
+        SessionPickerAction::Resume,
+    );
+    state.filtered_rows = (0..10)
+        .map(|id| Row {
+            path: None,
+            preview: format!("Session {id}"),
+            thread_id: Some(ThreadId::from_u128(id)),
+            thread_name: None,
+            created_at: None,
+            updated_at: None,
+            cwd: None,
+            git_branch: None,
+        })
+        .collect();
+    for (width, height) in [(80, 20), (38, 12)] {
+        let area = Rect::new(0, 0, width, height);
+        state.action = SessionPickerAction::Fork;
+        let fork = layout::areas(area, &state);
+        state.action = SessionPickerAction::Resume;
+        let current = layout::areas(area, &state);
+        assert_eq!(current.list.height, fork.list.height + 1);
+        assert_eq!(area.bottom() - current.list.bottom(), 3);
+        assert_eq!(area.bottom() - fork.list.bottom(), 4);
+        state.update_viewport(usize::from(current.list.height), list_viewport_width(width));
+        let backend = VT100Backend::new(width, height);
+        let mut terminal = Terminal::with_options(backend).unwrap();
+        terminal.set_viewport_area(area);
+        let mut frame = terminal.get_frame();
+        layout::render(&mut frame, &state);
+        let rows = frame
+            .buffer
+            .content
+            .chunks(usize::from(width))
+            .map(|row| {
+                row.iter()
+                    .map(ratatui::buffer::Cell::symbol)
+                    .collect::<String>()
+            })
+            .collect::<Vec<_>>();
+        let heading = &rows[0];
+        assert!(heading.starts_with(" Resume a previous session ·"));
+        if width == 80 {
+            assert!(heading.contains("· 1 / 10 · 0%"));
+        }
+        assert_eq!(
+            rows.iter()
+                .map(|row| row.matches('%').count())
+                .sum::<usize>(),
+            1
+        );
+        assert!(rows[usize::from(current.list.bottom())].contains("enter"));
+        assert!(!rows[usize::from(current.list.bottom())].contains('─'));
+        let percent = frame
+            .buffer
+            .content
+            .iter()
+            .find(|cell| cell.symbol() == "%")
+            .unwrap();
+        assert_eq!(
+            percent.fg,
+            secondary_text_style().fg.unwrap_or(Color::Reset)
+        );
+        assert!(!percent.modifier.intersects(Modifier::BOLD | Modifier::DIM));
+    }
+}
