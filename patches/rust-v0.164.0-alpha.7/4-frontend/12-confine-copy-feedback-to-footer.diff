+pub(super) fn copy_feedback_layout(
+    feedback: Option<crate::transcript_view::CopyFeedback>,
+    area: Rect,
+    left_width: usize,
+    occupied_right_width: usize,
+) -> Option<(Rect, Line<'static>)> {
+    let feedback = feedback?;
+    if area.is_empty() {
+        return None;
+    }
+    // Measure the already-selected footer content before spending spare columns on feedback.
+    let reserved =
+        left_width.saturating_add(usize::from(left_width > 0) * 2) + occupied_right_width;
+    let budget = usize::from(area.width.saturating_sub(1)).saturating_sub(reserved) as u16;
+    let line = feedback.line(budget);
+    let width = line.width() as u16;
+    (width > 0).then(|| {
+        (
+            Rect::new(area.right() - width - 1, area.bottom() - 1, width, 1),
+            line,
+        )
+    })
+}
