+    pub(super) fn context_remaining_count_value(&self) -> Option<String> {
+        if self.token_usage_pending {
+            return None;
+        }
+        let window = self
+            .status_line_context_window_size()
+            .filter(|window| *window > 0)?;
+        let used = self
+            .token_info
+            .as_ref()?
+            .last_token_usage
+            .tokens_in_context_window()
+            .max(0);
+        let remaining = window.saturating_sub(used).max(0);
+        Some(format!(
+            "{} of {} left",
+            format_tokens_compact(remaining),
+            format_tokens_compact(window),
+        ))
+    }
