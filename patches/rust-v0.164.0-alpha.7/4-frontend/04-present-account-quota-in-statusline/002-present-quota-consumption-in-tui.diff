+fn compact_status_line_limit_label(window_minutes: i64) -> Option<String> {
+    if window_minutes <= 0 {
+        return None;
+    }
+    Some(match get_limits_duration(window_minutes).as_deref() {
+        Some("5h") => "5H".to_string(),
+        Some("daily") => "1D".to_string(),
+        Some("weekly") => "7D".to_string(),
+        Some("monthly") => "30D".to_string(),
+        Some("annual") => "365D".to_string(),
+        _ if window_minutes % (24 * 60) == 0 => format!("{}D", window_minutes / (24 * 60)),
+        _ if window_minutes % 60 == 0 => format!("{}H", window_minutes / 60),
+        _ => format!("{window_minutes}M"),
+    })
+}
+
+fn selected_status_line_limit_window(
+    snapshot: &RateLimitSnapshotDisplay,
+    item: StatusLineItem,
+) -> Option<&RateLimitWindowDisplay> {
+    match item {
+        StatusLineItem::FiveHourLimit => five_hour_status_window(snapshot).map(|value| value.0),
+        StatusLineItem::WeeklyLimit => weekly_status_window(snapshot).map(|value| value.0),
+        _ => None,
+    }
+}
