+/// Produces a config edit for named CLI symlink argument arrays.
+pub fn symlink_launch_profiles_edit(
+    profiles: &std::collections::BTreeMap<String, Vec<String>>,
+) -> ConfigEdit {
+    let mut table = toml_edit::Table::new();
+    for (name, arguments) in profiles {
+        let array = arguments.iter().cloned().collect::<toml_edit::Array>();
+        table.insert(name, TomlItem::Value(array.into()));
+    }
+    ConfigEdit::SetPath {
+        segments: vec!["symlinks".to_string()],
+        value: TomlItem::Table(table),
+    }
+}
+
