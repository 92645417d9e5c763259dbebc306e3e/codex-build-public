+use super::load_profile;
+use pretty_assertions::assert_eq;
+use std::ffi::OsString;
+
+#[test]
+fn named_arguments_are_not_shell_parsed() {
+    let home = tempfile::tempdir().unwrap();
+    std::fs::write(
+        home.path().join("config.toml"),
+        "[symlinks]\ncodex = [\"--config\", \"a value with spaces\"]\ncodex-yolo = []\n",
+    )
+    .unwrap();
+    assert_eq!(
+        load_profile(home.path(), "codex").unwrap(),
+        ["--config", "a value with spaces"].map(OsString::from)
+    );
+    assert!(load_profile(home.path(), "codex-yolo").unwrap().is_empty());
+}
+
+#[test]
+fn missing_file_is_initialized_and_existing_configuration_is_preserved() {
+    let home = tempfile::tempdir().unwrap();
+    let path = home.path().join("config.toml");
+    assert_eq!(
+        load_profile(home.path(), "codex-embedded").unwrap(),
+        ["--no-daemon"].map(OsString::from)
+    );
+    assert!(load_profile(home.path(), "codex").unwrap().is_empty());
+    assert_eq!(
+        std::fs::read_to_string(&path).unwrap(),
+        "[symlinks]\ncodex = []\ncodex-embedded = [\"--no-daemon\"]\n"
+    );
+    let custom = "# Keep this comment\nmodel = \"custom\"\n[symlinks]\ncodex = [\"--sandbox\", \"read-only\"]\n";
+    std::fs::write(&path, custom).unwrap();
+    assert_eq!(
+        load_profile(home.path(), "codex").unwrap(),
+        ["--sandbox", "read-only"].map(OsString::from)
+    );
+    assert_eq!(std::fs::read_to_string(&path).unwrap(), custom);
+}
+
+#[test]
+fn invalid_toml_invalid_arguments_and_missing_named_profile_are_errors() {
+    let home = tempfile::tempdir().unwrap();
+    let path = home.path().join("config.toml");
+    std::fs::write(&path, "not valid toml").unwrap();
+    assert!(load_profile(home.path(), "codex").is_err());
+    std::fs::write(&path, "[symlinks]\ncodex = \"--no-daemon\"\n").unwrap();
+    assert!(load_profile(home.path(), "codex").is_err());
+    std::fs::write(&path, "[symlinks]\ncodex-yolo = []\n").unwrap();
+    assert!(load_profile(home.path(), "codex").is_err());
+}
+
+#[test]
+fn default_creation_failure_is_an_error() {
+    let home = tempfile::tempdir().unwrap();
+    let not_a_directory = home.path().join("file");
+    std::fs::write(&not_a_directory, "occupied").unwrap();
+    assert!(load_profile(&not_a_directory, "codex").is_err());
+}
+
+#[test]
+fn missing_table_preserves_unrelated_configuration() {
+    let home = tempfile::tempdir().unwrap();
+    let path = home.path().join("config.toml");
+    let original = "# User settings\nmodel = \"custom\"\n[features]\napps = true\n";
+    std::fs::write(&path, original).unwrap();
+    assert!(load_profile(home.path(), "codex").unwrap().is_empty());
+    let written = std::fs::read_to_string(&path).unwrap();
+    assert!(written.starts_with(original));
+    let config: codex_config::config_toml::ConfigToml = toml::from_str(&written).unwrap();
+    assert_eq!(config.model.as_deref(), Some("custom"));
+    assert_eq!(config.symlinks.unwrap()["codex-embedded"], ["--no-daemon"]);
+}
