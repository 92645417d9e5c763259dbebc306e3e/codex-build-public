+use anyhow::Context;
+use codex_core::config::edit::ConfigEditsBuilder;
+use codex_core::config::edit::symlink_launch_profiles_edit;
+use std::collections::BTreeMap;
+use std::ffi::OsString;
+use std::io::ErrorKind;
+use std::path::Path;
+
+pub(crate) fn load_profile(codex_home: &Path, name: &str) -> anyhow::Result<Vec<OsString>> {
+    let path = codex_home.join("config.toml");
+    let source = match std::fs::read_to_string(&path) {
+        Ok(source) => source,
+        Err(error) if error.kind() == ErrorKind::NotFound => String::new(),
+        Err(error) => {
+            return Err(error).with_context(|| format!("failed to read {}", path.display()));
+        }
+    };
+    let root: toml::Table = toml::from_str(&source)
+        .with_context(|| format!("invalid configuration in {}", path.display()))?;
+    let mut profiles: BTreeMap<String, Vec<String>> = match root.get("symlinks") {
+        Some(profiles) => profiles
+            .clone()
+            .try_into()
+            .with_context(|| format!("invalid [symlinks] launch profiles in {}", path.display()))?,
+        None => {
+            let profiles = BTreeMap::from([
+                ("codex".to_string(), Vec::new()),
+                (
+                    "codex-embedded".to_string(),
+                    vec!["--no-daemon".to_string()],
+                ),
+            ]);
+            ConfigEditsBuilder::new(codex_home)
+                .with_edits([symlink_launch_profiles_edit(&profiles)])
+                .apply_blocking()?;
+            profiles
+        }
+    };
+    let profile = profiles.remove(name).with_context(|| {
+        format!(
+            "missing [symlinks] launch profile {name:?} in {}",
+            path.display()
+        )
+    })?;
+    Ok(profile.into_iter().map(OsString::from).collect())
+}
+
