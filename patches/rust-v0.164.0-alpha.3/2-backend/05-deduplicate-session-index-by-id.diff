+// The caller holds both the process mutex and the stable home-directory lock.
+fn rewrite_session_index(
+    codex_home: &Path,
+    retain: impl Fn(&SessionIndexEntry) -> std::io::Result<bool>,
+    replacement: Option<SessionIndexEntry>,
+) -> std::io::Result<()> {
+    let path = session_index_path(codex_home);
+    let contents = match std::fs::read_to_string(&path) {
+        Ok(contents) => contents,
+        Err(err) if err.kind() == ErrorKind::NotFound => String::new(),
+        Err(err) => return Err(err),
+    };
+    let mut removed = false;
+    let mut remaining = String::with_capacity(contents.len());
+    for line in contents.lines() {
+        let discard = match serde_json::from_str::<SessionIndexEntry>(line.trim()) {
+            Ok(entry) => !retain(&entry)?,
+            Err(_) => false,
+        };
+        if discard {
+            removed = true;
+        } else {
+            remaining.push_str(line);
+            remaining.push('\n');
+        }
+    }
+    if let Some(entry) = replacement {
+        remaining.push_str(&serde_json::to_string(&entry).map_err(std::io::Error::other)?);
+        remaining.push('\n');
+    } else if !removed {
+        return Ok(());
+    }
+    let mut temp = tempfile::NamedTempFile::new_in(codex_home)?;
+    match std::fs::metadata(&path) {
+        Ok(metadata) => temp.as_file().set_permissions(metadata.permissions())?,
+        Err(err) if err.kind() == ErrorKind::NotFound => {}
+        Err(err) => return Err(err),
+    }
+    temp.write_all(remaining.as_bytes())?;
+    temp.persist(path).map_err(|err| err.error)?;
+    Ok(())
+}
