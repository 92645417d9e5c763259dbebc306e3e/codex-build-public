+#[tokio::test]
+async fn index_replacement_holds_directory_lock_and_preserves_open_readers() -> std::io::Result<()>
+{
+    use std::io::Read;
+
+    let home = TempDir::new()?;
+    let id = ThreadId::new();
+    append_thread_name(home.path(), id, "original").await?;
+    let path = session_index_path(home.path());
+    let original = std::fs::read_to_string(&path)?;
+    let mut reader = File::open(&path)?;
+    let directory = File::open(home.path())?;
+    let (reached_tx, reached_rx) = tokio::sync::oneshot::channel();
+    let (resume_tx, resume_rx) = std::sync::mpsc::channel();
+    let reached_tx = std::sync::Mutex::new(Some(reached_tx));
+    let update_home = home.path().to_path_buf();
+    let update = tokio::spawn(async move {
+        update_session_index(
+            &update_home,
+            move |_| {
+                reached_tx.lock().unwrap().take().unwrap().send(()).unwrap();
+                let _ = resume_rx.recv();
+                Ok(false)
+            },
+            None,
+        )
+        .await
+    });
+    reached_rx.await.unwrap();
+    let lock_is_held = matches!(directory.try_lock(), Err(std::fs::TryLockError::WouldBlock));
+    resume_tx.send(()).unwrap();
+    update.await.unwrap()?;
+    assert!(
+        lock_is_held,
+        "another process must not enter the read-modify-write operation"
+    );
+    directory
+        .try_lock()
+        .expect("directory lock released after publication");
+    let mut retained = String::new();
+    reader.read_to_string(&mut retained)?;
+    assert_eq!(retained, original);
+    assert_eq!(std::fs::read_to_string(path)?, "");
+    Ok(())
+}
