+#[tokio::test]
+async fn renaming_replaces_duplicate_entries_and_preserves_unrelated_lines() -> std::io::Result<()>
+{
+    use std::os::unix::fs::PermissionsExt;
+
+    let home = TempDir::new()?;
+    let path = session_index_path(home.path());
+    let id = ThreadId::new();
+    let old = SessionIndexEntry {
+        id,
+        thread_name: "old name".to_string(),
+        updated_at: "2024-01-01T00:00:00Z".to_string(),
+    };
+    let retained = SessionIndexEntry {
+        id: ThreadId::new(),
+        thread_name: "unrelated".to_string(),
+        ..old.clone()
+    };
+    write_index(&path, &[old.clone(), retained.clone(), old])?;
+    std::fs::OpenOptions::new()
+        .append(true)
+        .open(&path)?
+        .write_all(b"malformed\n")?;
+    std::fs::set_permissions(&path, std::fs::Permissions::from_mode(0o640))?;
+
+    for name in ["new name", "newest name", ""] {
+        append_thread_name(home.path(), id, name).await?;
+        let contents = std::fs::read_to_string(&path)?;
+        let entries: Vec<SessionIndexEntry> = contents
+            .lines()
+            .filter_map(|line| serde_json::from_str(line).ok())
+            .collect();
+        assert_eq!(entries.len(), 2);
+        assert_eq!(entries[0], retained);
+        assert_eq!((entries[1].id, entries[1].thread_name.as_str()), (id, name));
+        assert!(contents.lines().any(|line| line == "malformed"));
+        assert_eq!(
+            std::fs::metadata(&path)?.permissions().mode() & 0o777,
+            0o640
+        );
+        assert_eq!(
+            find_thread_name_by_id(home.path(), &id).await?,
+            Some(name.to_string())
+        );
+    }
+    Ok(())
+}
