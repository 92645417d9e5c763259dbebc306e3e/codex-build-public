+async fn update_session_index(
+    codex_home: &Path,
+    retain: impl Fn(&SessionIndexEntry) -> std::io::Result<bool> + Send + 'static,
+    replacement: Option<SessionIndexEntry>,
+) -> std::io::Result<()> {
+    let codex_home = codex_home.to_path_buf();
+    with_session_index_lock(&SESSION_INDEX_LOCK, move || {
+        // Lock the stable home directory rather than the index inode replaced below.
+        // This serializes read-modify-write across processes without a lock sidecar.
+        let directory = match File::open(&codex_home) {
+            Ok(directory) => directory,
+            Err(err) if err.kind() == ErrorKind::NotFound && replacement.is_none() => {
+                return Ok(());
             }
