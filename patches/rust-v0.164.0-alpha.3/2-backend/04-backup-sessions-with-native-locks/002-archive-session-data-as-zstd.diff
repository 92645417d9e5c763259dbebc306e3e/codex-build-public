+fn fixture() -> (TempDir, TempDir, TempDir) {
+    let home = TempDir::new().unwrap();
+    let harness = TempDir::new().unwrap();
+    let destination = TempDir::new().unwrap();
+    for directory in DIRECTORIES {
+        fs::create_dir(home.path().join(directory)).unwrap();
+    }
+    fs::write(home.path().join("sessions/active.jsonl"), b"active\n").unwrap();
+    fs::write(
+        home.path().join("archived_sessions/archive.jsonl.zst"),
+        b"stored compressed bytes",
+    )
+    .unwrap();
+    fs::write(home.path().join(INDEX), b"names\n").unwrap();
+    fs::write(home.path().join("state.sqlite"), b"not a backup member").unwrap();
+    (home, harness, destination)
+}
+
+fn assert_destination_empty(destination: &Path) {
+    assert_eq!(fs::read_dir(destination).unwrap().count(), 0);
+}
+
+#[test]
+fn backup_command_is_discoverable_and_requires_an_output() {
+    use clap::CommandFactory;
+    let parsed =
+        crate::MultitoolCli::try_parse_from(["codex", "backup-sessions", "sessions.tar.zst"])
+            .unwrap();
+    let Some(crate::Subcommand::BackupSessions(command)) = parsed.subcommand else {
+        panic!("expected standalone backup command");
+    };
+    assert_eq!(command.output, PathBuf::from("sessions.tar.zst"));
+    assert!(crate::MultitoolCli::try_parse_from(["codex", "backup-sessions"]).is_err());
+    assert!(
+        crate::MultitoolCli::command()
+            .render_long_help()
+            .to_string()
+            .contains("backup-sessions")
+    );
+    assert!(
+        crate::reject_root_strict_config_for_subcommand(
+            true,
+            &Some(crate::Subcommand::BackupSessions(command))
+        )
+        .is_err()
+    );
+    assert!(
+        crate::reject_remote_mode_for_subcommand(Some("unix:///remote"), None, "backup-sessions")
+            .is_err()
+    );
+}
+
+#[test]
+fn backup_roundtrips_exact_sources_and_preserves_symlinks() {
+    let (home, harness, destination) = fixture();
+    let outside = TempDir::new().unwrap();
+    fs::write(outside.path().join("private"), b"outside").unwrap();
+    symlink(outside.path(), home.path().join("sessions/link")).unwrap();
+    let output = destination.path().join("snapshot.tar.zst");
+    let result = create_backup(
+        home.path(),
+        harness.path(),
+        &output,
+        &AtomicBool::new(false),
+    )
+    .unwrap();
+    assert_eq!(result, output);
+    let decoder = zstd::stream::read::Decoder::new(File::open(&output).unwrap()).unwrap();
+    let mut archive = tar::Archive::new(decoder);
+    let mut files = BTreeMap::new();
+    let mut roots = std::collections::BTreeSet::new();
+    let mut saw_link = false;
+    for entry in archive.entries().unwrap() {
+        let mut entry = entry.unwrap();
+        let path = entry.path().unwrap().into_owned();
+        roots.insert(path.components().next().unwrap().as_os_str().to_owned());
+        if entry.header().entry_type().is_symlink() {
+            assert_eq!(path, Path::new("sessions/link"));
+            assert_eq!(
+                entry.link_name().unwrap().unwrap().into_owned(),
+                outside.path()
+            );
+            saw_link = true;
+        } else if entry.header().entry_type().is_file() {
+            let mut contents = Vec::new();
+            entry.read_to_end(&mut contents).unwrap();
+            files.insert(path, contents);
+        }
+    }
+    assert!(saw_link);
+    assert_eq!(
+        roots,
+        ["archived_sessions", "sessions", INDEX]
+            .map(std::ffi::OsString::from)
+            .into()
+    );
+    assert_eq!(
+        files,
+        BTreeMap::from([
+            (PathBuf::from("sessions/active.jsonl"), b"active\n".to_vec()),
+            (
+                PathBuf::from("archived_sessions/archive.jsonl.zst"),
+                b"stored compressed bytes".to_vec()
+            ),
+            (PathBuf::from(INDEX), b"names\n".to_vec()),
+        ])
+    );
+    assert_eq!(fs::read_dir(destination.path()).unwrap().count(), 1);
+    drop(codex_rollout::try_acquire_session_backup_lock(home.path(), harness.path()).unwrap());
+}
+
+#[test]
+fn busy_native_lock_prevents_archive_creation() {
+    let (home, harness, destination) = fixture();
+    let coordinator = Arc::new(codex_rollout::WriterLockCoordinator::new(harness.path()));
+    let writer = coordinator
+        .acquire(codex_protocol::ThreadId::default())
+        .unwrap();
+    let error = create_backup(
+        home.path(),
+        harness.path(),
+        &destination.path().join("backup.tar.zst"),
+        &AtomicBool::new(false),
+    )
+    .unwrap_err();
+    assert!(format!("{error:#}").contains("active thread writer"));
+    assert_destination_empty(destination.path());
+    drop(writer);
+    drop(codex_rollout::try_acquire_session_backup_lock(home.path(), harness.path()).unwrap());
+}
+
+#[test]
+fn backup_preserves_existing_output_and_rejects_recursive_destination() {
+    let (home, harness, destination) = fixture();
+    let output = destination.path().join("existing.tar.zst");
+    fs::write(&output, b"existing archive").unwrap();
+    assert!(
+        create_backup(
+            home.path(),
+            harness.path(),
+            &output,
+            &AtomicBool::new(false)
+        )
+        .is_err()
+    );
+    assert_eq!(fs::read(&output).unwrap(), b"existing archive");
+    let linked_output = destination.path().join("existing-link.tar.zst");
+    symlink(&output, &linked_output).unwrap();
+    assert!(
+        create_backup(
+            home.path(),
+            harness.path(),
+            &linked_output,
+            &AtomicBool::new(false)
+        )
+        .is_err()
+    );
+    let recursive = home.path().join("sessions/backup.tar.zst");
+    assert!(
+        create_backup(
+            home.path(),
+            harness.path(),
+            &recursive,
+            &AtomicBool::new(false)
+        )
+        .is_err()
+    );
+    assert!(!recursive.exists());
+    drop(codex_rollout::try_acquire_session_backup_lock(home.path(), harness.path()).unwrap());
+}
+
+#[test]
+fn missing_sources_and_archive_failure_leave_no_output_or_locks() {
+    let (home, harness, destination) = fixture();
+    let output = destination.path().join("backup.tar.zst");
+    fs::remove_file(home.path().join(INDEX)).unwrap();
+    assert!(
+        create_backup(
+            home.path(),
+            harness.path(),
+            &output,
+            &AtomicBool::new(false)
+        )
+        .is_err()
+    );
+    assert_destination_empty(destination.path());
+    fs::write(home.path().join(INDEX), b"restored\n").unwrap();
+    let _socket = UnixListener::bind(home.path().join("sessions/socket")).unwrap();
+    assert!(
+        create_backup(
+            home.path(),
+            harness.path(),
+            &output,
+            &AtomicBool::new(false)
+        )
+        .is_err()
+    );
+    assert_destination_empty(destination.path());
+    drop(codex_rollout::try_acquire_session_backup_lock(home.path(), harness.path()).unwrap());
+}
+
+#[test]
+fn cancellation_stops_copying_and_releases_backup_ownership() {
+    let (home, harness, destination) = fixture();
+    let cancelled = AtomicBool::new(true);
+    let error = create_backup(
+        home.path(),
+        harness.path(),
+        &destination.path().join("backup.tar.zst"),
+        &cancelled,
+    )
+    .unwrap_err();
+    assert!(error.to_string().contains("cancelled"));
+    assert_destination_empty(destination.path());
+    drop(codex_rollout::try_acquire_session_backup_lock(home.path(), harness.path()).unwrap());
+
+    let cancelled = AtomicBool::new(false);
+    let mut writer = CancellableWriter {
+        inner: Vec::new(),
+        cancelled: &cancelled,
+    };
+    writer.write_all(b"first chunk").unwrap();
+    cancelled.store(true, Ordering::Relaxed);
+    assert!(writer.write_all(b"second chunk").is_err());
+    assert_eq!(writer.inner, b"first chunk");
+}
