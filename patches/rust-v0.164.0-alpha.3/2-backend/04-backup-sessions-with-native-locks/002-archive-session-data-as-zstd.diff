+use std::fs;
+use std::fs::File;
+use std::io;
+use std::io::Seek;
+use std::io::Write;
+use std::path::Path;
+use std::path::PathBuf;
+use std::sync::Arc;
+use std::sync::atomic::AtomicBool;
+use std::sync::atomic::Ordering;
+
+use anyhow::Context;
+use clap::Parser;
+use codex_core::config::ConfigBuilder;
+use codex_utils_cli::CliConfigOverrides;
+
+const DIRECTORIES: [&str; 2] = ["archived_sessions", "sessions"];
+const INDEX: &str = "session_index.jsonl";
+
+#[derive(Debug, Parser)]
+pub(crate) struct BackupSessionsCommand {
+    /// New zstd-compressed tar archive in an existing directory. Never overwritten.
+    #[arg(value_name = "OUTPUT.tar.zst")]
+    output: PathBuf,
+}
+
+pub(crate) async fn run(
+    command: BackupSessionsCommand,
+    config_overrides: CliConfigOverrides,
+) -> anyhow::Result<()> {
+    let config = ConfigBuilder::default()
+        .cli_overrides(
+            config_overrides
+                .parse_overrides()
+                .map_err(anyhow::Error::msg)?,
+        )
+        .build()
+        .await?;
+    let mut interrupt = tokio::signal::unix::signal(tokio::signal::unix::SignalKind::interrupt())?;
+    let mut terminate = tokio::signal::unix::signal(tokio::signal::unix::SignalKind::terminate())?;
+    let cancelled = Arc::new(AtomicBool::new(false));
+    let worker_cancelled = Arc::clone(&cancelled);
+    // The worker owns both the locks and staging file, even if its async waiter is dropped.
+    let mut worker = tokio::task::spawn_blocking(move || {
+        create_backup(
+            &config.codex_home,
+            &config.codex_harness,
+            &command.output,
+            &worker_cancelled,
+        )
+    });
+    let result = tokio::select! {
+        result = &mut worker => result,
+        _ = interrupt.recv() => {
+            cancelled.store(true, Ordering::Relaxed);
+            worker.await
+        }
+        _ = terminate.recv() => {
+            cancelled.store(true, Ordering::Relaxed);
+            worker.await
+        }
+    };
+    let output = result.context("session backup worker failed")??;
+    println!("Backup completed: {}", output.display());
+    Ok(())
+}
+
+fn create_backup(
+    home: &Path,
+    harness: &Path,
+    output: &Path,
+    cancelled: &AtomicBool,
+) -> anyhow::Result<PathBuf> {
+    let parent = output
+        .parent()
+        .filter(|parent| !parent.as_os_str().is_empty())
+        .unwrap_or_else(|| Path::new("."))
+        .canonicalize()
+        .context("backup destination directory is unavailable")?;
+    let filename = output
+        .file_name()
+        .context("backup output needs a filename")?;
+    let output = parent.join(filename);
+    match output.symlink_metadata() {
+        Ok(_) => anyhow::bail!(
+            "refusing to overwrite an existing backup: {}",
+            output.display()
+        ),
+        Err(error) if error.kind() == io::ErrorKind::NotFound => {}
+        Err(error) => return Err(error.into()),
+    }
+    check_sources(home)?;
+    let _locks = codex_rollout::try_acquire_session_backup_lock(home, harness)
+        .context("session backup requires all native session-data locks to be idle")?;
+    // Acquisition may span many files. Recheck every source only after the full lock set is held.
+    check_sources(home)?;
+    for directory in DIRECTORIES {
+        let source = home.join(directory);
+        if !source.symlink_metadata()?.file_type().is_symlink()
+            && parent.starts_with(source.canonicalize()?)
+        {
+            anyhow::bail!("backup output cannot be inside {directory}");
+        }
+    }
+    ensure_running(cancelled)?;
+    let mut staged = tempfile::Builder::new()
+        .prefix(".codex-sessions-backup-")
+        .tempfile_in(parent)?;
+    if let Err(error) = write_archive(home, staged.as_file_mut(), cancelled) {
+        staged
+            .close()
+            .with_context(|| format!("backup failed ({error}); staging cleanup failed"))?;
+        return Err(error.into());
+    }
+    match staged.persist_noclobber(&output) {
+        Ok(_) => Ok(output),
+        Err(error) => {
+            let publication_error = error.error;
+            error.file.close().with_context(|| {
+                format!("backup publication failed ({publication_error}); staging cleanup failed")
+            })?;
+            Err(publication_error).context("failed to publish backup without overwriting")
+        }
+    }
+}
+
+fn check_sources(home: &Path) -> anyhow::Result<()> {
+    for directory in DIRECTORIES {
+        let path = home.join(directory);
+        anyhow::ensure!(
+            path.metadata()?.is_dir(),
+            "source is not a directory: {}",
+            path.display()
+        );
+    }
+    let index = home.join(INDEX);
+    anyhow::ensure!(
+        index.metadata()?.is_file(),
+        "source index is not a file: {}",
+        index.display()
+    );
+    Ok(())
+}
+
+fn write_archive(home: &Path, file: &mut File, cancelled: &AtomicBool) -> io::Result<()> {
+    let mut encoder = zstd::stream::write::Encoder::new(&mut *file, 0)?;
+    encoder.include_checksum(true)?;
+    let mut archive = tar::Builder::new(CancellableWriter {
+        inner: encoder,
+        cancelled,
+    });
+    archive.follow_symlinks(false);
+    for directory in DIRECTORIES {
+        let source = home.join(directory);
+        if source.symlink_metadata()?.file_type().is_symlink() {
+            archive.append_path_with_name(source, directory)?;
+        } else {
+            archive.append_dir_all(directory, source)?;
+        }
+    }
+    archive.append_path_with_name(home.join(INDEX), INDEX)?;
+    archive.into_inner()?.inner.finish()?;
+    file.rewind()?;
+    let mut decoder = zstd::stream::read::Decoder::new(&mut *file)?;
+    io::copy(
+        &mut decoder,
+        &mut CancellableWriter {
+            inner: io::sink(),
+            cancelled,
+        },
+    )?;
+    ensure_running(cancelled)
+}
+
+fn ensure_running(cancelled: &AtomicBool) -> io::Result<()> {
+    if cancelled.load(Ordering::Relaxed) {
+        // Write::write_all and io::copy retry Interrupted, so cancellation must be terminal.
+        Err(io::Error::other("session backup cancelled"))
+    } else {
+        Ok(())
+    }
+}
+
+struct CancellableWriter<'a, W> {
+    inner: W,
+    cancelled: &'a AtomicBool,
+}
+
+impl<W: Write> Write for CancellableWriter<'_, W> {
+    fn write(&mut self, buffer: &[u8]) -> io::Result<usize> {
+        ensure_running(self.cancelled)?;
+        self.inner.write(buffer)
+    }
+
+    fn flush(&mut self) -> io::Result<()> {
+        ensure_running(self.cancelled)?;
+        self.inner.flush()
+    }
+}
