+#[tokio::test]
+async fn child_start_inherits_rebound_tui_endpoint_from_live_parent() {
+    let home = tempdir().unwrap();
+    let mut captured = crate::config::ConfigBuilder::without_managed_config_for_tests()
+        .codex_home(home.path().to_path_buf())
+        .fallback_cwd(Some(home.path().to_path_buf()))
+        .cli_overrides(vec![(
+            "mcp_servers.codex_tui".to_string(),
+            toml::from_str(
+                "url = 'http://127.0.0.1:39087/mcp'\n\
+                 enabled = false\n\
+                 http_headers = { Authorization = 'Bearer previous' }\n\
+                 default_tools_approval_mode = 'prompt'",
+            )
+            .unwrap(),
+        )])
+        .build()
+        .await
+        .unwrap();
+    let manager = ThreadManager::with_models_provider_and_home_for_tests(
+        CodexAuth::from_api_key("dummy"),
+        captured.model_provider.clone(),
+        captured.codex_home.to_path_buf(),
+        Arc::new(codex_exec_server::EnvironmentManager::default_for_tests()),
+    );
+    let parent = manager
+        .start_thread(StartThreadOptions::new(captured.clone()))
+        .await
+        .unwrap();
+    let previous = captured.mcp_servers.get()["codex_tui"].clone();
+    let replacement = serde_json::from_value::<codex_config::McpServerConfig>(serde_json::json!({
+        "url": "http://127.0.0.1:39088/mcp",
+        "http_headers": {"Authorization": "Bearer replacement"}
+    }))
+    .unwrap();
+    assert!(
+        parent
+            .thread
+            .rebind_session_mcp_endpoint("codex_tui", &previous.transport, &replacement.transport)
+            .await
+            .unwrap()
+    );
+    // The invoking Turn can retain its model settings and the old endpoint.
+    captured.model_reasoning_effort = Some(ReasoningEffort::Low);
+    let start_child = || {
+        manager.state.spawn_child_thread(
+            StartThreadOptions {
+                session_source: Some(SessionSource::SubAgent(SubAgentSource::ThreadSpawn {
+                    parent_thread_id: parent.thread_id,
+                    depth: 1,
+                    agent_path: None,
+                    agent_role: None,
+                    agent_nickname: None,
+                })),
+                ..StartThreadOptions::new(captured.clone())
+            },
+            parent
+                .thread
+                .session
+                .services
+                .local_agent_runtime
+                .control(parent.thread.session.session_id()),
+            Some(parent.thread_id),
+            None,
+        )
+    };
+    let child = start_child().await.unwrap();
+    let child_config = child.thread.config().await;
+    let mut expected = previous.clone();
+    expected.transport = replacement.transport.clone();
+    assert_eq!(child_config.mcp_servers.get()["codex_tui"], expected);
+    assert_eq!(
+        child_config.model_reasoning_effort,
+        Some(ReasoningEffort::Low)
+    );
+    assert_eq!(captured.mcp_servers.get()["codex_tui"], previous);
+
+    let next = serde_json::from_value::<codex_config::McpServerConfig>(serde_json::json!({
+        "url": "http://127.0.0.1:39089/mcp",
+        "http_headers": {"Authorization": "Bearer next"}
+    }))
+    .unwrap();
+    let concurrent_child = start_child();
+    tokio::pin!(concurrent_child);
+    {
+        // Pause admission at its first parent lookup, without a scheduler hook.
+        let _threads = manager.state.threads.write().await;
+        assert!(futures::poll!(&mut concurrent_child).is_pending());
+    }
+    let rebind = async {
+        let _rebinding = manager.lock_tui_mcp_rebinding().await;
+        let descendants = manager
+            .list_agent_subtree_thread_ids(parent.thread_id)
+            .await
+            .unwrap();
+        assert!(descendants.contains(&child.thread_id));
+        assert_eq!(descendants.len(), 3);
+        for id in descendants {
+            assert!(
+                manager
+                    .get_thread(id)
+                    .await
+                    .unwrap()
+                    .rebind_session_mcp_endpoint(
+                        "codex_tui",
+                        &replacement.transport,
+                        &next.transport
+                    )
+                    .await
+                    .unwrap()
+            );
+        }
+    };
+    tokio::pin!(rebind);
+    assert!(futures::poll!(&mut rebind).is_pending());
+    let concurrent_child = concurrent_child.await.unwrap();
+    rebind.await;
+    expected.transport = next.transport.clone();
+    for thread in [&child.thread, &concurrent_child.thread] {
+        let config = thread.config().await;
+        assert_eq!(config.mcp_servers.get()["codex_tui"], expected);
+        assert_eq!(config.model_reasoning_effort, Some(ReasoningEffort::Low));
+    }
+    let report = manager
+        .shutdown_all_threads_bounded(Duration::from_secs(10))
+        .await;
+    assert_eq!(report.completed.len(), 3);
+}
