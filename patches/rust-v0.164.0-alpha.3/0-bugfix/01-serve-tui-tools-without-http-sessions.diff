+    /// Rebinds an HTTP server already injected by this session, without changing
+    /// its tool policy or persisting the client-owned endpoint in user config.
+    pub fn with_session_mcp_http_endpoint(
+        &self,
+        name: &str,
+        url: &str,
+        http_headers: &Option<HashMap<String, String>>,
+    ) -> Option<Self> {
+        let mut stack = self.clone();
+        let layer = stack.layers.iter_mut().rev().find(|layer| {
+            matches!(layer.name, ConfigLayerSource::SessionFlags)
+                && !layer.is_disabled()
+                && layer
+                    .config
+                    .get("mcp_servers")
+                    .and_then(|servers| servers.get(name))
+                    .and_then(|server| server.get("url"))
+                    .is_some_and(TomlValue::is_str)
+        })?;
+        let server = layer
+            .config
+            .get_mut("mcp_servers")?
+            .get_mut(name)?
+            .as_table_mut()?;
+        server.insert("url".to_string(), TomlValue::String(url.to_string()));
+        match http_headers {
+            Some(headers) => {
+                server.insert(
+                    "http_headers".to_string(),
+                    TomlValue::Table(
+                        headers
+                            .iter()
+                            .map(|(name, value)| (name.clone(), TomlValue::String(value.clone())))
+                            .collect(),
+                    ),
+                );
+            }
+            None => {
+                server.remove("http_headers");
+            }
+        }
+        layer.version = version_for_toml(&layer.config);
+        layer.raw_toml = None;
+        Some(stack)
+    }
