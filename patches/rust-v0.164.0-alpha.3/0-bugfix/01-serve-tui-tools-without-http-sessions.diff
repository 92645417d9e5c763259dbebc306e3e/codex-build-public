+            .map_err(|error| invalid_request(format!("invalid TUI MCP configuration: {error}")))?;
+            if previous.transport == replacement.transport {
+                remaining.remove(&key);
+                continue;
+            }
+            let descendants = self
+                .thread_manager
+                .list_agent_subtree_thread_ids(thread_id)
+                .await
+                .map_err(|error| {
+                    internal_error(format!("failed to load TUI MCP descendants: {error}"))
+                })?;
+            // Publish the parent last. A partial failure leaves its old endpoint
+            // available to identify the remaining inherited bindings on resume.
+            for target_id in descendants
+                .into_iter()
+                .filter(|id| *id != thread_id)
+                .chain(std::iter::once(thread_id))
+            {
+                if self
+                    .thread_state_manager
+                    .subscribed_connection_ids(target_id)
+                    .await
+                    .iter()
+                    .any(|id| *id != request_id.connection_id)
+                {
+                    continue;
+                }
+                let Ok(target) = self.thread_manager.get_thread(target_id).await else {
+                    // Unloaded children inherit the live parent when next started.
+                    continue;
+                };
+                let changed = target
+                    .rebind_session_mcp_endpoint(name, &previous.transport, &replacement.transport)
+                    .await
+                    .map_err(|error| {
+                        internal_error(format!(
+                            "failed to rebind TUI MCP server {name} for thread {target_id}: {error}"
+                        ))
+                    })?;
+                if target_id == thread_id && changed {
+                    remaining.remove(&key);
+                }
+            }
+        }
+        Ok((!remaining.is_empty()).then_some(remaining))
+    }
