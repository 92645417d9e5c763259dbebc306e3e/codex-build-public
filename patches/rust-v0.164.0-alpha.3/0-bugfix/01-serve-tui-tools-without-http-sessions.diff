 impl Config {
+    pub(crate) fn rebind_session_mcp_endpoint(
+        &mut self,
+        name: &str,
+        expected: &McpServerTransportConfig,
+        replacement: &McpServerTransportConfig,
+    ) -> std::io::Result<bool> {
+        let Some(current) = self.mcp_servers.get().get(name) else {
+            return Ok(false);
+        };
+        if &current.transport != expected || expected == replacement {
+            return Ok(false);
+        }
+        let McpServerTransportConfig::StreamableHttp {
+            url, http_headers, ..
+        } = replacement
+        else {
+            return Ok(false);
+        };
+        let Some(layers) =
+            self.config_layer_stack
+                .with_session_mcp_http_endpoint(name, url, http_headers)
+        else {
+            // User- and project-configured servers do not belong to the TUI.
+            return Ok(false);
+        };
+        let mut server = current.clone();
+        let McpServerTransportConfig::StreamableHttp {
+            url: current_url,
+            http_headers: current_headers,
+            ..
+        } = &mut server.transport
+        else {
+            return Ok(false);
+        };
+        current_url.clone_from(url);
+        current_headers.clone_from(http_headers);
+        let was_enabled = server.enabled;
+        let mut servers = self.mcp_servers.clone();
+        let mut values = servers.get().clone();
+        values.insert(name.to_string(), server);
+        servers.set(values).map_err(std::io::Error::other)?;
+        if was_enabled && !servers.get()[name].enabled {
+            return Err(std::io::Error::new(
+                std::io::ErrorKind::PermissionDenied,
+                format!("managed MCP requirements do not permit rebinding {name}"),
+            ));
+        }
+        self.mcp_servers = servers;
+        self.config_layer_stack = layers;
+        Ok(true)
+    }
+
+    pub(crate) fn inherit_tui_mcp_endpoints(&mut self, parent: &Self) -> std::io::Result<()> {
+        for name in TUI_MCP_SERVER_NAMES {
+            if let Some(current) = self.mcp_servers.get().get(name)
+                && let Some(live) = parent.mcp_servers.get().get(name)
+            {
+                let expected = current.transport.clone();
+                self.rebind_session_mcp_endpoint(name, &expected, &live.transport)?;
+            }
+        }
+        Ok(())
+    }
