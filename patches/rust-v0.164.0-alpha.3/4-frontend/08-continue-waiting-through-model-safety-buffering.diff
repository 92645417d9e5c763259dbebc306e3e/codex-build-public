+#[tokio::test]
+async fn safety_buffering_live_status_ignores_replay_and_clears_on_completion() {
+    let (mut chat, mut rx, mut op_rx) = make_chatwidget_manual(/*model_override*/ None).await;
+    let (thread_id, turn_id, _) = start_safety_buffering_test_turn(&mut chat, &mut op_rx);
+    chat.safety_buffering_prompt = None;
+    let initial = render_bottom_popup(&chat, /*width*/ 80);
+    for (id, show, replay) in [
+        (turn_id, false, None),
+        ("stale-turn", true, None),
+        (turn_id, true, Some(ReplayKind::ResumeInitialMessages)),
+        (turn_id, true, Some(ReplayKind::ThreadSnapshot)),
+    ] {
+        let mut notification = safety_buffering_notification(thread_id, id, None);
+        notification.show_buffering_ui = show;
+        chat.handle_server_notification(
+            ServerNotification::ModelSafetyBufferingUpdated(notification),
+            replay,
+        );
+        assert!(!chat.safety_buffering_is_waiting());
+        assert_eq!(render_bottom_popup(&chat, /*width*/ 80), initial);
+    }
+    let mut notification = safety_buffering_notification(thread_id, turn_id, None);
+    chat.handle_server_notification(
+        ServerNotification::ModelSafetyBufferingUpdated(notification.clone()),
+        None,
+    );
+    assert!(chat.safety_buffering_is_waiting());
+    assert!(!chat.bottom_pane.has_active_view());
+    notification.show_buffering_ui = false;
+    for replay in [
+        ReplayKind::ResumeInitialMessages,
+        ReplayKind::ThreadSnapshot,
+    ] {
+        chat.handle_server_notification(
+            ServerNotification::ModelSafetyBufferingUpdated(notification.clone()),
+            Some(replay),
+        );
+        assert!(chat.safety_buffering_is_waiting());
+    }
+    chat.handle_server_notification(
+        ServerNotification::ModelSafetyBufferingUpdated(notification.clone()),
+        None,
+    );
+    assert!(!chat.safety_buffering_is_waiting());
+    assert_eq!(chat.bottom_pane.status_widget().unwrap().details(), None);
+    notification.show_buffering_ui = true;
+    chat.handle_server_notification(
+        ServerNotification::ModelSafetyBufferingUpdated(notification.clone()),
+        None,
+    );
+    assert!(chat.safety_buffering_is_waiting());
+    handle_turn_completed(&mut chat, turn_id, None);
+    chat.handle_server_notification(
+        ServerNotification::ModelSafetyBufferingUpdated(notification.clone()),
+        None,
+    );
+    assert!(!chat.safety_buffering_is_waiting());
+    assert!(!chat.can_retry_safety_buffered_turn(turn_id));
+    chat.on_task_started();
+    chat.handle_server_notification(
+        ServerNotification::ModelSafetyBufferingUpdated(notification),
+        None,
+    );
+    assert!(chat.safety_buffering_is_waiting());
+    chat.finalize_turn();
+    assert!(!chat.safety_buffering_is_waiting());
+    assert!(!chat.can_retry_safety_buffered_turn(turn_id));
+    assert!(op_rx.try_recv().is_err());
+    while let Ok(event) = rx.try_recv() {
+        assert!(!matches!(
+            event,
+            AppEvent::ConfirmSafetyBufferedRetry { .. } | AppEvent::RetrySafetyBufferedTurn { .. }
+        ));
+    }
+}
