+#[tokio::test]
+async fn safety_buffering_live_status_restores_reasoning_without_rearming() {
+    for fullscreen in [false, true] {
+        let (mut chat, _rx, mut op_rx) = make_chatwidget_manual(/*model_override*/ None).await;
+        chat.local_settings.tui.fullscreen_transcript = fullscreen;
+        let (thread_id, turn_id, _) = start_safety_buffering_test_turn(&mut chat, &mut op_rx);
+        let mut notification =
+            safety_buffering_notification(thread_id, turn_id, Some("faster-model"));
+        chat.handle_server_notification(
+            ServerNotification::ModelSafetyBufferingUpdated(notification.clone()),
+            None,
+        );
+        chat.on_agent_reasoning_delta("Pending reasoning".to_string());
+        assert!(chat.safety_buffering_is_waiting());
+        chat.on_agent_message_delta("Visible response".to_string());
+        assert!(!chat.safety_buffering_is_waiting());
+        assert_eq!(chat.status_state.current_status.header, "Pending reasoning");
+        assert_eq!(chat.status_state.current_status.details, None);
+        let popup = render_bottom_popup(&chat, /*width*/ 80);
+        for show in [true, false, true] {
+            notification.show_buffering_ui = show;
+            chat.handle_server_notification(
+                ServerNotification::ModelSafetyBufferingUpdated(notification.clone()),
+                None,
+            );
+            assert!(!chat.can_retry_safety_buffered_turn(turn_id));
+            assert_eq!(render_bottom_popup(&chat, /*width*/ 80), popup);
+        }
+    }
+}
