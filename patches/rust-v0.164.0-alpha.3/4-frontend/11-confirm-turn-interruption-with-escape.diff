+use super::*;
+use codex_protocol::items::AsyncUserInputQuestion;
+use pretty_assertions::assert_eq;
+
+#[tokio::test]
+async fn escape_confirmation_is_inline_and_defaults_to_keep_working() {
+    let (mut chat, mut events, mut ops) = make_chatwidget_manual(/*model_override*/ None).await;
+    chat.thread_id = Some(ThreadId::new());
+    handle_turn_started(&mut chat, "turn-1");
+    chat.bottom_pane
+        .set_composer_text("retained draft".into(), Vec::new(), Vec::new());
+
+    for key in [KeyCode::Enter, KeyCode::Esc] {
+        chat.handle_key_event(KeyEvent::from(KeyCode::Esc));
+        assert!(chat.bottom_pane.has_active_view());
+        assert!(!chat.bottom_pane.has_centered_view());
+        assert!(chat.turn_lifecycle.agent_turn_running);
+        assert!(events.try_recv().is_err());
+        assert!(ops.try_recv().is_err());
+        if key == KeyCode::Enter {
+            insta::assert_snapshot!(
+                "inline_turn_interruption_confirmation",
+                render_bottom_popup(&chat, /*width*/ 60)
+            );
+        }
+        chat.handle_key_event(KeyEvent::from(key));
+        assert!(!chat.bottom_pane.has_active_view());
+        assert!(chat.turn_lifecycle.agent_turn_running);
+        assert_eq!(chat.bottom_pane.composer_text(), "retained draft");
+        assert!(events.try_recv().is_err());
+        assert!(ops.try_recv().is_err());
+    }
+
+    chat.handle_key_event(KeyEvent::from(KeyCode::Esc));
+    chat.handle_key_event(KeyEvent::from(KeyCode::Char('2')));
+    assert!(chat.bottom_pane.has_active_view());
+    assert!(events.try_recv().is_err());
+    chat.handle_key_event(KeyEvent::from(KeyCode::Enter));
+    assert_matches!(
+        events.try_recv(),
+        Ok(AppEvent::ConfirmTurnInterruption { .. })
+    );
+    assert!(events.try_recv().is_err());
+    assert!(ops.try_recv().is_err());
+}
+
+#[tokio::test]
+async fn confirmation_dismisses_when_the_turn_ends_or_changes() {
+    for change in ["completed", "interrupted", "next_turn", "unavailable"] {
+        let (mut chat, _events, _ops) = make_chatwidget_manual(/*model_override*/ None).await;
+        chat.thread_id = Some(ThreadId::new());
+        handle_turn_started(&mut chat, "turn-1");
+        chat.handle_key_event(KeyEvent::from(KeyCode::Esc));
+        assert!(chat.bottom_pane.has_active_view());
+        match change {
+            "completed" => handle_turn_completed(&mut chat, "turn-1", None),
+            "interrupted" => handle_turn_interrupted(&mut chat, "turn-1"),
+            "next_turn" => handle_turn_started(&mut chat, "turn-2"),
+            "unavailable" => chat.pause_unavailable_thread(),
+            _ => unreachable!(),
+        }
+        assert!(!chat.bottom_pane.has_active_view(), "{change}");
+    }
+}
+
+#[tokio::test]
+async fn delayed_confirmation_cannot_interrupt_a_completed_or_replacement_turn() {
+    for change in ["completed", "next_turn", "other_thread"] {
+        let (mut chat, mut events, mut ops) = make_chatwidget_manual(/*model_override*/ None).await;
+        chat.thread_id = Some(ThreadId::new());
+        handle_turn_started(&mut chat, "turn-1");
+        chat.handle_key_event(KeyEvent::from(KeyCode::Esc));
+        chat.handle_key_event(KeyEvent::from(KeyCode::Down));
+        chat.handle_key_event(KeyEvent::from(KeyCode::Enter));
+        let AppEvent::ConfirmTurnInterruption {
+            thread_id,
+            turn_id,
+            key_event,
+        } = events.try_recv().unwrap()
+        else {
+            panic!("expected turn confirmation");
+        };
+        match change {
+            "completed" => handle_turn_completed(&mut chat, "turn-1", None),
+            "next_turn" => handle_turn_started(&mut chat, "turn-2"),
+            "other_thread" => {
+                chat.thread_id = Some(ThreadId::new());
+                handle_turn_started(&mut chat, "turn-1");
+            }
+            _ => unreachable!(),
+        }
+        while events.try_recv().is_ok() {}
+        while ops.try_recv().is_ok() {}
+        assert_matches!(
+            chat.confirm_turn_interruption(thread_id, turn_id, key_event),
+            KeyEventAction::None
+        );
+        assert!(events.try_recv().is_err(), "{change}");
+        assert!(ops.try_recv().is_err(), "{change}");
+    }
+}
