+        assert!(events.try_recv().is_err());
+        assert!(ops.try_recv().is_err());
+        assert_eq!(chat.bottom_pane.has_active_view(), !esc_back);
+        assert_eq!(
+            chat.bottom_pane.questions.as_ref().unwrap().expanded,
+            !esc_back
+        );
+        if !esc_back {
+            chat.handle_key_event(KeyEvent::from(KeyCode::Esc));
+            assert!(chat.bottom_pane.questions.as_ref().unwrap().expanded);
+            assert_eq!(
+                chat.bottom_pane
+                    .questions
+                    .as_ref()
+                    .unwrap()
+                    .unanswered_count(),
+                1
+            );
+            chat.handle_key_event(KeyEvent::from(KeyCode::Esc));
+            confirm_pending_turn_interruption(&mut chat, &mut events);
+            assert_matches!(events.try_recv(), Ok(AppEvent::CodexOp(Op::Interrupt)));
+        }
+    }
+}
+
+#[tokio::test]
+async fn canceling_confirmation_preserves_the_underlying_blocking_question() {
+    let (mut chat, mut events, mut ops) = make_chatwidget_manual(/*model_override*/ None).await;
+    let thread_id = ThreadId::new();
+    chat.thread_id = Some(thread_id);
+    handle_turn_started(&mut chat, "turn-1");
+    chat.handle_request_user_input_now(ToolRequestUserInputParams {
+        thread_id: thread_id.to_string(),
+        item_id: "call-1".into(),
+        turn_id: "turn-1".into(),
+        questions: Vec::new(),
+        is_blocking: true,
+        auto_resolution_ms: None,
+    });
+    chat.handle_key_event(KeyEvent::from(KeyCode::Esc));
+    assert!(!chat.bottom_pane.has_centered_view());
+    assert!(render_bottom_popup(&chat, /*width*/ 60).contains("Stop this turn?"));
+    chat.handle_key_event(KeyEvent::from(KeyCode::Esc));
+    assert!(chat.bottom_pane.has_active_view());
+    assert!(!render_bottom_popup(&chat, /*width*/ 60).contains("Stop this turn?"));
+    assert!(events.try_recv().is_err());
+    assert!(ops.try_recv().is_err());
+    chat.handle_key_event(KeyEvent::from(KeyCode::Esc));
+    confirm_pending_turn_interruption(&mut chat, &mut events);
+    assert_matches!(events.try_recv(), Ok(AppEvent::CodexOp(Op::Interrupt)));
+}
