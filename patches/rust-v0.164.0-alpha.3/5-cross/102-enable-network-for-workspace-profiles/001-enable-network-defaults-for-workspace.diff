+#[test]
+fn workspace_network_default_survives_inheritance_and_explicit_restrictions() -> std::io::Result<()>
+{
+    let permissions = toml::from_str::<PermissionsToml>(
+        r#"
+[workspace]
+extends = ":workspace"
+
+[child]
+extends = "workspace"
+
+[restricted]
+extends = "child"
+
+[restricted.network]
+enabled = false
+
+[read_only]
+extends = ":read-only"
+
+[standalone.filesystem]
+":root" = "read"
+"#,
+    )
+    .expect("profiles should deserialize");
+    let cwd = TempDir::new()?;
+    let context = ConfigPathContext::new(
+        PathConvention::native(),
+        Some(PathUri::from_host_native_path(cwd.path())?),
+        /*user_home_dir*/ None,
+    );
+    for (name, network) in [
+        (BUILT_IN_WORKSPACE_PROFILE, NetworkSandboxPolicy::Enabled),
+        ("workspace", NetworkSandboxPolicy::Enabled),
+        ("child", NetworkSandboxPolicy::Enabled),
+        ("restricted", NetworkSandboxPolicy::Restricted),
+        (BUILT_IN_READ_ONLY_PROFILE, NetworkSandboxPolicy::Restricted),
+        ("read_only", NetworkSandboxPolicy::Restricted),
+        ("standalone", NetworkSandboxPolicy::Restricted),
+    ] {
+        let compiled = compile_permission_profile(
+            Some(&permissions),
+            name,
+            &context,
+            /*workspace_write*/ None,
+            &mut Vec::new(),
+        )?;
+        assert_eq!(
+            compiled.permission_profile.network_sandbox_policy(),
+            network,
+            "{name}"
+        );
+    }
+    Ok(())
+}
