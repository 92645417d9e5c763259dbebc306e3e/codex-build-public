+use super::*;
+use crate::ResponseMetrics;
+use crate::response_metrics::ResponseAttemptContext;
+use codex_api::ResponseObservation;
+use codex_api::ResponseObserver;
+use codex_protocol::response_metrics::ResponseAttemptEnd;
+use codex_protocol::response_metrics::ResponseTokenCounts;
+use pretty_assertions::assert_eq;
+use serde_json::json;
+use std::time::Duration;
+
+pub(super) fn recording() -> (Arc<ResponseMetrics>, Arc<ResponseHistory>) {
+    let history = Arc::new(ResponseHistory::default());
+    let retained = Arc::clone(&history);
+    let metrics = Arc::new(ResponseMetrics::new(move |record| retained.record(record)));
+    (metrics, history)
+}
+
+pub(super) fn context() -> ResponseAttemptContext {
+    ResponseAttemptContext {
+        thread_id: Some(ThreadId::new()),
+        turn_id: Some("turn-1".into()),
+        request_kind: "generation".into(),
+        requested_model: "model".into(),
+        reasoning_effort: None,
+    }
+}
+
+#[tokio::test(start_paused = true)]
+async fn pages_keep_live_identities_and_last_generation_outside_filters() {
+    let (metrics, history) = recording();
+    let first_context = context();
+    let thread_id = first_context.thread_id;
+    let first = metrics.start(first_context, Instant::now(), 1000);
+    first.sent(Instant::now());
+    first.received(
+        ResponseObservation {
+            served_model: Some("served".into()),
+            usage: Some(json!({"output_tokens": 0})),
+            terminal: Some(ResponseAttemptEnd::Failed),
+            ..Default::default()
+        },
+        Instant::now(),
+    );
+    let first_row = history.page(None, None, None, None, 1).await.data.remove(0);
+    let second = metrics.start(context(), Instant::now(), 1000);
+    let second_id = history.page(None, None, None, None, 1).await.data[0].attempt_id;
+    tokio::time::advance(Duration::from_secs(2)).await;
+    let page = history.page(None, None, None, None, 1).await;
+    assert_eq!(page.data.len(), 1);
+    assert_eq!(page.data[0].attempt_id, second_id);
+    assert_eq!(page.data[0].elapsed_ms, 2000);
+    assert_eq!(page.active_attempt_ids, vec![second_id]);
+    assert_eq!(
+        page.last_generation.unwrap().attempt_id,
+        first_row.attempt_id
+    );
+    let older = history.page(None, None, None, Some(second_id), 1).await;
+    assert_eq!(older.data, vec![first_row.clone()]);
+    assert_eq!(older.next_cursor, None);
+    let filtered = history.page(thread_id, Some("model"), None, None, 1).await;
+    assert_eq!(filtered.data, vec![first_row]);
+    assert_eq!(filtered.active_attempt_ids, vec![second_id]);
+    assert_eq!(filtered.models, vec!["model"]);
+    assert!(
+        history
+            .page(None, Some("served"), None, None, 1)
+            .await
+            .data
+            .is_empty()
+    );
+    drop(second);
+    assert!(
+        history
+            .page(None, None, None, None, 1)
+            .await
+            .active_attempt_ids
+            .is_empty()
+    );
+}
+
+#[tokio::test]
+async fn evicted_snapshots_do_not_keep_trackers_alive_or_displace_newer_history() {
+    let (metrics, history) = recording();
+    let oldest = metrics.start(context(), Instant::now(), 1000);
+    let oldest_id = history.page(None, None, None, None, 1).await.data[0].attempt_id;
+    for _ in 0..RECENT_RESPONSE_LIMIT {
+        drop(metrics.start(context(), Instant::now(), 1000));
+    }
+    let rows = history
+        .page(None, None, None, None, RECENT_RESPONSE_LIMIT)
+        .await
+        .data;
+    assert_eq!(rows.len(), RECENT_RESPONSE_LIMIT);
+    assert!(rows.iter().all(|row| row.attempt_id != oldest_id));
+    assert!(
+        rows.iter()
+            .all(|row| row.end_reason == Some(ResponseAttemptEnd::Canceled))
+    );
+    assert!(
+        rows.windows(2)
+            .all(|rows| rows[0].attempt_id > rows[1].attempt_id)
+    );
+    drop(oldest);
+    assert_eq!(
+        history
+            .page(None, None, None, None, RECENT_RESPONSE_LIMIT)
+            .await
+            .data,
+        rows
+    );
+}
+
+#[tokio::test(start_paused = true)]
+async fn terminal_receipt_stops_retained_clocks_before_output_validation() {
+    let (metrics, history) = recording();
+    let attempt = metrics.start(context(), Instant::now(), 1000);
+    attempt.sent(Instant::now());
+    tokio::time::advance(Duration::from_secs(1)).await;
+    attempt.received(
+        ResponseObservation {
+            usage: Some(json!({"output_tokens": 10})),
+            terminal: Some(ResponseAttemptEnd::Completed),
+            ..Default::default()
+        },
+        Instant::now(),
+    );
+    tokio::time::advance(Duration::from_secs(30)).await;
+    let pending = history.page(None, None, None, None, 1).await;
+    assert!(pending.active_attempt_ids.is_empty());
+    assert_eq!(pending.data[0].elapsed_ms, 1000);
+    assert_eq!(pending.data[0].end_reason, None);
+    assert_eq!(pending.data[0].tokens, ResponseTokenCounts::default());
+    assert!(history.notification_snapshot().is_empty());
+    attempt.ended(ResponseAttemptEnd::Completed, Instant::now());
+    let completed = history.page(None, None, None, None, 1).await;
+    assert_eq!(completed.data[0].elapsed_ms, 1000);
+    assert_eq!(completed.data[0].tokens.output, Some(10));
+    assert_eq!(completed.data[0].attempt_id, pending.data[0].attempt_id);
+    assert!(completed.data[0].revision > pending.data[0].revision);
+    assert_eq!(history.notification_snapshot(), completed.data);
+}
+
+#[tokio::test(start_paused = true)]
+async fn status_and_model_filters_page_live_transitions_before_limiting() {
+    let (metrics, history) = recording();
+    let older = metrics.start(context(), Instant::now(), 1000);
+    let newer = metrics.start(context(), Instant::now(), 1000);
+    let mut other_context = context();
+    other_context.requested_model = "other".into();
+    let other = metrics.start(other_context, Instant::now(), 1000);
+    let first = history
+        .page(
+            None,
+            Some("model"),
+            Some(ResponseAttemptStatus::Working),
+            None,
+            1,
+        )
+        .await;
+    assert_eq!(first.data.len(), 1);
+    assert_eq!(first.active_attempt_ids.len(), 3);
+    assert_eq!(first.models, vec!["model", "other"]);
+    let cursor = first.data[0].attempt_id;
+    assert_eq!(first.next_cursor, Some(cursor.to_string()));
+    let second = history
+        .page(
+            None,
+            Some("model"),
+            Some(ResponseAttemptStatus::Working),
+            Some(cursor),
+            1,
+        )
+        .await;
+    assert_eq!(second.data.len(), 1);
+    assert!(second.data[0].attempt_id < cursor);
+    assert_eq!(second.next_cursor, None);
+
+    newer.sent(Instant::now());
+    newer.received(
+        ResponseObservation {
+            terminal: Some(ResponseAttemptEnd::Completed),
+            ..Default::default()
+        },
+        Instant::now(),
+    );
+    let working = history
+        .page(
+            None,
+            Some("model"),
+            Some(ResponseAttemptStatus::Working),
+            None,
+            1,
+        )
+        .await;
+    assert_eq!(working.data, second.data);
+    assert_eq!(working.next_cursor, None);
+    let received = history
+        .page(None, None, Some(ResponseAttemptStatus::Received), None, 1)
+        .await;
+    assert_eq!(received.data[0].attempt_id, cursor);
+    assert!(!received.active_attempt_ids.contains(&cursor));
+    assert!(
+        history
+            .page(None, None, Some(ResponseAttemptStatus::Unfinished), None, 1)
+            .await
+            .data
+            .is_empty()
+    );
+    newer.ended(ResponseAttemptEnd::Completed, Instant::now());
+    assert!(
+        history
+            .page(None, None, Some(ResponseAttemptStatus::Received), None, 1)
+            .await
+            .data
+            .is_empty()
+    );
+    let completed = history
+        .page(
+            None,
+            Some("model"),
+            Some(ResponseAttemptStatus::Completed),
+            None,
+            1,
+        )
+        .await;
+    assert_eq!(completed.data[0].attempt_id, cursor);
+    assert_eq!(completed.last_generation.unwrap().attempt_id, cursor);
+    drop((older, other));
+}
