+//! Retained response observations, independent of transport and live trackers.
+
+use codex_app_server_protocol::ResponseAttemptsReadResponse;
+use codex_protocol::ThreadId;
+use codex_protocol::response_metrics::ResponseAttempt;
+use codex_protocol::response_metrics::ResponseAttemptStatus;
+use codex_protocol::response_metrics::ResponsePerformance;
+use std::collections::BTreeMap;
+use std::collections::BTreeSet;
+use std::collections::HashMap;
+use std::sync::Arc;
+use std::sync::Mutex;
+use tokio::time::Instant;
+use uuid::Uuid;
+
+const RECENT_RESPONSE_LIMIT: usize = 250;
+
+#[derive(Debug, Default)]
+pub struct ResponseHistory {
+    state: Mutex<HistoryState>,
+}
+
+#[derive(Debug, Default)]
+struct HistoryState {
+    recent: BTreeMap<Uuid, RetainedAttempt>,
+    has_older: bool,
+    models: BTreeSet<String>,
+    last_generations: HashMap<Option<ThreadId>, ResponsePerformance>,
+}
+
+#[derive(Debug)]
+struct RetainedAttempt {
+    record: ResponseAttempt,
+    observed_at: Option<Instant>,
+}
+
+impl RetainedAttempt {
+    fn snapshot(&self) -> ResponseAttempt {
+        let mut record = self.record.clone();
+        if let Some(at) = self.observed_at {
+            record.elapsed_ms += u64::try_from(at.elapsed().as_millis()).unwrap_or(u64::MAX);
+        }
+        record
+    }
+}
+
+impl ResponseHistory {
+    /// Consume a published snapshot without retaining or controlling its tracker.
+    pub fn record(self: &Arc<Self>, record: ResponseAttempt) {
+        let mut history = self.state.lock().expect("response history lock");
+        history.models.insert(record.requested_model.clone());
+        if record.end_reason.is_some() && record.request_kind == "generation" {
+            history.record_generation(ResponsePerformance::from(&record));
+        }
+        let observed_at = (record.end_reason.is_none()
+            && record.terminal_observed_offset_ms.is_none())
+        .then(Instant::now);
+        history.recent.insert(
+            record.attempt_id,
+            RetainedAttempt {
+                record,
+                observed_at,
+            },
+        );
+        history.trim();
+    }
+
+    pub async fn page(
+        self: &Arc<Self>,
+        thread_id: Option<ThreadId>,
+        model: Option<&str>,
+        status: Option<ResponseAttemptStatus>,
+        before: Option<Uuid>,
+        limit: usize,
+    ) -> ResponseAttemptsReadResponse {
+        let history = self.state.lock().expect("response history lock");
+        let mut data: Vec<_> = history
+            .recent
+            .values()
+            .rev()
+            .filter(|row| {
+                let record = &row.record;
+                before.is_none_or(|cursor| record.attempt_id < cursor)
+                    && thread_id.is_none_or(|id| record.thread_id == Some(id))
+                    && model.is_none_or(|model| record.requested_model == model)
+                    && status
+                        .is_none_or(|status| record.status(row.observed_at.is_some()) == status)
+            })
+            .take(limit + 1)
+            .map(RetainedAttempt::snapshot)
+            .collect();
+        let next_cursor = if data.len() > limit {
+            data.truncate(limit);
+            data.last().map(|row| row.attempt_id.to_string())
+        } else {
+            None
+        };
+        ResponseAttemptsReadResponse {
+            data,
+            next_cursor,
+            models: history.models.iter().cloned().collect(),
+            active_attempt_ids: history
+                .recent
+                .values()
+                .filter(|row| row.observed_at.is_some())
+                .map(|row| row.record.attempt_id)
+                .collect(),
+            last_generation: history
+                .last_generations
+                .values()
+                .filter(|last| thread_id.is_none_or(|id| Some(id) == last.thread_id))
+                .max_by_key(|last| last.attempt_id)
+                .cloned(),
+            persistence_error: None,
+        }
+    }
+
+    /// Resynchronize live subscribers without reviving unfinished stored records.
+    pub fn notification_snapshot(&self) -> Vec<ResponseAttempt> {
+        self.state
+            .lock()
+            .expect("response history lock")
+            .recent
+            .values()
+            .rev()
+            .filter(|row| row.observed_at.is_some() || row.record.end_reason.is_some())
+            .map(RetainedAttempt::snapshot)
+            .collect()
+    }
+}
+
+impl HistoryState {
+    fn record_generation(&mut self, performance: ResponsePerformance) {
+        let current = self
+            .last_generations
+            .entry(performance.thread_id)
+            .or_insert_with(|| performance.clone());
+        if current.attempt_id < performance.attempt_id {
+            *current = performance;
+        }
+    }
+
+    fn trim(&mut self) {
+        while self.recent.len() > RECENT_RESPONSE_LIMIT {
+            self.recent.pop_first();
+            self.has_older = true;
+        }
+    }
+}
