+const READ_TIMEOUT: Duration = Duration::from_secs(30);
+
+#[tokio::test]
+async fn response_pages_and_notifications_share_records_across_sessions() -> Result<()> {
+    skip_if_no_network!(Ok(()));
+    let usage = json!({
+        "input_tokens": 100, "input_tokens_details": {"cached_tokens": 10},
+        "output_tokens": 20, "output_tokens_details": {"reasoning_tokens": 12}, "total_tokens": 120,
+    });
+    let mut completed = ev_completed("answer");
+    completed["response"]["usage"] = usage.clone();
+    let connection = WebSocketConnectionConfig {
+        requests: vec![
+            vec![ev_response_created("prewarm"), ev_completed("prewarm")],
+            vec![
+                ev_response_created("answer"),
+                json!({"type": "codex.rate_limits", "rate_limits": {"secondary": {
+                    "used_percent": 12, "window_minutes": 10080, "reset_at": 1900000000
+                }}}),
+                ev_assistant_message("message", "Complete answer"),
+                completed,
+            ],
+        ],
+        response_headers: vec![("openai-model".into(), "served-model".into())],
+        accept_delay: None,
+        close_after_requests: true,
+    };
+    let server = start_websocket_server_with_headers(vec![connection.clone(), connection]).await;
+    let home = TempDir::new()?;
+    MockResponsesConfig::new(server.uri())
+        .with_provider_config("supports_websockets = true\nrequires_openai_auth = true")
+        .with_root_config("thread_unload_delay_secs = 0")
+        .write(home.path())?;
+    write_chatgpt_auth(
+        home.path(),
+        ChatGptAuthFixture::new("fake-access-token")
+            .account_id("metrics-account")
+            .plan_type("plus"),
+        AuthCredentialsStoreMode::File,
+    )?;
+    let mut app = TestAppServer::builder()
+        .with_codex_home(home.path())
+        .with_env_overrides(&[("OPENAI_API_KEY", None), ("CODEX_API_KEY", None)])
+        .build_initialized_with_timeout(READ_TIMEOUT)
+        .await?;
+    let mut records = Vec::new();
+    for text in ["first session", "second session"] {
+        let thread = app.start_thread(ThreadStartParams::default()).await?.thread;
+        let completed = timeout(
+            READ_TIMEOUT,
+            app.start_turn_and_wait_for_completion(TurnStartParams {
+                thread_id: thread.id.clone(),
+                input: vec![UserInput::Text {
+                    text: text.into(),
+                    text_elements: Vec::new(),
+                }],
+                ..Default::default()
+            }),
+        )
+        .await??;
+        let notification = timeout(
+            READ_TIMEOUT,
+            app.read_stream_until_matching_notification(
+                "completed response record",
+                |notification| {
+                    notification.method == "modelResponse/updated"
+                        && notification.params.as_ref().is_some_and(|params| {
+                            params["threadId"] == thread.id
+                                && params["attempt"]["requestKind"] == "generation"
+                                && params["attempt"]["endReason"] == "completed"
+                        })
+                },
+            ),
+        )
+        .await??;
+        let params = notification.params.unwrap();
+        assert!(params.get("quota").is_none());
+        for field in [
+            "provider",
+            "accountId",
+            "rateLimits",
+            "usageObservedSequence",
+        ] {
+            assert!(params["attempt"].get(field).is_none(), "unexpected {field}");
+        }
+        let update: ResponseAttemptUpdatedNotification = serde_json::from_value(params)?;
+        assert_eq!(update.thread_id.as_deref(), Some(thread.id.as_str()));
+        assert_eq!(
+            update.attempt.turn_id.as_deref(),
+            Some(completed.turn.id.as_str())
+        );
+        assert_eq!(
+            update.attempt.end_reason,
+            Some(ResponseAttemptEnd::Completed)
+        );
+        assert_eq!(
+            update.attempt.tokens,
+            ResponseTokenCounts {
+                input: Some(100),
+                cache_read: Some(10),
+                cache_write: Some(0),
+                output: Some(20),
+                reasoning: Some(12),
+            }
+        );
+        assert_eq!(update.attempt.served_model.as_deref(), Some("served-model"));
+        assert!(update.attempt.ttfb_ms.is_some());
+        assert!(update.attempt.ttfc_ms.is_some());
+        assert!(update.attempt.tps.is_some());
+        assert!(update.attempt.sent_payload_bytes.is_some());
+        records.insert(0, update.attempt);
+
+        let _: ThreadUnsubscribeResponse = app
+            .request(|request_id| ClientRequest::ThreadUnsubscribe {
+                request_id,
+                params: ThreadUnsubscribeParams {
+                    thread_id: thread.id,
+                },
+            })
+            .await?;
+        timeout(
+            READ_TIMEOUT,
+            app.read_stream_until_notification_message("thread/closed"),
+        )
+        .await??;
+    }
+    let request_count = server.connections().iter().map(Vec::len).sum::<usize>();
+    for _ in 0..2 {
+        let snapshot: ResponseAttemptsReadResponse = app
+            .request(|request_id| ClientRequest::ResponseAttemptsRead {
+                request_id,
+                params: ResponseAttemptsReadParams::default(),
+            })
+            .await?;
+        assert_eq!(snapshot.data, records);
+        assert!(snapshot.active_attempt_ids.is_empty());
+        assert_eq!(
+            snapshot.last_generation.unwrap().attempt_id,
+            records[0].attempt_id
+        );
+        assert_eq!(snapshot.models, vec![records[0].requested_model.clone()]);
+    }
+    let first: ResponseAttemptsReadResponse = app
+        .request(|request_id| ClientRequest::ResponseAttemptsRead {
+            request_id,
+            params: ResponseAttemptsReadParams {
+                limit: Some(1),
+                ..Default::default()
+            },
+        })
+        .await?;
+    assert_eq!(first.data, records[..1]);
+    let second: ResponseAttemptsReadResponse = app
+        .request(|request_id| ClientRequest::ResponseAttemptsRead {
+            request_id,
+            params: ResponseAttemptsReadParams {
+                cursor: first.next_cursor,
+                ..Default::default()
+            },
+        })
+        .await?;
+    assert_eq!(second.data, records[1..]);
+    let filtered: ResponseAttemptsReadResponse = app
+        .request(|request_id| ClientRequest::ResponseAttemptsRead {
+            request_id,
+            params: ResponseAttemptsReadParams {
+                thread_id: Some(records[1].thread_id.expect("session response").to_string()),
+                model: Some(records[1].requested_model.clone()),
+                status: Some(ResponseAttemptStatus::Completed),
+                ..Default::default()
+            },
+        })
+        .await?;
+    assert_eq!(filtered.data, records[1..]);
+    let working: ResponseAttemptsReadResponse = app
+        .request(|request_id| ClientRequest::ResponseAttemptsRead {
+            request_id,
+            params: ResponseAttemptsReadParams {
+                status: Some(ResponseAttemptStatus::Working),
+                ..Default::default()
+            },
+        })
+        .await?;
+    assert!(working.data.is_empty());
+    assert_eq!(
+        filtered.last_generation.unwrap().attempt_id,
+        records[1].attempt_id
+    );
+    assert_eq!(
+        server.connections().iter().map(Vec::len).sum::<usize>(),
+        request_count
+    );
+    assert!(
+        timeout(READ_TIMEOUT, app.shutdown_gracefully())
+            .await??
+            .success()
+    );
+    server.shutdown().await;
+    Ok(())
+}
+
+#[tokio::test]
+async fn response_page_rejects_invalid_session_and_cursor() -> Result<()> {
+    let mut app = TestAppServer::builder()
+        .build_initialized_with_timeout(READ_TIMEOUT)
+        .await?;
+    for (params, expected) in [
+        (
+            ResponseAttemptsReadParams {
+                thread_id: Some("invalid-thread".into()),
+                ..Default::default()
+            },
+            "invalid thread ID",
+        ),
+        (
+            ResponseAttemptsReadParams {
+                cursor: Some("invalid-cursor".into()),
+                ..Default::default()
+            },
+            "invalid response cursor",
+        ),
+    ] {
+        let id = app
+            .send_request("modelResponse/list", Some(serde_json::to_value(params)?))
+            .await?;
+        let error = timeout(
+            READ_TIMEOUT,
+            app.read_stream_until_error_message(RequestId::Integer(id)),
+        )
+        .await??;
+        assert_eq!(error.error.code, -32600);
+        assert!(error.error.message.contains(expected), "{error:?}");
+    }
+    assert!(
+        timeout(READ_TIMEOUT, app.shutdown_gracefully())
+            .await??
+            .success()
+    );
+    Ok(())
+}
