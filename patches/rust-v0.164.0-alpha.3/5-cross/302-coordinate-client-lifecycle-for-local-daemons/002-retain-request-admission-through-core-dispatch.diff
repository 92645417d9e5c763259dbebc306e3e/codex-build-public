+#[tokio::test]
+async fn dispatch_wait_distinguishes_queued_work_from_completed_dispatch() {
+    for dispatch in [true, false] {
+        let (session, turn_context) = make_session_and_context().await;
+        let (tx_sub, rx_sub) = async_channel::bounded(2);
+        let (_tx_event, rx_event) = async_channel::unbounded();
+        let io = SessionIo {
+            tx_sub,
+            rx_event,
+            agent_status: watch::channel(AgentStatus::PendingInit).1,
+            session_loop_termination: completed_session_loop_termination(),
+        };
+        let mut request =
+            Box::pin(io.submit_with_trace_and_wait_for_dispatch(Op::Interrupt, /*trace*/ None));
+        assert!(futures::poll!(request.as_mut()).is_pending());
+        assert_eq!(rx_sub.len(), 1);
+
+        if dispatch {
+            io.submit(Op::Shutdown).await.expect("queue shutdown");
+            submission_loop(Arc::new(session), turn_context.config, rx_sub).await;
+            request.await.expect("Core acknowledged dispatch");
+        } else {
+            let submission = rx_sub.recv().await.expect("accepted submission");
+            assert!(futures::poll!(request.as_mut()).is_pending());
+            drop(submission);
+            let error = request.await.expect_err("dropped dispatch must fail");
+            assert!(matches!(
+                error.details(),
+                CodexErrorDetails::InternalAgentDied
+            ));
+        }
+    }
+}
