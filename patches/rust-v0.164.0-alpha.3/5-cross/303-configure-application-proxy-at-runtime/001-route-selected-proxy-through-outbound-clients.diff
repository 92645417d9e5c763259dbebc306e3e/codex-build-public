+
+use pretty_assertions::assert_eq;
+
+use super::*;
+use crate::ClientRouteClass;
+use crate::HttpClientFactory;
+use crate::OutboundProxyPolicy;
+
+fn selected_proxy(address: SocketAddr) -> RuntimeProxyConfig {
+    RuntimeProxyConfig {
+        enabled: true,
+        selected: Some("lan".to_string()),
+        entries: vec![RuntimeProxyDefinition {
+            alias: "lan".to_string(),
+            url: format!("http://{address}"),
+        }],
+    }
+}
+
+fn response_server(
+    bind_address: &str,
+    body: &'static str,
+) -> (SocketAddr, std::thread::JoinHandle<String>) {
+    let listener = TcpListener::bind(bind_address).expect("listener");
+    let address = listener.local_addr().expect("address");
+    let server = std::thread::spawn(move || {
+        let (mut stream, _) = listener.accept().expect("request connection");
+        stream
+            .set_read_timeout(Some(Duration::from_secs(5)))
+            .expect("timeout");
+        let mut request = Vec::new();
+        let mut chunk = [0; 1024];
+        while !request.ends_with(b"\r\n\r\n") {
+            let received = stream.read(&mut chunk).expect("request headers");
+            assert!(received > 0 && request.len() < 65_536);
+            request.extend_from_slice(&chunk[..received]);
+        }
+        write!(
+            stream,
+            "HTTP/1.1 200 OK\r\nContent-Length: {}\r\nConnection: close\r\n\r\n{body}",
+            body.len()
+        )
+        .expect("response");
+        String::from_utf8(request).expect("request text")
+    });
+    (address, server)
+}
+
+#[test]
+fn configuration_requires_a_valid_selected_http_proxy() {
+    let config = selected_proxy("127.0.0.1:8080".parse().expect("address"));
+    assert_eq!(
+        validate_runtime_proxy_config(config.clone()).expect("valid"),
+        config
+    );
+    let mut credentialed = config.clone();
+    credentialed.entries[0].url = "https://user:secret@proxy.test:8443".to_string();
+    assert!(validate_runtime_proxy_config(credentialed.clone()).is_ok());
+    assert!(!format!("{credentialed:?}").contains("secret"));
+    let mut duplicate = config.clone();
+    duplicate.entries.push(duplicate.entries[0].clone());
+    assert!(validate_runtime_proxy_config(duplicate).is_err());
+    let mut missing = config.clone();
+    missing.selected = None;
+    assert!(validate_runtime_proxy_config(missing).is_err());
+    for url in [
+        "socks5://127.0.0.1:8080",
+        "http://",
+        "https://proxy.test/path",
+        "https://proxy.test/?q=1",
+    ] {
+        let mut invalid = config.clone();
+        invalid.entries[0].url = url.to_string();
+        assert!(validate_runtime_proxy_config(invalid).is_err(), "{url}");
+    }
+}
+
+#[tokio::test]
+async fn proxy_probe_client_uses_explicit_route_without_runtime_activation() {
+    let (proxy, server) = response_server("127.0.0.1:0", "probe");
+    let factory = HttpClientFactory::new(OutboundProxyPolicy::ReqwestDefault);
+    let response = factory
+        .build_client_for_proxy_probe(&format!("http://{proxy}"))
+        .expect("proxy probe client")
+        .get("http://origin.invalid/trace")
+        .timeout(Duration::from_secs(5))
+        .send()
+        .await
+        .expect("proxied probe");
+    assert_eq!(response.text().await.expect("body"), "probe");
+    assert!(
+        server
+            .join()
+            .expect("request")
+            .starts_with("GET http://origin.invalid/trace HTTP/1.1\r\n")
+    );
+}
