+#[test]
+fn runtime_proxy_routes_and_switches_without_changing_child_environment() {
+    let output = Command::new(std::env::current_exe().expect("test binary"))
+        .args([
+            "--exact",
+            "runtime_proxy::tests::runtime_proxy_process_probe",
+            "--nocapture",
+        ])
+        .env("CODEX_TEST_RUNTIME_PROXY", "1")
+        .env_remove("HTTP_PROXY")
+        .env_remove("HTTPS_PROXY")
+        .env_remove("ALL_PROXY")
+        .env_remove("http_proxy")
+        .env_remove("https_proxy")
+        .env_remove("all_proxy")
+        .env("NO_PROXY", "127.0.0.1,localhost")
+        .env_remove("no_proxy")
+        .output()
+        .expect("isolated test process");
+    assert!(
+        output.status.success(),
+        "{}\n{}",
+        String::from_utf8_lossy(&output.stdout),
+        String::from_utf8_lossy(&output.stderr)
+    );
+}
+
+#[tokio::test]
+async fn runtime_proxy_process_probe() {
+    if std::env::var_os("CODEX_TEST_RUNTIME_PROXY").is_none() {
+        return;
+    }
+    let proxy_environment = || {
+        std::env::vars()
+            .filter(|(name, _)| {
+                matches!(
+                    name.to_ascii_uppercase().as_str(),
+                    "HTTP_PROXY" | "HTTPS_PROXY" | "ALL_PROXY" | "NO_PROXY"
+                )
+            })
+            .collect::<BTreeMap<_, _>>()
+    };
+    let original_environment = proxy_environment();
+    set_runtime_proxy_config(RuntimeProxyConfig::default()).expect("disabled config");
+    let factory =
+        HttpClientFactory::new(OutboundProxyPolicy::ReqwestDefault).with_system_proxy_fallback();
+    // Construct before enabling: the same client must observe both switching and disabling.
+    let client = factory
+        .build_client("http://origin.invalid/start", ClientRouteClass::Api)
+        .expect("client");
+    let (first, first_server) = response_server("127.0.0.1:0", "first");
+    let snapshot = set_runtime_proxy_config(selected_proxy(first)).expect("select first proxy");
+    assert_eq!(
+        set_runtime_proxy_config(snapshot.config.clone()).expect("same config"),
+        snapshot
+    );
+    assert!(!factory.allows_system_proxy_fallback());
+    let response = client
+        .get("http://origin.invalid/start")
+        .timeout(Duration::from_secs(5))
+        .send()
+        .await
+        .expect("proxied request");
+    assert_eq!(response.text().await.expect("body"), "first");
+    assert!(
+        first_server
+            .join()
+            .expect("first request")
+            .starts_with("GET http://origin.invalid/start HTTP/1.1\r\n")
+    );
+
+    let (second, second_server) = response_server("127.0.0.1:0", "second");
+    set_runtime_proxy_config(selected_proxy(second)).expect("switch proxy");
+    let response = client
+        .get("http://another.invalid/account")
+        .timeout(Duration::from_secs(5))
+        .send()
+        .await
+        .expect("switched request");
+    assert_eq!(response.text().await.expect("body"), "second");
+    assert!(
+        second_server
+            .join()
+            .expect("second request")
+            .starts_with("GET http://another.invalid/account HTTP/1.1\r\n")
+    );
+
+    let unavailable = TcpListener::bind("127.0.0.1:0").expect("reserve proxy port");
+    let unavailable_address = unavailable.local_addr().expect("proxy port");
+    drop(unavailable);
+    set_runtime_proxy_config(selected_proxy(unavailable_address)).expect("unavailable proxy");
+    assert!(
+        client
+            .get("http://origin.invalid/no-fallback")
+            .timeout(Duration::from_secs(3))
+            .send()
+            .await
+            .is_err()
+    );
+    for bind_address in ["127.0.0.1:0", "[::1]:0"] {
+        let (direct, server) = response_server(bind_address, "local MCP");
+        let url = format!("http://{direct}/mcp");
+        assert_eq!(
+            factory.resolve_proxy_route(&url),
+            OutboundProxyRoute::Direct
+        );
+        assert_eq!(
+            factory
+                .resolve_proxy_route_async(url.clone())
+                .await
+                .expect("route"),
+            OutboundProxyRoute::Direct
+        );
+        let response = client
+            .get(url)
+            .header("Authorization", "Bearer local-test-token")
+            .timeout(Duration::from_secs(5))
+            .send()
+            .await
+            .expect("local request bypasses unavailable proxy");
+        assert_eq!(response.text().await.expect("body"), "local MCP");
+        let request = server.join().expect("local request");
+        assert!(request.starts_with("GET /mcp HTTP/1.1\r\n"));
+        assert!(
+            request
+                .to_ascii_lowercase()
+                .contains("authorization: bearer local-test-token\r\n")
+        );
+    }
+
+    let (direct, server) = response_server("127.0.0.1:0", "fixed route");
+    let url = format!("http://{direct}/fixed");
+    let fixed = factory
+        .build_reqwest_client(reqwest::Client::builder(), &url, ClientRouteClass::Api)
+        .expect("fixed client");
+    assert_eq!(
+        fixed
+            .get(url)
+            .send()
+            .await
+            .expect("direct request")
+            .text()
+            .await
+            .unwrap(),
+        "fixed route"
+    );
+    assert!(
+        server
+            .join()
+            .expect("fixed request")
+            .starts_with("GET /fixed HTTP/1.1\r\n")
+    );
+
+    set_runtime_proxy_config(RuntimeProxyConfig::default()).expect("disable proxy");
+    let (direct, direct_server) = response_server("127.0.0.1:0", "direct");
+    let response = client
+        .get(format!("http://{direct}/direct"))
+        .timeout(Duration::from_secs(5))
+        .send()
+        .await
+        .expect("upstream direct route");
+    assert_eq!(response.text().await.expect("body"), "direct");
+    assert!(
+        direct_server
+            .join()
+            .expect("direct request")
+            .starts_with("GET /direct HTTP/1.1\r\n")
+    );
+    // Default login/API transports retain legacy CA behavior, but a selected proxy still wins.
+    for direct_fallback in [false, true] {
+        let pool = crate::RouteAwareClientPool::new(factory.clone(), ClientRouteClass::Api);
+        let client = if direct_fallback {
+            pool.with_legacy_direct_proxy_and_custom_ca_fallback()
+        } else {
+            pool.with_legacy_custom_ca_fallback()
+        }
+        .into_client();
+        let (proxy, server) = response_server("127.0.0.1:0", "legacy");
+        set_runtime_proxy_config(selected_proxy(proxy)).expect("select legacy-client proxy");
+        let response = client
+            .get("http://origin.invalid/legacy")
+            .timeout(Duration::from_secs(5))
+            .send()
+            .await
+            .expect("selected proxy overrides legacy routing");
+        assert_eq!(response.text().await.expect("body"), "legacy");
+        assert!(
+            server
+                .join()
+                .expect("proxy request")
+                .starts_with("GET http://origin.invalid/legacy HTTP/1.1\r\n")
+        );
+        let (direct, server) = response_server("127.0.0.1:0", "legacy local");
+        let response = client
+            .get(format!("http://{direct}/mcp"))
+            .timeout(Duration::from_secs(5))
+            .send()
+            .await
+            .expect("legacy local request bypasses proxy");
+        assert_eq!(response.text().await.expect("body"), "legacy local");
+        assert!(
+            server
+                .join()
+                .expect("legacy local request")
+                .starts_with("GET /mcp HTTP/1.1\r\n")
+        );
+    }
+    set_runtime_proxy_config(RuntimeProxyConfig::default()).expect("disable after legacy clients");
+    assert_eq!(proxy_environment(), original_environment);
+    let shell = Command::new("/bin/sh")
+        .args(["-c", "env"])
+        .output()
+        .expect("shell environment");
+    assert!(shell.status.success());
+    let child_environment = String::from_utf8(shell.stdout)
+        .expect("environment text")
+        .lines()
+        .filter_map(|line| line.split_once('='))
+        .filter(|(name, _)| {
+            matches!(
+                name.to_ascii_uppercase().as_str(),
+                "HTTP_PROXY" | "HTTPS_PROXY" | "ALL_PROXY" | "NO_PROXY"
+            )
+        })
+        .map(|(name, value)| (name.to_string(), value.to_string()))
+        .collect::<BTreeMap<_, _>>();
+    assert_eq!(child_environment, original_environment);
+}
