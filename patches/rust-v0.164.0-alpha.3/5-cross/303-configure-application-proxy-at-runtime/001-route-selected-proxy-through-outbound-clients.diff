diff --git a/codex-rs/http-client/src/runtime_proxy.rs b/codex-rs/http-client/src/runtime_proxy.rs
new file mode 100644
--- /dev/null
+++ b/codex-rs/http-client/src/runtime_proxy.rs
@@ -0,0 +1,244 @@
+//! Application-process proxy selection. Never changes environment or sandbox policy.
+
+use std::collections::HashSet;
+use std::fmt;
+use std::io;
+use std::net::IpAddr;
+use std::net::Ipv4Addr;
+use std::net::Ipv6Addr;
+use std::sync::LazyLock;
+use std::sync::RwLock;
+
+use serde::Deserialize;
+use serde::Serialize;
+use tokio::sync::watch;
+
+use crate::OutboundProxyRoute;
+
+#[derive(Clone, Deserialize, Eq, PartialEq, Serialize)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub struct RuntimeProxyDefinition {
+    pub alias: String,
+    pub url: String,
+}
+
+impl fmt::Debug for RuntimeProxyDefinition {
+    fn fmt(&self, formatter: &mut fmt::Formatter<'_>) -> fmt::Result {
+        formatter
+            .debug_struct("RuntimeProxyDefinition")
+            .field("alias", &self.alias)
+            .field("url", &"<redacted>")
+            .finish()
+    }
+}
+
+#[derive(Clone, Debug, Default, Deserialize, Eq, PartialEq, Serialize)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub struct RuntimeProxyConfig {
+    #[serde(default)]
+    pub enabled: bool,
+    #[serde(default)]
+    pub selected: Option<String>,
+    #[serde(default)]
+    pub entries: Vec<RuntimeProxyDefinition>,
+}
+
+impl RuntimeProxyConfig {
+    pub fn active_alias(&self) -> Option<&str> {
+        self.enabled.then_some(self.selected.as_deref()).flatten()
+    }
+
+    fn route(&self, request_url: &str) -> Option<OutboundProxyRoute> {
+        let alias = self.active_alias()?;
+        if bypasses_runtime_proxy(request_url) {
+            return Some(OutboundProxyRoute::Direct);
+        }
+        self.entries
+            .iter()
+            .find(|proxy| proxy.alias == alias)
+            .map(|proxy| OutboundProxyRoute::Proxy {
+                url: proxy.url.clone(),
+                no_proxy: None,
+            })
+    }
+}
+
+// Keep local and reserved destinations on the host's network. Other DNS names remain
+// proxy-resolved; resolving them here would change proxy DNS and privacy semantics.
+fn bypasses_runtime_proxy(request_url: &str) -> bool {
+    let Ok(url) = reqwest::Url::parse(request_url) else {
+        return false;
+    };
+    let Some(host) = url.host_str() else {
+        return false;
+    };
+    let host = host.trim_end_matches('.');
+    if host == "localhost" || host.ends_with(".localhost") {
+        return true;
+    }
+    match host.trim_matches(['[', ']']).parse::<IpAddr>() {
+        Ok(IpAddr::V4(ip)) => bypasses_ipv4(ip),
+        Ok(IpAddr::V6(ip)) => bypasses_ipv6(ip),
+        Err(_) => false,
+    }
+}
+
+fn bypasses_ipv4(ip: Ipv4Addr) -> bool {
+    let [a, b, c, d] = ip.octets();
+    ip.is_private()
+        || ip.is_loopback()
+        || ip.is_link_local()
+        || ip.is_documentation()
+        || ip.is_multicast()
+        || a == 0 // This network.
+        || a >= 240 // Reserved and limited broadcast.
+        || (a == 100 && (64..=127).contains(&b)) // Shared address space.
+        || (a == 198 && (18..=19).contains(&b)) // Benchmarking.
+        || (a == 192 && b == 0 && c == 0 && !matches!(d, 9 | 10)) // Protocol assignments.
+        || (a == 192 && b == 88 && c == 99) // Deprecated relay anycast.
+}
+
+fn bypasses_ipv6(ip: Ipv6Addr) -> bool {
+    if let Some(ip) = ip.to_ipv4_mapped() {
+        return bypasses_ipv4(ip);
+    }
+    let segments = ip.segments();
+    ip.is_loopback()
+        || ip.is_unspecified()
+        || ip.is_unique_local()
+        || ip.is_unicast_link_local()
+        || ip.is_multicast()
+        || segments[0] & 0xffc0 == 0xfec0 // Deprecated site-local addresses.
+        || matches!(segments, [0, 0, 0, 0, 0, 0, _, _]) // Deprecated IPv4-compatible form.
+        || matches!(segments, [0x64, 0xff9b, 1, ..]) // Local-use translation.
+        || matches!(segments, [0x100, 0, 0, 0 | 1, ..]) // Discard-only and dummy prefixes.
+        || (segments[0] == 0x2001
+            && segments[1] <= 0x1ff
+            && !matches!(segments,
+                [0x2001, 1, 0, 0, 0, 0, 0, 1..=3]
+                | [0x2001, 3, ..]
+                | [0x2001, 4, 0x112, ..]
+                | [0x2001, 0x20..=0x3f, ..])) // Protocol assignments, except global allocations.
+        || matches!(segments, [0x2001, 0xdb8, ..]) // Documentation.
+        || (segments[0] == 0x3fff && segments[1] <= 0x0fff) // Documentation.
+        || segments[0] == 0x5f00 // Segment-routing SIDs.
+}
+
+#[derive(Clone, Debug, Default, Eq, PartialEq)]
+pub struct RuntimeProxySnapshot {
+    pub config: RuntimeProxyConfig,
+    pub generation: u64,
+}
+
+static RUNTIME_PROXY: LazyLock<(RwLock<RuntimeProxySnapshot>, watch::Sender<u64>)> =
+    LazyLock::new(|| {
+        (
+            RwLock::new(RuntimeProxySnapshot::default()),
+            watch::channel(0).0,
+        )
+    });
+
+pub fn validate_runtime_proxy_config(
+    mut config: RuntimeProxyConfig,
+) -> io::Result<RuntimeProxyConfig> {
+    let mut aliases = HashSet::new();
+    for proxy in &mut config.entries {
+        proxy.alias = proxy.alias.trim().to_string();
+        proxy.url = proxy.url.trim().to_string();
+        if proxy.alias.is_empty() || !aliases.insert(proxy.alias.as_str()) {
+            return Err(io::Error::new(
+                io::ErrorKind::InvalidInput,
+                "proxy aliases must be non-empty and unique",
+            ));
+        }
+        let valid_url = reqwest::Url::parse(&proxy.url).is_ok_and(|url| {
+            matches!(url.scheme(), "http" | "https")
+                && url.host_str().is_some()
+                && url.path() == "/"
+                && url.query().is_none()
+                && url.fragment().is_none()
+        });
+        if !valid_url || reqwest::Proxy::all(&proxy.url).is_err() {
+            return Err(io::Error::new(
+                io::ErrorKind::InvalidInput,
+                "proxy URL must be an HTTP(S) proxy origin without a path, query, or fragment",
+            ));
+        }
+    }
+    config.selected = config
+        .selected
+        .map(|alias| alias.trim().to_string())
+        .filter(|alias| !alias.is_empty());
+    if config
+        .selected
+        .as_ref()
+        .is_some_and(|alias| !aliases.contains(alias.as_str()))
+        || config.enabled && config.selected.is_none()
+    {
+        return Err(io::Error::new(
+            io::ErrorKind::InvalidInput,
+            "enabled proxy routing requires a configured selected alias",
+        ));
+    }
+    Ok(config)
+}
+
+/// Installs one validated configuration for this process, without publishing environment values.
+pub fn set_runtime_proxy_config(config: RuntimeProxyConfig) -> io::Result<RuntimeProxySnapshot> {
+    let config = validate_runtime_proxy_config(config)?;
+    let (state, changes) = &*RUNTIME_PROXY;
+    let mut state = state.write().expect("runtime proxy lock poisoned");
+    if state.generation == 0 || state.config != config {
+        state.config = config;
+        state.generation = state.generation.saturating_add(1);
+        changes.send_replace(state.generation);
+    }
+    Ok(state.clone())
+}
+
+pub fn runtime_proxy_snapshot() -> RuntimeProxySnapshot {
+    RUNTIME_PROXY
+        .0
+        .read()
+        .expect("runtime proxy lock poisoned")
+        .clone()
+}
+
+pub fn runtime_proxy_generation() -> u64 {
+    RUNTIME_PROXY
+        .0
+        .read()
+        .expect("runtime proxy lock poisoned")
+        .generation
+}
+
+/// Once the application loads its configuration, clients must observe later enable/disable changes.
+pub fn runtime_proxy_initialized() -> bool {
+    runtime_proxy_generation() != 0
+}
+
+pub fn subscribe_runtime_proxy_generation() -> watch::Receiver<u64> {
+    RUNTIME_PROXY.1.subscribe()
+}
+
+pub(crate) fn runtime_proxy_enabled() -> bool {
+    RUNTIME_PROXY
+        .0
+        .read()
+        .expect("runtime proxy lock poisoned")
+        .config
+        .enabled
+}
+
+pub(crate) fn runtime_proxy_route(request_url: &str) -> Option<OutboundProxyRoute> {
+    RUNTIME_PROXY
+        .0
+        .read()
+        .expect("runtime proxy lock poisoned")
+        .config
+        .route(request_url)
+}
+
