+use pretty_assertions::assert_eq;
+
+#[tokio::test]
+async fn telegram_rpc_reads_validates_and_disables_persisted_configuration() -> Result<()> {
+    let home = tempfile::tempdir()?;
+    let path = home.path().join("telegram.json");
+    let mut server = TestAppServer::builder()
+        .with_codex_home(home.path())
+        .build_initialized()
+        .await?;
+    let empty: TelegramCommandResponse = server
+        .request(|request_id| ClientRequest::TelegramCommand {
+            request_id,
+            params: TelegramCommandParams::Read {},
+        })
+        .await?;
+    assert_eq!(empty, TelegramCommandResponse::default());
+    let saved = r#"{"bot_token":"bot-secret","chat_id":"chat-secret","github_token":"github-secret","notify_version_updates":false,"version_check_interval_hours":20}"#;
+    std::fs::write(&path, saved)?;
+    let loaded: TelegramCommandResponse = server
+        .request(|request_id| ClientRequest::TelegramCommand {
+            request_id,
+            params: TelegramCommandParams::Read {},
+        })
+        .await?;
+    assert!(loaded.configured);
+    assert!(loaded.github_token_configured);
+    assert!(!loaded.notify_version_updates);
+    assert_eq!(loaded.version_check_interval_hours, 20);
+    let wire = serde_json::to_string(&loaded)?;
+    for secret in ["bot-secret", "chat-secret", "github-secret"] {
+        assert!(!wire.contains(secret));
+    }
+    let rejected_id = server
+        .send_request(
+            "telegram/command",
+            Some(serde_json::json!({"kind": "read", "text": "unexpected"})),
+        )
+        .await?;
+    let rejected = tokio::time::timeout(
+        std::time::Duration::from_secs(10),
+        server.read_stream_until_error_message(RequestId::Integer(rejected_id)),
+    )
+    .await??;
+    assert_eq!(rejected.error.code, -32600);
+    assert_eq!(std::fs::read_to_string(&path)?, saved);
+    let disabled: TelegramCommandResponse = server
+        .request(|request_id| ClientRequest::TelegramCommand {
+            request_id,
+            params: TelegramCommandParams::Disable {},
+        })
+        .await?;
+    assert_eq!(disabled, TelegramCommandResponse::default());
+    assert!(!path.exists());
+    let absent: TelegramCommandResponse = server
+        .request(|request_id| ClientRequest::TelegramCommand {
+            request_id,
+            params: TelegramCommandParams::Read {},
+        })
+        .await?;
+    assert_eq!(absent, TelegramCommandResponse::default());
+    assert!(server.shutdown_gracefully().await?.success());
+    Ok(())
+}
