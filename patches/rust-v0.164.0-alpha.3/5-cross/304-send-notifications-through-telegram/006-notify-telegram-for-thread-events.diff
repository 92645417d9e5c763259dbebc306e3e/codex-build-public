+            ServerRequest::McpServerElicitationRequest { request_id, params } => {
+                mcp_event_id = format!("mcp:{}:{request_id:?}", params.server_name);
+                (
+                    params.turn_id.as_deref().unwrap_or("unknown"),
+                    mcp_event_id.as_str(),
+                    "External response requested",
+                    "Codex needs an MCP elicitation response to continue.",
