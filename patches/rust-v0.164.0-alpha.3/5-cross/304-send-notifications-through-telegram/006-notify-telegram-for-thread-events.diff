+use super::*;
+use codex_app_server_protocol::TelegramCommandParams;
+
+pub(super) fn take_telegram_commands(
+    rx: &mut tokio::sync::mpsc::UnboundedReceiver<AppEvent>,
+) -> Vec<TelegramCommandParams> {
+    std::iter::from_fn(|| rx.try_recv().ok())
+        .filter_map(|event| match event {
+            AppEvent::TelegramCommand { params } => Some(params),
+            _ => None,
+        })
+        .collect()
+}
+
+#[tokio::test]
+async fn approval_notifications_keep_each_source_identity_within_one_turn() {
+    let (mut chat, mut rx, _ops) = make_chatwidget_manual(None).await;
+    chat.thread_id = Some(ThreadId::new());
+    chat.thread_name = Some("Approval source title".to_string());
+    chat.turn_lifecycle.last_turn_id = Some("newer-turn".into());
+    chat.local_settings.tui.notification_settings.notifications = Notifications::Enabled(false);
+    for approval_id in ["approval-1", "approval-2"] {
+        chat.handle_exec_approval_now(ExecApprovalRequestEvent {
+            kind: Default::default(),
+            call_id: "shared-command".into(),
+            approval_id: Some(approval_id.into()),
+            turn_id: "source-turn".into(),
+            environment_id: None,
+            command: vec!["ls".into()],
+            cwd: chat.config.cwd.clone(),
+            reason: None,
+            proposed_execpolicy_amendment: None,
+            proposed_network_policy_amendments: None,
+            available_decisions: None,
+            network_approval_context: None,
+            additional_permissions: None,
+        });
+    }
+    chat.handle_apply_patch_approval_now(ApplyPatchApprovalRequestEvent {
+        call_id: "edit-1".into(),
+        turn_id: "source-turn".into(),
+        changes: HashMap::new(),
+        reason: None,
+        grant_root: None,
+    });
+    chat.handle_request_permissions_now(RequestPermissionsEvent {
+        call_id: "permissions-1".into(),
+        turn_id: "source-turn".into(),
+        environment_id: None,
+        started_at_ms: 0,
+        reason: None,
+        permissions: Default::default(),
+        cwd: None,
+    });
+    let commands = take_telegram_commands(&mut rx);
+    assert_eq!(commands.len(), 4);
+    let mut ids = Vec::new();
+    for command in commands {
+        let TelegramCommandParams::NeedsInput {
+            notification_id,
+            text,
+        } = command
+        else {
+            panic!("expected immediate approval notification");
+        };
+        assert!(text.contains("TurnID: source-turn"));
+        assert!(text.contains("Title: Approval source title\n"));
+        assert!(!text.contains("newer-turn"));
+        ids.push(notification_id);
+    }
+    ids.sort();
+    ids.dedup();
+    assert_eq!(ids.len(), 4);
+}
