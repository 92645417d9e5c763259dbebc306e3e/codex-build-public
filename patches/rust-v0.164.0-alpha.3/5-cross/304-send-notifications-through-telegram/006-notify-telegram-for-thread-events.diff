+    pub(super) async fn notify_telegram_thread_request(
+        &self,
+        thread_id: ThreadId,
+        request: &ServerRequest,
+    ) {
+        let mcp_event_id;
+        let (turn_id, event_id, title, body) = match request {
+            ServerRequest::CommandExecutionRequestApproval { params, .. } => (
