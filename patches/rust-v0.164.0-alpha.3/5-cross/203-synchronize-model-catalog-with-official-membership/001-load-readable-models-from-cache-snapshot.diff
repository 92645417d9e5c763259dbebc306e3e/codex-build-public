diff --git a/codex-rs/models-manager/src/cache_tests.rs b/codex-rs/models-manager/src/cache_tests.rs
new file mode 100644
--- /dev/null
+++ b/codex-rs/models-manager/src/cache_tests.rs
@@ -0,0 +1,29 @@
+use super::*;
+use pretty_assertions::assert_eq;
+use tempfile::tempdir;
+
+#[tokio::test]
+async fn load_any_preserves_stale_versioned_identity_for_caller_validation() {
+    let codex_home = tempdir().expect("temp dir");
+    let cache = FileModelsCache::new(
+        codex_home.path().join("models_cache.json"),
+        Duration::from_secs(60),
+    );
+    let entry = ModelsCacheEntry {
+        fetched_at: Utc::now() - chrono::Duration::hours(1),
+        etag: None,
+        client_version: Some("old-version".to_string()),
+        identity: Some("provider/account".to_string()),
+        models: Vec::new(),
+    };
+    cache.store(&entry).await.expect("write cache");
+
+    assert!(
+        cache
+            .load("new-version")
+            .await
+            .expect("fresh read")
+            .is_none()
+    );
+    assert_eq!(cache.load_any().await.expect("snapshot read"), Some(entry));
+}
