+#[test]
+fn membership_delta_only_reports_same_identity_slug_changes() {
+    let first = OfficialModelsObservation {
+        identity: "account-a".to_string(),
+        slugs: BTreeSet::from(["old".to_string()]),
+    };
+    let second = OfficialModelsObservation {
+        identity: "account-a".to_string(),
+        slugs: BTreeSet::from(["new".to_string()]),
+    };
+    assert_eq!(membership_delta(None, &first), None);
+    assert_eq!(membership_delta(Some(&first), &first), None);
+    assert_eq!(
+        membership_delta(Some(&first), &second),
+        Some(ModelMembershipChangedNotification {
+            added: vec!["new".to_string()],
+            removed: vec!["old".to_string()],
+        })
+    );
+    let different_account = OfficialModelsObservation {
+        identity: "account-b".to_string(),
+        slugs: second.slugs.clone(),
+    };
+    assert_eq!(membership_delta(Some(&first), &different_account), None);
+}
