+fn personal_chatgpt_account(auth_manager: &AuthManager) -> bool {
+    personal_chatgpt_plan(
+        auth_manager.auth_mode(),
+        auth_manager
+            .auth_cached()
+            .and_then(|auth| auth.account_plan_type()),
+    )
+}
+
+fn personal_chatgpt_plan(auth_mode: Option<AuthMode>, plan_type: Option<PlanType>) -> bool {
+    auth_mode == Some(AuthMode::Chatgpt)
+        && matches!(
+            plan_type,
+            Some(PlanType::Plus | PlanType::Pro | PlanType::ProLite)
+        )
+}
+
+fn membership_delta(
+    previous: Option<&OfficialModelsObservation>,
+    current: &OfficialModelsObservation,
+) -> Option<ModelMembershipChangedNotification> {
+    let previous = previous.filter(|previous| previous.identity == current.identity)?;
+    let added = current.slugs.difference(&previous.slugs).cloned().collect();
+    let removed = previous.slugs.difference(&current.slugs).cloned().collect();
+    let delta = ModelMembershipChangedNotification { added, removed };
+    (!delta.added.is_empty() || !delta.removed.is_empty()).then_some(delta)
+}
