+    async fn try_load_cache_snapshot(&self) -> bool {
+        let (Some(cache), Some(identity)) = (self.cache.as_ref(), self.endpoint_client.identity())
+        else {
+            return false;
+        };
+        {
+            let current = self.remote_models.read().await;
+            // A readable stale snapshot must not undo the upstream invalidation policy.
+            if current.base.fetched_at == DateTime::<Utc>::MIN_UTC
+                && current.base.identity.as_ref() == Some(&identity)
+            {
+                return false;
+            }
+        }
+        let cache_entry = match cache.load_any().await {
+            Ok(Some(entry)) => entry,
+            Ok(None) => return false,
+            Err(err) => {
+                error!("failed to load models cache snapshot: {err}");
+                return false;
+            }
+        };
+        if cache_entry.fetched_at == DateTime::<Utc>::MIN_UTC
+            || cache_entry.identity.as_deref() != Some(identity.as_str())
+            || self.endpoint_client.identity().as_deref() != Some(identity.as_str())
+        {
+            return false;
+        }
+        self.apply_remote_models(cache_entry).await
+    }
+}
+
+fn personal_chatgpt_account(auth_mode: Option<AuthMode>, plan_type: Option<PlanType>) -> bool {
+    auth_mode == Some(AuthMode::Chatgpt)
+        && matches!(
+            plan_type,
+            Some(PlanType::Plus | PlanType::Pro | PlanType::ProLite)
+        )
 }
 
