+#[test]
+fn tables_follow_the_active_theme_without_changing_values_or_geometry() {
+    let original = crate::render::highlight::current_syntax_theme();
+    let mut rendered = Vec::new();
+    for (theme, bg, fg) in [
+        ("nord", (20, 35, 50), (220, 230, 240)),
+        ("github", (250, 241, 235), (30, 40, 50)),
+    ] {
+        crate::render::highlight::set_syntax_theme(
+            crate::render::highlight::resolve_theme_by_name(theme, None).unwrap(),
+        );
+        rendered.push(crate::terminal_palette::with_test_default_colors(
+            crate::terminal_probe::DefaultColors { fg, bg },
+            || {
+                let lines = render(&report(), UsageRange::Daily, 220);
+                let find = |value| {
+                    lines
+                        .iter()
+                        .flat_map(|line| &line.spans)
+                        .find(|span| span.content.trim() == value)
+                        .unwrap()
+                        .style
+                };
+                let total = find("$4.20");
+                assert_eq!(total.fg, Palette::current().intensity(16).fg);
+                assert_eq!(find("$3.00").fg, total.fg);
+                assert_eq!(find("$1.20").fg, total.fg);
+                let header = find("Total cost");
+                assert_eq!(
+                    header.fg,
+                    crate::style::accent_style()
+                        .fg
+                        .map(|color| { crate::style::readable_color_on(color, None) }),
+                );
+                assert!(header.add_modifier.contains(ratatui::style::Modifier::BOLD));
+                assert_eq!(
+                    lines[0].spans[0].style.fg,
+                    crate::style::table_separator_style().fg
+                );
+                (lines.iter().join("\n"), total.fg)
+            },
+        ));
+    }
+    crate::render::highlight::set_syntax_theme(original);
+    assert_eq!(rendered[0].0, rendered[1].0);
+    assert_ne!(rendered[0].1, rendered[1].1);
+}
