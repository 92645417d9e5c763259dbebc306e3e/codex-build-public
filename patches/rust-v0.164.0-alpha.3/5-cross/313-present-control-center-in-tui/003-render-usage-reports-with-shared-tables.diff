+            .rows
+            .get_mut("2026-09-28")
+            .unwrap()
+            .get_mut("gpt-5.4")
+            .unwrap();
+        usage.tokens.cache_write = short_write + long_write;
+        usage.long_tokens.cache_write = long_write;
+        report.prices = serde_json::from_value(serde_json::json!({"gpt-5.4": {
+            "0": {"input":2.0,"cacheRead":0.2,"cacheWrite":short_price,"output":10.0},
