+use std::collections::BTreeMap;
+
+use crate::render::renderable::Renderable;
+use ratatui::style::Stylize;
+use ratatui::text::Line;
+use unicode_width::UnicodeWidthStr;
+
+use super::UsageRange;
+use super::UsageReport;
+use crate::control_center_table as table;
+use crate::control_center_table::Cell;
+use crate::control_center_table::Column;
+use crate::control_center_table::Palette;
+use codex_app_server_protocol::UsageTotals as Usage;
+
+pub(crate) fn render(
+    report: &UsageReport,
+    range: UsageRange,
+    width: u16,
+) -> Vec<Box<dyn Renderable>> {
+    let palette = Palette::current();
+    let mut lines = diagnostics(report);
+    let combined;
+    let dates;
+    let periods = if range == UsageRange::All {
+        combined = combined_models(report.rows.values());
+        dates = match (report.rows.first_key_value(), report.rows.last_key_value()) {
+            (Some((first, _)), Some((last, _))) if first != last => format!("{first} - {last}"),
+            (Some((day, _)), _) => day.clone(),
+            _ => String::new(),
+        };
+        vec![(dates.as_str(), &combined)]
+    } else {
+        super::periods(report, range)
+            .map(|(period, models)| (period.as_str(), models))
+            .collect()
+    };
+    lines.extend(usage_tables(report, &periods, width, &palette));
+    lines
+}
+
+pub(crate) fn render_summary(
+    report: &UsageReport,
+    width: u16,
+    selected: Option<chrono::NaiveDate>,
+) -> Vec<Box<dyn Renderable>> {
+    let mut lines = diagnostics(report);
+    lines.extend(super::heatmap::render(
+        report,
+        width,
+        selected,
+        &Palette::current(),
+    ));
+    lines
+}
+
+pub(crate) fn render_quotas(report: &UsageReport, width: u16) -> Vec<Box<dyn Renderable>> {
+    quota::render(
+        &report.quota,
+        *report.refreshed_at.offset(),
+        width,
+        &Palette::current(),
+    )
+}
+
+fn diagnostics(report: &UsageReport) -> Vec<Box<dyn Renderable>> {
+    let mut lines = Vec::new();
+    if report.diagnostics.malformed_records != 0 || report.diagnostics.incomplete_tails != 0 {
+        lines.push(
+            format!(
+                " Skipped {} malformed records and {} unfinished tails",
+                count(report.diagnostics.malformed_records as u64),
+                count(report.diagnostics.incomplete_tails as u64)
+            )
+            .dim()
+            .into(),
+        );
+    }
+    lines
+}
+
+pub(super) fn combined_models<'a>(
+    rows: impl Iterator<Item = &'a BTreeMap<String, Usage>>,
+) -> BTreeMap<String, Usage> {
+    let mut combined = BTreeMap::<String, Usage>::new();
+    for (model, usage) in rows.flat_map(BTreeMap::iter) {
+        combined.entry(model.clone()).or_default().add_usage(usage);
+    }
+    combined
+}
+
+#[derive(Clone, Copy, PartialEq)]
+enum ContextColumns {
+    All,
+    ShortAndLong,
+}
+
+pub(super) fn usage_tables(
+    report: &UsageReport,
+    periods: &[(&str, &BTreeMap<String, Usage>)],
+    width: u16,
+    palette: &Palette,
+) -> Vec<Box<dyn Renderable>> {
+    if periods.iter().all(|(_, models)| models.is_empty()) {
+        return vec![" No usage in this range".dim().into()];
+    }
+    let mut lines = Vec::new();
+    for (period, models) in table::descending_rows(
+        periods
+            .iter()
+            .copied()
+            .filter(|(_, models)| !models.is_empty()),
+        |(period, _)| *period,
+    ) {
+        lines.push(usage_table(report, Some(period), models, width, palette).into());
+        lines.push(Line::default().into());
+    }
+    let models = combined_models(periods.iter().map(|(_, models)| *models));
+    lines.push(price_table(report, &models, width, palette).into());
+    lines
+}
+
+fn usage_table(
+    report: &UsageReport,
+    period: Option<&str>,
+    models: &BTreeMap<String, Usage>,
+    width: u16,
+    palette: &Palette,
+) -> table::Table {
+    let contexts = if models.keys().any(|model| {
+        report
+            .prices
+            .get(model)
+            .is_some_and(|price| price.len() > 1)
+    }) {
+        ContextColumns::ShortAndLong
+    } else {
+        ContextColumns::All
+    };
+    let writes = if contexts == ContextColumns::ShortAndLong {
+        [
+            models
+                .values()
+                .any(|usage| usage.tokens.cache_write > usage.long_tokens.cache_write),
+            models
+                .values()
+                .any(|usage| usage.long_tokens.cache_write > 0),
+        ]
+    } else {
+        [
+            models.values().any(|usage| usage.tokens.cache_write > 0),
+            false,
+        ]
+    };
+    let mut rows = Vec::new();
+    let mut total = Usage::default();
+    for (model, usage) in table::descending_rows(models, |(model, _)| *model) {
+        total.add_usage(usage);
+        rows.push(usage_row(
+            model,
+            usage,
+            !report.missing_prices.contains(model),
+            contexts,
+            writes,
+        ));
+    }
+    if models.len() > 1 {
+        rows.push(usage_row(
+            "",
+            &total,
+            models
+                .keys()
+                .any(|model| !report.missing_prices.contains(model)),
+            contexts,
+            writes,
+        ));
+    }
+    let labels = [
+        "Input",
+        "Read",
+        "Write",
+        "Output",
+        "Reasoning",
+        "Hits",
+        "Cost",
+    ];
+    let context_columns = labels.map(|label| match label {
+        "Hits" => Column::new(label, "100.00%".len(), 9),
+        "Cost" => Column::new(
+            if contexts == ContextColumns::All {
+                "Total cost"
+            } else {
+                label
+            },
+            "$0.00".len(),
+            12,
+        ),
+        _ => Column::new(label, "0.00K".len(), 10),
+    });
+    // The date and model name share one physical column and therefore one parity.
+    let model_label = if period.is_some_and(|period| period.width() % 2 == 0) {
+        "Models"
+    } else {
+        "Model"
+    };
+    let mut columns = vec![Column::new(
+        model_label,
+        12.max(period.map_or(0, UnicodeWidthStr::width)),
+        30,
+    )];
+    let mut leading_headers = vec![palette.header(model_label)];
+    let context_headers = |write: bool| {
+        labels
+            .iter()
+            .enumerate()
+            .filter(move |(index, _)| *index != 2 || write)
+            .map(|(_, label)| {
+                palette.header(if *label == "Cost" && contexts == ContextColumns::All {
+                    "Total cost"
+                } else {
+                    label
+                })
+            })
+    };
+    columns.extend(
+        context_columns
+            .iter()
+            .enumerate()
+            .filter(|(index, _)| *index != 2 || writes[0])
+            .map(|(_, column)| *column),
+    );
+    let mut headers = if contexts == ContextColumns::ShortAndLong {
+        columns.extend(
+            context_columns
+                .iter()
+                .enumerate()
+                .filter(|(index, _)| *index != 2 || writes[1])
+                .map(|(_, column)| *column),
+        );
+        columns.push(Column::new("Total cost", "$0.00".len(), 12));
+        let mut groups = leading_headers
+            .into_iter()
+            .map(|cell| cell.spanning(2, 1))
+            .collect::<Vec<_>>();
+        groups.extend([
+            palette
+                .header("Short context")
+                .spanning(1, 6 + usize::from(writes[0])),
+            palette
+                .header("Long contexts")
+                .spanning(1, 6 + usize::from(writes[1])),
+            palette.header("Total cost").spanning(2, 1),
+        ]);
+        vec![
+            groups,
+            context_headers(writes[0])
+                .chain(context_headers(writes[1]))
+                .collect(),
+        ]
+    } else {
+        leading_headers.extend(context_headers(writes[0]));
+        vec![leading_headers]
+    };
+    if let Some(period) = period {
+        headers.insert(
+            0,
+            vec![
+                palette.header(period),
+                palette.header("").spanning(1, columns.len() - 1),
+            ],
+        );
+    }
+    numeric_table(headers, &columns, rows, Some(0), width, palette)
+}
+
+fn usage_row(
+    model: &str,
+    usage: &Usage,
+    priced: bool,
+    contexts: ContextColumns,
+    writes: [bool; 2],
+) -> Vec<Cell> {
+    let mut cells = vec![Cell::text(model)];
+    let split = contexts == ContextColumns::ShortAndLong;
+    let first = if split {
+        (usage.tokens.subtract(usage.long_tokens), usage.short_cost)
+    } else {
+        (usage.tokens, usage.cost)
+    };
+    for (context, (tokens, cost)) in std::iter::once(first)
+        .chain(split.then_some((usage.long_tokens, usage.long_cost)))
+        .enumerate()
+    {
+        for (_, value) in [
+            tokens
+                .input
+                .saturating_sub(tokens.cached)
+                .saturating_sub(tokens.cache_write),
+            tokens.cached,
+            tokens.cache_write,
+            tokens.output,
+            tokens.reasoning,
+        ]
+        .into_iter()
+        .enumerate()
+        .filter(|(column, _)| *column != 2 || writes[context])
+        {
+            cells.push(Cell::tokens(Some(value)));
+        }
+        let hit = (tokens.input > 0).then_some(tokens.cached as f64 * 100.0 / tokens.input as f64);
+        cells.push(Cell::value(
+            hit,
+            hit.map_or_else(|| "--".into(), |value| number(value, 2, "", "%")),
+        ));
+        cells.push(cost_cell(cost, priced));
+    }
+    if split {
+        cells.push(cost_cell(usage.cost, priced));
+    }
+    cells
+}
+
+fn cost_cell(cost: f64, priced: bool) -> Cell {
+    Cell::value(
+        priced.then_some(cost),
+        if priced {
+            number(cost, 2, "$", "")
+        } else {
+            "--".into()
+        },
+    )
+}
+
+fn price_table(
+    report: &UsageReport,
+    models: &BTreeMap<String, Usage>,
+    width: u16,
+    palette: &Palette,
+) -> table::Table {
+    let effective = |usage: &Usage| {
+        (usage.tokens.total > 0 && usage.cost > 0.0)
+            .then_some(usage.cost / usage.tokens.total as f64)
+    };
+    let highest = models.values().filter_map(effective).fold(0.0, f64::max);
+    let contexts = models
+        .keys()
+        .filter_map(|model| report.prices.get(model))
+        .map(BTreeMap::len)
+        .max()
+        .unwrap_or(1);
+    let writes: Vec<_> = (0..contexts)
+        .map(|index| {
+            models
+                .keys()
+                .filter_map(|model| report.prices.get(model))
+                .filter_map(|price| price.iter().nth(index))
+                .any(|(_, rates)| rates.cache_write > 0.0)
+        })
+        .collect();
+    let mut rows = Vec::new();
+    for (model, usage) in table::descending_rows(models, |(model, _)| *model) {
+        let intervals = report
+            .prices
+            .get(model)
+            .map(|price| price.iter().collect::<Vec<_>>())
+            .unwrap_or_default();
+        let efficiency = effective(usage).map(|cost| highest / cost);
+        let mut row = vec![Cell::text(model)];
+        for (index, write) in writes.iter().copied().enumerate() {
+            let Some((_, rates)) = intervals.get(index) else {
+                row.extend((0..3 + usize::from(write)).map(|_| Cell::number("--")));
+                continue;
+            };
+            row.extend(
+                [
+                    rates.input,
+                    rates.cache_read,
+                    rates.cache_write,
+                    rates.output,
+                ]
+                .into_iter()
+                .enumerate()
+                .filter(|(column, _)| *column != 2 || write)
+                .map(|(_, rate)| Cell::value(Some(rate), number(rate, 4, "$", ""))),
+            );
+        }
+        row.push(Cell::value(
+            efficiency,
+            efficiency.map_or_else(|| "--".into(), |value| number(value, 2, "", "")),
+        ));
+        rows.push(row);
+    }
+    let labels = ["Input", "Read", "Write", "Output"];
+    let context_labels = |write: bool| {
+        labels
+            .into_iter()
+            .enumerate()
+            .filter(move |(index, _)| *index != 2 || write)
+            .map(|(_, label)| label)
+    };
+    let mut columns = vec![Column::new("Model", 12, 30)];
+    for write in &writes {
+        columns.extend(context_labels(*write).map(|label| Column::new(label, "$0.0000".len(), 11)));
+    }
+    columns.push(Column::new("Efficiency", "0.00".len(), 10));
+    let headers = if contexts == 1 {
+        vec![
+            std::iter::once("Model")
+                .chain(context_labels(writes[0]))
+                .chain(["Efficiency"])
+                .map(|label| palette.header(label))
+                .collect(),
+        ]
+    } else {
+        let mut groups = vec![palette.header("Model").spanning(2, 1)];
+        for (index, write) in writes.iter().enumerate() {
+            let label = match (contexts, index) {
+                (2, 0) => "Short context".to_owned(),
+                (2, 1) => "Long contexts".to_owned(),
+                _ => {
+                    let label = format!("Context {}", index + 1);
+                    if label.width() % 2 == 0 {
+                        format!("Context #{}", index + 1)
+                    } else {
+                        label
+                    }
+                }
+            };
+            groups.push(palette.header(&label).spanning(1, 3 + usize::from(*write)));
+        }
+        groups.push(palette.header("Efficiency").spanning(2, 1));
+        vec![
+            groups,
+            writes
+                .into_iter()
+                .flat_map(|write| context_labels(write).map(|label| palette.header(label)))
+                .collect(),
+        ]
+    };
+    numeric_table(headers, &columns, rows, Some(0), width, palette)
+}
+
+fn numeric_table(
+    mut headers: Vec<Vec<Cell>>,
+    columns: &[Column],
+    mut rows: Vec<Vec<Cell>>,
+    model_column: Option<usize>,
+    width: u16,
+    palette: &Palette,
+) -> table::Table {
+    table::shade_columns(&mut rows, palette);
+    let header_rows = headers.len();
+    headers.extend(rows);
+    let widths = table::widths(width, columns, &headers);
+    if let Some(column) = model_column {
+        table::center_left_column(&mut headers[header_rows..], column, widths[column]);
+    }
+    table::render(&widths, &headers, palette)
+}
+
+pub(super) fn count(value: u64) -> String {
+    if value == 0 {
+        "--".into()
+    } else {
+        table::compact_count(value)
+    }
+}
+
+pub(super) fn number(value: f64, precision: usize, prefix: &str, suffix: &str) -> String {
+    if (value * 10_f64.powi(precision as i32)).round() == 0.0 {
+        "--".into()
+    } else {
+        format!("{prefix}{value:.precision$}{suffix}")
+    }
+}
