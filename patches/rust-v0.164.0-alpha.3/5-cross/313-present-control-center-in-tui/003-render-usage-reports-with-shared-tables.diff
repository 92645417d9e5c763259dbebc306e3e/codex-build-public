+        let (usage, prices) = text.rsplit_once("\n\n").unwrap();
+        assert_eq!(
+            usage.matches("Write").count(),
+            usize::from(short_write > 0) + usize::from(long_write > 0)
+        );
+        assert_eq!(
+            prices.matches("Write").count(),
+            usize::from(short_price > 0.0) + usize::from(long_price > 0.0)
+        );
+        let row = usage.lines().find(|line| line.contains("gpt-5.4")).unwrap();
+        assert!(row.contains("$3.00") && row.contains("$1.20") && row.contains("$4.20"));
+        assert!(row.contains("83.33%") && row.contains("75.00%"));
+        assert!(prices.contains("$0.2000") && prices.contains("$0.4000"));
+        for section in [usage, prices] {
+            let table = section
+                .lines()
+                .filter(|line| line.starts_with(['┌', '│', '├', '└']))
+                .collect::<Vec<_>>();
+            let width = table[0].chars().count();
+            assert!(width <= 220);
+            assert!(table.iter().all(|line| line.chars().count() == width));
