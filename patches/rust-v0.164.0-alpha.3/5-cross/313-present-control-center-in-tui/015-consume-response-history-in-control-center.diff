+#[tokio::test]
+async fn native_page_read_and_global_notifications_reach_responses_while_usage_is_selected()
+-> crate::app::Result<()> {
+    use codex_app_server_client::AppServerEvent;
+    use codex_app_server_protocol::ResponseAttemptUpdatedNotification;
+    use codex_app_server_protocol::ServerNotification;
+    use codex_protocol::response_metrics::ResponseAttemptEnd;
+    let (mut app, mut events, mut ops) = crate::app::tests::make_test_app_with_channels().await;
+    let mut tui = crate::tui::test_support::make_test_tui()?;
+    let mut server = crate::start_embedded_app_server_for_picker(&app.config).await?;
+    let mut row = attempt(7, Some(ResponseAttemptEnd::Completed));
+    row.response_id = Some("resp_recorded".into());
+    app.active_thread_id = row.thread_id;
+    row.thread_id = None;
+    app.open_control_center(&mut tui);
+    tokio::time::timeout(std::time::Duration::from_secs(10), async {
+        loop {
+            let event = events.recv().await.expect("app event channel");
+            if let AppEvent::ReadResponseAttempts { params, .. } = &event {
+                assert_eq!(params.thread_id, None);
+            }
+            let loaded = matches!(event, AppEvent::ResponseAttemptsLoaded { .. });
+            app.handle_event(&mut tui, &mut server, event).await?;
+            if loaded {
+                break;
+            }
+        }
+        Ok::<_, color_eyre::Report>(())
+    })
+    .await
+    .map_err(color_eyre::Report::msg)??;
+    assert!(
+        matches!(&app.overlay, Some(Overlay::ControlCenter(center)) if center.responses.history.count() == 0)
+    );
+    for screen in [
+        CenterScreen::Summary,
+        CenterScreen::Usage(crate::usage::UsageRange::Daily),
+        CenterScreen::Quotas,
+        CenterScreen::Responses,
+    ] {
+        if let Some(Overlay::ControlCenter(center)) = &mut app.overlay {
+            center.screen = screen;
+        }
+        row.revision += 1;
+        app.handle_app_server_event(
+            &server,
+            AppServerEvent::ServerNotification(Box::new(
+                ServerNotification::ResponseAttemptUpdated(ResponseAttemptUpdatedNotification {
+                    thread_id: None,
+                    attempt: row.clone(),
+                }),
+            )),
+        )
+        .await;
+        let Some(Overlay::ControlCenter(center)) = &mut app.overlay else {
+            panic!("center")
+        };
+        assert_eq!(center.responses.history.count(), 1);
+        assert_eq!(center.responses.history.rows().next().unwrap().row, row);
+        assert!(!center.responses.history.is_loading());
+        assert!(
+            std::iter::from_fn(|| events.try_recv().ok())
+                .all(|event| !matches!(event, AppEvent::ReadResponseAttempts { .. }))
+        );
+    }
+    let Some(Overlay::ControlCenter(center)) = &mut app.overlay else {
+        panic!("center")
+    };
+    let area = ratatui::layout::Rect::new(0, 0, 600, 20);
+    let mut buffer = ratatui::buffer::Buffer::empty(area);
+    center
+        .responses
+        .render(area, &mut buffer, &mut center.table_interaction);
+    let line = |y| {
+        (0..area.width)
+            .map(|x| buffer[(x, y)].symbol())
+            .collect::<String>()
+    };
+    assert!(line(2).contains("Attempt ID"));
+    assert!(line(3).contains("Input"));
+    assert!(line(5).contains(&row.attempt_id.to_string()));
+    assert!(!line(5).contains("resp_recorded"));
+    assert!(ops.try_recv().is_err());
+    server.shutdown().await?;
+    Ok(())
+}
