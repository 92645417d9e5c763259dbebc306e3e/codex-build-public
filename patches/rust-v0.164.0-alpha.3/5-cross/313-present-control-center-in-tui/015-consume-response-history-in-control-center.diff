+#[tokio::test]
+async fn response_filters_are_transient_and_never_write_configuration() -> anyhow::Result<()> {
+    use codex_protocol::response_metrics::ResponseAttemptStatus;
+    use crossterm::event::KeyCode;
+
+    let mut app = crate::app::test_support::make_test_app().await;
+    let mut tui = crate::tui::test_support::make_test_tui()?;
+    let config = app.config.codex_home.join("presentation-config.toml");
+    std::fs::write(&config, "# unchanged configuration\n")?;
+    app.local_settings.user_config_path = config.clone();
+    app.open_control_center(&mut tui);
+    let Some(Overlay::ControlCenter(center)) = &mut app.overlay else {
+        panic!("center")
+    };
+    center.responses.history.models.insert("gpt-5.4".into());
+    app.overlay
+        .as_mut()
+        .unwrap()
+        .handle_event(&mut tui, crate::tui::TuiEvent::Key(KeyCode::Tab.into()))?;
+    app.overlay
+        .as_mut()
+        .unwrap()
+        .handle_event(&mut tui, crate::tui::TuiEvent::Key(KeyCode::Right.into()))?;
+    for model in [Some("gpt-5.4"), None] {
+        app.overlay
+            .as_mut()
+            .unwrap()
+            .handle_event(&mut tui, crate::tui::TuiEvent::Key(KeyCode::Left.into()))?;
+        let Some(Overlay::ControlCenter(center)) = &mut app.overlay else {
+            panic!("center")
+        };
+        assert_eq!(center.responses.history.model(), model);
+        assert_eq!(
+            center.responses.history.status(),
+            Some(ResponseAttemptStatus::Working)
+        );
+        assert_eq!(
+            std::fs::read_to_string(&config)?,
+            "# unchanged configuration\n"
+        );
+    }
+    app.overlay
+        .as_mut()
+        .unwrap()
+        .handle_event(&mut tui, crate::tui::TuiEvent::Key(KeyCode::Left.into()))?;
+    app.overlay = None;
+    app.open_control_center(&mut tui);
+    let Some(Overlay::ControlCenter(center)) = &mut app.overlay else {
+        panic!("center")
+    };
+    assert_eq!(center.responses.history.model(), None);
+    assert_eq!(center.responses.history.status(), None);
+    Ok(())
+}
