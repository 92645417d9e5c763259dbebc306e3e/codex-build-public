+//! The control center consumes filtered response pages and live observations.
+
+use super::App;
+use crate::app_event::AppEvent;
+use crate::app_server_session::AppServerSession;
+use crate::pager_overlay::Overlay;
+use codex_app_server_protocol::ClientRequest;
+use codex_app_server_protocol::RequestId;
+use codex_app_server_protocol::ResponseAttemptsReadParams;
+use codex_app_server_protocol::ResponseAttemptsReadResponse;
+use codex_models_manager::model_pricing::Prices;
+use std::time::Instant;
+use uuid::Uuid;
+
+impl App {
+    pub(super) fn read_response_attempts(
+        &self,
+        app_server: &AppServerSession,
+        request_id: Uuid,
+        params: ResponseAttemptsReadParams,
+    ) {
+        if !matches!(&self.overlay, Some(Overlay::ControlCenter(center)) if !center.is_done() && center.responses.history.accepts(request_id))
+        {
+            return;
+        }
+        let handle = app_server.request_handle();
+        let home = self.config.codex_home.clone();
+        let events = self.app_event_tx.clone();
+        tokio::spawn(async move {
+            let prices = tokio::task::spawn_blocking(move || {
+                codex_models_manager::model_pricing::read_prices(&home)
+            });
+            let result = handle
+                .request_typed(ClientRequest::ResponseAttemptsRead {
+                    request_id: RequestId::String(request_id.to_string()),
+                    params,
+                })
+                .await
+                .map_err(|error| error.to_string());
+            let prices = prices
+                .await
+                .map_err(|error| format!("pricing task failed: {error}"))
+                .and_then(|result| result.map_err(|error| error.to_string()));
+            events.send(AppEvent::ResponseAttemptsLoaded {
+                request_id,
+                result,
+                prices,
+            });
+        });
+    }
+
+    pub(super) fn finish_response_attempts(
+        &mut self,
+        request_id: Uuid,
+        result: Result<ResponseAttemptsReadResponse, String>,
+        prices: Result<Prices, String>,
+    ) {
+        if let Some(Overlay::ControlCenter(center)) = &mut self.overlay
+            && !center.is_done()
+        {
+            if center.responses.history.accepts(request_id)
+                && result
+                    .as_ref()
+                    .is_ok_and(|page| page.persistence_error.is_some())
+            {
+                // A summary started before this error cannot establish recovery.
+                center.timing_request = None;
+            }
+            let request =
+                center
+                    .responses
+                    .history
+                    .finish(request_id, result, prices, Instant::now());
+            center.responses.request(request);
+        }
+    }
+}
