+use super::*;
+use crate::pager_overlay::CenterScreen;
+use crate::response_timing::tests::attempt;
+use crate::response_timing::tests::page;
+use pretty_assertions::assert_eq;
+
+#[tokio::test]
+async fn late_pages_cannot_replace_another_overlay_or_reopen_a_closed_center() -> anyhow::Result<()>
+{
+    let (mut app, mut events, _) = crate::app::tests::make_test_app_with_channels().await;
+    let mut tui = crate::tui::test_support::make_test_tui()?;
+    app.open_control_center(&mut tui);
+    let request_id = loop {
+        if let AppEvent::ReadResponseAttempts { request_id, .. } = events.try_recv()? {
+            break request_id;
+        }
+    };
+    app.finish_response_attempts(Uuid::new_v4(), Err("stale".into()), Ok(Prices::new()));
+    assert!(
+        matches!(&app.overlay, Some(Overlay::ControlCenter(center)) if center.responses.history.accepts(request_id))
+    );
+    app.overlay = Some(Overlay::new_static_with_lines(
+        vec!["other".into()],
+        "Other".into(),
+        app.keymap.pager.clone(),
+    ));
+    app.finish_response_attempts(request_id, Ok(page(Vec::new())), Ok(Prices::new()));
+    assert!(matches!(app.overlay, Some(Overlay::Static(_))));
+    app.overlay = None;
+    app.finish_response_attempts(request_id, Err("late".into()), Ok(Prices::new()));
+    assert!(app.overlay.is_none());
+    Ok(())
+}
+
+#[tokio::test]
+async fn response_page_errors_require_a_fresh_successful_timing_observation() -> anyhow::Result<()>
+{
+    let (mut app, mut events, _) = crate::app::tests::make_test_app_with_channels().await;
+    let mut tui = crate::tui::test_support::make_test_tui()?;
+    app.open_control_center(&mut tui);
+    let page_request = loop {
+        if let AppEvent::ReadResponseAttempts { request_id, .. } = events.try_recv()? {
+            break request_id;
+        }
+    };
+    let old_timing_request = Uuid::new_v4();
+    let Some(Overlay::ControlCenter(center)) = &mut app.overlay else {
+        unreachable!()
+    };
+    center.screen = CenterScreen::Responses;
+    center.timing_request = Some(old_timing_request);
+    let mut failed_page = page(Vec::new());
+    failed_page.persistence_error = Some("database is locked".into());
+    app.finish_response_attempts(Uuid::new_v4(), Ok(failed_page.clone()), Ok(Prices::new()));
+    assert!(
+        matches!(&app.overlay, Some(Overlay::ControlCenter(center)) if center.timing_request == Some(old_timing_request))
+    );
+    app.finish_response_attempts(page_request, Ok(failed_page), Ok(Prices::new()));
+    let healthy = codex_app_server_protocol::ResponseTimingReadResponse {
+        models: Vec::new(),
+        successful_attempts: 0,
+        total_attempts: 0,
+        persistence_error: None,
+    };
+    app.finish_control_center_timing(&mut tui, old_timing_request, Ok(healthy.clone()));
+    let Some(Overlay::ControlCenter(center)) = &mut app.overlay else {
+        unreachable!()
+    };
+    assert!(center.timing_request.is_none());
+    assert!(center.timing.is_none());
+    assert_eq!(
+        center.responses.history.persistence_error.as_deref(),
+        Some("database is locked")
+    );
+    let failed_timing_request = Uuid::new_v4();
+    center.timing_request = Some(failed_timing_request);
+    app.finish_control_center_timing(&mut tui, failed_timing_request, Err("disconnected".into()));
+    let Some(Overlay::ControlCenter(center)) = &mut app.overlay else {
+        unreachable!()
+    };
+    assert_eq!(
+        center.responses.history.persistence_error.as_deref(),
+        Some("database is locked")
+    );
+    let fresh_timing_request = Uuid::new_v4();
+    center.timing_request = Some(fresh_timing_request);
+    app.finish_control_center_timing(&mut tui, fresh_timing_request, Ok(healthy));
+    assert!(
+        matches!(&app.overlay, Some(Overlay::ControlCenter(center)) if center.responses.history.persistence_error.is_none())
+    );
+    Ok(())
+}
