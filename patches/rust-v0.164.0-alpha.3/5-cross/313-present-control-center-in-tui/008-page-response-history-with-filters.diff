+//! Retained response pages and live observations share one ordered row owner.
+
+use crate::keymap::ListAction;
+use crate::response_table::ROW_HEIGHT;
+use crate::response_timing::ObservedResponse;
+use crate::resume_picker::LOAD_NEAR_THRESHOLD;
+use codex_app_server_protocol::ResponseAttemptsReadParams;
+use codex_app_server_protocol::ResponseAttemptsReadResponse;
+use codex_models_manager::model_pricing::Prices;
+use codex_protocol::response_metrics::ResponseAttempt;
+use codex_protocol::response_metrics::ResponseAttemptStatus;
+use std::collections::BTreeMap;
+use std::collections::BTreeSet;
+use std::time::Instant;
+use uuid::Uuid;
+
+pub(crate) struct ResponsePageRequest {
+    pub(crate) id: Uuid,
+    pub(crate) params: ResponseAttemptsReadParams,
+}
+
+struct PendingPage {
+    id: Uuid,
+    requested_at: Instant,
+    older: bool,
+}
+
+pub(crate) struct ResponseHistory {
+    query: ResponseAttemptsReadParams,
+    records: BTreeMap<Uuid, ObservedResponse>,
+    pub(crate) models: BTreeSet<String>,
+    pub(crate) prices: Result<Prices, String>,
+    pub(crate) error: Option<String>,
+    pub(crate) persistence_error: Option<String>,
+    next_cursor: Option<String>,
+    loaded: bool,
+    pending: Option<PendingPage>,
+    pub(crate) scroll_top: usize,
+    viewport_height: usize,
+    pending_scroll_top: Option<usize>,
+}
+
+impl ResponseHistory {
+    pub(crate) fn new() -> Self {
+        Self {
+            query: ResponseAttemptsReadParams::default(),
+            records: BTreeMap::new(),
+            models: BTreeSet::new(),
+            prices: Ok(Prices::new()),
+            error: None,
+            persistence_error: None,
+            next_cursor: None,
+            loaded: false,
+            pending: None,
+            scroll_top: 0,
+            viewport_height: 0,
+            pending_scroll_top: None,
+        }
+    }
+
+    pub(crate) fn model(&self) -> Option<&str> {
+        self.query.model.as_deref()
+    }
+
+    pub(crate) fn status(&self) -> Option<ResponseAttemptStatus> {
+        self.query.status
+    }
+
+    pub(crate) fn rows(&self) -> impl Iterator<Item = &ObservedResponse> {
+        self.records.values().rev().filter(|row| self.matches(row))
+    }
+
+    pub(crate) fn count(&self) -> usize {
+        self.rows().count()
+    }
+
+    pub(crate) fn is_loading(&self) -> bool {
+        self.pending.is_some()
+    }
+
+    pub(crate) fn accepts(&self, id: Uuid) -> bool {
+        self.pending.as_ref().is_some_and(|page| page.id == id)
+    }
+
+    pub(crate) fn load_recent(&mut self, now: Instant) -> Option<ResponsePageRequest> {
+        self.request(None, now)
+    }
+
+    fn request(&mut self, cursor: Option<String>, now: Instant) -> Option<ResponsePageRequest> {
+        if self.pending.is_some() {
+            return None;
+        }
+        let id = Uuid::new_v4();
+        self.pending = Some(PendingPage {
+            id,
+            requested_at: now,
+            older: cursor.is_some(),
+        });
+        let mut params = self.query.clone();
+        params.cursor = cursor;
+        self.error = None;
+        Some(ResponsePageRequest { id, params })
+    }
+
+    pub(crate) fn finish(
+        &mut self,
+        id: Uuid,
+        response: Result<ResponseAttemptsReadResponse, String>,
+        prices: Result<Prices, String>,
+        now: Instant,
+    ) -> Option<ResponsePageRequest> {
+        if !self.accepts(id) {
+            return None;
+        }
+        let pending = self.pending.take().expect("matching response page");
+        self.prices = prices;
+        let page = match response {
+            Ok(page) => page,
+            Err(error) => {
+                self.error = Some(error);
+                self.pending_scroll_top = None;
+                return None;
+            }
+        };
+        let top = self.top_anchor();
+        for row in page.data {
+            if self.records.get(&row.attempt_id).is_some_and(|current| {
+                current.snapshot_is_stale(row.revision, pending.requested_at)
+            }) {
+                continue;
+            }
+            let active = page.active_attempt_ids.contains(&row.attempt_id);
+            self.store(ObservedResponse::new(row, active, now));
+        }
+        self.models.extend(page.models);
+        // Refreshing recent observations cannot rewind a cursor already advanced
+        // through older history. The server alone interprets cursor contents.
+        if !self.loaded || pending.older {
+            self.next_cursor = page.next_cursor;
+        }
+        self.loaded = true;
+        self.persistence_error = page.persistence_error;
+        self.restore_scroll(top);
+        if let Some(target) = self.pending_scroll_top {
+            if target > self.max_scroll_top() && self.next_cursor.is_some() {
+                return self.load_more(now);
+            }
+            self.scroll_top = target.min(self.max_scroll_top());
+            self.pending_scroll_top = None;
+        }
+        self.fill_viewport(now)
+    }
+
+    pub(crate) fn update(&mut self, row: ResponseAttempt, now: Instant) {
+        let top = self.top_anchor();
+        self.store(ObservedResponse::new(row, true, now));
+        self.restore_scroll(top);
+    }
+
+    fn store(&mut self, incoming: ObservedResponse) {
+        let row = &incoming.row;
+        if self
+            .records
+            .get(&row.attempt_id)
+            .is_some_and(|current| current.row.revision > row.revision)
+        {
+            return;
+        }
+        self.models.insert(row.requested_model.clone());
+        if let Some(current) = self.records.get_mut(&row.attempt_id) {
+            current.update(incoming);
+        } else {
+            // A completion outside the filter can arrive before its older page.
+            // Retain its revision so that page cannot resurrect the working row.
+            self.records.insert(row.attempt_id, incoming);
+        }
+    }
+
+    fn matches(&self, row: &ObservedResponse) -> bool {
+        self.model()
+            .is_none_or(|model| model == row.row.requested_model)
+            && self
+                .status()
+                .is_none_or(|status| status == row.row.status(row.is_running()))
+    }
+
+    pub(crate) fn set_model(
+        &mut self,
+        model: Option<String>,
+        now: Instant,
+    ) -> Option<ResponsePageRequest> {
+        if model == self.query.model {
+            return None;
+        }
+        self.query.model = model;
+        self.reset_filter(now)
+    }
+
+    pub(crate) fn set_status(
+        &mut self,
+        status: Option<ResponseAttemptStatus>,
+        now: Instant,
+    ) -> Option<ResponsePageRequest> {
+        if status == self.query.status {
+            return None;
+        }
+        self.query.status = status;
+        self.reset_filter(now)
+    }
+
+    fn reset_filter(&mut self, now: Instant) -> Option<ResponsePageRequest> {
+        self.records.clear();
+        self.loaded = false;
+        self.next_cursor = None;
+        self.pending = None;
+        self.scroll_top = 0;
+        self.pending_scroll_top = None;
+        self.request(None, now)
+    }
+
+    fn top_anchor(&self) -> Option<Uuid> {
+        self.rows()
+            .nth(self.scroll_top)
+            .map(|row| row.row.attempt_id)
+    }
+
+    fn restore_scroll(&mut self, top: Option<Uuid>) {
+        // The newest row follows live arrivals. A pending scroll already
+        // means the user is reading older history, even before it has arrived.
+        if self.scroll_top == 0 && self.pending_scroll_top.is_none() {
+            return;
+        }
+        let previous = self.scroll_top;
+        if let Some(index) = top.and_then(|id| self.rows().position(|row| row.row.attempt_id == id))
+        {
+            self.scroll_top = index;
+        }
+        self.scroll_top = self.scroll_top.min(if self.pending_scroll_top.is_some() {
+            self.count().saturating_sub(1)
+        } else {
+            self.max_scroll_top()
+        });
+        if let Some(target) = &mut self.pending_scroll_top {
+            *target = target
+                .saturating_add(self.scroll_top)
+                .saturating_sub(previous);
+        }
+    }
+
+    fn max_scroll_top(&self) -> usize {
+        self.count().saturating_sub(self.visible_rows())
+    }
+
+    pub(crate) fn visible_rows(&self) -> usize {
+        (self.viewport_height / ROW_HEIGHT).max(1)
+    }
+
+    pub(crate) fn update_viewport(
+        &mut self,
+        height: usize,
+        now: Instant,
+    ) -> Option<ResponsePageRequest> {
+        self.viewport_height = height;
+        if self.pending_scroll_top.is_none() {
+            self.scroll_top = self.scroll_top.min(self.max_scroll_top());
+        }
+        self.fill_viewport(now)
+    }
+
+    fn fill_viewport(&mut self, now: Instant) -> Option<ResponsePageRequest> {
+        if self.error.is_none() && self.count() < self.scroll_top + self.visible_rows() {
+            self.load_more(now)
+        } else {
+            None
+        }
+    }
+
+    fn load_more(&mut self, now: Instant) -> Option<ResponsePageRequest> {
+        self.request(Some(self.next_cursor.clone()?), now)
+    }
+
+    pub(crate) fn cancel_scroll(&mut self) {
+        self.pending_scroll_top = None;
+    }
+
+    pub(crate) fn scroll_by(&mut self, rows: isize, now: Instant) -> Option<ResponsePageRequest> {
+        if rows == 0 {
+            return None;
+        }
+        let start = if rows > 0 {
+            self.pending_scroll_top.unwrap_or(self.scroll_top)
+        } else {
+            self.scroll_top
+        };
+        self.scroll_to(start.saturating_add_signed(rows), rows > 0, now)
+    }
+
+    fn scroll_to(
+        &mut self,
+        target: usize,
+        older: bool,
+        now: Instant,
+    ) -> Option<ResponsePageRequest> {
+        self.scroll_top = target.min(self.max_scroll_top());
+        self.pending_scroll_top =
+            (target > self.max_scroll_top() && self.next_cursor.is_some()).then_some(target);
+        if older
+            && (self.pending_scroll_top.is_some()
+                || self
+                    .count()
+                    .saturating_sub(self.scroll_top + self.visible_rows())
+                    <= LOAD_NEAR_THRESHOLD)
+        {
+            self.load_more(now)
+        } else {
+            None
+        }
+    }
+
+    pub(crate) fn navigate(
+        &mut self,
+        action: ListAction,
+        now: Instant,
+    ) -> Option<ResponsePageRequest> {
+        match action {
+            ListAction::MoveUp => self.scroll_by(-1, now),
+            ListAction::MoveDown => self.scroll_by(1, now),
+            ListAction::PageUp => self.scroll_by(-(self.visible_rows() as isize), now),
+            ListAction::PageDown => self.scroll_by(self.visible_rows() as isize, now),
+            ListAction::JumpTop => self.scroll_to(0, false, now),
+            ListAction::JumpBottom => self.scroll_to(self.max_scroll_top(), true, now),
+            _ => None,
+        }
+    }
+}
+
