+#[test]
+fn combined_filters_reject_superseded_pages_and_fill_from_matching_older_history() {
+    let now = Instant::now();
+    let mut history = ResponseHistory::new();
+    history.update_viewport(4, now);
+    let model = history.set_model(Some("gpt-5.4".into()), now).unwrap();
+    let working = history
+        .set_status(Some(ResponseAttemptStatus::Working), now)
+        .unwrap();
+    assert!(!history.accepts(model.id));
+    assert_eq!(working.params.model.as_deref(), Some("gpt-5.4"));
+    assert_eq!(working.params.status, Some(ResponseAttemptStatus::Working));
+    assert_eq!(working.params.thread_id, None);
+    assert!(
+        history
+            .set_status(Some(ResponseAttemptStatus::Working), now)
+            .is_none()
+    );
+    finish(&mut history, working, vec![attempt(8, None)], now);
+    assert_eq!(history.count(), 1);
+
+    let done = history
+        .set_status(Some(ResponseAttemptStatus::Completed), now)
+        .unwrap();
+    assert_eq!(history.count(), 0);
+    assert!(!history.accepts(model.id));
+    finish(&mut history, model, completed(1, 2), now);
+    assert!(history.accepts(done.id));
+    let mut response = page(completed(7, 8));
+    response.next_cursor = Some("older-completed".into());
+    let mut ended = attempt(8, Some(ResponseAttemptEnd::Failed));
+    ended.revision += 1;
+    history.update(ended, now);
+    let older = history
+        .finish(done.id, Ok(response), Ok(Prices::new()), now)
+        .unwrap();
+    assert_eq!(older.params.model.as_deref(), Some("gpt-5.4"));
+    assert_eq!(older.params.status, Some(ResponseAttemptStatus::Completed));
+    assert_eq!(older.params.cursor.as_deref(), Some("older-completed"));
+    assert_eq!(history.count(), 1);
+    finish(&mut history, older, completed(5, 6), now);
+    assert_eq!(history.count(), 3);
+    let all_models = history.set_model(None, now).unwrap();
+    assert_eq!(all_models.params.model, None);
+    assert_eq!(
+        all_models.params.status,
+        Some(ResponseAttemptStatus::Completed)
+    );
+    let all_statuses = history.set_status(None, now).unwrap();
+    assert!(!history.accepts(all_models.id));
+    assert_eq!(all_statuses.params.model, None);
+    assert_eq!(all_statuses.params.status, None);
+    assert_eq!(all_statuses.params.cursor, None);
+}
