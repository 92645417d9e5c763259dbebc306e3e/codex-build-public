+#[test]
+fn empty_filtered_pages_continue_with_storage_and_local_pricing_errors() {
+    let now = Instant::now();
+    let mut history = ResponseHistory::new();
+    assert!(history.update_viewport(20, now).is_none());
+    let first = history.load_recent(now).unwrap();
+    let mut response = page(Vec::new());
+    response.next_cursor = Some("history-after-empty-memory".into());
+    response.persistence_error = Some("storage unavailable".into());
+    let older = history
+        .finish(
+            first.id,
+            Ok(response),
+            Err("pricing unavailable".into()),
+            now,
+        )
+        .unwrap();
+    assert_eq!(
+        older.params.cursor.as_deref(),
+        Some("history-after-empty-memory")
+    );
+    assert_eq!(
+        history.persistence_error.as_deref(),
+        Some("storage unavailable")
+    );
+    assert_eq!(history.prices.as_ref().unwrap_err(), "pricing unavailable");
+    let mut other = attempt(2, None);
+    other.thread_id = Some(ThreadId::new());
+    history.update(other, now);
+    assert_eq!(history.count(), 1);
+    finish(&mut history, older, completed(1, 1), now);
+    assert_eq!(history.count(), 2);
+}
