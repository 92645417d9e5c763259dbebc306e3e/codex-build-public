+#[test]
+fn live_status_changes_cannot_be_reversed_by_late_filtered_pages() {
+    let now = Instant::now();
+    let later = now + Duration::from_secs(1);
+    let mut history = ResponseHistory::new();
+    history.set_model(Some("gpt-5.4".into()), now);
+    let working = history
+        .set_status(Some(ResponseAttemptStatus::Working), now)
+        .unwrap();
+    let mut completed = attempt(2, Some(ResponseAttemptEnd::Completed));
+    completed.revision += 1;
+    history.update(completed, later);
+    let mut other = attempt(3, None);
+    other.requested_model = "another-model".into();
+    other.revision += 1;
+    history.update(other, later);
+    finish(
+        &mut history,
+        working,
+        vec![attempt(1, None), attempt(2, None), attempt(3, None)],
+        later,
+    );
+    assert_eq!(
+        history
+            .rows()
+            .map(|row| row.row.attempt_id)
+            .collect::<Vec<_>>(),
+        vec![Uuid::from_u128(1)]
+    );
+    let mut received = attempt(1, None);
+    received.terminal_observed_offset_ms = Some(1500);
+    received.revision += 1;
+    history.update(received.clone(), later);
+    assert_eq!(history.count(), 0);
+    let received_page = history
+        .set_status(Some(ResponseAttemptStatus::Received), later)
+        .unwrap();
+    finish(&mut history, received_page, vec![received], later);
+    assert_eq!(history.count(), 1);
+    assert!(!history.rows().next().unwrap().is_running());
+    let unfinished = history
+        .set_status(Some(ResponseAttemptStatus::Unfinished), later)
+        .unwrap();
+    let mut response = page(vec![attempt(4, None), attempt(5, None)]);
+    response.active_attempt_ids = vec![Uuid::from_u128(5)];
+    history.finish(unfinished.id, Ok(response), Ok(Prices::new()), later);
+    assert_eq!(
+        history
+            .rows()
+            .map(|row| row.row.attempt_id)
+            .collect::<Vec<_>>(),
+        vec![Uuid::from_u128(4)]
+    );
+}
