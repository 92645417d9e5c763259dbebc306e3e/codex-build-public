+            buffer[(all_column, area.bottom() - 1)].fg,
+            Palette::current().model(0).fg.unwrap()
+        );
+        assert!(
+            !buffer[(all_column, area.bottom() - 1)]
+                .modifier
+                .contains(ratatui::style::Modifier::DIM)
+        );
