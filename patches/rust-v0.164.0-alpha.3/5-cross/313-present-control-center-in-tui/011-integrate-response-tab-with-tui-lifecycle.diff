+        let models = report.rows["2026-09-28"].clone();
+        report
+            .weekly_rows
+            .insert("2026-09-28".into(), models.clone());
+        report.monthly_rows.insert("2026-09".into(), models.clone());
+        report.yearly_rows.insert("2026".into(), models);
+        let report = Arc::new(report);
+        for screen in [CenterScreen::Summary, CenterScreen::Quotas]
+            .into_iter()
+            .chain(UsageRange::VIEWS.map(CenterScreen::Usage))
+        {
+            let mut center = test_center(Some(Arc::clone(&report)), screen, 204, 1.0);
+            let area = Rect::new(4, 3, 204, 40);
+            let mut buffer = Buffer::empty(area);
+            center.render(area, &mut buffer);
+            assert!(!center.table_interaction.cells.is_empty(), "{screen:?}");
+            for (rect, _) in &center.table_interaction.cells {
