+//! Request shared accounting snapshots and retain request-scoped build observations.
+use super::App;
+use crate::app_event::AppEvent;
+use crate::pager_overlay::Overlay;
+use crate::tui;
+use codex_app_server_protocol::RequestId;
+use codex_app_server_protocol::UsageBuildProgress;
+use codex_app_server_protocol::UsageBuildProgressNotification;
+use codex_app_server_protocol::UsageReadResponse;
+use std::sync::Arc;
+use std::time::Instant;
+use tokio::sync::watch;
+use uuid::Uuid;
+
+pub(super) struct UsageRequest {
+    pub(super) id: Uuid,
+    pub(super) rpc_id: Option<RequestId>,
+    pub(super) started_at: Instant,
+    pub(super) progress: watch::Sender<Option<UsageBuildProgress>>,
+}
+
+impl UsageRequest {
+    pub(super) fn new() -> Self {
+        let (progress, _) = watch::channel(None);
+        Self {
+            id: Uuid::new_v4(),
+            rpc_id: None,
+            started_at: Instant::now(),
+            progress,
+        }
+    }
+}
+
+impl App {
+    pub(super) fn open_control_center(&mut self, tui: &mut tui::Tui) {
+        if let Err(error) = tui.enter_alt_screen() {
+            self.chat_widget
+                .add_error_message(format!("Could not open control center: {error}"));
+            tui.frame_requester().schedule_frame();
+            return;
+        }
+        let start_load = self.usage_request.is_none();
+        let request = self.usage_request.get_or_insert_with(UsageRequest::new);
+        let request_id = request.id;
+        self.overlay = Some(Overlay::new_control_center_loading(
+            &self.keymap,
+            request_id,
+            tui.terminal.last_known_screen_size.width,
+            self.local_settings.tui.mouse_scroll_speed.unwrap_or(1.0),
+            tui.frame_requester(),
+            self.app_event_tx.clone(),
+            Arc::clone(&self.model_catalog),
+        ));
+        if start_load {
+            self.app_event_tx.send(AppEvent::LoadUsage {
+                request_id,
+                refresh: false,
+            });
+        }
+        tui.frame_requester().schedule_frame();
+    }
+
+    pub(super) fn refresh_usage(&mut self, tui: &mut tui::Tui) {
+        let Some(Overlay::ControlCenter(view)) = &mut self.overlay else {
+            return;
+        };
+        if self.usage_request.is_some() {
+            return;
+        }
+        let request = UsageRequest::new();
+        let request_id = request.id;
+        self.usage_request = Some(request);
+        view.begin_usage_refresh(request_id);
+        self.app_event_tx.send(AppEvent::LoadUsage {
+            request_id,
+            refresh: true,
+        });
+        tui.frame_requester().schedule_frame();
+    }
+
+    pub(super) fn finish_usage(
+        &mut self,
+        tui: &mut tui::Tui,
+        request_id: Uuid,
+        result: Result<UsageReadResponse, String>,
+    ) {
+        let Some(active_request) = &self.usage_request else {
+            return;
+        };
+        if active_request.id != request_id {
+            return;
+        }
+        self.usage_request = None;
+        if !self
+            .overlay
+            .as_ref()
+            .is_some_and(|overlay| overlay.accepts_usage_request(request_id) && !overlay.is_done())
+        {
+            return;
+        }
+        if let Some(Overlay::ControlCenter(view)) = &mut self.overlay {
+            view.set_report(result.map(|response| response.report));
+        }
+        tui.frame_requester().schedule_frame();
+    }
+
+    pub(super) fn update_usage_progress(&self, update: UsageBuildProgressNotification) {
+        if let Some(request) = &self.usage_request
+            && request.rpc_id.as_ref() == Some(&update.request_id)
+        {
+            request
+                .progress
+                .send_modify(|progress| *progress = Some(update.progress));
+        }
+    }
+}
