+#[tokio::test]
+async fn cached_reads_use_the_producer_duration_for_new_clients_and_new_snapshots()
+-> anyhow::Result<()> {
+    let mut app = crate::app::test_support::make_test_app().await;
+    let mut tui = crate::tui::test_support::make_test_tui()?;
+    let report = Arc::new(crate::usage::test_report());
+    app.open_control_center(&mut tui);
+    let request_id = app.usage_request.as_ref().unwrap().id;
+    app.finish_usage(
+        &mut tui,
+        request_id,
+        Ok(UsageReadResponse {
+            report: Arc::clone(&report),
+            refreshed: false,
+        }),
+    );
+    let duration = |app: &App| {
+        let Some(Overlay::ControlCenter(view)) = &app.overlay else {
+            panic!("center")
+        };
+        view.report().and_then(|report| report.build_duration_ms)
+    };
+    assert_eq!(duration(&app), Some(1234));
+
+    app.refresh_usage(&mut tui);
+    let request_id = app.usage_request.as_ref().unwrap().id;
+    let mut refreshed = (*report).clone();
+    refreshed.build_duration_ms = Some(0);
+    let report = Arc::new(refreshed);
+    app.finish_usage(
+        &mut tui,
+        request_id,
+        Ok(UsageReadResponse {
+            report: Arc::clone(&report),
+            refreshed: true,
+        }),
+    );
+    assert_eq!(duration(&app), Some(0));
+
+    for _ in 0..2 {
+        app.close_transcript_overlay(&mut tui);
+        app.open_control_center(&mut tui);
+        let request_id = app.usage_request.as_ref().unwrap().id;
+        app.finish_usage(
+            &mut tui,
+            request_id,
+            Ok(UsageReadResponse {
+                report: Arc::clone(&report),
+                refreshed: false,
+            }),
+        );
+        assert_eq!(duration(&app), Some(0));
+    }
+
+    let mut another_client = crate::app::test_support::make_test_app().await;
+    let mut another_tui = crate::tui::test_support::make_test_tui()?;
+    another_client.open_control_center(&mut another_tui);
+    let request_id = another_client.usage_request.as_ref().unwrap().id;
+    another_client.finish_usage(
+        &mut another_tui,
+        request_id,
+        Ok(UsageReadResponse {
+            report: Arc::clone(&report),
+            refreshed: false,
+        }),
+    );
+    assert_eq!(duration(&another_client), Some(0));
+
+    let mut newer = (*report).clone();
+    newer.refreshed_at += chrono::Duration::seconds(1);
+    newer.build_duration_ms = Some(9876);
+    app.close_transcript_overlay(&mut tui);
+    app.open_control_center(&mut tui);
+    let request_id = app.usage_request.as_ref().unwrap().id;
+    app.finish_usage(
+        &mut tui,
+        request_id,
+        Ok(UsageReadResponse {
+            report: Arc::new(newer),
+            refreshed: false,
+        }),
+    );
+    assert_eq!(duration(&app), Some(9876));
+    Ok(())
+}
