+use super::*;
+use crate::pager_overlay::CenterScreen;
+use crossterm::event::KeyCode;
+use crossterm::event::KeyEvent;
+use crossterm::event::KeyEventKind;
+use crossterm::event::KeyModifiers;
+use pretty_assertions::assert_eq;
+
+#[tokio::test]
+async fn stale_scan_cannot_replace_a_newer_or_closed_overlay() -> anyhow::Result<()> {
+    let mut app = crate::app::test_support::make_test_app().await;
+    let mut tui = crate::tui::test_support::make_test_tui()?;
+    let old_request = Uuid::new_v4();
+    let request = UsageRequest::new();
+    let current_request = request.id;
+    app.usage_request = Some(request);
+    app.open_control_center(&mut tui);
+    app.finish_usage(
+        &mut tui,
+        old_request,
+        Ok(UsageReadResponse {
+            report: Arc::new(crate::usage::test_report()),
+            refreshed: true,
+        }),
+    );
+    assert_eq!(
+        app.usage_request.as_ref().map(|request| request.id),
+        Some(current_request)
+    );
+    assert!(
+        app.overlay
+            .as_ref()
+            .unwrap()
+            .accepts_usage_request(current_request)
+    );
+    app.finish_usage(&mut tui, current_request, Err("fixture error".to_owned()));
+    assert!(app.usage_request.is_none());
+    assert!(
+        !app.overlay
+            .as_ref()
+            .unwrap()
+            .accepts_usage_request(current_request)
+    );
+    app.overlay = None;
+    app.finish_usage(&mut tui, current_request, Err("late".to_owned()));
+    assert!(app.overlay.is_none());
+    Ok(())
+}
+
+#[tokio::test]
+async fn loading_and_failed_usage_reports_close_with_escape() -> anyhow::Result<()> {
+    let mut app = crate::app::test_support::make_test_app().await;
+    let mut tui = crate::tui::test_support::make_test_tui()?;
+    for failure in [false, true] {
+        if failure {
+            let request = UsageRequest::new();
+            let request_id = request.id;
+            app.usage_request = Some(request);
+            app.open_control_center(&mut tui);
+            app.finish_usage(&mut tui, request_id, Err("fixture error".into()));
+        } else {
+            app.open_control_center(&mut tui);
+        }
+        for key in [
+            KeyCode::Char('q').into(),
+            KeyEvent::new(KeyCode::Char('c'), KeyModifiers::CONTROL),
+            KeyEvent::new_with_kind(KeyCode::Esc, KeyModifiers::NONE, KeyEventKind::Release),
+        ] {
+            app.overlay
+                .as_mut()
+                .unwrap()
+                .handle_event(&mut tui, crate::tui::TuiEvent::Key(key))?;
+            assert!(!app.overlay.as_ref().unwrap().is_done());
+        }
+        app.overlay
+            .as_mut()
+            .unwrap()
+            .handle_event(&mut tui, crate::tui::TuiEvent::Key(KeyCode::Esc.into()))?;
+        assert!(app.overlay.as_ref().unwrap().is_done());
+        app.overlay = None;
+    }
+    Ok(())
+}
