+#[tokio::test]
+async fn closed_report_stays_closed_and_reopening_reuses_only_the_pending_request()
+-> anyhow::Result<()> {
+    let (mut app, mut events, _ops) = crate::app::tests::make_test_app_with_channels().await;
+    let mut tui = crate::tui::test_support::make_test_tui()?;
+    let request = UsageRequest::new();
+    let request_id = request.id;
+    app.usage_request = Some(request);
+    let report = Arc::new(crate::usage::test_report());
+    app.finish_usage(
+        &mut tui,
+        request_id,
+        Ok(UsageReadResponse {
+            report: Arc::clone(&report),
+            refreshed: true,
+        }),
+    );
+    assert!(app.overlay.is_none());
+    assert!(app.usage_request.is_none());
+    app.open_control_center(&mut tui);
+    let current = app.usage_request.as_ref().unwrap().id;
+    // Reopening during the request keeps its owner and returns to Summary.
+    app.open_control_center(&mut tui);
+    assert_eq!(
+        app.usage_request.as_ref().map(|request| request.id),
+        Some(current)
+    );
+    let requests = std::iter::from_fn(|| events.try_recv().ok())
+        .filter_map(|event| match event {
+            AppEvent::LoadUsage {
+                request_id,
+                refresh,
+            } => Some((request_id, refresh)),
+            _ => None,
+        })
+        .collect::<Vec<_>>();
+    assert_eq!(requests, vec![(current, false)]);
+    app.finish_usage(
+        &mut tui,
+        current,
+        Ok(UsageReadResponse {
+            report: Arc::clone(&report),
+            refreshed: false,
+        }),
+    );
+    assert!(app.usage_request.is_none());
+    assert!(matches!(&app.overlay, Some(Overlay::ControlCenter(overlay))
+            if overlay.screen == CenterScreen::Summary
+                && Arc::ptr_eq(overlay.report().unwrap(), &report)
+                && overlay.report().unwrap().build_duration_ms == Some(1234)));
+    Ok(())
+}
