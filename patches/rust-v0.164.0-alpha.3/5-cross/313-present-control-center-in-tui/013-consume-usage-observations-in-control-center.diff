+#[tokio::test]
+async fn progress_matches_the_rpc_and_retains_its_clock_and_latest_value_across_reopening()
+-> anyhow::Result<()> {
+    use codex_app_server_protocol::UsageBuildPhase;
+
+    let mut app = crate::app::test_support::make_test_app().await;
+    let mut tui = crate::tui::test_support::make_test_tui()?;
+    let mut request = UsageRequest::new();
+    let request_id = request.id;
+    let started_at = request.started_at;
+    let observed = request.progress.subscribe();
+    request.rpc_id = Some(RequestId::Integer(73));
+    app.usage_request = Some(request);
+    app.open_control_center(&mut tui);
+    let reading = UsageBuildProgress {
+        phase: UsageBuildPhase::Reading,
+        files_processed: 2,
+        files_total: Some(5),
+    };
+    app.update_usage_progress(UsageBuildProgressNotification {
+        request_id: RequestId::String("73".into()),
+        progress: reading.clone(),
+    });
+    assert!(observed.borrow().is_none());
+    app.update_usage_progress(UsageBuildProgressNotification {
+        request_id: RequestId::Integer(73),
+        progress: reading.clone(),
+    });
+    assert_eq!(*observed.borrow(), Some(reading));
+    app.close_transcript_overlay(&mut tui);
+    let aggregating = UsageBuildProgress {
+        phase: UsageBuildPhase::Aggregating,
+        files_processed: 5,
+        files_total: Some(5),
+    };
+    app.update_usage_progress(UsageBuildProgressNotification {
+        request_id: RequestId::Integer(73),
+        progress: aggregating.clone(),
+    });
+    app.open_control_center(&mut tui);
+    let retained = app.usage_request.as_ref().unwrap();
+    assert_eq!(retained.id, request_id);
+    assert_eq!(retained.started_at, started_at);
+    assert_eq!(*retained.progress.borrow(), Some(aggregating.clone()));
+    app.finish_usage(&mut tui, request_id, Err("scan failed".into()));
+    assert!(observed.has_changed().is_err());
+    app.update_usage_progress(UsageBuildProgressNotification {
+        request_id: RequestId::Integer(73),
+        progress: aggregating,
+    });
+    assert!(app.usage_request.is_none());
+    Ok(())
+}
