+    assert_eq!(instructions_template(&edited), Some("edited prompt"));
+
+    let configured = manager
+        .get_model_info(
+            "gpt-5.6-sol",
+            &ModelsManagerConfig {
+                base_instructions: Some("configured prompt".to_string()),
+                ..Default::default()
+            },
+        )
+        .await;
+    assert_eq!(
+        instructions_template(&configured),
+        Some("configured prompt")
+    );
