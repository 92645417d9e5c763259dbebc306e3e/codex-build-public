diff --git a/codex-rs/models-manager/src/instructions_overlay.rs b/codex-rs/models-manager/src/instructions_overlay.rs
new file mode 100644
--- /dev/null
+++ b/codex-rs/models-manager/src/instructions_overlay.rs
@@ -0,0 +1,320 @@
+use codex_protocol::openai_models::ModelInfo;
+use std::collections::BTreeMap;
+use std::io;
+use std::io::ErrorKind;
+use std::io::Write;
+use std::path::Path;
+use std::path::PathBuf;
+use tokio::fs;
+use tracing::warn;
+
+pub(crate) const INSTRUCTIONS_OVERLAY_DIR: &str = "instructions";
+
+pub(crate) fn dir_path(codex_home: &Path) -> PathBuf {
+    codex_home.join(INSTRUCTIONS_OVERLAY_DIR)
+}
+
+pub(crate) async fn apply(dir: &Path, catalog_slug: &str, model: &mut ModelInfo) -> bool {
+    let Some(path) = matching_overlay_path(dir, catalog_slug).await else {
+        return false;
+    };
+    let template = match fs::read_to_string(&path).await {
+        Ok(template) if !template.trim().is_empty() => template,
+        Ok(_) => {
+            warn!(path = %path.display(), catalog_slug, "instructions overlay must not be empty");
+            return false;
+        }
+        Err(err) if err.kind() == ErrorKind::NotFound => return false,
+        Err(err) => {
+            warn!(path = %path.display(), catalog_slug, "failed to read instructions overlay: {err}");
+            return false;
+        }
+    };
+    let Some(messages) = model.model_messages.as_mut() else {
+        return false;
+    };
+    messages.instructions_template = Some(template);
+    true
+}
+
+pub(crate) async fn seed(dir: &Path, models: &[ModelInfo]) {
+    if let Err(err) = fs::create_dir_all(dir).await {
+        warn!(path = %dir.display(), "failed to create instructions overlay directory: {err}");
+        return;
+    }
+    let snapshot = match OverlayIndex::capture(dir).await {
+        Ok(snapshot) => snapshot,
+        Err(err) => {
+            warn!(path = %dir.display(), "failed to scan instructions overlay directory: {err}");
+            return;
+        }
+    };
+    for model in models {
+        let Some(template) = model
+            .model_messages
+            .as_ref()
+            .and_then(|messages| messages.instructions_template.as_deref())
+            .filter(|template| !template.trim().is_empty())
+        else {
+            continue;
+        };
+        let Some(path) = model_path(dir, &model.slug) else {
+            warn!(model = %model.slug, "instructions overlay catalog slug is unsafe");
+            continue;
+        };
+        if snapshot.matching_path(&model.slug).is_some() {
+            continue;
+        }
+        if let Err(err) = create_new(&path, template).await
+            && err.kind() != ErrorKind::AlreadyExists
+        {
+            warn!(path = %path.display(), model = %model.slug, "failed to seed instructions overlay: {err}");
+        }
+    }
+}
+
+#[derive(Default)]
+struct OverlayIndex {
+    paths_by_stem: BTreeMap<String, PathBuf>,
+}
+
+impl OverlayIndex {
+    async fn capture(dir: &Path) -> io::Result<Self> {
+        let mut entries = match fs::read_dir(dir).await {
+            Ok(entries) => entries,
+            Err(err) if err.kind() == ErrorKind::NotFound => return Ok(Self::default()),
+            Err(err) => return Err(err),
+        };
+        let mut index = Self::default();
+        while let Some(entry) = entries.next_entry().await? {
+            let path = entry.path();
+            let Some(stem) = path
+                .extension()
+                .filter(|extension| *extension == "md")
+                .and_then(|_| path.file_stem())
+                .and_then(|stem| stem.to_str())
+                .filter(|stem| is_safe_catalog_slug(stem))
+            else {
+                continue;
+            };
+            index.paths_by_stem.insert(stem.to_string(), path);
+        }
+        Ok(index)
+    }
+
+    fn matching_path(&self, catalog_slug: &str) -> Option<&Path> {
+        if !is_safe_catalog_slug(catalog_slug) {
+            return None;
+        }
+        self.paths_by_stem
+            .get(catalog_slug)
+            .map(PathBuf::as_path)
+            .or_else(|| {
+                self.paths_by_stem
+                    .iter()
+                    .filter(|(stem, _)| catalog_slug.starts_with(stem.as_str()))
+                    .max_by_key(|(stem, _)| stem.len())
+                    .map(|(_, path)| path.as_path())
+            })
+    }
+}
+
+fn model_path(dir: &Path, catalog_slug: &str) -> Option<PathBuf> {
+    is_safe_catalog_slug(catalog_slug).then(|| dir.join(format!("{catalog_slug}.md")))
+}
+
+async fn matching_overlay_path(dir: &Path, catalog_slug: &str) -> Option<PathBuf> {
+    if !is_safe_catalog_slug(catalog_slug) {
+        return None;
+    }
+    match OverlayIndex::capture(dir).await {
+        Ok(index) => index.matching_path(catalog_slug).map(Path::to_path_buf),
+        Err(err) => {
+            warn!(path = %dir.display(), catalog_slug, "failed to scan instructions overlay directory: {err}");
+            None
+        }
+    }
+}
+
+fn is_safe_catalog_slug(catalog_slug: &str) -> bool {
+    let bytes = catalog_slug.as_bytes();
+    bytes
+        .first()
+        .copied()
+        .is_some_and(is_ascii_lowercase_alphanumeric)
+        && bytes
+            .last()
+            .copied()
+            .is_some_and(is_ascii_lowercase_alphanumeric)
+        && bytes
+            .iter()
+            .copied()
+            .all(|byte| is_ascii_lowercase_alphanumeric(byte) || matches!(byte, b'-' | b'_' | b'.'))
+        && !catalog_slug.contains("..")
+}
+
+fn is_ascii_lowercase_alphanumeric(byte: u8) -> bool {
+    byte.is_ascii_lowercase() || byte.is_ascii_digit()
+}
+
+async fn create_new(path: &Path, contents: &str) -> io::Result<()> {
+    let path = path.to_path_buf();
+    let contents = contents.as_bytes().to_vec();
+    tokio::task::spawn_blocking(move || {
+        let parent = path
+            .parent()
+            .ok_or_else(|| io::Error::other("instructions overlay target has no parent"))?;
+        let mut staged = tempfile::NamedTempFile::new_in(parent)?;
+        staged.write_all(&contents)?;
+        staged.as_file().sync_all()?;
+        staged
+            .persist_noclobber(path)
+            .map(|_| ())
+            .map_err(|error| error.error)
+    })
+    .await
+    .map_err(io::Error::other)?
+}
+
