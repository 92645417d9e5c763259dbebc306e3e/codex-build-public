+#[tokio::test]
+async fn generic_prompts_are_exposed_and_reloaded_without_mutating_model_metadata() {
+    for declared_locally in [false, true] {
+        let codex_home = tempdir().expect("temp dir");
+        if declared_locally {
+            write_models_document(
+                codex_home.path(),
+                json!({"models": [{"slug": "generic-model"}]}),
+            );
+        }
+        let official = remote_model("catalog-model", "Catalog", /*priority*/ 0);
+        let manager = openai_manager_for_tests(
+            codex_home.path().to_path_buf(),
+            TestModelsEndpoint::new(vec![vec![official]]),
+        );
+        manager
+            .raw_model_catalog(RefreshStrategy::Online, DEFAULT_HTTP_CLIENT_FACTORY)
+            .await;
+        let catalog = manager.get_remote_models().await;
+        write_instructions_overlay(codex_home.path(), "catalog-model", "local prompt");
+        let selected = manager
+            .get_model_info("catalog-model-alias", &ModelsManagerConfig::default())
+            .await;
+        assert_eq!(instructions_template(&selected), Some("local prompt"));
+
+        let mut native = model_info::local_model_defaults("generic-model");
+        native.used_fallback_model_metadata = !declared_locally;
+        assert_eq!(
+            manager
+                .get_model_info("generic-model", &ModelsManagerConfig::default())
+                .await,
+            native
+        );
+        let prompt_path =
+            crate::instructions_overlay::dir_path(codex_home.path()).join("generic-model.md");
+        assert_eq!(
+            std::fs::read_to_string(&prompt_path).expect("read exposed generic prompt"),
+            model_info::BASE_INSTRUCTIONS
+        );
+        write_instructions_overlay(codex_home.path(), "generic-model", "edited generic prompt");
+        let mut edited = native.clone();
+        edited
+            .model_messages
+            .as_mut()
+            .unwrap()
+            .instructions_template = Some("edited generic prompt".to_string());
+        assert_eq!(
+            manager
+                .get_model_info("generic-model", &ModelsManagerConfig::default())
+                .await,
+            edited
+        );
+        let configured = manager
+            .get_model_info(
+                "generic-model",
+                &ModelsManagerConfig {
+                    base_instructions: Some("explicit prompt".to_string()),
+                    ..Default::default()
+                },
+            )
+            .await;
+        assert_eq!(instructions_template(&configured), Some("explicit prompt"));
+        assert_eq!(
+            std::fs::read_to_string(&prompt_path).unwrap(),
+            "edited generic prompt"
+        );
+        std::fs::write(&prompt_path, " \n").unwrap();
+        assert_eq!(
+            manager
+                .get_model_info("generic-model", &ModelsManagerConfig::default())
+                .await,
+            native,
+            "an invalid file falls back to native instructions, not the previous edit"
+        );
+        assert_eq!(manager.get_remote_models().await, catalog);
+    }
+}
