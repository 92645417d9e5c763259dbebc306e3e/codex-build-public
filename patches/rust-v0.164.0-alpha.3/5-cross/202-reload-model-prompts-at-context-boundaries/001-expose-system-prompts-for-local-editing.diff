+        let mut model = crate::bundled_models_response()
+            .expect("bundled models should parse")
+            .models
+            .into_iter()
+            .find(|model| model.model_messages.is_some())
+            .expect("bundled catalog should include instruction messages");
+        model.slug = slug.to_string();
+        model
+            .model_messages
+            .as_mut()
+            .expect("test model should have messages")
+            .instructions_template = Some(prompt.to_string());
+        model
+    }
+
+    fn prompt(model: &ModelInfo) -> Option<&str> {
+        model
+            .model_messages
+            .as_ref()
+            .and_then(|messages| messages.instructions_template.as_deref())
+    }
+
+    #[test]
+    fn catalog_slug_paths_use_a_positive_ascii_filename_policy() {
+        let dir = Path::new("instructions");
+        assert_eq!(
+            model_path(dir, "gpt-5.2_codex"),
+            Some(dir.join("gpt-5.2_codex.md"))
+        );
+        for slug in [
+            "",
+            ".",
+            "..",
+            ".hidden",
+            "gpt.",
+            "gpt..5",
+            "../gpt-5",
+            "provider/gpt-5",
+            "gpt 5",
+            "GPT-5",
+            "模型",
+        ] {
+            assert_eq!(model_path(dir, slug), None, "accepted unsafe slug {slug:?}");
+        }
+    }
+
+    #[tokio::test]
+    async fn seed_is_idempotent_and_respects_existing_family_files() {
+        let temp = tempfile::tempdir().expect("create temp dir");
+        let dir = dir_path(temp.path());
+        seed(
+            &dir,
+            &[
+                model_with_prompt("gpt-5.4", "base"),
+                model_with_prompt("gpt-5.4-mini", "mini"),
+            ],
+        )
+        .await;
+        assert_eq!(
+            fs::read_to_string(dir.join("gpt-5.4.md")).await.unwrap(),
+            "base"
+        );
+        assert_eq!(
+            fs::read_to_string(dir.join("gpt-5.4-mini.md"))
+                .await
+                .unwrap(),
+            "mini"
+        );
+        seed(&dir, &[model_with_prompt("gpt-5.4", "replacement")]).await;
+        assert_eq!(
+            fs::read_to_string(dir.join("gpt-5.4.md")).await.unwrap(),
+            "base"
+        );
+
+        let family_dir = dir_path(&temp.path().join("family"));
+        fs::create_dir_all(&family_dir).await.unwrap();
+        fs::write(family_dir.join("gpt-5.md"), "family")
+            .await
+            .unwrap();
+        seed(&family_dir, &[model_with_prompt("gpt-5.6-sol", "exact")]).await;
+        assert!(!family_dir.join("gpt-5.6-sol.md").exists());
+    }
+
+    #[tokio::test]
+    async fn exact_then_longest_family_overlay_applies_and_invalid_content_does_not() {
+        let temp = tempfile::tempdir().expect("create temp dir");
+        let dir = dir_path(temp.path());
+        fs::create_dir_all(&dir).await.unwrap();
+        fs::write(dir.join("gpt-5.md"), "broad").await.unwrap();
+        fs::write(dir.join("gpt-5.6.md"), "specific").await.unwrap();
+        let mut model = model_with_prompt("requested", "original");
+        assert!(apply(&dir, "gpt-5.6-sol", &mut model).await);
+        assert_eq!(prompt(&model), Some("specific"));
+
+        fs::write(dir.join("gpt-5.6-sol.md"), "exact")
+            .await
+            .unwrap();
+        assert!(apply(&dir, "gpt-5.6-sol", &mut model).await);
+        assert_eq!(prompt(&model), Some("exact"));
+
+        fs::write(dir.join("empty.md"), " \n").await.unwrap();
+        assert!(!apply(&dir, "empty", &mut model).await);
+        assert_eq!(prompt(&model), Some("exact"));
+        fs::create_dir(dir.join("unreadable.md")).await.unwrap();
+        assert!(!apply(&dir, "unreadable", &mut model).await);
+        assert_eq!(prompt(&model), Some("exact"));
+    }
+
+    #[tokio::test]
+    async fn concurrent_seed_is_atomic_and_never_clobbers_the_winner() {
+        let temp = tempfile::tempdir().expect("create temp dir");
+        let dir = dir_path(temp.path());
+        let first = vec![model_with_prompt("seed-race", "first")];
+        let second = vec![model_with_prompt("seed-race", "second")];
+        tokio::join!(seed(&dir, &first), seed(&dir, &second));
+        let winner = fs::read_to_string(dir.join("seed-race.md")).await.unwrap();
+        assert!(winner == "first" || winner == "second");
+        seed(&dir, &[model_with_prompt("seed-race", "later")]).await;
+        assert_eq!(
+            fs::read_to_string(dir.join("seed-race.md")).await.unwrap(),
+            winner
+        );
+    }
+
+    #[tokio::test]
+    async fn failed_install_cleans_up_and_preserves_the_winner() {
+        let temp = tempfile::tempdir().expect("create temp dir");
+        let target = temp.path().join("model.md");
+        std::fs::write(&target, "user").unwrap();
+        assert_eq!(
+            create_new(&target, "seed").await.unwrap_err().kind(),
+            ErrorKind::AlreadyExists
+        );
+        assert_eq!(std::fs::read_to_string(&target).unwrap(), "user");
+        assert_eq!(std::fs::read_dir(temp.path()).unwrap().count(), 1);
+    }
+}
