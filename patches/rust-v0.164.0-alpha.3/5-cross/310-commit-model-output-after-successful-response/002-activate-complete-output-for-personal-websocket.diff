+#[test_case::test_case(false; "interruption_discards_output")]
+#[test_case::test_case(true; "completion_wins_interrupt_race")]
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn steered_input_preserves_response_output_and_usage(completed: bool) -> anyhow::Result<()> {
+    skip_if_no_network!(Ok(()));
+    let mut terminal = ev_completed("steered-response");
+    terminal["response"]["usage"] = json!({
+        "input_tokens": 100, "output_tokens": 12, "total_tokens": 112
+    });
+    if !completed {
+        terminal["type"] = json!("response.incomplete");
+        terminal["response"]["incomplete_details"] = json!({"reason": "interrupted"});
+    }
+    // The terminal is sent only after the real session sends response.interrupt.
+    // Returning completed models the server finishing before it can honor that interrupt.
+    let server = start_websocket_server(vec![vec![
+        vec![ev_response_created("warmup"), ev_completed("warmup")],
+        vec![
+            ev_response_created("steered-response"),
+            core_test_support::responses::ev_message_item_added("original-message", ""),
+            ev_output_text_delta("original answer"),
+            ev_assistant_message("original-message", "original answer"),
+        ],
+        vec![terminal],
+        vec![
+            ev_response_created("follow-up"),
+            ev_assistant_message("final-message", "updated answer"),
+            ev_completed("follow-up"),
+        ],
+    ]])
+    .await;
+    let test = test_codex()
+        .with_auth(personal_auth("plus"))
+        .with_model_info_override(MODEL, |model| model.use_responses_lite = true)
+        .with_config(|config| {
+            assert!(config.features.enabled(Feature::InstantInterrupt));
+            config.model_provider.request_max_retries = Some(0);
+            config.model_provider.stream_max_retries = Some(0);
+        })
+        .build_with_websocket_server(&server)
+        .await?;
+    let mut updates = test.thread_manager.response_attempt_receiver();
+    test.codex
+        .start_or_steer_turn(TurnInputRequest::user_input(vec![UserInput::Text {
+            text: "original input".into(),
+            text_elements: Vec::new(),
+        }]))
+        .await?;
+    tokio::time::timeout(Duration::from_secs(10), async {
+        loop {
+            let row = updates.recv().await.unwrap();
+            if row.response_id.as_deref() == Some("steered-response") && row.ttfc_ms.is_some() {
+                assert_eq!(row.end_reason, None);
+                break;
+            }
+        }
+    })
+    .await?;
+    assert!(matches!(
+        test.codex
+            .start_or_steer_turn(TurnInputRequest::user_input(vec![UserInput::Text {
+                text: "steered input".into(),
+                text_elements: Vec::new(),
+            }]))
+            .await?,
+        codex_core::TurnInputSubmission::Steered { .. }
+    ));
+    let mut events = Vec::new();
+    core_test_support::wait_for_event_with_timeout(
+        &test.codex,
+        |event| {
+            events.push(event.clone());
+            matches!(event, EventMsg::TurnComplete(_))
+        },
+        Duration::from_secs(10),
+    )
+    .await;
+    assert!(
+        !events
+            .iter()
+            .any(|event| matches!(event, EventMsg::Error(_)))
+    );
+    let visible = serde_json::to_string(&events)?;
+    assert_eq!(visible.contains("original answer"), completed);
+    assert!(visible.contains("updated answer"));
+    assert!(events.iter().any(|event| matches!(event,
+        EventMsg::TokenCount(event) if event.info.as_ref().is_some_and(|info|
+            info.total_token_usage.input_tokens == 100
+                && info.total_token_usage.output_tokens == 12
+                && info.last_token_usage.total_tokens == if completed { 112 } else { 0 })
+    )));
+    let mut row = None;
+    while let Ok(update) = updates.try_recv() {
+        if update.response_id.as_deref() == Some("steered-response") && update.end_reason.is_some()
+        {
+            row = Some(update);
+        }
+    }
+    let row =
+        row.expect("the interrupted or completed attempt is published before turn completion");
+    assert_eq!(row.tokens.input, Some(100));
+    assert_eq!(row.tokens.output, Some(12));
+    assert_eq!(
+        row.end_reason,
+        Some(if completed {
+            ResponseAttemptEnd::Completed
+        } else {
+            ResponseAttemptEnd::Interrupted
+        })
+    );
+    let requests = server.single_connection();
+    assert_eq!(requests.len(), 4);
+    assert_eq!(
+        requests[2].body_json(),
+        json!({
+            "type": "response.interrupt", "response_id": "steered-response", "mode": "discard_partial_items"
+        })
+    );
+    let follow_up = requests[3].body_json();
+    if completed {
+        assert_eq!(follow_up["previous_response_id"], "steered-response");
+    } else {
+        assert!(follow_up["previous_response_id"].is_null());
+        assert!(follow_up["input"].to_string().contains("original input"));
+        assert!(!follow_up["input"].to_string().contains("original answer"));
+    }
+    assert!(follow_up["input"].to_string().contains("steered input"));
+    test.codex.flush_rollout().await?;
+    let (items, _, errors) = codex_rollout::RolloutRecorder::load_rollout_items(
+        &test.codex.rollout_path().expect("test rollout path"),
+    )
+    .await?;
+    assert_eq!(errors, 0);
+    assert!(items.iter().any(|item| matches!(item,
+        codex_rollout::RolloutItem::TokenUsageRecord(record)
+            if record.response_id == "steered-response" && record.usage.output_tokens == 12
+    )));
+    assert_eq!(
+        serde_json::to_string(&items)?.contains("original answer"),
+        completed
+    );
+    test.codex.shutdown_and_wait().await?;
+    server.shutdown().await;
+    Ok(())
+}
