+        .unwrap();
+    let mut counts = (0, 0, 0);
+    let mut failed = false;
+    while let Some(event) = stream.next().await {
+        match event {
+            Ok(ResponseEvent::OutputItemDone(ResponseItem::FunctionCall { .. })) => counts.0 += 1,
+            Ok(ResponseEvent::ReasoningSummaryDelta { .. }) => counts.1 += 1,
+            Ok(ResponseEvent::OutputTextDelta(_)) => counts.2 += 1,
+            Err(_) => failed = true,
+            _ => {}
+        }
+    }
