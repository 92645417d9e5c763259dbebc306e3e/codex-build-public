         self
     }
 
+    /// Resolve named host variables before connection reuse, catalog caching, and launch.
+    pub(crate) fn with_local_process_environment(
+        mut self,
+        environment: &HashMap<String, String>,
+    ) -> Self {
+        if let McpServerTransportConfig::Stdio { env, env_vars, .. } = &mut self.config.transport {
+            for variable in env_vars
+                .iter()
+                .filter(|variable| !variable.is_remote_source())
+            {
+                if let Some(value) = environment.get(variable.name()) {
+                    env.get_or_insert_default()
+                        .entry(variable.name().to_owned())
+                        .or_insert_with(|| value.clone());
+                }
+            }
+        }
+        self
+    }
+
     pub(crate) fn requires_read_only_mcp_tools(&self) -> bool {
         self.requires_read_only_mcp_tools
     }
