diff --git a/codex-rs/tui/src/app/tests/stream_rtt.rs b/codex-rs/tui/src/app/tests/stream_rtt.rs
new file mode 100644
--- /dev/null
+++ b/codex-rs/tui/src/app/tests/stream_rtt.rs
@@ -0,0 +1,167 @@
+use super::*;
+use codex_app_server_client::AppServerEvent;
+use codex_app_server_protocol::AccountRateLimitsUpdatedNotification;
+use codex_app_server_protocol::AccountUpdatedNotification;
+use codex_app_server_protocol::RateLimitSnapshot;
+use codex_app_server_protocol::RemoteControlConnectionStatus;
+use codex_app_server_protocol::RemoteControlStatusChangedNotification;
+use codex_app_server_protocol::ResponsesStreamConnectionStatusNotification;
+use codex_protocol::account::PlanType;
+use pretty_assertions::assert_eq;
+
+pub(super) fn remote_control_status(
+    status: RemoteControlConnectionStatus,
+    rtt_ms: Option<u64>,
+) -> RemoteControlStatusChangedNotification {
+    RemoteControlStatusChangedNotification {
+        status,
+        server_name: "server".to_string(),
+        installation_id: "installation".to_string(),
+        environment_id: Some("environment".to_string()),
+        rtt_ms,
+    }
+}
+
+#[tokio::test]
+async fn remote_control_rtt_is_global_and_clears_on_scope_or_connection_changes() -> Result<()> {
+    let mut app = make_test_app().await;
+    let server = crate::start_embedded_app_server_for_picker(&app.config).await?;
+    assert!(app.active_thread_id.is_none());
+    let connected = remote_control_status(RemoteControlConnectionStatus::Connected, Some(0));
+    app.handle_app_server_event(
+        &server,
+        AppServerEvent::ServerNotification(Box::new(
+            ServerNotification::RemoteControlStatusChanged(connected.clone()),
+        )),
+    )
+    .await;
+    assert!(app.remote_control_connection_status.is_none());
+
+    app.chat_widget
+        .update_account_state(None, Some(PlanType::Plus), true, true);
+    let responses = ResponsesStreamConnectionStatusNotification {
+        thread_id: ThreadId::new().to_string(),
+        connected: true,
+        rtt_ms: Some(42),
+    };
+    app.chat_widget.handle_server_notification(
+        ServerNotification::ResponsesStreamConnectionStatus(responses.clone()),
+        None,
+    );
+    for (status, rtt_ms) in [
+        (RemoteControlConnectionStatus::Connected, Some(0)),
+        (RemoteControlConnectionStatus::Connected, None),
+        (RemoteControlConnectionStatus::Connecting, None),
+        (RemoteControlConnectionStatus::Errored, None),
+        (RemoteControlConnectionStatus::Disabled, None),
+    ] {
+        let notification = remote_control_status(status, rtt_ms);
+        app.handle_app_server_event(
+            &server,
+            AppServerEvent::ServerNotification(Box::new(
+                ServerNotification::RemoteControlStatusChanged(notification.clone()),
+            )),
+        )
+        .await;
+        assert_eq!(
+            app.remote_control_connection_status,
+            (status != RemoteControlConnectionStatus::Disabled).then_some(notification),
+        );
+        assert_eq!(
+            app.chat_widget.responses_stream_connection_status(),
+            Some(&responses),
+        );
+    }
+
+    app.handle_app_server_event(
+        &server,
+        AppServerEvent::ServerNotification(Box::new(
+            ServerNotification::RemoteControlStatusChanged(connected.clone()),
+        )),
+    )
+    .await;
+    app.handle_app_server_event(
+        &server,
+        AppServerEvent::ServerNotification(Box::new(ServerNotification::AccountRateLimitsUpdated(
+            AccountRateLimitsUpdatedNotification {
+                rate_limits: RateLimitSnapshot {
+                    limit_id: Some("codex".to_string()),
+                    limit_name: None,
+                    normal_model_slug: None,
+                    primary: None,
+                    secondary: None,
+                    credits: None,
+                    individual_limit: None,
+                    spend_control_reached: None,
+                    plan_type: Some(PlanType::Business),
+                    rate_limit_reached_type: None,
+                },
+            },
+        ))),
+    )
+    .await;
+    assert!(app.remote_control_connection_status.is_none());
+    assert!(
+        app.chat_widget
+            .responses_stream_connection_status()
+            .is_none()
+    );
+    app.chat_widget
+        .update_account_state(None, Some(PlanType::Plus), true, true);
+    app.chat_widget.handle_server_notification(
+        ServerNotification::ResponsesStreamConnectionStatus(responses.clone()),
+        None,
+    );
+    app.handle_app_server_event(
+        &server,
+        AppServerEvent::ServerNotification(Box::new(
+            ServerNotification::RemoteControlStatusChanged(connected.clone()),
+        )),
+    )
+    .await;
+    app.handle_app_server_event(
+        &server,
+        AppServerEvent::ServerNotification(Box::new(ServerNotification::AccountUpdated(
+            AccountUpdatedNotification {
+                auth_mode: None,
+                plan_type: None,
+            },
+        ))),
+    )
+    .await;
+    assert!(app.remote_control_connection_status.is_none());
+    assert!(
+        app.chat_widget
+            .responses_stream_connection_status()
+            .is_none()
+    );
+
+    app.chat_widget
+        .update_account_state(None, Some(PlanType::Plus), true, true);
+    app.chat_widget.handle_server_notification(
+        ServerNotification::ResponsesStreamConnectionStatus(responses),
+        None,
+    );
+    app.handle_app_server_event(
+        &server,
+        AppServerEvent::ServerNotification(Box::new(
+            ServerNotification::RemoteControlStatusChanged(connected),
+        )),
+    )
+    .await;
+    app.handle_app_server_event(
+        &server,
+        AppServerEvent::Disconnected {
+            message: "closed".to_string(),
+        },
+    )
+    .await;
+    assert!(app.remote_control_connection_status.is_none());
+    assert!(
+        app.chat_widget
+            .responses_stream_connection_status()
+            .is_none()
+    );
+    server.shutdown().await?;
+    Ok(())
+}
