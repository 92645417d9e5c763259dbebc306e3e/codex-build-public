@@ -0,0 +1,31 @@
+use codex_app_server_protocol::ResponsesStreamConnectionStatusNotification;
+use codex_protocol::account::PlanType;
+
+use super::ChatWidget;
+
+impl ChatWidget {
+    pub(crate) fn responses_stream_connection_status(
+        &self,
+    ) -> Option<&ResponsesStreamConnectionStatusNotification> {
+        self.responses_stream_connection_status.as_ref()
+    }
+
+    pub(super) fn on_responses_stream_connection_status(
+        &mut self,
+        notification: ResponsesStreamConnectionStatusNotification,
+    ) {
+        self.responses_stream_connection_status = self.stream_rtt_enabled().then_some(notification);
+    }
+
+    pub(crate) fn clear_responses_stream_connection_status(&mut self) {
+        self.responses_stream_connection_status = None;
+    }
+
+    pub(crate) fn stream_rtt_enabled(&self) -> bool {
+        self.has_chatgpt_account
+            && matches!(
+                self.plan_type,
+                Some(PlanType::Plus | PlanType::Pro | PlanType::ProLite)
+            )
+    }
+}
