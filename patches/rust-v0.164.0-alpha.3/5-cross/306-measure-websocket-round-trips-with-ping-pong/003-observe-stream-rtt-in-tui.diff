+use super::*;
+use codex_app_server_protocol::ResponsesStreamConnectionStatusNotification;
+
+#[tokio::test]
+async fn responses_rtt_preserves_connection_samples_only_for_personal_accounts() {
+    let (mut chat, _rx, _ops) = make_chatwidget_manual(None).await;
+    let thread_id = ThreadId::new();
+    chat.thread_id = Some(thread_id);
+    for (plan, signed_in, enabled) in [
+        (Some(PlanType::Plus), true, true),
+        (Some(PlanType::Pro), true, true),
+        (Some(PlanType::ProLite), true, true),
+        (Some(PlanType::ProMax), true, false),
+        (Some(PlanType::Business), true, false),
+        (Some(PlanType::Unknown), true, false),
+        (None, true, false),
+        (Some(PlanType::Plus), false, false),
+    ] {
+        chat.update_account_state(None, plan, signed_in, signed_in);
+        assert!(chat.responses_stream_connection_status().is_none());
+        for (connected, rtt_ms) in [
+            (true, None),
+            (true, Some(0)),
+            (true, Some(42)),
+            (false, None),
+        ] {
+            let notification = ResponsesStreamConnectionStatusNotification {
+                thread_id: thread_id.to_string(),
+                connected,
+                rtt_ms,
+            };
+            chat.handle_server_notification(
+                ServerNotification::ResponsesStreamConnectionStatus(notification.clone()),
+                None,
+            );
+            assert_eq!(
+                chat.responses_stream_connection_status(),
+                enabled.then_some(&notification),
+            );
+        }
+    }
+}
+
+#[tokio::test]
+async fn account_and_plan_changes_clear_responses_rtt() {
+    let (mut chat, _rx, _ops) = make_chatwidget_manual(None).await;
+    chat.update_account_state(None, Some(PlanType::Plus), true, true);
+    let notification = ResponsesStreamConnectionStatusNotification {
+        thread_id: ThreadId::new().to_string(),
+        connected: true,
+        rtt_ms: Some(42),
+    };
+    chat.on_responses_stream_connection_status(notification.clone());
+    chat.update_account_state(None, Some(PlanType::Plus), true, true);
+    assert!(chat.responses_stream_connection_status().is_none());
+    chat.on_responses_stream_connection_status(notification);
+    chat.on_rate_limit_snapshot(Some(RateLimitSnapshot {
+        limit_id: Some("codex".to_string()),
+        limit_name: None,
+        normal_model_slug: None,
+        primary: None,
+        secondary: None,
+        credits: None,
+        individual_limit: None,
+        spend_control_reached: None,
+        plan_type: Some(PlanType::Business),
+        rate_limit_reached_type: None,
+    }));
+    assert!(chat.responses_stream_connection_status().is_none());
+}
