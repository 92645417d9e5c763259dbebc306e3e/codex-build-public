+#[test]
+fn personal_websocket_retry_requires_chatgpt_personal_plan() {
+    let token = "header.e30.signature";
+    for (plan, expected) in [
+        ("plus", true),
+        ("pro", true),
+        ("prolite", true),
+        ("free", false),
+        ("go", false),
+        ("promax", false),
+        ("team", false),
+        ("business", false),
+        ("enterprise", false),
+        ("unknown", false),
+    ] {
+        let auth = CodexAuth::from_external_chatgpt_tokens(token, "account", Some(plan))
+            .expect("test ChatGPT auth");
+        let mut client = test_model_client(SessionSource::Exec);
+        Arc::get_mut(&mut client.state)
+            .expect("unique test client state")
+            .provider = create_model_provider(
+            ModelProviderInfo::create_openai_provider(None),
+            Some(AuthManager::from_auth_for_testing(auth)),
+        );
+        assert_eq!(
+            client.new_session().personal_chatgpt_websocket_enabled(),
+            expected,
+            "plan {plan}"
+        );
+    }
+
+    let mut api_key_client = test_model_client(SessionSource::Exec);
+    Arc::get_mut(&mut api_key_client.state)
+        .expect("unique test client state")
+        .provider = create_model_provider(
+        ModelProviderInfo::create_openai_provider(None),
+        Some(AuthManager::from_auth_for_testing(CodexAuth::from_api_key(
+            "test-api-key",
+        ))),
+    );
+    assert!(
+        !api_key_client
+            .new_session()
+            .personal_chatgpt_websocket_enabled()
+    );
+}
+
+#[test]
+fn official_personal_websocket_transport_does_not_activate_http_fallback() {
+    for (plan, base_url, fallback) in [
+        ("plus", None, false),
+        ("pro", None, false),
+        ("prolite", None, false),
+        ("business", None, true),
+        ("plus", Some("https://example.com/v1"), true),
+    ] {
+        let auth =
+            CodexAuth::from_external_chatgpt_tokens("header.e30.signature", "account", Some(plan))
+                .expect("test ChatGPT auth");
+        let mut client = test_model_client(SessionSource::Exec);
+        Arc::get_mut(&mut client.state)
+            .expect("unique test client state")
+            .provider = create_model_provider(
+            ModelProviderInfo::create_openai_provider(base_url.map(str::to_string)),
+            Some(AuthManager::from_auth_for_testing(auth)),
+        );
+        let mut session = client.new_session();
+        assert_eq!(
+            session.try_switch_fallback_transport(&test_session_telemetry(), &test_model_info()),
+            fallback,
+        );
+        assert_eq!(client.responses_websocket_enabled(), !fallback);
+        assert!(
+            !session.try_switch_fallback_transport(&test_session_telemetry(), &test_model_info())
+        );
+    }
+}
