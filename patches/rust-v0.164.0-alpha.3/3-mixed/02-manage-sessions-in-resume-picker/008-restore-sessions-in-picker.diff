+#[tokio::test]
+async fn restore_shortcut_stays_in_picker_and_preserves_failed_rows() {
+    let (mut state, requests) = archive_picker_state();
+    let thread_id = ThreadId::new();
+    state.status = SessionStatus::Archived;
+    set_selected_session(&mut state, thread_id);
+    let shortcut = KeyEvent::new(KeyCode::Char('a'), KeyModifiers::CONTROL);
+    let footer = super::super::footer_hint_lines(&state, 220)[0].to_string();
+    assert!(footer.contains("enter restore and resume"));
+    assert!(footer.contains(&format!(
+        "{} restore",
+        crate::key_hint::ctrl(KeyCode::Char('a')).display_label()
+    )));
+    assert!(state.handle_key(shortcut).await.unwrap().is_none());
+    assert_eq!(
+        state.archive_state,
+        ArchiveState::Restoring {
+            thread_id,
+            resume: false
+        }
+    );
+    assert!(
+        state
+            .handle_key(KeyEvent::from(KeyCode::Enter))
+            .await
+            .unwrap()
+            .is_none()
+    );
+    assert_eq!(*requests.lock().unwrap(), vec![thread_id]);
+    assert!(
+        state
+            .handle_unarchive_result(thread_id, Err(std::io::Error::other("restore denied")))
+            .is_none()
+    );
+    assert_eq!(state.filtered_rows.len(), 1);
+    assert_eq!(
+        state.inline_error.as_deref(),
+        Some("Failed to restore archived session: restore denied")
+    );
+    assert!(state.handle_key(shortcut).await.unwrap().is_none());
+    state.picker_loader = Arc::new(|_| panic!("restore completion must not reload the listing"));
+    assert!(
+        state
+            .handle_unarchive_result(
+                thread_id,
+                Ok(SessionTarget {
+                    backend_id: state.backend_id,
+                    path: None,
+                    thread_id,
+                    cwd: None,
+                    history_mode: None,
+                })
+            )
+            .is_none()
+    );
+    assert_eq!(state.archive_state, ArchiveState::Idle);
+    assert_eq!(state.status, SessionStatus::Archived);
+    assert!(state.filtered_rows.is_empty());
+    assert!(!state.pagination.is_loading());
+    assert_eq!(*requests.lock().unwrap(), vec![thread_id, thread_id]);
+}
diff --git a/docs/resume-session-actions.md b/docs/resume-session-actions.md
new file mode 100644
--- /dev/null
+++ b/docs/resume-session-actions.md
@@ -0,0 +1,10 @@
+# Resume Session Actions
+
+- In the active-session list, Ctrl+A archives the selected session and keeps the picker open.
+- In the archived-session list, Enter performs `restore and resume`.
+- In the archived-session list, Ctrl+A performs `restore` without entering the session.
+- Restore-only removes the restored session from the archived list after the native restore succeeds, preserving unrelated rows, selection and pagination without reloading the list.
+- Restore failures preserve the displayed session and report the server error.
+- Ctrl+A preserves a conflicting configured list binding or chord prefix.
+- The currently open conversation must be archived through `/archive`.
+- Profile archive and restore actions also stay in the picker without submitting a model turn.
