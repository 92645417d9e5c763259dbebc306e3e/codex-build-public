+#[tokio::test(start_paused = true)]
+async fn queue_failure_reports_its_target_and_continues_the_remaining_fifo() -> Result<()> {
+    let (mut state, requests) = queue_picker(3, 3);
+    let targets = state
+        .all_rows
+        .iter()
+        .map(|row| row.thread_id.unwrap())
+        .collect::<Vec<_>>();
+    state.request_title();
+    state.selected = 1;
+    state.request_title();
+    state.selected = 2;
+    state.request_title();
+    let first = requests.lock().unwrap().pop().unwrap();
+    let PickerLoadRequest::GenerateTitle {
+        thread_id,
+        cancellation,
+        start_not_before,
+    } = first
+    else {
+        panic!("first title request")
+    };
+    assert_eq!(start_not_before, None);
+    state.finish_title(thread_id, Err(std::io::Error::other("generation failed")));
+    assert!(cancellation.is_cancelled());
+    assert_eq!(
+        state.inline_error.as_deref(),
+        Some(format!("Could not generate title: generation failed (session {thread_id})").as_str())
+    );
+    for (index, succeeds) in [(1, true), (2, false)] {
+        let pending = std::mem::take(&mut *requests.lock().unwrap());
+        assert_eq!(pending.len(), 1, "only one remaining target may start");
+        let PickerLoadRequest::GenerateTitle {
+            thread_id: next,
+            cancellation,
+            start_not_before,
+        } = pending.into_iter().next().unwrap()
+        else {
+            panic!("remaining title request")
+        };
+        assert_eq!(next, targets[index]);
+        assert_eq!(
+            start_not_before,
+            Some(tokio::time::Instant::now() + std::time::Duration::from_secs(2))
+        );
+        assert!(!cancellation.is_cancelled());
+        state.finish_title(thread_id, Ok("stale failed result".into()));
+        assert!(requests.lock().unwrap().is_empty());
+        assert!(state.all_rows[0].thread_name.is_none());
+        tokio::time::advance(std::time::Duration::from_secs(2)).await;
+        state.title_started(next);
+        state.finish_title(
+            next,
+            if succeeds {
+                Ok("second saved title".into())
+            } else {
+                Err(std::io::Error::other("another failure"))
+            },
+        );
+        assert!(cancellation.is_cancelled());
+    }
+    assert!(state.title_action.is_none());
+    assert!(requests.lock().unwrap().is_empty());
+    assert_eq!(
+        state.all_rows[1].thread_name.as_deref(),
+        Some("second saved title")
+    );
+    assert!(state.all_rows[2].thread_name.is_none());
+    assert_eq!(
+        state.inline_error.as_deref(),
+        Some(
+            format!(
+                "Could not generate title: another failure (session {})",
+                targets[2]
+            )
+            .as_str()
+        )
+    );
+    Ok(())
+}
