@@ -0,0 +1,567 @@
+use super::*;
+use pretty_assertions::assert_eq;
+use std::sync::Mutex;
+
+fn queue_picker(stored: usize, listed: usize) -> (PickerState, Arc<Mutex<Vec<PickerLoadRequest>>>) {
+    let requests = Arc::new(Mutex::new(Vec::new()));
+    let sink = Arc::clone(&requests);
+    let mut state = PickerState::new(
+        crate::backend_id::BackendId::new(),
+        FrameRequester::test_dummy(),
+        Arc::new(move |request| sink.lock().unwrap().push(request)),
+        ProviderFilter::Any,
+        true,
+        None,
+        SessionPickerAction::Resume,
+    );
+    state.all_rows = (0..stored)
+        .map(|index| Row {
+            path: None,
+            preview: format!(
+                "{} session {index}",
+                if index < listed { "batch" } else { "other" }
+            ),
+            thread_id: Some(ThreadId::new()),
+            thread_name: None,
+            created_at: None,
+            updated_at: None,
+            cwd: None,
+            git_branch: None,
+        })
+        .collect();
+    state.query = "batch".into();
+    state.apply_filter();
+    state.pagination.next_cursor = Some(PageCursor::AppServer("unloaded sessions".into()));
+    (state, requests)
+}
+
+fn title_hints(state: &PickerState, width: u16) -> String {
+    footer_hint_lines(state, width)
+        .into_iter()
+        .map(|line| line.to_string())
+        .collect::<Vec<_>>()
+        .join("\n")
+}
+
+#[tokio::test(start_paused = true)]
+async fn ctrl_g_queues_only_manual_targets_in_fifo_order_during_generation_and_cooldown()
+-> Result<()> {
+    let (mut state, requests) = queue_picker(12, 10);
+    let expected = [2, 0, 1, 3].map(|index| state.filtered_rows[index].thread_id.unwrap());
+    let key = KeyEvent::new(KeyCode::Char('g'), KeyModifiers::CONTROL);
+    let retired = crate::key_hint::alt(KeyCode::Char('g'));
+    assert!(!title_hints(&state, 240).contains(&retired.display_label()));
+    state
+        .handle_key(KeyEvent::new(KeyCode::Char('g'), KeyModifiers::ALT))
+        .await?;
+    assert!(requests.lock().unwrap().is_empty());
+    for _ in 0..2 {
+        state.handle_key(KeyEvent::from(KeyCode::Down)).await?;
+    }
+    state.handle_key(key).await?;
+    let first = requests.lock().unwrap().pop().unwrap();
+    let PickerLoadRequest::GenerateTitle {
+        thread_id,
+        cancellation,
+        start_not_before,
+    } = first
+    else {
+        panic!("first manual title request")
+    };
+    assert_eq!(thread_id, expected[0]);
+    assert_eq!(start_not_before, None);
+    state.title_started(thread_id);
+    for _ in 0..2 {
+        state.handle_key(KeyEvent::from(KeyCode::Up)).await?;
+    }
+    assert!(title_hints(&state, 240).contains("queue title"));
+    state.handle_key(key).await?;
+    state.handle_key(key).await?;
+    assert!(title_hints(&state, 240).contains("queued title 1/2"));
+    state.handle_key(KeyEvent::from(KeyCode::Down)).await?;
+    state.handle_key(key).await?;
+    state.handle_key(key).await?;
+    state.handle_key(KeyEvent::from(KeyCode::Down)).await?;
+    state.handle_key(key).await?;
+    assert!(title_hints(&state, 240).contains("generating title 1/3"));
+    state.finish_title(ThreadId::new(), Ok("stale completion".into()));
+    assert!(
+        requests.lock().unwrap().is_empty(),
+        "generation is still blocked"
+    );
+    state.set_query("other".into());
+    assert_eq!(state.filtered_rows.len(), 2);
+    assert!(title_hints(&state, 96).contains("queue 1/3"));
+    state.finish_title(thread_id, Ok("generated title zero".into()));
+    assert!(cancellation.is_cancelled());
+    state.set_query("batch".into());
+    state.selected = 3;
+    state.handle_key(key).await?;
+    assert!(title_hints(&state, 240).contains("queued title 1/4"));
+    for (index, target) in expected.into_iter().enumerate().skip(1) {
+        let pending = std::mem::take(&mut *requests.lock().unwrap());
+        assert_eq!(
+            pending.len(),
+            1,
+            "only the current target may be dispatched"
+        );
+        let Some(PickerLoadRequest::GenerateTitle {
+            thread_id,
+            cancellation,
+            start_not_before,
+        }) = pending.into_iter().next()
+        else {
+            panic!("next manual title request")
+        };
+        assert_eq!(thread_id, target);
+        assert_eq!(
+            start_not_before,
+            Some(tokio::time::Instant::now() + std::time::Duration::from_secs(2))
+        );
+        state.selected = state
+            .filtered_rows
+            .iter()
+            .position(|row| row.thread_id == Some(target))
+            .unwrap();
+        assert!(title_hints(&state, 240).contains(&format!("waiting 2s {index}/4")));
+        state.handle_key(key).await?;
+        assert!(requests.lock().unwrap().is_empty());
+        tokio::time::advance(std::time::Duration::from_secs(2)).await;
+        state.title_started(thread_id);
+        assert!(title_hints(&state, 240).contains(&format!("generating title {}/4", index + 1)));
+        state.finish_title(thread_id, Ok(format!("generated title {index}")));
+        assert!(cancellation.is_cancelled());
+    }
+    assert!(state.title_action.is_none());
+    assert!(requests.lock().unwrap().is_empty());
+    assert_eq!(
+        state
+            .all_rows
+            .iter()
+            .filter(|row| row.thread_name.is_some())
+            .count(),
+        4
+    );
+    Ok(())
+}
