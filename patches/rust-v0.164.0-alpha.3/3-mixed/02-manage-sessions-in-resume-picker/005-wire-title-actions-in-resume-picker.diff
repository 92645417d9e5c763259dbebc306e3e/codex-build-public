+#[tokio::test(start_paused = true)]
+async fn queue_closure_cancels_unstarted_targets_and_keeps_the_idle_deadline() -> Result<()> {
+    let (mut state, requests) = queue_picker(3, 3);
+    state.request_title();
+    let first = requests.lock().unwrap().pop().unwrap();
+    let PickerLoadRequest::GenerateTitle { thread_id, .. } = first else {
+        panic!("first title request")
+    };
+    state.title_started(thread_id);
+    state.finish_title(thread_id, Ok("first saved title".into()));
+    assert!(requests.lock().unwrap().is_empty());
+    let next_deadline = tokio::time::Instant::now() + std::time::Duration::from_secs(2);
+    tokio::time::advance(std::time::Duration::from_secs(1)).await;
+    state.selected = 2;
+    state.request_title();
+    let next = requests.lock().unwrap().pop().unwrap();
+    let PickerLoadRequest::GenerateTitle {
+        cancellation,
+        start_not_before,
+        ..
+    } = next
+    else {
+        panic!("next title request")
+    };
+    assert_eq!(start_not_before, Some(next_deadline));
+    assert!(!cancellation.is_cancelled());
+    assert!(title_hints(&state, 240).contains("waiting 2s"));
+    state.selected = 0;
+    state.request_title();
+    assert!(title_hints(&state, 240).contains("queued title 0/2"));
+    drop(state);
+    assert!(cancellation.is_cancelled());
+    assert!(requests.lock().unwrap().is_empty());
+    Ok(())
