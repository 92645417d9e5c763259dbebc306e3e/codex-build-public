--- /dev/null
+++ b/codex-rs/tui/src/resume_picker/titles.rs
@@ -0,0 +1,221 @@
+//! Generate or manually edit titles without leaving the session picker.
+
+use super::*;
+use crate::bottom_pane::CenteredView;
+use crate::bottom_pane::ViewCompletion;
+use crate::bottom_pane::custom_prompt_view::CustomPromptView;
+use crate::render::renderable::Renderable;
+use std::collections::VecDeque;
+use tokio_util::sync::CancellationToken;
+
+pub(super) enum TitleAction {
+    Generating {
+        thread_id: ThreadId,
+        remaining: VecDeque<ThreadId>,
+        completed: usize,
+        waiting: bool,
+        _cancellation: tokio_util::sync::DropGuard,
+    },
+    Editing {
+        thread_id: ThreadId,
+        prompt: Box<CustomPromptView>,
+    },
+    Saving {
+        thread_id: ThreadId,
+    },
+}
+
+impl PickerState {
+    pub(super) fn title_actions_available(&self) -> bool {
+        matches!(self.action, SessionPickerAction::Resume)
+            && self.status == SessionStatus::Active
+            && self.profile_pending.is_none()
+            && matches!(self.archive_state, archive::ArchiveState::Idle)
+            && matches!(
+                self.title_action,
+                None | Some(TitleAction::Generating { .. })
+            )
+    }
+
+    fn title_target(&self) -> Option<&Row> {
+        (self.title_actions_available() && self.title_action.is_none())
+            .then(|| self.filtered_rows.get(self.selected))
+            .flatten()
+    }
+
+    pub(super) fn request_title(&mut self) {
+        let Some(thread_id) = self
+            .title_actions_available()
+            .then(|| {
+                self.filtered_rows
+                    .get(self.selected)
+                    .and_then(|row| row.thread_id)
+            })
+            .flatten()
+        else {
+            return;
+        };
+        if let Some(TitleAction::Generating {
+            thread_id: current,
+            remaining,
+            ..
+        }) = &mut self.title_action
+        {
+            if *current != thread_id && !remaining.contains(&thread_id) {
+                remaining.push_back(thread_id);
+                self.request_frame();
+            }
+            return;
+        }
+        self.title_generated_for = None;
+        self.start_title_generation(thread_id, VecDeque::new(), 0);
+    }
+
+    fn start_title_generation(
+        &mut self,
+        thread_id: ThreadId,
+        remaining: VecDeque<ThreadId>,
+        completed: usize,
+    ) {
+        let cancellation = CancellationToken::new();
+        self.title_action = Some(TitleAction::Generating {
+            thread_id,
+            remaining,
+            completed,
+            waiting: true,
+            _cancellation: cancellation.clone().drop_guard(),
+        });
+        (self.picker_loader)(PickerLoadRequest::GenerateTitle {
+            thread_id,
+            cancellation,
+            start_not_before: self.title_start_not_before,
+        });
+        self.request_frame();
+    }
+
+    pub(super) fn title_started(&mut self, thread_id: ThreadId) {
+        if let Some(TitleAction::Generating {
+            thread_id: current,
+            waiting,
+            ..
+        }) = &mut self.title_action
+            && *current == thread_id
+        {
+            *waiting = false;
+            self.request_frame();
+        }
+    }
+
+    pub(super) fn edit_title(&mut self) {
+        let Some(row) = self.title_target() else {
+            return;
+        };
+        let Some(thread_id) = row.thread_id else {
+            return;
+        };
+        let name = row.thread_name.clone().unwrap_or_default();
+        self.title_generated_for = None;
+        let loader = Arc::clone(&self.picker_loader);
+        let mut prompt = CustomPromptView::new(
+            if name.trim().is_empty() {
+                "Name session"
+            } else {
+                "Rename session"
+            }
+            .to_string(),
+            "Enter a session name".to_string(),
+            name,
+            None,
+            Box::new(move |name| loader(PickerLoadRequest::RenameTitle { thread_id, name })),
+        );
+        prompt.set_keymap_bindings(&self.keymap);
+        self.chord_matcher.cancel();
+        self.title_action = Some(TitleAction::Editing {
+            thread_id,
+            prompt: Box::new(prompt),
+        });
+        self.request_frame();
+    }
+
+    pub(super) fn handle_title_prompt_key(&mut self, key: KeyEvent) -> bool {
+        let Some(TitleAction::Editing { thread_id, prompt }) = &mut self.title_action else {
+            return false;
+        };
+        if crate::key_hint::ctrl(KeyCode::Char('c')).is_press(key) {
+            prompt.on_ctrl_c();
+        } else {
+            prompt.handle_key_event(key);
+        }
+        if let Some(completion) = prompt.completion() {
+            self.title_action = match completion {
+                ViewCompletion::Accepted => Some(TitleAction::Saving {
+                    thread_id: *thread_id,
+                }),
+                ViewCompletion::Cancelled => None,
+            };
+            self.chord_matcher.cancel();
+        }
+        self.request_frame();
+        true
+    }
+
+    pub(super) fn render_title_prompt(&self, frame: &mut crate::custom_terminal::Frame) {
+        if let Some(TitleAction::Editing { prompt, .. }) = &self.title_action {
+            let dialog = CenteredView(prompt.as_ref());
+            let area = frame.area();
+            dialog.render(area, frame.buffer);
+            if let Some(position) = dialog.cursor_pos(area) {
+                frame.set_cursor_position(position);
+            }
+            frame.set_cursor_style(dialog.cursor_style(area));
+        }
+    }
+
+    pub(super) fn finish_title(&mut self, thread_id: ThreadId, result: std::io::Result<String>) {
+        let generated = match &self.title_action {
+            Some(TitleAction::Generating { thread_id: id, .. }) if *id == thread_id => true,
+            Some(TitleAction::Saving { thread_id: id }) if *id == thread_id => false,
+            _ => return,
+        };
+        let action = self.title_action.take();
+        if generated {
+            self.title_start_not_before =
+                Some(tokio::time::Instant::now() + std::time::Duration::from_secs(2));
+        }
+        match result {
+            Ok(title) => {
+                if let Some(row) = self
+                    .all_rows
+                    .iter_mut()
+                    .find(|row| row.thread_id == Some(thread_id))
+                {
+                    row.thread_name = Some(title);
+                }
+                self.title_generated_for = generated.then_some(thread_id);
+                self.apply_filter();
+            }
+            Err(error) => {
+                self.inline_error = Some(if generated {
+                    format!("Could not generate title: {error} (session {thread_id})")
+                } else {
+                    format!("Could not save title: {error}")
+                });
+            }
+        }
+        if let Some(TitleAction::Generating {
+            mut remaining,
+            completed,
+            ..
+        }) = action
+            && let Some(next) = remaining.pop_front()
+        {
+            self.title_generated_for = None;
+            self.start_title_generation(next, remaining, completed + 1);
+        }
+        self.request_frame();
+    }
+}
