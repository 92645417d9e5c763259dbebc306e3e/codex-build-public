 use super::*;
 use pretty_assertions::assert_eq;
 
+#[tokio::test]
+async fn profile_updates_keep_focus_near_the_original_row() -> Result<()> {
+    for (target, selected, updated_at, expected) in
+        [(4, 4, 100, 5), (7, 7, 100, 6), (4, 4, 4, 4), (4, 5, 100, 5)]
+    {
+        let (mut state, requests) = test_picker();
+        let rows = (0..8)
+            .map(|index| Row {
+                created_at: DateTime::from_timestamp(8 - index, 0),
+                updated_at: DateTime::from_timestamp(8 - index, 0),
+                ..test_row(ThreadId::new())
+            })
+            .collect::<Vec<_>>();
+        let thread_id = rows[target].thread_id.unwrap();
+        let expected_id = rows[expected].thread_id;
+        state.all_rows = rows.clone();
+        state.apply_filter();
+        state.selected = selected;
+        state.scroll_top = selected - 2;
+        state.view_rows = Some(5);
+        state.density = SessionListDensity::Dense;
+        let scroll_top = state.scroll_top;
+        state.profile_pending = Some((thread_id, 0));
+        if target == selected && updated_at == 100 {
+            let (mut archived, _) = test_picker();
+            archived.all_rows = rows;
+            archived.apply_filter();
+            archived.selected = selected;
+            archived.apply_session_mutation(thread_id, SessionStatus::Archived, None);
+            assert_eq!(
+                archived.filtered_rows[archived.selected].thread_id,
+                expected_id
+            );
+        }
+        let thread = Thread {
+            id: thread_id.to_string(),
+            session_id: thread_id.to_string(),
+            originator: None,
+            environments: None,
+            extra: None,
+            forked_from_id: None,
+            parent_thread_id: None,
+            preview: "profile applied".into(),
+            ephemeral: false,
+            section: None,
+            section_entered_at: None,
+            project_id: None,
+            daybreak_enabled: None,
+            history_mode: Default::default(),
+            model_provider: "openai".into(),
+            model: None,
+            reasoning_effort: None,
+            created_at: 8 - target as i64,
+            updated_at,
+            recency_at: Some(updated_at),
+            status: codex_app_server_protocol::ThreadStatus::Idle,
+            path: None,
+            cwd: codex_utils_absolute_path::AbsolutePathBuf::try_from(PathBuf::from("/tmp"))?,
+            cli_version: "0.0.0".into(),
+            source: codex_app_server_protocol::SessionSource::Cli,
+            can_accept_direct_input: None,
+            thread_source: None,
+            agent_nickname: None,
+            agent_role: None,
+            git_info: None,
+            name: Some("saved profile values".into()),
+            turns: Vec::new(),
+        };
+        state
+            .handle_background_event(BackgroundEvent::ProfileApplied {
+                thread_id,
+                status: SessionStatus::Active,
+                thread: Some(Box::new(thread)),
+                result: Ok(()),
+            })
+            .await?;
+        assert_eq!(state.filtered_rows[state.selected].thread_id, expected_id);
+        assert_eq!(state.scroll_top, scroll_top);
+        assert_eq!(state.filtered_rows.len(), 8);
+        assert_eq!(state.profile_pending, None);
+        assert!(state.inline_error.is_none());
+        assert_eq!(
+            state.filtered_rows[if updated_at == 100 { 0 } else { target }].thread_id,
+            Some(thread_id)
+        );
+        assert!(requests.lock().unwrap().is_empty());
+    }
+    Ok(())
+}
