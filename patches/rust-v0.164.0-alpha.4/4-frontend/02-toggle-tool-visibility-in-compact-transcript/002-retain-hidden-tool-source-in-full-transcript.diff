+#[test]
+fn tool_visibility_marks_agent_calls_but_preserves_source() {
+    for (source, hideable) in [
+        (ExecCommandSource::Agent, true),
+        (ExecCommandSource::UserShell, false),
+    ] {
+        let cell = ExecCell::new(
+            ExecCall {
+                call_id: "call-1".to_string(),
+                command: vec!["echo".to_string(), "visible".to_string()],
+                parsed: Vec::new(),
+                output: Some(CommandOutput::default()),
+                source,
+                start_time: None,
+                duration: None,
+                interaction_input: None,
+            },
+            /*animations_enabled*/ false,
+        );
+        assert_eq!(cell.is_hideable_tool_call(), hideable);
+        assert!(!cell.transcript_hyperlink_lines(/*width*/ 80).is_empty());
+    }
+
+    let image = new_image_generation_call(
+        "image-1".into(),
+        "completed",
+        Some("a small image".into()),
+        None,
+    );
+    assert!(image.is_hideable_tool_call());
+    assert!(!image.transcript_hyperlink_lines(/*width*/ 80).is_empty());
+    assert_eq!(
+        image.display_lines(/*width*/ 80),
+        image.transcript_lines(/*width*/ 80)
+    );
+}
