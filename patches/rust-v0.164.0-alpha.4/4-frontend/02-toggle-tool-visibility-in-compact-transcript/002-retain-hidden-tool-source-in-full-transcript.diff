+#[tokio::test]
+async fn alt_o_shows_default_hidden_compact_tools_but_ctrl_t_keeps_complete_transcript()
+-> Result<()> {
+    let mut app = crate::app::test_support::make_test_app().await;
+    app.local_settings.tui.fullscreen_transcript = true;
+    app.chat_widget.local_settings.tui.fullscreen_transcript = true;
+    attach_thread(&mut app, ThreadId::new());
+    app.transcript_cells = vec![
+        user_cell("Prompt"),
+        Arc::new(crate::history_cell::new_image_generation_call(
+            "image-1".into(),
+            "completed",
+            Some("blue square".into()),
+            None,
+        )),
+    ];
+    let mut app_server = Box::pin(crate::start_embedded_app_server_for_picker(&app.config)).await?;
+    let mut tui = crate::tui::test_support::make_test_tui()?;
+    tui.set_owned_screen(/*owned*/ true)?;
+    let area = Size::new(/*width*/ 80, /*height*/ 24);
+    app.render_owned_transcript(&mut tui, area)?;
+    let hidden = buffer_text(crate::custom_terminal::test_support::last_rendered_buffer(
+        &tui.terminal,
+    ));
+    assert!(!hidden.contains("Generated Image"), "{hidden}");
+    assert!(hidden.contains("Tool calls hidden"), "{hidden}");
+    assert!(hidden.contains("Prompt"), "{hidden}");
+    app.handle_tui_event(
+        &mut tui,
+        &mut app_server,
+        TuiEvent::Key(KeyEvent::new(KeyCode::Char('o'), KeyModifiers::ALT)),
+    )
+    .await?;
+    assert!(app.transcript_view.tool_calls_visible());
+    app.render_owned_transcript(&mut tui, area)?;
+    let visible = buffer_text(crate::custom_terminal::test_support::last_rendered_buffer(
+        &tui.terminal,
+    ));
+    assert!(visible.contains("Generated Image"), "{visible}");
+    assert!(visible.contains("Tool calls shown"), "{visible}");
+    // Hide tools before opening the full transcript; retained source is independent.
+    app.handle_tui_event(
+        &mut tui,
+        &mut app_server,
+        TuiEvent::Key(KeyEvent::new(KeyCode::Char('o'), KeyModifiers::ALT)),
+    )
+    .await?;
+    assert!(!app.transcript_view.tool_calls_visible());
+    app.handle_tui_event(
+        &mut tui,
+        &mut app_server,
+        TuiEvent::Key(KeyEvent::new(KeyCode::Char('t'), KeyModifiers::CONTROL)),
+    )
+    .await?;
+    assert!(app.transcript_view.is_detailed());
+    app.render_owned_transcript(&mut tui, area)?;
+    let detailed = buffer_text(crate::custom_terminal::test_support::last_rendered_buffer(
+        &tui.terminal,
+    ));
+    assert!(detailed.contains("Generated Image"), "{detailed}");
+    app_server.shutdown().await?;
+    tui.set_owned_screen(/*owned*/ false)?;
+    Ok(())
+}
