+#[test]
+fn hidden_tool_row_remains_searchable_in_complete_transcript() {
+    let command = crate::exec_cell::ExecCell::new(
+        crate::exec_cell::ExecCall {
+            call_id: "command".to_string(),
+            command: vec!["echo".to_string(), "needle".to_string()],
+            parsed: Vec::new(),
+            output: Some(crate::exec_cell::CommandOutput::new(
+                /*exit_code*/ 0,
+                "hidden needle\n".to_string(),
+            )),
+            source: codex_app_server_protocol::CommandExecutionSource::Agent,
+            start_time: None,
+            duration: None,
+            interaction_input: None,
+        },
+        /*animations_enabled*/ false,
+    );
+    let cells: Vec<Arc<dyn HistoryCell>> = vec![
+        Arc::new(command),
+        Arc::new(crate::history_cell::new_image_generation_call(
+            "unrelated-image".into(),
+            "completed",
+            Some("blue square".into()),
+            None,
+        )),
+    ];
+    let mut view = TranscriptView {
+        area: Rect::new(
+            /*x*/ 0, /*y*/ 0, /*width*/ 80, /*height*/ 4,
+        ),
+        ..TranscriptView::default()
+    };
+    assert!(view.current_layout(&cells, 0).unwrap().text().is_empty());
+    view.begin_search();
+    view.paste_search("hidden needle");
+    finish_scan(&mut view, &cells);
+    assert!(view.search.current.is_some());
+    assert!(!view.is_detailed());
+    assert!(
+        view.layout(&cells, 0)
+            .unwrap()
+            .text()
+            .contains("hidden needle")
+    );
+    assert!(view.layout(&cells, 1).unwrap().text().is_empty());
+    view.cancel_search();
+    assert!(view.current_layout(&cells, 0).unwrap().text().is_empty());
+    assert!(view.current_layout(&cells, 1).unwrap().text().is_empty());
+}
