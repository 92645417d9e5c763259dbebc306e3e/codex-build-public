@@ -57,6 +57,56 @@ fn render_with_height(
     (text, composer.cursor_pos_with_options(area, options))
 }
 
+#[test]
+fn tui_composer_offsets_only_the_hint_without_changing_fill_layout_or_cursor() {
+    let mut composer = composer();
+    let inline = ComposerRenderOptions {
+        separate_status_line: true,
+        ..Default::default()
+    };
+    let fullscreen = ComposerRenderOptions {
+        fullscreen_transcript: true,
+        ..inline
+    };
+    for draft in ["", "typed text"] {
+        composer.set_text_content(draft.into(), Vec::new(), Vec::new());
+        let width = 40;
+        let height = composer.desired_height_with_options(width, fullscreen);
+        let area = Rect::new(/*x*/ 0, /*y*/ 0, width, height);
+        let layout = composer.layout_with_options(area, fullscreen);
+        assert_eq!(
+            layout.textarea,
+            composer.layout_with_options(area, inline).textarea
+        );
+        assert_eq!(
+            composer.cursor_pos_with_options(area, fullscreen),
+            composer.cursor_pos_with_options(area, inline)
+        );
+        let mut actual = Buffer::empty(area);
+        let mut expected = Buffer::empty(area);
+        composer.render_with_options(area, &mut actual, /*mask_char*/ None, fullscreen);
+        composer.render_with_options(area, &mut expected, /*mask_char*/ None, inline);
+        if !draft.is_empty() {
+            assert_eq!(actual, expected);
+            continue;
+        }
+        for y in [layout.composer.y, layout.composer.bottom() - 1] {
+            for x in 0..width {
+                assert_eq!(
+                    actual[(x, y)].bg,
+                    user_message_style().bg.unwrap_or(Color::Reset)
+                );
+            }
+        }
+        let (x, y) = (layout.textarea.x, layout.textarea.y);
+        assert_eq!(actual[(x - LIVE_PREFIX_COLS, y)].symbol(), "›");
+        assert_eq!(expected[(x, y)].symbol(), "A");
+        assert_eq!(actual[(x, y)].symbol(), " ");
+        assert_eq!(actual[(x + 2, y)].symbol(), "A");
+        insta::assert_snapshot!(format!("inline={expected:?}\nfullscreen={actual:?}"));
+    }
+}
