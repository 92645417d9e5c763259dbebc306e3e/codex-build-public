new file mode 100644
--- /dev/null
+++ b/codex-rs/tui/src/resume_picker/message_counts.rs
@@ -0,0 +1,148 @@
+//! Count messages only for an explicitly selected Messages listing.
+
+use super::*;
+use codex_app_server_protocol::ThreadMessageCountReadParams;
+use codex_app_server_protocol::ThreadMessageCountReadResponse;
+use tokio_util::sync::CancellationToken;
+
+pub(super) struct MessageCounts {
+    request_token: usize,
+    values: HashMap<ThreadId, MessageCount>,
+    requests: mpsc::UnboundedSender<ThreadId>,
+    _cancellation: tokio_util::sync::DropGuard,
+}
+
+#[derive(Clone, Copy)]
+enum MessageCount {
+    Pending,
+    Ready(u64),
+    Failed,
+}
+
+impl MessageCounts {
+    pub(super) fn queue_rows(&mut self, rows: &[Row]) {
+        for row in rows {
+            if let Some(thread_id) = row.thread_id
+                && let std::collections::hash_map::Entry::Vacant(entry) =
+                    self.values.entry(thread_id)
+            {
+                entry.insert(MessageCount::Pending);
+                let _ = self.requests.send(thread_id);
+            }
+        }
+    }
+
+    fn for_row(&self, row: &Row) -> MessageCount {
+        row.thread_id
+            .and_then(|thread_id| self.values.get(&thread_id))
+            .copied()
+            .unwrap_or(MessageCount::Pending)
+    }
+
+    pub(super) fn sort_value(&self, row: &Row) -> u64 {
+        match self.for_row(row) {
+            MessageCount::Ready(value) => value,
+            MessageCount::Pending | MessageCount::Failed => 0,
+        }
+    }
+
+    pub(super) fn display_value(&self, row: &Row) -> String {
+        match self.for_row(row) {
+            MessageCount::Ready(value) => value.to_string(),
+            MessageCount::Pending => "0".to_string(),
+            MessageCount::Failed => "Error".to_string(),
+        }
+    }
+}
+
+impl PickerState {
+    pub(super) fn start_message_counts(&mut self) {
+        let request_token = self.allocate_request_token();
+        let (requests, receiver) = mpsc::unbounded_channel();
+        let cancellation = CancellationToken::new();
+        self.sort_key = PickerSortKey::MessageCount(MessageCounts {
+            request_token,
+            values: HashMap::new(),
+            requests,
+            _cancellation: cancellation.clone().drop_guard(),
+        });
+        (self.picker_loader)(PickerLoadRequest::MessageCounts {
+            request_token,
+            requests: receiver,
+            cancellation,
+        });
+    }
+
+    pub(super) fn message_count_finished(
+        &mut self,
+        request_token: usize,
+        thread_id: ThreadId,
+        result: std::io::Result<u64>,
+    ) {
+        let PickerSortKey::MessageCount(counts) = &mut self.sort_key else {
+            return;
+        };
+        if counts.request_token != request_token || !counts.values.contains_key(&thread_id) {
+            return;
+        }
+        let value = match result {
+            Ok(value) => MessageCount::Ready(value),
+            Err(error) => {
+                self.inline_error = Some(format!(
+                    "Could not count messages: {error} (session {thread_id})"
+                ));
+                MessageCount::Failed
+            }
+        };
+        counts.values.insert(thread_id, value);
+        let selected_key = self
+            .filtered_rows
+            .get(self.selected)
+            .and_then(Row::seen_key);
+        // A count changes ordering, not the input context or a pending key chord.
+        self.sort_filtered_rows(selected_key);
+    }
+}
+
+pub(super) async fn run(
+    handle: AppServerRequestHandle,
+    request_token: usize,
+    mut requests: mpsc::UnboundedReceiver<ThreadId>,
+    cancellation: CancellationToken,
+    bg_tx: mpsc::UnboundedSender<BackgroundEvent>,
+) {
+    loop {
+        let thread_id = tokio::select! {
+            biased;
+            _ = cancellation.cancelled() => break,
+            next = requests.recv() => match next {
+                Some(thread_id) => thread_id,
+                None => break,
+            },
+        };
+        let result = tokio::select! {
+            biased;
+            _ = cancellation.cancelled() => break,
+            result = handle.request_typed::<ThreadMessageCountReadResponse>(
+                ClientRequest::ThreadMessageCountRead {
+                    request_id: RequestId::String(format!("resume-picker-count-{}", Uuid::new_v4())),
+                    params: ThreadMessageCountReadParams { thread_id: thread_id.to_string() },
+                },
+            ) => result.map(|response| response.message_count).map_err(std::io::Error::other),
+        };
+        if bg_tx
+            .send(BackgroundEvent::MessageCount {
+                request_token,
+                thread_id,
+                result,
+            })
+            .is_err()
+        {
+            break;
+        }
+    }
+}
+
