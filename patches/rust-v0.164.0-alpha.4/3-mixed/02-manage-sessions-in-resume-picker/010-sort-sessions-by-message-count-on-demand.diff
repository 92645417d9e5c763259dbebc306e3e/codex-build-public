+#[tokio::test]
+async fn pending_count_rpc_leaves_other_requests_available_and_cancellation_stops_the_queue()
+-> Result<()> {
+    let listener = tokio::net::TcpListener::bind("127.0.0.1:0").await?;
+    let address = listener.local_addr()?;
+    let (requests_tx, mut requests_rx) = mpsc::unbounded_channel();
+    let server = tokio::spawn(async move {
+        let (stream, _) = listener.accept().await.unwrap();
+        let mut socket = tokio_tungstenite::accept_async(stream).await.unwrap();
+        while let Some(frame) = futures::StreamExt::next(&mut socket).await {
+            let frame = frame.unwrap();
+            if frame.is_close() {
+                break;
+            }
+            if !frame.is_text() {
+                continue;
+            }
+            let request: serde_json::Value =
+                serde_json::from_str(frame.to_text().unwrap()).unwrap();
+            let method = request["method"].as_str().unwrap();
+            let result = match method {
+                "initialize" => {
+                    json!({"userAgent":"message-count-test","codexHome":"/server/.codex"})
+                }
+                "initialized" => continue,
+                "thread/messageCount/read" => {
+                    requests_tx.send(request.clone()).unwrap();
+                    continue;
+                }
+                "model/list" => {
+                    requests_tx.send(request.clone()).unwrap();
+                    json!({"data":[],"nextCursor":null})
+                }
+                _ => panic!("unexpected message-count request: {method}"),
+            };
+            socket
+                .send(Message::Text(
+                    json!({"id":request["id"],"result":result})
+                        .to_string()
+                        .into(),
+                ))
+                .await
+                .unwrap();
+        }
+    });
+    let client = RemoteAppServerClient::connect(RemoteAppServerConnectArgs {
+        endpoint: RemoteAppServerEndpoint::WebSocket {
+            websocket_url: format!("ws://{address}"),
+            auth_token: None,
+        },
+        client_name: "message-count-test".into(),
+        client_version: "test".into(),
+        experimental_api: true,
+        mcp_server_openai_form_elicitation: false,
+        opt_out_notification_methods: Vec::new(),
+        channel_capacity: 8,
+    })
+    .await?;
+    let handle = AppServerRequestHandle::Remote(client.request_handle());
+    let (counts_tx, counts_rx) = mpsc::unbounded_channel();
+    let (bg_tx, mut bg_rx) = mpsc::unbounded_channel();
+    let first = ThreadId::new();
+    counts_tx.send(first)?;
+    counts_tx.send(ThreadId::new())?;
+    let cancellation = CancellationToken::new();
+    let worker = tokio::spawn(run(
+        handle.clone(),
+        17,
+        counts_rx,
+        cancellation.clone(),
+        bg_tx,
+    ));
+    let pending = requests_rx.recv().await.unwrap();
+    assert_eq!(pending["method"], "thread/messageCount/read");
+    assert_eq!(pending["params"]["threadId"], first.to_string());
+    let _: ModelListResponse = handle
+        .request_typed(ClientRequest::ModelList {
+            request_id: RequestId::String("message-count-barrier".into()),
+            params: ModelListParams::default(),
+        })
+        .await?;
+    assert_eq!(requests_rx.recv().await.unwrap()["method"], "model/list");
+    assert!(!worker.is_finished());
+    cancellation.cancel();
+    worker.await?;
+    assert!(requests_rx.try_recv().is_err());
+    assert!(bg_rx.try_recv().is_err());
+    client.shutdown().await?;
+    server.await?;
+    Ok(())
+}
