@@ -0,0 +1,412 @@
+use super::*;
+use codex_app_server_client::RemoteAppServerClient;
+use codex_app_server_client::RemoteAppServerConnectArgs;
+use codex_app_server_client::RemoteAppServerEndpoint;
+use codex_app_server_protocol::ModelListParams;
+use codex_app_server_protocol::ModelListResponse;
+use futures::SinkExt;
+use pretty_assertions::assert_eq;
+use serde_json::json;
+use std::sync::Mutex;
+use tokio_tungstenite::tungstenite::Message;
+
+type Requests = Arc<Mutex<Vec<PickerLoadRequest>>>;
+
+fn take_page(requests: &Requests) -> PageLoadRequest {
+    let mut requests = requests.lock().unwrap();
+    let index = requests
+        .iter()
+        .position(|request| matches!(request, PickerLoadRequest::Page(_)))
+        .unwrap();
+    let PickerLoadRequest::Page(page) = requests.remove(index) else {
+        unreachable!()
+    };
+    page
+}
+
+fn take_counts(
+    requests: &Requests,
+) -> (usize, mpsc::UnboundedReceiver<ThreadId>, CancellationToken) {
+    let mut requests = requests.lock().unwrap();
+    let index = requests
+        .iter()
+        .position(|request| matches!(request, PickerLoadRequest::MessageCounts { .. }))
+        .unwrap();
+    let PickerLoadRequest::MessageCounts {
+        request_token,
+        requests: receiver,
+        cancellation,
+    } = requests.remove(index)
+    else {
+        unreachable!()
+    };
+    (request_token, receiver, cancellation)
+}
+
+fn row(title: &str, timestamp: &str) -> Row {
+    let timestamp = parse_timestamp_str(timestamp).unwrap();
+    Row {
+        preview: title.into(),
+        thread_name: Some(title.into()),
+        created_at: Some(timestamp),
+        updated_at: Some(timestamp),
+        ..test_row(ThreadId::new())
+    }
+}
+
+async fn deliver(
+    state: &mut PickerState,
+    request: PageLoadRequest,
+    rows: Vec<Row>,
+    next: Option<&str>,
+) {
+    state
+        .handle_background_event(BackgroundEvent::Page {
+            request_token: request.request_token,
+            search_token: request.search_token,
+            page: Ok(PickerPage {
+                num_scanned_files: rows.len(),
+                rows,
+                history_modes: HashMap::new(),
+                next_cursor: next.map(|cursor| PageCursor::AppServer(cursor.into())),
+                reached_scan_cap: false,
+            }),
+        })
+        .await
+        .unwrap();
+}
+
+#[tokio::test]
+async fn messages_sort_is_opt_in_and_fork_keeps_its_native_time_choices() {
+    let (mut state, requests) = test_picker();
+    state.start_initial_load();
+    assert_eq!(take_page(&requests).sort_key, ThreadSortKey::UpdatedAt);
+    assert!(requests.lock().unwrap().is_empty());
+    assert_eq!(sort_key_label(&state.sort_key), "Updated");
