+    assert_eq!(take_page(&requests).sort_key, ThreadSortKey::CreatedAt);
+    assert!(requests.lock().unwrap().is_empty());
+    assert_eq!(sort_key_label(&state.sort_key), "Created");
+    state.toggle_sort_key();
+    assert_eq!(take_page(&requests).sort_key, ThreadSortKey::CreatedAt);
+    let (_, _counts, cancellation) = take_counts(&requests);
+    assert_eq!(sort_key_label(&state.sort_key), "Messages");
+    assert!(!cancellation.is_cancelled());
+    state.toggle_sort_key();
+    assert!(cancellation.is_cancelled());
+    assert_eq!(take_page(&requests).sort_key, ThreadSortKey::UpdatedAt);
+    assert_eq!(sort_key_label(&state.sort_key), "Updated");
+    state.action = SessionPickerAction::Fork;
+    for expected in [ThreadSortKey::CreatedAt, ThreadSortKey::UpdatedAt] {
+        state.toggle_sort_key();
+        assert_eq!(take_page(&requests).sort_key, expected);
+        assert!(requests.lock().unwrap().is_empty());
+        assert!(
+            !sort_control_spans(&state, false)
+                .iter()
+                .any(|span| span.content.contains("Messages"))
+        );
+    }
