+#[tokio::test]
+async fn index_rebuild_dry_run_reports_skipped_legacy_and_missing_indexes_without_writes() {
+    let home = TempDir::new().expect("create Codex home");
+    let paginated_id = ThreadId::new();
+    let paginated_path = write_rollout(
+        home.path(),
+        paginated_id,
+        SessionSource::Cli,
+        vec![user_message("indexed question")],
+    );
+    let store = indexed_store(home.path()).await;
+    store
+        .migrate_rollouts(apply_options())
+        .await
+        .expect("create existing paginated index");
+    let legacy_id = ThreadId::new();
+    let legacy_path = write_rollout(
+        home.path(),
+        legacy_id,
+        SessionSource::Cli,
+        vec![user_message("legacy question")],
+    );
+    let paginated_bytes = fs::read(&paginated_path).expect("read paginated rollout");
+    let legacy_bytes = fs::read(&legacy_path).expect("read legacy rollout");
+    let dry_store = LocalThreadStore::new(store.config.clone(), None);
+    let report = dry_store
+        .rebuild_rollout_index_with_progress(RolloutMigrationOptions::default(), |_| {})
+        .await
+        .expect("inspect indexes without a writable state DB");
+    assert_eq!(report.outcomes.len(), 2);
+    let inspection = report.index_rebuild.expect("index-rebuild inspection");
+    assert_eq!(inspection.non_paginated, 1);
+    assert_eq!(inspection.missing_indexes, 0);
+    assert_eq!(fs::read(&paginated_path).unwrap(), paginated_bytes);
+    assert_eq!(fs::read(&legacy_path).unwrap(), legacy_bytes);
+
+    let db_path = store.config.sqlite.thread_history_db_path();
+    store.thread_history_db().await.unwrap().close().await;
+    drop(store);
+    fs::remove_file(&db_path).expect("remove history database");
+    let report = dry_store
+        .rebuild_rollout_index_with_progress(RolloutMigrationOptions::default(), |_| {})
+        .await
+        .expect("inspect missing database without creating it");
+    let inspection = report.index_rebuild.expect("missing-index inspection");
+    assert_eq!(inspection.non_paginated, 1);
+    assert_eq!(inspection.missing_indexes, 1);
+    assert!(!db_path.exists());
+    assert_eq!(fs::read(&paginated_path).unwrap(), paginated_bytes);
+    assert_eq!(fs::read(&legacy_path).unwrap(), legacy_bytes);
+
+    let filtered = dry_store
+        .rebuild_rollout_index_with_progress(
+            RolloutMigrationOptions {
+                thread_ids: vec![paginated_id],
+                ..Default::default()
+            },
+            |_| {},
+        )
+        .await
+        .expect("inspect only the selected paginated rollout");
+    assert_eq!(filtered.outcomes.len(), 1);
+    let inspection = filtered.index_rebuild.unwrap();
+    assert_eq!(inspection.non_paginated, 0);
+    assert_eq!(inspection.missing_indexes, 1);
+}
