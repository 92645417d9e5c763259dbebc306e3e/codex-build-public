+use clap::CommandFactory;
+use clap::Parser;
+
+#[test]
+fn index_rebuild_is_a_distinct_command_with_the_migration_options() {
+    for name in ["migrate-rollouts", "rebuild-rollout-index"] {
+        let thread_id = codex_protocol::ThreadId::new().to_string();
+        let cli = crate::MultitoolCli::try_parse_from([
+            "codex",
+            name,
+            "--apply",
+            "--thread",
+            &thread_id,
+            "--max-mib-per-second",
+            "8",
+            "--json",
+            "--verbose",
+        ])
+        .expect("shared rollout command options");
+        let command = match cli.subcommand {
+            Some(crate::Subcommand::MigrateRollouts(command)) if name == "migrate-rollouts" => {
+                command
+            }
+            Some(crate::Subcommand::RebuildRolloutIndex(command))
+                if name == "rebuild-rollout-index" =>
+            {
+                command
+            }
+            _ => panic!("wrong rollout operation selected"),
+        };
+        assert!(command.apply);
+        assert_eq!(command.thread[0].to_string(), thread_id);
+        assert_eq!(command.max_mib_per_second, Some(8));
+        assert!(command.json && command.verbose);
+    }
+
+    let mut root = crate::MultitoolCli::command();
+    let rebuild = root
+        .find_subcommand_mut("rebuild-rollout-index")
+        .expect("discoverable index-rebuild command");
+    let help = rebuild.render_long_help().to_string();
+    assert!(help.contains("Forcibly rebuild SQLite indexes for existing paginated rollouts"));
+    assert!(help.contains("Without this flag, inspect local rollouts only"));
+}
