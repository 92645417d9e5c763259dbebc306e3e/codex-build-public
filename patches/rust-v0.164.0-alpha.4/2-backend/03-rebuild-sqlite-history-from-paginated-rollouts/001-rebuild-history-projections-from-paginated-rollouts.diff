+    ));
+    let mut lines = read_rollout(&path);
+    let RolloutItem::SessionMeta(metadata) = &mut lines[0].item else {
+        panic!("expected session metadata");
+    };
+    metadata.meta.session_id = rollout_id.into();
+    let mut replacement_bytes = Vec::new();
+    for line in lines {
+        serde_json::to_writer(&mut replacement_bytes, &line).expect("serialize replacement line");
+        replacement_bytes.push(b'\n');
+    }
+    fs::write(&replacement, &replacement_bytes).expect("write replacement rollout");
+    let state_db = store.state_db().await.expect("state database");
+    let mut metadata = state_db
+        .get_thread(thread_id)
+        .await
+        .expect("read metadata")
+        .expect("thread metadata");
+    metadata.rollout_path = replacement.clone();
+    state_db
+        .upsert_thread(&metadata)
+        .await
+        .expect("select replacement rollout");
+    thread_history::delete_thread(&store, thread_id)
+        .await
+        .expect("remove original projection");
+
+    let report = store
+        .rebuild_rollout_index_with_progress(apply_options(), |_| {})
+        .await
+        .expect("rebuild both immutable histories");
+    assert_eq!(report.outcomes.len(), 2);
+    assert!(
+        report
+            .outcomes
+            .iter()
+            .all(|outcome| outcome.status == RolloutMigrationStatus::Migrated)
+    );
+    for (id, bytes) in [
+        (thread_id, &original_bytes),
+        (rollout_id, &replacement_bytes),
+    ] {
+        assert_eq!(
+            thread_history::projection_state(&store, id)
+                .await
+                .expect("read projection")
+                .expect("independent projection")
+                .next_byte_offset,
+            bytes.len() as u64
+        );
+    }
+    assert_eq!(
+        state_db
+            .get_thread(thread_id)
+            .await
+            .expect("read selected metadata")
+            .expect("thread metadata")
+            .rollout_path,
+        replacement
+    );
+    assert_eq!(
+        fs::read(&path).expect("read unchanged original"),
+        original_bytes
+    );
+    assert_eq!(
+        fs::read(&replacement).expect("read unchanged replacement"),
+        replacement_bytes
+    );
+
+    fs::remove_file(&path).expect("remove unreferenced original fixture");
+    codex_rollout::append_thread_name(home.path(), thread_id, "logical name")
+        .await
+        .expect("record logical thread name");
+    thread_history::delete_thread(&store, rollout_id)
+        .await
+        .expect("remove replacement projection");
+    let compressed = compress_rollout(&replacement);
+    let compressed_bytes = fs::read(&compressed).expect("read compressed replacement");
+    let report = store
+        .rebuild_rollout_index_with_progress(apply_options(), |_| {})
+        .await
+        .expect("rebuild compressed replacement");
+    assert_eq!(report.outcomes[0].status, RolloutMigrationStatus::Migrated);
+    assert!(report.outcomes[0].bytes_processed > 0);
+    assert!(!replacement.exists());
+    assert_eq!(
+        fs::read(&compressed).expect("read unchanged compressed replacement"),
+        compressed_bytes
+    );
+    assert_eq!(
+        codex_rollout::find_thread_name_by_id(home.path(), &thread_id)
+            .await
+            .expect("read logical name")
+            .as_deref(),
+        Some("logical name")
+    );
+    assert_eq!(
+        list_active_summary_turns(&store, thread_id)
+            .await
+            .turns
+            .len(),
+        1
+    );
+    let second = store
+        .rebuild_rollout_index_with_progress(apply_options(), |_| {})
+        .await
+        .expect("repeat compressed rebuild");
+    assert_eq!(second.outcomes[0].status, RolloutMigrationStatus::Migrated);
+    assert!(second.outcomes[0].bytes_processed > 0);
+}
