+#[test_case::test_case(true; "response_identity")]
+#[test_case::test_case(false; "cumulative_checkpoint")]
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn complete_output_persists_incomplete_spending_without_installing_output(
+    has_response_id: bool,
+) -> anyhow::Result<()> {
+    skip_if_no_network!(Ok(()));
+    let completed_usage = TokenUsage {
+        input_tokens: 120,
+        cached_input_tokens: 80,
+        cache_write_input_tokens: 0,
+        output_tokens: 30,
+        reasoning_output_tokens: 10,
+        total_tokens: 150,
+        codex_rollout_budget_units: None,
+    };
+    let incomplete_usage = TokenUsage {
+        input_tokens: 20,
+        cached_input_tokens: 10,
+        cache_write_input_tokens: 0,
+        output_tokens: 5,
+        reasoning_output_tokens: 3,
+        total_tokens: 25,
+        codex_rollout_budget_units: None,
+    };
+    let mut completed = ev_completed("accepted-response");
+    completed["response"]["usage"] = json!({
+        "input_tokens": 120, "input_tokens_details": {"cached_tokens": 80},
+        "output_tokens": 30, "output_tokens_details": {"reasoning_tokens": 10},
+        "total_tokens": 150
+    });
+    let mut incomplete = json!({"type": "response.incomplete", "response": {
+        "incomplete_details": {"reason": "max_output_tokens"},
+        "usage": {
+            "input_tokens": 20, "input_tokens_details": {"cached_tokens": 10},
+            "output_tokens": 5, "output_tokens_details": {"reasoning_tokens": 3},
+            "total_tokens": 25
+        }
+    }});
+    if has_response_id {
+        incomplete["response"]["id"] = json!("discarded-response");
+    }
+    let server = start_websocket_server(vec![vec![
+        vec![ev_response_created("prewarm"), ev_completed("prewarm")],
+        vec![
+            ev_response_created("accepted-response"),
+            ev_assistant_message("accepted-message", "accepted answer"),
+            completed,
+        ],
+        vec![
+            ev_response_created("discarded-response"),
+            ev_output_text_delta("discarded partial answer"),
+            ev_assistant_message("discarded-message", "discarded partial answer"),
+            incomplete,
+        ],
+    ]])
+    .await;
+    let test = test_codex()
+        .with_auth(CodexAuth::from_external_chatgpt_tokens(
+            "header.e30.signature",
+            "selected-account",
+            Some("plus"),
+        )?)
+        .with_config(|config| {
+            config.model_provider.request_max_retries = Some(0);
+            config.model_provider.stream_max_retries = Some(2);
+        })
+        .build_with_websocket_server(&server)
+        .await?;
+    test.submit_text_turn("first").await?;
+    let before = test.codex.token_usage_info().await.unwrap();
+    assert_eq!(before.total_token_usage, completed_usage);
+    assert_eq!(before.last_token_usage, completed_usage);
+    test.codex
+        .start_or_steer_turn(TurnInputRequest::user_input(vec![UserInput::Text {
+            text: "next".into(),
+            text_elements: Vec::new(),
+        }]))
+        .await?;
+    let mut events = Vec::new();
+    wait_for_event(&test.codex, |event| {
+        events.push(event.clone());
+        matches!(event, EventMsg::TurnComplete(_))
+    })
+    .await;
+    let errors = events
+        .iter()
+        .filter_map(|event| match event {
+            EventMsg::Error(error) => Some(error.message.as_str()),
+            EventMsg::StreamError(_) | EventMsg::RawResponseCompleted(_) => {
+                panic!("incomplete response must retain its original terminal: {event:?}");
+            }
+            _ => None,
+        })
+        .collect::<Vec<_>>();
+    assert_eq!(
+        errors,
+        vec!["Incomplete response returned, reason: max_output_tokens"]
+    );
+    assert!(!serde_json::to_string(&events)?.contains("discarded partial answer"));
+    let mut total_usage = completed_usage.clone();
+    total_usage.add_assign(&incomplete_usage);
+    let after = test.codex.token_usage_info().await.unwrap();
+    assert_eq!(after.total_token_usage, total_usage);
+    assert_eq!(after.last_token_usage, completed_usage);
+    test.codex.flush_rollout().await?;
+    let persisted = std::fs::read_to_string(test.codex.rollout_path().expect("rollout path"))?;
+    let lines = persisted
+        .lines()
+        .map(codex_rollout::parse_rollout_line)
+        .collect::<serde_json::Result<Vec<_>>>()?;
+    assert!(persisted.contains("accepted answer"));
+    assert!(!persisted.contains("discarded partial answer"));
+    let records = lines
+        .iter()
+        .filter_map(|line| match &line.item {
+            RolloutItem::TokenUsageRecord(record) => Some(record),
+            _ => None,
+        })
+        .collect::<Vec<_>>();
+    assert_eq!(records.len(), if has_response_id { 2 } else { 1 });
+    assert_eq!(records[0].response_id, "accepted-response");
+    assert_eq!(records[0].usage, completed_usage);
+    if has_response_id {
+        assert_eq!(records[1].response_id, "discarded-response");
+        assert_eq!(records[1].usage, incomplete_usage);
+        assert_eq!(records[1].thread_id, records[0].thread_id);
+    }
+    let checkpoint = lines
+        .iter()
+        .rev()
+        .find_map(|line| match &line.item {
+            RolloutItem::EventMsg(EventMsg::TokenCount(event)) => event.info.as_ref(),
+            _ => None,
+        })
+        .expect("durable accounting checkpoint after incomplete response");
+    assert_eq!(checkpoint.total_token_usage, total_usage);
+    assert_eq!(checkpoint.last_token_usage, completed_usage);
+    assert_eq!(server.single_connection().len(), 3);
+    test.codex.shutdown_and_wait().await?;
+    server.shutdown().await;
+    Ok(())
+}
