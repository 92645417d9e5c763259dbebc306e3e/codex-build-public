+}
+
+#[derive(Default)]
+struct Observations(Mutex<Vec<ResponseObservation>>);
+
+impl ResponseObserver for Observations {
+    fn prepared(&self, _: u64) {}
+    fn sent(&self, _: Instant) {}
+    fn received(&self, observation: ResponseObservation, _: Instant) {
+        self.0.lock().unwrap().push(observation);
+    }
+    fn ended(&self, reason: ResponseAttemptEnd, at: Instant) {
+        self.received(
+            ResponseObservation {
+                terminal: Some(reason),
+                ..Default::default()
+            },
+            at,
+        );
+    }
+}
