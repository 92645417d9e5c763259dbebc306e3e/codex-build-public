+    skip_if_no_network!();
+    let mut events = vec![ev_response_created("r1")];
+    match ending {
+        "timeout" => events.push(json!({"type": "codex.response.metadata"})),
+        _ => events.extend([
+            ev_output_text_delta("Native output"),
+            ev_assistant_message("message", "Native output"),
+        ]),
+    }
+    let usage = json!({"input_tokens": 100, "input_tokens_details": {"cached_tokens": 80},
+        "output_tokens": 12, "output_tokens_details": {"reasoning_tokens": 5}, "total_tokens": 112});
+    match ending {
+        "completed" => events.push(ev_completed("r1")),
+        "interrupted" | "incomplete" => {
+            let mut terminal = ev_completed("r1");
+            terminal["type"] = json!("response.incomplete");
+            terminal["response"]["incomplete_details"] = json!({"reason":
+                if ending == "interrupted" { "interrupted" } else { "max_output_tokens" }
+            });
+            terminal["response"]["usage"] = usage.clone();
+            events.push(terminal);
+        }
+        "failed" => events.push(json!({"type": "response.failed", "response": {
+            "id": "r1", "usage": usage, "error": {"code": "failure", "message": "failed"}
+        }})),
+        "error" => events.push(json!({"type": "error", "status": 429,
+            "error": {"code": "rate_limit_exceeded", "message": "Try later"}})),
+        "closed" | "timeout" => {}
+        _ => unreachable!(),
+    }
+    let server = start_websocket_server_with_headers(vec![WebSocketConnectionConfig {
+        requests: vec![events],
+        response_headers: Vec::new(),
+        accept_delay: None,
+        close_after_requests: ending != "timeout",
+    }])
+    .await;
+    let provider = websocket_provider(&server).to_api_provider(None).unwrap();
+    let client = ResponsesWebsocketClient::new(provider, Arc::new(NoAuth));
+    let connection = client
+        .connect(
+            &HttpClientFactory::new(OutboundProxyPolicy::ReqwestDefault),
+            HeaderMap::new(),
+            HeaderMap::new(),
+            None,
+            None,
+        )
+        .await
+        .unwrap();
+    let request = ResponsesApiRequest {
+        model: MODEL.into(),
+        input: vec![message_item("hello")],
+        tools: None,
+        tool_choice: "auto".into(),
+        parallel_tool_calls: true,
+        reasoning: None,
+        store: false,
+        stream: true,
+        stream_options: None,
+        include: Vec::new(),
+        service_tier: None,
+        prompt_cache_key: None,
+        text: None,
+        client_metadata: None,
+        access_programs: None,
+    };
+    let observations = Arc::new(Observations::default());
+    let observer = observe.then(|| observations.clone() as Arc<dyn ResponseObserver>);
+    let mut stream = connection
+        .stream_complete_response(
+            ResponsesWsRequest::ResponseCreate(ResponseCreateWsRequest::from(&request)),
+            false,
+            None,
+            observer,
+        )
+        .await
+        .unwrap();
+    let mut output = Vec::new();
+    let mut did_complete = false;
+    let mut interrupted = false;
+    let mut failed = false;
+    while let Some(event) = stream.next().await {
+        match event {
+            Ok(ResponseEvent::Created { .. }) if ending == "timeout" => {
+                tokio::time::pause();
+                tokio::time::advance(Duration::from_secs(301)).await;
+            }
+            Ok(ResponseEvent::OutputTextDelta(text)) => output.push(text),
+            Ok(ResponseEvent::Completed { .. }) => did_complete = true,
+            Ok(ResponseEvent::Interrupted {
+                response_id,
+                token_usage,
+                ..
+            }) => {
+                assert_eq!(response_id, "r1");
+                assert_eq!(token_usage.unwrap().output_tokens, 12);
+                interrupted = true;
+            }
+            Err(error) => {
+                failed = true;
+                if ending == "timeout" {
+                    assert!(matches!(
+                        error,
+                        codex_api::ApiError::ResponseProgressTimeout
+                    ));
+                } else if ending == "incomplete" {
+                    let codex_api::ApiError::ResponseIncomplete(incomplete) = error else {
+                        panic!("expected the original incomplete response error");
+                    };
+                    assert_eq!(incomplete.reason, "max_output_tokens");
+                    assert_eq!(incomplete.response_id.as_deref(), Some("r1"));
+                    assert_eq!(incomplete.token_usage.unwrap().output_tokens, 12);
+                }
+            }
+            _ => {}
+        }
+    }
+    assert_eq!(did_complete, ending == "completed");
+    assert_eq!(interrupted, ending == "interrupted");
+    assert_eq!(
+        failed,
+        matches!(
+            ending,
+            "closed" | "failed" | "incomplete" | "error" | "timeout"
+        )
+    );
+    assert_eq!(
+        output,
+        if did_complete {
+            vec!["Native output".to_owned()]
+        } else {
+            Vec::new()
+        }
+    );
+    if observe {
+        let records = observations.0.lock().unwrap();
+        assert!(records.iter().any(|row| row.terminal
+            == Some(if ending == "timeout" {
+                ResponseAttemptEnd::ProgressTimeout
+            } else if ending == "incomplete" {
+                ResponseAttemptEnd::Incomplete
+            } else {
+                ResponseAttemptEnd::Failed
+            })));
+        assert!(
+            !records
+                .iter()
+                .any(|row| row.terminal == Some(ResponseAttemptEnd::TransportClosed))
+        );
+        if matches!(ending, "failed" | "incomplete") {
+            assert!(records.iter().any(|row| row.usage.as_ref() == Some(&usage)));
+        }
+    }
+    server.shutdown().await;
+}
