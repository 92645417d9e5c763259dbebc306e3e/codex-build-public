+            .collect::<Vec<_>>();
+        assert!(details.iter().any(|(_, text)| text.as_ref() == "gpt-5.4"));
+        assert!(
+            details
+                .iter()
+                .any(|(_, text)| text.as_ref() == "unknown model")
+        );
+        assert!(details.iter().any(|(_, text)| text.as_ref() == "1234567"));
+        assert!(
+            details
+                .iter()
+                .all(|(_, text)| !text.contains("2026-") && text.as_ref() != "Efficiency")
+        );
+        for (rect, _) in cells
+            .iter()
+            .filter(|(rect, _)| rect.y == 5 && rect.x < right)
+        {
+            for x in rect.x..rect.right() {
+                assert!(buffer[(x, rect.y)].modifier.contains(Modifier::ITALIC));
+            }
+        }
+        let token = cells
+            .iter()
+            .find(|(_, text)| text.as_ref() == "1234567")
+            .unwrap()
+            .0;
+        let clipped = Rect::new(3, 2, 5, 12);
+        let mut buffer = Buffer::empty(Rect::new(0, 0, 12, 16));
+        tables.render_scrolled(clipped, &mut buffer, 0, token.x);
+        let copied = tables.copyable_cells(clipped, 0, token.x);
+        assert!(copied.iter().any(|(_, text)| text.as_ref() == "1234567"));
+        assert!(
+            copied
+                .iter()
+                .all(|(rect, _)| rect.intersection(clipped) == *rect)
+        );
+        let scroll = tables.periods[0].desired_height(200) + 1;
+        let visible = Rect::new(0, 0, tables.desired_width(), 12);
+        let mut buffer = Buffer::empty(visible);
+        tables.render_scrolled(visible, &mut buffer, scroll, 0);
+        assert!(
+            tables
+                .copyable_cells(visible, scroll, 0)
+                .iter()
+                .any(|(rect, text)| { rect.x >= right && text.as_ref() == "1234567" })
+        );
+        let (weekly, row) = render(&report, 1, 200, &Palette::current());
+        assert_eq!(row, Some(13));
+        let cells = weekly.copyable_cells(area, 0, 0);
+        assert!(
+            cells
+                .iter()
+                .any(|(_, text)| text.as_ref() == "weekly-model")
+        );
+        assert!(!cells.iter().any(|(_, text)| text.as_ref() == "1234567"));
+        assert_eq!(report, original);
+
+        for (details, expected) in [
+            (None, "Period usage unavailable"),
+            (Some(UsageByModel::new()), "No usage in this period"),
+        ] {
+            report.quota[1].model_usage = details;
+            let (tables, _) = render(&report, 1, 200, &Palette::current());
+            let cells = tables.copyable_cells(area, 0, 0);
+            assert!(cells.iter().any(|(_, text)| text.as_ref() == expected));
+        }
+    }
+}
