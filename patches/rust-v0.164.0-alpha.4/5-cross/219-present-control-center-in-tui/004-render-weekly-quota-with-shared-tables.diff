+pub(super) fn render(
+    report: &UsageReport,
+    selected: usize,
+    width: u16,
+    palette: &Palette,
+) -> (QuotaTables, Option<usize>) {
+    let weekly = descending_rows(&report.quota, |estimate| {
+        DateTime::parse_from_rfc3339(&estimate.started_at).expect("validated quota timestamp")
+    });
+    let credits = descending_rows(&report.credits, |period| {
+        DateTime::parse_from_rfc3339(&period.started_at).expect("validated credit timestamp")
+    });
+    let timezone = *report.refreshed_at.offset();
+    let credit_table = render_credits(&credits, selected, timezone, width, palette);
+    let weekly_table = render_weekly(
+        &weekly,
+        selected.checked_sub(credits.len()),
+        timezone,
+        width,
+        palette,
+    );
+    let left_width = credit_table
+        .desired_width()
+        .max(weekly_table.desired_width());
+    let selected = credits
+        .get(selected)
+        .map(|period| {
+            (
+                credit_table.row_offset(selected + 2),
+                period.model_usage.as_ref(),
+            )
+        })
+        .or_else(|| {
+            let index = selected.checked_sub(credits.len())?;
+            weekly.get(index).map(|period| {
+                (
+                    usize::from(credit_table.desired_height(width))
+                        + 1
+                        + weekly_table.row_offset(index + 2),
+                    period.model_usage.as_ref(),
+                )
+            })
+        });
+    let selected_row = selected.map(|(row, _)| row);
+    let detail = match selected {
+        Some((_, Some(models))) if !models.is_empty() => usage_table(
+            report,
+            None,
+            models,
+            width.saturating_sub(left_width.saturating_add(3)),
+            palette,
+        ),
+        other => {
+            let message = match other {
+                Some((_, Some(_))) => "No usage in this period",
+                Some((_, None)) => "Period usage unavailable",
+                None => "No period selected",
+            };
+            let mut cell = Cell::text(message);
+            cell.style = cell.style.dim();
+            table::render(&[message.len()], &[vec![cell]], palette)
+        }
+    };
+    (
+        QuotaTables {
+            periods: [credit_table, weekly_table],
+            detail,
+        },
+        selected_row,
+    )
+}
+
+fn render_weekly(
+    estimates: &[&Estimate],
+    selected: Option<usize>,
+    timezone: FixedOffset,
+    width: u16,
+    palette: &Palette,
+) -> Table {
+    let mut rows: Vec<_> = estimates
+        .iter()
+        .enumerate()
+        .map(|(index, estimate)| {
+            let started = DateTime::parse_from_rfc3339(&estimate.started_at)
+                .expect("validated quota timestamp");
+            let ended = DateTime::parse_from_rfc3339(&estimate.ended_at)
+                .expect("validated quota timestamp");
+            let mut row = vec![
+                Cell::text(if selected == Some(index) { ">" } else { "" }),
+                Cell::number(local_date(started, timezone)),
+                Cell::number(local_date(ended, timezone)),
+                Cell::number(duration((ended - started).num_seconds())),
+                Cell::value(
+                    Some(estimate.used_percent_end),
+                    number(estimate.used_percent_end, 1, "", "%"),
+                ),
+                cost_cell(estimate.observed_cost_usd, true),
+                cost_cell(estimate.estimated_weekly_cost_usd, true),
+                Cell::text(status_label(estimate.status)),
+                Cell::value(
+                    Some(estimate.sample_count as f64),
+                    count(estimate.sample_count as u64),
+                ),
+            ];
+            if selected == Some(index) {
+                for cell in &mut row {
+                    cell.style = cell.style.italic();
+                }
+            }
+            row
+        })
+        .collect();
+    if rows.is_empty() {
+        rows.push(vec![
+            Cell::text("No historical quota estimate available").spanning(1, 9),
+        ]);
+    }
+    numeric_table(
+        vec![
+            vec![
+                palette.header("").spanning(2, 1),
+                palette.header("Weekly quotas"),
+                palette.header("").spanning(1, 7),
+            ],
+            [
+                "Started",
+                "Ended",
+                "Duration",
+                "Used",
+                "Observed",
+                "Estimated",
+                "Status",
+                "Records",
+            ]
+            .into_iter()
+            .map(|label| palette.header(label))
+            .collect(),
+        ],
+        &[
+            Column::new("", 2, 2),
+            date_column("Started"),
+            date_column("Ended"),
+            Column::new("Duration", duration(0).len(), 12),
+            Column::new("Used", "100.0%".len(), 7),
+            Column::new("Observed", "$0.00".len(), 12),
+            Column::new("Estimated", "$0.00".len(), 12),
+            Column::new(
+                "Status",
+                [Status::Completed, Status::Provisional]
+                    .into_iter()
+                    .map(status_label)
+                    .map(str::len)
+                    .max()
+                    .expect("quota statuses"),
+                11,
+            ),
+            Column::new("Records", "0.00K".len(), 7),
+        ],
+        rows,
+        None,
+        width,
+        palette,
+    )
+}
