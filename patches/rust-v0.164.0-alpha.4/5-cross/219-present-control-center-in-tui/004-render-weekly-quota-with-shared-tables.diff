+fn render_credits(
+    credits: &[&UsageCreditPeriod],
+    selected: usize,
+    timezone: FixedOffset,
+    width: u16,
+    palette: &Palette,
+) -> Table {
+    let mut rows: Vec<_> = credits
+        .iter()
+        .enumerate()
+        .map(|(index, period)| {
+            let started = DateTime::parse_from_rfc3339(&period.started_at)
+                .expect("validated credit timestamp");
+            let ended =
+                DateTime::parse_from_rfc3339(&period.ended_at).expect("validated credit timestamp");
+            let mut row = vec![
+                Cell::text(if selected == index { ">" } else { "" }),
+                Cell::number(local_date(started, timezone)),
+                Cell::number(local_date(ended, timezone)),
+                Cell::number(duration((ended - started).num_seconds())),
+                Cell::value(
+                    Some(period.used_credits),
+                    format!("{:.2}", period.used_credits),
+                ),
+                cost_cell(period.observed_cost_usd, true),
+                Cell::value(
+                    Some(period.sample_count as f64),
+                    count(period.sample_count as u64),
+                ),
+            ];
+            if selected == index {
+                for cell in &mut row {
+                    cell.style = cell.style.italic();
+                }
+            }
+            row
+        })
+        .collect();
+    if rows.is_empty() {
+        rows.push(vec![
+            Cell::text("No historical credit deductions available").spanning(1, 7),
+        ]);
+    }
+    numeric_table(
+        vec![
+            vec![
+                palette.header("").spanning(2, 1),
+                palette.header("Credits"),
+                palette.header("").spanning(1, 5),
+            ],
+            [
+                "Started", "Ended", "Duration", "Used", "Observed", "Records",
+            ]
+            .into_iter()
+            .map(|label| palette.header(label))
+            .collect(),
+        ],
+        &[
+            Column::new("", 2, 2),
+            date_column("Started"),
+            date_column("Ended"),
+            Column::new("Duration", duration(0).len(), 12),
+            Column::new("Used", "0.00".len(), 9),
+            Column::new("Observed", "$0.00".len(), 12),
+            Column::new("Records", "0.00K".len(), 7),
+        ],
+        rows,
+        None,
+        width,
+        palette,
+    )
+}
