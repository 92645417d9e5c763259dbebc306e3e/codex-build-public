+/// The selected detail stays beside the visible period list while that list scrolls.
+pub(super) struct QuotaTables {
+    periods: [Table; 2],
+    detail: Table,
+}
+
+impl QuotaTables {
+    fn left_width(&self) -> u16 {
+        self.periods
+            .iter()
+            .map(Renderable::desired_width)
+            .max()
+            .unwrap()
+    }
+
+    fn visible_tables(
+        &self,
+        area: Rect,
+        scroll: u16,
+        horizontal: u16,
+    ) -> impl Iterator<Item = (&Table, Rect, u16, u16)> {
+        let viewport = Rect::new(
+            horizontal,
+            scroll,
+            area.width,
+            area.height
+                .min(self.desired_height(area.width).saturating_sub(scroll)),
+        );
+        [
+            (&self.periods[0], 0, 0),
+            (
+                &self.periods[1],
+                0,
+                self.periods[0].desired_height(area.width).saturating_add(1),
+            ),
+            (&self.detail, self.left_width().saturating_add(3), scroll),
+        ]
+        .into_iter()
+        .filter_map(move |(table, x, y)| {
+            let source = Rect::new(
+                x,
+                y,
+                table.desired_width(),
+                table.desired_height(area.width),
+            );
+            let visible = source.intersection(viewport);
+            (!visible.is_empty()).then(|| {
+                (
+                    table,
+                    Rect::new(
+                        area.x + (visible.x - horizontal),
+                        area.y + (visible.y - scroll),
+                        visible.width,
+                        visible.height,
+                    ),
+                    visible.y - y,
+                    visible.x - x,
+                )
+            })
+        })
+    }
+}
+
+impl Renderable for QuotaTables {
+    fn desired_width(&self) -> u16 {
+        self.left_width()
+            .saturating_add(3)
+            .saturating_add(self.detail.desired_width())
+    }
+
+    fn desired_height(&self, width: u16) -> u16 {
+        self.periods[0]
+            .desired_height(width)
+            .saturating_add(1)
+            .saturating_add(self.periods[1].desired_height(width))
+            .max(self.detail.desired_height(width))
+    }
+
+    fn render(&self, area: Rect, buffer: &mut Buffer) {
+        self.render_scrolled(area, buffer, 0, 0);
+    }
+
+    fn render_scrolled(
+        &self,
+        area: Rect,
+        buffer: &mut Buffer,
+        scroll: u16,
+        horizontal: u16,
+    ) -> bool {
+        for (table, visible, top, left) in self.visible_tables(area, scroll, horizontal) {
+            table.render_scrolled(visible, buffer, top, left);
+        }
+        true
+    }
+
+    fn copyable_cells(&self, area: Rect, scroll: u16, horizontal: u16) -> Vec<(Rect, Arc<str>)> {
+        self.visible_tables(area, scroll, horizontal)
+            .flat_map(|(table, visible, top, left)| table.copyable_cells(visible, top, left))
+            .collect()
+    }
+}
+
+fn duration(seconds: i64) -> String {
+    format!(
+        "{}d {:02}:{:02}:{:02}",
+        seconds / 86_400,
+        seconds / 3_600 % 24,
+        seconds / 60 % 60,
+        seconds % 60,
+    )
+}
+
+fn local_date(value: DateTime<FixedOffset>, timezone: FixedOffset) -> String {
+    value
+        .with_timezone(&timezone)
+        .format(DATE_FORMAT)
+        .to_string()
+}
+
+fn date_column(label: &str) -> Column {
+    let width = "0000-00-00 00:00".len();
+    Column::new(label, width, width)
+}
+
+fn status_label(status: Status) -> &'static str {
+    match status {
+        Status::Completed => "Completed",
+        Status::Provisional => "Provisional",
+    }
+}
