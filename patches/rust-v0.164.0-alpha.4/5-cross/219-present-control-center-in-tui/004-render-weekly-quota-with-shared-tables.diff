+    fn render_periods(report: &UsageReport, width: u16) -> Vec<ratatui::text::Line<'static>> {
+        let (tables, _) = render(report, 0, width, &Palette::current());
+        let width = tables.left_width();
+        let [credits, weekly] = tables.periods;
+        render_lines(
+            vec![
+                credits.into(),
+                ratatui::text::Line::default().into(),
+                weekly.into(),
+            ],
+            width,
+        )
+    }
+
+    #[test]
+    fn quota_cycles_keep_time_order_and_ranked_theme_colors_with_group_headers() {
+        let report = report();
+        let palette = Palette::current();
+        let lines = render_periods(&report, 110);
+        assert!(lines.iter().all(|line| line.width() <= 118));
+        assert!(lines.iter().any(|line| line.width() == 118));
+        let text = lines.iter().join("\n");
+        assert!(!text.contains("Average"));
+        assert!(!text.contains("last 90 days"));
+        assert!(text.contains("2026-09-30 00:30"));
+        assert!(lines[0].to_string().starts_with('┌'));
+        assert!(text.contains("Duration"));
+        assert!(text.contains("Status") && text.contains("Records"));
+        assert!(text.contains("Completed") && text.contains("Provisional"));
+        let rows = lines
+            .iter()
+            .filter(|line| {
+                let text = line.to_string();
+                text.starts_with('│') && text.contains('%')
+            })
+            .collect::<Vec<_>>();
+        assert_eq!(rows.len(), 3);
+        assert!(rows[0].to_string().contains("60.0%"));
+        assert!(rows[1].to_string().contains("100.0%"));
+        assert!(rows[2].to_string().contains("20.0%"));
+        for (row, expected) in rows
+            .iter()
+            .zip(["0d 16:30:00", "6d 00:00:00", "1d 00:00:00"])
+        {
+            assert_eq!(row.to_string().split('│').nth(4).unwrap().trim(), expected);
+        }
+        for (index, (row, expected)) in rows
+            .iter()
+            .zip([
+                [("60.0%", 8), ("$360.00", 8), ("$600.00", 16)],
+                [("100.0%", 16), ("$450.00", 16), ("$500.00", 1)],
+                [("20.0%", 1), ("$100.00", 1), ("$500.00", 1)],
+            ])
+            .enumerate()
+        {
+            for (value, level) in expected {
+                let actual = row
+                    .spans
+                    .iter()
+                    .find(|span| span.content.contains(value))
+                    .unwrap()
+                    .style;
+                let expected = if index == 0 {
+                    palette.intensity(level).italic()
+                } else {
+                    palette.intensity(level)
+                };
+                assert_eq!(
+                    actual.fg.unwrap_or_default(),
+                    expected.fg.unwrap_or_default()
+                );
+                assert_eq!(actual.add_modifier, expected.add_modifier);
+            }
+        }
+        insta::assert_snapshot!("usage_quota", text);
+    }
+
+    #[test]
