+        let lines = render_periods(&report, 120);
+        let text = lines.iter().join("\n");
+        assert!(text.find("Credits").unwrap() < text.find("Weekly").unwrap());
+        for label in ["Weekly quotas", "Credits"] {
+            let group = text.lines().find(|line| line.contains(label)).unwrap();
+            let cells = group.split('│').collect::<Vec<_>>();
+            assert_eq!(cells.len(), 5);
+            assert_eq!(cells[1].trim(), "");
+            assert_eq!(cells[2].trim(), label);
+            assert_eq!(cells[3].trim(), "");
+            let headers = text.lines().find(|line| line.contains("Started")).unwrap();
+            assert_eq!(
+                cells[2].chars().count(),
+                headers.split('│').nth(2).unwrap().chars().count()
+            );
+        }
+        let credits = text
+            .split_once("Credits")
+            .unwrap()
+            .1
+            .split_once("Weekly")
