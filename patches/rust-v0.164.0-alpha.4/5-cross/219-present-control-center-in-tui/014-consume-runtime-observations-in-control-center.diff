+use super::*;
+use itertools::Itertools;
+use pretty_assertions::assert_eq;
+
+#[tokio::test]
+async fn github_status_refreshes_independently_and_rejects_stale_results() -> crate::app::Result<()>
+{
+    use codex_app_server_protocol::GithubRelease;
+    use codex_app_server_protocol::GithubStatus;
+    use codex_app_server_protocol::JSONRPCMessage;
+    use futures::SinkExt;
+    use futures::StreamExt;
+    use tokio_tungstenite::tungstenite::Message;
+
+    let (mut app, mut events, _ops) = crate::app::tests::make_test_app_with_channels().await;
+    let listener = tokio::net::TcpListener::bind("127.0.0.1:0").await?;
+    let url = format!("ws://{}", listener.local_addr()?);
+    let home = app.config.codex_home.display().to_string();
+    let (read_tx, mut read_rx) = tokio::sync::mpsc::unbounded_channel();
+    let (release_old, hold_old) = tokio::sync::oneshot::channel();
+    let server: tokio::task::JoinHandle<crate::app::Result<()>> = tokio::spawn(async move {
+        let (stream, _) = listener.accept().await?;
+        let mut socket = tokio_tungstenite::accept_async(stream).await?;
+        let mut reads = 0;
+        let mut hold_old = Some(hold_old);
+        while let Some(Ok(Message::Text(text))) = socket.next().await {
+            let JSONRPCMessage::Request(request) = serde_json::from_str(&text)? else {
+                continue;
+            };
+            let response = match request.method.as_str() {
+                "initialize" => serde_json::json!({
+                    "id": request.id, "result": {"userAgent": "test", "codexHome": home}
+                }),
+                "github/read" => {
+                    assert!(request.params.is_none());
+                    reads += 1;
+                    read_tx.send(reads).unwrap();
+                    if reads == 4 {
+                        hold_old.take().unwrap().await?;
+                    }
+                    if reads == 2 {
+                        serde_json::json!({"id": request.id, "error": {
+                            "code": -32600, "message": "Status unavailable"
+                        }})
+                    } else {
+                        let status = match reads {
+                            1 | 4 => Some(GithubStatus {
+                                latest_release: Some(GithubRelease {
+                                    version: if reads == 1 { "0.163.0" } else { "stale" }.into(),
+                                    url: "https://github.com/openai/codex/releases/tag/rust-v0.163.0".into(),
+                                }),
+                                latest_prerelease: Some(GithubRelease {
+                                    version: "0.164.0-alpha.3".into(),
+                                    url: "https://github.com/openai/codex/releases/tag/rust-v0.164.0-alpha.3".into(),
+                                }),
+                                checked_at: 1_792_346_400,
+                                remaining: Some(4999),
+                            }),
+                            3 => None,
+                            5 => Some(GithubStatus {
+                                latest_release: None,
+                                latest_prerelease: None,
+                                checked_at: 1_792_346_400,
+                                remaining: Some(0),
+                            }),
+                            _ => panic!("unexpected status read {reads}"),
+                        };
+                        serde_json::json!({"id": request.id, "result": GithubReadResponse {
+                            configured: true, status
+                        }})
+                    }
+                }
+                method => panic!(
+                    "local status polling must not request network checks, Telegram, usage or response data: {method}"
+                ),
+            };
+            socket
+                .send(Message::Text(response.to_string().into()))
+                .await?;
+        }
+        assert_eq!(reads, 5);
+        Ok(())
+    });
+    let client = crate::connect_remote_app_server(crate::RemoteAppServerEndpoint::WebSocket {
+        websocket_url: url,
+        auth_token: None,
+    })
+    .await?;
+    let mut session = AppServerSession::new(
+        crate::backend_id::BackendId::new(),
+        client,
+        crate::app_server_session::ThreadParamsMode::Remote,
+    );
+    let mut tui = crate::tui::test_support::make_test_tui()?;
+    app.open_control_center(&mut tui);
+    let blank = app.control_center_details().iter().join("\n");
+    for label in ["Release", "Pre-release", "Last checked", "Remaining points"] {
+        assert!(
+            blank.lines().any(|line| line == format!("{label}: ")),
+            "{blank}"
+        );
+    }
+    app.refresh_control_center_details(&session, &TuiEvent::Draw);
+    let Some(Overlay::ControlCenter(view)) = &app.overlay else {
+        unreachable!()
+    };
+    let first_request = view.github_request.unwrap();
+    app.refresh_control_center_details(&session, &TuiEvent::Draw);
+    assert!(
+        matches!(&app.overlay, Some(Overlay::ControlCenter(view)) if view.github_request == Some(first_request))
+    );
+    consume_github_result(&mut app, &mut tui, &mut session, &mut events).await?;
+    let text = app.control_center_details().iter().join("\n");
+    assert!(
+        !text.contains("Telegram") && !text.contains("Sent messages"),
+        "{text}"
+    );
+    assert!(text.contains("Release: 0.163.0"), "{text}");
+    assert!(text.contains("Pre-release: 0.164.0-alpha.3"), "{text}");
+    assert!(text.contains("Remaining points: 4999"), "{text}");
+    assert!(
+        text.lines()
+            .any(|line| line.starts_with("Last checked: ") && line.len() > "Last checked: ".len())
+    );
+    for (before, after) in [
+        ("Storage free\n", "GitHub\n"),
+        ("GitHub\n", "Proxy\n"),
+        ("Proxy\n", "Miscellaneous\n"),
+    ] {
+        assert!(text.find(before).unwrap() < text.find(after).unwrap());
+    }
+    app.refresh_control_center_github(&session);
+    assert!(
+        matches!(&app.overlay, Some(Overlay::ControlCenter(view)) if view.github_request.is_none())
+    );
+
+    for _ in 0..2 {
+        let Some(Overlay::ControlCenter(view)) = &mut app.overlay else {
+            unreachable!()
+        };
+        view.github_read_at = Some(Instant::now() - Duration::from_secs(2));
+        app.refresh_control_center_github(&session);
+        consume_github_result(&mut app, &mut tui, &mut session, &mut events).await?;
+        assert!(
+            matches!(&app.overlay, Some(Overlay::ControlCenter(view)) if view.github.is_none())
+        );
+    }
+
+    let Some(Overlay::ControlCenter(view)) = &mut app.overlay else {
+        unreachable!()
+    };
+    view.github_read_at = Some(Instant::now() - Duration::from_secs(2));
+    view.screen = CenterScreen::Responses;
+    app.refresh_control_center_github(&session);
+    let Some(Overlay::ControlCenter(view)) = &mut app.overlay else {
+        unreachable!()
+    };
+    assert!(view.github_request.is_none());
+    view.screen = CenterScreen::Summary;
+    app.refresh_control_center_github(&session);
+    tokio::time::timeout(Duration::from_secs(10), async {
+        while read_rx.recv().await.expect("status read") != 4 {}
+    })
+    .await?;
+    let Some(Overlay::ControlCenter(view)) = &app.overlay else {
+        unreachable!()
+    };
+    let stale_request = view.github_request.unwrap();
+    app.close_transcript_overlay(&mut tui);
+    app.open_control_center(&mut tui);
+    app.refresh_control_center_github(&session);
+    assert!(
+        matches!(&app.overlay, Some(Overlay::ControlCenter(view)) if view.github_request != Some(stale_request))
+    );
+    release_old.send(()).unwrap();
+    for _ in 0..2 {
+        consume_github_result(&mut app, &mut tui, &mut session, &mut events).await?;
+        assert!(
+            matches!(&app.overlay, Some(Overlay::ControlCenter(view)) if view.github.as_ref().is_none_or(|status| status.latest_release.as_ref().is_none_or(|release| release.version != "stale")))
+        );
+    }
+    let text = app.control_center_details().iter().join("\n");
+    assert!(text.contains("Remaining points: 0"), "{text}");
+    assert!(!text.contains("4999"), "{text}");
+    assert!(text.lines().any(|line| line == "Release: "));
+    assert!(text.lines().any(|line| line == "Pre-release: "));
+    session.shutdown().await?;
+    server.await??;
+    Ok(())
+}
+
+async fn consume_github_result(
+    app: &mut App,
+    tui: &mut tui::Tui,
+    session: &mut AppServerSession,
+    events: &mut tokio::sync::mpsc::UnboundedReceiver<AppEvent>,
+) -> crate::app::Result<()> {
+    let event = tokio::time::timeout(Duration::from_secs(10), async {
+        loop {
+            let event = events.recv().await.expect("GitHub status result");
+            if matches!(event, AppEvent::ControlCenterGithubLoaded { .. }) {
+                break event;
+            }
+        }
+    })
+    .await?;
+    app.handle_event(tui, session, event).await?;
+    Ok(())
+}
