+//! Observe shared runtime status without reloading usage accounting.
+use super::App;
+use crate::app_event::AppEvent;
+use crate::app_server_session::AppServerSession;
+use crate::control_center_table::Palette;
+use crate::pager_overlay::CenterScreen;
+use crate::pager_overlay::Overlay;
+use crate::tui;
+use crate::tui::TuiEvent;
+use codex_app_server_protocol::ClientRequest;
+use codex_app_server_protocol::GithubReadResponse;
+use codex_app_server_protocol::RemoteControlConnectionStatus;
+use codex_app_server_protocol::RequestId;
+use ratatui::style::Stylize;
+use ratatui::text::Line;
+use ratatui::text::Span;
+use std::sync::Arc;
+use std::time::Duration;
+use std::time::Instant;
+use uuid::Uuid;
+
+impl App {
+    pub(super) fn refresh_control_center_details(
+        &mut self,
+        app_server: &AppServerSession,
+        event: &TuiEvent,
+    ) {
+        if !matches!(self.overlay, Some(Overlay::ControlCenter(_))) {
+            return;
+        }
+        if matches!(
+            event,
+            TuiEvent::Draw | TuiEvent::Resize(_) | TuiEvent::FocusGained | TuiEvent::Resume
+        ) {
+            self.refresh_control_center_github(app_server);
+            let details = self.control_center_details();
+            if let Some(Overlay::ControlCenter(view)) = &mut self.overlay {
+                view.details = details;
+                view.responses.catalog = Arc::clone(&self.model_catalog);
+            }
+        }
+    }
+
+    fn refresh_control_center_github(&mut self, app_server: &AppServerSession) {
+        if self.reconnect.offline {
+            return;
+        }
+        let Some(Overlay::ControlCenter(view)) = &mut self.overlay else {
+            return;
+        };
+        let now = Instant::now();
+        if view.screen != CenterScreen::Summary
+            || view.github_request.is_some()
+            || view
+                .github_read_at
+                .is_some_and(|at| now.duration_since(at) < Duration::from_secs(1))
+        {
+            return;
+        }
+        let request_id = Uuid::new_v4();
+        view.github_request = Some(request_id);
+        view.github_read_at = Some(now);
+        let handle = app_server.request_handle();
+        let events = self.app_event_tx.clone();
+        tokio::spawn(async move {
+            let result = handle
+                .request_typed(ClientRequest::GithubRead {
+                    request_id: RequestId::String(request_id.to_string()),
+                    params: None,
+                })
+                .await
+                .map_err(|error| error.to_string());
+            events.send(AppEvent::ControlCenterGithubLoaded { request_id, result });
+        });
+    }
+
+    pub(super) fn finish_control_center_github(
+        &mut self,
+        tui: &mut tui::Tui,
+        request_id: Uuid,
+        result: Result<GithubReadResponse, String>,
+    ) {
+        if let Some(Overlay::ControlCenter(view)) = &mut self.overlay
+            && view.github_request == Some(request_id)
+        {
+            view.github_request = None;
+            view.github = result.ok().and_then(|response| response.status);
+            tui.frame_requester().schedule_frame();
+        }
+    }
+
+    pub(super) fn control_center_details(&self) -> Vec<Line<'static>> {
+        let github = match &self.overlay {
+            Some(Overlay::ControlCenter(view)) => view.github.as_ref(),
+            _ => None,
+        };
+        let palette = Palette::current();
+        let heading = |text: &str, index| Line::styled(text.to_owned(), palette.model(index));
+        let metric = |label, value| metric(&palette, label, value);
+        let rtt = |connected: bool, ms: Option<u64>| {
+            if connected {
+                ms.map(|ms| format!("{ms}ms"))
+            } else {
+                Some("Disconnected".into())
+            }
+        };
+        vec![
+            heading("WebSocket RTT", 2),
+            metric(
+                "Responses",
+                self.chat_widget
+                    .responses_stream_connection_status()
+                    .and_then(|status| rtt(status.connected, status.rtt_ms)),
+            ),
+            metric(
+                "Remote",
+                self.remote_control_connection_status
+                    .as_ref()
+                    .and_then(|status| {
+                        rtt(
+                            status.status == RemoteControlConnectionStatus::Connected,
+                            status.rtt_ms,
+                        )
+                    }),
+            ),
+            Line::default(),
+            heading("Storage free", 4),
+            metric(
+                "Home",
+                self.storage_capacity
+                    .as_ref()
+                    .map(|capacity| format_capacity_bytes(capacity.home_available_bytes)),
+            ),
+            metric(
+                "Harness",
+                self.storage_capacity
+                    .as_ref()
+                    .map(|capacity| format_capacity_bytes(capacity.harness_available_bytes)),
+            ),
+            Line::default(),
+            heading("GitHub", 7),
+            metric(
+                "Release",
+                github.and_then(|status| {
+                    status
+                        .latest_release
+                        .as_ref()
+                        .map(|release| release.version.clone())
+                }),
+            ),
+            metric(
+                "Pre-release",
+                github.and_then(|status| {
+                    status
+                        .latest_prerelease
+                        .as_ref()
+                        .map(|release| release.version.clone())
+                }),
+            ),
+            metric(
+                "Last checked",
+                github.and_then(|status| {
+                    chrono::DateTime::from_timestamp(status.checked_at, 0).map(|at| {
+                        at.with_timezone(&chrono::Local)
+                            .format("%Y-%m-%d %H:%M:%S")
+                            .to_string()
+                    })
+                }),
+            ),
+            metric(
+                "Remaining points",
+                github.and_then(|status| status.remaining.map(|value| value.to_string())),
+            ),
+            Line::default(),
+            heading("Proxy", 5),
+            metric("Name", self.proxy_alias.clone()),
+            metric("Address", self.proxy_address.clone()),
+            Line::default(),
+            heading("Miscellaneous", 6),
+            metric(
+                "Clients",
+                self.connected_client_count.map(|count| count.to_string()),
+            ),
+        ]
+    }
+}
+
+pub(super) fn metric(palette: &Palette, label: &str, value: Option<String>) -> Line<'static> {
+    Line::from(vec![
+        format!("{label}: ").dim(),
+        Span::styled(value.unwrap_or_default(), palette.intensity(16)),
+    ])
+}
+
+fn format_capacity_bytes(bytes: u64) -> String {
+    const UNITS: [&str; 6] = ["B", "KiB", "MiB", "GiB", "TiB", "PiB"];
+    let mut value = bytes as f64;
+    let mut unit = 0;
+    while value >= 1024.0 && unit + 1 < UNITS.len() {
+        value /= 1024.0;
+        unit += 1;
+    }
+    format!("{value:.2}{}", UNITS[unit])
+}
