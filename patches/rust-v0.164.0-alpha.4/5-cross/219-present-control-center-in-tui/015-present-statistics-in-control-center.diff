+                cost,
+                tokens: codex_app_server_protocol::UsageTokens {
+                    input: 10_000,
+                    cached: 10_000,
+                    output: (cost * 100_000.0) as u64,
+                    total: 10_000 + (cost * 100_000.0) as u64,
+                    ..Default::default()
+                },
+                ..Default::default()
+            },
+        )])),
+        sample_count: 2,
+    };
+    let mut partial = period(3, 100.0, 1.0);
+    partial.model_usage.as_mut().unwrap().insert(
+        "unpriced".into(),
+        UsageTotals {
+            tokens: codex_app_server_protocol::UsageTokens {
+                input: 1,
+                total: 1,
+                ..Default::default()
+            },
+            ..Default::default()
+        },
+    );
+    let mut missing = period(4, 200.0, 2.0);
+    missing.model_usage = None;
+    report.missing_prices.insert("unpriced".into());
