+#[tokio::test]
+async fn refreshing_usage_preserves_the_center_and_its_response_pages() -> anyhow::Result<()> {
+    let (mut app, mut events, _ops) = crate::app::tests::make_test_app_with_channels().await;
+    let mut tui = crate::tui::test_support::make_test_tui()?;
+    app.open_control_center(&mut tui);
+    let request = app.usage_request.as_ref().unwrap().id;
+    app.finish_usage(
+        &mut tui,
+        request,
+        Ok(UsageReadResponse {
+            report: Arc::new(crate::usage::test_report()),
+            refreshed: true,
+        }),
+    );
+    app.overlay.as_mut().unwrap().handle_event(
+        &mut tui,
+        TuiEvent::Key(KeyEvent::new(KeyCode::Char('4'), KeyModifiers::ALT)),
+    )?;
+    let response_request = std::iter::from_fn(|| events.try_recv().ok())
+        .find_map(|event| match event {
+            AppEvent::ReadResponseAttempts { request_id, .. } => Some(request_id),
+            _ => None,
+        })
+        .unwrap();
+    while events.try_recv().is_ok() {}
+    let Some(Overlay::ControlCenter(view)) = &mut app.overlay else {
+        unreachable!()
+    };
+    view.responses.history.finish(
+        response_request,
+        Ok(crate::response_timing::tests::page(vec![
+            crate::response_timing::tests::attempt(7, None),
+        ])),
+        Ok(codex_models_manager::model_pricing::Prices::new()),
+        Instant::now(),
+    );
+    let timing_request = Uuid::new_v4();
+    let timing_read_at = Instant::now();
+    view.timing_request = Some(timing_request);
+    view.timing_read_at = Some(timing_read_at);
+    assert!(view.report().is_some());
+    app.refresh_usage(&mut tui);
+    app.refresh_usage(&mut tui);
+    let AppEvent::LoadUsage {
+        request_id,
+        refresh,
+    } = events.try_recv().unwrap()
+    else {
+        panic!("refresh shared usage")
+    };
+    assert!(refresh);
+    assert_ne!(request_id, request);
+    assert!(events.try_recv().is_err());
+    let Some(Overlay::ControlCenter(view)) = &mut app.overlay else {
+        unreachable!()
+    };
+    assert_eq!(view.request_id, Some(request_id));
+    assert!(view.report().is_none());
+    assert_eq!(
+        view.screen,
+        CenterScreen::Usage(crate::usage::UsageRange::Monthly)
+    );
+    assert_eq!(view.responses.history.count(), 1);
+    assert_eq!(view.timing_request, Some(timing_request));
+    assert_eq!(view.timing_read_at, Some(timing_read_at));
+    let area = ratatui::layout::Rect::new(0, 0, 200, 32);
+    let mut buffer = ratatui::buffer::Buffer::empty(area);
+    view.render(area, &mut buffer);
+    let text = buffer
+        .content
+        .iter()
+        .map(|cell| cell.symbol())
+        .collect::<String>();
+    assert!(text.contains("Loading usage..."), "{text}");
+
+    app.finish_usage(
+        &mut tui,
+        request_id,
+        Ok(UsageReadResponse {
+            report: Arc::new(crate::usage::test_report()),
+            refreshed: true,
+        }),
+    );
+    app.overlay
+        .as_mut()
+        .unwrap()
+        .handle_event(&mut tui, TuiEvent::Key(KeyCode::Esc.into()))?;
+    // The responsive Summary can place its runtime details below the selected-day tables.
+    app.overlay
+        .as_mut()
+        .unwrap()
+        .handle_event(&mut tui, TuiEvent::Key(KeyCode::End.into()))?;
+    let Some(Overlay::ControlCenter(view)) = &mut app.overlay else {
+        unreachable!()
+    };
+    assert!(view.report().is_some());
+    assert_eq!(view.responses.history.count(), 1);
+    assert_eq!(view.timing_request, Some(timing_request));
+    assert_eq!(view.screen, CenterScreen::Summary);
+    view.render(area, &mut buffer);
+    let duration = buffer
+        .content
+        .chunks_exact(usize::from(area.width))
+        .find_map(|row| {
+            let text = row.iter().map(|cell| cell.symbol()).collect::<String>();
+            text.split_once("Build duration: ")
+                .map(|(_, value)| value.trim().to_owned())
+        })
+        .expect("producer build duration is visible");
+    assert_eq!(duration, "1.23s");
+    assert!(events.try_recv().is_err());
+    Ok(())
