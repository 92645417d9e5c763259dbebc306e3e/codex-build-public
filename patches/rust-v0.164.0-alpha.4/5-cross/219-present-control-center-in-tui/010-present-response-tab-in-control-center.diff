+//! Response rows and contextual filter keys share one table body.
+
+use crate::app_event::AppEvent;
+use crate::app_event_sender::AppEventSender;
+use crate::control_center_table::interaction::TableInteraction;
+use crate::key_hint;
+use crate::keymap::ListAction;
+use crate::keymap::ListKeymap;
+use crate::model_catalog::ModelCatalog;
+use crate::response_history::ResponseHistory;
+use crate::response_history::ResponsePageRequest;
+use crate::response_table::HEADER_HEIGHT;
+use crate::response_table::ResponseTable;
+use crate::response_table::STATUSES;
+use crate::response_table::status_label;
+use crate::tui::FrameRequester;
+use crossterm::event::KeyCode;
+use crossterm::event::KeyEvent;
+use crossterm::event::KeyEventKind;
+use crossterm::event::KeyModifiers;
+use ratatui::buffer::Buffer;
+use ratatui::layout::Constraint;
+use ratatui::layout::Layout;
+use ratatui::layout::Rect;
+use ratatui::style::Stylize;
+use ratatui::text::Line;
+use ratatui::widgets::Widget;
+use std::sync::Arc;
+use std::time::Instant;
+
+pub(crate) struct ResponseTab {
+    pub(crate) history: ResponseHistory,
+    pub(crate) catalog: Arc<ModelCatalog>,
+    keymap: ListKeymap,
+    frames: FrameRequester,
+    events: AppEventSender,
+}
+
+impl ResponseTab {
+    pub(crate) fn new(
+        keymap: ListKeymap,
+        frames: FrameRequester,
+        events: AppEventSender,
+        catalog: Arc<ModelCatalog>,
+    ) -> Self {
+        let mut browser = Self {
+            history: ResponseHistory::new(),
+            catalog,
+            keymap,
+            frames,
+            events,
+        };
+        let request = browser.history.load_recent(Instant::now());
+        browser.request(request);
+        browser
+    }
+
+    pub(crate) fn request(&self, request: Option<ResponsePageRequest>) {
+        if let Some(request) = request {
+            self.events.send(AppEvent::ReadResponseAttempts {
+                request_id: request.id,
+                params: request.params,
+            });
+        }
+        self.frames.schedule_frame();
+    }
+
+    pub(crate) fn render(
+        &mut self,
+        area: Rect,
+        buffer: &mut Buffer,
+        interaction: &mut TableInteraction,
+    ) -> Vec<(Rect, Arc<str>)> {
+        let mut errors = Line::default();
+        for error in [
+            self.history.error.as_ref(),
+            self.history.persistence_error.as_ref(),
+            self.history.prices.as_ref().err(),
+        ]
+        .into_iter()
+        .flatten()
+        {
+            if !errors.spans.is_empty() {
+                errors.push_span(" | ");
+            }
+            errors.push_span(error.clone());
+        }
+        let [error_area, list] = Layout::vertical([
+            Constraint::Length(u16::from(!errors.spans.is_empty())),
+            Constraint::Min(0),
+        ])
+        .areas(area);
+        errors.yellow().render(error_area, buffer);
+        let request = self.history.update_viewport(
+            usize::from(list.height).saturating_sub(HEADER_HEIGHT),
+            Instant::now(),
+        );
+        if request.is_some() {
+            self.request(request);
+        }
+        let rows = self.history.rows().collect::<Vec<_>>();
+        let table = ResponseTable::new(
+            &rows,
+            self.history.prices.as_ref().ok(),
+            &self.catalog,
+            Instant::now(),
+        );
+        interaction.column_offset = interaction.column_offset.min(table.max_offset(list.width));
+        if rows.is_empty() {
+            if !self.history.is_loading() {
+                Line::from("No matching responses.")
+                    .dim()
+                    .render(list, buffer);
+            }
+            Vec::new()
+        } else {
+            let end = rows
+                .len()
+                .min(self.history.scroll_top + self.history.visible_rows());
+            table.render(
+                self.history.scroll_top..end,
+                list,
+                buffer,
+                interaction.column_offset,
+            )
+        }
+    }
+
+    pub(crate) fn model_label(&self) -> &str {
+        self.history
+            .model()
+            .map_or("All", |model| self.catalog.display_name(model))
+    }
+
+    pub(crate) fn status_label(&self) -> &'static str {
+        self.history.status().map_or("All", status_label)
+    }
+
+    pub(crate) fn owns_key(key: KeyEvent) -> bool {
+        (matches!(key.code, KeyCode::Left | KeyCode::Right) && key.modifiers == KeyModifiers::NONE)
+            || TableInteraction::horizontal_key(key)
+    }
+
+    pub(crate) fn scroll_direction(&self, key: KeyEvent) -> Option<f64> {
+        if Self::owns_key(key) {
+            return None;
+        }
+        match self.keymap.action_for(key) {
+            Some(ListAction::MoveUp) => Some(-1.0),
+            Some(ListAction::MoveDown) => Some(1.0),
+            _ => None,
+        }
+    }
+
+    pub(crate) fn scroll(&mut self, rows: isize) {
+        let request = self.history.scroll_by(rows, Instant::now());
+        self.request(request);
+    }
+
+    /// Return a close request for the owning control center, never a second overlay.
+    pub(crate) fn handle_key(&mut self, key: KeyEvent, interaction: &mut TableInteraction) -> bool {
+        if key.kind == KeyEventKind::Release {
+            return false;
+        }
+        let action = self.keymap.action_for(key);
+        if Self::owns_key(key)
+            || !matches!(action, Some(ListAction::MoveDown | ListAction::PageDown))
+        {
+            self.history.cancel_scroll();
+        }
+        let now = Instant::now();
+        let request = if key_hint::plain(KeyCode::Left).is_press(key) {
+            let next = self
+                .history
+                .models
+                .iter()
+                .find(|model| {
+                    self.history
+                        .model()
+                        .is_none_or(|current| model.as_str() > current)
+                })
+                .cloned();
+            self.history.set_model(next, now)
+        } else if key_hint::plain(KeyCode::Right).is_press(key) {
+            let next = match self.history.status() {
+                None => STATUSES.first().copied(),
+                Some(status) => STATUSES
+                    .iter()
+                    .position(|candidate| *candidate == status)
+                    .and_then(|index| STATUSES.get(index + 1))
+                    .copied(),
+            };
+            self.history.set_status(next, now)
+        } else if interaction.handle_horizontal(key) {
+            None
+        } else if matches!(action, Some(ListAction::MoveLeft | ListAction::MoveRight)) {
+            interaction.scroll_columns(action == Some(ListAction::MoveRight));
+            None
+        } else if action == Some(ListAction::Cancel)
+            || key_hint::ctrl(KeyCode::Char('c')).is_press(key)
+        {
+            return true;
+        } else if let Some(action) = action {
+            self.history.navigate(action, now)
+        } else {
+            return false;
+        };
+        self.request(request);
+        false
+    }
+}
