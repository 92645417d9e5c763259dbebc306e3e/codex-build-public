+#[tokio::test]
+async fn arrows_cycle_combined_raw_filters_with_metadata_labels_and_no_dialog() {
+    let (mut browser, mut interaction, mut events) = browser();
+    events.try_recv().unwrap();
+    browser
+        .history
+        .models
+        .extend(["model-a".into(), "model-b".into(), "retired-model".into()]);
+    let mut alpha = crate::test_support::TEST_MODEL_PRESETS[0].clone();
+    alpha.model = "model-a".into();
+    alpha.display_name = "Friendly Alpha".into();
+    let mut beta = alpha.clone();
+    beta.model = "model-b".into();
+    beta.display_name = "Friendly Beta".into();
+    browser.catalog = Arc::new(ModelCatalog::new(vec![alpha, beta]));
+    assert_eq!(browser.model_label(), "All");
+    assert_eq!(browser.status_label(), "All");
+    browser.handle_key(KeyCode::Right.into(), &mut interaction);
+    let AppEvent::ReadResponseAttempts { params, .. } = events.try_recv().unwrap() else {
+        panic!("status page")
+    };
+    assert_eq!(params.status, Some(STATUSES[0]));
+    for (model, label) in [
+        (Some("model-a"), "Friendly Alpha"),
+        (Some("model-b"), "Friendly Beta"),
+        (Some("retired-model"), "retired-model"),
+        (None, "All"),
+    ] {
+        browser.handle_key(KeyCode::Left.into(), &mut interaction);
+        let AppEvent::ReadResponseAttempts { params, .. } = events.try_recv().unwrap() else {
+            panic!("model page")
+        };
+        assert_eq!(params.model.as_deref(), model);
+        assert_eq!(params.status, Some(STATUSES[0]));
+        assert_eq!(params.thread_id, None);
+        assert_eq!(params.cursor, None);
+        assert_eq!(browser.model_label(), label);
+    }
+    browser.handle_key(KeyCode::Left.into(), &mut interaction);
+    events.try_recv().unwrap();
+    for status in STATUSES.iter().skip(1).copied().map(Some).chain([None]) {
+        browser.handle_key(KeyCode::Right.into(), &mut interaction);
+        let AppEvent::ReadResponseAttempts { params, .. } = events.try_recv().unwrap() else {
+            panic!("status page")
+        };
+        assert_eq!(params.model.as_deref(), Some("model-a"));
+        assert_eq!(params.status, status);
+        assert_eq!(browser.status_label(), status.map_or("All", status_label));
+    }
+    assert_eq!(interaction.column_offset, 0);
+    for key in [KeyCode::Left, KeyCode::Right] {
+        browser.handle_key(
+            KeyEvent::new_with_kind(key, KeyModifiers::NONE, KeyEventKind::Release),
+            &mut interaction,
+        );
+    }
+    assert!(events.try_recv().is_err());
+    assert_eq!(browser.history.model(), Some("model-a"));
+    assert_eq!(browser.history.status(), None);
+    assert!(browser.handle_key(
+        KeyEvent::new(KeyCode::Char('c'), KeyModifiers::CONTROL),
+        &mut interaction
+    ));
+}
