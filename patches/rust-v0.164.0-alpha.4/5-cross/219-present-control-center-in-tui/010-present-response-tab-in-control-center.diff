+#[tokio::test]
+async fn filter_arrows_override_list_bindings_and_keep_configured_non_arrow_navigation() {
+    let (mut browser, mut interaction, mut events) = browser();
+    let AppEvent::ReadResponseAttempts { request_id, .. } = events.try_recv().unwrap() else {
+        panic!("initial page")
+    };
+    browser.history.finish(
+        request_id,
+        Ok(page(vec![
+            attempt(1, Some(ResponseAttemptEnd::Completed)),
+            attempt(2, Some(ResponseAttemptEnd::Completed)),
+        ])),
+        Ok(Prices::new()),
+        Instant::now(),
+    );
+    let config =
+        toml::from_str("[list]\nmove_down = ['m', 'left', 'shift-right']\nmove_left = 'ctrl-left'\nmove_right = 's'\naccept = 'ctrl-s'\ncancel = 'q'").unwrap();
+    browser.keymap = crate::keymap::RuntimeKeymap::from_config(&config)
+        .unwrap()
+        .list;
+    browser.handle_key(KeyCode::Char('m').into(), &mut interaction);
+    assert_eq!(browser.history.scroll_top, 1);
+    for key in [
+        KeyCode::Tab.into(),
+        KeyCode::BackTab.into(),
+        KeyEvent::new(KeyCode::Char('s'), KeyModifiers::CONTROL),
+    ] {
+        browser.handle_key(key, &mut interaction);
+        assert_eq!(browser.history.scroll_top, 1);
+    }
+    assert_eq!(browser.scroll_direction(KeyCode::Left.into()), None);
+    assert_eq!(
+        browser.scroll_direction(KeyEvent::new(KeyCode::Right, KeyModifiers::SHIFT)),
+        None
+    );
+    browser.handle_key(KeyCode::Left.into(), &mut interaction);
+    assert_eq!(browser.history.model(), Some("gpt-5.4"));
+    assert_eq!(browser.history.scroll_top, 0);
+    browser.handle_key(
+        KeyEvent::new(KeyCode::Right, KeyModifiers::SHIFT),
+        &mut interaction,
+    );
+    assert_eq!(interaction.column_offset, 8);
+    browser.handle_key(KeyCode::Char('s').into(), &mut interaction);
+    assert_eq!(interaction.column_offset, 16);
+    browser.handle_key(
+        KeyEvent::new(KeyCode::Left, KeyModifiers::SHIFT),
+        &mut interaction,
+    );
+    assert_eq!(interaction.column_offset, 8);
+    assert!(browser.handle_key(KeyCode::Char('q').into(), &mut interaction));
+}
