+#[tokio::test]
+async fn table_cells_retain_painted_text_until_the_next_frame() {
+    let (mut browser, mut interaction, mut events) = browser();
+    let AppEvent::ReadResponseAttempts { request_id, .. } = events.try_recv().unwrap() else {
+        panic!("initial page")
+    };
+    browser.history.finish(
+        request_id,
+        Ok(page(vec![attempt(1, None)])),
+        Ok(Prices::new()),
+        Instant::now(),
+    );
+    let area = Rect::new(4, 3, 120, 16);
+    let cells = browser.render(area, &mut Buffer::empty(area), &mut interaction);
+    let first = Uuid::from_u128(1).to_string();
+    let (id_rect, text) = cells
+        .iter()
+        .find(|(_, text)| text.as_ref() == first)
+        .unwrap();
+    assert!(cells.iter().any(|(_, text)| text.as_ref() == "Attempt ID"));
+    assert!(cells.iter().any(|(_, text)| text.as_ref() == "gpt-5.4"));
+    browser.history.update(attempt(2, None), Instant::now());
+    assert_eq!(text.as_ref(), first);
+    let next = browser.render(area, &mut Buffer::empty(area), &mut interaction);
+    assert_eq!(
+        next.iter().find_map(|(rect, text)| {
+            rect.contains((id_rect.x, id_rect.y).into())
+                .then_some(text.as_ref())
+        }),
+        Some(Uuid::from_u128(2).to_string().as_str())
+    );
+    let cells = browser.render(
+        Rect::new(0, 0, 10, 4),
+        &mut Buffer::empty(Rect::new(0, 0, 10, 4)),
+        &mut interaction,
+    );
+    assert_eq!(cells.len(), 1);
+    assert_eq!(cells[0].1.as_ref(), "Start time");
+    let cells = browser.render(
+        Rect::new(0, 0, 10, 2),
+        &mut Buffer::empty(Rect::new(0, 0, 10, 2)),
+        &mut interaction,
+    );
+    assert!(cells.is_empty());
+}
