+#[tokio::test]
+async fn browser_has_no_hidden_close_key_and_columns_remain_accessible_after_resize() {
+    let (mut browser, mut interaction, mut events) = browser();
+    let AppEvent::ReadResponseAttempts { request_id, .. } = events.try_recv().unwrap() else {
+        panic!("page")
+    };
+    let row = attempt(1, Some(ResponseAttemptEnd::Completed));
+    browser.history.finish(
+        request_id,
+        Ok(page(vec![row])),
+        Ok(Prices::new()),
+        Instant::now(),
+    );
+    for key in [
+        KeyCode::Char('q').into(),
+        KeyCode::Tab.into(),
+        KeyCode::BackTab.into(),
+        KeyCode::Enter.into(),
+        KeyCode::Char('r').into(),
+        KeyCode::Char('c').into(),
+        KeyCode::Char('m').into(),
+        KeyCode::Char('s').into(),
+        KeyEvent::new(KeyCode::Char('e'), KeyModifiers::CONTROL),
+    ] {
+        assert!(!browser.handle_key(key, &mut interaction));
+    }
+    assert!(events.try_recv().is_err());
+    for _ in 0..100 {
+        browser.handle_key(
+            KeyEvent::new(KeyCode::Right, KeyModifiers::SHIFT),
+            &mut interaction,
+        );
+    }
+    let area = Rect::new(0, 0, 80, 16);
+    let mut buffer = Buffer::empty(area);
+    browser.render(area, &mut buffer, &mut interaction);
+    assert!(line(&buffer, 2).contains("Cost"));
+    assert!(interaction.column_offset > 0);
+    for (width, height) in [(1, 1), (10, 4), (80, 10), (600, 20)] {
+        let area = Rect::new(0, 0, width, height);
+        browser.render(area, &mut Buffer::empty(area), &mut interaction);
+    }
+    assert_eq!(interaction.column_offset, 0);
+    assert!(browser.handle_key(KeyCode::Esc.into(), &mut interaction));
+}
