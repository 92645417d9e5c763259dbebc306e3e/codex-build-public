+use super::*;
+use crate::response_timing::tests::attempt;
+use crate::response_timing::tests::page;
+use codex_models_manager::model_pricing::Prices;
+use codex_protocol::response_metrics::ResponseAttemptEnd;
+use pretty_assertions::assert_eq;
+use uuid::Uuid;
+
+fn browser() -> (
+    ResponseTab,
+    TableInteraction,
+    tokio::sync::mpsc::UnboundedReceiver<AppEvent>,
+) {
+    let (events, received) = tokio::sync::mpsc::unbounded_channel();
+    (
+        ResponseTab::new(
+            crate::keymap::RuntimeKeymap::defaults().list,
+            FrameRequester::test_dummy(),
+            AppEventSender::new(events),
+            Arc::new(ModelCatalog::new(Vec::new())),
+        ),
+        TableInteraction::new(1.0, FrameRequester::test_dummy()),
+        received,
+    )
+}
+
+fn line(buffer: &Buffer, y: u16) -> String {
+    (buffer.area.x..buffer.area.right())
+        .map(|x| buffer[(x, y)].symbol())
+        .collect()
+}
+
+#[tokio::test]
+async fn response_body_keeps_shared_table_paging_without_selection_filter_or_progress_bars() {
+    let (mut browser, mut interaction, mut events) = browser();
+    let AppEvent::ReadResponseAttempts { request_id, params } = events.try_recv().unwrap() else {
+        panic!("initial page")
+    };
+    assert_eq!(params.thread_id, None);
+    let mut response = page(
+        (101..=130)
+            .map(|id| {
+                let mut row = attempt(id, Some(ResponseAttemptEnd::Completed));
+                row.requested_model = if id % 2 == 0 { "model-a" } else { "model-b" }.into();
+                row
+            })
+            .collect(),
+    );
+    response.next_cursor = Some("older".into());
+    browser
+        .history
+        .finish(request_id, Ok(response), Ok(Prices::new()), Instant::now());
+    let area = Rect::new(0, 0, 140, 20);
+    for bg in [(20, 35, 50), (250, 241, 235)] {
+        crate::terminal_palette::with_test_default_colors(
+            crate::terminal_probe::DefaultColors {
+                fg: (180, 220, 255),
+                bg,
+            },
+            || {
+                let mut buffer = Buffer::empty(area);
+                browser.render(area, &mut buffer, &mut interaction);
+                assert!(line(&buffer, 0).starts_with('┌'));
+                assert!(line(&buffer, 1).contains("Model"));
+                assert!(line(&buffer, 2).contains("Attempt ID"));
+                assert!(line(&buffer, 3).contains("Requested"));
+                assert!(line(&buffer, 3).contains("Served"));
+                assert!(line(&buffer, 17).contains(&Uuid::from_u128(124).to_string()));
+                assert!(line(&buffer, 18).starts_with('└'));
+                assert_eq!(buffer[(2, 7)].bg, buffer[(2, 9)].bg);
+                let text = buffer
+                    .content
+                    .iter()
+                    .map(|cell| cell.symbol())
+                    .collect::<String>();
+                assert!(!text.contains(&attempt(1, None).thread_id.unwrap().to_string()));
+                assert!(!text.contains("Type to search"));
+                for removed in [
+                    "choose columns",
+                    "scroll columns",
+                    "browse",
+                    "refresh responses",
+                    "Model: All",
+                    "1 / 30",
+                    "more",
+                ] {
+                    assert!(!text.contains(removed));
+                }
+                assert_eq!(buffer[(2, 5)].bg, ratatui::style::Color::Reset);
+                assert_eq!(buffer[(2, 5)].bg, buffer[(2, 7)].bg);
+            },
+        );
+    }
+    browser.handle_key(KeyCode::End.into(), &mut interaction);
+    assert!(matches!(
+        events.try_recv().unwrap(),
+        AppEvent::ReadResponseAttempts { .. }
+    ));
+    let mut loading = Buffer::empty(area);
+    browser.render(area, &mut loading, &mut interaction);
+    assert!(line(&loading, 0).starts_with('┌'));
+    assert!(line(&loading, 17).contains(&Uuid::from_u128(101).to_string()));
+    assert!(line(&loading, 18).starts_with('└'));
+    assert!(
+        !loading
+            .content
+            .iter()
+            .map(|cell| cell.symbol())
+            .collect::<String>()
+            .contains("more")
+    );
+    browser.handle_key(
+        KeyEvent::new(KeyCode::Right, KeyModifiers::SHIFT),
+        &mut interaction,
+    );
+    assert_eq!(interaction.column_offset, 8);
+    assert_eq!(browser.history.model(), None);
+    browser.handle_key(KeyCode::Tab.into(), &mut interaction);
+    browser.handle_key(
+        KeyEvent::new(KeyCode::Right, KeyModifiers::CONTROL),
+        &mut interaction,
+    );
+    assert_eq!(interaction.column_offset, 16);
+    browser.handle_key(
+        KeyEvent::new(KeyCode::Left, KeyModifiers::CONTROL),
+        &mut interaction,
+    );
+    assert_eq!(interaction.column_offset, 8);
+    assert!(events.try_recv().is_err());
+}
