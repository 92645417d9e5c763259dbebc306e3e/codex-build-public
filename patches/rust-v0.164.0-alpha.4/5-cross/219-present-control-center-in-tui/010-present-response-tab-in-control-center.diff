+#[tokio::test]
+async fn configured_list_bindings_own_horizontal_scrolling_and_cancel() {
+    let (mut browser, mut interaction, mut events) = browser();
+    events.try_recv().unwrap();
+    browser.history.models.insert("model-a".into());
+    let config =
+        toml::from_str("[list]\nmove_left = 'ctrl-left'\nmove_right = 'ctrl-right'\ncancel = 'q'")
+            .unwrap();
+    browser.keymap = crate::keymap::RuntimeKeymap::from_config(&config)
+        .unwrap()
+        .list;
+    browser.handle_key(
+        KeyEvent::new(KeyCode::Right, KeyModifiers::CONTROL),
