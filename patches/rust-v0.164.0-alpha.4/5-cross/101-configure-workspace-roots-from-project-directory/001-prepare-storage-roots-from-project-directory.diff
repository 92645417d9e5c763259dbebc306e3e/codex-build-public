+++ b/codex-rs/core/src/config/storage_roots.rs
@@ -0,0 +1,183 @@
+use anyhow::Context;
+use codex_utils_absolute_path::AbsolutePathBuf;
+use std::collections::HashMap;
+use std::ffi::OsStr;
+use std::ffi::OsString;
+use std::path::Path;
+use std::path::PathBuf;
+
+pub(crate) struct StorageRoots {
+    project_scratch_root: AbsolutePathBuf,
+    project_runtime_root: AbsolutePathBuf,
+    project_persistent_root: AbsolutePathBuf,
+    repos_root: AbsolutePathBuf,
+    skills_root: AbsolutePathBuf,
+    skills_scratch_root: AbsolutePathBuf,
+}
+
+impl StorageRoots {
+    pub(crate) fn for_cwd(
+        cwd: &Path,
+        codex_home: &Path,
+        codex_harness: &Path,
+    ) -> anyhow::Result<Self> {
+        Self::resolve(cwd, codex_home, codex_harness, |name| {
+            std::env::var_os(name)
+        })
+    }
+
+    fn resolve(
+        cwd: &Path,
+        codex_home: &Path,
+        codex_harness: &Path,
+        mut variable: impl FnMut(&str) -> Option<OsString>,
+    ) -> anyhow::Result<Self> {
+        let relative = project_relative_directory(cwd);
+        let project_leaf = relative
+            .file_name()
+            .context("project-relative directory has no final component")?;
+
+        Ok(Self {
+            project_scratch_root: absolute_override(
+                "PROJECT_SCRATCH_ROOT",
+                codex_harness.join(&relative),
+                &mut variable,
+            )?,
+            project_runtime_root: project_root_from_base(
+                "PROJECT_RUNTIME_ROOT",
+                "TMPDIR",
+                project_leaf,
+                &mut variable,
+            )?,
+            project_persistent_root: project_root_from_base(
+                "PROJECT_PERSISTENT_ROOT",
+                "HOME",
+                project_leaf,
+                &mut variable,
+            )?,
+            repos_root: project_root_from_base(
+                "REPOS_ROOT",
+                "HOME",
+                OsStr::new("repos"),
+                &mut variable,
+            )?,
+            skills_root: absolute_override(
+                "SKILLS_ROOT",
+                codex_home.join("skills"),
+                &mut variable,
+            )?,
+            skills_scratch_root: absolute_override(
+                "SKILLS_SCRATCH_ROOT",
+                codex_harness.join("skills"),
+                &mut variable,
+            )?,
+        })
+    }
+
+    pub(crate) fn ensure(mut self) -> anyhow::Result<Self> {
+        ensure_root("PROJECT_SCRATCH_ROOT", &mut self.project_scratch_root)?;
+        for language in ["python", "go", "rust"] {
+            let child = self.project_scratch_root.join(language);
+            std::fs::create_dir_all(child.as_path())
+                .with_context(|| format!("failed to ensure PROJECT_SCRATCH_ROOT/{language}"))?;
+        }
+        ensure_root("PROJECT_RUNTIME_ROOT", &mut self.project_runtime_root)?;
+        ensure_root("PROJECT_PERSISTENT_ROOT", &mut self.project_persistent_root)?;
+        ensure_root("REPOS_ROOT", &mut self.repos_root)?;
+        ensure_root("SKILLS_ROOT", &mut self.skills_root)?;
+        ensure_root("SKILLS_SCRATCH_ROOT", &mut self.skills_scratch_root)?;
+        Ok(self)
+    }
+
+    pub(crate) fn environment(&self) -> anyhow::Result<HashMap<String, String>> {
+        [
+            ("PROJECT_SCRATCH_ROOT", &self.project_scratch_root),
+            ("PROJECT_RUNTIME_ROOT", &self.project_runtime_root),
+            ("PROJECT_PERSISTENT_ROOT", &self.project_persistent_root),
+            ("REPOS_ROOT", &self.repos_root),
+            ("SKILLS_ROOT", &self.skills_root),
+            ("SKILLS_SCRATCH_ROOT", &self.skills_scratch_root),
+        ]
+        .into_iter()
+        .map(|(name, path)| {
+            let value = path
+                .as_path()
+                .to_str()
+                .with_context(|| format!("{name} is not valid UTF-8"))?;
+            Ok((name.to_owned(), value.to_owned()))
+        })
+        .collect()
+    }
+
+    pub(crate) fn directories(&self) -> [&AbsolutePathBuf; 6] {
+        [
+            &self.project_scratch_root,
+            &self.project_runtime_root,
+            &self.project_persistent_root,
+            &self.repos_root,
+            &self.skills_root,
+            &self.skills_scratch_root,
+        ]
+    }
+}
+
+fn ensure_root(name: &str, path: &mut AbsolutePathBuf) -> anyhow::Result<()> {
+    std::fs::create_dir_all(path.as_path())
+        .with_context(|| format!("failed to ensure {name} at {}", path.display()))?;
+    *path = path
+        .canonicalize()
+        .with_context(|| format!("failed to resolve {name} at {}", path.display()))?;
+    Ok(())
+}
+
+fn project_relative_directory(cwd: &Path) -> PathBuf {
+    let project = cwd
+        .file_name()
+        .filter(|name| !name.is_empty())
+        .unwrap_or_else(|| OsStr::new("workspace"));
+    let group = cwd
+        .parent()
+        .and_then(Path::file_name)
+        .filter(|name| !name.is_empty())
+        .unwrap_or_else(|| OsStr::new("root"));
+    PathBuf::from(group).join(project)
+}
+
+fn absolute_override(
+    name: &str,
+    default: PathBuf,
+    variable: &mut impl FnMut(&str) -> Option<OsString>,
+) -> anyhow::Result<AbsolutePathBuf> {
+    let path = variable(name)
+        .filter(|value| !value.is_empty())
+        .map_or(default, PathBuf::from);
+    absolute_path(name, path)
+}
+
+fn project_root_from_base(
+    name: &str,
+    base_name: &str,
+    project_leaf: &OsStr,
+    variable: &mut impl FnMut(&str) -> Option<OsString>,
+) -> anyhow::Result<AbsolutePathBuf> {
+    if let Some(override_path) = variable(name).filter(|value| !value.is_empty()) {
+        return absolute_path(name, PathBuf::from(override_path));
+    }
+    let base = variable(base_name)
+        .filter(|value| !value.is_empty())
+        .map(PathBuf::from)
+        .with_context(|| format!("{base_name} is required for default {name}"))?;
+    if !base.is_absolute() {
+        anyhow::bail!("{base_name} must be an absolute path");
+    }
+    absolute_path(name, base.join(project_leaf))
+}
+
+fn absolute_path(name: &str, path: PathBuf) -> anyhow::Result<AbsolutePathBuf> {
+    AbsolutePathBuf::from_absolute_path_checked(path)
+        .with_context(|| format!("{name} must be an absolute path"))
+}
