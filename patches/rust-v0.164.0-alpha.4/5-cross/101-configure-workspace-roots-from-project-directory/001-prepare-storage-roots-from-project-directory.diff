+use super::permissions::BUILT_IN_WORKSPACE_PROFILE;
+use super::storage_roots::StorageRoots;
+use codex_config::SandboxModeRequirement;
+use codex_config::sandbox_mode_requirement_for_permission_profile;
+use codex_protocol::models::ActivePermissionProfile;
+use codex_protocol::models::PermissionProfile;
+use codex_protocol::permissions::FileSystemAccessMode;
+use codex_protocol::permissions::FileSystemPath;
+use codex_protocol::permissions::FileSystemSandboxEntry;
+use codex_protocol::permissions::FileSystemSandboxPolicy;
+use codex_protocol::permissions::FileSystemSpecialPath;
+use codex_protocol::permissions::PROTECTED_METADATA_PATH_NAMES;
+use codex_protocol::protocol::SandboxPolicy;
+use codex_utils_absolute_path::AbsolutePathBuf;
+
+pub(super) fn is_builtin_workspace(
+    profile: &PermissionProfile,
+    active_profile: Option<&ActivePermissionProfile>,
+    cwd: &AbsolutePathBuf,
+) -> bool {
+    if sandbox_mode_requirement_for_permission_profile(profile)
+        != SandboxModeRequirement::WorkspaceWrite
+    {
+        return false;
+    }
+    if let Some(active) = active_profile {
+        return active.id == BUILT_IN_WORKSPACE_PROFILE;
+    }
+    let file_system = profile.file_system_sandbox_policy();
+    // An absolute grant, even to cwd itself, does not declare cwd-following permissions.
+    if !file_system.entries.iter().any(|entry| {
+        entry.access == FileSystemAccessMode::Write
+            && matches!(
+                entry.path,
+                FileSystemPath::Special {
+                    value: FileSystemSpecialPath::ProjectRoots { subpath: None },
+                }
+            )
+    }) {
+        return false;
+    }
+    let Ok(legacy) = profile.to_legacy_sandbox_policy(cwd) else {
+        return false;
+    };
+    // Legacy overrides inspect existing metadata; native profile compilation adds
+    // skip-if-missing metadata entries for its declared roots. Admit both native
+    // Workspace forms, while preserving richer anonymous read/write carveouts.
+    if file_system.is_semantically_equivalent_to(
+        &FileSystemSandboxPolicy::from_legacy_sandbox_policy_preserving_deny_entries(
+            &legacy,
+            cwd,
+            &file_system,
+        ),
+        cwd,
+    ) {
+        return true;
+    }
+    let SandboxPolicy::WorkspaceWrite {
+        writable_roots,
+        exclude_tmpdir_env_var,
+        exclude_slash_tmp,
+        ..
+    } = legacy
+    else {
+        return false;
+    };
+    let mut configured =
+        FileSystemSandboxPolicy::workspace_write(&[], exclude_tmpdir_env_var, exclude_slash_tmp)
+            .with_materialized_project_roots_for_workspace_roots(&writable_roots);
+    configured.preserve_deny_read_restrictions_from(&file_system);
+    file_system.is_semantically_equivalent_to(&configured, cwd)
+}
+
+pub(super) fn workspace_permission_profile(
+    profile: &PermissionProfile,
+    cwd: &AbsolutePathBuf,
+    storage_roots: &StorageRoots,
+) -> PermissionProfile {
+    let mut entries = vec![FileSystemSandboxEntry::new(
+        FileSystemPath::Special {
+            value: FileSystemSpecialPath::Root,
+        },
+        FileSystemAccessMode::Read,
+    )];
+    // Bind the entered cwd rather than symbolic workspace folders, which can change later.
+    for root in std::iter::once(cwd).chain(storage_roots.directories()) {
+        entries.push(FileSystemSandboxEntry::new(
+            root.clone().into(),
+            FileSystemAccessMode::Write,
+        ));
+        // Native policy gives these names implicit read-only protection unless explicitly granted.
+        for name in PROTECTED_METADATA_PATH_NAMES {
+            entries.push(FileSystemSandboxEntry::new(
+                root.join(name).into(),
+                FileSystemAccessMode::Write,
+            ));
+        }
+    }
+    let mut file_system = FileSystemSandboxPolicy::restricted(entries);
+    file_system.preserve_deny_read_restrictions_from(&profile.file_system_sandbox_policy());
+    PermissionProfile::from_runtime_permissions_with_enforcement(
+        profile.enforcement(),
+        &file_system,
+        profile.network_sandbox_policy(),
+    )
+}
