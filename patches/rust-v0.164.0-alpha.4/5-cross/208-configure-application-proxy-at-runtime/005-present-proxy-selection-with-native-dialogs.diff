+#[test]
+fn adding_from_the_picker_preserves_the_staged_configuration_without_writing() {
+    let (mut view, mut rx) = test_view(configuration());
+    view.handle_key_event(KeyEvent::from(KeyCode::Char(' ')));
+    view.handle_key_event(KeyEvent::from(KeyCode::Char('a')));
