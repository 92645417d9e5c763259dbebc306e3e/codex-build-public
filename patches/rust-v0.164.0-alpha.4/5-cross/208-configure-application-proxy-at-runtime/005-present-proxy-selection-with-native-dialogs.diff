+//! Proxy configuration content, constructed independently of its dialog host.
+
+use crate::app_event::AppEvent;
+use crate::bottom_pane::ProxyPickerView;
+use crate::bottom_pane::custom_prompt_view::CustomPromptView;
+use crate::dialog::DialogResources;
+use codex_app_server_protocol::ProxyConfig;
+use codex_app_server_protocol::ProxyDefinition;
+
+pub(crate) fn menu(config: ProxyConfig, resources: &DialogResources<'_>) -> ProxyPickerView {
+    ProxyPickerView::new(
+        config,
+        resources.app_event_tx.clone(),
+        resources.keymap.list.clone(),
+        resources.frame_requester.clone(),
+    )
+}
+
+pub(crate) fn add_alias(config: ProxyConfig, resources: &DialogResources<'_>) -> CustomPromptView {
+    let tx = resources.app_event_tx.clone();
+    resources.text_prompt(CustomPromptView::new(
+        "Add proxy".to_string(),
+        "Enter an alias".to_string(),
+        String::new(),
+        Some("This alias identifies the proxy in the control center.".to_string()),
+        Box::new(move |alias| {
+            let alias = alias.trim();
+            if !alias.is_empty() {
+                tx.send(AppEvent::OpenProxyAddUrl {
+                    config: config.clone(),
+                    alias: alias.to_string(),
+                });
+            }
+        }),
+    ))
+}
+
+pub(crate) fn add_url(
+    config: ProxyConfig,
+    alias: String,
+    resources: &DialogResources<'_>,
+) -> CustomPromptView {
+    let tx = resources.app_event_tx.clone();
+    resources.text_prompt(CustomPromptView::new(
+        "Add proxy".to_string(),
+        "Enter an http:// or https:// proxy URL".to_string(),
+        String::new(),
+        Some(format!("Alias: {alias}")),
+        Box::new(move |url| {
+            let mut config = config.clone();
+            config.entries.push(ProxyDefinition {
+                alias: alias.clone(),
+                url: url.trim().to_string(),
+            });
+            tx.send(AppEvent::WriteProxyConfig {
+                config,
+                reopen_picker: true,
+            });
+        }),
+    ))
+}
