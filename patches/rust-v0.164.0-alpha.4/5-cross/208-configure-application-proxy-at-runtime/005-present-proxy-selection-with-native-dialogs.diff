+use super::App;
+use crate::dialog::DialogResources;
+use crate::proxy_dialogs;
+use crate::tui::Tui;
+use codex_app_server_protocol::ProxyConfig;
+
+impl App {
+    pub(super) fn open_proxy_menu(&mut self, tui: &Tui, config: ProxyConfig) {
+        let frames = tui.frame_requester();
+        let resources = DialogResources {
+            app_event_tx: &self.app_event_tx,
+            keymap: &self.keymap,
+            frame_requester: &frames,
+            vim_enabled: self.chat_widget.composer_is_vim_enabled(),
+        };
+        let view = proxy_dialogs::menu(config, &resources);
+        self.chat_widget.show_bottom_pane_view(Box::new(view));
+    }
+
+    pub(super) fn open_proxy_add_alias(&mut self, tui: &Tui, config: ProxyConfig) {
+        let frames = tui.frame_requester();
+        let resources = DialogResources {
+            app_event_tx: &self.app_event_tx,
+            keymap: &self.keymap,
+            frame_requester: &frames,
+            vim_enabled: self.chat_widget.composer_is_vim_enabled(),
+        };
+        let view = proxy_dialogs::add_alias(config, &resources);
+        self.chat_widget.show_bottom_pane_view(Box::new(view));
+    }
+
+    pub(super) fn open_proxy_add_url(&mut self, tui: &Tui, config: ProxyConfig, alias: String) {
+        let frames = tui.frame_requester();
+        let resources = DialogResources {
+            app_event_tx: &self.app_event_tx,
+            keymap: &self.keymap,
+            frame_requester: &frames,
+            vim_enabled: self.chat_widget.composer_is_vim_enabled(),
+        };
+        let view = proxy_dialogs::add_url(config, alias, &resources);
+        self.chat_widget.show_bottom_pane_view(Box::new(view));
+    }
+}
