+#[test]
+fn proxy_picker_stages_selection_and_deletion_until_apply() {
+    let (mut view, mut rx) = test_view(configuration());
+    view.handle_key_event(KeyEvent::new(KeyCode::Char(' '), KeyModifiers::NONE));
+    view.handle_key_event(KeyEvent::new(KeyCode::Down, KeyModifiers::NONE));
+    view.handle_key_event(KeyEvent::new(KeyCode::Char('d'), KeyModifiers::NONE));
+    assert!(rx.try_recv().is_err());
+    view.handle_key_event(KeyEvent::new(KeyCode::Enter, KeyModifiers::NONE));
+    let AppEvent::WriteProxyConfig {
+        config,
+        reopen_picker,
+    } = rx.try_recv().expect("apply")
+    else {
+        panic!("unexpected event");
+    };
+    let mut expected = configuration();
+    expected.enabled = true;
+    expected.selected = Some("backup".to_string());
+    expected.entries.remove(0);
+    assert_eq!(config, expected);
+    assert!(!reopen_picker);
+    assert!(view.is_complete());
+
+    let (mut view, mut rx) = test_view(configuration());
+    view.handle_key_event(KeyEvent::new(KeyCode::Char(' '), KeyModifiers::NONE));
+    view.handle_key_event(KeyEvent::new(KeyCode::Esc, KeyModifiers::NONE));
+    assert!(rx.try_recv().is_err());
+    assert!(view.is_complete());
+}
+
+#[test]
+fn proxy_picker_renders_enabled_and_disabled_selection() {
+    let (mut view, _rx) = test_view(configuration());
+    view.config.selected = Some("stable-lan".to_string());
+    for enabled in [false, true] {
+        if enabled {
+            view.handle_key_event(KeyEvent::from(KeyCode::Char(' ')));
+            view.handle_key_event(KeyEvent::from(KeyCode::Down));
+        }
+        let (buffer, text) = render(&view);
+        assert!(text.contains("[x] stable-lan"));
+        assert!(text.contains("Testing..."));
+        assert!(!text.contains("secret"));
+        assert!(!text.contains("Disabled"));
+        assert!(!text.contains("shell commands"));
+        let alias = alias_cell(&buffer);
+        assert_eq!(
+            alias.modifier.contains(ratatui::style::Modifier::DIM),
+            !enabled
+        );
+        if enabled {
+            let selected = super::super::picker_style::selection_style();
+            assert_eq!(
+                alias.bg,
+                selected.bg.unwrap_or(ratatui::style::Color::Reset)
+            );
+            assert_eq!(
+                alias.modifier.contains(ratatui::style::Modifier::REVERSED),
+                selected
+                    .add_modifier
+                    .contains(ratatui::style::Modifier::REVERSED)
+            );
+        }
+    }
+}
