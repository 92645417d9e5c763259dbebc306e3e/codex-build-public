+#[test]
+fn proxy_picker_uses_configured_list_keys_and_ignores_release_events() {
+    let (mut view, mut rx) = test_view(configuration());
+    view.keymap.accept = vec![key_hint::plain(KeyCode::Char('x'))];
+    view.keymap.cancel = vec![key_hint::plain(KeyCode::Char('z'))];
+    let space = KeyEvent::new(KeyCode::Char(' '), KeyModifiers::NONE);
+    view.handle_key_event(space);
+    view.handle_key_event(KeyEvent {
+        kind: KeyEventKind::Release,
+        ..space
+    });
+    assert!(view.config.enabled);
+    assert!(rx.try_recv().is_err());
+    let (_, text) = render(&view);
+    assert!(text.contains("x apply"));
+    assert!(text.contains("z cancel"));
+    view.handle_key_event(KeyEvent::from(KeyCode::Enter));
+    assert!(!view.is_complete());
+    view.handle_key_event(KeyEvent::from(KeyCode::Char('x')));
+    assert!(
+        matches!(rx.try_recv(), Ok(AppEvent::WriteProxyConfig { config, .. }) if config.enabled)
+    );
+}
+
+#[test]
+fn deleting_a_scrolled_selected_proxy_keeps_selection_visible_and_disables_the_last_entry() {
+    let config = ProxyConfig {
+        entries: (0..25)
+            .map(|index| ProxyDefinition {
+                alias: format!("proxy-{index}"),
+                url: "http://127.0.0.1:8080".to_string(),
+            })
+            .collect(),
+        ..Default::default()
+    };
+    let (mut view, mut rx) = test_view(config);
+    view.handle_key_event(KeyEvent::from(KeyCode::Char(' ')));
+    view.handle_key_event(KeyEvent::from(KeyCode::Up));
+    view.handle_key_event(KeyEvent::from(KeyCode::Char(' ')));
+    assert_eq!(view.config.selected.as_deref(), Some("proxy-24"));
+    assert!(view.state.scroll_top > 0);
+    while !view.config.entries.is_empty() {
+        view.handle_key_event(KeyEvent::from(KeyCode::Char('d')));
+        if !view.config.entries.is_empty() {
+            let selected = view.state.selected_idx.expect("remaining proxy row");
+            assert!(selected < 1 + view.config.entries.len());
+            assert!(selected >= view.state.scroll_top);
+            assert!(selected < view.state.scroll_top + MAX_POPUP_ROWS);
+        }
+        assert!(rx.try_recv().is_err());
+    }
+    assert_eq!(view.config, ProxyConfig::default());
+    assert_eq!(view.state.scroll_top, 0);
+    assert_eq!(view.state.selected_idx, None);
+    assert!(view.rows().is_empty());
+    view.handle_key_event(KeyEvent::from(KeyCode::Enter));
+    assert!(
+        matches!(rx.try_recv(), Ok(AppEvent::WriteProxyConfig { config, .. }) if config == ProxyConfig::default())
+    );
+}
