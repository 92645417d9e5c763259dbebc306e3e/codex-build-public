+#[test]
+fn proxy_picker_uses_the_shared_body_and_wrapped_footer_surfaces() {
+    crate::terminal_palette::with_test_default_colors(
+        crate::terminal_probe::DefaultColors {
+            fg: (240, 240, 240),
+            bg: (0, 0, 0),
+        },
+        || {
+            let (view, _rx) = test_view(configuration());
+            for width in [20, 40, 72] {
+                let area = Rect::new(3, 2, width, view.desired_height(width));
+                let mut buffer = Buffer::empty(area);
+                for cell in &mut buffer.content {
+                    cell.set_bg(ratatui::style::Color::Blue);
+                }
+                view.render(area, &mut buffer);
+                assert_eq!(
+                    buffer[(area.x, area.y)].bg,
+                    crate::style::user_message_style().bg.unwrap()
+                );
+                let footer_height =
+                    wrap_styled_line(&view.footer_hint(), width.saturating_sub(2)).len() as u16;
+                let mut footer = String::new();
+                for y in area.bottom() - footer_height..area.bottom() {
+                    for x in area.left()..area.right() {
+                        assert_eq!(buffer[(x, y)].bg, ratatui::style::Color::Reset);
+                        footer.push_str(buffer[(x, y)].symbol());
+                    }
+                }
+                assert!(footer.starts_with("  ") && footer.contains("esc"));
+            }
+        },
+    );
+}
