+++ b/codex-rs/tui/src/app/tests/proxy.rs
@@ -0,0 +1,119 @@
+use super::make_test_app_with_channels;
+use crate::app_event::AppEvent;
+use crate::chatwidget::tests::helpers::render_bottom_popup;
+use crate::tui::TuiEvent;
+use codex_app_server_protocol::ProxyConfig;
+use codex_app_server_protocol::ProxyDefinition;
+use color_eyre::eyre::Result;
+use crossterm::event::KeyCode;
+use pretty_assertions::assert_eq;
+
+#[tokio::test]
+async fn proxy_picker_rpc_round_trip_persists_and_updates_app_state() -> Result<()> {
+    let (mut app, mut events, _ops) = make_test_app_with_channels().await;
+    let mut server = crate::start_embedded_app_server_for_picker(&app.config).await?;
+    let mut tui = crate::tui::test_support::make_test_tui()?;
+    app.handle_event(&mut tui, &mut server, AppEvent::OpenProxy)
+        .await?;
+    assert!(render_bottom_popup(&app.chat_widget, 80).contains("Proxy"));
+    app.handle_tui_event(&mut tui, &mut server, TuiEvent::Key(KeyCode::Esc.into()))
+        .await?;
+    assert!(app.chat_widget.no_modal_or_popup_active());
+    let mut config = ProxyConfig {
+        entries: vec![ProxyDefinition {
+            alias: "lan".to_string(),
+            url: "https://user:secret@127.0.0.1:8443".to_string(),
+        }],
+        ..Default::default()
+    };
+    app.handle_event(
+        &mut tui,
+        &mut server,
+        AppEvent::WriteProxyConfig {
+            config: config.clone(),
+            reopen_picker: true,
+        },
+    )
+    .await?;
+    let popup = render_bottom_popup(&app.chat_widget, 80);
+    assert!(popup.contains("lan"));
+    assert!(!popup.contains("secret"));
+    assert!(app.proxy_alias.is_none());
+    assert!(app.proxy_address.is_none());
+    let path = app.config.codex_home.join("integrations.json");
+    let document: serde_json::Value = serde_json::from_slice(&std::fs::read(&path)?)?;
+    assert_eq!(
+        serde_json::from_value::<ProxyConfig>(document["proxy"].clone())?,
+        config
+    );
+    app.handle_tui_event(
+        &mut tui,
+        &mut server,
+        TuiEvent::Key(KeyCode::Char(' ').into()),
+    )
+    .await?;
+    assert!(render_bottom_popup(&app.chat_widget, 80).contains("[x] Enabled"));
+    assert!(events.try_recv().is_err());
+    assert_eq!(server.proxy_read().await?.config, config);
+    assert!(app.proxy_alias.is_none());
+    app.handle_tui_event(&mut tui, &mut server, TuiEvent::Key(KeyCode::Enter.into()))
+        .await?;
+    let event = events.try_recv().expect("confirmed proxy settings");
+    config.enabled = true;
+    config.selected = Some("lan".to_string());
+    assert!(
+        matches!(&event, AppEvent::WriteProxyConfig { config: written, reopen_picker: false } if written == &config)
+    );
+    assert!(events.try_recv().is_err());
+    assert!(app.chat_widget.no_modal_or_popup_active());
+    app.handle_event(&mut tui, &mut server, event).await?;
+    assert_eq!(app.proxy_alias.as_deref(), Some("lan"));
+    assert_eq!(app.proxy_address.as_deref(), Some("127.0.0.1:8443"));
+    let enabled = server.proxy_read().await?;
+    assert_eq!(enabled.config, config);
+    assert_eq!(enabled.active_alias.as_deref(), Some("lan"));
+    assert_eq!(enabled.active_address.as_deref(), Some("127.0.0.1:8443"));
+    app.handle_event(&mut tui, &mut server, AppEvent::OpenProxy)
+        .await?;
+    app.handle_tui_event(
+        &mut tui,
+        &mut server,
+        TuiEvent::Key(KeyCode::Char(' ').into()),
+    )
+    .await?;
+    app.handle_tui_event(&mut tui, &mut server, TuiEvent::Key(KeyCode::Esc.into()))
+        .await?;
+    assert!(events.try_recv().is_err());
+    assert!(app.chat_widget.no_modal_or_popup_active());
+    assert_eq!(server.proxy_read().await?.config, config);
+    assert_eq!(app.proxy_alias.as_deref(), Some("lan"));
+
+    app.handle_event(&mut tui, &mut server, AppEvent::OpenProxy)
+        .await?;
+    for key in [KeyCode::Char(' '), KeyCode::Enter] {
+        app.handle_tui_event(&mut tui, &mut server, TuiEvent::Key(key.into()))
+            .await?;
+    }
+    let event = events.try_recv().expect("confirmed disabled proxy");
+    config.enabled = false;
+    assert!(
+        matches!(&event, AppEvent::WriteProxyConfig { config: written, reopen_picker: false } if written == &config)
+    );
+    assert!(events.try_recv().is_err());
+    assert!(app.chat_widget.no_modal_or_popup_active());
+    app.handle_event(&mut tui, &mut server, event).await?;
+    assert!(app.proxy_alias.is_none());
+    assert!(app.proxy_address.is_none());
+    let disabled = server.proxy_read().await?;
+    assert_eq!(disabled.config, config);
+    assert!(disabled.generation > enabled.generation);
+    assert!(disabled.active_alias.is_none());
+    assert!(disabled.active_address.is_none());
+    let document: serde_json::Value = serde_json::from_slice(&std::fs::read(&path)?)?;
+    assert_eq!(
+        serde_json::from_value::<ProxyConfig>(document["proxy"].clone())?,
+        config
+    );
+    server.shutdown().await?;
+    Ok(())
+}
