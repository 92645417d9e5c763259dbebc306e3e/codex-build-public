+use super::*;
+use crate::app_event_sender::AppEventSender;
+use crate::dialog::DialogStack;
+use crate::keymap::RuntimeKeymap;
+use crate::tui::FrameRequester;
+use crossterm::event::KeyCode;
+use crossterm::event::KeyEvent;
+use pretty_assertions::assert_eq;
+
+#[test]
+fn adding_a_proxy_uses_real_prompt_callbacks_and_preserves_staged_settings() {
+    let (tx, mut rx) = tokio::sync::mpsc::unbounded_channel();
+    let events = AppEventSender::new(tx);
+    let keymap = RuntimeKeymap::defaults();
+    let frames = FrameRequester::test_dummy();
+    let resources = DialogResources {
+        app_event_tx: &events,
+        keymap: &keymap,
+        frame_requester: &frames,
+        vim_enabled: false,
+    };
+    let mut dialogs = DialogStack::new(frames.clone());
+    let config = ProxyConfig {
+        enabled: true,
+        selected: Some("existing".to_string()),
+        entries: vec![ProxyDefinition {
+            alias: "existing".to_string(),
+            url: "http://127.0.0.1:8080".to_string(),
+        }],
+    };
+    dialogs.push(Box::new(add_alias(config.clone(), &resources)));
+    dialogs.handle_paste("  backup  ".to_string());
+    dialogs.handle_key_event(KeyEvent::from(KeyCode::Enter), None);
+    let AppEvent::OpenProxyAddUrl {
+        config: staged,
+        alias,
+    } = rx.try_recv().expect("URL step")
+    else {
+        panic!("expected URL step")
+    };
+    assert_eq!(staged, config);
+    assert_eq!(alias, "backup");
+    assert!(rx.try_recv().is_err());
+    dialogs.push(Box::new(add_url(staged, alias, &resources)));
+    dialogs.handle_paste(" https://user:secret@127.0.0.1:8443 ".to_string());
+    dialogs.handle_key_event(KeyEvent::from(KeyCode::Enter), None);
+    let AppEvent::WriteProxyConfig {
+        config: written,
+        reopen_picker,
+    } = rx.try_recv().expect("write")
+    else {
+        panic!("expected write")
+    };
+    let mut expected = config;
+    expected.entries.push(ProxyDefinition {
+        alias: "backup".to_string(),
+        url: "https://user:secret@127.0.0.1:8443".to_string(),
+    });
+    assert_eq!(written, expected);
+    assert!(reopen_picker);
+    assert!(!format!("{written:?}").contains("secret"));
+    assert!(rx.try_recv().is_err());
+    assert!(dialogs.is_empty());
+}
+
+#[test]
+fn cancelled_proxy_alias_and_url_prompts_do_not_write() {
+    let (tx, mut rx) = tokio::sync::mpsc::unbounded_channel();
+    let events = AppEventSender::new(tx);
+    let keymap = RuntimeKeymap::defaults();
+    let frames = FrameRequester::test_dummy();
+    let resources = DialogResources {
+        app_event_tx: &events,
+        keymap: &keymap,
+        frame_requester: &frames,
+        vim_enabled: false,
+    };
+    for url_step in [false, true] {
+        let mut dialogs = DialogStack::new(frames.clone());
+        let view = if url_step {
+            add_url(ProxyConfig::default(), "lan".to_string(), &resources)
+        } else {
+            add_alias(ProxyConfig::default(), &resources)
+        };
+        dialogs.push(Box::new(view));
+        dialogs.handle_paste("unfinished".to_string());
+        dialogs.handle_key_event(KeyEvent::from(KeyCode::Esc), None);
+        assert!(rx.try_recv().is_err());
+        assert!(dialogs.is_empty());
+    }
+}
+
+#[test]
+fn independent_proxy_dialogs_use_current_editor_and_list_bindings() {
+    let (tx, mut rx) = tokio::sync::mpsc::unbounded_channel();
+    let events = AppEventSender::new(tx);
+    let mut config = codex_config::types::TuiKeymap::default();
+    config.editor.move_left = Some(codex_config::types::KeybindingsSpec::One(
+        codex_config::types::KeybindingSpec("f2".into()),
+    ));
+    config.list.accept = Some(codex_config::types::KeybindingsSpec::One(
+        codex_config::types::KeybindingSpec("f3".into()),
+    ));
+    let keymap = RuntimeKeymap::from_config(&config).expect("valid dialog bindings");
+    let frames = FrameRequester::test_dummy();
+    let resources = DialogResources {
+        app_event_tx: &events,
+        keymap: &keymap,
+        frame_requester: &frames,
+        vim_enabled: false,
+    };
+    let mut dialogs = DialogStack::new(frames.clone());
+    dialogs.push(Box::new(add_alias(ProxyConfig::default(), &resources)));
+    dialogs.handle_paste("ab".into());
+    dialogs.handle_key_event(KeyEvent::from(KeyCode::F(2)), None);
+    dialogs.handle_paste("x".into());
+    dialogs.handle_key_event(KeyEvent::from(KeyCode::Enter), None);
+    assert!(matches!(rx.try_recv(), Ok(AppEvent::OpenProxyAddUrl { alias, .. }) if alias == "axb"));
+    assert!(dialogs.is_empty());
+    dialogs.push(Box::new(menu(ProxyConfig::default(), &resources)));
+    dialogs.handle_key_event(KeyEvent::from(KeyCode::Enter), None);
+    assert!(!dialogs.is_empty());
+    assert!(rx.try_recv().is_err());
+    dialogs.handle_key_event(KeyEvent::from(KeyCode::F(3)), None);
+    assert!(
+        matches!(rx.try_recv(), Ok(AppEvent::WriteProxyConfig { config, reopen_picker: false }) if config == ProxyConfig::default())
+    );
+    assert!(dialogs.is_empty());
+}
