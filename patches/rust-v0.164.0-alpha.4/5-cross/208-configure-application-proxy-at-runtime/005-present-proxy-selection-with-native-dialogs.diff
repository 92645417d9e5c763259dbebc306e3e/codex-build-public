+use super::*;
+
+fn test_view(
+    config: ProxyConfig,
+) -> (
+    ProxyPickerView,
+    tokio::sync::mpsc::UnboundedReceiver<AppEvent>,
+) {
+    let (tx, rx) = unbounded_channel();
+    (
+        ProxyPickerView::new(
+            config,
+            AppEventSender::new(tx),
+            crate::keymap::RuntimeKeymap::defaults().list,
+            FrameRequester::test_dummy(),
+        ),
+        rx,
+    )
+}
+
+fn render(view: &ProxyPickerView) -> (Buffer, String) {
+    let area = Rect::new(0, 0, 80, view.desired_height(80));
+    let mut buffer = Buffer::empty(area);
+    view.render(area, &mut buffer);
+    let text = buffer.content.iter().map(|cell| cell.symbol()).collect();
+    (buffer, text)
+}
+
+fn alias_cell(buffer: &Buffer) -> &ratatui::buffer::Cell {
+    let y = (0..buffer.area.height)
+        .find(|&y| {
+            (0..buffer.area.width)
+                .map(|x| buffer[(x, y)].symbol())
+                .collect::<String>()
+                .contains("stable-lan")
+        })
+        .expect("proxy row");
+    &buffer[(8, y)]
+}
+
+fn configuration() -> ProxyConfig {
+    ProxyConfig {
+        enabled: false,
+        selected: None,
+        entries: vec![
+            ProxyDefinition {
+                alias: "stable-lan".to_string(),
+                url: "http://192.0.2.1:8080".to_string(),
+            },
+            ProxyDefinition {
+                alias: "backup".to_string(),
+                url: "https://user:secret@192.0.2.2:8443".to_string(),
+            },
+        ],
+    }
+}
