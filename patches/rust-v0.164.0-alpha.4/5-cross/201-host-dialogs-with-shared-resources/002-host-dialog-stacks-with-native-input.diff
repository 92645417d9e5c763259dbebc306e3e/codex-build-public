 use super::*;
+use crate::bottom_pane::SelectionItem;
+use crate::keymap::KeymapContext;
+use crate::keymap::KeymapContextSet;
+use crate::render::renderable::Renderable;
+use crossterm::event::KeyCode;
 use pretty_assertions::assert_eq;
+use ratatui::buffer::Buffer;
+use ratatui::layout::Rect;
 use ratatui::text::Line;
 
 #[test]
@@ -38,3 +45,62 @@ fn custom_and_noncancelable_popup_hints_keep_their_policy() {
         assert_eq!(params.footer_hint, expected);
     }
 }
+
+#[test]
+fn standalone_dialog_host_preserves_backdrop_input_and_nested_navigation() {
+    let (tx, _rx) = tokio::sync::mpsc::unbounded_channel();
+    let app_event_tx = AppEventSender::new(tx);
+    let mut keymap = RuntimeKeymap::defaults();
+    keymap.list.cancel = vec![crate::key_hint::plain(KeyCode::F(2))];
+    let frame_requester = FrameRequester::test_dummy();
+    let resources = DialogResources {
+        app_event_tx: &app_event_tx,
+        keymap: &keymap,
+        frame_requester: &frame_requester,
+        vim_enabled: false,
+    };
+    let mut stack = DialogStack::new(resources.frame_requester.clone());
+    stack.push(Box::new(resources.selection_view(SelectionViewParams {
+        title: Some("Settings".into()),
+        view_id: Some("settings"),
+        items: vec![SelectionItem {
+            name: "Edit".into(),
+            ..Default::default()
+        }],
+        ..SelectionViewParams::picker()
+    })));
+    let (submitted_tx, submitted_rx) = std::sync::mpsc::channel();
+    stack.push(Box::new(resources.text_prompt(CustomPromptView::new(
+        "Alias".into(),
+        "Enter alias".into(),
+        String::new(),
+        None,
+        Box::new(move |text| submitted_tx.send(text).unwrap()),
+    ))));
+    assert!(stack.take_key_chord_reset());
+    assert!(!stack.take_key_chord_reset());
+    assert_eq!(
+        stack.last().unwrap().keymap_contexts(),
+        KeymapContextSet::new(KeymapContext::Editor)
+    );
+    stack.handle_key_event(KeyEvent::from(KeyCode::Char('r')), None);
+    stack.handle_paste("oute".into());
+    let area = Rect::new(7, 3, 80, 20);
+    let mut buffer = Buffer::empty(area);
+    for cell in &mut buffer.content {
+        cell.set_symbol(".");
+    }
+    let dialog = stack.centered_view().unwrap();
+    dialog.render(area, &mut buffer);
+    assert_eq!(buffer[(area.x, area.y)].symbol(), ".");
+    let (x, y) = dialog
+        .cursor_pos(area)
+        .expect("text dialog owns the cursor");
+    assert!(area.contains((x, y).into()));
+    stack.handle_key_event(KeyEvent::from(KeyCode::Enter), None);
+    assert_eq!(submitted_rx.try_recv(), Ok("route".into()));
+    assert_eq!(stack.len(), 1);
+    assert_eq!(stack.last().unwrap().view_id(), Some("settings"));
+    stack.handle_key_event(KeyEvent::from(KeyCode::F(2)), None);
+    assert!(stack.is_empty());
+}
