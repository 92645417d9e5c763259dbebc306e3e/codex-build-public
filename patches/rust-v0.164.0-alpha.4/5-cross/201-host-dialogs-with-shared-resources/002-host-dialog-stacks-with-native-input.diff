+//! Centered settings dialogs retained over the Control Center backdrop.
+
+use super::DialogResources;
+use crate::bottom_pane::BottomPaneView;
+use crate::bottom_pane::CancellationEvent;
+use crate::bottom_pane::CenteredView;
+use crate::bottom_pane::ChatComposer;
+use crate::bottom_pane::SelectionViewParams;
+use crate::bottom_pane::ViewCompletion;
+use crate::key_hint::KeyBinding;
+use crate::tui::FrameRequester;
+use crossterm::event::KeyCode;
+use crossterm::event::KeyEvent;
+use crossterm::event::KeyEventKind;
+use std::ops::Deref;
+use std::time::Instant;
+
+pub(crate) struct DialogStack {
+    views: Vec<Box<dyn BottomPaneView>>,
+    frame_requester: FrameRequester,
+    key_chord_reset_requested: bool,
+}
+
+// The host can inspect retained views, but focus and completion stay with the stack.
+impl Deref for DialogStack {
+    type Target = [Box<dyn BottomPaneView>];
+
+    fn deref(&self) -> &Self::Target {
+        &self.views
+    }
+}
+
+impl DialogStack {
+    pub(crate) fn new(frame_requester: FrameRequester) -> Self {
+        Self {
+            views: Vec::new(),
+            frame_requester,
+            key_chord_reset_requested: false,
+        }
+    }
+
+    pub(crate) fn centered_view(&self) -> Option<CenteredView<'_>> {
+        self.views.last().map(|view| CenteredView(view.as_ref()))
+    }
+
+    pub(crate) fn take_key_chord_reset(&mut self) -> bool {
+        std::mem::take(&mut self.key_chord_reset_requested)
+    }
+
+    pub(crate) fn push(&mut self, view: Box<dyn BottomPaneView>) {
+        self.views.push(view);
+        self.focus_changed();
+    }
+
+    fn clear(&mut self) {
+        if !self.views.is_empty() {
+            self.views.clear();
+            self.focus_changed();
+        }
+    }
+
+    fn focus_changed(&mut self) {
+        self.key_chord_reset_requested = true;
+        self.schedule_active_frame();
+        self.frame_requester.schedule_frame();
+    }
+
+    fn pop_with_completion(&mut self, completion: Option<ViewCompletion>) {
+        self.views.pop();
+        match completion {
+            Some(ViewCompletion::Accepted) => {
+                while self
+                    .views
+                    .last()
+                    .is_some_and(|view| view.dismiss_after_child_accept())
+                {
+                    self.views.pop();
+                }
+            }
+            Some(ViewCompletion::Cancelled) => {
+                if let Some(view) = self.views.last_mut() {
+                    view.clear_dismiss_after_child_accept();
+                }
+            }
+            None => {}
+        }
+        self.focus_changed();
+    }
+
+    pub(crate) fn handle_key_event(&mut self, key: KeyEvent, activation_key: Option<KeyBinding>) {
+        if key.kind == KeyEventKind::Release {
+            return;
+        }
+        let Some(view) = self.views.last_mut() else {
+            return;
+        };
+        let prefer_esc = key.code == KeyCode::Esc && view.prefer_esc_to_handle_key_event();
+        let cancelled = key.code == KeyCode::Esc
+            && !prefer_esc
+            && matches!(view.on_ctrl_c(), CancellationEvent::Handled)
+            && view.is_complete();
+        if !cancelled {
+            view.handle_key_event_with_activation_key(key, activation_key);
+        }
+        let complete = view.is_complete();
+        let completion = view.completion();
+        let in_paste_burst = view.is_in_paste_burst();
+        if complete {
+            self.pop_with_completion(completion);
+        }
+        if (!complete && in_paste_burst)
+            || (cancelled
+                && self
+                    .views
+                    .last()
+                    .is_some_and(|view| view.is_in_paste_burst()))
+        {
+            self.frame_requester
+                .schedule_frame_in(ChatComposer::recommended_paste_flush_delay());
+        }
+        self.frame_requester.schedule_frame();
+    }
+
+    pub(crate) fn on_ctrl_c(&mut self) -> CancellationEvent {
+        let Some(view) = self.views.last_mut() else {
+            return CancellationEvent::NotHandled;
+        };
+        let result = view.on_ctrl_c();
+        let complete = view.is_complete();
+        let completion = view.completion();
+        if matches!(result, CancellationEvent::Handled) {
+            if complete {
+                self.pop_with_completion(completion);
+            }
+            self.frame_requester.schedule_frame();
+        }
+        result
+    }
+
+    /// Return whether completion cleared the stack, allowing its host to restore its input.
+    pub(crate) fn handle_paste(&mut self, text: String) -> bool {
+        let Some(view) = self.views.last_mut() else {
+            return false;
+        };
+        let changed = view.handle_paste(text);
+        let complete = view.is_complete();
+        if complete {
+            self.clear();
+        }
+        if changed || complete {
+            self.frame_requester.schedule_frame();
+        }
+        complete
+    }
+
+    /// Return whether the active view completed and cleared its retained stack.
+    pub(crate) fn pre_draw_tick(&mut self, now: Instant) -> bool {
+        let Some(view) = self.views.last_mut() else {
+            return false;
+        };
+        let changed = view.pre_draw_tick(now);
+        let complete = view.is_complete();
+        if complete {
+            self.clear();
+        }
+        if changed || complete {
+            self.key_chord_reset_requested = true;
+            self.frame_requester.schedule_frame();
+        }
+        self.schedule_active_frame();
+        complete
+    }
+
+    fn schedule_active_frame(&self) {
+        if let Some(delay) = self.views.last().and_then(|view| view.next_frame_delay()) {
+            self.frame_requester.schedule_frame_in(delay);
+        }
+    }
+
+    pub(crate) fn replace_selection_if_present(
+        &mut self,
+        view_id: &'static str,
+        params: SelectionViewParams,
+        resources: DialogResources<'_>,
+    ) -> bool {
+        let Some(index) = self
+            .views
+            .iter()
+            .rposition(|view| view.view_id() == Some(view_id))
+        else {
+            return false;
+        };
+        let mut view = resources.selection_view(params);
+        view.dismiss_after_child_accept = self.views[index].dismiss_after_child_accept();
+        self.views[index] = Box::new(view);
+        if index + 1 == self.views.len() {
+            self.focus_changed();
+        } else {
+            self.frame_requester.schedule_frame();
+        }
+        true
+    }
+}
