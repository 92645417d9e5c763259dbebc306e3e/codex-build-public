+#[tokio::test]
+async fn publishes_same_changes_to_internal_and_connected_consumers() -> anyhow::Result<()> {
+    use crate::outgoing_message::OutgoingEnvelope;
+    use crate::outgoing_message::OutgoingMessage;
+    use codex_app_server_protocol::ModelChange;
+
+    let home = tempdir()?;
+    app_test_support::write_chatgpt_auth(
+        home.path(),
+        app_test_support::ChatGptAuthFixture::new("test-token")
+            .account_id("test-account")
+            .plan_type("plus"),
+        codex_config::types::AuthCredentialsStoreMode::File,
+    )?;
+    let config_manager = crate::config_manager::ConfigManager::without_managed_config_for_tests(
+        home.path().to_path_buf(),
+    );
+    let config = Arc::new(config_manager.load_non_project_config().await?);
+    let auth_manager = AuthManager::shared_from_config(config.as_ref(), false).await?;
+    assert!(personal_chatgpt_account(&auth_manager));
+    let endpoint = TestModelsEndpoint::new();
+    let models_manager: SharedModelsManager = Arc::new(OpenAiModelsManager::new(
+        home.path().to_path_buf(),
+        endpoint.clone(),
+        None,
+    ));
+    let catalog = Arc::new(ModelCatalog::new(
+        config_manager,
+        None,
+        config,
+        models_manager,
+        Arc::clone(&auth_manager),
+    ));
+    let (outgoing_tx, mut outgoing_rx) = mpsc::channel(1);
+    let outgoing = Arc::new(OutgoingMessageSender::new(
+        outgoing_tx,
+        codex_analytics::AnalyticsEventsClient::disabled(),
+    ));
+    let worker = spawn_with_interval(&catalog, auth_manager, outgoing, Duration::from_millis(10));
+    let mut changes = worker.subscribe();
+    endpoint.wait_for_fetch_count(2).await;
+    assert!(changes.try_recv().is_err());
+    assert!(outgoing_rx.try_recv().is_err());
+    endpoint.release_second_fetch.notify_one();
+    let expected = ModelChangedNotification {
+        changes: vec![
+            ModelChange::Added { slug: "new".into() },
+            ModelChange::Removed { slug: "old".into() },
+        ],
+    };
+    assert_eq!(
+        tokio::time::timeout(Duration::from_secs(1), changes.recv()).await??,
+        expected,
+    );
+    let message = tokio::time::timeout(Duration::from_secs(1), outgoing_rx.recv())
+        .await?
+        .expect("one external notification");
+    let OutgoingEnvelope::Broadcast {
+        message: OutgoingMessage::AppServerNotification(envelope),
+    } = message
+    else {
+        panic!("expected global model change notification");
+    };
+    let ServerNotification::ModelChanged(notification) = envelope.notification else {
+        panic!("expected typed model changes");
+    };
+    assert_eq!(notification, expected);
+    endpoint.wait_for_fetch_count(4).await;
+    assert!(changes.try_recv().is_err());
+    assert!(outgoing_rx.try_recv().is_err());
+    drop(worker);
+    Ok(())
+}
