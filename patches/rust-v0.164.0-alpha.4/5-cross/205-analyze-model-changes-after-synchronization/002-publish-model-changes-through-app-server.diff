+#[tokio::test]
+async fn model_change_notification_broadcast_reaches_each_initialized_client() {
+    let (sender, mut outgoing) = mpsc::channel(1);
+    let sender = crate::outgoing_message::OutgoingMessageSender::new(
+        sender,
+        codex_analytics::AnalyticsEventsClient::disabled(),
+    );
+    sender
+        .send_server_notification(ServerNotification::ModelChanged(ModelChangedNotification {
+            changes: vec![
+                ModelChange::Added { slug: "new".into() },
+                ModelChange::Removed { slug: "old".into() },
+            ],
+        }))
+        .await;
+    let envelope = outgoing
+        .recv()
+        .await
+        .expect("one model-change notification");
+    let OutgoingEnvelope::Broadcast { message } = &envelope else {
+        panic!("model changes must use the global broadcast sender");
+    };
+    let expected = serde_json::to_value(message).expect("serialize model-change notification");
+    assert_eq!(expected["method"], "model/changed");
+    assert_eq!(
+        expected["params"],
+        json!({"changes": [{"type": "added", "slug": "new"}, {"type": "removed", "slug": "old"}]})
+    );
+
+    let mut connections = HashMap::new();
+    let mut receivers = Vec::new();
+    for connection_id in [ConnectionId(1), ConnectionId(2)] {
+        let (writer, receiver) = mpsc::channel(1);
+        connections.insert(
+            connection_id,
+            OutboundConnectionState::new(
+                writer,
+                Arc::new(AtomicBool::new(true)),
+                Arc::new(AtomicBool::new(false)),
+                Arc::new(RwLock::new(HashSet::new())),
+                /*disconnect_sender*/ None,
+            ),
+        );
+        receivers.push(receiver);
+    }
+    route_outgoing_envelope(&mut connections, envelope).await;
+    for mut receiver in receivers {
+        let delivered = receiver
+            .recv()
+            .await
+            .expect("initialized client receives the event");
+        assert_eq!(serde_json::to_value(delivered.message).unwrap(), expected);
+        assert!(receiver.try_recv().is_err(), "one event per client");
+    }
+}
