+use codex_app_server_protocol::ModelChange;
+use codex_models_manager::manager::OfficialModelsObservation;
+
+/// A new account or provider establishes a silent baseline.
+pub(crate) fn analyze(
+    previous: Option<&OfficialModelsObservation>,
+    current: &OfficialModelsObservation,
+) -> Vec<ModelChange> {
+    let Some(previous) = previous.filter(|previous| previous.identity == current.identity) else {
+        return Vec::new();
+    };
+    current
+        .slugs
+        .difference(&previous.slugs)
+        .map(|slug| ModelChange::Added { slug: slug.clone() })
+        .chain(
+            previous
+                .slugs
+                .difference(&current.slugs)
+                .map(|slug| ModelChange::Removed { slug: slug.clone() }),
+        )
+        .collect()
+}
+
+#[cfg(test)]
+mod tests {
+    use std::collections::BTreeSet;
+
+    use super::*;
+
+    #[test]
+    fn reports_only_changes_between_same_identity_observations() {
+        let first = OfficialModelsObservation {
+            identity: "account-a".into(),
+            slugs: BTreeSet::from(["old".into(), "retained".into()]),
+        };
+        let second = OfficialModelsObservation {
+            identity: "account-a".into(),
+            slugs: BTreeSet::from(["new".into(), "retained".into()]),
+        };
+        assert!(analyze(None, &first).is_empty());
+        assert!(analyze(Some(&first), &first).is_empty());
+        assert_eq!(
+            analyze(Some(&first), &second),
+            vec![
+                ModelChange::Added { slug: "new".into() },
+                ModelChange::Removed { slug: "old".into() },
+            ]
+        );
+        let different_account = OfficialModelsObservation {
+            identity: "account-b".into(),
+            slugs: second.slugs,
+        };
+        assert!(analyze(Some(&first), &different_account).is_empty());
+    }
+}
