+use super::App;
+use crate::bottom_pane::SelectionViewParams;
+use crate::dialog::DialogResources;
+use crate::telegram_dialogs;
+use crate::telegram_dialogs::TelegramSetupDraft;
+use crate::tui::Tui;
+use codex_app_server_protocol::TelegramCommandResponse;
+use codex_app_server_protocol::TelegramSetup;
+
+impl App {
+    pub(super) fn open_telegram_menu(&mut self, tui: &Tui, config: TelegramCommandResponse) {
+        if config.configured {
+            self.show_telegram_selection(telegram_dialogs::settings());
+            return;
+        }
+        let frames = tui.frame_requester();
+        let resources = DialogResources {
+            app_event_tx: &self.app_event_tx,
+            keymap: &self.keymap,
+            frame_requester: &frames,
+            vim_enabled: self.chat_widget.composer_is_vim_enabled(),
+        };
+        let view = telegram_dialogs::menu(config, &resources);
+        self.chat_widget.show_bottom_pane_view(view);
+    }
+
+    pub(super) fn open_telegram_chat(&mut self, tui: &Tui, draft: TelegramSetupDraft) {
+        let frames = tui.frame_requester();
+        let resources = DialogResources {
+            app_event_tx: &self.app_event_tx,
+            keymap: &self.keymap,
+            frame_requester: &frames,
+            vim_enabled: self.chat_widget.composer_is_vim_enabled(),
+        };
+        let view = telegram_dialogs::chat(draft, &resources);
+        self.chat_widget.show_bottom_pane_view(Box::new(view));
+    }
+
+    pub(super) fn open_telegram_setup(&mut self, tui: &Tui, setup: TelegramSetup) {
+        let frames = tui.frame_requester();
+        let resources = DialogResources {
+            app_event_tx: &self.app_event_tx,
+            keymap: &self.keymap,
+            frame_requester: &frames,
+            vim_enabled: self.chat_widget.composer_is_vim_enabled(),
+        };
+        let view = telegram_dialogs::setup(setup, &resources);
+        self.chat_widget.show_bottom_pane_view(Box::new(view));
+    }
+
+    pub(super) fn open_telegram_notifications(
+        &mut self,
+        tui: &Tui,
+        config: TelegramCommandResponse,
+    ) {
+        let frames = tui.frame_requester();
+        let resources = DialogResources {
+            app_event_tx: &self.app_event_tx,
+            keymap: &self.keymap,
+            frame_requester: &frames,
+            vim_enabled: self.chat_widget.composer_is_vim_enabled(),
+        };
+        let view = telegram_dialogs::notifications(config, &resources);
+        self.chat_widget.show_bottom_pane_view(Box::new(view));
+    }
+
+    fn show_telegram_selection(&mut self, mut params: SelectionViewParams) {
+        if let Some(view_id) = params.view_id
+            && let Some(selected) = self.chat_widget.selected_index_for_present_view(view_id)
+        {
+            params.initial_selected_idx = Some(selected);
+            self.chat_widget
+                .replace_selection_view_if_present(view_id, params);
+        } else {
+            self.chat_widget.show_selection_view(params);
+        }
+    }
+}
