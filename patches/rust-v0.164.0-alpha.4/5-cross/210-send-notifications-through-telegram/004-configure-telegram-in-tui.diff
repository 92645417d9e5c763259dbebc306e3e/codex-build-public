+#[tokio::test]
+async fn setting_results_preserve_local_drafts_without_reopening_closed_dialogs()
+-> color_eyre::Result<()> {
+    let (mut app, mut rx, _ops) = super::make_test_app_with_channels().await;
+    let mut tui = crate::tui::test_support::make_test_tui()?;
+    let mut server = crate::start_embedded_app_server_for_picker(&app.config).await?;
+    let config = TelegramCommandResponse {
+        configured: true,
+        ..Default::default()
+    };
+    app.handle_event(
+        &mut tui,
+        &mut server,
+        AppEvent::TelegramCommandFinished {
+            kind: TelegramCommandKind::Read,
+            result: Ok(config.clone()),
+        },
+    )
+    .await?;
+    app.chat_widget
+        .handle_key_event(crossterm::event::KeyEvent::from(
+            crossterm::event::KeyCode::Down,
+        ));
+    app.open_telegram_notifications(&tui, config.clone());
+    for key in [KeyCode::Char(' '), KeyCode::Down, KeyCode::Char(' ')] {
+        app.handle_tui_event(&mut tui, &mut server, TuiEvent::Key(key.into()))
+            .await?;
+    }
+    assert!(rx.try_recv().is_err());
+    let response = TelegramCommandResponse {
+        notifications: [TelegramNotificationKind::ModelChanges].into(),
+        ..config
+    };
+    app.handle_event(
+        &mut tui,
+        &mut server,
+        AppEvent::TelegramCommandFinished {
+            kind: TelegramCommandKind::SetNotification,
+            result: Ok(response.clone()),
+        },
+    )
+    .await?;
+    app.handle_event(
+        &mut tui,
+        &mut server,
+        AppEvent::TelegramCommandFinished {
+            kind: TelegramCommandKind::Read,
+            result: Ok(response.clone()),
+        },
+    )
+    .await?;
+    let popup = render_bottom_popup(&app.chat_widget, 80);
+    assert!(popup.contains("Telegram notifications"));
+    assert!(popup.contains("[x] Turn completion"));
+    assert!(popup.contains("[x] Input needed"));
+    assert!(popup.contains("[ ] Model changes"));
+    app.handle_tui_event(&mut tui, &mut server, TuiEvent::Key(KeyCode::Esc.into()))
+        .await?;
+    assert_eq!(
+        app.chat_widget
+            .selected_index_for_present_view("telegram-settings"),
+        Some(1)
+    );
+    app.handle_tui_event(&mut tui, &mut server, TuiEvent::Key(KeyCode::Esc.into()))
+        .await?;
+    app.handle_event(
+        &mut tui,
+        &mut server,
+        AppEvent::TelegramCommandFinished {
+            kind: TelegramCommandKind::SetNotification,
+            result: Ok(response),
+        },
+    )
+    .await?;
+    assert!(app.chat_widget.no_modal_or_popup_active());
+    assert!(rx.try_recv().is_err());
+    server.shutdown().await?;
+    Ok(())
+}
