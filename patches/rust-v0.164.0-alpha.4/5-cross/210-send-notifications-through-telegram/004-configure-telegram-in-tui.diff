+#[test]
+fn setup_masks_tokens_and_publishes_one_complete_configuration() {
+    let (tx, mut rx) = tokio::sync::mpsc::unbounded_channel();
+    let events = AppEventSender::new(tx);
+    let mut bindings = codex_config::types::TuiKeymap::default();
+    bindings.editor.move_left = Some(codex_config::types::KeybindingsSpec::One(
+        codex_config::types::KeybindingSpec("f2".into()),
+    ));
+    bindings.list.accept = Some(codex_config::types::KeybindingsSpec::One(
+        codex_config::types::KeybindingSpec("f3".into()),
+    ));
+    let keymap = RuntimeKeymap::from_config(&bindings).expect("valid editor bindings");
+    let frames = FrameRequester::test_dummy();
+    let resources = DialogResources {
+        app_event_tx: &events,
+        keymap: &keymap,
+        frame_requester: &frames,
+        vim_enabled: false,
+    };
+    let mut dialogs = DialogStack::new(frames.clone());
+    dialogs.push(menu(TelegramCommandResponse::default(), &resources));
+    dialogs.handle_paste("bot-secrt".to_string());
+    dialogs.handle_key_event(KeyEvent::from(KeyCode::F(2)), None);
+    dialogs.handle_paste("e".to_string());
+    let popup = render(&dialogs);
+    assert!(popup.contains("Bot token"));
+    assert!(!popup.contains("bot-secret"));
+    assert!(popup.contains("**********"));
+    assert!(rx.try_recv().is_err());
+    dialogs.handle_key_event(KeyEvent::from(KeyCode::Enter), None);
+    let AppEvent::OpenTelegramChat { draft } = rx.try_recv().expect("chat step") else {
+        panic!("expected chat step")
+    };
+    assert!(!format!("{draft:?}").contains("bot-secret"));
+    dialogs.push(Box::new(chat(draft, &resources)));
+    dialogs.handle_paste("chat-id".to_string());
+    dialogs.handle_key_event(KeyEvent::from(KeyCode::Enter), None);
+    let AppEvent::OpenTelegramSetup { setup: configured } = rx.try_recv().expect("setup step")
+    else {
+        panic!("expected setup step")
+    };
+    assert_eq!(
+        configured.notifications,
+        [
+            TelegramNotificationKind::TurnCompletion,
+            TelegramNotificationKind::NeedsInput,
+            TelegramNotificationKind::CodexPrerelease,
+            TelegramNotificationKind::CodexRelease,
+            TelegramNotificationKind::ModelChanges,
+        ]
+        .into()
+    );
+    let debug = format!("{configured:?}");
+    for secret in ["bot-secret", "chat-id"] {
+        assert!(!debug.contains(secret));
+    }
+    assert_eq!(debug.matches("<redacted>").count(), 2);
+    dialogs.push(Box::new(setup(configured, &resources)));
+    dialogs.handle_key_event(KeyEvent::from(KeyCode::Char(' ')), None);
+    dialogs.handle_key_event(KeyEvent::from(KeyCode::Down), None);
+    dialogs.handle_key_event(KeyEvent::from(KeyCode::Char(' ')), None);
+    assert!(rx.try_recv().is_err());
+    assert_eq!(dialogs.len(), 1);
+    dialogs.handle_key_event(KeyEvent::from(KeyCode::Enter), None);
+    assert!(rx.try_recv().is_err());
+    dialogs.handle_key_event(KeyEvent::from(KeyCode::F(3)), None);
+    let AppEvent::TelegramCommand { params } = rx.try_recv().expect("configure command") else {
+        panic!("expected configure")
+    };
+    assert_eq!(
+        params,
+        TelegramCommandParams::Configure {
+            setup: TelegramSetup {
+                bot_token: "bot-secret".to_string(),
+                chat_id: "chat-id".to_string(),
+                notifications: [
+                    TelegramNotificationKind::CodexPrerelease,
+                    TelegramNotificationKind::CodexRelease,
+                    TelegramNotificationKind::ModelChanges,
+                ]
+                .into(),
+            },
+        }
+    );
+    assert!(rx.try_recv().is_err());
+    assert!(dialogs.is_empty());
+}
