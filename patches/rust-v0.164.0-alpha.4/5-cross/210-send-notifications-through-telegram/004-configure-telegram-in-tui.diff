+#[test]
+fn notification_picker_saves_only_confirmed_changes_and_discards_cancellation() {
+    let (tx, mut rx) = tokio::sync::mpsc::unbounded_channel();
+    let events = AppEventSender::new(tx);
+    let keymap = RuntimeKeymap::defaults();
+    let frames = FrameRequester::test_dummy();
+    let resources = DialogResources {
+        app_event_tx: &events,
+        keymap: &keymap,
+        frame_requester: &frames,
+        vim_enabled: false,
+    };
+    let mut dialogs = DialogStack::new(frames.clone());
+    let mut config = TelegramCommandResponse {
+        configured: true,
+        ..Default::default()
+    };
+    dialogs.push(Box::new(notifications(config.clone(), &resources)));
+    let kinds = [
+        TelegramNotificationKind::TurnCompletion,
+        TelegramNotificationKind::NeedsInput,
+        TelegramNotificationKind::CodexPrerelease,
+        TelegramNotificationKind::CodexRelease,
+        TelegramNotificationKind::ModelChanges,
+    ];
+    for index in 0..kinds.len() {
+        dialogs.handle_key_event(KeyEvent::from(KeyCode::Char(' ')), None);
+        assert!(rx.try_recv().is_err());
+        if index < kinds.len() - 1 {
+            dialogs.handle_key_event(KeyEvent::from(KeyCode::Down), None);
+        }
+    }
+    dialogs.handle_key_event(KeyEvent::from(KeyCode::Enter), None);
+    assert!(dialogs.is_empty());
+    for notification in kinds {
+        let AppEvent::TelegramCommand { params } = rx.try_recv().expect("confirmed notification")
+        else {
+            panic!("expected notification selection")
+        };
+        assert_eq!(
+            params,
+            TelegramCommandParams::SetNotification {
+                notification,
+                enabled: true
+            }
+        );
+    }
+    assert!(rx.try_recv().is_err());
+    config.notifications = kinds.into();
+    dialogs.push(Box::new(notifications(config.clone(), &resources)));
+    dialogs.handle_key_event(KeyEvent::from(KeyCode::Char(' ')), None);
+    dialogs.handle_key_event(KeyEvent::from(KeyCode::Esc), None);
+    assert!(dialogs.is_empty());
+    assert!(rx.try_recv().is_err());
+
+    dialogs.push(Box::new(notifications(config, &resources)));
+    for index in 0..kinds.len() {
+        dialogs.handle_key_event(KeyEvent::from(KeyCode::Char(' ')), None);
+        if index < kinds.len() - 1 {
+            dialogs.handle_key_event(KeyEvent::from(KeyCode::Down), None);
+        }
+    }
+    assert!(rx.try_recv().is_err());
+    dialogs.handle_key_event(KeyEvent::from(KeyCode::Enter), None);
+    for notification in kinds {
+        assert!(matches!(rx.try_recv(), Ok(AppEvent::TelegramCommand {
+            params: TelegramCommandParams::SetNotification { notification: changed, enabled: false }
+        }) if changed == notification));
+    }
+    assert!(rx.try_recv().is_err());
+    assert!(dialogs.is_empty());
+}
