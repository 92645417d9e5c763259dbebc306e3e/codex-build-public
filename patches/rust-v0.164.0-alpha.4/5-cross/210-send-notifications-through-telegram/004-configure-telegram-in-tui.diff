+//! Telegram configuration business shared by ordinary and full-screen dialog hosts.
+
+use crate::app_event::AppEvent;
+use crate::bottom_pane::BottomPaneView;
+use crate::bottom_pane::MultiSelectItem;
+use crate::bottom_pane::MultiSelectPicker;
+use crate::bottom_pane::SelectionItem;
+use crate::bottom_pane::SelectionViewParams;
+use crate::bottom_pane::custom_prompt_view::CustomPromptView;
+use crate::dialog::DialogResources;
+use codex_app_server_protocol::TelegramCommandParams;
+use codex_app_server_protocol::TelegramCommandResponse;
+use codex_app_server_protocol::TelegramNotificationKind;
+use codex_app_server_protocol::TelegramSetup;
+use std::collections::BTreeSet;
+
+const SETTINGS_VIEW_ID: &str = "telegram-settings";
+const NOTIFICATION_OPTIONS: [(TelegramNotificationKind, &str); 5] = [
+    (TelegramNotificationKind::TurnCompletion, "Turn completion"),
+    (TelegramNotificationKind::NeedsInput, "Input needed"),
+    (
+        TelegramNotificationKind::CodexPrerelease,
+        "Codex prereleases",
+    ),
+    (TelegramNotificationKind::CodexRelease, "Codex releases"),
+    (TelegramNotificationKind::ModelChanges, "Model changes"),
+];
+
+#[derive(Clone)]
+pub(crate) struct TelegramSetupDraft {
+    bot_token: String,
+}
+
+impl std::fmt::Debug for TelegramSetupDraft {
+    fn fmt(&self, formatter: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        formatter
+            .debug_struct("TelegramSetupDraft")
+            .field("bot_token", &"<redacted>")
+            .finish()
+    }
+}
+
+pub(crate) fn menu(
+    config: TelegramCommandResponse,
+    resources: &DialogResources<'_>,
+) -> Box<dyn BottomPaneView> {
+    if !config.configured {
+        return Box::new(configure(resources));
+    }
+    Box::new(resources.selection_view(settings()))
+}
+
+fn configure(resources: &DialogResources<'_>) -> CustomPromptView {
+    let tx = resources.app_event_tx.clone();
+    resources.text_prompt(CustomPromptView::new_masked(
+        "Bot token".to_string(),
+        "Enter the bot token".to_string(),
+        None,
+        Box::new(move |bot_token| {
+            tx.send(AppEvent::OpenTelegramChat {
+                draft: TelegramSetupDraft { bot_token },
+            });
+        }),
+    ))
+}
+
+pub(crate) fn chat(draft: TelegramSetupDraft, resources: &DialogResources<'_>) -> CustomPromptView {
+    let tx = resources.app_event_tx.clone();
+    resources.text_prompt(CustomPromptView::new(
+        "Chat ID".to_string(),
+        "Enter the chat ID".to_string(),
+        String::new(),
+        None,
+        Box::new(move |chat_id| {
+            tx.send(AppEvent::OpenTelegramSetup {
+                setup: TelegramSetup {
+                    bot_token: draft.bot_token.clone(),
+                    chat_id,
+                    notifications: NOTIFICATION_OPTIONS
+                        .into_iter()
+                        .map(|(kind, _)| kind)
+                        .collect(),
+                },
+            });
+        }),
+    ))
+}
+
+pub(crate) fn setup(setup: TelegramSetup, resources: &DialogResources<'_>) -> MultiSelectPicker {
+    MultiSelectPicker::builder(
+        "Notifications setup".to_owned(),
+        Some("Confirm to test bot delivery, then save.".to_owned()),
+        resources.app_event_tx.clone(),
+    )
+    .list_keymap(resources.keymap.list.clone())
+    .items(notification_items(&setup.notifications))
+    .on_confirm(move |selected, tx| {
+        let mut setup = setup.clone();
+        setup.notifications = selected_notifications(selected);
+        tx.send(AppEvent::TelegramCommand {
+            params: TelegramCommandParams::Configure { setup },
+        });
+    })
+    .build()
+}
+
+pub(crate) fn settings() -> SelectionViewParams {
+    SelectionViewParams {
+        view_id: Some(SETTINGS_VIEW_ID),
+        title: Some("Telegram".to_owned()),
+        items: vec![
+            SelectionItem {
+                name: "Notifications".to_owned(),
+                description: Some("Choose notifications, then confirm to save.".to_owned()),
+                actions: vec![Box::new(|tx| tx.send(AppEvent::OpenTelegramNotifications))],
+                ..Default::default()
+            },
+            SelectionItem {
+                name: "Disable".to_owned(),
+                description: Some("Clear saved Telegram credentials.".to_owned()),
+                actions: vec![Box::new(|tx| {
+                    tx.send(AppEvent::TelegramCommand {
+                        params: TelegramCommandParams::Disable {},
+                    });
+                })],
+                dismiss_on_select: true,
+                ..Default::default()
+            },
+        ],
+        ..SelectionViewParams::picker()
+    }
+}
+
+pub(crate) fn notifications(
+    config: TelegramCommandResponse,
+    resources: &DialogResources<'_>,
+) -> MultiSelectPicker {
+    MultiSelectPicker::builder(
+        "Telegram notifications".to_owned(),
+        None,
+        resources.app_event_tx.clone(),
+    )
+    .list_keymap(resources.keymap.list.clone())
+    .items(notification_items(&config.notifications))
+    .on_confirm(move |selected, tx| {
+        let selected = selected_notifications(selected);
+        for (notification, _) in NOTIFICATION_OPTIONS {
+            let enabled = selected.contains(&notification);
+            if enabled != config.notifications.contains(&notification) {
+                tx.send(AppEvent::TelegramCommand {
+                    params: TelegramCommandParams::SetNotification {
+                        notification,
+                        enabled,
+                    },
+                });
+            }
+        }
+    })
+    .build()
+}
+
+fn notification_items(selected: &BTreeSet<TelegramNotificationKind>) -> Vec<MultiSelectItem> {
+    NOTIFICATION_OPTIONS
+        .into_iter()
+        .map(|(kind, label)| MultiSelectItem {
+            id: label.to_owned(),
+            name: label.to_owned(),
+            enabled: selected.contains(&kind),
+            ..Default::default()
+        })
+        .collect()
+}
+
+fn selected_notifications(selected: &[String]) -> BTreeSet<TelegramNotificationKind> {
+    NOTIFICATION_OPTIONS
+        .into_iter()
+        .filter(|(_, label)| selected.iter().any(|id| id.as_str() == *label))
+        .map(|(kind, _)| kind)
+        .collect()
+}
