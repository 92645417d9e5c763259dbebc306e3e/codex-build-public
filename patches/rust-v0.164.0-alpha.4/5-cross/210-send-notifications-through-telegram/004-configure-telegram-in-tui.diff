+use crate::app::App;
+use crate::app::test_support::make_test_app;
+use crate::app_event::AppEvent;
+use crate::app_event_sender::AppEventSender;
+use crate::app_server_session::AppServerSession;
+use crate::chatwidget::tests::helpers::render_bottom_popup;
+use crate::tui::TuiEvent;
+use codex_app_server_protocol::TelegramCommandKind;
+use codex_app_server_protocol::TelegramCommandParams;
+use codex_app_server_protocol::TelegramCommandResponse;
+use codex_app_server_protocol::TelegramNotificationKind;
+use crossterm::event::KeyCode;
+use pretty_assertions::assert_eq;
+use std::time::Duration;
+use tokio::sync::mpsc::UnboundedReceiver;
+
+async fn finish_command(
+    app: &mut App,
+    tui: &mut crate::tui::Tui,
+    server: &mut AppServerSession,
+    rx: &mut UnboundedReceiver<AppEvent>,
+    expected: TelegramCommandKind,
+) -> color_eyre::Result<AppEvent> {
+    Ok(tokio::time::timeout(Duration::from_secs(10), async {
+        loop {
+            tokio::select! {
+                Some(event) = rx.recv() => {
+                    if matches!(&event, AppEvent::TelegramCommandFinished { kind, .. } if *kind == expected) {
+                        break Ok::<_, color_eyre::eyre::Report>(event);
+                    }
+                    app.handle_event(tui, server, event).await?;
+                }
+                Some(event) = server.next_event() => app.handle_app_server_event(server, event).await,
+            }
+        }
+    }).await??)
+}
+
+#[tokio::test]
+async fn telegram_menu_round_trip_uses_embedded_server_and_saved_configuration()
+-> color_eyre::Result<()> {
+    let (mut app, mut rx, _ops) = super::make_test_app_with_channels().await;
+    let mut tui = crate::tui::test_support::make_test_tui()?;
+    let mut server = crate::start_embedded_app_server_for_picker(&app.config).await?;
+    app.handle_event(&mut tui, &mut server, AppEvent::OpenTelegram)
+        .await?;
+    let event = finish_command(
+        &mut app,
+        &mut tui,
+        &mut server,
+        &mut rx,
+        TelegramCommandKind::Read,
+    )
+    .await?;
+    let AppEvent::TelegramCommandFinished { result, .. } = &event else {
+        panic!("expected result")
+    };
+    assert_eq!(
+        result.as_ref().expect("unconfigured read"),
+        &TelegramCommandResponse::default()
+    );
+    app.handle_event(&mut tui, &mut server, event).await?;
+    assert!(render_bottom_popup(&app.chat_widget, 80).contains("Bot token"));
+
+    app.handle_tui_event(&mut tui, &mut server, TuiEvent::Key(KeyCode::Esc.into()))
+        .await?;
+    server.shutdown().await?;
+    let path = app.config.codex_home.join("integrations.json");
+    std::fs::write(
+        &path,
+        r#"{"telegram":{"bot_token":"bot-secret","chat_id":"chat-secret","notifications":["turnCompletion"]}}"#,
+    )?;
+    let mut server = crate::start_embedded_app_server_for_picker(&app.config).await?;
+    app.handle_event(&mut tui, &mut server, AppEvent::OpenTelegram)
+        .await?;
+    let event = finish_command(
+        &mut app,
+        &mut tui,
+        &mut server,
+        &mut rx,
+        TelegramCommandKind::Read,
+    )
+    .await?;
+    let AppEvent::TelegramCommandFinished { result, .. } = &event else {
+        panic!("expected result")
+    };
+    let response = result.as_ref().expect("configured read");
+    assert!(response.configured);
+    assert_eq!(
+        response.notifications,
+        [TelegramNotificationKind::TurnCompletion].into()
+    );
+    app.handle_event(&mut tui, &mut server, event).await?;
+    let popup = render_bottom_popup(&app.chat_widget, 80);
+    assert!(popup.contains("Notifications") && popup.contains("Disable"));
+    app.handle_tui_event(&mut tui, &mut server, TuiEvent::Key(KeyCode::Enter.into()))
+        .await?;
+    let event = rx.try_recv().expect("notification selection");
+    assert!(matches!(event, AppEvent::OpenTelegramNotifications));
+    app.handle_event(&mut tui, &mut server, event).await?;
+    let popup = render_bottom_popup(&app.chat_widget, 80);
+    assert!(popup.contains("Telegram notifications"));
+    for label in [
+        "Turn completion",
+        "Input needed",
+        "Codex prereleases",
+        "Codex releases",
+        "Model changes",
+    ] {
+        assert!(popup.contains(label));
+    }
+    for secret in ["bot-secret", "chat-secret"] {
+        assert!(!popup.contains(secret));
+    }
+    let original = std::fs::read(&path)?;
+    for key in [
+        KeyCode::Char(' '),
+        KeyCode::Down,
+        KeyCode::Char(' '),
+        KeyCode::End,
+        KeyCode::Char(' '),
+    ] {
+        app.handle_tui_event(&mut tui, &mut server, TuiEvent::Key(key.into()))
+            .await?;
+    }
+    assert!(rx.try_recv().is_err());
+    assert_eq!(std::fs::read(&path)?, original);
+    app.handle_tui_event(&mut tui, &mut server, TuiEvent::Key(KeyCode::Enter.into()))
+        .await?;
+    for (notification, enabled) in [
+        (TelegramNotificationKind::TurnCompletion, false),
+        (TelegramNotificationKind::NeedsInput, true),
+        (TelegramNotificationKind::ModelChanges, true),
+    ] {
+        let event = rx.try_recv().expect("confirmed change");
+        assert!(matches!(&event, AppEvent::TelegramCommand {
+            params: TelegramCommandParams::SetNotification { notification: changed, enabled: selected }
+        } if *changed == notification && *selected == enabled));
+        app.handle_event(&mut tui, &mut server, event).await?;
+    }
+    for _ in 0..3 {
+        let event = finish_command(
+            &mut app,
+            &mut tui,
+            &mut server,
+            &mut rx,
+            TelegramCommandKind::SetNotification,
+        )
+        .await?;
+        assert!(matches!(
+            &event,
+            AppEvent::TelegramCommandFinished { result: Ok(_), .. }
+        ));
+        app.handle_event(&mut tui, &mut server, event).await?;
+    }
+    assert!(render_bottom_popup(&app.chat_widget, 80).contains("Disable"));
+    app.handle_tui_event(&mut tui, &mut server, TuiEvent::Key(KeyCode::Enter.into()))
+        .await?;
+    let event = rx.try_recv().expect("reopen notification selection");
+    assert!(matches!(event, AppEvent::OpenTelegramNotifications));
+    app.handle_event(&mut tui, &mut server, event).await?;
+    let popup = render_bottom_popup(&app.chat_widget, 80);
+    assert!(popup.contains("[ ] Turn completion"));
+    assert!(popup.contains("[x] Input needed"));
+    assert!(popup.contains("[x] Model changes"));
+    let saved = std::fs::read(&path)?;
+    for key in [KeyCode::Char(' '), KeyCode::Esc] {
+        app.handle_tui_event(&mut tui, &mut server, TuiEvent::Key(key.into()))
+            .await?;
+    }
+    assert!(rx.try_recv().is_err());
+    assert_eq!(std::fs::read(&path)?, saved);
+    for key in [KeyCode::Down, KeyCode::Enter] {
+        app.handle_tui_event(&mut tui, &mut server, TuiEvent::Key(key.into()))
+            .await?;
+    }
+    let event = rx.try_recv().expect("disable");
+    assert!(matches!(
+        &event,
+        AppEvent::TelegramCommand {
+            params: TelegramCommandParams::Disable {}
+        }
+    ));
+    assert!(app.chat_widget.no_modal_or_popup_active());
+    app.handle_event(&mut tui, &mut server, event).await?;
+    let event = finish_command(
+        &mut app,
+        &mut tui,
+        &mut server,
+        &mut rx,
+        TelegramCommandKind::Disable,
+    )
+    .await?;
+    let AppEvent::TelegramCommandFinished { result, .. } = event else {
+        panic!("expected result")
+    };
+    assert_eq!(
+        result.expect("disabled"),
+        TelegramCommandResponse::default()
+    );
+    let saved: serde_json::Value = serde_json::from_slice(&std::fs::read(path)?)?;
+    assert!(saved["telegram"].is_null());
+    server.shutdown().await?;
+    Ok(())
+}
