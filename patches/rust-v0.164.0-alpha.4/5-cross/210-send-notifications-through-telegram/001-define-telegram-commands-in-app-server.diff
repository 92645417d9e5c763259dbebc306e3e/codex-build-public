+use super::*;
+use crate::ClientRequest;
+use crate::ClientRequestSerializationScope;
+use pretty_assertions::assert_eq;
+use serde_json::json;
+
+#[test]
+fn command_payloads_keep_durations_numeric_and_fields_command_specific() {
+    assert!(TelegramCommandParams::decl().contains("durationMs: number"));
+    for (command, kind) in [
+        (TelegramCommandParams::Read {}, "read"),
+        (TelegramCommandParams::Disable {}, "disable"),
+    ] {
+        let wire = json!({"kind": kind});
+        assert_eq!(serde_json::to_value(&command).unwrap(), wire);
+        assert_eq!(
+            serde_json::from_value::<TelegramCommandParams>(wire).unwrap(),
+            command
+        );
+        let unexpected = json!({"kind": kind, "text": "unexpected"});
+        assert!(serde_json::from_value::<TelegramCommandParams>(unexpected).is_err());
+    }
+    let completion = TelegramCommandParams::Completion {
+        text: "Completed".into(),
+        duration_ms: 30_000,
+    };
+    let wire = json!({"kind": "completion", "text": "Completed", "durationMs": 30_000});
+    assert_eq!(serde_json::to_value(&completion).unwrap(), wire);
+    assert_eq!(
+        serde_json::from_value::<TelegramCommandParams>(wire).unwrap(),
+        completion
+    );
+    for invalid in [
+        json!({"kind": "needsInput", "text": "Missing event identity"}),
+        json!({"kind": "completion", "text": "Completed", "durationMs": "30000"}),
+        json!({"kind": "completion", "text": "Completed", "durationMs": -1}),
+    ] {
+        assert!(serde_json::from_value::<TelegramCommandParams>(invalid).is_err());
+    }
+    for (notification, name) in [
+        (TelegramNotificationKind::TurnCompletion, "turnCompletion"),
+        (TelegramNotificationKind::NeedsInput, "needsInput"),
+        (TelegramNotificationKind::CodexPrerelease, "codexPrerelease"),
+        (TelegramNotificationKind::CodexRelease, "codexRelease"),
+        (TelegramNotificationKind::ModelChanges, "modelChanges"),
+    ] {
+        let command = TelegramCommandParams::SetNotification {
+            notification,
+            enabled: true,
+        };
+        let wire = json!({"kind": "setNotification", "notification": name, "enabled": true});
+        assert_eq!(serde_json::to_value(&command).unwrap(), wire);
+        assert_eq!(
+            serde_json::from_value::<TelegramCommandParams>(wire).unwrap(),
+            command
+        );
+    }
+}
+
+#[test]
+fn debug_redacts_setup_and_notification_payloads() {
+    let setup = TelegramCommandParams::Configure {
+        setup: TelegramSetup {
+            bot_token: "bot-secret".into(),
+            chat_id: "chat-secret".into(),
+            notifications: BTreeSet::from([TelegramNotificationKind::ModelChanges]),
+        },
+    };
+    let input = TelegramCommandParams::NeedsInput {
+        text: "private-message".into(),
+        notification_id: "private-event".into(),
+    };
+    let debug = format!("{setup:?} {input:?}");
+    for secret in [
+        "bot-secret",
+        "chat-secret",
+        "private-message",
+        "private-event",
+    ] {
+        assert!(!debug.contains(secret));
+    }
+    assert_eq!(debug.matches("<redacted>").count(), 4);
+}
+
+#[test]
+fn only_setting_reads_bypass_telegram_command_serialization() {
+    let read = ClientRequest::TelegramCommand {
+        request_id: crate::RequestId::Integer(1),
+        params: TelegramCommandParams::Read {},
+    };
+    assert_eq!(read.serialization_scope(), None);
+    for params in [
+        TelegramCommandParams::Configure {
+            setup: TelegramSetup {
+                bot_token: "bot".into(),
+                chat_id: "chat".into(),
+                notifications: BTreeSet::from([TelegramNotificationKind::TurnCompletion]),
+            },
+        },
+        TelegramCommandParams::SetNotification {
+            notification: TelegramNotificationKind::NeedsInput,
+            enabled: false,
+        },
+        TelegramCommandParams::Disable {},
+        TelegramCommandParams::Completion {
+            text: "done".into(),
+            duration_ms: 30_000,
+        },
+        TelegramCommandParams::NeedsInput {
+            text: "question".into(),
+            notification_id: "question-1".into(),
+        },
+    ] {
+        let request = ClientRequest::TelegramCommand {
+            request_id: crate::RequestId::Integer(2),
+            params,
+        };
+        assert_eq!(
+            request.serialization_scope(),
+            Some(ClientRequestSerializationScope::Global("telegram"))
+        );
+    }
+}
