+fn validate_credential(value: &str, field: &str) -> io::Result<()> {
+    if value.trim().is_empty() || value.chars().any(char::is_control) {
+        return Err(io::Error::new(
+            io::ErrorKind::InvalidData,
+            format!("invalid {field}"),
+        ));
+    }
+    Ok(())
+}
