+use std::os::unix::fs::MetadataExt;
+
+use codex_app_server_protocol::ProxyDefinition;
+use pretty_assertions::assert_eq;
+
+use super::*;
+
+fn telegram_config() -> TelegramConfig {
+    TelegramConfig {
+        bot_token: "bot-secret".into(),
+        chat_id: "chat-secret".into(),
+        notifications: BTreeSet::from([
+            TelegramNotificationKind::TurnCompletion,
+            TelegramNotificationKind::NeedsInput,
+            TelegramNotificationKind::ModelChanges,
+        ]),
+        completion_min_duration_ms: default_completion_min_duration_ms(),
+    }
+}
+
+#[test]
+fn loads_shared_settings_and_redacts_credentials() {
+    let home = tempfile::tempdir().unwrap();
+    let store = IntegrationsStore::load(home.path()).unwrap();
+    assert_eq!(store.proxy(), ProxyConfig::default());
+    assert!(store.github().is_none());
+    assert!(store.telegram().is_none());
+    let config = IntegrationsConfig {
+        proxy: ProxyConfig {
+            entries: vec![ProxyDefinition {
+                alias: "local".into(),
+                url: "http://user:proxy-secret@localhost:8080".into(),
+            }],
+            ..ProxyConfig::default()
+        },
+        github: Some(GithubConfig {
+            token: "github-secret".into(),
+            check_interval_hours: DEFAULT_GITHUB_CHECK_INTERVAL_HOURS,
+        }),
+        telegram: Some(telegram_config()),
+    };
+    let rendered = format!("{config:?}");
+    for secret in ["proxy-secret", "github-secret", "bot-secret", "chat-secret"] {
+        assert!(!rendered.contains(secret));
+    }
+    std::fs::write(
+        home.path().join(INTEGRATIONS_FILE_NAME),
+        serde_json::to_vec(&config).unwrap(),
+    )
+    .unwrap();
+    let store = IntegrationsStore::load(home.path()).unwrap();
+    assert_eq!(store.proxy(), config.proxy);
+    assert_eq!(store.github().unwrap().token, "github-secret");
+    assert_eq!(
+        store.telegram().unwrap().notifications,
+        telegram_config().notifications
+    );
+}
+
+#[tokio::test]
+async fn concurrent_updates_preserve_other_sections_and_private_permissions() {
+    let home = tempfile::tempdir().unwrap();
+    std::fs::write(
+        home.path().join(INTEGRATIONS_FILE_NAME),
+        r#"{"github":{"token":"github-secret"}}"#,
+    )
+    .unwrap();
+    let store = Arc::new(IntegrationsStore::load(home.path()).unwrap());
+    let proxy = ProxyConfig {
+        enabled: true,
+        selected: Some("local".into()),
+        entries: vec![ProxyDefinition {
+            alias: "local".into(),
+            url: "http://localhost:8080".into(),
+        }],
+    };
+    let (proxy_result, telegram_result) = tokio::join!(
+        store.set_proxy(proxy.clone()),
+        store.set_telegram(Some(telegram_config())),
+    );
+    proxy_result.unwrap();
+    telegram_result.unwrap();
+    let reloaded = IntegrationsStore::load(home.path()).unwrap();
+    assert_eq!(reloaded.proxy(), proxy);
+    assert_eq!(reloaded.github().unwrap().token, "github-secret");
+    assert_eq!(reloaded.github().unwrap().check_interval_hours, 20);
+    assert_eq!(
+        reloaded.telegram().unwrap().completion_min_duration_ms,
+        30_000
+    );
+    assert_eq!(
+        std::fs::metadata(home.path().join(INTEGRATIONS_FILE_NAME))
+            .unwrap()
+            .mode()
+            & 0o777,
+        0o600,
+    );
+    store.set_telegram(None).await.unwrap();
+    let reloaded = IntegrationsStore::load(home.path()).unwrap();
+    assert!(reloaded.telegram().is_none());
+    assert_eq!(reloaded.proxy(), proxy);
+    assert_eq!(reloaded.github().unwrap().token, "github-secret");
+}
+
+#[tokio::test]
+async fn failed_writes_preserve_active_settings() {
+    let home = tempfile::tempdir().unwrap();
+    let store = Arc::new(IntegrationsStore::load(home.path()).unwrap());
+    std::fs::create_dir(home.path().join(INTEGRATIONS_FILE_NAME)).unwrap();
+    assert!(store.set_telegram(Some(telegram_config())).await.is_err());
+    assert!(store.telegram().is_none());
+    assert_eq!(store.proxy(), ProxyConfig::default());
+}
+
+#[test]
+fn invalid_settings_report_fields_without_secret_values() {
+    let home = tempfile::tempdir().unwrap();
+    for contents in [
+        r#"{"github":{"token":"github-secret","check_interval_hours":0}}"#,
+        r#"{"telegram":{"bot_token":"bot-secret","chat_id":"chat-secret","notifications":["secret-invalid-kind"]}}"#,
+        r#"{"github":{"token":"github-secret","secret-unexpected-field":1}}"#,
+        "",
+    ] {
+        std::fs::write(home.path().join(INTEGRATIONS_FILE_NAME), contents).unwrap();
+        let error = IntegrationsStore::load(home.path())
+            .err()
+            .expect("invalid settings");
+        assert_eq!(error.kind(), io::ErrorKind::InvalidData);
+        assert!(!error.to_string().contains("secret"));
+    }
+}
+
+#[tokio::test]
+async fn shared_settings_reject_symlinks_on_load_and_write() {
+    let home = tempfile::tempdir().unwrap();
+    let store = Arc::new(IntegrationsStore::load(home.path()).unwrap());
+    std::os::unix::fs::symlink("target", home.path().join(INTEGRATIONS_FILE_NAME)).unwrap();
+    let error = IntegrationsStore::load(home.path())
+        .err()
+        .expect("symlink rejected");
+    assert_eq!(error.kind(), io::ErrorKind::InvalidInput);
+    let error = store
+        .set_telegram(Some(telegram_config()))
+        .await
+        .unwrap_err();
+    assert_eq!(error.kind(), io::ErrorKind::InvalidInput);
+    assert!(!home.path().join("target").exists());
+    assert!(store.telegram().is_none());
+}
