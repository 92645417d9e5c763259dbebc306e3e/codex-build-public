+impl GithubConfig {
+    fn validate(&self) -> io::Result<()> {
+        validate_credential(&self.token, "github.token")?;
+        if !(MIN_GITHUB_CHECK_INTERVAL_HOURS..=MAX_GITHUB_CHECK_INTERVAL_HOURS)
+            .contains(&self.check_interval_hours)
+        {
+            return Err(io::Error::new(
+                io::ErrorKind::InvalidData,
+                "github.check_interval_hours must be between 1 and 168",
+            ));
+        }
+        Ok(())
+    }
+}
