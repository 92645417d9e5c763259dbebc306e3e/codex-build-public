+/// Shared by all integration processors in one app-server process.
+pub(crate) struct IntegrationsStore {
+    path: PathBuf,
+    config: Mutex<IntegrationsConfig>,
+}
+
+impl IntegrationsStore {
+    pub(crate) fn load(codex_home: &Path) -> io::Result<Self> {
+        let path = codex_home.join(INTEGRATIONS_FILE_NAME);
+        reject_symlink(&path)?;
+        let config: IntegrationsConfig = match std::fs::read(&path) {
+            Ok(contents) => serde_json::from_slice(&contents).map_err(|error| {
+                io::Error::new(
+                    io::ErrorKind::InvalidData,
+                    format!(
+                        "invalid integrations.json at line {}, column {}",
+                        error.line(),
+                        error.column(),
+                    ),
+                )
+            })?,
+            Err(error) if error.kind() == io::ErrorKind::NotFound => IntegrationsConfig::default(),
+            Err(error) => return Err(error),
+        };
+        if let Some(github) = &config.github {
+            github.validate()?;
+        }
+        if let Some(telegram) = &config.telegram {
+            telegram.validate()?;
+        }
+        Ok(Self {
+            path,
+            config: Mutex::new(config),
+        })
+    }
+
+    pub(crate) fn proxy(&self) -> ProxyConfig {
+        self.config
+            .lock()
+            .expect("integration settings")
+            .proxy
+            .clone()
+    }
+
+    pub(crate) fn github(&self) -> Option<GithubConfig> {
+        self.config
+            .lock()
+            .expect("integration settings")
+            .github
+            .clone()
+    }
+
+    pub(crate) fn telegram(&self) -> Option<TelegramConfig> {
+        self.config
+            .lock()
+            .expect("integration settings")
+            .telegram
+            .clone()
+    }
+
+    /// Persist a proxy configuration already validated by the routing owner.
+    pub(crate) async fn set_proxy(self: &Arc<Self>, proxy: ProxyConfig) -> io::Result<()> {
+        self.update(move |config| config.proxy = proxy).await
+    }
+
+    /// Persist validated Telegram settings, or disable Telegram alone.
+    pub(crate) async fn set_telegram(
+        self: &Arc<Self>,
+        telegram: Option<TelegramConfig>,
+    ) -> io::Result<()> {
+        self.update(move |config| config.telegram = telegram).await
+    }
+
+    async fn update(
+        self: &Arc<Self>,
+        update: impl FnOnce(&mut IntegrationsConfig) + Send + 'static,
+    ) -> io::Result<()> {
+        let store = Arc::clone(self);
+        tokio::task::spawn_blocking(move || {
+            let mut config = store.config.lock().expect("integration settings");
+            // A failed write must leave the currently active settings intact.
+            let mut next = config.clone();
+            update(&mut next);
+            reject_symlink(&store.path)?;
+            let parent = store.path.parent().expect("integration settings parent");
+            std::fs::create_dir_all(parent)?;
+            let mut file = NamedTempFile::new_in(parent)?;
+            serde_json::to_writer_pretty(&mut file, &next).map_err(io::Error::other)?;
+            file.write_all(b"\n")?;
+            file.as_file().sync_all()?;
+            file.persist(&store.path)?;
+            *config = next;
+            Ok(())
+        })
+        .await
+        .map_err(io::Error::other)?
+    }
+}
+
+fn reject_symlink(path: &Path) -> io::Result<()> {
+    match std::fs::symlink_metadata(path) {
+        Ok(metadata) if metadata.file_type().is_symlink() => Err(io::Error::new(
+            io::ErrorKind::InvalidInput,
+            "integrations.json must not be a symlink",
+        )),
+        Ok(_) => Ok(()),
+        Err(error) if error.kind() == io::ErrorKind::NotFound => Ok(()),
+        Err(error) => Err(error),
+    }
+}
