diff --git a/codex-rs/app-server/src/integrations.rs b/codex-rs/app-server/src/integrations.rs
new file mode 100644
--- /dev/null
+++ b/codex-rs/app-server/src/integrations.rs
@@ -0,0 +1,70 @@
+use std::collections::BTreeSet;
+use std::fmt;
+
+use codex_app_server_protocol::ProxyConfig;
+use codex_app_server_protocol::TelegramNotificationKind;
+use serde::Deserialize;
+use serde::Serialize;
+
+pub(crate) const DEFAULT_GITHUB_CHECK_INTERVAL_HOURS: u16 = 20;
+pub(crate) const MIN_GITHUB_CHECK_INTERVAL_HOURS: u16 = 1;
+pub(crate) const MAX_GITHUB_CHECK_INTERVAL_HOURS: u16 = 168;
+
+#[derive(Clone, Debug, Default, Deserialize, Serialize)]
+#[serde(default, deny_unknown_fields)]
+pub(crate) struct IntegrationsConfig {
+    pub(crate) proxy: ProxyConfig,
+    pub(crate) github: Option<GithubConfig>,
+    pub(crate) telegram: Option<TelegramConfig>,
+}
+
+#[derive(Clone, Deserialize, Serialize)]
+#[serde(deny_unknown_fields)]
+pub(crate) struct GithubConfig {
+    pub(crate) token: String,
+    #[serde(default = "default_github_check_interval_hours")]
+    pub(crate) check_interval_hours: u16,
+}
+
+impl fmt::Debug for GithubConfig {
+    fn fmt(&self, formatter: &mut fmt::Formatter<'_>) -> fmt::Result {
+        formatter
+            .debug_struct("GithubConfig")
+            .field("token", &"<redacted>")
+            .field("check_interval_hours", &self.check_interval_hours)
+            .finish()
+    }
+}
+
+#[derive(Clone, Deserialize, Serialize)]
+#[serde(deny_unknown_fields)]
+pub(crate) struct TelegramConfig {
+    pub(crate) bot_token: String,
+    pub(crate) chat_id: String,
+    pub(crate) notifications: BTreeSet<TelegramNotificationKind>,
+    #[serde(default = "default_completion_min_duration_ms")]
+    pub(crate) completion_min_duration_ms: u64,
+}
+
+impl fmt::Debug for TelegramConfig {
+    fn fmt(&self, formatter: &mut fmt::Formatter<'_>) -> fmt::Result {
+        formatter
+            .debug_struct("TelegramConfig")
+            .field("bot_token", &"<redacted>")
+            .field("chat_id", &"<redacted>")
+            .field("notifications", &self.notifications)
+            .field(
+                "completion_min_duration_ms",
+                &self.completion_min_duration_ms,
+            )
+            .finish()
+    }
+}
+
+fn default_github_check_interval_hours() -> u16 {
+    DEFAULT_GITHUB_CHECK_INTERVAL_HOURS
+}
+
+pub(crate) fn default_completion_min_duration_ms() -> u64 {
+    30_000
+}
