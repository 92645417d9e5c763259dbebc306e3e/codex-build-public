@@ -0,0 +1,48 @@
+use std::fmt;
+
+use crate::JsonSchema;
+use crate::TS;
+use serde::Deserialize;
+use serde::Serialize;
+
+/// One named application proxy, independent of shell and sandbox network settings.
+#[derive(Clone, Deserialize, Eq, JsonSchema, PartialEq, Serialize, TS)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+#[ts(export_to = "v2/")]
+pub struct ProxyDefinition {
+    pub alias: String,
+    pub url: String,
+}
+
+impl fmt::Debug for ProxyDefinition {
+    fn fmt(&self, formatter: &mut fmt::Formatter<'_>) -> fmt::Result {
+        formatter
+            .debug_struct("ProxyDefinition")
+            .field("alias", &self.alias)
+            .field("url", &"<redacted>")
+            .finish()
+    }
+}
+
+#[derive(Clone, Debug, Default, Deserialize, Eq, JsonSchema, PartialEq, Serialize, TS)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+#[ts(export_to = "v2/")]
+pub struct ProxyConfig {
+    pub enabled: bool,
+    pub selected: Option<String>,
+    pub entries: Vec<ProxyDefinition>,
+}
+
+/// Independently selectable Telegram notification sources.
+#[derive(
+    Clone, Copy, Debug, Deserialize, Eq, JsonSchema, Ord, PartialEq, PartialOrd, Serialize, TS,
+)]
+#[serde(rename_all = "camelCase")]
+#[ts(export_to = "v2/")]
+pub enum TelegramNotificationKind {
+    TurnCompletion,
+    NeedsInput,
+    CodexPrerelease,
+    CodexRelease,
+    ModelChanges,
+}
