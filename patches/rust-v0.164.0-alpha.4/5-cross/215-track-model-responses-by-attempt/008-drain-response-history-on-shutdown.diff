+        final_record.tokens.output = Some(77);
+        let (shutdown, stopped) = oneshot::channel();
+        let (flush, flushed) = oneshot::channel();
+        // No await: all three commands are accepted before shutdown closes admission.
+        assert!(backup.sender.send(Command::Shutdown(shutdown)).is_ok());
