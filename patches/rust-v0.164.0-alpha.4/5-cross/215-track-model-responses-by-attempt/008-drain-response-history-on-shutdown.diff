+#[tokio::test]
+async fn shutdown_drains_final_writes_before_native_pool_closure() {
+    let home = tempfile::tempdir().unwrap();
+    let sqlite = SqliteConfig::new_for_testing(home.path().abs());
+    let (metrics, history, runtime) = recording(home.path()).await;
+    let attempt = metrics.start(context(), Instant::now(), chrono::Utc::now().timestamp());
+    attempt.sent(Instant::now());
+    attempt.received(
+        ResponseObservation {
+            payload_bytes: 512,
+            usage: Some(json!({"output_tokens": 17})),
+            terminal: Some(ResponseAttemptEnd::Completed),
+            ..Default::default()
+        },
+        Instant::now(),
+    );
+    attempt.ended(ResponseAttemptEnd::Completed, Instant::now());
+    let expected = history.notification_snapshot()[0].clone();
+    // No flush or yield before shutdown: its acknowledgement owns the final write.
+    history.shutdown().await.unwrap();
+    runtime.close().await;
+    let path = sqlite.logs_db_path();
+    assert!(!path.with_extension("sqlite-wal").exists());
+    assert!(!path.with_extension("sqlite-shm").exists());
+    let standalone_home = tempfile::tempdir().unwrap();
+    let standalone_sqlite = SqliteConfig::new_for_testing(standalone_home.path().abs());
+    std::fs::copy(&path, standalone_sqlite.logs_db_path()).unwrap();
+    let reopened = codex_state::StateRuntime::init(standalone_sqlite, "test".into())
+        .await
+        .unwrap();
+    let saved = reopened
+        .response_history()
+        .page(None, None, None, None, 10)
+        .await
+        .unwrap();
+    assert_eq!(saved.data, vec![expected]);
+    reopened.close().await;
