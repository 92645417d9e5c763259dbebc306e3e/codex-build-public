+use super::*;
+use codex_http_client::OutboundProxyPolicy;
+use pretty_assertions::assert_eq;
+use serde_json::Value;
+use serde_json::json;
+use wiremock::Mock;
+use wiremock::MockServer;
+use wiremock::ResponseTemplate;
+use wiremock::matchers::method;
+use wiremock::matchers::path;
+
+fn client(server: &MockServer) -> GithubHttp {
+    GithubHttp::with_url(
+        HttpClientFactory::new(OutboundProxyPolicy::ReqwestDefault),
+        Url::parse(&server.uri()).expect("mock URL"),
+    )
+}
+
+#[tokio::test]
+async fn release_query_selects_only_required_fields_and_independent_channels() {
+    let server = MockServer::start().await;
+    Mock::given(method("POST"))
+        .and(path("/graphql"))
+        .respond_with(
+            ResponseTemplate::new(200)
+                .insert_header("x-ratelimit-remaining", "4999")
+                .set_body_json(json!({
+                    "data": { "repository": { "releases": { "nodes": [
+                        {"tagName": "rust-v9.0.0", "url": "https://example.invalid/stable", "isDraft": false},
+                        {"tagName": "rust-v9.1.0-alpha.2", "url": "https://example.invalid/alpha", "isDraft": false},
+                        {"tagName": "rust-v10.0.0", "url": "https://example.invalid/draft", "isDraft": true},
+                        {"tagName": "rust-v8.0.0", "url": "https://example.invalid/old-stable", "isDraft": false},
+                        {"tagName": "rust-v9.1.0-alpha.1", "url": "https://example.invalid/old-alpha", "isDraft": false},
+                        {"tagName": "other-v11.0.0", "url": "https://example.invalid/other", "isDraft": false},
+                        {"tagName": "rust-vinvalid", "url": "https://example.invalid/invalid", "isDraft": false}
+                    ] } } }
+                })),
+        )
+        .expect(1)
+        .mount(&server)
+        .await;
+
+    let status = client(&server)
+        .releases("github-token")
+        .await
+        .expect("GitHub observation");
+    assert_eq!(status.remaining, Some(4999));
+    assert!(status.checked_at > 0);
+    assert_eq!(
+        status.latest_release,
+        Some(GithubRelease {
+            version: "9.0.0".into(),
+            url: "https://example.invalid/stable".into(),
+        })
+    );
+    assert_eq!(
+        status.latest_prerelease,
+        Some(GithubRelease {
+            version: "9.1.0-alpha.2".into(),
+            url: "https://example.invalid/alpha".into(),
+        })
+    );
+    let requests = server.received_requests().await.expect("requests");
+    assert_eq!(
+        requests[0].headers["authorization"].to_str().ok(),
+        Some("Bearer github-token")
+    );
+    let body: Value = serde_json::from_slice(&requests[0].body).expect("GraphQL JSON");
+    let query = body["query"].as_str().expect("query");
+    assert!(query.contains("first: 10") && query.contains("CREATED_AT"));
+    for field in ["tagName", "url", "isDraft"] {
+        assert!(query.contains(field), "{field}");
+    }
+    for unused in ["releaseAssets", "description", "author"] {
+        assert!(!query.contains(unused), "{unused}");
+    }
+}
+
+#[tokio::test]
+async fn secret_bearing_github_requests_do_not_follow_redirects() {
+    let server = MockServer::start().await;
+    Mock::given(method("POST"))
+        .and(path("/graphql"))
+        .respond_with(
+            ResponseTemplate::new(307)
+                .insert_header("location", format!("{}/redirected", server.uri())),
+        )
+        .expect(1)
+        .mount(&server)
+        .await;
+    Mock::given(path("/redirected"))
+        .respond_with(ResponseTemplate::new(200))
+        .expect(0)
+        .mount(&server)
+        .await;
+    assert!(client(&server).releases("github-token").await.is_err());
+}
+
+#[tokio::test]
+async fn github_rejects_oversized_response_bodies() {
+    let server = MockServer::start().await;
+    Mock::given(method("POST"))
+        .and(path("/graphql"))
+        .respond_with(ResponseTemplate::new(200).set_body_json(json!({
+            "data": { "repository": { "releases": { "nodes": [{
+                "tagName": "rust-v9.0.0",
+                "url": "x".repeat(RESPONSE_LIMIT),
+                "isDraft": false
+            }] } } }
+        })))
+        .expect(1)
+        .mount(&server)
+        .await;
+    assert!(client(&server).releases("github-token").await.is_err());
+}
+
+#[tokio::test]
+async fn graphql_errors_reject_absent_and_partial_observations() {
+    for data in [
+        Value::Null,
+        json!({"repository": {"releases": {"nodes": []}}}),
+    ] {
+        let server = MockServer::start().await;
+        Mock::given(method("POST"))
+            .and(path("/graphql"))
+            .respond_with(ResponseTemplate::new(200).set_body_json(json!({
+                "data": data,
+                "errors": [{"message": "Resource not accessible"}]
+            })))
+            .expect(1)
+            .mount(&server)
+            .await;
+        assert!(client(&server).releases("github-token").await.is_err());
+    }
+}
