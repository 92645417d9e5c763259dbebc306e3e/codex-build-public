diff --git a/codex-rs/app-server-protocol/src/protocol/v2/github.rs b/codex-rs/app-server-protocol/src/protocol/v2/github.rs
new file mode 100644
--- /dev/null
+++ b/codex-rs/app-server-protocol/src/protocol/v2/github.rs
@@ -0,0 +1,80 @@
+use crate::JsonSchema;
+use crate::TS;
+use serde::Deserialize;
+use serde::Serialize;
+
+#[derive(Clone, Debug, Deserialize, Eq, JsonSchema, PartialEq, Serialize, TS)]
+#[serde(rename_all = "camelCase")]
+#[ts(export_to = "v2/")]
+pub struct GithubRelease {
+    pub version: String,
+    pub url: String,
+}
+
+/// The latest successful observation from the bounded Codex release query.
+#[derive(Clone, Debug, Deserialize, Eq, JsonSchema, PartialEq, Serialize, TS)]
+#[serde(rename_all = "camelCase")]
+#[ts(export_to = "v2/")]
+pub struct GithubStatus {
+    pub latest_release: Option<GithubRelease>,
+    pub latest_prerelease: Option<GithubRelease>,
+    /// Time of the successful GitHub response, in Unix seconds.
+    #[ts(type = "number")]
+    pub checked_at: i64,
+    /// Remaining GraphQL points from the response header, when supplied.
+    #[ts(type = "number | null")]
+    pub remaining: Option<u64>,
+}
+
+/// Cached observations, without waiting for a network check or exposing credentials.
+#[derive(Clone, Debug, Default, Deserialize, Eq, JsonSchema, PartialEq, Serialize, TS)]
+#[serde(rename_all = "camelCase")]
+#[ts(export_to = "v2/")]
+pub struct GithubReadResponse {
+    pub configured: bool,
+    /// Cleared after a failed check; absent before the first successful check.
+    pub status: Option<GithubStatus>,
+}
+
+#[derive(Clone, Debug, Deserialize, Eq, JsonSchema, PartialEq, Serialize, TS)]
+#[serde(rename_all = "camelCase")]
+#[ts(export_to = "v2/")]
+pub struct GithubCheckResponse {
+    /// False when the thirty-second manual-check throttle reused cached observations.
+    pub performed: bool,
+    pub status: Option<GithubStatus>,
+}
+
+#[cfg(test)]
+mod tests {
+    use crate::ClientRequest;
+    use crate::ClientRequestSerializationScope;
+    use crate::RequestId;
+    use pretty_assertions::assert_eq;
+    use serde_json::json;
+
+    #[test]
+    fn github_reads_are_independent_of_serialized_network_checks() {
+        let read = ClientRequest::GithubRead {
+            request_id: RequestId::Integer(1),
+            params: None,
+        };
+        assert_eq!(read.serialization_scope(), None);
+        assert_eq!(
+            serde_json::to_value(read).unwrap(),
+            json!({"id": 1, "method": "github/read"})
+        );
+        let check = ClientRequest::GithubCheck {
+            request_id: RequestId::Integer(2),
+            params: None,
+        };
+        assert_eq!(
+            check.serialization_scope(),
+            Some(ClientRequestSerializationScope::Global("github"))
+        );
+        assert_eq!(
+            serde_json::to_value(check).unwrap(),
+            json!({"id": 2, "method": "github/check"})
+        );
+    }
+}
