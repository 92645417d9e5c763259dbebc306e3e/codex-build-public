+use super::*;
+use pretty_assertions::assert_eq;
+use std::os::unix::fs::PermissionsExt;
+
+#[test]
+fn harness_directory_preserves_private_socket_guards() {
+    if std::env::var_os("CODEX_TEST_DAEMON_DIRECTORY").is_none() {
+        let temporary = tempfile::tempdir().unwrap();
+        let harness = temporary.path().join("harness");
+        let home = temporary.path().join("home");
+        let scratch = temporary.path().join("temporary");
+        for directory in [&harness, &home, &scratch] {
+            fs::create_dir(directory).unwrap();
+        }
+        let output = std::process::Command::new(std::env::current_exe().unwrap())
+            .args([
+                "--exact",
+                "daemon_directory::tests::harness_directory_preserves_private_socket_guards",
+                "--nocapture",
+            ])
+            .env("CODEX_TEST_DAEMON_DIRECTORY", "1")
+            .env("CODEX_HARNESS", &harness)
+            .env("CODEX_HOME", &home)
+            .env("TMPDIR", &scratch)
+            .output()
+            .unwrap();
+        assert!(output.status.success(), "{output:?}");
+        assert!(String::from_utf8_lossy(&output.stdout).contains("harness guards verified"));
+        assert_eq!(fs::read_dir(home).unwrap().count(), 0);
+        assert_eq!(fs::read_dir(scratch).unwrap().count(), 0);
+        return;
+    }
+
+    let harness = fs::canonicalize(std::env::var_os("CODEX_HARNESS").unwrap()).unwrap();
+    let uid = unsafe { libc::geteuid() };
