+async fn check_structured_turn_wait(timeout: Option<Duration>, cancel: bool) {
+    let listener = tokio::net::TcpListener::bind("127.0.0.1:0").await.unwrap();
+    let address = listener.local_addr().unwrap();
+    let (requests_tx, mut requests) = unbounded_channel();
+    let server = tokio::spawn(async move {
+        let (stream, _) = listener.accept().await.unwrap();
+        let mut socket = tokio_tungstenite::accept_async(stream).await.unwrap();
+        while let Some(frame) = socket.next().await {
+            let frame = frame.unwrap();
+            if frame.is_close() {
+                break;
+            }
+            if !frame.is_text() {
+                continue;
+            }
+            let request: serde_json::Value =
+                serde_json::from_str(frame.to_text().unwrap()).unwrap();
+            let method = request["method"].as_str().unwrap();
+            let result = match method {
+                "initialize" => {
+                    json!({"userAgent":"structured-turn-test","codexHome":"/server/.codex"})
+                }
+                "initialized" => continue,
+                "turn/start" => json!({"turn":{"id":"turn-1","items":[],"status":"inProgress"}}),
+                "model/list" => json!({"data":[],"nextCursor":null}),
+                "turn/interrupt" => json!({}),
+                _ => panic!("unexpected structured request: {method}"),
+            };
+            if method != "initialize" {
+                requests_tx.send(request.clone()).unwrap();
+            }
+            socket
+                .send(Message::Text(
+                    json!({"id":request["id"],"result":result})
+                        .to_string()
+                        .into(),
+                ))
+                .await
+                .unwrap();
+        }
+    });
+    let client = RemoteAppServerClient::connect(RemoteAppServerConnectArgs {
+        endpoint: RemoteAppServerEndpoint::WebSocket {
+            websocket_url: format!("ws://{address}"),
+            auth_token: None,
+        },
+        client_name: "structured-turn-test".into(),
+        client_version: "test".into(),
+        experimental_api: true,
+        mcp_server_openai_form_elicitation: false,
+        opt_out_notification_methods: Vec::new(),
+        channel_capacity: 8,
+    })
+    .await
+    .unwrap();
+    let handle = AppServerRequestHandle::Remote(client.request_handle());
+    let cancellation = CancellationToken::new();
+    let (notifications_tx, mut notifications) = unbounded_channel();
+    let generation = run_structured_turn(
+        &handle,
+        TurnStartParams {
+            thread_id: "thread-1".into(),
+            ..Default::default()
+        },
+        timeout,
+        &mut notifications,
+        &cancellation,
+    );
+    tokio::pin!(generation);
+    tokio::select! {
+        result = &mut generation => panic!("turn completed before startup: {result:?}"),
+        request = requests.recv() => assert_eq!(request.unwrap()["method"], "turn/start"),
+    }
+    // The ordered RPC reply proves startup has reached the client before advancing its clock.
+    let _: ModelListResponse = handle
+        .request_typed(ClientRequest::ModelList {
+            request_id: RequestId::String("structured-turn-barrier".into()),
+            params: ModelListParams::default(),
+        })
+        .await
+        .unwrap();
+    assert_eq!(requests.recv().await.unwrap()["method"], "model/list");
+    assert!(futures::poll!(generation.as_mut()).is_pending());
+    tokio::time::pause();
+    tokio::time::advance(Duration::from_secs(32)).await;
+    if cancel {
+        cancellation.cancel();
+    }
+    tokio::time::resume();
+    if timeout.is_some() || cancel {
+        let error = generation.await.unwrap_err();
+        assert_eq!(
+            error.to_string(),
+            if cancel {
+                "temporary structured turn cancelled"
+            } else {
+                "temporary structured turn timed out"
+            }
+        );
+        assert!(cancellation.is_cancelled());
+        let interrupt = requests.recv().await.unwrap();
+        assert_eq!(interrupt["method"], "turn/interrupt");
+        assert_eq!(
+            interrupt["params"],
+            json!({"threadId":"thread-1","turnId":"turn-1"})
+        );
+    } else {
+        assert!(futures::poll!(generation.as_mut()).is_pending());
+        notifications_tx
+            .send(agent_message_notification("turn-1", "late title"))
+            .unwrap();
+        notifications_tx
+            .send(turn_completed_notification("turn-1", TurnStatus::Completed))
+            .unwrap();
+        assert_eq!(generation.await.unwrap(), "late title");
+        assert!(!cancellation.is_cancelled());
+        assert!(requests.try_recv().is_err());
+    }
+    client.shutdown().await.unwrap();
+    server.await.unwrap();
+}
