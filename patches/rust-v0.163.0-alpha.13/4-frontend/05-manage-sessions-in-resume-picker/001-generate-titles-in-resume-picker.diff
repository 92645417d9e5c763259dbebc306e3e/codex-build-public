+async fn check_generation(
+    second_response: &str,
+    succeeds: bool,
+    luna_available: bool,
+    cancelled: bool,
+) -> Result<()> {
+    let mock = responses::start_mock_server().await;
+    let invalid = r#"{"title":"\u4fee\u590d\u767b\u5f55\u8d85\u65f6"}"#;
+    let mut seed_events = vec![responses::ev_response_created("source-response")];
+    for index in 0..110 {
+        let mut message = responses::ev_assistant_message(
+            &format!("source-message-{index}"),
+            &format!("context-message-{index:03}"),
+        );
+        message["item"]["phase"] = json!("commentary");
+        seed_events.push(message);
+        // Reasoning forces the 100 substantive messages to cross page boundaries.
+        seed_events.push(responses::ev_reasoning_item(
+            &format!("reasoning-{index}"),
+            &["excluded reasoning"],
+            &[],
+        ));
+    }
+    seed_events.push(responses::ev_completed("source-response"));
+    let response = responses::mount_sse_sequence(
+        &mock,
+        std::iter::once(responses::sse(seed_events))
+            .chain(
+                [invalid, second_response]
+                    .into_iter()
+                    .filter(|_| luna_available && !cancelled)
+                    .enumerate()
+                    .map(|(index, title)| {
+                        responses::sse(vec![
+                            responses::ev_response_created(&format!("response-{index}")),
+                            responses::ev_assistant_message(&format!("message-{index}"), title),
+                            responses::ev_completed(&format!("response-{index}")),
+                        ])
+                    }),
+            )
+            .collect(),
+    )
+    .await;
+    let home = tempfile::tempdir()?;
+    let mut catalog = codex_models_manager::bundled_models_response()?;
+    let template = catalog.models[0].clone();
+    catalog.models = [
+        ("title-secondary-luna", 20, ModelVisibility::List),
+        ("title-luna-preview", 0, ModelVisibility::List),
+        ("title-preferred-luna", 10, ModelVisibility::Hide),
+        ("gpt-5.5", 1, ModelVisibility::List),
+    ]
+    .into_iter()
+    .filter(|(slug, _, _)| luna_available || !slug.ends_with("-luna"))
+    .map(|(slug, priority, visibility)| {
+        let mut model = template.clone();
+        model.slug = slug.to_string();
+        model.priority = priority;
+        model.visibility = visibility;
+        model.supported_in_api = true;
+        model
+    })
+    .collect();
+    let catalog_path = home.path().join("models.json");
+    std::fs::write(&catalog_path, serde_json::to_vec(&catalog)?)?;
+    std::fs::write(
+        home.path().join("config.toml"),
+        format!(
+            "model = 'gpt-5.5'\nmodel_provider = 'title-test'\nmodel_catalog_json = '{}'\n[model_providers.title-test]\nname = 'OpenAI'\nbase_url = '{}/v1'\nwire_api = 'responses'\nrequest_max_retries = 0\nstream_max_retries = 0\n",
+            catalog_path.display(),
+            mock.uri(),
+        ),
+    )?;
+    let config = ConfigBuilder::default()
+        .codex_home(home.path().to_path_buf())
+        .codex_harness(home.path().join("harness"))
+        .build()
+        .await?;
+    let mut server = crate::start_embedded_app_server_for_picker(&config).await?;
+    let thread_id = server.start_thread(&config).await?.session.thread_id;
+    let seed: TurnStartResponse = server
+        .request_handle()
+        .request_typed(ClientRequest::TurnStart {
+            request_id: RequestId::String("seed-title-context".into()),
+            params: TurnStartParams {
+                thread_id: thread_id.to_string(),
+                input: vec![UserInput::Text {
+                    text: "oldest user request".into(),
+                    text_elements: Vec::new(),
+                }],
+                ..Default::default()
+            },
+        })
+        .await?;
+    tokio::time::timeout(std::time::Duration::from_secs(10), async {
+        while let Some(event) = server.next_event().await {
+            if let AppServerEvent::ServerNotification(notification) = event
+                && let ServerNotification::TurnCompleted(completed) = *notification
+                && completed.thread_id == thread_id.to_string()
+                && completed.turn.id == seed.turn.id
+            {
+                assert_eq!(completed.turn.status, TurnStatus::Completed);
+                return;
+            }
+        }
+        panic!("source conversation closed before completion");
+    })
+    .await?;
+    server
+        .thread_set_name(thread_id, "existing title".into())
+        .await?;
+    let path = server
+        .thread_read(thread_id, false)
+        .await?
+        .path
+        .expect("source rollout");
+    server.thread_unsubscribe(thread_id).await?;
+    let before = std::fs::read(&path)?;
+    let cancellation = CancellationToken::new();
+    if cancelled {
+        cancellation.cancel();
+    }
+    let result = tokio::time::timeout(
+        std::time::Duration::from_secs(20),
+        generate(&mut server, thread_id, cancellation),
+    )
+    .await?;
+    let expected =
+        "repair authentication timeout handling across multiple concurrent client sessions";
+    if succeeds {
+        assert_eq!(result?, expected);
+    } else if cancelled {
+        let error = result.unwrap_err();
+        assert!(error.to_string().contains("title generation cancelled"));
+    } else if luna_available {
+        let error = result.unwrap_err();
+        assert!(
+            error.to_string().contains("after one corrective request"),
+            "{error:?}"
+        );
+    } else {
+        let error = result.unwrap_err();
+        assert!(
+            error.to_string().contains("no available luna-suffix model"),
+            "{error:?}"
+        );
+    }
+    assert_eq!(
+        server.thread_read(thread_id, false).await?.name.as_deref(),
+        Some(if succeeds { expected } else { "existing title" })
+    );
+    server.shutdown().await?;
+    assert_eq!(std::fs::read(path)?, before);
+    let requests = response.requests();
+    if cancelled || !luna_available {
+        assert_eq!(requests.len(), 1);
+        return Ok(());
+    }
+    assert_eq!(requests.len(), 3);
+    let first = requests[1].message_input_texts("user").join("\n");
+    assert_eq!(first.matches("<message role=").count(), 100);
+    assert!(!first.contains("context-message-009"));
+    assert!(first.contains("context-message-010"));
+    assert!(first.contains("context-message-109"));
+    assert!(first.find("context-message-010") < first.find("context-message-109"));
+    assert!(first.contains("<message role=\"assistant\">context-message-109</message>"));
+    assert!(!first.contains("excluded reasoning"));
+    let second = requests[2].message_input_texts("user").join("\n");
+    assert!(second.contains("context-message-010"));
+    assert!(requests[2].inputs_of_type("message").iter().any(|item| {
+        item["role"] == "assistant"
+            && item["content"].as_array().is_some_and(|content| {
+                content
+                    .iter()
+                    .any(|span| span["text"].as_str() == Some(invalid))
+            })
+    }));
+    for request in requests.into_iter().skip(1) {
+        let body = request.body_json();
+        assert_eq!(body["model"], "title-preferred-luna");
+        assert_eq!(body["reasoning"]["effort"], "low");
+        assert!(body["tools"].as_array().is_none_or(Vec::is_empty));
+    }
+    Ok(())
+}
