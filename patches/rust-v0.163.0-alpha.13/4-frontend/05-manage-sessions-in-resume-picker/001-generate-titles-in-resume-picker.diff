+#[test]
+fn bounded_prompt_preserves_recent_requests_unicode_and_complete_markup() {
+    let conversation = conversation_messages(vec![
+        ("user", "Fix <authentication> & login regressions".into()),
+        ("assistant", "\u{1f680}<&>".repeat(TITLE_PROMPT_MAX_BYTES)),
+    ])
+    .expect("substantive conversation");
+    let prompt = title_prompt(&conversation);
+    assert!(prompt.len() <= TITLE_PROMPT_MAX_BYTES);
+    assert!(prompt.contains(
+        "<message role=\"user\">Fix &lt;authentication&gt; &amp; login regressions</message>"
+    ));
+    assert_eq!(prompt.matches("<message role=").count(), 2);
+    assert_eq!(prompt.matches("</message>").count(), 2);
+    let content = conversation
+        .split("<message role=\"assistant\">")
+        .nth(1)
+        .unwrap()
+        .strip_suffix("</message>\n</conversation>")
+        .unwrap();
+    for entity in content.split('&').skip(1) {
+        assert!(
+            entity.starts_with("lt;") || entity.starts_with("gt;") || entity.starts_with("amp;")
+        );
+    }
+}
