+#[tokio::test(start_paused = true)]
+async fn title_cooldown_uses_the_completion_deadline_and_cancellation_stops_it() -> Result<()> {
+    let cancellation = CancellationToken::new();
+    let deadline = tokio::time::Instant::now() + std::time::Duration::from_secs(2);
+    let waiting = wait_between_titles(&cancellation, deadline);
+    tokio::pin!(waiting);
+    assert!(futures::poll!(waiting.as_mut()).is_pending());
+    tokio::time::advance(std::time::Duration::from_millis(1999)).await;
+    assert!(futures::poll!(waiting.as_mut()).is_pending());
+    tokio::time::advance(std::time::Duration::from_millis(1)).await;
+    waiting.await?;
+
+    let deadline = tokio::time::Instant::now() + std::time::Duration::from_secs(2);
+    let waiting = wait_between_titles(&cancellation, deadline);
+    tokio::pin!(waiting);
+    assert!(futures::poll!(waiting.as_mut()).is_pending());
+    tokio::time::advance(std::time::Duration::from_secs(1)).await;
+    cancellation.cancel();
+    assert!(waiting.await.is_err());
+    assert!(wait_between_titles(&cancellation, deadline).await.is_err());
+    Ok(())
+}
