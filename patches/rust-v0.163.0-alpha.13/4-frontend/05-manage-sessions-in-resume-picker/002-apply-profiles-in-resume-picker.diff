new file mode 100644
--- /dev/null
+++ b/codex-rs/tui/src/resume_picker/profiles.rs
@@ -0,0 +1,256 @@
+//! Apply saved-session profiles through settings, rename and archive APIs.
+
+use super::*;
+use crate::render::highlight::convert_syntect_color;
+use crate::render::highlight::current_syntax_theme;
+use crate::render::highlight::foreground_style_for_scopes_with_theme;
+use codex_app_server_protocol::ThreadSettingsUpdateParams;
+use codex_protocol::openai_models::ReasoningEffort;
+use codex_utils_absolute_path::AbsolutePathBuf;
+use color_eyre::eyre::WrapErr;
+use color_eyre::eyre::eyre;
+use itertools::Itertools;
+use serde::Deserialize;
+use std::collections::BTreeMap;
+
+const PROFILE_FILE: &str = "resume-profiles.json";
+
+#[derive(Clone, Debug, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub(super) struct ResumeProfile {
+    pub(super) name: String,
+    cwd: Option<AbsolutePathBuf>,
+    model: Option<String>,
+    reasoning_effort: Option<ReasoningEffort>,
+    title: Option<String>,
+    archive: Option<bool>,
+}
+
+fn parse_profiles(contents: &str) -> Result<BTreeMap<u8, ResumeProfile>> {
+    let entries: BTreeMap<String, serde_json::Value> = serde_json::from_str(contents)?;
+    let mut profiles = BTreeMap::new();
+    for (key, entry) in entries {
+        let [digit @ b'0'..=b'9'] = key.as_bytes() else {
+            return Err(eyre!(
+                "profile slot must be a single digit from 0 to 9: {key}"
+            ));
+        };
+        let Some(name) = entry.get("name").and_then(serde_json::Value::as_str) else {
+            continue;
+        };
+        if name.is_empty() || name.chars().any(|c| c.is_whitespace() || c.is_control()) {
+            continue;
+        }
+        let profile: ResumeProfile = serde_json::from_value(entry)?;
+        for (field, value) in [("model", &profile.model), ("title", &profile.title)] {
+            if value.as_ref().is_some_and(|value| value.trim().is_empty()) {
+                return Err(eyre!("profile {key} has an empty {field}"));
+            }
+        }
+        if profile.cwd.is_none()
+            && profile.model.is_none()
+            && profile.reasoning_effort.is_none()
+            && profile.title.is_none()
+            && profile.archive.is_none()
+        {
+            return Err(eyre!("profile {key} has no settings"));
+        }
+        profiles.insert(*digit - b'0', profile);
+    }
+    Ok(profiles)
+}
+
+pub(super) async fn load(codex_home: &Path) -> Result<BTreeMap<u8, ResumeProfile>> {
+    let path = codex_home.join(PROFILE_FILE);
+    let contents = match tokio::fs::read_to_string(&path).await {
+        Ok(contents) => contents,
+        Err(error) if error.kind() == std::io::ErrorKind::NotFound => return Ok(BTreeMap::new()),
+        Err(error) => {
+            return Err(error).wrap_err_with(|| format!("could not read {}", path.display()));
+        }
+    };
+    parse_profiles(&contents).wrap_err_with(|| format!("invalid {}", path.display()))
+}
+
+pub(super) async fn apply(
+    app_server: &mut AppServerSession,
+    thread_id: ThreadId,
+    codex_home: &Path,
+    slot: u8,
+    archived: &mut bool,
+    is_current: bool,
+) -> Result<()> {
+    let mut profiles = load(codex_home).await?;
+    let profile = profiles.remove(&slot).ok_or_else(|| {
+        eyre!(
+            "profile {slot} is not defined in {}",
+            codex_home.join(PROFILE_FILE).display()
+        )
+    })?;
+    let target_archived = profile.archive.unwrap_or(false);
+    if is_current && target_archived {
+        return Err(eyre!(
+            "Use /archive to archive the current session and exit."
+        ));
+    }
+    let needs_settings =
+        profile.cwd.is_some() || profile.model.is_some() || profile.reasoning_effort.is_some();
+    // Restore once before mutations, or to satisfy the requested final state.
+    if *archived && (!target_archived || needs_settings || profile.title.is_some()) {
+        app_server
+            .thread_unarchive(thread_id)
+            .await
+            .wrap_err("could not restore the session before applying its profile")?;
+        *archived = false;
+    }
+    if needs_settings {
+        app_server
+            .thread_settings_update(ThreadSettingsUpdateParams {
+                thread_id: thread_id.to_string(),
+                cwd: profile.cwd.map(AbsolutePathBuf::into_path_buf),
+                model: profile.model,
+                effort: profile.reasoning_effort,
+                ..Default::default()
+            })
+            .await?
+            .then_some(())
+            .ok_or_else(|| eyre!("this server does not support persistent thread settings"))?;
+    }
+    if let Some(title) = profile.title {
+        app_server
+            .thread_set_name(thread_id, title)
+            .await
+            .wrap_err("profile settings applied, but the title could not be saved")?;
+    }
+    if target_archived && !*archived {
+        app_server
+            .thread_archive(thread_id)
+            .await
+            .wrap_err("profile values applied, but the session could not be archived")?;
+        *archived = true;
+    }
+    Ok(())
+}
+
+impl PickerState {
+    pub(super) fn request_profile(&mut self, slot: u8) {
+        if !matches!(self.action, SessionPickerAction::Resume)
+            || self.profile_pending.is_some()
+            || !matches!(self.archive_state, archive::ArchiveState::Idle)
+        {
+            return;
+        }
+        let Some(thread_id) = self
+            .filtered_rows
+            .get(self.selected)
+            .and_then(|row| row.thread_id)
+        else {
+            return;
+        };
+        let Some(persistence) = &self.view_persistence else {
+            return;
+        };
+        if !self.profile_names.contains_key(&slot) {
+            return;
+        }
+        self.profile_pending = Some((thread_id, slot));
+        (self.picker_loader)(PickerLoadRequest::ApplyProfile {
+            thread_id,
+            codex_home: persistence.codex_home.clone(),
+            slot,
+            archived: self.status == SessionStatus::Archived,
+            is_current: matches!(self.launch_context, SessionPickerLaunchContext::ExistingSession { current_thread_id: Some(current) } if current == thread_id),
+        });
+        self.request_frame();
+    }
+
+    pub(super) fn finish_profile(&mut self, thread_id: ThreadId, result: std::io::Result<()>) {
+        if !self
+            .profile_pending
+            .is_some_and(|(pending, _)| pending == thread_id)
+        {
+            return;
+        }
+        self.profile_pending = None;
+        if let Err(error) = result {
+            self.inline_error = Some(format!("Could not apply profile: {error}"));
+        }
+        self.request_frame();
+    }
+}
+
+pub(super) fn hint_lines(
+    names: &BTreeMap<u8, String>,
+    width: u16,
+    pending: Option<u8>,
+) -> Vec<Line<'static>> {
+    let theme = current_syntax_theme();
+    let colors = [
+        "entity.name.type",
+        "string",
+        "constant.numeric",
+        "keyword",
+        "entity.name.function",
+        "variable.parameter",
+        "storage.modifier",
+    ]
+    .into_iter()
+    .filter_map(|scope| foreground_style_for_scopes_with_theme(&theme, &[scope])?.fg)
+    .chain(
+        theme
+            .scopes
+            .iter()
+            .filter_map(|item| item.style.foreground)
+            .chain(theme.settings.foreground)
+            .filter_map(convert_syntect_color),
+    )
+    .map(|color| readable_color_on(color, None))
+    .unique()
+    .take(10)
+    .collect::<Vec<_>>();
+    let mut lines = Vec::new();
+    let mut line = Line::default();
+    for (slot, name) in names {
+        if pending.is_some_and(|pending| pending != *slot) {
+            continue;
+        }
+        let mut spans = if pending.is_some() {
+            vec!["saving to profile ".set_style(footer_hint_label_style())]
+        } else {
+            let key = format!("alt+{slot}");
+            let mut spans = crate::key_hint::key_label_spans(&key);
+            spans.push(" apply profile ".set_style(footer_hint_label_style()));
+            spans
+        };
+        let color = colors
+            .iter()
+            .cycle()
+            .nth(usize::from(*slot))
+            .copied()
+            .unwrap_or(Color::Reset);
+        spans.push(Span::styled(name.clone(), Style::default().fg(color)));
+        let hint = Line::from(spans);
+        if !line.spans.is_empty()
+            && line.width() + FOOTER_HINT_GAP + hint.width() > usize::from(width)
+        {
+            lines.push(line);
+            line = Line::default();
+        }
+        let gap = if line.spans.is_empty() {
+            FOOTER_HINT_LEFT_PADDING
+        } else {
+            FOOTER_HINT_GAP
+        };
+        line.spans
+            .push(" ".repeat(gap).set_style(footer_hint_label_style()));
+        line.spans.extend(hint.spans);
+    }
+    if !line.spans.is_empty() {
+        lines.push(line);
+    }
+    lines
+}
