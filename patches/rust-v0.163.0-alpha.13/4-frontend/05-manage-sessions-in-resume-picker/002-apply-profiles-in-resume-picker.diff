+#[tokio::test]
+async fn profile_settings_survive_reopen_without_a_model_turn() -> Result<()> {
+    let mock = responses::start_mock_server().await;
+    let home = tempfile::tempdir()?;
+    let cwd = tempfile::tempdir()?;
+    std::fs::write(
+        home.path().join("config.toml"),
+        format!(
+            "model = 'gpt-5.5'\nmodel_provider = 'profile-test'\n[model_providers.profile-test]\nname = 'OpenAI'\nbase_url = '{}/v1'\nwire_api = 'responses'\nrequest_max_retries = 0\nstream_max_retries = 0\n",
+            mock.uri(),
+        ),
+    )?;
+    let config = ConfigBuilder::default()
+        .codex_home(home.path().to_path_buf())
+        .codex_harness(home.path().join("harness"))
+        .build()
+        .await?;
+    let mut thread_id = create_profile_rollout(home.path(), "Existing conversation");
+    let mut server = crate::start_embedded_app_server_for_picker(&config).await?;
+    let mut inherited = Vec::new();
+    for _ in 0..6 {
+        let fork = server
+            .fork_thread(
+                &crate::local_settings::LocalSettings::from(&config),
+                config.clone(),
+                thread_id,
+            )
+            .await?;
+        server.thread_archive(thread_id).await?;
+        let archived = server.thread_read(thread_id, false).await?;
+        let path = archived.path.expect("archived ancestor path");
+        let bytes = std::fs::read(&path)?;
+        inherited.push((path, bytes));
+        thread_id = fork.session.thread_id;
+    }
+    // Ancestor resolution must not repeatedly scan unrelated conversations.
+    for _ in 0..2_048 {
+        create_profile_rollout(home.path(), "Unrelated conversation");
+    }
+    std::fs::write(
+        home.path().join(PROFILE_FILE),
+        serde_json::to_vec(&json!({
+            "3": {
+                "name": "inspect",
+                "cwd": cwd.path(),
+                "model": "gpt-6-luna",
+                "reasoning_effort": "high",
+                "title": "inspect saved changes"
+            }
+        }))?,
+    )?;
+    let before = server.thread_read(thread_id, false).await?;
+    let path = before.path.clone().expect("saved rollout path");
+    let original = std::fs::read(&path)?;
+    let (mut picker, requests) = test_picker();
+    picker.all_rows = vec![row_from_app_server_thread(before).unwrap()];
+    picker.apply_filter();
+    apply(&mut server, thread_id, home.path(), 3, &mut false, false).await?;
+    server
+        .thread_set_name(thread_id, "before repeat".into())
+        .await?;
+    apply(&mut server, thread_id, home.path(), 3, &mut false, false).await?;
+    let updated = server.thread_read(thread_id, false).await?;
+    assert_eq!(updated.name.as_deref(), Some("inspect saved changes"));
+    assert_eq!(updated.cwd.as_path(), cwd.path());
+    picker.apply_session_mutation(thread_id, SessionStatus::Active, Some(updated.clone()));
+    assert_eq!(
+        picker.filtered_rows[picker.selected].thread_id,
+        Some(thread_id)
+    );
+    assert_eq!(
+        picker.filtered_rows[0].thread_name.as_deref(),
+        Some("inspect saved changes")
+    );
+    assert_eq!(picker.filtered_rows[0].cwd.as_deref(), Some(cwd.path()));
+    picker.filter_mode = SessionFilterMode::Cwd;
+    picker.filter_cwd = Some(home.path().to_path_buf());
+    picker.local_filter_cwd = Some(home.path().to_path_buf());
+    picker.apply_session_mutation(thread_id, SessionStatus::Active, Some(updated));
+    assert!(
+        picker.filtered_rows.is_empty(),
+        "changed cwd must obey the current filter"
+    );
+    assert!(requests.lock().unwrap().is_empty());
+    server.shutdown().await?;
+
+    let history = RolloutRecorder::get_rollout_history(&path).await?;
+    let settings = saved_settings(history.get_rollout_items());
+    assert_eq!(settings.cwd.as_path(), cwd.path());
+    assert_eq!(settings.model, "gpt-6-luna");
+    assert_eq!(settings.reasoning_effort, Some(ReasoningEffort::High));
+
+    let mut server = crate::start_embedded_app_server_for_picker(&config).await?;
+    let response: ThreadResumeResponse = server
+        .request_handle()
+        .request_typed(ClientRequest::ThreadResume {
