+    apply(&mut server, thread_id, home.path(), 3, &mut false, false).await?;
+    listed_profile(&mut server, thread_id, SessionStatus::Archived).await?;
+    // An archived session can receive settings and return to archived without opening in the TUI.
+    apply(&mut server, thread_id, home.path(), 4, &mut true, false).await?;
+    // Repeat matching settings while unloaded and still rename and archive.
+    apply(&mut server, thread_id, home.path(), 5, &mut true, false).await?;
+    let saved = listed_profile(&mut server, thread_id, SessionStatus::Active).await?;
+    assert_eq!(saved.name.as_deref(), Some("restored by default"));
+    apply(&mut server, thread_id, home.path(), 4, &mut false, false).await?;
+    let mut archived = true;
+    tokio::time::timeout(std::time::Duration::from_secs(30), async {
+        for _ in 0..60 {
+            apply(&mut server, thread_id, home.path(), 4, &mut archived, false).await?;
+            assert!(archived);
+        }
+        Ok::<_, color_eyre::Report>(())
+    })
+    .await??;
+    let saved = listed_profile(&mut server, thread_id, SessionStatus::Archived).await?;
+    assert_eq!(saved.name.as_deref(), Some("quick archive"));
+    let history = RolloutRecorder::get_rollout_history(saved.path.as_ref().unwrap()).await?;
+    let settings = saved_settings(history.get_rollout_items());
+    assert_eq!(settings.reasoning_effort, Some(ReasoningEffort::Low));
+    apply(&mut server, thread_id, home.path(), 6, &mut true, false).await?;
+    let renamed = listed_profile(&mut server, thread_id, SessionStatus::Archived).await?;
+    assert_eq!(renamed.name.as_deref(), Some("renamed while archived"));
+    // Settings and archive state change without changing an omitted title.
+    apply(&mut server, thread_id, home.path(), 7, &mut archived, false).await?;
+    assert!(!archived);
+    let saved = listed_profile(&mut server, thread_id, SessionStatus::Active).await?;
+    assert_eq!(saved.name.as_deref(), Some("renamed while archived"));
+    assert_eq!(saved.cwd.as_path(), cwd.path());
+    let history = RolloutRecorder::get_rollout_history(saved.path.as_ref().unwrap()).await?;
+    let settings = saved_settings(history.get_rollout_items());
+    assert_eq!(settings.cwd.as_path(), cwd.path());
+    assert_eq!(settings.model, "gpt-6-luna");
+    assert_eq!(settings.reasoning_effort, Some(ReasoningEffort::Low));
+    assert!(
+        !history
+            .get_rollout_items()
+            .iter()
+            .any(|item| matches!(item, RolloutItem::EventMsg(EventMsg::TurnStarted(_))))
+    );
+    for (path, bytes) in inherited {
+        assert_eq!(std::fs::read(path)?, bytes);
+    }
+    let current = std::fs::read(saved.path.as_ref().unwrap())?;
+    assert!(current.starts_with(&original));
+    server.shutdown().await?;
+    assert!(
+        responses::received_responses_requests(&mock)
+            .await
+            .is_empty()
+    );
+    Ok(())
+}
