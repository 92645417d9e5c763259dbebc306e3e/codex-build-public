+    // A fresh process seeds its notification baseline from the persisted values.
+    server
+        .thread_set_name(thread_id, "before fresh repeat".into())
+        .await?;
+    apply(&mut server, thread_id, home.path(), 3, &mut false, true).await?;
+    assert_eq!(
+        server.thread_read(thread_id, false).await?.name.as_deref(),
+        Some("inspect saved changes")
+    );
+    // Applying settings to the current session must preserve its existing subscription.
+    let detached: ThreadUnsubscribeResponse = server
+        .request_handle()
+        .request_typed(ClientRequest::ThreadUnsubscribe {
+            request_id: RequestId::String("unsubscribe-after-profile".into()),
+            params: ThreadUnsubscribeParams {
+                thread_id: thread_id.to_string(),
