diff --git a/codex-rs/tui/src/resume_picker/mutation_tests.rs b/codex-rs/tui/src/resume_picker/mutation_tests.rs
new file mode 100644
--- /dev/null
+++ b/codex-rs/tui/src/resume_picker/mutation_tests.rs
@@ -0,0 +1,52 @@
+use super::*;
+use pretty_assertions::assert_eq;
+
+#[test]
+fn mutations_keep_large_list_selection_cursor_and_stale_page_tombstones() {
+    for (listed, changed) in [
+        (SessionStatus::Active, SessionStatus::Archived),
+        (SessionStatus::Archived, SessionStatus::Active),
+    ] {
+        let (mut state, requests) = test_picker();
+        state.status = listed;
+        let rows = (0..2_000)
+            .map(|index| Row {
+                path: Some(PathBuf::from(format!("/sessions/{index}"))),
+                ..test_row(ThreadId::new())
+            })
+            .collect::<Vec<_>>();
+        let removed = rows[1_000].clone();
+        let selected = rows[1_500].clone();
+        state.ingest_page(PickerPage {
+            rows,
+            history_modes: HashMap::new(),
+            next_cursor: Some(PageCursor::AppServer("older".into())),
+            num_scanned_files: 2_000,
+            reached_scan_cap: false,
+        });
+        state.selected = 1_500;
+        state.scroll_top = 1_490;
+        state.apply_session_mutation(removed.thread_id.unwrap(), changed, None);
+        assert_eq!(state.filtered_rows.len(), 1_999);
+        assert_eq!(state.filtered_rows[state.selected], selected);
+        assert_eq!(state.scroll_top, 1_490);
+        assert_eq!(state.pagination.num_scanned_files, 2_000);
+        assert!(
+            matches!(&state.pagination.next_cursor, Some(PageCursor::AppServer(cursor)) if cursor == "older")
+        );
+        assert!(requests.lock().unwrap().is_empty());
+
+        let mut changed_path = removed.clone();
+        changed_path.path = Some(PathBuf::from("/another/path"));
+        state.ingest_page(PickerPage {
+            rows: vec![removed, changed_path],
+            history_modes: HashMap::new(),
+            next_cursor: None,
+            num_scanned_files: 2,
+            reached_scan_cap: false,
+        });
+        assert_eq!(state.filtered_rows.len(), 1_999);
+        assert_eq!(state.filtered_rows[state.selected], selected);
+        assert!(requests.lock().unwrap().is_empty());
+    }
+}
