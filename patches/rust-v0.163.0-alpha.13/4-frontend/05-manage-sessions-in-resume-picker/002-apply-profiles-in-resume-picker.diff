+    let names = (0..=9)
+        .map(|slot| (slot, format!("p{slot}")))
+        .collect::<BTreeMap<_, _>>();
+    let mut previous = None;
+    for (theme_name, foreground, background) in [
+        ("catppuccin-mocha", (205, 214, 244), (30, 30, 46)),
+        ("catppuccin-latte", (76, 79, 105), (239, 241, 245)),
+    ] {
+        crate::render::highlight::set_syntax_theme(
+            crate::render::highlight::resolve_theme_by_name(theme_name, None).unwrap(),
+        );
+        crate::terminal_palette::with_test_default_colors(
+            crate::terminal_probe::DefaultColors {
+                fg: foreground,
+                bg: background,
+            },
+            || {
+                let colors = hint_lines(&names, 300, None)
+                    .into_iter()
+                    .flat_map(|line| line.spans)
+                    .filter(|span| names.values().any(|name| name == span.content.as_ref()))
+                    .map(|span| span.style.fg.unwrap())
+                    .collect::<Vec<_>>();
+                assert_eq!(colors.len(), 10);
+                assert_eq!(colors.iter().unique().count(), 10);
+                assert!(!colors.contains(&Color::Reset));
+                if let Some(previous) = &previous {
+                    assert_ne!(&colors, previous);
+                }
+                let sparse = BTreeMap::from([(9, "p9".to_string())]);
+                let last = hint_lines(&sparse, 80, None)
+                    .pop()
+                    .unwrap()
+                    .spans
+                    .pop()
+                    .unwrap();
+                assert_eq!(last.content, "p9");
+                assert_eq!(last.style.fg, Some(colors[9]));
+                let pending = hint_lines(&names, 80, Some(9));
+                assert_eq!(pending.len(), 1);
+                assert_eq!(pending[0].to_string().trim(), "saving to profile p9");
+                assert_eq!(pending[0].spans.last().unwrap().style.fg, Some(colors[9]));
+                previous = Some(colors);
+            },
+        );
+    }
+    crate::render::highlight::set_syntax_theme(original);
+}
