+async fn alt_digits_apply_to_the_selected_session_without_typing_or_resuming() -> Result<()> {
+    let (mut state, requests) = test_picker();
+    let thread_id = ThreadId::new();
+    state.view_persistence = Some(SessionPickerViewPersistence {
+        codex_home: PathBuf::from("/tmp/profile-home"),
+    });
+    state.filtered_rows.push(test_row(thread_id));
+    // Remote pickers do not load profiles; absent shortcuts must submit no request.
+    state
+        .handle_key(KeyEvent::new(KeyCode::Char('0'), KeyModifiers::ALT))
+        .await?;
+    assert!(requests.lock().unwrap().is_empty());
+    assert_eq!(state.profile_pending, None);
+    state.profile_names = (0..=9)
+        .map(|slot| (slot, format!("profile{slot}")))
+        .collect();
+    for slot in 0..=9 {
+        state.status = if slot % 2 == 0 {
+            SessionStatus::Active
+        } else {
+            SessionStatus::Archived
+        };
+        state.profile_pending = None;
+        let selection = state
+            .handle_key(KeyEvent::new(
+                KeyCode::Char(char::from(b'0' + slot)),
+                KeyModifiers::ALT,
+            ))
+            .await?;
+        assert!(selection.is_none());
+        assert_eq!(state.query, "");
