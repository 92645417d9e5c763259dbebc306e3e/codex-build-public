+        )
+        .await?;
+    // Server startup can create files, but each reading must refer to its configured filesystem.
+    for (path, reported) in [
+        (home.path(), response.home_available_bytes),
+        (harness.path(), response.harness_available_bytes),
+    ] {
+        let measured = codex_core::disk_capacity::available_space(path)?;
+        assert!(reported.abs_diff(measured) < 64 * 1024 * 1024);
+    }
+    assert!(!home.path().join("auth.json").exists());
+    Ok(())
+}
