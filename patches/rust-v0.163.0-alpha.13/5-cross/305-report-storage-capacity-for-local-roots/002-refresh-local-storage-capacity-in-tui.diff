+#[tokio::test]
+async fn storage_capacity_refresh_works_without_account_and_rejects_stale_samples() -> Result<()> {
+    let home = tempdir()?;
+    let (mut app, mut events, _ops) = make_test_app_with_channels().await;
+    app.config.codex_home = home.path().to_path_buf().abs();
+    app.config.sqlite = codex_state::SqliteConfig::new_for_testing(home.path().abs());
+    let mut session = Box::pin(crate::start_embedded_app_server_for_picker(&app.config)).await?;
+    let mut tui = crate::tui::test_support::make_test_tui()?;
+    assert!(app.chat_widget.rate_limit_refresh_interval().is_none());
+    app.refresh_rate_limits(&session, RateLimitRefreshOrigin::Periodic);
+    app.refresh_rate_limits(&session, RateLimitRefreshOrigin::Periodic);
+    let loaded = next_rate_limits_loaded(&mut events).await?;
+    let (request_id, generation, capacity) = match &loaded {
+        AppEvent::RateLimitsLoaded {
+            request_id,
+            hard_stop_generation,
+            result: None,
+            storage_capacity: Ok(capacity),
+            ..
+        } => (*request_id, *hard_stop_generation, capacity.clone()),
+        other => panic!("expected an unauthenticated storage read, got {other:?}"),
+    };
+    app.handle_event(&mut tui, &mut session, loaded).await?;
+    assert_eq!(app.storage_capacity, Some(capacity.clone()));
+    assert!(
+        app.rate_limit_refresh_state
+            .poll_deadline(Duration::from_secs(60))
+            .is_some()
+    );
+
+    let (new_id, new_generation) = app
+        .rate_limit_refresh_state
+        .start(
+            RateLimitRefreshOrigin::Periodic,
+            &mut app.rate_limit_hard_stop_generation,
+        )
+        .unwrap();
+    let zero_home = codex_app_server_protocol::GetStorageCapacityResponse {
+        home_available_bytes: 0,
+        harness_available_bytes: 1024,
+    };
+    let zero_harness = codex_app_server_protocol::GetStorageCapacityResponse {
+        home_available_bytes: 2048,
+        harness_available_bytes: 0,
+    };
+    for (id, generation, result, expected) in [
+        (
+            request_id,
+            generation,
+            Ok(zero_home.clone()),
+            Some(capacity),
+        ),
+        (
+            new_id,
+            new_generation,
+            Ok(zero_home.clone()),
+            Some(zero_home.clone()),
+        ),
+        (
+            new_id,
+            new_generation,
+            Ok(zero_harness.clone()),
+            Some(zero_harness),
+        ),
+        (new_id, new_generation, Err("unavailable".into()), None),
+        (request_id, generation, Ok(zero_home), None),
+    ] {
+        app.handle_event(
+            &mut tui,
+            &mut session,
+            AppEvent::RateLimitsLoaded {
+                request_id: id,
+                origin: RateLimitRefreshOrigin::Periodic,
+                hard_stop_generation: generation,
+                result: None,
+                storage_capacity: result,
+            },
+        )
+        .await?;
+        assert_eq!(app.storage_capacity, expected);
+    }
+    session.shutdown().await?;
+    Ok(())
+}
