+
+struct PendingPostHost {
+    entered: Notify,
+    release: Notify,
+}
+
+impl MessageBoardHost for PendingPostHost {
+    fn agent_path(&self, _caller: ThreadId) -> BoxFuture<'_, Result<AgentPath>> {
+        Box::pin(async {
+            self.entered.notify_one();
+            self.release.notified().await;
+            Ok(AgentPath::root())
+        })
+    }
+
+    fn resolve_agent(&self, _path: AgentPath) -> BoxFuture<'_, Result<ThreadId>> {
+        unreachable!("the post has no explicit recipients")
+    }
+
+    fn current_time(&self, _caller: ThreadId) -> BoxFuture<'_, Result<DateTime<Utc>>> {
+        Box::pin(async { Ok(Utc::now()) })
+    }
+
+    fn notify(
+        &self,
+        _recipient: ThreadId,
+        _post: PostPreview,
+    ) -> BoxFuture<'_, Result<NotificationDelivery>> {
+        unreachable!("the post has no other subscribers")
+    }
+}
+
+#[tokio::test]
+async fn shutdown_waits_for_detached_post_and_checkpoints_the_main_file() {
+    let dir = tempfile::tempdir().unwrap();
+    let sqlite = SqliteConfig::new_for_testing(dir.path().to_path_buf().try_into().unwrap());
+    let host = Arc::new(PendingPostHost {
+        entered: Notify::new(),
+        release: Notify::new(),
+    });
+    let board = LocalAgentMessageBoard::open(&sqlite, SessionId::new(), host.clone())
+        .await
+        .unwrap();
+    let other_home = tempfile::tempdir().unwrap();
+    let other_sqlite =
+        SqliteConfig::new_for_testing(other_home.path().to_path_buf().try_into().unwrap());
+    let other = LocalAgentMessageBoard::open(&other_sqlite, SessionId::new(), Arc::new(UnusedHost))
+        .await
+        .unwrap();
+    let caller = tokio::spawn(async move {
+        board
+            .post(
+                ThreadId::new(),
+                PostRequest {
+                    destination: PostDestination::NewChannel("work".into()),
+                    text: "final accepted post".into(),
+                    request_id: "final-post".into(),
+                    agents_to_notify: Vec::new(),
+                },
+            )
+            .await
+    });
+    host.entered.notified().await;
+    let pool = local_message_board_pool_for_shutdown(&sqlite)
+        .await
+        .unwrap()
+        .unwrap();
+    caller.abort();
+    assert!(caller.await.unwrap_err().is_cancelled());
+
+    let close = pool.close();
+    tokio::pin!(close);
+    assert!(futures::poll!(&mut close).is_pending());
+    assert!(pool.is_closed());
+    host.release.notify_one();
+    tokio::time::timeout(std::time::Duration::from_secs(5), close)
+        .await
+        .unwrap();
+    assert!(!other.pool.is_closed());
+    other.pool.close().await;
+
+    let database = dir.path().join(pool::DATABASE_FILE);
+    for suffix in ["-wal", "-shm"] {
+        assert!(!std::path::PathBuf::from(format!("{}{suffix}", database.display())).exists());
+    }
+    let standalone = tempfile::tempdir().unwrap();
+    let copy = standalone.path().join(pool::DATABASE_FILE);
+    tokio::fs::copy(database, &copy).await.unwrap();
+    let reader = sqlite.open_read_only_pool(&copy, None).await.unwrap();
+    let posts: Vec<String> = sqlx::query_scalar("SELECT body_search FROM posts")
+        .fetch_all(&reader)
+        .await
+        .unwrap();
+    assert_eq!(posts, vec!["final accepted post"]);
+    reader.close().await;
+}
