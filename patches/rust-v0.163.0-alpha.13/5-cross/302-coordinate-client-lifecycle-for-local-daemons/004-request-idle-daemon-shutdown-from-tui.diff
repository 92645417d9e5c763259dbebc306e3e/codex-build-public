+#[tokio::test]
+async fn control_center_shutdown_preserves_embedded_and_remote_servers() -> Result<()> {
+    let (mut app, mut events, mut ops) = make_test_app_with_channels().await;
+    let mut server = crate::start_embedded_app_server_for_picker(&app.config).await?;
+    for target in [
+        AppServerTarget::Embedded,
+        AppServerTarget::Remote {
+            endpoint: crate::RemoteAppServerEndpoint::WebSocket {
+                websocket_url: "wss://example.com/".to_string(),
+                auth_token: None,
+            },
+        },
+    ] {
+        app.app_server_target = target;
+        while events.try_recv().is_ok() {}
+        while ops.try_recv().is_ok() {}
+        assert_eq!(
+            app.check_idle_daemon_shutdown(&mut server)
+                .await
+                .unwrap_err(),
+            "Quit requires a connection to the local background server."
+        );
+        assert_eq!(
+            app.request_idle_daemon_shutdown(&mut server)
+                .await
+                .unwrap_err(),
+            "Quit requires a connection to the local background server."
+        );
+        assert!(events.try_recv().is_err());
+        assert!(ops.try_recv().is_err());
+    }
+    server.shutdown().await?;
+    Ok(())
+}
