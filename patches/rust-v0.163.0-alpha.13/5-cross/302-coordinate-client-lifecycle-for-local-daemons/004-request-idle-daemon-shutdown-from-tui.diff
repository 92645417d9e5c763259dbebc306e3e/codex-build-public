+//! Guarded daemon shutdown for the control center, independent of client-exit shortcuts.
+
+use super::App;
+use super::AppServerTarget;
+use super::ExitReason;
+use crate::app_server_session::AppServerSession;
+use codex_app_server_protocol::DaemonShutdownStatus;
+
+impl App {
+    /// Check eligibility without reserving it or stopping the daemon.
+    pub(super) async fn check_idle_daemon_shutdown(
+        &self,
+        app_server: &mut AppServerSession,
+    ) -> Result<(), String> {
+        self.idle_daemon_shutdown(app_server, true).await
+    }
+
+    /// Return acceptance or a message for the caller, retaining the interface and connection on refusal.
+    pub(super) async fn request_idle_daemon_shutdown(
+        &self,
+        app_server: &mut AppServerSession,
+    ) -> Result<ExitReason, String> {
+        self.idle_daemon_shutdown(app_server, false).await?;
+        Ok(ExitReason::DaemonShutdownAccepted)
+    }
+
+    async fn idle_daemon_shutdown(
+        &self,
+        app_server: &mut AppServerSession,
+        check_only: bool,
+    ) -> Result<(), String> {
+        if !matches!(self.app_server_target, AppServerTarget::LocalDaemon { .. }) {
+            return Err("Quit requires a connection to the local background server.".to_string());
+        }
+        let response = app_server
+            .request_daemon_shutdown(check_only)
+            .await
+            .map_err(|error| {
+                let action = if check_only {
+                    "check shutdown eligibility"
+                } else {
+                    "stop the app server"
+                };
+                format!("Could not {action}: {error:#}")
+            })?;
+        match response.status {
+            DaemonShutdownStatus::Accepted => Ok(()),
+            DaemonShutdownStatus::OtherClients => Err(
+                "Other clients are connected. Quit requires this to be the last client. This client and the app server are still running.".to_string(),
+            ),
+            DaemonShutdownStatus::Busy => Err(
+                "All sessions must be idle before quitting. This client and the app server are still running.".to_string(),
+            ),
+        }
+    }
+}
