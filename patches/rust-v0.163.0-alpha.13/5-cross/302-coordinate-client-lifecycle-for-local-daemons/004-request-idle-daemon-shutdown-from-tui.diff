+#[tokio::test]
+async fn manual_idle_daemon_exit_summary_reports_stopped_server() -> Result<()> {
+    let (mut app, _, _) = make_test_app_with_channels().await;
+    let thread_id = prepare_local_daemon_thread(&mut app)?;
+    let lines = app
+        .exit_info(ExitReason::DaemonShutdownAccepted)
+        .format_exit_messages(/*color_enabled*/ false);
+    assert_eq!(
+        lines[0],
+        "App server is shutting down. This session can be resumed."
+    );
+    assert_eq!(lines[1], format!("Resume: codex resume {thread_id}"));
+    assert_eq!(lines.len(), 2);
+    Ok(())
+}
