 use super::*;
 use pretty_assertions::assert_eq;
 
+#[tokio::test]
+async fn control_center_shutdown_returns_refusals_without_history_or_disconnect() -> Result<()> {
+    use codex_app_server_protocol::ClientRequest;
+    use codex_app_server_protocol::DaemonShutdownStatus;
+    use codex_app_server_protocol::JSONRPCMessage;
+    use codex_app_server_protocol::RequestId;
+    use futures::SinkExt;
+    use futures::StreamExt;
+    use tokio_tungstenite::tungstenite::Message;
+
+    for status in [
+        Some(DaemonShutdownStatus::OtherClients),
+        Some(DaemonShutdownStatus::Busy),
+        None,
+        Some(DaemonShutdownStatus::Accepted),
+    ] {
+        let (mut app, mut events, mut ops) = make_test_app_with_channels().await;
+        prepare_local_daemon_thread(&mut app)?;
+        app.chat_widget.insert_str("Keep this draft on refusal");
+        while events.try_recv().is_ok() {}
+        while ops.try_recv().is_ok() {}
+
+        let listener = tokio::net::TcpListener::bind("127.0.0.1:0").await?;
+        let websocket_url = format!("ws://{}", listener.local_addr()?);
+        let codex_home = app.config.codex_home.display().to_string();
+        let server: tokio::task::JoinHandle<Result<()>> = tokio::spawn(async move {
+            let (stream, _) = listener.accept().await?;
+            let mut websocket = tokio_tungstenite::accept_async(stream).await?;
+            let mut received_check = false;
+            let mut received_shutdown = false;
+            let mut received_followup = false;
+            while let Some(Ok(Message::Text(text))) = websocket.next().await {
+                let JSONRPCMessage::Request(request) = serde_json::from_str(&text)? else {
+                    continue;
+                };
+                let response = match request.method.as_str() {
+                    "initialize" => {
+                        serde_json::json!({"id": request.id, "result": {"userAgent": "codex-tui-test", "codexHome": codex_home}})
+                    }
+                    "daemon/shutdown" => {
+                        assert!(!received_shutdown);
+                        if request
+                            .params
+                            .as_ref()
+                            .is_some_and(|params| params["checkOnly"] == true)
+                        {
+                            assert!(!received_check);
+                            received_check = true;
+                        } else {
+                            assert!(received_check);
+                            received_shutdown = true;
+                        }
+                        if let Some(status) = status {
+                            serde_json::json!({"id": request.id, "result": {"status": status}})
+                        } else {
+                            serde_json::json!({"id": request.id, "error": {"code": -32600, "message": "Shutdown unavailable"}})
+                        }
+                    }
+                    "thread/list" => {
+                        assert!(received_shutdown);
+                        received_followup = true;
+                        serde_json::json!({"id": request.id, "result": {}})
+                    }
+                    method => panic!("unexpected request: {method}"),
+                };
+                websocket
+                    .send(Message::Text(response.to_string().into()))
+                    .await?;
+            }
+            assert!(received_check && received_shutdown);
+            assert_eq!(
+                received_followup,
+                status != Some(DaemonShutdownStatus::Accepted)
+            );
+            Ok(())
+        });
+        let client = crate::connect_remote_app_server(crate::RemoteAppServerEndpoint::WebSocket {
+            websocket_url,
+            auth_token: None,
+        })
+        .await?;
+        let mut app_server =
+            AppServerSession::new(client, crate::app_server_session::ThreadParamsMode::Remote);
+        let eligibility = app.check_idle_daemon_shutdown(&mut app_server).await;
+        assert_eq!(
+            eligibility.is_ok(),
+            status == Some(DaemonShutdownStatus::Accepted)
+        );
+        assert!(ops.try_recv().is_err());
+        assert!(events.try_recv().is_err());
+        assert_eq!(
+            app.chat_widget.composer_text_with_pending(),
+            "Keep this draft on refusal"
+        );
+        let decision = app.request_idle_daemon_shutdown(&mut app_server).await;
+        assert!(
+            ops.try_recv().is_err(),
+            "quit must not shut down or interrupt an individual thread"
+        );
+        assert!(
+            events.try_recv().is_err(),
+            "shutdown decisions do not add chat history"
+        );
+        if status == Some(DaemonShutdownStatus::Accepted) {
+            assert_matches!(decision, Ok(ExitReason::DaemonShutdownAccepted));
+        } else {
+            assert_eq!(
+                app.chat_widget.composer_text_with_pending(),
+                "Keep this draft on refusal"
+            );
+            let text = decision.expect_err("shutdown refusal for the control center");
+            match status {
+                Some(DaemonShutdownStatus::OtherClients) => {
+                    assert!(text.contains("last client"), "{text}")
+                }
+                Some(DaemonShutdownStatus::Busy) => {
+                    assert!(text.contains("All sessions must be idle"), "{text}")
+                }
+                None => assert!(text.contains("Shutdown unavailable"), "{text}"),
+                Some(DaemonShutdownStatus::Accepted) => unreachable!(),
+            }
+            assert!(
+                app_server
+                    .request_handle()
+                    .request(ClientRequest::ThreadList {
+                        request_id: RequestId::Integer(999),
+                        params: serde_json::from_value(serde_json::json!({}))?,
+                    })
+                    .await?
+                    .is_ok()
+            );
+        }
+        app_server.shutdown().await?;
+        server.await??;
+    }
+    Ok(())
+}
