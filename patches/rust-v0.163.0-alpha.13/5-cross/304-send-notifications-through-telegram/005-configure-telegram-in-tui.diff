+//! Telegram configuration business shared by ordinary and full-screen dialog hosts.
+
+use crate::app_event::AppEvent;
+use crate::bottom_pane::BottomPaneView;
+use crate::bottom_pane::SelectionItem;
+use crate::bottom_pane::SelectionToggle;
+use crate::bottom_pane::SelectionViewParams;
+use crate::bottom_pane::custom_prompt_view::CustomPromptView;
+use crate::dialog::DialogResources;
+use codex_app_server_protocol::TelegramCommandParams;
+use codex_app_server_protocol::TelegramCommandResponse;
+use codex_app_server_protocol::TelegramSetup;
+
+const DEFAULT_VERSION_CHECK_INTERVAL_HOURS: u16 = 20;
+const VERSION_CHECK_INTERVALS: [u16; 7] = [1, 6, 12, 20, 24, 48, 168];
+const SETUP_VIEW_ID: &str = "telegram-setup";
+const VERSION_VIEW_ID: &str = "telegram-version";
+
+#[derive(Clone)]
+pub(crate) struct TelegramSetupDraft {
+    bot_token: String,
+    chat_id: Option<String>,
+    github_token: Option<String>,
+}
+
+impl std::fmt::Debug for TelegramSetupDraft {
+    fn fmt(&self, formatter: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        formatter
+            .debug_struct("TelegramSetupDraft")
+            .field("bot_token", &"<redacted>")
+            .field("chat_id", &self.chat_id.as_ref().map(|_| "<redacted>"))
+            .field(
+                "github_token",
+                &self.github_token.as_ref().map(|_| "<redacted>"),
+            )
+            .finish()
+    }
+}
+
+pub(crate) fn menu(
+    config: TelegramCommandResponse,
+    resources: &DialogResources<'_>,
+) -> Box<dyn BottomPaneView> {
+    if !config.configured {
+        return Box::new(configure(resources));
+    }
+    Box::new(resources.selection_view(SelectionViewParams {
+        title: Some("Telegram notifications".to_string()),
+        items: vec![
+            SelectionItem {
+                name: "GitHub release updates".to_string(),
+                description: Some("Change release-check settings.".to_string()),
+                actions: vec![Box::new(move |tx| {
+                    tx.send(AppEvent::OpenTelegramVersion {
+                        config: config.clone(),
+                    });
+                })],
+                ..Default::default()
+            },
+            SelectionItem {
+                name: "Disable".to_string(),
+                description: Some("Clear saved Telegram credentials.".to_string()),
+                actions: vec![Box::new(|tx| {
+                    tx.send(AppEvent::TelegramCommand {
+                        params: TelegramCommandParams::Disable {},
+                    });
+                })],
+                ..Default::default()
+            },
+        ],
+        ..SelectionViewParams::picker()
+    }))
+}
+
+fn configure(resources: &DialogResources<'_>) -> CustomPromptView {
+    let tx = resources.app_event_tx.clone();
+    resources.text_prompt(CustomPromptView::new_masked(
+        "Bot token".to_string(),
+        "Enter the bot token".to_string(),
+        None,
+        Box::new(move |bot_token| {
+            tx.send(AppEvent::OpenTelegramChat {
+                draft: TelegramSetupDraft {
+                    bot_token,
+                    chat_id: None,
+                    github_token: None,
+                },
+            });
+        }),
+    ))
+}
+
+pub(crate) fn chat(draft: TelegramSetupDraft, resources: &DialogResources<'_>) -> CustomPromptView {
+    let tx = resources.app_event_tx.clone();
+    resources.text_prompt(CustomPromptView::new(
+        "Chat ID".to_string(),
+        "Enter the chat ID".to_string(),
+        String::new(),
+        None,
+        Box::new(move |chat_id| {
+            let mut draft = draft.clone();
+            draft.chat_id = Some(chat_id);
+            tx.send(AppEvent::OpenTelegramGithubToken { draft });
+        }),
+    ))
+}
+
+pub(crate) fn github_token(
+    draft: TelegramSetupDraft,
+    resources: &DialogResources<'_>,
+) -> CustomPromptView {
+    let tx = resources.app_event_tx.clone();
+    resources.text_prompt(CustomPromptView::new_masked(
+        "GitHub token".to_string(),
+        "Enter a GitHub API token".to_string(),
+        None,
+        Box::new(move |github_token| {
+            let mut draft = draft.clone();
+            draft.github_token = Some(github_token);
+            tx.send(AppEvent::OpenTelegramSetup {
+                draft,
+                notify_version_updates: true,
+            });
+        }),
+    ))
+}
+
+pub(crate) fn setup(
+    draft: TelegramSetupDraft,
+    notify_version_updates: bool,
+) -> SelectionViewParams {
+    let toggle_draft = draft.clone();
+    let submit_draft = draft;
+    SelectionViewParams {
+        view_id: Some(SETUP_VIEW_ID),
+        title: Some("Notifications setup".to_string()),
+        items: vec![
+            SelectionItem {
+                name: "Notify on new Codex releases".to_string(),
+                toggle: Some(SelectionToggle {
+                    is_on: notify_version_updates,
+                    action: Box::new(move |enabled, tx| {
+                        tx.send(AppEvent::OpenTelegramSetup {
+                            draft: toggle_draft.clone(),
+                            notify_version_updates: enabled,
+                        });
+                    }),
+                }),
+                ..Default::default()
+            },
+            SelectionItem {
+                name: "Finish setup".to_string(),
+                description: Some("Test bot delivery and GitHub access, then save.".to_string()),
+                actions: vec![Box::new(move |tx| {
+                    if let (Some(chat_id), Some(github_token)) =
+                        (&submit_draft.chat_id, &submit_draft.github_token)
+                    {
+                        tx.send(AppEvent::TelegramCommand {
+                            params: TelegramCommandParams::Configure {
+                                setup: TelegramSetup {
+                                    bot_token: submit_draft.bot_token.clone(),
+                                    chat_id: chat_id.clone(),
+                                    github_token: github_token.clone(),
+                                    notify_version_updates,
+                                    version_check_interval_hours:
+                                        DEFAULT_VERSION_CHECK_INTERVAL_HOURS,
+                                },
+                            },
+                        });
+                    }
+                })],
+                ..Default::default()
+            },
+        ],
+        ..SelectionViewParams::picker()
+    }
+}
+
+pub(crate) fn version(config: TelegramCommandResponse) -> SelectionViewParams {
+    let enabled = config.notify_version_updates;
+    let hours = config.version_check_interval_hours;
+    let toggle = SelectionToggle {
+        is_on: enabled,
+        action: Box::new(move |enabled, tx| {
+            tx.send(AppEvent::TelegramCommand {
+                params: TelegramCommandParams::SetVersionSettings {
+                    notify_version_updates: enabled,
+                    version_check_interval_hours: hours,
+                },
+            });
+        }),
+    };
+    SelectionViewParams {
+        view_id: Some(VERSION_VIEW_ID),
+        title: Some("GitHub release updates".to_string()),
+        items: vec![
+            SelectionItem {
+                name: "Enable".to_string(),
+                toggle: Some(toggle),
+                ..Default::default()
+            },
+            SelectionItem {
+                name: "Check interval".to_string(),
+                description: Some(format!("Every {hours} hours")),
+                actions: vec![Box::new(move |tx| {
+                    tx.send(AppEvent::OpenTelegramInterval {
+                        config: config.clone(),
+                    });
+                })],
+                ..Default::default()
+            },
+            SelectionItem {
+                name: "Check GitHub access".to_string(),
+                actions: vec![Box::new(|tx| {
+                    tx.send(AppEvent::TelegramCommand {
+                        params: TelegramCommandParams::ProbeGithub {},
+                    });
+                })],
+                ..Default::default()
+            },
+            SelectionItem {
+                name: "Check for updates now".to_string(),
+                actions: vec![Box::new(|tx| {
+                    tx.send(AppEvent::TelegramCommand {
+                        params: TelegramCommandParams::CheckVersion {},
+                    });
+                })],
+                ..Default::default()
+            },
+        ],
+        ..SelectionViewParams::picker()
+    }
+}
+
+pub(crate) fn interval(config: TelegramCommandResponse) -> SelectionViewParams {
+    let items = VERSION_CHECK_INTERVALS
+        .into_iter()
+        .map(|hours| {
+            let enabled = config.notify_version_updates;
+            SelectionItem {
+                name: format!("Every {hours} hours"),
+                is_current: config.version_check_interval_hours == hours,
+                actions: vec![Box::new(move |tx| {
+                    tx.send(AppEvent::TelegramCommand {
+                        params: TelegramCommandParams::SetVersionSettings {
+                            notify_version_updates: enabled,
+                            version_check_interval_hours: hours,
+                        },
+                    });
+                })],
+                ..Default::default()
+            }
+        })
+        .collect();
+    SelectionViewParams {
+        title: Some("Release check interval".to_string()),
+        items,
+        ..SelectionViewParams::picker()
+    }
+}
