+}
+
+fn show_selection(
+    dialogs: &mut DialogStack,
+    mut params: SelectionViewParams,
+    resources: DialogResources<'_>,
+) {
+    if let Some(view_id) = params.view_id
+        && let Some(selected) = dialogs
+            .iter()
+            .rev()
+            .find(|view| view.view_id() == Some(view_id))
+            .and_then(|view| view.selected_index())
+    {
+        params.initial_selected_idx = Some(selected);
+        assert!(dialogs.replace_selection_if_present(view_id, params, resources));
+    } else {
+        dialogs.push(Box::new(resources.selection_view(params)));
+    }
+}
