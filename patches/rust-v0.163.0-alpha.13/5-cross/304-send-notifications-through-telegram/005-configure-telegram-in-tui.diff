+#[test]
+fn every_telegram_dialog_uses_the_native_panel_in_both_hosts() {
+    let (tx, _rx) = tokio::sync::mpsc::unbounded_channel();
+    let events = AppEventSender::new(tx);
+    let keymap = RuntimeKeymap::defaults();
+    let frames = FrameRequester::test_dummy();
+    let resources = DialogResources {
+        app_event_tx: &events,
+        keymap: &keymap,
+        frame_requester: &frames,
+        vim_enabled: false,
+    };
+    let config = TelegramCommandResponse {
+        configured: true,
+        github_token_configured: true,
+        notify_version_updates: true,
+        version_check_interval_hours: 20,
+        message: None,
+    };
+    let draft = TelegramSetupDraft {
+        bot_token: "bot-secret".into(),
+        chat_id: Some("chat-id".into()),
+        github_token: Some("github-secret".into()),
+    };
+    for bg in [(24, 24, 24), (245, 245, 245)] {
+        crate::terminal_palette::with_test_default_colors(
+            crate::terminal_probe::DefaultColors {
+                fg: (128, 128, 128),
+                bg,
+            },
+            || {
+                let panel = crate::style::user_message_style()
+                    .bg
+                    .expect("known palette supplies a panel background");
+                for (width, height) in [(80, 24), (40, 12)] {
+                    let views: Vec<Box<dyn BottomPaneView>> = vec![
+                        menu(TelegramCommandResponse::default(), &resources),
+                        menu(config.clone(), &resources),
+                        Box::new(chat(draft.clone(), &resources)),
+                        Box::new(github_token(draft.clone(), &resources)),
+                        Box::new(resources.selection_view(setup(draft.clone(), true))),
+                        Box::new(resources.selection_view(version(config.clone()))),
+                        Box::new(resources.selection_view(interval(config.clone()))),
+                    ];
+                    for view in views {
+                        let area = Rect::new(0, 0, width, height);
+                        let mut buffer = Buffer::empty(area);
+                        view.render(area, &mut buffer);
+                        assert_eq!(buffer[(0, 0)].bg, panel);
+
+                        let backdrop = ratatui::style::Color::Magenta;
+                        buffer.set_style(area, ratatui::style::Style::default().bg(backdrop));
+                        crate::bottom_pane::CenteredView(view.as_ref()).render(area, &mut buffer);
+                        let first_dialog_cell = buffer
+                            .content
+                            .iter()
+                            .find(|cell| cell.bg != backdrop)
+                            .expect("centered dialog painted its surface");
+                        assert_eq!(first_dialog_cell.bg, panel);
+                        assert_eq!(buffer[(0, 0)].bg, backdrop);
+                    }
+                }
+            },
+        );
+    }
+}
