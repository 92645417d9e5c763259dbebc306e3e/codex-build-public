+use crate::JsonSchema;
+use crate::TS;
+use serde::Deserialize;
+use serde::Serialize;
+use std::fmt;
+
+/// Identifies the result of a Telegram command without retaining its credentials or message.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum TelegramCommandKind {
+    Read,
+    Configure,
+    SetVersionSettings,
+    Disable,
+    Completion,
+    NeedsInput,
+    ProbeGithub,
+    CheckVersion,
+}
+
+#[derive(Serialize, Deserialize, Clone, PartialEq, Eq, JsonSchema, TS)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+#[ts(export_to = "v2/")]
+pub struct TelegramSetup {
+    pub bot_token: String,
+    pub chat_id: String,
+    pub github_token: String,
+    pub notify_version_updates: bool,
+    pub version_check_interval_hours: u16,
+}
+
+impl fmt::Debug for TelegramSetup {
+    fn fmt(&self, formatter: &mut fmt::Formatter<'_>) -> fmt::Result {
+        formatter
+            .debug_struct("TelegramSetup")
+            .field("bot_token", &"<redacted>")
+            .field("chat_id", &"<redacted>")
+            .field("github_token", &"<redacted>")
+            .field("notify_version_updates", &self.notify_version_updates)
+            .field(
+                "version_check_interval_hours",
+                &self.version_check_interval_hours,
+            )
+            .finish()
+    }
+}
+
+/// Telegram configuration and delivery commands. Each command admits only its own fields.
+#[derive(Serialize, Deserialize, Clone, PartialEq, Eq, JsonSchema, TS)]
+#[serde(tag = "kind", rename_all = "camelCase", deny_unknown_fields)]
+#[ts(tag = "kind", export_to = "v2/")]
+pub enum TelegramCommandParams {
+    Read {},
+    Configure {
+        setup: TelegramSetup,
+    },
+    #[serde(rename_all = "camelCase")]
+    #[ts(rename_all = "camelCase")]
+    SetVersionSettings {
+        notify_version_updates: bool,
+        version_check_interval_hours: u16,
+    },
+    Disable {},
+    /// Successful turn completion, subject to the saved minimum duration.
+    #[serde(rename_all = "camelCase")]
+    #[ts(rename_all = "camelCase")]
+    Completion {
+        text: String,
+        #[ts(type = "number")]
+        duration_ms: u64,
+    },
+    /// Immediate question or approval notification, deduplicated by its source event identity.
+    #[serde(rename_all = "camelCase")]
+    #[ts(rename_all = "camelCase")]
+    NeedsInput {
+        text: String,
+        notification_id: String,
+    },
+    ProbeGithub {},
+    CheckVersion {},
+}
+
+impl TelegramCommandParams {
+    pub fn kind(&self) -> TelegramCommandKind {
+        match self {
+            Self::Read {} => TelegramCommandKind::Read,
+            Self::Configure { .. } => TelegramCommandKind::Configure,
+            Self::SetVersionSettings { .. } => TelegramCommandKind::SetVersionSettings,
+            Self::Disable {} => TelegramCommandKind::Disable,
+            Self::Completion { .. } => TelegramCommandKind::Completion,
+            Self::NeedsInput { .. } => TelegramCommandKind::NeedsInput,
+            Self::ProbeGithub {} => TelegramCommandKind::ProbeGithub,
+            Self::CheckVersion {} => TelegramCommandKind::CheckVersion,
+        }
+    }
+}
+
+impl fmt::Debug for TelegramCommandParams {
+    fn fmt(&self, formatter: &mut fmt::Formatter<'_>) -> fmt::Result {
+        let mut fields = formatter.debug_struct("TelegramCommandParams");
+        fields.field("kind", &self.kind());
+        match self {
+            Self::Configure { setup } => {
+                fields.field("setup", setup);
+            }
+            Self::SetVersionSettings {
+                notify_version_updates,
+                version_check_interval_hours,
+            } => {
+                fields.field("notify_version_updates", notify_version_updates);
+                fields.field("version_check_interval_hours", version_check_interval_hours);
+            }
+            Self::Completion { duration_ms, .. } => {
+                fields.field("text", &"<redacted>");
+                fields.field("duration_ms", duration_ms);
+            }
+            Self::NeedsInput { .. } => {
+                fields.field("text", &"<redacted>");
+                fields.field("notification_id", &"<redacted>");
+            }
+            Self::Read {} | Self::Disable {} | Self::ProbeGithub {} | Self::CheckVersion {} => {}
+        }
+        fields.finish()
+    }
+}
+
+#[derive(Serialize, Deserialize, Debug, Clone, Default, PartialEq, Eq, JsonSchema, TS)]
+#[serde(rename_all = "camelCase")]
+#[ts(export_to = "v2/")]
+pub struct TelegramCommandResponse {
+    pub configured: bool,
+    pub github_token_configured: bool,
+    pub notify_version_updates: bool,
+    pub version_check_interval_hours: u16,
+    pub message: Option<String>,
+}
+
