+use super::*;
+use codex_http_client::OutboundProxyPolicy;
+use std::path::Path;
+use std::sync::atomic::AtomicUsize;
+use std::sync::atomic::Ordering;
+use url::Url;
+use wiremock::Mock;
+use wiremock::MockServer;
+use wiremock::Respond;
+use wiremock::ResponseTemplate;
+use wiremock::matchers::method;
+use wiremock::matchers::path;
+
+async fn processor(server: &MockServer, home: &Path) -> TelegramProcessor {
+    let base = Url::parse(&server.uri()).expect("mock URL");
+    let factory = HttpClientFactory::new(OutboundProxyPolicy::ReqwestDefault);
+    TelegramProcessor::with_http(
+        home.to_path_buf(),
+        TelegramHttp::with_urls(factory, base.clone(), base),
+    )
+}
+
+struct ReleaseSequence {
+    calls: AtomicUsize,
+}
+
+impl Respond for ReleaseSequence {
+    fn respond(&self, _: &wiremock::Request) -> ResponseTemplate {
+        let version = match self.calls.fetch_add(1, Ordering::SeqCst) {
+            0 => "1.0.0",
+            _ => "1.1.0",
+        };
+        ResponseTemplate::new(200).set_body_json(serde_json::json!([{
+            "tag_name": format!("rust-v{version}"),
+            "html_url": format!("https://example.invalid/{version}"),
+            "draft": false
+        }]))
+    }
+}
+
+#[tokio::test]
+async fn first_release_is_a_silent_baseline_and_later_release_notifies() {
+    let home = tempfile::tempdir().expect("tempdir");
+    let server = MockServer::start().await;
+    Mock::given(method("GET"))
+        .and(path("/repos/openai/codex/releases"))
+        .respond_with(ReleaseSequence {
+            calls: AtomicUsize::new(0),
+        })
+        .expect(2)
+        .mount(&server)
+        .await;
+    Mock::given(method("POST"))
+        .respond_with(ResponseTemplate::new(200).set_body_json(serde_json::json!({"ok": true})))
+        .expect(1)
+        .mount(&server)
+        .await;
+    let store = TelegramStore::new(home.path().to_path_buf());
+    let mut config = TelegramConfig::new("123:secret".to_string(), "chat".to_string());
+    config.github_token = Some("github-token".to_string());
+    config.notify_version_updates = true;
+    store.persist(Some(&config)).expect("persist config");
+    let base = Url::parse(&server.uri()).expect("mock URL");
+    let inner = Inner {
+        store,
+        http: TelegramHttp::with_urls(
+            HttpClientFactory::new(OutboundProxyPolicy::ReqwestDefault),
+            base.clone(),
+            base,
+        ),
+        version: Mutex::new(VersionMonitor::default()),
+    };
+
+    let baseline = inner.check_version(true).await.expect("establish baseline");
+    assert!(baseline.performed);
+    assert_eq!(baseline.version, Some(Version::new(1, 0, 0)));
+    inner.version.lock().await.last_attempt =
+        Some(Instant::now() - MANUAL_VERSION_CHECK_MIN_INTERVAL);
+    let update = inner.check_version(true).await.expect("notify update");
+    assert!(update.performed);
+    assert_eq!(update.version, Some(Version::new(1, 1, 0)));
+
+    let requests = server.received_requests().await.expect("requests");
+    let telegram = requests
+        .iter()
+        .find(|request| request.method.as_str() == "POST")
+        .expect("Telegram notification");
+    let body: serde_json::Value = serde_json::from_slice(&telegram.body).expect("Telegram JSON");
+    assert!(body["text"].as_str().is_some_and(|text| {
+        text.contains("Previous: 1.0.0") && text.contains("Latest: 1.1.0")
+    }));
+}
+
+#[tokio::test]
+async fn repeated_manual_checks_share_the_recent_attempt_gate() {
+    let home = tempfile::tempdir().expect("tempdir");
+    let server = MockServer::start().await;
+    Mock::given(method("GET"))
+        .and(path("/repos/openai/codex/releases"))
+        .respond_with(ResponseTemplate::new(503))
+        .expect(1)
+        .mount(&server)
+        .await;
+    let store = TelegramStore::new(home.path().to_path_buf());
+    let mut config = TelegramConfig::new("123:secret".to_string(), "chat".to_string());
+    config.github_token = Some("github-token".to_string());
+    config.notify_version_updates = true;
+    store.persist(Some(&config)).expect("persist config");
+    let base = Url::parse(&server.uri()).expect("mock URL");
+    let inner = Inner {
+        store,
+        http: TelegramHttp::with_urls(
+            HttpClientFactory::new(OutboundProxyPolicy::ReqwestDefault),
+            base.clone(),
+            base,
+        ),
+        version: Mutex::new(VersionMonitor::default()),
+    };
+
+    assert!(inner.check_version(true).await.is_err());
+    assert!(
+        !inner
+            .check_version(true)
+            .await
+            .expect("recent attempt")
+            .performed
+    );
+}
+
+#[tokio::test]
+async fn shutdown_cancels_an_in_flight_version_request() {
+    let home = tempfile::tempdir().expect("tempdir");
+    let server = MockServer::start().await;
+    Mock::given(method("GET"))
+        .and(path("/repos/openai/codex/releases"))
+        .respond_with(
+            ResponseTemplate::new(200)
+                .set_body_json(serde_json::json!([]))
+                .set_delay(Duration::from_secs(60)),
+        )
+        .expect(1)
+        .mount(&server)
+        .await;
+    let mut config = TelegramConfig::new("123:secret".to_string(), "chat".to_string());
+    config.github_token = Some("github-token".to_string());
+    config.notify_version_updates = true;
+    TelegramStore::new(home.path().to_path_buf())
+        .persist(Some(&config))
+        .expect("persist");
+    let mut processor = processor(&server, home.path()).await;
+    tokio::time::timeout(Duration::from_secs(5), async {
+        while server
+            .received_requests()
+            .await
+            .expect("requests")
+            .is_empty()
+        {
+            tokio::time::sleep(Duration::from_millis(10)).await;
+        }
+    })
+    .await
+    .expect("version request started");
+    processor.shutdown();
+    tokio::time::timeout(Duration::from_secs(5), &mut processor._task)
+        .await
+        .expect("worker stopped before HTTP timeout")
+        .expect("worker joined");
+}
+
+#[tokio::test]
+async fn dropping_processor_releases_its_background_owner() {
+    let home = tempfile::tempdir().expect("tempdir");
+    let server = MockServer::start().await;
+    let processor = processor(&server, home.path()).await;
+    let inner = Arc::downgrade(&processor.inner);
+    drop(processor);
+    tokio::time::timeout(Duration::from_secs(5), async {
+        while inner.upgrade().is_some() {
+            tokio::task::yield_now().await;
+        }
+    })
+    .await
+    .expect("worker owner released on drop");
+}
