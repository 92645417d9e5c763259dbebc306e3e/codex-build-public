+use codex_app_server_protocol::JSONRPCErrorError;
+use codex_http_client::HttpClientFactory;
+use semver::Version;
+use std::path::PathBuf;
+use std::sync::Arc;
+use std::time::Duration;
+use tokio::sync::Mutex;
+use tokio::sync::mpsc;
+use tokio::task::JoinHandle;
+use tokio::time::Instant;
+use tokio_util::sync::CancellationToken;
+
+use crate::error_code::internal_error;
+use crate::telegram_http::Destination;
+use crate::telegram_http::TelegramHttp;
+
+#[path = "telegram_store.rs"]
+mod store;
+use store::DEFAULT_VERSION_CHECK_INTERVAL_HOURS;
+use store::TelegramConfig;
+use store::TelegramStore;
+
+const MANUAL_VERSION_CHECK_MIN_INTERVAL: Duration = Duration::from_secs(30);
+
+pub(crate) struct TelegramProcessor {
+    inner: Arc<Inner>,
+    wake: mpsc::Sender<()>,
+    cancel: CancellationToken,
+    _task: JoinHandle<()>,
+}
+
+struct Inner {
+    store: TelegramStore,
+    http: TelegramHttp,
+    version: Mutex<VersionMonitor>,
+}
+
+#[derive(Default)]
+struct VersionMonitor {
+    baseline: Option<Version>,
+    last_attempt: Option<Instant>,
+}
+
+struct VersionCheck {
+    performed: bool,
+    version: Option<Version>,
+}
+
+impl TelegramProcessor {
+    pub(crate) fn new(codex_home: PathBuf, factory: HttpClientFactory) -> Self {
+        Self::with_http(codex_home, TelegramHttp::new(factory))
+    }
+
+    fn with_http(codex_home: PathBuf, http: TelegramHttp) -> Self {
+        let inner = Arc::new(Inner {
+            store: TelegramStore::new(codex_home),
+            http,
+            version: Mutex::new(VersionMonitor::default()),
+        });
+        let cancel = CancellationToken::new();
+        let (wake, mut wakes) = mpsc::channel(1);
+        let worker_inner = Arc::clone(&inner);
+        let worker_cancel = cancel.clone();
+        let task = tokio::spawn(async move {
+            loop {
+                let delay = tokio::select! {
+                    _ = worker_cancel.cancelled() => break,
+                    delay = worker_inner.version_delay() => delay,
+                };
+                let force = tokio::select! {
+                    _ = worker_cancel.cancelled() => break,
+                    _ = tokio::time::sleep(delay) => false,
+                    wake = wakes.recv() => {
+                        if wake.is_none() {
+                            break;
+                        }
+                        true
+                    },
+                };
+                tokio::select! {
+                    _ = worker_cancel.cancelled() => break,
+                    _ = worker_inner.check_version(force) => {},
+                }
+            }
+        });
+        Self {
+            inner,
+            wake,
+            cancel,
+            _task: task,
+        }
+    }
+
+    pub(crate) fn shutdown(&self) {
+        self.cancel.cancel();
+    }
+}
+
+impl Drop for TelegramProcessor {
+    fn drop(&mut self) {
+        self.shutdown();
+    }
+}
+
+impl Inner {
+    fn load(&self) -> Result<Option<TelegramConfig>, JSONRPCErrorError> {
+        self.store.load().map_err(storage_error)
+    }
+
+    async fn seed_version_baseline(&self, probe: crate::telegram_http::Probe) {
+        *self.version.lock().await = VersionMonitor {
+            baseline: probe.release.map(|release| release.version),
+            last_attempt: Some(Instant::now()),
+        };
+    }
+
+    async fn version_delay(&self) -> Duration {
+        let Some(config) = self.load().ok().flatten() else {
+            return version_interval_duration(DEFAULT_VERSION_CHECK_INTERVAL_HOURS);
+        };
+        if !config.notify_version_updates || config.github_token.is_none() {
+            return version_interval_duration(config.version_check_interval_hours);
+        }
+        let interval = version_interval_duration(config.version_check_interval_hours);
+        self.version
+            .lock()
+            .await
+            .last_attempt
+            .map_or(Duration::ZERO, |last| {
+                interval.saturating_sub(last.elapsed())
+            })
+    }
+
+    async fn check_version(&self, force: bool) -> Result<VersionCheck, JSONRPCErrorError> {
+        let Some(config) = self.load()? else {
+            return Ok(VersionCheck {
+                performed: false,
+                version: None,
+            });
+        };
+        if !config.notify_version_updates || config.github_token.is_none() {
+            return Ok(VersionCheck {
+                performed: false,
+                version: None,
+            });
+        }
+        let mut monitor = self.version.lock().await;
+        let minimum_interval = if force {
+            MANUAL_VERSION_CHECK_MIN_INTERVAL
+        } else {
+            version_interval_duration(config.version_check_interval_hours)
+        };
+        if monitor
+            .last_attempt
+            .is_some_and(|last| last.elapsed() < minimum_interval)
+        {
+            return Ok(VersionCheck {
+                performed: false,
+                version: monitor.baseline.clone(),
+            });
+        }
+        monitor.last_attempt = Some(Instant::now());
+        let probe = self
+            .http
+            .releases(config.github_token.as_deref().expect("checked token"))
+            .await
+            .map_err(|_| internal_error("GitHub version check failed"))?;
+        if let Some(candidate) = probe.release {
+            let Some(baseline) = monitor.baseline.as_ref() else {
+                monitor.baseline = Some(candidate.version);
+                return Ok(VersionCheck {
+                    performed: true,
+                    version: monitor.baseline.clone(),
+                });
+            };
+            if candidate.version > *baseline {
+                let channel = if candidate.version.pre.is_empty() {
+                    "stable"
+                } else {
+                    "prerelease"
+                };
+                let text = format!(
+                    "Codex update available\nPrevious: {}\nLatest: {}\nChannel: {channel}\n{}",
+                    baseline, candidate.version, candidate.url,
+                );
+                self.http
+                    .send(Destination(&config.bot_token, &config.chat_id), &text)
+                    .await
+                    .map_err(|_| internal_error("Telegram version notification failed"))?;
+                monitor.baseline = Some(candidate.version);
+            }
+        }
+        Ok(VersionCheck {
+            performed: true,
+            version: monitor.baseline.clone(),
+        })
+    }
+
+    async fn reset_version_baseline(&self) {
+        *self.version.lock().await = VersionMonitor::default();
+    }
+}
+
+fn storage_error(_: std::io::Error) -> JSONRPCErrorError {
+    internal_error("Telegram configuration operation failed")
+}
+
+fn version_interval_duration(hours: u16) -> Duration {
+    Duration::from_secs(u64::from(hours) * 60 * 60)
+}
