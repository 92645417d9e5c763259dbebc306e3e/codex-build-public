+#[test]
+fn native_response_records_keep_incomplete_costs_and_deduplicate_copies_by_identity() {
+    let directory = tempfile::tempdir().unwrap();
+    let incomplete = json!({"type":"token_usage_record","timestamp":"2026-02-01T00:01:00Z",
+        "payload":{"thread_id":"thread","response_id":"incomplete","usage":usage(280_000, 100)}});
+    let incomplete_snapshot = count(
+        "2026-02-01T00:01:00.001Z",
+        usage(100, 10),
+        usage(280_100, 110),
+    );
+    let standalone = json!({"type":"token_usage_record","timestamp":"2026-02-01T00:02:00Z",
+        "payload":{"thread_id":"thread","response_id":"standalone","usage":usage(50, 5)}});
+    write_rollout(
+        directory.path(),
+        "sessions/main.jsonl",
+        "thread",
+        None,
+        &[
+            count("2026-02-01T00:00:00Z", usage(100, 10), usage(100, 10)),
+            incomplete.clone(),
+            incomplete_snapshot,
+            standalone.clone(),
+        ],
+    );
+    // A same-thread copy can end before the original file's corresponding snapshot.
+    write_rollout(
+        directory.path(),
+        "sessions/copy.jsonl",
+        "thread",
+        None,
+        &[incomplete],
+    );
+    let mut distinct = standalone;
+    distinct["payload"]["response_id"] = json!("distinct");
+    write_rollout(
+        directory.path(),
+        "sessions/distinct.jsonl",
+        "thread",
+        None,
+        &[distinct],
+    );
+    let report = report(directory.path());
+    let total = &report.rows["2026-02-01"]["gpt-5.4"];
+    assert_eq!(report.diagnostics.duplicate_events, 1);
+    assert_eq!(report.diagnostics.unique_events, 4);
+    assert_eq!(total.tokens.input, 280_200);
+    assert_eq!(total.tokens.output, 120);
+    assert_eq!(total.long_tokens.input, 280_000);
+    assert!((total.cost - 1.12088).abs() < 1e-12);
+    assert!((total.short_cost - 0.00048).abs() < 1e-12);
+}
