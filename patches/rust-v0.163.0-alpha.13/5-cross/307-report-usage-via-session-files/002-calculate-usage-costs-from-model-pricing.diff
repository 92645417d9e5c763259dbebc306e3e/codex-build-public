+        "sessions/mixed.jsonl",
+        "mixed",
+        None,
+        &[
+            count("2026-02-01T00:00:00Z", usage(100, 10), usage(100, 10)),
+            count(
+                "2026-02-01T00:01:00Z",
+                usage(280_000, 100),
+                usage(280_100, 110),
+            ),
+        ],
+    );
+    let report = report(directory.path());
+    let usage = &report.rows["2026-02-01"]["gpt-5.4"];
+    assert_eq!(usage.tokens.subtract(usage.long_tokens).input, 100);
+    assert_eq!(usage.long_tokens.input, 280_000);
+    assert_eq!(usage.long_tokens.output, 100);
+    let mut total = super::super::types::Usage::default();
