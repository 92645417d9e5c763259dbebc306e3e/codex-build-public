+#[test]
+fn conflicting_response_copies_keep_first_owner_facts_and_report_invalid_duplicates() {
+    for equal_timestamps in [false, true] {
+        let directory = tempfile::tempdir().unwrap();
+        let original = json!({"type":"token_usage_record","timestamp":"2026-02-01T00:00:00Z",
+            "payload":{"thread_id":"thread","response_id":"same","usage":usage(100,10)}});
+        let mut copied = original.clone();
+        if !equal_timestamps {
+            copied["timestamp"] = json!("2026-02-01T00:01:00Z");
+        }
+        write_response_copy(
+            directory.path(),
+            "b-model-copy.jsonl",
+            Some("gpt-6-sol"),
+            &copied,
+        );
+        let mut conflicting_usage = copied.clone();
+        conflicting_usage["payload"]["usage"] = usage(200, 20);
+        write_response_copy(
+            directory.path(),
+            "c-usage-copy.jsonl",
+            Some("gpt-5.4"),
+            &conflicting_usage,
+        );
+        write_response_copy(
+            directory.path(),
+            "d-consistent-copy.jsonl",
+            Some("gpt-5.4"),
+            &copied,
+        );
+        write_response_copy(
+            directory.path(),
+            if equal_timestamps {
+                "a-original.jsonl"
+            } else {
+                "z-original.jsonl"
+            },
+            Some("gpt-5.4"),
+            &original,
+        );
+        let mut other_thread = original;
+        other_thread["payload"]["thread_id"] = json!("other-thread");
+        write_response_copy(
+            directory.path(),
+            "e-other-thread.jsonl",
+            Some("gpt-5.4"),
+            &other_thread,
+        );
+        let report = report(directory.path());
+        assert_eq!(report.rows["2026-02-01"].len(), 1);
+        let row = &report.rows["2026-02-01"]["gpt-5.4"];
+        assert_eq!(row.tokens.input, 200);
+        assert_eq!(row.tokens.output, 20);
+        assert_eq!(row.tokens.total, 220);
+        assert!((row.cost - 0.00048).abs() < 1e-12);
+        assert!(report.missing_prices.is_empty());
+        assert_eq!(report.diagnostics.unique_events, 2);
+        assert_eq!(report.diagnostics.duplicate_events, 3);
+        assert_eq!(report.diagnostics.malformed_records, 2);
+    }
+}
+
+#[test]
+fn mixed_context_totals_retain_token_partitions_and_the_prices_used() {
+    let directory = tempfile::tempdir().unwrap();
+    write_rollout(
