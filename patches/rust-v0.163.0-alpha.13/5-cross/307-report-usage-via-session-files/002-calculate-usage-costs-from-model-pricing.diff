+#[test]
+fn response_identity_merges_missing_model_without_repeating_or_redating_usage() {
+    for (first_model, copied_model) in [
+        (None, Some("gpt-5.4")),
+        (Some("gpt-5.4"), None),
+        (Some("gpt-5.4"), Some("gpt-5.4")),
+        (None, None),
+    ] {
+        let directory = tempfile::tempdir().unwrap();
+        let original = json!({"type":"token_usage_record","timestamp":"2026-01-31T15:59:59Z",
+            "payload":{"thread_id":"thread","response_id":"same","usage":usage(100,10)}});
+        let mut copied = original.clone();
+        copied["timestamp"] = json!("2026-01-31T16:00:01Z");
+        // Discovery order differs from response arrival order.
+        write_response_copy(directory.path(), "a-copy.jsonl", copied_model, &copied);
+        write_response_copy(directory.path(), "z-original.jsonl", first_model, &original);
+        let report = report(directory.path());
+        let expected_model = first_model.or(copied_model).unwrap_or("unknown model");
+        assert_eq!(report.rows.len(), 1);
+        assert_eq!(report.rows["2026-01-31"].len(), 1);
+        let row = &report.rows["2026-01-31"][expected_model];
+        assert_eq!(row.tokens.input, 100);
+        assert_eq!(row.tokens.output, 10);
+        assert_eq!(row.tokens.total, 110);
+        let expected_cost = if expected_model == "unknown model" {
+            0.0
+        } else {
+            0.00024
+        };
+        assert!((row.cost - expected_cost).abs() < 1e-12);
+        assert_eq!(
+            report.missing_prices.is_empty(),
+            expected_model != "unknown model"
+        );
+        assert_eq!(report.diagnostics.unique_events, 1);
+        assert_eq!(report.diagnostics.duplicate_events, 1);
+        assert_eq!(report.diagnostics.malformed_records, 0);
+    }
+}
