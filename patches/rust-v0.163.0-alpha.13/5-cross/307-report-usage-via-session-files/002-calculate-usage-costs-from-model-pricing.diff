+use super::*;
+use crate::usage::types::Tokens;
+use pretty_assertions::assert_eq;
+use serde_json::Value;
+use serde_json::json;
+use std::fs;
+
+fn usage(input: u64, output: u64) -> Value {
+    json!({"input_tokens":input,"output_tokens":output,"total_tokens":input+output})
+}
+
+fn count(at: &str, last: Value, total: Value) -> Value {
+    json!({"type":"event_msg","timestamp":at,"payload":{"type":"token_count",
+        "info":{"last_token_usage":last,"total_token_usage":total}}})
+}
+
+fn write_rollout(root: &Path, relative: &str, id: &str, parent: Option<&str>, events: &[Value]) {
+    let path = root.join(relative);
+    fs::create_dir_all(path.parent().unwrap()).unwrap();
+    let header = json!({"type":"session_meta","timestamp":"2026-02-01T00:00:00Z",
+        "payload":{"id":id,"forked_from_id":parent,"history_mode":"paginated"}});
+    let context = json!({"type":"turn_context","payload":{"model":"gpt-5.4","effort":"high"}});
+    let mut text = format!("{header}\n{context}\n");
+    for event in events {
+        text.push_str(&format!("{event}\n"));
+    }
+    fs::write(path, text).unwrap();
+}
+
+fn prices() -> Prices {
+    serde_json::from_value(json!({"gpt-5.4":{
+        "0": {"input":2.0,"output":4.0,"cache_read":1.0,"cache_write":3.0},
+        "272000": {"input":4.0,"output":4.0,"cache_read":1.0,"cache_write":3.0}
+    }}))
+    .unwrap()
+}
+
+fn report(root: &Path) -> UsageReport {
+    let now = DateTime::parse_from_rfc3339("2026-02-01T04:00:00Z")
+        .unwrap()
+        .timestamp_millis();
+    load(
+        root,
+        prices(),
+        FixedOffset::east_opt(8 * 3600).unwrap(),
+        now,
+    )
+    .unwrap()
+}
+
+fn prices_with_applied_model() -> Prices {
+    let mut result = prices();
+    result.insert(
+        "gpt-6-sol".into(),
+        serde_json::from_value(json!({
+            "0":{"input":2.0,"cache_read":0.2,"cache_write":2.5,"output":10.0}
+        }))
+        .unwrap(),
+    );
+    result
+}
+
+#[test]
+fn applied_settings_price_standalone_compaction_without_turn_context() {
+    for (owner, model, after_start, expected) in [
+        (Some("thread"), Some("gpt-6-sol"), false, "gpt-6-sol"),
+        (Some("foreign"), Some("gpt-6-sol"), false, "unknown model"),
+        (None, Some("gpt-6-sol"), false, "unknown model"),
+        (Some("thread"), None, false, "unknown model"),
+        (Some("thread"), Some(" "), false, "unknown model"),
+        (Some("thread"), Some("gpt-6-sol"), true, "unknown model"),
+        (
+            Some("thread"),
+            Some(" custom \"model\" "),
+            false,
+            "custom \"model\"",
+        ),
+    ] {
+        let directory = tempfile::tempdir().unwrap();
+        fs::create_dir(directory.path().join("sessions")).unwrap();
+        let header = json!({"type":"session_meta","timestamp":"2026-09-26T02:50:33.079Z",
+            "payload":{"id":"thread","history_mode":"paginated",
+                "history_base":{"end_ordinal_exclusive":66042}}});
+        let settings = json!({"type":"event_msg",
+            "timestamp":if after_start { "2026-09-26T02:50:40.000Z" } else { "2026-09-26T02:50:33.178Z" },
+            "payload":{"type":"thread_settings_applied","thread_id":owner,
+                "thread_settings":{"model":model,"service_tier":"default"}}});
+        let started = codex_rollout::RolloutLine {
+            timestamp: "2026-09-26T02:50:37.166Z".into(),
+            ordinal: None,
+            item: serde_json::from_value(json!({"type":"event_msg",
+                "payload":{"type":"task_started","turn_id":"compaction"}}))
+            .unwrap(),
+        };
+        let started = serde_json::to_string(&started).unwrap();
+        let mut text = if after_start {
+            format!("{header}\n{started}\n{settings}\n")
+        } else {
+            format!("{header}\n{settings}\n{started}\n")
+        };
+        let mut checkpoint_settings = settings;
+        checkpoint_settings["timestamp"] = json!("2026-09-26T02:51:03.826Z");
+        let reported = json!({"input_tokens":214570,"cached_input_tokens":213504,
+            "cache_write_input_tokens":0,"output_tokens":1239,
+            "reasoning_output_tokens":0,"total_tokens":215809});
+        for event in [
+            json!({"type":"token_usage_record","timestamp":"2026-09-26T02:51:03.794Z",
+                "payload":{"thread_id":"thread","response_id":"compaction","usage":reported}}),
+            json!({"type":"compacted","payload":{"compaction_response_id":"compaction"}}),
+            checkpoint_settings,
+            count(
+                "2026-09-26T02:51:03.833Z",
+                json!({"total_tokens":26471}),
+                json!({"input_tokens":1405234158,"cached_input_tokens":1377123584,
+                    "output_tokens":3915828,"reasoning_output_tokens":1829056,"total_tokens":1409149986}),
+            ),
+            json!({"type":"turn_context","payload":{"model":"gpt-5.4","turn_id":"later"}}),
+        ] {
+            text.push_str(&format!("{event}\n"));
+        }
+        fs::write(directory.path().join("sessions/compaction.jsonl"), text).unwrap();
+        let now = DateTime::parse_from_rfc3339("2026-10-16T04:10:30Z")
+            .unwrap()
+            .timestamp_millis();
+        let report = load(
+            directory.path(),
+            prices_with_applied_model(),
+            FixedOffset::east_opt(8 * 3600).unwrap(),
+            now,
+        )
+        .unwrap();
+        for (rows, period) in [
+            (&report.rows, "2026-09-26"),
+            (&report.weekly_rows, "2026-09-21"),
+            (&report.monthly_rows, "2026-09"),
+            (&report.yearly_rows, "2026"),
+        ] {
+            assert_eq!(rows[period].len(), 1);
+            let row = &rows[period][expected];
+            assert_eq!(
+                row.tokens,
+                Tokens {
+                    input: 214570,
+                    cached: 213504,
+                    output: 1239,
+                    total: 215809,
+                    ..Tokens::default()
+                }
+            );
+            let expected_cost = if expected == "gpt-6-sol" {
+                0.0572228
+            } else {
+                0.0
+            };
+            assert!((row.cost - expected_cost).abs() < 1e-12);
+        }
+        assert_eq!(
+            report.missing_prices.contains(expected),
+            expected != "gpt-6-sol"
+        );
+        assert_eq!(report.diagnostics.unique_events, 1);
+        assert_eq!(report.diagnostics.duplicate_events, 0);
+        assert_eq!(report.diagnostics.replayed_events, 0);
+        assert_eq!(report.diagnostics.malformed_records, 0);
+    }
+}
