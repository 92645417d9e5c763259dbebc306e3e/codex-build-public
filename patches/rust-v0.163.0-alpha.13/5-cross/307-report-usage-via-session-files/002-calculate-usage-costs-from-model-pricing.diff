+#[test]
+fn migrated_parent_replay_and_archive_copy_are_counted_once() {
+    let directory = tempfile::tempdir().unwrap();
+    let root = directory.path();
+    let parent = count(
+        "2026-01-31T16:00:00Z",
+        usage(/*input*/ 100, /*output*/ 10),
+        usage(/*input*/ 100, /*output*/ 10),
+    );
+    write_rollout(
+        root,
+        "sessions/2026/01/31/parent.jsonl",
+        "parent",
+        /*parent*/ None,
+        &[parent.clone()],
+    );
+    write_rollout(
+        root,
+        "archived_sessions/2026/01/31/parent.jsonl",
+        "parent",
+        /*parent*/ None,
+        &[count(
+            "2026-01-31T16:00:00Z",
+            usage(/*input*/ 999, /*output*/ 1),
+            usage(/*input*/ 999, /*output*/ 1),
+        )],
+    );
+    let replay = count(
+        "2026-02-01T00:00:00Z",
+        usage(/*input*/ 100, /*output*/ 10),
+        usage(/*input*/ 100, /*output*/ 10),
+    );
+    let own = count(
+        "2026-02-01T00:00:03Z",
+        usage(/*input*/ 200, /*output*/ 20),
+        usage(/*input*/ 300, /*output*/ 30),
+    );
+    write_rollout(
+        root,
+        "sessions/2026/02/01/child.jsonl",
+        "child",
+        Some("parent"),
+        &[replay, own.clone(), own],
+    );
+    fs::write(
+        root.join("sessions/ignored.jsonl"),
+        "{\"type\":\"session_meta\",\"payload\":{\"history_mode\":\"linear\"}}\n",
+    )
+    .unwrap();
+    fs::write(
+        root.join("sessions/ignored.jsonl.zst"),
+        "not an admitted input",
+    )
+    .unwrap();
+    let daily = report(root);
+    assert_eq!(
+        daily.rows["2026-02-01"]["gpt-5.4"].tokens,
+        Tokens {
+            input: 300,
+            output: 30,
+            total: 330,
+            ..Tokens::default()
+        }
+    );
+    assert!((daily.rows["2026-02-01"]["gpt-5.4"].cost - 0.00072).abs() < 1e-12);
+    assert_eq!(daily.diagnostics.replayed_events, 1);
+    assert_eq!(daily.diagnostics.skipped_non_paginated, 1);
+    for (range, period) in [
+        (UsageRange::Today, "2026-02-01"),
+        (UsageRange::Weekly, "2026-01-26"),
+        (UsageRange::Monthly, "2026-02"),
+        (UsageRange::Yearly, "2026"),
+    ] {
+        assert_eq!(
+            daily
+                .periods(range)
+                .find(|(key, _)| key.as_str() == period)
+                .unwrap()
+                .1
+                .get("gpt-5.4"),
+            daily.rows["2026-02-01"].get("gpt-5.4")
+        );
+    }
+    assert!(daily.periods(UsageRange::Yesterday).next().is_none());
+}
