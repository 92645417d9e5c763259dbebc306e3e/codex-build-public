+#[test]
+fn deferred_snapshot_does_not_move_a_response_to_another_calendar_day() {
+    let directory = tempfile::tempdir().unwrap();
+    let record = json!({"type":"token_usage_record","timestamp":"2026-01-31T15:59:59Z",
+        "payload":{"thread_id":"thread","response_id":"waiting-tool","usage":usage(100, 10)}});
+    write_rollout(
+        directory.path(),
+        "sessions/deferred.jsonl",
+        "thread",
+        None,
+        &[
+            record,
+            count("2026-01-31T16:05:00Z", usage(100, 10), usage(100, 10)),
+        ],
+    );
+    let report = report(directory.path());
+    assert_eq!(report.rows["2026-01-31"]["gpt-5.4"].tokens.total, 110);
+    assert!(!report.rows.contains_key("2026-02-01"));
+    assert_eq!(report.monthly_rows["2026-01"]["gpt-5.4"].tokens.total, 110);
