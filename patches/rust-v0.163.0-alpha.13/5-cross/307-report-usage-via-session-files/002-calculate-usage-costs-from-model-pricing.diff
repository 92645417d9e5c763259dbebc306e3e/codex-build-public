@@ -1,6 +1,108 @@
 //! Local paginated-rollout accounting, with no external process or network dependency.
+mod aggregate;
 mod reader;
 mod types;
 mod wire;
 
+use chrono::FixedOffset;
+use chrono::Local;
+use chrono::NaiveDate;
+use codex_models_manager::model_pricing;
+use codex_models_manager::model_pricing::Prices;
+use std::collections::BTreeMap;
+use std::collections::BTreeSet;
+use std::path::Path;
+use types::Diagnostics;
+use types::Usage;
+
 type Error = Box<dyn std::error::Error + Send + Sync>;
+type Rows = BTreeMap<String, BTreeMap<String, Usage>>;
+
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub(crate) enum UsageRange {
+    Today,
+    Yesterday,
+    Daily,
+    Weekly,
+    Monthly,
+    Yearly,
+    Heatmap,
+}
+
+impl UsageRange {
+    pub(crate) fn label(self) -> &'static str {
+        match self {
+            Self::Today => "today",
+            Self::Yesterday => "yesterday",
+            Self::Daily => "daily",
+            Self::Weekly => "weekly",
+            Self::Monthly => "monthly",
+            Self::Yearly => "yearly",
+            Self::Heatmap => "heatmap",
+        }
+    }
+}
+
+#[derive(Debug)]
+pub(crate) struct UsageReport {
+    pub(crate) refreshed_at: chrono::DateTime<FixedOffset>,
+    rows: Rows,
+    weekly_rows: Rows,
+    monthly_rows: Rows,
+    yearly_rows: Rows,
+    prices: Prices,
+    missing_prices: BTreeSet<String>,
+    diagnostics: Diagnostics,
+    today: NaiveDate,
+    timezone: FixedOffset,
+}
+
+impl UsageReport {
+    fn periods(
+        &self,
+        range: UsageRange,
+    ) -> impl DoubleEndedIterator<Item = (&String, &BTreeMap<String, Usage>)> {
+        let rows = match range {
+            UsageRange::Weekly => &self.weekly_rows,
+            UsageRange::Monthly => &self.monthly_rows,
+            UsageRange::Yearly => &self.yearly_rows,
+            UsageRange::Today | UsageRange::Yesterday | UsageRange::Daily | UsageRange::Heatmap => {
+                &self.rows
+            }
+        };
+        let bounds = match range {
+            UsageRange::Today => Some((self.today, self.today)),
+            UsageRange::Yesterday => {
+                let yesterday = self.today - chrono::Duration::days(1);
+                Some((yesterday, yesterday))
+            }
+            UsageRange::Heatmap => Some((self.today - chrono::Duration::days(364), self.today)),
+            UsageRange::Daily | UsageRange::Weekly | UsageRange::Monthly | UsageRange::Yearly => {
+                None
+            }
+        }
+        .map(|(start, end)| (start.to_string(), end.to_string()));
+        rows.iter().filter(move |(date, _)| {
+            bounds
+                .as_ref()
+                .is_none_or(|(start, end)| *date >= start && *date <= end)
+        })
+    }
+}
+
+pub(crate) fn load(codex_home: &Path) -> Result<UsageReport, String> {
+    let now = Local::now();
+    let prices = model_pricing::read_prices(codex_home).map_err(|error| error.to_string())?;
+    let report = aggregate::load(codex_home, prices, *now.offset(), now.timestamp_millis())
+        .map_err(|error| format!("could not load Codex usage: {error}"))?;
+    model_pricing::ensure_models(
+        codex_home,
+        report
+            .rows
+            .values()
+            .flat_map(BTreeMap::keys)
+            .map(String::as_str),
+    )
+    .map_err(|error| error.to_string())?;
+    Ok(report)
+}
