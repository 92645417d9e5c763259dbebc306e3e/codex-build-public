+#[test]
+fn applied_model_changes_wait_for_task_start_and_preserve_response_context() {
+    let directory = tempfile::tempdir().unwrap();
+    let next_model = json!({"type":"event_msg","payload":{
+        "type":"thread_settings_applied","thread_id":"thread",
+        "thread_settings":{"model":"gpt-6-sol"}}});
+    let events = [
+        json!({"type":"event_msg","payload":{"type":"task_started","turn_id":"running"}}),
+        next_model,
+        json!({"type":"event_msg","payload":{
+            "type":"thread_settings_applied","thread_id":"foreign",
+            "thread_settings":{"model":"foreign-model"}}}),
+        json!({"type":"token_usage_record","timestamp":"2026-02-01T00:00:00Z",
+            "payload":{"thread_id":"thread","response_id":"running","usage":usage(100,10)}}),
+        count("2026-02-01T00:00:00.001Z", usage(100, 10), usage(100, 10)),
+        json!({"type":"event_msg","payload":{"type":"task_started","turn_id":"next-task"}}),
+        json!({"type":"token_usage_record","timestamp":"2026-02-01T00:01:00Z",
+            "payload":{"thread_id":"thread","response_id":"next-task","usage":usage(20,5)}}),
+        count("2026-02-01T00:01:00.001Z", usage(20, 5), usage(120, 15)),
+        count("2026-02-01T00:02:00Z", usage(20, 5), usage(140, 20)),
+        json!({"type":"event_msg","payload":{
+            "type":"thread_settings_applied","thread_id":"thread",
+            "thread_settings":{"model":"future-model"}}}),
+        json!({"type":"turn_context","payload":{"model":"future-model"}}),
+    ];
+    write_rollout(
+        directory.path(),
+        "sessions/settings.jsonl",
+        "thread",
+        None,
+        &events,
+    );
+    let now = DateTime::parse_from_rfc3339("2026-02-01T04:00:00Z")
+        .unwrap()
+        .timestamp_millis();
+    let report = load(
+        directory.path(),
+        prices_with_applied_model(),
+        FixedOffset::east_opt(8 * 3600).unwrap(),
+        now,
+    )
+    .unwrap();
+    let rows = &report.rows["2026-02-01"];
+    assert_eq!(rows.len(), 2);
+    assert_eq!(rows["gpt-5.4"].tokens.total, 110);
+    assert_eq!(rows["gpt-6-sol"].tokens.total, 50);
+    assert!((rows["gpt-5.4"].cost - 0.00024).abs() < 1e-12);
+    assert!((rows["gpt-6-sol"].cost - 0.00018).abs() < 1e-12);
+    assert!(report.missing_prices.is_empty());
+    assert_eq!(report.diagnostics.unique_events, 3);
+    assert_eq!(report.diagnostics.duplicate_events, 0);
+}
