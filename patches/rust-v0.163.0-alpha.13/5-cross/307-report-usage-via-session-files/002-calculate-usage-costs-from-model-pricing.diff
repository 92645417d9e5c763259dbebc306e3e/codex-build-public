+fn write_response_copy(root: &Path, name: &str, model: Option<&str>, record: &Value) {
+    let directory = root.join("sessions");
+    fs::create_dir_all(&directory).unwrap();
+    let header = json!({"type":"session_meta","payload":{
+        "id":record["payload"]["thread_id"],"history_mode":"paginated"}});
+    let context = json!({"type":"turn_context","payload":{"model":model}});
+    fs::write(
+        directory.join(name),
+        format!("{header}\n{context}\n{record}\n"),
+    )
+    .unwrap();
+}
