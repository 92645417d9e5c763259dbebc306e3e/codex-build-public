new file mode 100644
--- /dev/null
+++ b/codex-rs/app-server/src/usage/service_tests.rs
@@ -0,0 +1,110 @@
+use super::*;
+use pretty_assertions::assert_eq;
+use std::fs;
+use std::time::Duration;
+
+#[tokio::test]
+async fn concurrent_clients_share_a_snapshot_without_automatic_expiry() {
+    let home = tempfile::tempdir().unwrap();
+    let service = Service::new(home.path().to_path_buf());
+    let (first, second) = tokio::join!(
+        service.read(UsageReadParams::default()),
+        service.read(UsageReadParams::default()),
+    );
+    let first = first.unwrap();
+    let second = second.unwrap();
+    assert_ne!(first.refreshed, second.refreshed);
+    let first = first.report;
+    let second = second.report;
+    assert!(Arc::ptr_eq(&first, &second));
+    assert_eq!(first.latest_usage_at, None);
+    assert!(first.build_duration_ms.is_some());
+    assert_eq!(first.build_duration_ms, second.build_duration_ms);
+
+    fs::create_dir(home.path().join("sessions")).unwrap();
+    fs::write(
+        home.path().join("sessions/linear.jsonl"),
+        "{\"type\":\"session_meta\",\"payload\":{\"history_mode\":\"linear\"}}\n",
+    )
+    .unwrap();
+    let cached = service.read(UsageReadParams::default()).await.unwrap();
+    assert!(!cached.refreshed);
+    let cached = cached.report;
+    assert!(Arc::ptr_eq(&first, &cached));
+    assert_eq!(cached.diagnostics.skipped_non_paginated, 0);
+    assert_eq!(cached.build_duration_ms, first.build_duration_ms);
+
+    let refreshed = service
+        .read(UsageReadParams { refresh: true })
+        .await
+        .unwrap();
+    assert!(refreshed.refreshed);
+    let refreshed = refreshed.report;
+    assert!(!Arc::ptr_eq(&first, &refreshed));
+    assert_eq!(refreshed.diagnostics.skipped_non_paginated, 1);
+    let another_client = service.read(UsageReadParams::default()).await.unwrap();
+    assert!(!another_client.refreshed);
+    let another_client = another_client.report;
+    assert!(Arc::ptr_eq(&refreshed, &another_client));
+    assert!(refreshed.build_duration_ms.is_some());
+    assert_eq!(
+        another_client.build_duration_ms,
+        refreshed.build_duration_ms
+    );
+
+    tokio::time::pause();
+    tokio::time::advance(Duration::from_secs(25 * 60 * 60)).await;
+    let aged = service.read(UsageReadParams::default()).await.unwrap();
+    assert!(!aged.refreshed);
+    let aged = aged.report;
+    assert!(Arc::ptr_eq(&refreshed, &aged));
+    assert_eq!(aged.diagnostics.skipped_non_paginated, 1);
+}
+
+#[tokio::test]
+async fn explicit_refresh_reports_scan_errors_and_recovers_on_the_next_request() {
+    let home = tempfile::tempdir().unwrap();
+    let service = Service::new(home.path().to_path_buf());
+    let initial = service.read(UsageReadParams::default()).await.unwrap();
+    fs::write(home.path().join("sessions"), "not a directory").unwrap();
+    assert!(
+        service
+            .read(UsageReadParams { refresh: true })
+            .await
+            .is_err()
+    );
+    let cached = service.read(UsageReadParams::default()).await.unwrap();
+    assert!(Arc::ptr_eq(&initial.report, &cached.report));
+    assert_eq!(
+        cached.report.build_duration_ms,
+        initial.report.build_duration_ms
+    );
+    fs::remove_file(home.path().join("sessions")).unwrap();
+    let response = service
+        .read(UsageReadParams { refresh: true })
+        .await
+        .unwrap();
+    let wire = serde_json::to_value(&response).unwrap();
+    let decoded: UsageReadResponse = serde_json::from_value(wire.clone()).unwrap();
+    assert_eq!(decoded, response);
+    assert!(response.refreshed);
+    assert!(response.report.build_duration_ms.is_some());
+
+    let mut zero_duration = wire.clone();
+    zero_duration["report"]["buildDurationMs"] = serde_json::json!(0);
+    let decoded: UsageReadResponse = serde_json::from_value(zero_duration).unwrap();
+    assert_eq!(decoded.report.build_duration_ms, Some(0));
+
+    // Installing a new TUI does not require restarting the shared server.
+    let mut older_response = wire;
+    older_response.as_object_mut().unwrap().remove("refreshed");
+    older_response["report"]
+        .as_object_mut()
+        .unwrap()
+        .remove("buildDurationMs");
+    let decoded: UsageReadResponse = serde_json::from_value(older_response).unwrap();
+    assert!(!decoded.refreshed);
+    let mut expected = (*response.report).clone();
+    expected.build_duration_ms = None;
+    assert_eq!(*decoded.report, expected);
+}
