+#[derive(Clone, Debug, Deserialize, JsonSchema, PartialEq, Serialize, TS)]
+#[serde(rename_all = "camelCase")]
+#[ts(export_to = "v2/")]
+pub struct UsagePriceRates {
+    pub input: f64,
+    pub cache_read: f64,
+    pub cache_write: f64,
+    pub output: f64,
+}
+
+#[derive(Clone, Copy, Debug, Deserialize, Eq, JsonSchema, PartialEq, Serialize, TS)]
+#[serde(rename_all = "camelCase")]
+#[ts(export_to = "v2/")]
+pub enum UsageQuotaStatus {
+    Completed,
+    Provisional,
+}
+
+#[derive(Clone, Debug, Deserialize, JsonSchema, PartialEq, Serialize, TS)]
+#[serde(rename_all = "camelCase")]
+#[ts(export_to = "v2/")]
+pub struct UsageQuotaEstimate {
+    pub started_at: String,
+    pub ended_at: String,
+    pub used_percent_start: f64,
+    pub used_percent_end: f64,
+    pub observed_cost_usd: f64,
+    /// Usage in the measured segments, excluding credit-funded gaps.
+    /// Absent in snapshots from older servers.
+    #[serde(default)]
+    pub model_usage: Option<UsageByModel>,
+    pub estimated_weekly_cost_usd: f64,
+    pub sample_count: usize,
+    pub status: UsageQuotaStatus,
+}
+
+/// A continuous interval of observed credit deductions, without an estimated quota or status.
+#[derive(Clone, Debug, Deserialize, JsonSchema, PartialEq, Serialize, TS)]
+#[serde(rename_all = "camelCase")]
+#[ts(export_to = "v2/")]
+pub struct UsageCreditPeriod {
+    pub started_at: String,
+    pub ended_at: String,
+    pub used_credits: f64,
+    pub observed_cost_usd: f64,
+    /// Usage in the observed deduction interval, absent in older snapshots.
+    #[serde(default)]
+    pub model_usage: Option<UsageByModel>,
+    /// Number of balance observations spanning the interval, including its starting balance.
+    pub sample_count: usize,
+}
