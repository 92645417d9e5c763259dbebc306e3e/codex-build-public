+use crate::JsonSchema;
+use crate::TS;
+pub use codex_protocol::usage::*;
+use serde::Deserialize;
+use serde::Serialize;
+use std::sync::Arc;
+
+#[derive(Clone, Debug, Default, Deserialize, JsonSchema, PartialEq, Serialize, TS)]
+#[serde(rename_all = "camelCase")]
+#[ts(export_to = "v2/")]
+pub struct UsageReadParams {
+    /// Explicitly rebuild the server's shared snapshot, which otherwise never expires.
+    #[serde(default)]
+    pub refresh: bool,
+}
+
+#[derive(Clone, Debug, Deserialize, JsonSchema, PartialEq, Serialize, TS)]
+#[serde(rename_all = "camelCase")]
+#[ts(export_to = "v2/")]
+pub struct UsageReadResponse {
+    pub report: Arc<UsageReport>,
+    /// True when this request rebuilt the snapshot instead of reading the cache.
+    /// Older running servers do not report this distinction.
+    #[serde(default)]
+    pub refreshed: bool,
+}
