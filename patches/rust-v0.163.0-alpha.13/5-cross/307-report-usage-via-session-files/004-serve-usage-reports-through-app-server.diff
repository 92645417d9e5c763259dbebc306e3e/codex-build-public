+use chrono::DateTime;
+use chrono::FixedOffset;
+use schemars::JsonSchema;
+use serde::Deserialize;
+use serde::Serialize;
+use std::collections::BTreeMap;
+use std::collections::BTreeSet;
+use ts_rs::TS;
+
+pub type UsageByModel = BTreeMap<String, UsageTotals>;
+pub type UsageRows = BTreeMap<String, UsageByModel>;
+
+/// A single server-local accounting snapshot, shared by all report views and clients.
+#[derive(Clone, Debug, Deserialize, JsonSchema, PartialEq, Serialize, TS)]
+#[serde(rename_all = "camelCase")]
+#[ts(export_to = "v2/")]
+pub struct UsageReport {
+    /// Snapshot time and the local offset used for its calendar aggregation.
+    #[schemars(with = "String")]
+    #[ts(type = "string")]
+    pub refreshed_at: DateTime<FixedOffset>,
+    /// Complete producer build duration retained with this snapshot, in milliseconds.
+    /// Absent in reports from servers that predate this field; zero is a measured duration.
+    #[serde(default)]
+    pub build_duration_ms: Option<u64>,
+    /// Latest counted JSONL usage timestamp, absent when no owned usage was found.
+    #[schemars(with = "Option<String>")]
+    #[ts(type = "string | null")]
+    pub latest_usage_at: Option<DateTime<FixedOffset>>,
+    pub rows: UsageRows,
+    pub weekly_rows: UsageRows,
+    pub monthly_rows: UsageRows,
+    pub yearly_rows: UsageRows,
+    /// Model prices by inclusive input-token threshold, in USD per million tokens.
+    pub prices: BTreeMap<String, BTreeMap<u64, UsagePriceRates>>,
+    pub quota: Vec<UsageQuotaEstimate>,
+    pub credits: Vec<UsageCreditPeriod>,
+    pub missing_prices: BTreeSet<String>,
+    pub diagnostics: UsageDiagnostics,
+}
+
+/// Input includes both cache buckets; reasoning is already included in output.
+#[derive(
+    Clone,
+    Copy,
+    Debug,
+    Default,
+    Deserialize,
+    Eq,
+    JsonSchema,
+    Ord,
+    PartialEq,
+    PartialOrd,
+    Serialize,
+    TS,
+)]
+#[serde(rename_all = "camelCase")]
+#[ts(export_to = "v2/")]
+pub struct UsageTokens {
+    pub input: u64,
+    pub cached: u64,
+    pub cache_write: u64,
+    pub output: u64,
+    pub reasoning: u64,
+    pub total: u64,
+}
+
+impl UsageTokens {
+    pub fn subtract(self, previous: Self) -> Self {
+        let input = self.input.saturating_sub(previous.input);
+        let cached = self.cached.saturating_sub(previous.cached).min(input);
+        Self {
+            input,
+            cached,
+            cache_write: self
+                .cache_write
+                .saturating_sub(previous.cache_write)
+                .min(input - cached),
+            output: self.output.saturating_sub(previous.output),
+            reasoning: self.reasoning.saturating_sub(previous.reasoning),
+            total: self.total.saturating_sub(previous.total),
+        }
+    }
+
+    pub fn is_empty(self) -> bool {
+        self.input == 0
+            && self.cached == 0
+            && self.cache_write == 0
+            && self.output == 0
+            && self.reasoning == 0
+    }
+
+    pub fn add(&mut self, other: Self) {
+        self.input += other.input;
+        self.cached += other.cached;
+        self.cache_write += other.cache_write;
+        self.output += other.output;
+        self.reasoning += other.reasoning;
+        self.total += other.total;
+    }
+}
+
+#[derive(Clone, Debug, Default, Deserialize, JsonSchema, PartialEq, Serialize, TS)]
+#[serde(rename_all = "camelCase")]
+#[ts(export_to = "v2/")]
+pub struct UsageTotals {
+    pub tokens: UsageTokens,
+    pub long_tokens: UsageTokens,
+    pub cost: f64,
+    pub short_cost: f64,
+    pub long_cost: f64,
+}
+
+impl UsageTotals {
+    pub fn add(&mut self, tokens: UsageTokens, cost: f64, long: bool) {
+        self.tokens.add(tokens);
+        self.cost += cost;
+        if long {
+            self.long_tokens.add(tokens);
+            self.long_cost += cost;
+        } else {
+            self.short_cost += cost;
+        }
+    }
+
+    pub fn add_usage(&mut self, other: &Self) {
+        self.tokens.add(other.tokens);
+        self.long_tokens.add(other.long_tokens);
+        self.cost += other.cost;
+        self.short_cost += other.short_cost;
+        self.long_cost += other.long_cost;
+    }
+}
