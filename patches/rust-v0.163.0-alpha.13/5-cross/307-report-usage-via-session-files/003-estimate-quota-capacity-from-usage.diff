+use super::*;
+use pretty_assertions::assert_eq;
+
+const BASE: i64 = 1_790_000_000_000;
+
+fn sample(seconds: i64, percent: f64, reset: i64) -> Observation {
+    let millis = BASE + seconds * 1_000;
+    Observation {
+        timestamp: chrono::DateTime::from_timestamp_millis(millis)
+            .unwrap()
+            .to_rfc3339(),
+        millis,
+        used_percent: percent,
+        resets_at: BASE / 1_000 + reset,
+        credit_balance: None,
+    }
+}
+
+fn costs(entries: &[(i64, f64)]) -> BTreeMap<i64, f64> {
+    entries
+        .iter()
+        .map(|(seconds, cost)| (BASE + seconds * 1_000, *cost))
+        .collect()
+}
+
+#[test]
+fn reset_closes_previous_cycle_and_keeps_current_provisional() {
+    let mut observations = vec![
+        sample(
+            /*seconds*/ 0, /*percent*/ 0.0, /*reset*/ 10_000,
+        ),
+        sample(
+            /*seconds*/ 600, /*percent*/ 100.0, /*reset*/ 10_000,
+        ),
+        sample(
+            /*seconds*/ 700, /*percent*/ 7.0, /*reset*/ 20_000,
+        ),
+        sample(
+            /*seconds*/ 800, /*percent*/ 57.0, /*reset*/ 20_000,
+        ),
+    ];
+    let estimates = estimate(
+        &costs(&[(0, 100.0), (600, 7.0), (700, 50.0), (800, 9.0)]),
+        &mut observations,
+        BASE + 900_000,
+    );
+    assert_eq!(estimates.len(), 2);
+    assert_eq!(estimates[0].status, Status::Completed);
+    assert_eq!(estimates[1].status, Status::Provisional);
+    // Each returned percentage excludes its own request. Charge the request at
+    // the start, not the one at the end, independently for each reset cycle.
+    assert_eq!(estimates[0].observed_cost_usd, 100.0);
+    // The first returned percentage after reset also includes the preceding
+    // request, even though that request still carried the old quota snapshot.
+    assert_eq!(estimates[1].started_at, observations[1].timestamp);
+    assert_eq!(estimates[1].used_percent_start, 0.0);
+    assert_eq!(estimates[1].observed_cost_usd, 57.0);
+    assert_eq!(estimates[1].estimated_weekly_cost_usd, 100.0);
+}
+
+#[test]
+fn reset_after_idle_gap_does_not_reuse_previous_cycle_or_costs() {
+    let day = 24 * 60 * 60;
+    let first_new = 3 * day + 4 * 60 * 60;
+    let last_new = 10 * day - 60;
+    let mut observations = vec![
+        sample(-4 * day, 0.0, 3 * day),
+        sample(0, 100.0, 3 * day),
+        sample(first_new, 0.0, 10 * day),
+        sample(last_new, 99.0, 10 * day),
+        sample(10 * day + 10, 0.0, 17 * day),
+    ];
+    let estimates = estimate(
+        &costs(&[
+            (-4 * day, 100.0),
+            (0, 900.0),
+            (first_new, 990.0),
+            (last_new, 9.0),
+        ]),
+        &mut observations,
+        BASE + (10 * day + 20) * 1_000,
+    );
+    assert_eq!(estimates.len(), 2);
+    assert_eq!(estimates[0].observed_cost_usd, 100.0);
+    let current = &estimates[1];
+    assert_eq!(current.started_at, observations[2].timestamp);
+    assert_eq!(current.ended_at, observations[3].timestamp);
+    assert_eq!(current.used_percent_start, 0.0);
+    assert_eq!(current.used_percent_end, 99.0);
+    assert_eq!(current.observed_cost_usd, 990.0);
+    assert_eq!(current.estimated_weekly_cost_usd, 1_000.0);
+    assert_eq!(current.sample_count, 2);
+    assert_eq!(current.status, Status::Completed);
+    for cycle in &estimates {
+        let start = chrono::DateTime::parse_from_rfc3339(&cycle.started_at).unwrap();
+        let end = chrono::DateTime::parse_from_rfc3339(&cycle.ended_at).unwrap();
+        assert!(end - start <= chrono::Duration::days(7));
+    }
+}
+
+#[test]
+fn early_reset_skips_small_cycle_without_carrying_its_cost() {
+    let hour = 60 * 60;
+    let week = 7 * 24 * hour;
+    for short_percent in [1.0, 2.0] {
+        let natural_reset = week;
+        let early_reset = natural_reset + 4 * hour;
+        let mut observations = vec![
+            sample(0, 0.0, natural_reset),
+            sample(natural_reset - hour, 100.0, natural_reset),
+            sample(natural_reset + 10, 0.0, natural_reset + week),
+            sample(
+                natural_reset + 3 * hour,
+                short_percent,
+                natural_reset + week,
+            ),
+            sample(early_reset + 10, 0.0, early_reset + week),
+            sample(early_reset + hour, 20.0, early_reset + week),
+        ];
+        let estimates = estimate(
+            &costs(&[
+                (0, 1_000.0),
+                (natural_reset - hour, 9.0),
+                (natural_reset + 10, short_percent * 10.0),
+                (natural_reset + 3 * hour, 7.0),
+                (early_reset + 10, 200.0),
+            ]),
+            &mut observations,
+            BASE + (early_reset + hour + 10) * 1_000,
+        );
+        assert_eq!(estimates.len(), 2);
+        assert_eq!(estimates[0].observed_cost_usd, 1_000.0);
+        assert_eq!(estimates[0].status, Status::Completed);
+        let current = &estimates[1];
+        assert_eq!(current.started_at, observations[4].timestamp);
+        assert_eq!(current.ended_at, observations[5].timestamp);
+        assert_eq!(current.used_percent_start, 0.0);
+        assert_eq!(current.used_percent_end, 20.0);
+        assert_eq!(current.observed_cost_usd, 200.0);
+        assert_eq!(current.estimated_weekly_cost_usd, 1_000.0);
+        assert_eq!(current.sample_count, 2);
+        assert_eq!(current.status, Status::Provisional);
+    }
+}
+
+#[test]
+fn credit_decrease_with_exhausted_quota_closes_the_billing_window_before_reset() {
+    for (balance, percent, status) in [
+        (90.0, 100.0, Status::Completed),
+        (110.0, 100.0, Status::Provisional),
+        (90.0, 90.0, Status::Provisional),
+    ] {
+        let mut observations = vec![
+            sample(0, 0.0, 10_000),
+            sample(10, 80.0, 10_000),
+            sample(20, 100.0, 10_000),
+            sample(30, percent, 10_000),
+        ];
+        for (index, observation) in observations.iter_mut().enumerate() {
+            observation.credit_balance = Some(if index < 3 { 100.0 } else { balance });
+        }
+        let estimates = estimate(
+            &costs(&[(0, 80.0), (10, 20.0), (20, 700.0), (30, 800.0)]),
+            &mut observations,
+            BASE + 40_000,
+        );
+        assert_eq!(estimates.len(), 1);
+        assert_eq!(estimates[0].status, status);
+        assert_eq!(estimates[0].ended_at, observations[2].timestamp);
+        assert_eq!(estimates[0].observed_cost_usd, 100.0);
+        assert_eq!(estimates[0].estimated_weekly_cost_usd, 100.0);
+        assert_eq!(estimates[0].sample_count, 3);
+    }
+}
+
+#[test]
+fn credit_change_excludes_the_preceding_request_until_quota_recovers() {
+    for changed_balance in [90.0, 110.0] {
+        let mut observations = vec![
+            sample(0, 0.0, 10_000),
+            sample(10, 80.0, 10_000),
+            sample(20, 100.0, 10_000),
+            sample(30, 100.0, 10_000),
+            sample(40, 100.0, 10_000),
+            sample(50, 10.0, 20_000),
+            sample(60, 50.0, 20_000),
+        ];
+        for (index, observation) in observations.iter_mut().enumerate() {
+            observation.credit_balance = Some(if index < 3 { 100.0 } else { changed_balance });
+        }
+        let estimates = estimate(
+            &costs(&[
+                (0, 80.0),
+                (10, 20.0),
+                (20, 700.0),
+                (30, 800.0),
+                (40, 10.0),
+                (50, 40.0),
+                (60, 123.0),
+            ]),
+            &mut observations,
+            BASE + 70_000,
