@@ -0,0 +1,261 @@
+use std::collections::BTreeMap;
+
+use super::types::Observation;
+
+pub(super) const RECENT_DAYS: i64 = 90;
+
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub(super) enum Status {
+    Completed,
+    Provisional,
+}
+
+#[derive(Clone, Debug)]
+pub(super) struct Estimate {
+    pub(super) started_at: String,
+    pub(super) ended_at: String,
+    pub(super) used_percent_start: f64,
+    pub(super) used_percent_end: f64,
+    pub(super) observed_cost_usd: f64,
+    pub(super) estimated_weekly_cost_usd: f64,
+    pub(super) sample_count: usize,
+    pub(super) status: Status,
+}
+
+/// One continuous measurement with no intervening credit-funded interval.
+struct Segment<'a> {
+    start: &'a Observation,
+    end: &'a Observation,
+    start_percent: f64,
+    start_cost: f64,
+    observed_cost: f64,
+    mean_percent: f64,
+    mean_cost: f64,
+    percent_variance: f64,
+    percent_cost_covariance: f64,
+    count: usize,
+}
+
+impl<'a> Segment<'a> {
+    fn new(observation: &'a Observation, cumulative_cost: f64, start_percent: f64) -> Self {
+        Self {
+            start: observation,
+            end: observation,
+            start_percent,
+            start_cost: cumulative_cost,
+            observed_cost: 0.0,
+            mean_percent: start_percent,
+            mean_cost: 0.0,
+            percent_variance: 0.0,
+            percent_cost_covariance: 0.0,
+            count: 1,
+        }
+    }
+
+    fn observe(&mut self, observation: &'a Observation, cumulative_cost: f64) {
+        self.end = observation;
+        self.observed_cost = cumulative_cost - self.start_cost;
+        self.count += 1;
+        // Each interval estimates 100 * delta_cost / delta_percent. Weighting
+        // by delta_percent^2 reduces the effect of 1%-precision rounding on short
+        // intervals. Across all pairs, that average is 100 * covariance / variance.
+        // Centered online sums compute it in O(1) time and memory per observation.
+        let percent_delta = observation.used_percent - self.mean_percent;
+        let cost_delta = self.observed_cost - self.mean_cost;
+        self.mean_percent += percent_delta / self.count as f64;
+        self.mean_cost += cost_delta / self.count as f64;
+        self.percent_variance += percent_delta * (observation.used_percent - self.mean_percent);
+        self.percent_cost_covariance += percent_delta * (self.observed_cost - self.mean_cost);
+    }
+
+    fn span(&self) -> f64 {
+        self.end.used_percent - self.start_percent
+    }
+}
+
+struct Cycle<'a> {
+    reset_horizon: i64,
+    segments: Vec<Segment<'a>>,
+    current: Option<Segment<'a>>,
+    completed: bool,
+}
+
+impl<'a> Cycle<'a> {
+    fn new(reset_horizon: i64, segment: Segment<'a>) -> Self {
+        Self {
+            reset_horizon,
+            segments: Vec::new(),
+            current: Some(segment),
+            completed: false,
+        }
+    }
+
+    fn observe(
+        &mut self,
+        sample: &'a Observation,
+        cumulative_cost: f64,
+        credit_balances: Option<(f64, f64)>,
+    ) {
+        if credit_balances.is_some_and(|(before, after)| before != after) {
+            // The balance describes the preceding request. Keep the measurements
+            // before it and exclude this interval, not the rest of the cycle.
+            if let Some(segment) = self.current.take() {
+                self.segments.push(segment);
+            }
+            self.completed |= sample.used_percent == 100.0
+                && credit_balances.is_some_and(|(before, after)| after < before);
+        }
+        let last = self.current.as_ref().or_else(|| self.segments.last());
+        if self.completed
+            || last.is_some_and(|segment| sample.used_percent < segment.end.used_percent)
+        {
+            return;
+        }
+        match self.current.as_mut() {
+            Some(segment) => segment.observe(sample, cumulative_cost),
+            None => {
+                self.current = Some(Segment::new(sample, cumulative_cost, sample.used_percent));
+            }
+        }
+    }
+
+    fn estimate(&self, status: Status) -> Option<Estimate> {
+        let mut segments = self
+            .segments
+            .iter()
+            .chain(self.current.iter())
+            .filter(|segment| segment.span() > 0.0);
+        let first = segments.next()?;
+        let mut last = first;
+        let mut span = first.span();
+        let mut observed_cost = first.observed_cost;
+        let mut count = first.count;
+        // All-pairs covariance/variance sums equal n times the centered sums.
+        // Combine only within-segment pairs so no estimate spans a credit gap.
+        let mut covariance = first.count as f64 * first.percent_cost_covariance;
+        let mut variance = first.count as f64 * first.percent_variance;
+        for segment in segments {
+            last = segment;
+            span += segment.span();
+            observed_cost += segment.observed_cost;
+            count += segment.count;
+            covariance += segment.count as f64 * segment.percent_cost_covariance;
+            variance += segment.count as f64 * segment.percent_variance;
+        }
+        if span <= 5.0 || observed_cost <= 0.0 {
+            return None;
+        }
+        Some(Estimate {
+            started_at: first.start.timestamp.clone(),
+            ended_at: last.end.timestamp.clone(),
+            used_percent_start: first.start_percent,
+            used_percent_end: last.end.used_percent,
+            observed_cost_usd: observed_cost,
+            estimated_weekly_cost_usd: 100.0 * covariance / variance,
+            sample_count: count,
+            status,
+        })
+    }
+}
+
+pub(super) fn estimate(
+    costs: &BTreeMap<i64, f64>,
+    observations: &mut Vec<Observation>,
+    now: i64,
+) -> Vec<Estimate> {
+    let since = now.saturating_sub(RECENT_DAYS * 24 * 60 * 60 * 1_000);
+    observations.retain(|sample| {
+        sample.millis >= since
+            && sample.millis <= now
+            && (0.0..=100.0).contains(&sample.used_percent)
+    });
+    observations.sort_by(|left, right| {
+        left.millis
+            .cmp(&right.millis)
+            .then_with(|| left.used_percent.total_cmp(&right.used_percent))
+            .then_with(|| left.resets_at.cmp(&right.resets_at))
+    });
+    observations.dedup_by(|left, right| {
+        left.millis == right.millis
+            && left.used_percent == right.used_percent
+            && left.resets_at == right.resets_at
+            && left.credit_balance == right.credit_balance
+    });
+    let mut estimates = Vec::new();
+    let mut cycle: Option<Cycle<'_>> = None;
+    let mut costs = costs.iter().peekable();
+    let mut cumulative_cost = 0.0;
+    let mut previous: Option<(&Observation, f64)> = None;
+    let mut index = 0;
+    while index < observations.len() {
+        let sample = &observations[index];
+        let mut end = index + 1;
+        while end < observations.len() && observations[end].millis == sample.millis {
+            end += 1;
+        }
+        let conflicting = end != index + 1;
+        index = end;
+        if conflicting {
+            continue;
+        }
+        // A response reports quota through the preceding request. Its own usage
+        // enters the next observation, so include the start and exclude the end.
+        while let Some((_, cost)) = costs.next_if(|(millis, _)| **millis < sample.millis) {
+            cumulative_cost += cost;
+        }
+        let Some(current) = cycle.as_mut() else {
+            cycle = Some(Cycle::new(
+                sample.resets_at,
+                Segment::new(sample, cumulative_cost, sample.used_percent),
+            ));
+            previous = Some((sample, cumulative_cost));
+            continue;
+        };
+        // Old concurrent responses can carry an earlier reset horizon. They do
+        // not change this cycle's identity or suspend later valid measurements.
+        if sample.resets_at < current.reset_horizon.saturating_sub(300) {
+            continue;
+        }
+        let (prior, prior_cost) = previous
+            .replace((sample, cumulative_cost))
+            .expect("an existing cycle has a preceding observation");
+        let credit_balances = prior.credit_balance.zip(sample.credit_balance);
+        let credit_changed = credit_balances.is_some_and(|(before, after)| before != after);
+        if sample.resets_at > current.reset_horizon.saturating_add(300) {
+            if let Some(estimate) = current.estimate(Status::Completed) {
+                estimates.push(estimate);
+            }
+            // Only a preceding request inside the new weekly window can supply
+            // its zero baseline. Idle gaps and early resets leave older records
+            // and their costs in the previous cycle.
+            let prior_in_cycle =
+                prior.millis.div_euclid(1_000) >= sample.resets_at.saturating_sub(7 * 24 * 60 * 60);
+            let segment = if credit_changed || !prior_in_cycle {
+                Segment::new(sample, cumulative_cost, sample.used_percent)
+            } else {
+                let mut restored = Segment::new(prior, prior_cost, 0.0);
+                restored.observe(sample, cumulative_cost);
+                restored
+            };
+            cycle = Some(Cycle::new(sample.resets_at, segment));
+            continue;
+        }
+        current.reset_horizon = current.reset_horizon.max(sample.resets_at);
+        current.observe(sample, cumulative_cost, credit_balances);
+    }
+    if let Some(cycle) = cycle {
+        let status = if cycle.completed {
+            Status::Completed
+        } else {
+            Status::Provisional
+        };
+        if let Some(estimate) = cycle.estimate(status) {
+            estimates.push(estimate);
+        }
+    }
+    estimates
+}
