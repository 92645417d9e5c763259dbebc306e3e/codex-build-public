+#[test]
+fn incremental_average_matches_all_weighted_intervals_across_rounding_phases() {
+    for capacity in [10.0, 100.0, 1000.0] {
+        for phase in [0.01, 0.49, 0.99] {
+            let mut observations = vec![sample(0, 23.0, 10_000)];
+            let mut charges = Vec::new();
+            let mut points = vec![(0.0, 23.0)];
+            let mut cost = 0.0;
+            let mut weighted_estimates = 0.0;
+            let mut total_weight = 0.0;
+            for index in 1..128 {
+                let charge = capacity * f64::from(index % 7) / 1000.0;
+                charges.push((i64::from(index - 1), charge));
+                cost += charge;
+                let percent = (23.0 + phase + cost * 100.0 / capacity).floor();
+                for (previous_cost, previous_percent) in &points {
+                    let span = percent - previous_percent;
+                    if span > 0.0 {
+                        let interval_estimate = 100.0 * (cost - previous_cost) / span;
+                        let weight = span * span;
+                        weighted_estimates += interval_estimate * weight;
+                        total_weight += weight;
+                    }
+                }
+                points.push((cost, percent));
+                observations.push(sample(i64::from(index), percent, 10_000));
+            }
+            let estimates = estimate(&costs(&charges), &mut observations, BASE + 900_000);
+            assert_eq!(estimates.len(), 1);
+            let expected = weighted_estimates / total_weight;
+            assert!((estimates[0].estimated_weekly_cost_usd - expected).abs() < 1e-9);
+        }
+    }
+}
