+    #[test]
+    fn replacing_usage_snapshots_reorders_every_report_without_navigation() {
+        use codex_app_server_protocol::UsageCreditPeriod;
+        use std::collections::BTreeMap;
+
+        let area = Rect::new(0, 0, 400, 100);
+        for screen in UsageRange::VIEWS
+            .map(CenterScreen::Usage)
+            .into_iter()
+            .chain([CenterScreen::Quotas])
+        {
+            let mut center = test_center(None, screen, area.width, 1.0);
+            for (prefix, month, days) in [("before", "08", [24, 10]), ("after", "09", [21, 7])] {
+                let mut report = crate::usage::test_report();
+                let usage = report.rows["2026-09-28"]["gpt-5.4"].clone();
+                let names = [format!("{prefix}-z"), format!("{prefix}-a")];
+                let models =
+                    BTreeMap::from([(names[1].clone(), usage.clone()), (names[0].clone(), usage)]);
+                // The weekly snapshot keys are Mondays, as in the accounting producer.
+                let dates = days.map(|day| format!("2026-{month}-{day:02}"));
+                report.rows = BTreeMap::from([
+                    (dates[1].clone(), models.clone()),
+                    (dates[0].clone(), models.clone()),
+                ]);
+                report.weekly_rows = report.rows.clone();
+                report.monthly_rows = BTreeMap::from([
+                    ("2026-01".into(), models.clone()),
+                    (format!("2026-{month}"), models.clone()),
+                ]);
+                report.yearly_rows =
+                    BTreeMap::from([("2025".into(), models.clone()), ("2026".into(), models)]);
+                report.missing_prices = names.iter().cloned().collect();
+                for (estimate, day) in report.quota.iter_mut().zip([7, 21, 14]) {
+                    estimate.started_at = format!("2026-{month}-{day:02}T00:00:00Z");
+                    estimate.ended_at = format!("2026-{month}-{day:02}T01:00:00Z");
+                }
+                report.credits = report
+                    .quota
+                    .iter()
+                    .map(|estimate| UsageCreditPeriod {
+                        started_at: estimate.started_at.clone(),
+                        ended_at: estimate.ended_at.clone(),
+                        used_credits: 1.0,
+                        observed_cost_usd: 1.0,
+                        model_usage: None,
+                        sample_count: 1,
+                    })
+                    .collect();
+                center.set_report(Ok(Arc::new(report)));
+                center.render(area, &mut Buffer::empty(area));
+                assert_eq!(center.screen, screen);
+                assert_eq!(center.view.scroll_offset, 0);
+                let values = center
+                    .table_interaction
+                    .cells
+                    .iter()
+                    .map(|(_, text)| text.as_ref())
+                    .collect::<Vec<_>>();
+                if screen == CenterScreen::Quotas {
+                    let starts = [21, 14, 7].map(|day| format!("2026-{month}-{day:02} 08:00"));
