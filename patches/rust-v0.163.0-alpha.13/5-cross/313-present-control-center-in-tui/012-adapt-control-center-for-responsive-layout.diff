+    #[test]
+    fn response_loading_stays_in_the_footer_and_shared_arrows_keep_filters_unchanged() {
+        let mut center = test_center(None, CenterScreen::Responses, 120, 1.0);
+        let area = Rect::new(4, 3, 120, 12);
+        let mut buffer = Buffer::empty(area);
+        center.render(area, &mut buffer);
+        for y in area.y..area.bottom() - 1 {
+            let line = (area.x..area.right())
+                .map(|x| buffer[(x, y)].symbol())
+                .collect::<String>();
+            assert!(!line.contains("Loading responses..."));
+        }
+        let footer = (area.x..area.right())
+            .map(|x| buffer[(x, area.bottom() - 1)].symbol())
+            .collect::<String>();
+        assert!(footer.ends_with("Loading responses..."));
+        assert!(footer.contains("left model filter All"));
+        for (key, offset) in [(KeyCode::Right, 8), (KeyCode::Left, 0)] {
+            assert!(center.handle_key(KeyEvent::new(key, KeyModifiers::CONTROL)));
+            assert_eq!(center.table_interaction.column_offset, offset);
+            assert_eq!(center.responses.history.model(), None);
+            assert_eq!(center.responses.history.status(), None);
+        }
+    }
