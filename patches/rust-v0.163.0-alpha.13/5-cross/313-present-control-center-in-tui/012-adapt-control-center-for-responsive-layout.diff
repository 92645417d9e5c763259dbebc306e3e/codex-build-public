+        use codex_app_server_protocol::UsageCreditPeriod;
+        use codex_app_server_protocol::UsageTotals;
+        use std::collections::BTreeMap;
+
+        let mut report = crate::usage::test_report();
+        for (index, period) in report.quota.iter_mut().enumerate() {
+            let model = format!("period-{index}");
+            report.missing_prices.insert(model.clone());
+            period.model_usage = Some(BTreeMap::from([(model, UsageTotals::default())]));
+        }
+        report.credits = report.quota[..2]
+            .iter()
+            .enumerate()
+            .map(|(index, period)| {
+                let model = format!("credit-{index}");
+                report.missing_prices.insert(model.clone());
+                UsageCreditPeriod {
+                    started_at: period.started_at.clone(),
+                    ended_at: period.ended_at.clone(),
+                    used_credits: 1.0,
+                    observed_cost_usd: 0.0,
+                    model_usage: Some(BTreeMap::from([(model, UsageTotals::default())])),
+                    sample_count: 2,
+                }
+            })
+            .collect();
+        let report = Arc::new(report);
+        let area = Rect::new(0, 0, 400, 9);
+        let mut center = test_center(
+            Some(Arc::clone(&report)),
+            CenterScreen::Quotas,
+            area.width,
+            1.0,
+        );
+        for (index, model) in ["credit-1", "credit-0", "period-1", "period-2", "period-0"]
+            .into_iter()
+            .enumerate()
+        {
+            if index > 0 {
+                assert!(center.handle_key(KeyCode::Down.into()));
+            }
+            let mut buffer = Buffer::empty(area);
+            center.render(area, &mut buffer);
+            assert_eq!(center.selected_quota, index);
+            assert!(Arc::ptr_eq(center.report().unwrap(), &report));
+            assert!(
+                center
+                    .table_interaction
+                    .cells
+                    .iter()
+                    .any(|(_, text)| text.as_ref() == model)
+            );
+            let cursor = center
+                .table_interaction
+                .cells
+                .iter()
+                .find(|(_, text)| text.as_ref() == ">")
+                .unwrap()
+                .0;
+            assert!(cursor.y < area.bottom() - 1);
+            assert!(
+                buffer[(cursor.x, cursor.y)]
+                    .modifier
+                    .contains(ratatui::style::Modifier::ITALIC)
+            );
+        }
+        assert!(center.view.scroll_offset > 0);
+        assert!(center.handle_key(KeyCode::Down.into()));
+        assert_eq!(center.selected_quota, 4);
+        for _ in 0..6 {
+            assert!(center.handle_key(KeyCode::Up.into()));
+        }
+        assert_eq!(center.selected_quota, 0);
+        assert!(center.handle_key(KeyCode::Esc.into()));
+        assert_eq!(center.screen, CenterScreen::Summary);
+        assert!(center.handle_key(KeyEvent::new(KeyCode::Char('0'), KeyModifiers::ALT)));
+        assert_eq!(center.selected_quota, 0);
+    }
