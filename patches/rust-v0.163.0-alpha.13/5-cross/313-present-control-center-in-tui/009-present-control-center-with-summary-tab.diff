+    #[test]
+    fn summary_sidebar_separates_usage_time_from_cache_age_and_keeps_header_controls() {
+        let mut report = crate::usage::test_report();
+        report.rows.clear();
+        report.quota.clear();
+        report.refreshed_at = Local::now().fixed_offset() - Duration::seconds(90_123);
+        let timestamp = report
+            .latest_usage_at
+            .unwrap()
+            .with_timezone(report.refreshed_at.offset())
+            .format("%Y-%m-%d %H:%M:%S")
+            .to_string();
+        let mut overlay = ControlCenter::new(
+            Some(Arc::new(report)),
+            UsageRange::Summary,
+            crate::keymap::RuntimeKeymap::defaults().pager,
+            120,
+            1.0,
+        );
+        let area = Rect::new(0, 0, 120, 24);
+        let mut buffer = Buffer::empty(area);
+        overlay.render(area, &mut buffer);
+        let row_text = |buffer: &Buffer, row| {
+            (0..120)
+                .map(|column| buffer[(column, row)].symbol())
+                .collect::<String>()
+        };
+        let tabs = row_text(&buffer, 0);
+        assert!(
+            tabs.contains("Summary") && tabs.trim_end().ends_with("view"),
+            "{tabs}"
+        );
+        assert!(!tabs.contains("Codex control center"));
+        let sidebar = overlay
+            .sidebar()
+            .iter()
+            .map(ToString::to_string)
+            .collect::<Vec<_>>();
+        assert!(!sidebar.iter().any(|line| line.starts_with("Status:")));
+        assert!(
+            sidebar
+                .iter()
+                .any(|line| line.starts_with("Cache ago: 1d1h2m"))
+        );
+        let latest = (0..23)
+            .find(|row| row_text(&buffer, *row).contains("Latest record:"))
+            .unwrap();
+        assert!(row_text(&buffer, latest).contains(&format!("Latest record: {timestamp}")));
+        assert!(!sidebar.iter().any(|line| line.starts_with("Updated:")));
+        assert_eq!(buffer[(80, 2)].symbol(), "U");
+        let footer = row_text(&buffer, 23);
+        assert!(footer.contains("esc back") && footer.contains("r refresh usage cache"));
+        assert!(footer.contains("p proxy") && footer.contains("t telegram"));
+        assert!(footer.contains("q quit"));
+        let key_column = footer.find("p proxy").unwrap() as u16;
+        assert!(
+            buffer[(key_column, 23)]
+                .modifier
+                .contains(ratatui::style::Modifier::BOLD)
+        );
+        assert!(
+            !buffer[(key_column + 2, 23)]
+                .modifier
+                .contains(ratatui::style::Modifier::BOLD)
+        );
+        for row in 0..23 {
+            assert!(!row_text(&buffer, row).contains("select day"));
+        }
+        assert!(overlay.handle_key(KeyCode::Tab.into()));
+        overlay.render(area, &mut buffer);
+        assert!(!row_text(&buffer, 4).contains(&timestamp));
+        assert!(!row_text(&buffer, 23).contains("select day"));
+        assert!(row_text(&buffer, 23).contains("q quit"));
+    }
