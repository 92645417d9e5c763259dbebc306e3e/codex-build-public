+//! One control center owns its chrome and transient report navigation.
+
+use super::PagerView;
+use crate::bottom_pane::render_filled_tab_bar;
+use crate::control_center_table::Palette;
+use crate::key_hint;
+use crate::keymap::PagerKeymap;
+use crate::line_truncation::truncate_line_with_ellipsis_if_overflow;
+use crate::render::highlight::syntax_theme_revision;
+use crate::style::footer_hint_label_style;
+use crate::style::table_separator_style;
+use crate::tui;
+use crate::tui::TuiEvent;
+use crate::usage::UsageRange;
+use crate::usage::UsageReport;
+use chrono::Datelike;
+use chrono::Duration;
+use chrono::NaiveDate;
+use crossterm::event::KeyCode;
+use crossterm::event::KeyEvent;
+use crossterm::event::KeyEventKind;
+use crossterm::event::KeyModifiers;
+use crossterm::event::MouseEventKind;
+use ratatui::buffer::Buffer;
+use ratatui::layout::Constraint;
+use ratatui::layout::Layout;
+use ratatui::layout::Margin;
+use ratatui::layout::Rect;
+use ratatui::style::Stylize;
+use ratatui::text::Line;
+use ratatui::text::Span;
+use ratatui::widgets::Clear;
+use ratatui::widgets::Paragraph;
+use ratatui::widgets::Widget;
+use std::io::Result;
+use std::sync::Arc;
+use uuid::Uuid;
+
+pub(crate) struct ControlCenter {
+    view: PagerView,
+    is_done: bool,
+    report: std::result::Result<Option<Arc<UsageReport>>, String>,
+    pub(crate) request_id: Option<Uuid>,
+    pub(crate) range: UsageRange,
+    selected_day: Option<NaiveDate>,
+    viewport_width: u16,
+    theme_revision: u64,
+    mouse_scroll_speed: f64,
+    pending_mouse_scroll: f64,
+    pub(crate) details: Vec<Line<'static>>,
+}
+
+impl ControlCenter {
+    pub(crate) fn new(
+        report: Option<Arc<UsageReport>>,
+        range: UsageRange,
+        keymap: PagerKeymap,
+        width: u16,
+        mouse_scroll_speed: f64,
+    ) -> Self {
+        let mut overlay = Self {
+            view: PagerView::new(Vec::new(), String::new(), 0, keymap),
+            is_done: false,
+            report: Ok(report),
+            request_id: None,
+            range,
+            selected_day: None,
+            viewport_width: width,
+            theme_revision: syntax_theme_revision(),
+            mouse_scroll_speed,
+            pending_mouse_scroll: 0.0,
+            details: Vec::new(),
+        };
+        overlay.refresh();
+        overlay
+    }
+
+    pub(crate) fn report(&self) -> Option<&Arc<UsageReport>> {
+        self.report.as_ref().ok()?.as_ref()
+    }
+
+    pub(crate) fn set_report(&mut self, result: std::result::Result<Arc<UsageReport>, String>) {
+        self.report = result.map(Some);
+        self.request_id = None;
+        self.selected_day = None;
+        self.refresh();
+    }
+
+    pub(super) fn is_done(&self) -> bool {
+        self.is_done
+    }
+
+    fn content_width(&self) -> u16 {
+        let inner = self.viewport_width.saturating_sub(4);
+        if self.range == UsageRange::Summary && inner >= 90 {
+            inner - 41
+        } else {
+            inner
+        }
+    }
+
+    fn refresh(&mut self) {
+        self.view.renderables = match &self.report {
+            Ok(Some(report)) => crate::usage::render_selected(
+                report,
+                self.range,
+                self.content_width(),
+                self.selected_day,
+            ),
+            Ok(None) => vec!["Loading usage...".dim().into()],
+            Err(error) => vec![format!(" Usage unavailable: {error}").dim().into()],
+        };
+        self.theme_revision = syntax_theme_revision();
+    }
+
+    fn handle_key(&mut self, key: KeyEvent) -> bool {
+        if key.kind == KeyEventKind::Release {
+            return false;
+        }
+        let next = key.code == KeyCode::Tab && key.modifiers == KeyModifiers::NONE;
+        let previous = key.code == KeyCode::BackTab && key.modifiers == KeyModifiers::SHIFT;
+        if next || previous {
+            let ranges = UsageRange::VIEWS;
+            let index = self.range.index();
+            let step = if next { 1 } else { ranges.len() - 1 };
+            self.range = ranges[(index + step) % ranges.len()];
+            self.selected_day = None;
+            self.view.scroll_offset = 0;
+            self.refresh();
+            return true;
+        }
+        if key.modifiers != KeyModifiers::NONE {
+            return false;
+        }
+        if key.code == KeyCode::Esc {
+            if self.selected_day.take().is_some() {
+                self.view.scroll_offset = 0;
+                self.refresh();
+            } else {
+                self.is_done = true;
+            }
+            return true;
+        }
+        let arrow = matches!(
+            key.code,
+            KeyCode::Up | KeyCode::Down | KeyCode::Left | KeyCode::Right
+        );
+        if self.range != UsageRange::Summary {
+            return arrow;
+        }
+        let Some(report) = self.report() else {
+            return arrow || key.code == KeyCode::Enter;
+        };
+        let (start, today) = crate::usage::heatmap_bounds(report, self.content_width());
+        let delta: i64 = match key.code {
+            KeyCode::Enter if self.selected_day.is_some() => return true,
+            KeyCode::Enter => -1,
+            KeyCode::Left => -7,
+            KeyCode::Right => 7,
+            KeyCode::Up => -1,
+            KeyCode::Down => 1,
+            _ => return false,
+        };
+        let (mut day, delta, lower, upper) = match self.selected_day {
+            None => (today, -1, start, today),
+            Some(day) => {
+                let week_start =
+                    day - Duration::days(i64::from(day.weekday().num_days_from_sunday()));
+                let (lower, upper) = if delta.abs() == 1 {
+                    (
+                        week_start.max(start),
+                        (week_start + Duration::days(6)).min(today),
+                    )
+                } else {
+                    (start, today)
+                };
+                (day + Duration::days(delta), delta, lower, upper)
+            }
+        };
+        while day >= lower && day <= upper {
+            if crate::usage::day_has_usage(report, day) {
+                self.selected_day = Some(day);
+                break;
+            }
+            day += Duration::days(delta);
+        }
+        self.view.scroll_offset = 0;
+        self.refresh();
+        true
+    }
+
+    pub(crate) fn render(&mut self, area: Rect, buf: &mut Buffer) {
+        let resized = self.viewport_width != area.width;
+        if resized {
+            self.viewport_width = area.width;
+            if let Some(report) = self.report() {
+                let (start, today) = crate::usage::heatmap_bounds(report, self.content_width());
+                self.selected_day = self
+                    .selected_day
+                    .filter(|day| (start..=today).contains(day));
+            }
+        }
+        if resized || self.theme_revision != syntax_theme_revision() {
+            self.refresh();
+        }
+        Clear.render(area, buf);
+        let inner = area.inner(Margin::new(2, 0));
+        let [mut tabs, rule, mut body, footer] = Layout::vertical([
+            Constraint::Length(1),
+            Constraint::Length(1),
+            Constraint::Min(0),
+            Constraint::Length(1),
+        ])
+        .areas(inner);
+        let tab_hint = hint_line(&[("tab/shift+tab", "view")]);
+        if tabs.width >= 80 {
+            let width = tab_hint.width() as u16;
+            tab_hint.render(Rect::new(tabs.right() - width, tabs.y, width, 1), buf);
+            tabs.width = tabs.width.saturating_sub(width + 2);
+        }
+        render_filled_tab_bar(
+            &UsageRange::VIEWS.map(UsageRange::label),
+            self.range.index(),
+            tabs,
+            buf,
+        );
+        Line::from("─".repeat(usize::from(rule.width)))
+            .style(table_separator_style())
+            .render(rule, buf);
+
+        let width = self.content_width();
+        let sidebar = if self.range == UsageRange::Summary {
+            crate::wrapping::word_wrap_lines(
+                self.sidebar(),
+                usize::from(if width < body.width {
+                    38
+                } else {
+                    body.width.max(1)
+                }),
+            )
+        } else {
+            Vec::new()
+        };
+        let report_height = self.view.content_height(width);
+        // Narrow screens put the same details below the report instead of hiding them.
+        let side_by_side = width < body.width;
+        let content_height = if side_by_side {
+            report_height.max(sidebar.len())
+        } else {
+            report_height + sidebar.len()
+        };
+        self.view
+            .update_last_content_height(body.height.saturating_sub(2).max(1));
+        self.view.scroll_offset = self
+            .view
+            .scroll_offset
+            .min(content_height.saturating_sub(usize::from(body.height)));
+        if side_by_side {
+            let sidebar_area = Rect::new(body.x + width + 3, body.y, 38, body.height);
+            Paragraph::new(
+                sidebar
+                    .into_iter()
+                    .skip(self.view.scroll_offset)
+                    .collect::<Vec<_>>(),
+            )
+            .render(sidebar_area, buf);
+            body.width = width;
+        } else if !sidebar.is_empty() {
+            let top = report_height
+                .saturating_sub(self.view.scroll_offset)
+                .min(usize::from(body.height)) as u16;
+            let sidebar_area = Rect::new(body.x, body.y + top, body.width, body.height - top);
+            Paragraph::new(
+                sidebar
+                    .into_iter()
+                    .skip(self.view.scroll_offset.saturating_sub(report_height))
+                    .collect::<Vec<_>>(),
+            )
+            .render(sidebar_area, buf);
+        }
+        self.view.render_content(body, buf, 0);
+        let mut hints = vec![("esc", "back"), ("r", "refresh usage cache")];
+        if self.range == UsageRange::Summary {
+            hints.extend([("p", "proxy"), ("t", "telegram")]);
+        }
+        hints.push(("q", "quit"));
+        truncate_line_with_ellipsis_if_overflow(hint_line(&hints), usize::from(footer.width))
+            .render(footer, buf);
+    }
+
+    fn sidebar(&self) -> Vec<Line<'static>> {
+        let palette = Palette::current();
+        let value = palette.intensity(16);
+        let field = |label: &str, text: String| {
+            Line::from(vec![format!("{label}: ").dim(), Span::styled(text, value)])
+        };
+        let timestamp =
+            |at: chrono::DateTime<chrono::FixedOffset>| at.format("%Y-%m-%d %H:%M:%S").to_string();
+        let report = self.report();
+        let mut lifetime = 0_u64;
+        let mut peak = 0;
+        let mut longest = 0;
+        let mut current = 0;
+        let mut last_day = None;
+        if let Some(report) = report {
+            let today = report.refreshed_at.date_naive();
+            for (date, models) in &report.rows {
+                let tokens: u64 = models.values().map(|usage| usage.tokens.total).sum();
+                lifetime += tokens;
+                peak = peak.max(tokens);
+                if tokens == 0 {
+                    continue;
+                }
+                let Ok(day) = NaiveDate::parse_from_str(date, "%Y-%m-%d") else {
+                    continue;
+                };
+                if day > today {
+                    continue;
+                }
+                current = if last_day == day.pred_opt() {
+                    current + 1
+                } else {
+                    1
+                };
+                longest = longest.max(current);
+                last_day = Some(day);
+            }
+            if last_day != Some(today) && last_day != today.pred_opt() {
+                current = 0;
+            }
+        }
+        let statistic = |value: u64, suffix: &str| {
+            report.map_or_else(|| "--".into(), |_| format!("{value}{suffix}"))
+        };
+        let streak = |days| statistic(days, if days == 1 { " day" } else { " days" });
+        let mut lines = vec![
+            Line::styled("Usage", palette.model(0)),
+            field(
+                "Cache ago",
+                report
+                    .map(|report| {
+                        format_age(
+                            (chrono::Local::now().fixed_offset() - report.refreshed_at)
+                                .num_seconds()
+                                .max(0) as u64,
+                        )
+                    })
+                    .unwrap_or_else(|| "--".into()),
+            ),
+            field("Lifetime tokens", statistic(lifetime, "")),
+            field("Peak tokens", statistic(peak, "")),
+            field("Longest streak", streak(longest)),
+            field("Current streak", streak(current)),
+            field(
+                "Latest record",
+                report
+                    .and_then(|report| {
+                        report
+                            .latest_usage_at
+                            .map(|at| timestamp(at.with_timezone(report.refreshed_at.offset())))
+                    })
+                    .unwrap_or_else(|| "--".into()),
+            ),
+            Line::default(),
+        ];
+        lines.extend(self.details.clone());
+        lines
+    }
+
+    fn scroll_mouse(&mut self, kind: MouseEventKind) -> bool {
+        let direction = match kind {
+            MouseEventKind::ScrollUp => -1.0,
+            MouseEventKind::ScrollDown => 1.0,
+            _ => return false,
+        };
+        if self.pending_mouse_scroll.signum() != direction {
+            self.pending_mouse_scroll = 0.0;
+        }
+        self.pending_mouse_scroll += direction * self.mouse_scroll_speed;
+        // Match the transcript's fractional-row and direction-reversal behavior.
+        let rounded = self.pending_mouse_scroll.round();
+        if rounded != 0.0 && (self.pending_mouse_scroll - rounded).abs() < 1e-9 {
+            self.pending_mouse_scroll = rounded;
+        }
+        let rows = self.pending_mouse_scroll as isize;
+        self.pending_mouse_scroll = self.pending_mouse_scroll.fract();
+        self.view.scroll_offset = self.view.scroll_offset.saturating_add_signed(rows);
+        true
+    }
+
+    pub(super) fn handle_event(&mut self, tui: &mut tui::Tui, event: TuiEvent) -> Result<()> {
+        match event {
+            TuiEvent::Key(key) if self.handle_key(key) => {
+                tui.frame_requester().schedule_frame();
+                Ok(())
+            }
+            TuiEvent::Mouse(mouse) if self.scroll_mouse(mouse.kind) => {
+                tui.frame_requester().schedule_frame();
+                Ok(())
+            }
+            TuiEvent::Draw | TuiEvent::Resume | TuiEvent::Resize(_) | TuiEvent::FocusGained => {
+                tui.draw(u16::MAX, |frame| self.render(frame.area(), frame.buffer))?;
+                tui.frame_requester()
+                    .schedule_frame_in(std::time::Duration::from_secs(1));
+                Ok(())
+            }
+            TuiEvent::Key(key) => self.view.handle_key_event(tui, key),
+            _ => Ok(()),
+        }
+    }
+}
+
+fn hint_line(hints: &[(&str, &str)]) -> Line<'static> {
+    let mut line = Line::default();
+    for (key, description) in hints {
+        if !line.spans.is_empty() {
+            line.spans.push("  ".dim());
+        }
+        line.spans.extend(key_hint::key_label_spans(key));
+        line.spans.push(Span::styled(
+            format!(" {description}"),
+            footer_hint_label_style().not_bold(),
+        ));
+    }
+    line
+}
+
+fn format_age(seconds: u64) -> String {
+    let days = seconds / 86_400;
+    let hours = seconds / 3_600 % 24;
+    let minutes = seconds / 60 % 60;
+    let seconds_part = seconds % 60;
+    if days > 0 {
+        format!("{days}d{hours}h{minutes}m{seconds_part}s")
+    } else if hours > 0 {
+        format!("{hours}h{minutes}m{seconds_part}s")
+    } else if minutes > 0 {
+        format!("{minutes}m{seconds_part}s")
+    } else {
+        format!("{seconds_part}s")
+    }
+}
