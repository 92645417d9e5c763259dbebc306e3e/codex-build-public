+        assert_eq!(overlay.selected_day, Some(latest - Duration::days(2)));
+        assert!(overlay.handle_key(KeyCode::Down.into()));
+        assert_eq!(overlay.selected_day, Some(latest));
+        let area = Rect::new(0, 0, 40, 16);
+        let mut buffer = Buffer::empty(area);
+        overlay.render(area, &mut buffer);
+        let tabs = buffer.content[..40].to_vec();
+        let labels = tabs.iter().map(|cell| cell.symbol()).collect::<String>();
+        assert!(labels.contains("Summary"));
+        overlay.handle_event(&mut tui, TuiEvent::Key(KeyCode::Down.into()))?;
+        assert_eq!(overlay.view.scroll_offset, 0);
+        assert_eq!(overlay.selected_day, Some(latest));
+        overlay.handle_event(&mut tui, TuiEvent::Key(KeyCode::Up.into()))?;
+        assert_eq!(overlay.view.scroll_offset, 0);
+        assert_eq!(overlay.selected_day, Some(latest - Duration::days(2)));
+        overlay.handle_event(&mut tui, TuiEvent::Key(KeyCode::Down.into()))?;
+        let page_height = overlay.view.page_height(area);
+        assert!(overlay.view.content_height(overlay.content_width()) > page_height);
+        overlay.handle_event(&mut tui, TuiEvent::Key(KeyCode::PageDown.into()))?;
+        assert_eq!(overlay.view.scroll_offset, page_height);
+        overlay.render(area, &mut buffer);
+        assert!(overlay.view.scroll_offset > 0);
+        assert_eq!(&buffer.content[..40], tabs.as_slice());
+        overlay.handle_event(&mut tui, TuiEvent::Key(KeyCode::PageUp.into()))?;
+        assert_eq!(overlay.view.scroll_offset, 0);
+        assert_eq!(overlay.selected_day, Some(latest));
+        assert_eq!(overlay.content_width(), 36);
+        assert!(overlay.selected_day.is_some());
+        assert!(overlay.handle_key(KeyCode::Tab.into()));
+        assert_eq!(overlay.range, UsageRange::Daily);
+        assert_eq!(overlay.selected_day, None);
+        assert_eq!(overlay.view.scroll_offset, 0);
+        assert!(Arc::ptr_eq(overlay.report().unwrap(), &report));
+        assert!(overlay.handle_key(KeyEvent::new(KeyCode::BackTab, KeyModifiers::SHIFT)));
+        assert_eq!(overlay.range, UsageRange::Summary);
+        assert!(overlay.handle_key(KeyCode::Up.into()));
+        assert!(overlay.selected_day.is_some());
+        assert!(overlay.handle_key(KeyCode::Esc.into()));
+        assert!(overlay.selected_day.is_none());
+        assert!(!overlay.is_done());
+        assert!(overlay.handle_key(KeyCode::Esc.into()));
+        assert!(overlay.is_done());
+        Ok(())
+    }
