+    #[test]
+    fn sidebar_statistics_use_full_history_and_count_current_streak_through_yesterday() {
+        let mut report = crate::usage::test_report();
+        report.rows.clear();
+        let today = report.refreshed_at.date_naive();
+        let mut usage = codex_app_server_protocol::UsageTotals::default();
+        usage.tokens.total = 100;
+        for ago in [400, 399, 398, 397, 4, 3, 1, 0] {
+            report.rows.insert(
+                (today - Duration::days(ago)).to_string(),
+                std::collections::BTreeMap::from([("first".into(), usage.clone())]),
+            );
+        }
+        usage.tokens.total = 50;
+        report
+            .rows
+            .get_mut(&today.to_string())
+            .unwrap()
+            .insert("second".into(), usage);
+        report.rows.insert(
+            (today - Duration::days(2)).to_string(),
+            std::collections::BTreeMap::from([("zero".into(), Default::default())]),
+        );
+        let mut overlay = ControlCenter::new(
+            Some(Arc::new(report.clone())),
+            UsageRange::Summary,
+            crate::keymap::RuntimeKeymap::defaults().pager,
+            120,
+            1.0,
+        );
+        let statistics = |overlay: &ControlCenter| {
+            overlay
+                .sidebar()
+                .iter()
+                .skip(2)
+                .take(4)
+                .map(ToString::to_string)
+                .collect::<Vec<_>>()
+        };
+        assert_eq!(
+            statistics(&overlay),
+            [
+                "Lifetime tokens: 850",
+                "Peak tokens: 150",
+                "Longest streak: 4 days",
+                "Current streak: 2 days"
+            ]
+        );
+        report.rows.remove(&today.to_string());
+        overlay.set_report(Ok(Arc::new(report.clone())));
+        assert_eq!(statistics(&overlay)[3], "Current streak: 1 day");
+        report.rows.remove(&(today - Duration::days(1)).to_string());
+        overlay.set_report(Ok(Arc::new(report.clone())));
+        assert_eq!(statistics(&overlay)[3], "Current streak: 0 days");
+        report.rows.clear();
+        overlay.set_report(Ok(Arc::new(report)));
+        assert_eq!(statistics(&overlay)[0], "Lifetime tokens: 0");
+        overlay.set_report(Err("unavailable".into()));
+        assert_eq!(statistics(&overlay)[0], "Lifetime tokens: --");
+    }
