+async fn entry_and_report_actions_preserve_keymap_and_request_ownership() -> crate::app::Result<()>
+{
+    let mut fixture = Fixture::new().await?;
+    let entry = KeyEvent::new(KeyCode::Char('`'), KeyModifiers::ALT);
+    let config = toml::from_str("[composer]\nsubmit = 'alt-`'")?;
+    fixture.app.keymap = crate::keymap::RuntimeKeymap::from_config(&config).expect("valid keymap");
+    fixture
+        .app
+        .chat_widget
+        .apply_keymap_update(config, &fixture.app.keymap);
+    fixture.key(entry).await?;
+    assert!(fixture.app.overlay.is_none());
+    fixture.app.keymap = crate::keymap::RuntimeKeymap::defaults();
+    fixture
+        .app
+        .chat_widget
+        .apply_keymap_update(Default::default(), &fixture.app.keymap);
+    fixture.app.chat_widget.toggle_vim_mode_and_notify();
+    fixture.app.chat_widget.insert_str("abc");
+    fixture
+        .app
+        .chat_widget
+        .handle_key_event(KeyCode::Char('i').into());
+    assert!(!fixture.app.should_recover_vim_insert_escape(entry));
+    fixture
+        .app
+        .chat_widget
+        .open_keymap_debug(&fixture.app.keymap);
+    fixture.key(entry).await?;
+    assert!(fixture.app.overlay.is_none());
+    fixture
+        .app
+        .chat_widget
+        .handle_key_event(KeyEvent::new(KeyCode::Char('c'), KeyModifiers::CONTROL));
+    fixture.key(entry).await?;
+    let request_id = fixture.app.usage_request.unwrap();
+    let requests = std::iter::from_fn(|| fixture.events.try_recv().ok());
+    assert_eq!(
+        requests
+            .filter(|event| matches!(event, AppEvent::LoadUsage { refresh: false, .. }))
+            .count(),
+        1
+    );
+    fixture
+        .dispatch(AppEvent::UsageLoaded {
+            request_id,
+            result: Ok(UsageReadResponse {
+                report: Arc::new(crate::usage::test_report()),
+                refreshed: false,
+            }),
+        })
+        .await?;
+    fixture
+        .key(KeyEvent::new(KeyCode::Char('2'), KeyModifiers::ALT))
+        .await?;
+    assert_eq!(
+        fixture.center().screen,
+        CenterScreen::Usage(UsageRange::Daily)
+    );
+    fixture.key(KeyCode::Char('p')).await?;
+    fixture.key(KeyCode::Char('t')).await?;
+    assert!(
+        fixture.events.try_recv().is_err(),
+        "settings belong to Summary"
+    );
+    fixture.key(KeyCode::Char('r')).await?;
+    let AppEvent::LoadUsage {
+        request_id: refresh_id,
+        refresh,
+    } = fixture.events.try_recv()?
+    else {
+        panic!("usage refresh")
+    };
+    assert!(refresh);
+    assert_ne!(refresh_id, request_id);
+    assert!(
+        fixture.events.try_recv().is_err(),
+        "usage refresh never reloads response pages"
+    );
+    assert!(fixture.center().report().is_none());
+    fixture.app.reconnect.offline = true;
+    fixture
+        .dispatch(AppEvent::UsageLoaded {
+            request_id: refresh_id,
+            result: Err("disconnected".into()),
+        })
+        .await?;
+    assert!(fixture.app.usage_request.is_none());
+    assert!(fixture.text().contains("Usage unavailable: disconnected"));
+    fixture.key(KeyCode::Esc).await?;
+    assert_eq!(fixture.center().screen, CenterScreen::Summary);
+    fixture.key(KeyCode::Esc).await?;
+    assert!(fixture.app.overlay.is_none());
+    assert!(fixture.commands.try_recv().is_err());
+    fixture.finish().await
+}
