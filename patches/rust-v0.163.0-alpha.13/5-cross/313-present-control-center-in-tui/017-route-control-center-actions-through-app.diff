+#[tokio::test]
+async fn proxy_settings_own_editor_input_cursor_and_return_to_the_same_center()
+-> crate::app::Result<()> {
+    let mut fixture = Fixture::new().await?;
+    let config = toml::from_str("[list]\ncancel = ['esc', 'ctrl-x c']")?;
+    fixture.app.keymap = crate::keymap::RuntimeKeymap::from_config(&config).expect("valid keymap");
+    fixture.open_settings('p', "Proxy").await?;
+    let request = fixture.app.usage_request;
+    fixture.key(KeyCode::Char('a')).await?;
+    let event = fixture.events.try_recv()?;
+    fixture.dispatch(event).await?;
+    assert!(
+        fixture
+            .app
+            .active_keymap_contexts()
+            .contains(KeymapContext::Editor)
+    );
+    fixture
+        .app
+        .handle_tui_event(
+            &mut fixture.tui,
+            &mut fixture.server,
+            TuiEvent::Paste("route".into()),
+        )
+        .await?;
+    fixture.key(KeyCode::Char('r')).await?;
+    assert!(
+        fixture.events.try_recv().is_err(),
+        "editor r must not refresh usage"
+    );
+    // Submit after the native paste detector's single-character window.
+    tokio::time::sleep(crate::bottom_pane::ChatComposer::recommended_paste_flush_delay()).await;
+    fixture.key(KeyCode::Enter).await?;
+    let event = fixture.events.try_recv()?;
+    assert!(matches!(&event, AppEvent::OpenProxyAddUrl { alias, .. } if alias == "router"));
+    fixture.dispatch(event).await?;
+    let dialog = fixture
+        .center()
+        .dialogs
+        .centered_view()
+        .expect("URL editor");
+    let (x, y) = dialog
+        .cursor_pos(Rect::new(0, 0, 200, 32))
+        .expect("editor cursor");
+    assert!((64..136).contains(&x) && (1..31).contains(&y));
+    fixture
+        .app
+        .handle_tui_event(
+            &mut fixture.tui,
+            &mut fixture.server,
+            TuiEvent::Paste("invalid".into()),
+        )
+        .await?;
+    fixture.key(KeyCode::Enter).await?;
+    let event = fixture.events.try_recv()?;
+    fixture.dispatch(event).await?;
+    assert!(fixture.text().contains("Failed to save proxy settings"));
+    fixture.key(KeyCode::Esc).await?;
+    assert!(!fixture.center().has_dialog());
+    fixture.dispatch(AppEvent::OpenProxy).await?;
+    fixture
+        .app
+        .handle_tui_event(&mut fixture.tui, &mut fixture.server, TuiEvent::Draw)
+        .await?;
+    fixture
+        .key(KeyEvent::new(KeyCode::Char('x'), KeyModifiers::CONTROL))
+        .await?;
+    fixture.key(KeyCode::Char('c')).await?;
+    assert!(!fixture.center().has_dialog());
+    assert!(!fixture.app.chat_widget.has_active_modal());
+    assert_eq!(fixture.app.usage_request, request);
+    assert_eq!(
+        fixture.app.chat_widget.composer_text_with_pending(),
+        "Preserved draft"
+    );
+    fixture.finish().await
+}
