+use super::*;
+use crate::keymap::KeymapContext;
+use crate::pager_overlay::ControlCenter;
+use crate::render::renderable::Renderable;
+use crate::usage::UsageRange;
+use codex_app_server_protocol::UsageReadResponse;
+use crossterm::event::KeyModifiers;
+use pretty_assertions::assert_eq;
+use ratatui::buffer::Buffer;
+use ratatui::layout::Rect;
+use std::sync::Arc;
+use std::time::Duration;
+use tokio::sync::mpsc::UnboundedReceiver;
+
+// These checks own App routing. Dialog, accounting and daemon protocols retain their own tests.
+struct Fixture {
+    app: Box<App>,
+    tui: tui::Tui,
+    server: AppServerSession,
+    events: UnboundedReceiver<AppEvent>,
+    commands: UnboundedReceiver<crate::app_command::AppCommand>,
+}
+
+impl Fixture {
+    async fn new() -> crate::app::Result<Self> {
+        let (app, events, commands) = crate::app::tests::make_test_app_with_channels().await;
+        let server = crate::start_embedded_app_server_for_picker(&app.config).await?;
+        Ok(Self {
+            app,
+            tui: crate::tui::test_support::make_test_tui()?,
+            server,
+            events,
+            commands,
+        })
+    }
+
+    async fn key(&mut self, key: impl Into<KeyEvent>) -> crate::app::Result<AppRunControl> {
+        self.app
+            .handle_tui_event(&mut self.tui, &mut self.server, TuiEvent::Key(key.into()))
+            .await
+    }
+
+    async fn dispatch(&mut self, event: AppEvent) -> crate::app::Result<AppRunControl> {
+        self.app
+            .handle_event(&mut self.tui, &mut self.server, event)
+            .await
+    }
+
+    fn center(&self) -> &ControlCenter {
+        let Some(Overlay::ControlCenter(center)) = &self.app.overlay else {
+            panic!("retained center")
+        };
+        center
+    }
+
+    fn text(&mut self) -> String {
+        let Some(Overlay::ControlCenter(center)) = &mut self.app.overlay else {
+            panic!("retained center")
+        };
+        let area = Rect::new(0, 0, 200, 32);
+        let mut buffer = Buffer::empty(area);
+        center.render(area, &mut buffer);
+        buffer
+            .content
+            .chunks_exact(200)
+            .map(|row| {
+                row.iter()
+                    .map(|cell| cell.symbol())
+                    .collect::<String>()
+                    .trim()
+                    .to_owned()
+            })
+            .collect::<Vec<_>>()
+            .join("\n")
+    }
+
+    async fn open_settings(&mut self, key: char, title: &str) -> crate::app::Result<()> {
+        self.app.chat_widget.insert_str("Preserved draft");
+        self.app.open_control_center(&mut self.tui);
+        while self.events.try_recv().is_ok() {}
+        self.key(KeyCode::Char(key)).await?;
+        tokio::time::timeout(Duration::from_secs(10), async {
+            while !self.text().contains(title) {
+                let event = self.events.recv().await.expect("settings event");
+                self.dispatch(event).await?;
+            }
+            Ok::<_, color_eyre::Report>(())
+        })
+        .await??;
+        assert!(!self.app.chat_widget.has_active_modal());
+        let text = self.text();
+        assert!(text.contains("Summary") && text.contains("Responses") && text.contains(title));
+        assert!(self.tui.is_alt_screen_active());
+        Ok(())
+    }
+
+    async fn finish(self) -> crate::app::Result<()> {
+        self.server.shutdown().await?;
+        Ok(())
+    }
+}
