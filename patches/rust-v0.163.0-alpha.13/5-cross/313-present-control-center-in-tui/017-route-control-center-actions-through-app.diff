+#[tokio::test]
+async fn settings_routes_preserve_native_popup_surfaces_in_both_hosts() -> crate::app::Result<()> {
+    let openers: [(&str, fn(&mut App, &tui::Tui)); 4] = [
+        ("Proxy", |app, tui| {
+            app.open_proxy_menu(tui, Default::default());
+        }),
+        ("Add proxy", |app, tui| {
+            app.open_proxy_add_alias(tui, Default::default());
+        }),
+        ("Bot token", |app, tui| {
+            app.open_telegram_menu(tui, Default::default());
+        }),
+        ("GitHub release updates", |app, tui| {
+            app.open_telegram_version(tui, Default::default());
+        }),
+    ];
+    for bg in [(24, 24, 24), (245, 245, 245)] {
+        for in_center in [false, true] {
+            for (title, open) in openers {
+                let mut app = crate::app::test_support::make_test_app().await;
+                let mut tui = crate::tui::test_support::make_test_tui()?;
+                crate::terminal_palette::with_test_default_colors(
+                    crate::terminal_probe::DefaultColors {
+                        fg: (128, 128, 128),
+                        bg,
+                    },
+                    || {
+                        if in_center {
+                            app.open_control_center(&mut tui);
+                        }
+                        open(&mut app, &tui);
+                        let panel = crate::style::user_message_style()
+                            .bg
+                            .expect("known palette supplies the native panel");
+                        let area = Rect::new(0, 0, 80, 24);
+                        let mut buffer = Buffer::empty(area);
+                        let backdrop = ratatui::style::Color::Magenta;
+                        buffer.set_style(area, ratatui::style::Style::default().bg(backdrop));
+                        if in_center {
+                            assert!(!app.chat_widget.has_active_modal());
+                            let Some(Overlay::ControlCenter(center)) = &app.overlay else {
+                                panic!("retained control center")
+                            };
+                            center
+                                .dialogs
+                                .centered_view()
+                                .expect("control center owns a centered dialog")
+                                .render(area, &mut buffer);
+                            let first_dialog_cell = buffer
+                                .content
+                                .iter()
+                                .find(|cell| cell.bg != backdrop)
+                                .expect("settings dialog painted its surface");
+                            assert_eq!(first_dialog_cell.bg, panel, "{title}");
+                            assert_eq!(buffer[(0, 0)].bg, backdrop);
+                        } else {
+                            assert!(app.overlay.is_none());
+                            assert!(app.chat_widget.has_active_modal());
+                            app.chat_widget.render(area, &mut buffer);
+                        }
+                        let title_cells = buffer
+                            .content
+                            .chunks_exact(usize::from(area.width))
+                            .flat_map(|row| row.windows(title.len()))
+                            .find(|cells| {
+                                cells
+                                    .iter()
+                                    .zip(title.chars())
+                                    .all(|(cell, ch)| cell.symbol().chars().eq(std::iter::once(ch)))
+                            })
+                            .expect("settings title is visible through its actual host");
+                        assert!(
+                            title_cells.iter().all(|cell| cell.bg == panel),
+                            "{title}, center={in_center}"
+                        );
+                    },
+                );
+            }
+        }
+    }
+    Ok(())
+}
