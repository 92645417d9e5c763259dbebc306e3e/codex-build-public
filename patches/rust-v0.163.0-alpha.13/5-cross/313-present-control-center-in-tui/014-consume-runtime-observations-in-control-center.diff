+#[tokio::test]
+async fn timing_refreshes_on_new_generation_and_expiry_without_reloading_usage_or_accepting_stale_results()
+-> crate::app::Result<()> {
+    use codex_app_server_client::AppServerEvent;
+    use codex_app_server_protocol::JSONRPCMessage;
+    use codex_app_server_protocol::ResponseAttemptUpdatedNotification;
+    use codex_app_server_protocol::ServerNotification;
+    use codex_protocol::response_metrics::ResponseAttemptEnd;
+    use futures::SinkExt;
+    use futures::StreamExt;
+    use tokio_tungstenite::tungstenite::Message;
+
+    let (mut app, mut events, _ops) = crate::app::tests::make_test_app_with_channels().await;
+    let listener = tokio::net::TcpListener::bind("127.0.0.1:0").await?;
+    let url = format!("ws://{}", listener.local_addr()?);
+    let home = app.config.codex_home.display().to_string();
+    let (read_tx, mut read_rx) = tokio::sync::mpsc::unbounded_channel();
+    let server: tokio::task::JoinHandle<crate::app::Result<()>> = tokio::spawn(async move {
+        let (stream, _) = listener.accept().await?;
+        let mut socket = tokio_tungstenite::accept_async(stream).await?;
+        let mut reads = 0;
+        while let Some(Ok(Message::Text(text))) = socket.next().await {
+            let JSONRPCMessage::Request(request) = serde_json::from_str(&text)? else {
+                continue;
+            };
+            let response = match request.method.as_str() {
+                "initialize" => {
+                    serde_json::json!({"id": request.id, "result": {"userAgent": "test", "codexHome": home}})
+                }
+                "modelResponse/timing/read" => {
+                    reads += 1;
+                    read_tx.send(reads).unwrap();
+                    if reads == 2 {
+                        serde_json::json!({"id": request.id, "error": {"code": -32600, "message": "Timing unavailable"}})
+                    } else {
+                        serde_json::json!({"id": request.id, "result": {
+                            "successfulAttempts": 8, "totalAttempts": 12,
+                            "models": [{"requestedModel": "Model/Case", "successfulAttempts": 8,
+                                "totalAttempts": 12, "lastTps": null, "lastTtfcMs": null,
+                                "tps": {"sampleCount": 10, "p50": reads as f64, "slow": 0.5},
+                                "ttfcMs": {"sampleCount": 3, "p50": 400.0, "slow": 1200.0}}],
+                            "persistenceError": (reads == 6).then_some("database is locked")
+                        }})
+                    }
+                }
+                method => panic!("summary must not reload usage or response pages: {method}"),
+            };
+            socket
+                .send(Message::Text(response.to_string().into()))
+                .await?;
+        }
+        assert_eq!(reads, 7);
+        Ok(())
+    });
+    let client = crate::connect_remote_app_server(crate::RemoteAppServerEndpoint::WebSocket {
+        websocket_url: url,
+        auth_token: None,
+    })
+    .await?;
+    let mut session =
+        AppServerSession::new(client, crate::app_server_session::ThreadParamsMode::Remote);
+    let mut tui = crate::tui::test_support::make_test_tui()?;
+    app.open_control_center(&mut tui);
+    let report_id = app.usage_request.unwrap();
+    app.finish_usage(
+        &mut tui,
+        report_id,
+        Ok(UsageReadResponse {
+            report: Arc::new(crate::usage::test_report()),
+            refreshed: true,
+        }),
+    );
+    while events.try_recv().is_ok() {}
+    let mut preset = crate::test_support::TEST_MODEL_PRESETS[0].clone();
+    preset.model = "Model/Case".into();
+    preset.display_name = "Friendly live model".into();
+    app.model_catalog = Arc::new(crate::model_catalog::ModelCatalog::new(vec![preset]));
+    app.refresh_control_center_details(&session, &TuiEvent::Draw);
+    assert!(
+        !app.control_center_details()
+            .iter()
+            .join("\n")
+            .contains("Status: Loading")
+    );
+    let Some(Overlay::ControlCenter(view)) = &mut app.overlay else {
+        panic!("summary")
+    };
+    let area = ratatui::layout::Rect::new(0, 0, 200, 32);
+    let mut buffer = ratatui::buffer::Buffer::empty(area);
+    view.render(area, &mut buffer);
+    let footer = (0..area.width)
+        .map(|x| buffer[(x, area.bottom() - 1)].symbol())
+        .collect::<String>();
+    assert!(footer.ends_with("Loading responses..."));
+    assert!(
+        matches!(&app.overlay, Some(Overlay::ControlCenter(view)) if Arc::ptr_eq(&view.responses.catalog, &app.model_catalog))
+    );
+    app.refresh_control_center_timing(&session, false);
+    consume_timing_result(&mut app, &mut tui, &mut session, &mut events).await?;
+    assert!(
+        app.control_center_details()
+            .iter()
+            .join("\n")
+            .contains("Friendly live model\n")
+    );
+    assert!(
+        app.control_center_details()
+            .iter()
+            .join("\n")
+            .contains("TPS P50 (typical): 1.0")
+    );
+    let Some(Overlay::ControlCenter(view)) = &mut app.overlay else {
+        unreachable!()
+    };
+    assert!(view.timing_request.is_none());
+    view.timing_read_at = Some(Instant::now() - Duration::from_secs(2));
+    app.refresh_control_center_timing(&session, false);
+    consume_timing_result(&mut app, &mut tui, &mut session, &mut events).await?;
+    assert!(
+        app.control_center_details()
+            .iter()
+            .join("\n")
+            .contains("Timing unavailable")
+    );
+    app.refresh_control_center_timing(&session, false);
+    assert!(
+        matches!(&app.overlay, Some(Overlay::ControlCenter(view)) if view.timing_request.is_none())
+    );
+    for (kind, ended) in [
+        ("generation", false),
+        ("warmup", true),
+        ("generation", true),
+    ] {
+        let mut attempt = crate::response_timing::tests::attempt(
+            50,
+            ended.then_some(ResponseAttemptEnd::Completed),
+        );
+        attempt.request_kind = kind.into();
+        app.handle_app_server_event(
+            &session,
+            AppServerEvent::ServerNotification(Box::new(
+                ServerNotification::ResponseAttemptUpdated(ResponseAttemptUpdatedNotification {
+                    thread_id: attempt.thread_id.map(|id| id.to_string()),
+                    attempt,
+                }),
+            )),
+        )
+        .await;
+        assert!(
+            matches!(&app.overlay, Some(Overlay::ControlCenter(view)) if view.timing_request.is_some() == (kind == "generation" && ended))
+        );
+    }
+    consume_timing_result(&mut app, &mut tui, &mut session, &mut events).await?;
+    assert!(
+        app.control_center_details()
+            .iter()
+            .join("\n")
+            .contains("TPS P50 (typical): 3.0")
+    );
+    app.refresh_control_center_timing(&session, true);
+    tokio::time::timeout(Duration::from_secs(10), async {
+        while read_rx.recv().await.expect("summary read") != 4 {}
+    })
+    .await?;
+    app.close_transcript_overlay(&mut tui);
+    app.open_control_center(&mut tui);
+    app.refresh_control_center_timing(&session, false);
+    for _ in 0..2 {
+        consume_timing_result(&mut app, &mut tui, &mut session, &mut events).await?;
+    }
+    assert!(
+        app.control_center_details()
+            .iter()
+            .join("\n")
+            .contains("TPS P50 (typical): 5.0")
+    );
+    assert!(
+        matches!(&app.overlay, Some(Overlay::ControlCenter(view)) if view.request_id == app.usage_request)
+    );
+    let Some(Overlay::ControlCenter(view)) = &mut app.overlay else {
+        unreachable!()
+    };
+    view.screen = CenterScreen::Responses;
+    view.responses.history.persistence_error = Some("database is locked".into());
+    view.timing_read_at = Some(Instant::now() - Duration::from_secs(2));
+    app.refresh_control_center_details(&session, &TuiEvent::Draw);
+    app.refresh_control_center_details(&session, &TuiEvent::Draw);
+    consume_timing_result(&mut app, &mut tui, &mut session, &mut events).await?;
+    let Some(Overlay::ControlCenter(view)) = &mut app.overlay else {
+        unreachable!()
+    };
+    assert_eq!(
+        view.responses.history.persistence_error.as_deref(),
+        Some("database is locked")
+    );
+    view.timing_read_at = Some(Instant::now() - Duration::from_secs(2));
+    app.refresh_control_center_details(&session, &TuiEvent::Draw);
+    consume_timing_result(&mut app, &mut tui, &mut session, &mut events).await?;
+    let Some(Overlay::ControlCenter(view)) = &mut app.overlay else {
+        unreachable!()
+    };
+    assert!(view.responses.history.persistence_error.is_none());
+    assert_eq!(view.screen, CenterScreen::Responses);
+    app.refresh_control_center_timing(&session, true);
+    assert!(
+        matches!(&app.overlay, Some(Overlay::ControlCenter(view)) if view.timing_request.is_none())
+    );
+    session.shutdown().await?;
+    server.await??;
+    Ok(())
+}
