+use super::*;
+use codex_app_server_protocol::UsageReadResponse;
+use crossterm::event::KeyCode;
+use crossterm::event::KeyEvent;
+use crossterm::event::KeyModifiers;
+use itertools::Itertools;
+use pretty_assertions::assert_eq;
+
+#[tokio::test]
+async fn quota_loads_every_recent_billing_cycle_through_app_server() {
+    use chrono::Duration;
+    use chrono::Utc;
+    use itertools::Itertools;
+
+    let mut app = crate::app::test_support::make_test_app().await;
+    let home = app.config.codex_home.as_path();
+    std::fs::create_dir_all(home.join("sessions")).unwrap();
+    std::fs::write(
+        home.join("models.json"),
+        serde_json::json!({"models": [], "prices": {"summary-model": {"0": {
+            "input": 1.0, "cache_read": 0.0, "cache_write": 0.0, "output": 0.0
+        }}}})
+        .to_string(),
+    )
+    .unwrap();
+    let now = Utc::now();
+    let mut records = vec![
+        serde_json::json!({"type": "session_meta", "payload": {"id": "summary-history", "history_mode": "paginated"}}),
+        serde_json::json!({"type": "turn_context", "payload": {"model": "summary-model"}}),
+    ];
+    let mut total = 0;
+    for cycle in 0..15 {
+        let start = now - Duration::days(99 - cycle * 7);
+        let reset = (start + Duration::days(7)).timestamp();
+        // Each quota sample excludes its response's own usage.
+        for (offset, percent, tokens) in [(0, 0, 1_000_000), (12, 100, 1)] {
+            total += tokens;
+            records.push(serde_json::json!({
+                "type": "event_msg",
+                "timestamp": (start + Duration::hours(offset)).to_rfc3339(),
+                "payload": {
+                    "type": "token_count",
+                    "info": {
+                        "last_token_usage": {"input_tokens": tokens, "total_tokens": tokens},
+                        "total_token_usage": {"input_tokens": total, "total_tokens": total}
+                    },
+                    "rate_limits": {"primary": {
+                        "used_percent": percent, "window_minutes": 10080, "resets_at": reset
+                    }}
+                }
+            }));
+        }
+    }
+    std::fs::write(
+        home.join("sessions/history.jsonl"),
+        records.iter().map(ToString::to_string).join("\n") + "\n",
+    )
+    .unwrap();
+    let mut server = crate::start_embedded_app_server_for_picker(&app.config)
+        .await
+        .unwrap();
+    let request_id = server.next_request_id();
+    let report = server
+        .request_handle()
+        .request_typed::<codex_app_server_protocol::UsageReadResponse>(
+            codex_app_server_protocol::ClientRequest::UsageRead {
+                request_id,
+                params: codex_app_server_protocol::UsageReadParams::default(),
+            },
+        )
+        .await
+        .unwrap();
+    assert!(report.refreshed);
+    assert!(report.report.build_duration_ms.is_some());
+    for cycle in &report.report.quota {
+        let models = cycle.model_usage.as_ref().unwrap();
+        assert_eq!(models["summary-model"].tokens.input, 1_000_000);
+        assert!((models["summary-model"].cost - cycle.observed_cost_usd).abs() < 1e-12);
+    }
+    let text = crate::control_center_table::tests::render_lines(
+        crate::usage::render_quotas(&report.report, 0, 200).0,
+        200,
+    )
+    .iter()
+    .join("\n");
+    assert!(!text.contains("Average"));
+    assert!(!text.contains("last 90 days"));
+    let cycles = text
+        .lines()
+        .filter(|line| line.contains("Completed") || line.contains("Provisional"))
+        .collect::<Vec<_>>();
+    assert_eq!(cycles.len(), 13);
+    for line in &cycles {
+        let cells = line.split('│').map(str::trim).collect::<Vec<_>>();
+        // The previous cycle's last request precedes the new seven-day window.
+        // Each displayed estimate therefore starts at its own zero sample.
+        assert_eq!(
+            [cells[4], cells[6], cells[7], cells[9]],
+            ["0d 12:00:00", "$1.00", "$1.00", "2"],
+            "{line}"
+        );
+    }
+    assert_eq!(text.matches("Completed").count(), 12);
+    assert_eq!(text.matches("Provisional").count(), 1);
+    assert!(!text.contains("cycles"));
+    let mut tui = crate::tui::test_support::make_test_tui().unwrap();
+    app.open_control_center(&mut tui);
+    let request_id = app.usage_request.unwrap();
+    app.finish_usage(&mut tui, request_id, Ok(report));
+    let details = app.control_center_details().iter().join("\n");
+    assert!(
+        details.contains("Quotas\nWeekly\nLatest estimated: $1.00\nAverage estimated: $1.00\nAverage utilization: 100.0%")
+    );
+    app.overlay
+        .as_mut()
+        .unwrap()
+        .handle_event(
+            &mut tui,
+            TuiEvent::Key(KeyEvent::new(KeyCode::Char('0'), KeyModifiers::ALT)),
+        )
+        .unwrap();
+    app.refresh_usage(&mut tui);
+    let request_id = app.usage_request.unwrap();
+    app.finish_usage(
+        &mut tui,
+        request_id,
+        Ok(UsageReadResponse {
+            report: Arc::new(crate::usage::test_report()),
+            refreshed: true,
+        }),
+    );
+    let Some(Overlay::ControlCenter(view)) = &mut app.overlay else {
+        panic!("same quota page after refresh")
+    };
+    assert_eq!(view.screen, CenterScreen::Quotas);
+    let area = ratatui::layout::Rect::new(0, 0, 200, 40);
+    view.render(area, &mut ratatui::buffer::Buffer::empty(area));
+    let started_x = view
+        .table_interaction
+        .cells
+        .iter()
+        .find(|(_, text)| text.as_ref() == "Started")
+        .unwrap()
+        .0
+        .x;
+    let starts = view
+        .table_interaction
+        .cells
+        .iter()
+        .filter(|(rect, text)| rect.x == started_x && text.starts_with("2026-"))
+        .map(|(_, text)| text.as_ref())
+        .collect::<Vec<_>>();
+    assert_eq!(
+        starts,
+        ["2026-09-29 08:00", "2026-09-22 08:00", "2026-09-10 08:00"]
+    );
+    server.shutdown().await.unwrap();
+}
