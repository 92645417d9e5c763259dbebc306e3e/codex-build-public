+//! Observe shared response timing and runtime details without reloading usage accounting.
+use super::App;
+use crate::app_event::AppEvent;
+use crate::app_server_session::AppServerSession;
+use crate::control_center_table::Palette;
+use crate::pager_overlay::CenterScreen;
+use crate::pager_overlay::Overlay;
+use crate::response_timing::seconds;
+use crate::response_timing::tps;
+use crate::tui;
+use crate::tui::TuiEvent;
+use codex_app_server_protocol::ClientRequest;
+use codex_app_server_protocol::RemoteControlConnectionStatus;
+use codex_app_server_protocol::RequestId;
+use codex_app_server_protocol::ResponseTimingReadParams;
+use codex_app_server_protocol::ResponseTimingReadResponse;
+use ratatui::style::Stylize;
+use ratatui::text::Line;
+use ratatui::text::Span;
+use std::sync::Arc;
+use std::time::Duration;
+use std::time::Instant;
+use uuid::Uuid;
+
+impl App {
+    pub(super) fn refresh_control_center_details(
+        &mut self,
+        app_server: &AppServerSession,
+        event: &TuiEvent,
+    ) {
+        if !matches!(self.overlay, Some(Overlay::ControlCenter(_))) {
+            return;
+        }
+        if matches!(
+            event,
+            TuiEvent::Draw | TuiEvent::Resize(_) | TuiEvent::FocusGained | TuiEvent::Resume
+        ) {
+            self.refresh_control_center_timing(app_server, false);
+            let details = self.control_center_details();
+            if let Some(Overlay::ControlCenter(view)) = &mut self.overlay {
+                view.details = details;
+                view.responses.catalog = Arc::clone(&self.model_catalog);
+            }
+        }
+    }
+
+    pub(super) fn refresh_control_center_timing(
+        &mut self,
+        app_server: &AppServerSession,
+        force: bool,
+    ) {
+        if self.reconnect.offline {
+            return;
+        }
+        let Some(Overlay::ControlCenter(view)) = &mut self.overlay else {
+            return;
+        };
+        let response_error = view.screen == CenterScreen::Responses
+            && view.responses.history.persistence_error.is_some();
+        if (view.screen != CenterScreen::Summary && !response_error)
+            || view.timing_request.is_some()
+        {
+            return;
+        }
+        let now = Instant::now();
+        if !force
+            && (view.timing.as_ref().is_some_and(Result::is_err)
+                || view
+                    .timing_read_at
+                    .is_some_and(|at| now.duration_since(at) < Duration::from_secs(1)))
+        {
+            return;
+        }
+        // Only the shared in-memory summary is read; drawing never scans response storage.
+        let request_id = Uuid::new_v4();
+        view.timing_request = Some(request_id);
+        view.timing_read_at = Some(now);
+        let handle = app_server.request_handle();
+        let events = self.app_event_tx.clone();
+        tokio::spawn(async move {
+            let result = handle
+                .request_typed(ClientRequest::ResponseTimingRead {
+                    request_id: RequestId::String(request_id.to_string()),
+                    params: ResponseTimingReadParams::default(),
+                })
+                .await
+                .map_err(|error| error.to_string());
+            events.send(AppEvent::ControlCenterTimingLoaded { request_id, result });
+        });
+    }
+
+    pub(super) fn finish_control_center_timing(
+        &mut self,
+        tui: &mut tui::Tui,
+        request_id: Uuid,
+        result: Result<ResponseTimingReadResponse, String>,
+    ) {
+        if let Some(Overlay::ControlCenter(view)) = &mut self.overlay
+            && view.timing_request == Some(request_id)
+        {
+            view.timing_request = None;
+            if let Ok(summary) = &result {
+                view.responses.history.persistence_error = summary.persistence_error.clone();
+            }
+            view.timing = Some(result);
+            tui.frame_requester().schedule_frame();
+        }
+    }
+
+    fn control_center_details(&self) -> Vec<Line<'static>> {
+        let timing = match &self.overlay {
+            Some(Overlay::ControlCenter(view)) => view.timing.as_ref(),
+            _ => None,
+        };
+        let summary = timing.and_then(|result| result.as_ref().ok());
+        let quota_estimates = match &self.overlay {
+            Some(Overlay::ControlCenter(view)) => view.report(),
+            _ => None,
+        }
+        .map(|report| &report.quota)
+        .filter(|estimates| !estimates.is_empty());
+        let latest_estimate = quota_estimates.and_then(|estimates| {
+            estimates.iter().max_by_key(|estimate| {
+                chrono::DateTime::parse_from_rfc3339(&estimate.started_at)
+                    .expect("validated quota timestamp")
+            })
+        });
+        let quota_means = quota_estimates.map(|estimates| {
+            let count = estimates.len() as f64;
+            (
+                estimates
+                    .iter()
+                    .map(|estimate| estimate.estimated_weekly_cost_usd)
+                    .sum::<f64>()
+                    / count,
+                estimates
+                    .iter()
+                    .map(|estimate| estimate.used_percent_end)
+                    .sum::<f64>()
+                    / count,
+            )
+        });
+        let palette = Palette::current();
+        let heading = |text: &str, index| Line::styled(text.to_owned(), palette.model(index));
+        let metric = |label: &str, value: Option<String>| {
+            Line::from(vec![
+                format!("{label}: ").dim(),
+                Span::styled(value.unwrap_or_else(|| "--".into()), palette.intensity(16)),
+            ])
+        };
+        let mut lines = vec![heading("Responses", 1)];
+        if let Some(error) = timing
+            .and_then(|result| result.as_ref().err())
+            .or_else(|| summary.and_then(|summary| summary.persistence_error.as_ref()))
+        {
+            lines.push(format!("Timing history: {error}").yellow().into());
+        }
+        lines.push(metric(
+            "24H total success",
+            summary.and_then(|summary| {
+                success_rate(summary.successful_attempts, summary.total_attempts)
+            }),
+        ));
+        if let Some(summary) = summary {
+            if summary.models.is_empty() {
+                lines.push("No generation responses".dim().into());
+            } else {
+                lines.push(Line::default());
+            }
+            for (index, model) in summary.models.iter().enumerate() {
+                let tps_samples = model.tps.as_ref().map_or(0, |values| values.sample_count);
+                let ttfc_samples = model
+                    .ttfc_ms
+                    .as_ref()
+                    .map_or(0, |values| values.sample_count);
+                lines.push(heading(
+                    self.model_catalog.display_name(&model.requested_model),
+                    index,
+                ));
+                lines.extend([
+                    metric(
+                        "24H success",
+                        success_rate(model.successful_attempts, model.total_attempts),
+                    ),
+                    metric("Last TPS", model.last_tps.map(tps)),
+                    metric("Last TTFC", model.last_ttfc_ms.map(seconds)),
+                    metric(
+                        "24H TPS P50 (typical)",
+                        model.tps.as_ref().map(|values| tps(values.p50)),
+                    ),
+                    metric(
+                        "24H TPS P05 (slow)",
+                        model.tps.as_ref().map(|values| tps(values.slow)),
+                    ),
+                    metric("24H TPS samples", Some(tps_samples.to_string())),
+                    metric(
+                        "24H TTFC P50 (typical)",
+                        model
+                            .ttfc_ms
+                            .as_ref()
+                            .map(|values| format!("{:.2}s", values.p50 / 1000.0)),
+                    ),
+                    metric(
+                        "24H TTFC P95 (slow)",
+                        model
+                            .ttfc_ms
+                            .as_ref()
+                            .map(|values| format!("{:.2}s", values.slow / 1000.0)),
+                    ),
+                    metric("24H TTFC samples", Some(ttfc_samples.to_string())),
+                    Line::default(),
+                ]);
+            }
+        } else {
+            if timing.is_some() {
+                lines.push(metric("Status", Some("Unavailable".into())));
+            }
+            lines.push(Line::default());
+        }
+        let rtt = |connected: bool, ms: Option<u64>| {
+            if connected {
+                ms.map(|ms| format!("{ms}ms"))
+            } else {
+                Some("Disconnected".into())
+            }
+        };
+        lines.extend([
+            heading("WebSocket RTT", 2),
+            metric(
+                "Responses",
+                self.chat_widget
+                    .responses_stream_connection_status()
+                    .and_then(|status| rtt(status.connected, status.rtt_ms)),
+            ),
+            metric(
+                "Remote",
+                self.remote_control_connection_status
+                    .as_ref()
+                    .and_then(|status| {
+                        rtt(
+                            status.status == RemoteControlConnectionStatus::Connected,
+                            status.rtt_ms,
+                        )
+                    }),
+            ),
+            Line::default(),
+            heading("Quotas", 3),
+            heading("Weekly", 3),
+            metric(
+                "Latest estimated",
+                latest_estimate
+                    .map(|estimate| format!("${:.2}", estimate.estimated_weekly_cost_usd)),
+            ),
+            metric(
+                "Average estimated",
+                quota_means.map(|(cost, _)| format!("${cost:.2}")),
+            ),
+            metric(
+                "Average utilization",
+                quota_means.map(|(_, percent)| format!("{percent:.1}%")),
+            ),
+            Line::default(),
+            heading("Storage free", 4),
+            metric(
+                "Home",
+                self.storage_capacity
+                    .as_ref()
+                    .map(|capacity| format_capacity_bytes(capacity.home_available_bytes)),
+            ),
+            metric(
+                "Harness",
+                self.storage_capacity
+                    .as_ref()
+                    .map(|capacity| format_capacity_bytes(capacity.harness_available_bytes)),
+            ),
+            Line::default(),
+            heading("Miscellaneous", 5),
+            metric("Proxy", self.proxy_alias.clone()),
+            metric(
+                "Clients",
+                self.connected_client_count.map(|count| count.to_string()),
+            ),
+        ]);
+        lines
+    }
+}
+
+fn success_rate(successful: u64, total: u64) -> Option<String> {
+    (total > 0).then(|| format!("{:.2}%", successful as f64 * 100.0 / total as f64))
+}
+
+fn format_capacity_bytes(bytes: u64) -> String {
+    const UNITS: [&str; 6] = ["B", "KiB", "MiB", "GiB", "TiB", "PiB"];
+    let mut value = bytes as f64;
+    let mut unit = 0;
+    while value >= 1024.0 && unit + 1 < UNITS.len() {
+        value /= 1024.0;
+        unit += 1;
+    }
+    format!("{value:.2}{}", UNITS[unit])
+}
+
