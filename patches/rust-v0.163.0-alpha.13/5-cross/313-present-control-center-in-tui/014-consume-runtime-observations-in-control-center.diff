+        .handle_event(&mut tui, TuiEvent::Key(KeyCode::End.into()))?;
+    let Some(Overlay::ControlCenter(view)) = &mut app.overlay else {
+        unreachable!()
+    };
+    assert!(view.report().is_some());
+    assert_eq!(view.responses.history.count(), 1);
+    assert_eq!(view.timing_request, Some(timing_request));
+    assert_eq!(view.screen, CenterScreen::Summary);
+    view.render(area, &mut buffer);
+    let duration = buffer
+        .content
+        .chunks_exact(usize::from(area.width))
+        .find_map(|row| {
+            let text = row.iter().map(|cell| cell.symbol()).collect::<String>();
+            text.split_once("Build duration: ")
+                .map(|(_, value)| value.trim().to_owned())
+        })
+        .expect("producer build duration is visible");
+    assert_eq!(duration, "1.23s");
+    assert!(events.try_recv().is_err());
+    Ok(())
+}
