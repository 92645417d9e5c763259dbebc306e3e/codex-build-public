+#[tokio::test]
+async fn latest_quota_estimate_uses_current_report_and_actual_cycle_order() {
+    let mut app = crate::app::test_support::make_test_app().await;
+    let mut tui = crate::tui::test_support::make_test_tui().unwrap();
+    app.open_control_center(&mut tui);
+    let mut report = crate::usage::test_report();
+    report.quota.truncate(2);
+    report.quota[0].started_at = "2026-09-29T01:00:00+02:00".into();
+    report.quota[0].estimated_weekly_cost_usd = 123.0;
+    report.quota[0].status = codex_app_server_protocol::UsageQuotaStatus::Completed;
+    report.quota[1].started_at = "2026-09-28T23:30:00Z".into();
+    report.quota[1].estimated_weekly_cost_usd = 0.0;
+    report.quota[1].status = codex_app_server_protocol::UsageQuotaStatus::Provisional;
+    // Neither array order nor lexical timestamps identify the newest cycle.
+    report.quota.reverse();
+    let Some(Overlay::ControlCenter(view)) = &mut app.overlay else {
+        unreachable!()
+    };
+    view.set_report(Ok(Arc::new(report.clone())));
+    assert!(
+        app.control_center_details()
+            .iter()
+            .join("\n")
+            .contains("Latest estimated: $0.00")
+    );
+    report.quota.clear();
+    let Some(Overlay::ControlCenter(view)) = &mut app.overlay else {
+        unreachable!()
+    };
+    view.set_report(Ok(Arc::new(report)));
+    assert!(
+        app.control_center_details()
+            .iter()
+            .join("\n")
+            .contains("Latest estimated: --")
+    );
+}
+
+async fn consume_timing_result(
+    app: &mut App,
+    tui: &mut tui::Tui,
+    session: &mut AppServerSession,
+    events: &mut tokio::sync::mpsc::UnboundedReceiver<AppEvent>,
+) -> crate::app::Result<()> {
+    let event = tokio::time::timeout(Duration::from_secs(10), async {
+        loop {
+            let event = events.recv().await.expect("timing result");
+            if matches!(event, AppEvent::ControlCenterTimingLoaded { .. }) {
+                break event;
+            }
+        }
+    })
+    .await?;
+    app.handle_event(tui, session, event).await?;
+    Ok(())
+}
