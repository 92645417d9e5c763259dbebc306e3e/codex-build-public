+        app.handle_app_server_event(
+            &server,
+            codex_app_server_client::AppServerEvent::ServerNotification(Box::new(
+                ServerNotification::ProxyUpdated(
+                    codex_app_server_protocol::ProxyUpdatedNotification {
+                        generation: 3,
+                        active_alias: alias.map(str::to_owned),
+                    },
+                ),
+            )),
+        )
+        .await;
+        assert_eq!(app.proxy_alias.as_deref(), alias);
+    }
+    app.handle_app_server_event(
