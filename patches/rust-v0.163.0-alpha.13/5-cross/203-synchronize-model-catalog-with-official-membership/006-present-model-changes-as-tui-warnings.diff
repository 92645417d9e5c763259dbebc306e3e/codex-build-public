+#[tokio::test]
+async fn model_membership_change_is_one_visible_warning_in_each_tui_client() {
+    let notification =
+        ServerNotification::ModelMembershipChanged(ModelMembershipChangedNotification {
+            added: vec!["gpt-new".into()],
+            removed: vec!["gpt-old".into()],
+        });
+    let message = "Model added: gpt-new\nModel removed: gpt-old";
+    for client_index in 0..2 {
+        let (mut chat, mut rx, _op_rx) = make_chatwidget_manual(/*model_override*/ None).await;
+        chat.local_settings.tui.fullscreen_transcript = true;
+        chat.handle_server_notification(notification.clone(), /*replay_kind*/ None);
+        let cells: Vec<Arc<dyn HistoryCell>> = std::iter::from_fn(|| rx.try_recv().ok())
+            .filter_map(|event| match event {
+                AppEvent::InsertHistoryCell(cell) => Some(Arc::from(cell)),
+                _ => None,
+            })
+            .collect();
+        assert_eq!(
+            cells.len(),
+            1,
+            "one event creates one shared warning record"
+        );
+        assert_eq!(history_cell::warning_count(&cells), 1);
+        assert_eq!(
+            history_cell::warning_entries(&cells),
+            vec![history_cell::WarningEntry {
+                id: history_cell::WarningId::Message(message.into()),
+                source: "Warning".into(),
+                details: message.into(),
+            }]
+        );
+        for mode in [
+            history_cell::HistoryRenderMode::Rich,
+            history_cell::HistoryRenderMode::Raw,
+        ] {
+            let visible = cells[0].display_lines_for_mode(/*width*/ 80, mode);
+            let text = lines_to_single_string(&visible);
+            assert!(text.contains("Model added: gpt-new"));
+            assert!(text.contains("Model removed: gpt-old"));
+            match mode {
+                history_cell::HistoryRenderMode::Rich => {
+                    assert_eq!(text, "! Model added: gpt-new\n  Model removed: gpt-old\n");
+                    assert_eq!(
+                        visible[0].spans[0].style,
+                        crate::style::status_style(crate::style::StatusTone::Attention)
+                    );
+                    assert_eq!(visible, cells[0].transcript_lines(/*width*/ 80));
+                }
+                history_cell::HistoryRenderMode::Raw => {
+                    assert_eq!(visible, cells[0].raw_lines());
+                }
+            }
+        }
+        if client_index == 0 {
+            insta::assert_snapshot!(
+                "model_membership_change_transcript",
+                lines_to_single_string(&cells[0].display_lines(/*width*/ 80))
+            );
+        }
+        chat.open_warnings(&cells);
+        let popup = super::helpers::render_bottom_popup(&chat, /*width*/ 80);
+        assert!(popup.contains("Model added: gpt-new"));
+        assert!(popup.contains("Model removed: gpt-old"));
+        if client_index == 0 {
+            insta::assert_snapshot!("model_membership_change_warning", popup);
+        }
+        chat.handle_server_notification(
+            notification.clone(),
+            Some(ReplayKind::ResumeInitialMessages),
+        );
+        chat.handle_server_notification(
+            ServerNotification::ModelMembershipChanged(ModelMembershipChangedNotification {
+                added: Vec::new(),
+                removed: Vec::new(),
+            }),
+            /*replay_kind*/ None,
+        );
+        assert!(drain_insert_history_transcript(&mut rx).is_empty());
+    }
+    let (mut legacy, mut rx, _op_rx) = make_chatwidget_manual(/*model_override*/ None).await;
+    legacy.local_settings.tui.fullscreen_transcript = false;
+    legacy.handle_server_notification(notification, /*replay_kind*/ None);
+    assert!(drain_insert_history_transcript(&mut rx).is_empty());
+}
