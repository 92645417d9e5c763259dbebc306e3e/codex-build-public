+//! Attempt creation and synchronous publication, independent of history storage.
+
+use super::AttemptState;
+use super::ResponseAttemptContext;
+use super::ResponseAttemptTracker;
+use codex_api::ResponseObserver;
+use codex_api::ResponsesApiRequest;
+use codex_protocol::ThreadId;
+use codex_protocol::response_metrics::ResponseAttempt;
+use std::fmt;
+use std::sync::Arc;
+use std::sync::Mutex;
+use tokio::time::Instant;
+
+pub struct ResponseMetrics {
+    publish: Box<dyn Fn(ResponseAttempt) + Send + Sync>,
+}
+
+impl fmt::Debug for ResponseMetrics {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.debug_struct("ResponseMetrics").finish_non_exhaustive()
+    }
+}
+
+impl ResponseMetrics {
+    /// The consumer receives ordered revisions synchronously and must not wait
+    /// for storage or presentation. No request body or live tracker is published.
+    pub fn new(publish: impl Fn(ResponseAttempt) + Send + Sync + 'static) -> Self {
+        Self {
+            publish: Box::new(publish),
+        }
+    }
+
+    /// Starts a Responses attempt using only attribution and model settings.
+    /// The request body is not retained.
+    pub fn record_request(
+        self: &Arc<Self>,
+        thread_id: Option<ThreadId>,
+        turn_id: Option<String>,
+        request_kind: &str,
+        request: &ResponsesApiRequest,
+    ) -> Arc<dyn ResponseObserver> {
+        self.start(
+            ResponseAttemptContext {
+                thread_id,
+                turn_id,
+                request_kind: request_kind.to_owned(),
+                requested_model: request.model.clone(),
+                reasoning_effort: request
+                    .reasoning
+                    .as_ref()
+                    .and_then(|reasoning| reasoning.effort.as_ref())
+                    .map(ToString::to_string),
+            },
+            Instant::now(),
+            chrono::Utc::now().timestamp(),
+        )
+    }
+
+    pub(crate) fn start(
+        self: &Arc<Self>,
+        context: ResponseAttemptContext,
+        started: Instant,
+        started_at: i64,
+    ) -> Arc<ResponseAttemptTracker> {
+        let state = AttemptState::new(context, started, started_at);
+        self.publish(&state);
+        Arc::new(ResponseAttemptTracker {
+            state: Mutex::new(state),
+            metrics: Arc::clone(self),
+        })
+    }
+
+    pub(super) fn publish(&self, state: &AttemptState) {
+        (self.publish)(state.snapshot());
+    }
+}
