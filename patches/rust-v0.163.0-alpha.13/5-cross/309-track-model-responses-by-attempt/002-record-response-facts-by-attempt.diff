+//! Attempt-owned transport observations and published response snapshots.
+
+mod recording;
+pub use recording::ResponseMetrics;
+
+use codex_api::ResponseObservation;
+use codex_api::ResponseObserver;
+use codex_protocol::ThreadId;
+use codex_protocol::response_metrics::ResponseAttempt;
+use codex_protocol::response_metrics::ResponseAttemptEnd;
+use codex_protocol::response_metrics::ResponseTokenCounts;
+use serde_json::Value;
+use std::sync::Arc;
+use std::sync::Mutex;
+use std::time::Duration;
+use tokio::time::Instant;
+use uuid::Uuid;
+
+struct AttemptState {
+    record: ResponseAttempt,
+    started: Instant,
+    sent: Option<Instant>,
+    terminal: Option<Instant>,
+    notified: Instant,
+}
+
+pub(crate) struct ResponseAttemptContext {
+    pub thread_id: Option<ThreadId>,
+    pub turn_id: Option<String>,
+    pub request_kind: String,
+    pub requested_model: String,
+    pub reasoning_effort: Option<String>,
+}
+
+pub(crate) struct ResponseAttemptTracker {
+    state: Mutex<AttemptState>,
+    metrics: Arc<ResponseMetrics>,
+}
+
+impl AttemptState {
+    fn new(context: ResponseAttemptContext, started: Instant, started_at: i64) -> Self {
+        let now = Instant::now();
+        Self {
+            record: ResponseAttempt {
+                attempt_id: Uuid::now_v7(),
+                revision: 1,
+                thread_id: context.thread_id,
+                turn_id: context.turn_id,
+                response_id: None,
+                request_kind: context.request_kind,
+                requested_model: context.requested_model,
+                served_model: None,
+                reasoning_effort: context.reasoning_effort,
+                started_at,
+                ttfb_ms: None,
+                ttfc_ms: None,
+                terminal_observed_offset_ms: None,
+                elapsed_ms: millis(now.duration_since(started)),
+                sent_payload_bytes: None,
+                received_payload_bytes: 0,
+                end_reason: None,
+                tokens: ResponseTokenCounts::default(),
+                tps: None,
+            },
+            started,
+            sent: None,
+            terminal: None,
+            notified: now,
+        }
+    }
+
+    fn snapshot(&self) -> ResponseAttempt {
+        let mut record = self.record.clone();
+        if record.end_reason.is_none() {
+            record.elapsed_ms = self
+                .terminal
+                .map(|at| millis(at.duration_since(self.started)))
+                .unwrap_or_else(|| {
+                    millis(Instant::now().duration_since(self.started)).max(record.elapsed_ms)
+                });
+            // Billing facts become public with the validated terminal, while
+            // the official response ID and transport progress remain available.
+            record.served_model = None;
+            record.tokens = ResponseTokenCounts::default();
+            record.tps = None;
+        }
+        record
+    }
+
+    fn received(&mut self, observation: ResponseObservation, at: Instant) -> bool {
+        if let Some(model) = observation.served_model {
+            self.record.served_model = Some(model);
+        }
+        let Some(sent) = self.sent else {
+            return false;
+        };
+        let record = &mut self.record;
+        let first_payload = record.ttfb_ms.is_none() && observation.payload_bytes > 0;
+        let first_content = record.ttfc_ms.is_none() && observation.has_content;
+        record.elapsed_ms = millis(at.duration_since(self.started));
+        record.received_payload_bytes += observation.payload_bytes;
+        if first_payload {
+            record.ttfb_ms = Some(millis(at.duration_since(sent)));
+        }
+        if first_content {
+            record.ttfc_ms = Some(millis(at.duration_since(sent)));
+        }
+        if let Some(id) = observation.response_id {
+            record.response_id = Some(id);
+        }
+        if let Some(usage) = observation.usage {
+            let window = at.duration_since(sent);
+            record.tokens = token_counts(&usage);
+            record.tps = record.tokens.output.and_then(|tokens| {
+                let rate = tokens as f64 / window.as_secs_f64();
+                (window > Duration::ZERO && rate.is_finite()).then_some(rate)
+            });
+        }
+        if let Some(terminal) = observation.terminal {
+            self.terminal = Some(at);
+            record.terminal_observed_offset_ms = Some(millis(at.duration_since(sent)));
+            if terminal != ResponseAttemptEnd::Completed {
+                record.end_reason = Some(terminal);
+            }
+        }
+        if first_payload
+            || first_content
+            || observation.terminal.is_some()
+            || at.duration_since(self.notified) >= Duration::from_millis(100)
+        {
+            self.notified = at;
+            true
+        } else {
+            false
+        }
+    }
+}
+
+impl ResponseAttemptTracker {
+    fn update(&self, update: impl FnOnce(&mut AttemptState) -> bool) {
+        let mut state = self.state.lock().expect("response attempt lock");
+        if state.record.end_reason.is_some() {
+            return;
+        }
+        state.record.revision += 1;
+        if update(&mut state) {
+            // Consumers receive snapshots, never tracker locks. Keeping this
+            // lock through publication preserves each attempt's revision order.
+            self.metrics.publish(&state);
+        }
+    }
+
+    pub(crate) fn configured(&self, request: &codex_api::ResponsesApiRequest) {
+        self.update(|state| {
+            state.record.requested_model.clone_from(&request.model);
+            state.record.reasoning_effort = request
+                .reasoning
+                .as_ref()
+                .and_then(|reasoning| reasoning.effort.as_ref())
+                .map(ToString::to_string);
+            false
+        });
+    }
+}
+
+impl ResponseObserver for ResponseAttemptTracker {
+    fn prepared(&self, payload_bytes: u64) {
+        self.update(|state| {
+            state.record.sent_payload_bytes = Some(payload_bytes);
+            false
+        });
+    }
+
+    fn sent(&self, at: Instant) {
+        self.update(|state| {
+            state.sent = Some(at);
+            state.record.elapsed_ms = millis(at.duration_since(state.started));
+            true
+        });
+    }
+
+    fn received(&self, observation: ResponseObservation, at: Instant) {
+        self.update(|state| state.received(observation, at));
+    }
+
+    fn ended(&self, reason: ResponseAttemptEnd, at: Instant) {
+        self.update(|state| {
+            let elapsed = millis(state.terminal.unwrap_or(at).duration_since(state.started));
+            state.record.end_reason = Some(reason);
+            state.record.elapsed_ms = elapsed;
+            true
+        });
+    }
+}
+
+impl Drop for ResponseAttemptTracker {
+    fn drop(&mut self) {
+        self.ended(ResponseAttemptEnd::Canceled, Instant::now());
+    }
+}
+
+fn millis(duration: Duration) -> u64 {
+    duration.as_millis().try_into().unwrap_or(u64::MAX)
+}
+
+fn token_counts(usage: &Value) -> ResponseTokenCounts {
+    let input = usage.get("input_tokens").and_then(Value::as_u64);
+    let output = usage.get("output_tokens").and_then(Value::as_u64);
+    // Native optional details default to zero, but missing totals or invalid
+    // reported values cannot establish a zero token count.
+    let (cache_read, cache_write) = if input.is_some() {
+        match usage.get("input_tokens_details") {
+            None | Some(Value::Null) => (Some(0), Some(0)),
+            Some(Value::Object(details)) => (
+                details.get("cached_tokens").and_then(Value::as_u64),
+                details
+                    .get("cache_write_tokens")
+                    .map_or(Some(0), Value::as_u64),
+            ),
+            _ => (None, None),
+        }
+    } else {
+        (None, None)
+    };
+    let reasoning = if output.is_some() {
+        match usage.get("output_tokens_details") {
+            None | Some(Value::Null) => Some(0),
+            Some(details) => details.get("reasoning_tokens").and_then(Value::as_u64),
+        }
+    } else {
+        None
+    };
+    ResponseTokenCounts {
+        input,
+        cache_read,
+        cache_write,
+        output,
+        reasoning,
+    }
+}
+
+#[cfg(test)]
+#[path = "response_metrics_tests.rs"]
+mod tests;
