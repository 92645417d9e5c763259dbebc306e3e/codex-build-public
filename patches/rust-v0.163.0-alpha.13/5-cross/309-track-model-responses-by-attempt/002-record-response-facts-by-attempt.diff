+use super::*;
+use pretty_assertions::assert_eq;
+use serde_json::json;
+use std::sync::mpsc;
+
+fn recording() -> (Arc<ResponseMetrics>, mpsc::Receiver<ResponseAttempt>) {
+    let (sender, receiver) = mpsc::channel();
+    let metrics = Arc::new(ResponseMetrics::new(move |record| {
+        sender.send(record).unwrap();
+    }));
+    (metrics, receiver)
+}
+
+fn context() -> ResponseAttemptContext {
+    ResponseAttemptContext {
+        thread_id: Some(ThreadId::new()),
+        turn_id: Some("turn-1".into()),
+        request_kind: "generation".into(),
+        requested_model: "model".into(),
+        reasoning_effort: None,
+    }
+}
+
+#[tokio::test(start_paused = true)]
+async fn live_progress_and_final_tokens_share_the_transport_clock() {
+    let (metrics, updates) = recording();
+    let attempt = metrics.start(context(), Instant::now(), 1000);
+    tokio::time::advance(Duration::from_secs(2)).await;
+    attempt.sent(Instant::now());
+    tokio::time::advance(Duration::from_millis(300)).await;
+    attempt.received(
+        ResponseObservation {
+            payload_bytes: 100,
+            ..Default::default()
+        },
+        Instant::now(),
+    );
+    tokio::time::advance(Duration::from_millis(8700)).await;
+    attempt.received(
+        ResponseObservation {
+            payload_bytes: 150,
+            has_content: true,
+            served_model: Some("served-model".into()),
+            usage: Some(json!({"output_tokens": 100})),
+            ..Default::default()
+        },
+        Instant::now(),
+    );
+    let live = updates.try_iter().last().unwrap();
+    assert_eq!(
+        (live.ttfb_ms, live.ttfc_ms, live.received_payload_bytes),
+        (Some(300), Some(9000), 250)
+    );
+    assert_eq!(live.tokens, ResponseTokenCounts::default());
+    assert_eq!((live.tps, live.served_model), (None, None));
+    tokio::time::advance(Duration::from_secs(1)).await;
+    let usage = json!({"input_tokens": 100, "input_tokens_details": {"cached_tokens": 60, "cache_write_tokens": 10},
+        "output_tokens": 200, "output_tokens_details": {"reasoning_tokens": 180}});
+    attempt.received(
+        ResponseObservation {
+            payload_bytes: 200,
+            response_id: Some("response-1".into()),
+            usage: Some(usage.clone()),
+            terminal: Some(ResponseAttemptEnd::Completed),
+            ..Default::default()
+        },
+        Instant::now(),
+    );
+    let terminal = updates.try_iter().last().unwrap();
+    assert_eq!(terminal.elapsed_ms, 12000);
+    assert_eq!(terminal.end_reason, None);
+    assert_eq!(terminal.tokens, ResponseTokenCounts::default());
+    tokio::time::advance(Duration::from_secs(30)).await;
+    attempt.ended(ResponseAttemptEnd::Completed, Instant::now());
+    let row = updates.try_recv().unwrap();
+    assert_eq!(row.elapsed_ms, 12000);
+    assert_eq!(
+        (row.ttfb_ms, row.ttfc_ms, row.tps),
+        (Some(300), Some(9000), Some(20.0))
+    );
+    assert_eq!(
+        row.tokens,
+        ResponseTokenCounts {
+            input: Some(100),
+            cache_read: Some(60),
+            cache_write: Some(10),
+            output: Some(200),
+            reasoning: Some(180),
+        }
+    );
+    assert_eq!(row.received_payload_bytes, 450);
+    assert_eq!(row.served_model.as_deref(), Some("served-model"));
+    drop(attempt);
+    assert!(updates.try_recv().is_err());
+}
+
+#[tokio::test(start_paused = true)]
+async fn failed_partial_usage_and_retries_are_distinct_records() {
+    let (metrics, updates) = recording();
+    let first_context = context();
+    let retry_context = ResponseAttemptContext {
+        thread_id: first_context.thread_id,
+        ..context()
+    };
+    let attempt = metrics.start(first_context, Instant::now(), 1000);
+    attempt.sent(Instant::now());
+    tokio::time::advance(Duration::from_secs(5)).await;
+    attempt.received(
+        ResponseObservation {
+            has_content: true,
+            usage: Some(json!({"output_tokens": 100})),
+            ..Default::default()
+        },
+        Instant::now(),
+    );
+    tokio::time::advance(Duration::from_secs(300)).await;
+    attempt.ended(ResponseAttemptEnd::ProgressTimeout, Instant::now());
+    let retry = metrics.start(retry_context, Instant::now(), 1305);
+    tokio::time::advance(Duration::from_secs(1)).await;
+    retry.ended(ResponseAttemptEnd::SetupFailed, Instant::now());
+    let rows: Vec<_> = updates
+        .try_iter()
+        .filter(|row| row.end_reason.is_some())
+        .collect();
+    assert_eq!(rows.len(), 2);
+    assert_ne!(rows[0].attempt_id, rows[1].attempt_id);
+    assert_eq!(rows[1].tokens, ResponseTokenCounts::default());
+    assert_eq!(rows[0].thread_id, rows[1].thread_id);
+    assert_eq!(rows[0].turn_id, rows[1].turn_id);
+    assert_eq!(
+        (rows[0].ttfc_ms, rows[0].tps, rows[0].elapsed_ms),
+        (Some(5000), Some(20.0), 305000)
+    );
+    assert_eq!(rows[0].tokens.output, Some(100));
+    attempt.ended(ResponseAttemptEnd::Canceled, Instant::now());
+    assert!(updates.try_recv().is_err());
+}
+
+#[tokio::test]
+async fn published_snapshots_do_not_keep_trackers_alive() {
+    let (metrics, updates) = recording();
+    let attempt = metrics.start(context(), Instant::now(), 1000);
+    let initial = updates.try_recv().unwrap();
+    drop(attempt);
+    let final_record = updates.try_recv().unwrap();
+    assert_eq!(final_record.attempt_id, initial.attempt_id);
+    assert_eq!(final_record.end_reason, Some(ResponseAttemptEnd::Canceled));
+    assert!(final_record.revision > initial.revision);
+}
+
+#[test]
+fn usage_preserves_known_zero_and_unknown_totals() {
+    assert_eq!(token_counts(&json!({})), ResponseTokenCounts::default());
+    assert_eq!(
+        token_counts(&json!({"input_tokens": 100, "output_tokens": 0})),
+        ResponseTokenCounts {
+            input: Some(100),
+            cache_read: Some(0),
+            cache_write: Some(0),
+            output: Some(0),
+            reasoning: Some(0),
+        }
+    );
+    let invalid = token_counts(
+        &json!({"input_tokens": 100, "input_tokens_details": {"cached_tokens": -1, "cache_write_tokens": null}}),
+    );
+    assert_eq!(
+        (invalid.cache_read, invalid.cache_write, invalid.output),
+        (None, None, None)
+    );
+}
+
+#[tokio::test]
+async fn live_records_expose_the_official_id_and_payload_size_without_request_content() {
+    let (metrics, updates) = recording();
+    let attempt = metrics.start(context(), Instant::now(), 1000);
+    let request = r#"{"input":"private message"}"#;
+    attempt.prepared(request.len() as u64);
+    attempt.sent(Instant::now());
+    assert_eq!(updates.try_iter().last().unwrap().response_id, None);
+    attempt.received(
+        ResponseObservation {
+            response_id: Some("resp-provider".into()),
+            payload_bytes: 20,
+            ..Default::default()
+        },
+        Instant::now(),
+    );
+    let row = updates.try_recv().unwrap();
+    assert_eq!(row.sent_payload_bytes, Some(request.len() as u64));
+    assert_eq!(row.response_id.as_deref(), Some("resp-provider"));
+    assert_eq!(row.end_reason, None);
+    assert!(!serde_json::to_string(&row).unwrap().contains("private"));
+    let published = serde_json::to_value(&row).unwrap();
+    assert!(published.get("provider").is_none());
+    assert!(published.get("accountId").is_none());
+    assert!(published.get("rateLimits").is_none());
+    assert!(published.get("usageObservedSequence").is_none());
+}
+
+#[tokio::test]
+async fn sessionless_responses_are_recorded_without_inventing_attribution() {
+    let (metrics, updates) = recording();
+    let mut context = context();
+    context.thread_id = None;
+    context.turn_id = None;
+    context.request_kind = "probe".into();
+    let attempt = metrics.start(context, Instant::now(), 1000);
+    attempt.sent(Instant::now());
+    attempt.ended(ResponseAttemptEnd::Completed, Instant::now());
+    let rows: Vec<_> = updates
+        .try_iter()
+        .filter(|row| row.end_reason.is_some())
+        .collect();
+    assert_eq!(rows.len(), 1);
+    assert_eq!(rows[0].thread_id, None);
+    assert_eq!(rows[0].turn_id, None);
+    assert_eq!(rows[0].request_kind, "probe");
+    let wire = serde_json::to_value(&rows[0]).unwrap();
+    assert!(wire["threadId"].is_null());
+    assert!(wire["turnId"].is_null());
+}
+
+#[tokio::test(start_paused = true)]
+async fn publications_have_ordered_revisions_and_frozen_terminals() {
+    let (metrics, updates) = recording();
+    let attempt = metrics.start(context(), Instant::now(), 1000);
+    attempt.sent(Instant::now());
+    tokio::time::advance(Duration::from_secs(1)).await;
+    attempt.received(
+        ResponseObservation {
+            payload_bytes: 100,
+            usage: Some(json!({"input_tokens": 0, "output_tokens": 0})),
+            terminal: Some(ResponseAttemptEnd::Failed),
+            ..Default::default()
+        },
+        Instant::now(),
+    );
+    tokio::time::advance(Duration::from_secs(10)).await;
+    drop(attempt);
+    let rows: Vec<_> = updates.try_iter().collect();
+    assert!(
+        rows.windows(2)
+            .all(|pair| pair[0].revision < pair[1].revision)
+    );
+    assert!(rows.iter().all(|row| row.attempt_id == rows[0].attempt_id));
+    let row = rows.last().unwrap();
+    assert_eq!(row.elapsed_ms, 1000);
+    assert_eq!(row.tokens.output, Some(0));
+    assert_eq!(row.tps, Some(0.0));
+    assert_eq!(row.end_reason, Some(ResponseAttemptEnd::Failed));
+}
