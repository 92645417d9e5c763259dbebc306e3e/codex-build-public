diff --git a/codex-rs/tui/src/bottom_pane/custom_prompt_view_tests.rs b/codex-rs/tui/src/bottom_pane/custom_prompt_view_tests.rs
--- a/codex-rs/tui/src/bottom_pane/custom_prompt_view_tests.rs
+++ b/codex-rs/tui/src/bottom_pane/custom_prompt_view_tests.rs
@@ -5,6 +5,38 @@ use crate::keymap::RuntimeKeymap;
 use pretty_assertions::assert_eq;
 use std::sync::mpsc::Receiver;
 
+#[test]
+fn masked_prompt_keeps_input_private_and_submits_the_original_text() {
+    let (tx, rx) = std::sync::mpsc::channel();
+    let mut view = CustomPromptView::new_masked(
+        "Credential".into(),
+        "Enter credential".into(),
+        None,
+        Box::new(move |value| tx.send(value).unwrap()),
+    );
+    let secret = "private-first-line\nprivate-second-line";
+    view.handle_paste(secret.into());
+    for (width, height) in [(80, 12), (24, 8)] {
+        let area = Rect::new(0, 0, width, height);
+        let mut buffer = Buffer::empty(area);
+        view.render(area, &mut buffer);
+        let painted = buffer
+            .content
+            .iter()
+            .map(|cell| cell.symbol())
+            .collect::<String>();
+        assert!(!painted.contains("private"));
+        assert!(painted.contains("***"));
+        let (x, y) = view
+            .cursor_pos(area)
+            .expect("masked editor keeps its cursor");
+        assert!(area.contains((x, y).into()));
+    }
+    view.handle_key_event(KeyEvent::from(KeyCode::Enter));
+    assert_eq!(rx.try_recv(), Ok(secret.into()));
+    assert_eq!(view.completion(), Some(ViewCompletion::Accepted));
+}
