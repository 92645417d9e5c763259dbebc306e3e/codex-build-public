@@ -0,0 +1,61 @@
+//! Native settings views for the Control Center and its feature consumers.
+//!
+//! Control Center supplies current preferences without borrowing the ordinary input-area
+//! host. Native text and list widgets retain their editing and selection behavior.
+
+use crate::app_event_sender::AppEventSender;
+use crate::bottom_pane::ListSelectionView;
+use crate::bottom_pane::SelectionViewParams;
+use crate::bottom_pane::custom_prompt_view::CustomPromptView;
+use crate::bottom_pane::popup_consts;
+use crate::keymap::RuntimeKeymap;
+use crate::tui::FrameRequester;
+use crossterm::event::KeyEvent;
+
+/// Borrow current host resources when constructing a view; an open view owns its input state.
+pub(crate) struct DialogResources<'a> {
+    pub(crate) app_event_tx: &'a AppEventSender,
+    pub(crate) keymap: &'a RuntimeKeymap,
+    pub(crate) frame_requester: &'a FrameRequester,
+    pub(crate) vim_enabled: bool,
+}
+
+impl DialogResources<'_> {
+    pub(crate) fn selection_view(&self, mut params: SelectionViewParams) -> ListSelectionView {
+        self.apply_standard_popup_hint(&mut params);
+        ListSelectionView::new(params, self.app_event_tx.clone(), self.keymap.list.clone())
+    }
+
+    fn apply_standard_popup_hint(&self, params: &mut SelectionViewParams) {
+        // Configured list actions take precedence over optional row shortcuts.
+        for item in &mut params.items {
+            if item.secondary_action.as_ref().is_some_and(|secondary| {
+                let (code, modifiers) = secondary.key.parts();
+                self.keymap
+                    .list
+                    .action_for(KeyEvent::new(code, modifiers))
+                    .is_some()
+            }) {
+                item.secondary_action = None;
+            }
+        }
+        if params.footer_hint.is_none()
+            || params.footer_hint.as_ref() == Some(&popup_consts::standard_popup_hint_line())
+        {
+            params.footer_hint = params
+                .allow_cancel
+                .then(|| popup_consts::picker_hint_line_for_keymap(&self.keymap.list));
+        }
+    }
+
+    pub(crate) fn text_prompt(&self, mut view: CustomPromptView) -> CustomPromptView {
+        view.set_keymap_bindings(self.keymap);
+        if self.vim_enabled {
+            view.enable_vim_in_insert_mode();
+        }
+        view
+    }
+}
+
+#[cfg(test)]
+mod tests;
