+    pub(crate) fn response_performance(
+        &self,
+    ) -> Option<&codex_protocol::response_metrics::ResponsePerformance> {
+        self.response_timing.last_performance()
+    }
+
+    pub(crate) fn on_response_attempt_updated(
+        &mut self,
+        attempt: codex_protocol::response_metrics::ResponseAttempt,
+    ) {
+        let Some(thread_id) = self.thread_id else {
+            return;
+        };
+        if attempt.thread_id != Some(thread_id) {
+            return;
+        }
+        self.response_timing.update(attempt, true, Instant::now());
+        self.refresh_response_status();
+        self.request_redraw();
+    }
+
+    pub(crate) fn on_response_attempts_loaded(
+        &mut self,
+        page: codex_app_server_protocol::ResponseAttemptsReadResponse,
+        requested_at: Instant,
+    ) {
+        let Some(thread_id) = self.thread_id else {
+            return;
+        };
+        if let Some(last) = page.last_generation
+            && last.thread_id == Some(thread_id)
+        {
+            self.response_timing.restore_performance(last);
+        }
+        let observed_at = Instant::now();
+        for row in page.data {
+            if row.thread_id == Some(thread_id) {
+                let active = page.active_attempt_ids.contains(&row.attempt_id);
+                self.response_timing
+                    .snapshot(row, active, requested_at, observed_at);
+            }
+        }
+        self.refresh_response_status();
+        self.request_redraw();
+    }
+
+    pub(super) fn refresh_response_status(&mut self) {
+        let attempt = self.response_timing.latest().filter(|attempt| {
+            self.local_settings.tui.fullscreen_transcript
+                && self.turn_lifecycle.agent_turn_running
+                && attempt.is_receiving()
+                && (self.turn_lifecycle.last_turn_id.is_none()
+                    || attempt.row.turn_id == self.turn_lifecycle.last_turn_id)
+        });
+        self.bottom_pane
+            .set_response_progress(attempt.map(crate::response_timing::ObservedResponse::progress));
+    }
