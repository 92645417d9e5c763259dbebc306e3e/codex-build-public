+use super::*;
+use crate::response_timing::tests::attempt;
+use crate::response_timing::tests::page;
+use codex_app_server_protocol::ResponseAttemptUpdatedNotification;
+use codex_protocol::response_metrics::ResponseAttempt;
+use codex_protocol::response_metrics::ResponseAttemptEnd;
+use codex_protocol::response_metrics::ResponsePerformance;
+use pretty_assertions::assert_eq;
+
+fn notify(chat: &mut ChatWidget, attempt: ResponseAttempt) {
+    chat.handle_server_notification(
+        ServerNotification::ResponseAttemptUpdated(ResponseAttemptUpdatedNotification {
+            thread_id: attempt.thread_id.map(|id| id.to_string()),
+            attempt,
+        }),
+        None,
+    );
+}
+
+#[tokio::test]
+async fn response_notifications_preserve_last_generation_and_filter_other_threads() {
+    let (mut chat, _rx, _ops) = make_chatwidget_manual(None).await;
+    chat.local_settings.tui.fullscreen_transcript = true;
+    let mut unscoped = attempt(4, Some(ResponseAttemptEnd::Completed));
+    unscoped.thread_id = None;
+    unscoped.ttfc_ms = Some(9000);
+    chat.thread_id = None;
+    notify(&mut chat, unscoped.clone());
+    chat.on_response_attempts_loaded(page(vec![unscoped.clone()]), Instant::now());
+    assert!(chat.response_timing.latest().is_none());
+    assert_eq!(chat.response_performance(), None);
+    let completed = attempt(1, Some(ResponseAttemptEnd::Completed));
+    let expected = ResponsePerformance::from(&completed);
+    chat.thread_id = completed.thread_id;
+    notify(&mut chat, completed);
+    assert_eq!(chat.response_performance(), Some(&expected));
+    notify(&mut chat, attempt(2, None));
+    assert_eq!(chat.response_performance(), Some(&expected));
+    assert!(chat.response_timing.latest().unwrap().is_receiving());
+    let mut other = attempt(3, Some(ResponseAttemptEnd::Completed));
+    other.thread_id = Some(ThreadId::new());
+    other.ttfc_ms = Some(9000);
+    notify(&mut chat, other);
+    notify(&mut chat, unscoped.clone());
+    chat.on_response_attempts_loaded(page(vec![unscoped]), Instant::now());
+    assert_eq!(chat.response_performance(), Some(&expected));
+    let mut failed = attempt(2, Some(ResponseAttemptEnd::ProgressTimeout));
+    failed.revision += 1;
+    failed.ttfc_ms = None;
+    failed.tps = None;
+    let expected = ResponsePerformance::from(&failed);
+    notify(&mut chat, failed);
+    assert_eq!(chat.response_performance(), Some(&expected));
+    assert!(!chat.response_timing.latest().unwrap().is_receiving());
+}
