+    chat.bottom_pane.hide_status_indicator();
+    chat.bottom_pane.ensure_status_indicator();
+    chat.pre_draw_tick();
+    assert!(!render(&chat).contains("Received"));
+    running.revision += 1;
+    running.end_reason = Some(ResponseAttemptEnd::Completed);
+    notify(&mut chat, running);
+    let mut next = attempt(2, None);
+    next.elapsed_ms = 100;
+    next.received_payload_bytes = 1024;
+    notify(&mut chat, next.clone());
+    assert!(render(&chat).ends_with("Received 1.0KiB · 42s"));
+    let last = chat.response_performance().cloned();
+    handle_turn_started(&mut chat, "turn-2");
+    chat.pre_draw_tick();
+    assert!(chat.response_timing.latest().is_none());
+    assert_eq!(chat.response_performance(), last.as_ref());
+    assert!(!render(&chat).contains("Received"));
+    notify(&mut chat, next);
+    assert!(!render(&chat).contains("Received"));
+    let mut current = attempt(3, None);
+    current.turn_id = Some("turn-2".into());
+    current.received_payload_bytes = 2048;
+    notify(&mut chat, current);
+    assert!(render(&chat).contains("Received 2.0KiB"));
+    chat.on_interrupted_turn(TurnAbortReason::Interrupted);
+    assert!(!chat.bottom_pane.status_indicator_visible());
+}
+
+#[tokio::test]
+async fn retained_page_restores_performance_without_reviving_unfinished_records() {
+    let (mut chat, _rx, _ops) = make_chatwidget_manual(None).await;
+    chat.thread_id = attempt(1, None).thread_id;
+    let mut running = attempt(2000, None);
+    running.request_kind = "memory".into();
+    let mut snapshot = page(vec![running.clone()]);
+    snapshot.active_attempt_ids.clear();
+    snapshot.last_generation = Some((&attempt(1, Some(ResponseAttemptEnd::Completed))).into());
+    let requested_at = Instant::now();
+    notify(&mut chat, running);
+    chat.on_response_attempts_loaded(snapshot.clone(), requested_at);
+    assert!(chat.response_timing.latest().unwrap().is_running());
+    assert_eq!(
+        chat.response_performance(),
+        snapshot.last_generation.as_ref()
+    );
+    chat.on_response_attempts_loaded(snapshot, Instant::now());
+    let historical = chat.response_timing.latest().unwrap();
+    assert!(!historical.is_running());
+    assert_eq!(historical.row.end_reason, None);
+    assert_eq!(
+        historical.elapsed_ms(Instant::now() + Duration::from_secs(60)),
+        2100
+    );
+}
