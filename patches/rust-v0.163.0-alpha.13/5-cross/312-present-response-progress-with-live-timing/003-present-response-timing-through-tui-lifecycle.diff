+#[tokio::test]
+async fn response_timing_routes_live_notifications_and_refreshes_each_selected_thread() -> Result<()>
+{
+    use crate::response_timing::tests::attempt;
+    use codex_app_server_protocol::ResponseAttemptUpdatedNotification;
+    use codex_protocol::response_metrics::ResponseAttemptEnd;
+
+    let (mut app, mut events, _ops) = make_test_app_with_channels().await;
+    let server = crate::start_embedded_app_server_for_picker(&app.config).await?;
+    let completed = attempt(1, Some(ResponseAttemptEnd::Completed));
+    let performance = codex_protocol::response_metrics::ResponsePerformance::from(&completed);
+    let thread_id = completed.thread_id.unwrap();
+    app.chat_widget
+        .handle_thread_session(test_thread_session(thread_id, app.config.cwd.to_path_buf()));
+    assert!(std::iter::from_fn(|| events.try_recv().ok()).any(|event| matches!(event, AppEvent::RefreshResponseTiming { thread_id: id } if id == thread_id)));
+    app.handle_app_server_event(
+        &server,
+        AppServerEvent::ServerNotification(Box::new(ServerNotification::ResponseAttemptUpdated(
+            ResponseAttemptUpdatedNotification {
+                thread_id: Some(thread_id.to_string()),
+                attempt: completed,
+            },
+        ))),
+    )
+    .await;
+    assert_eq!(app.chat_widget.response_performance(), Some(&performance));
+    let other = ThreadId::new();
+    app.chat_widget
+        .handle_thread_session(test_thread_session(other, app.config.cwd.to_path_buf()));
+    assert!(std::iter::from_fn(|| events.try_recv().ok()).any(
+        |event| matches!(event, AppEvent::RefreshResponseTiming { thread_id: id } if id == other)
+    ));
+    assert_eq!(app.chat_widget.response_performance(), None);
+    app.refresh_response_timing(&server, other);
+    let loaded = tokio::time::timeout(Duration::from_secs(10), async {
+        loop {
+            if let Some(AppEvent::ResponseTimingLoaded {
+                thread_id, result, ..
+            }) = events.recv().await
+            {
+                break (thread_id, result);
+            }
+        }
+    })
+    .await?;
+    assert_eq!(loaded.0, other);
+    assert!(
+        loaded
+            .1
+            .map_err(color_eyre::eyre::Report::msg)?
+            .data
+            .is_empty()
+    );
+    server.shutdown().await?;
+    Ok(())
+}
