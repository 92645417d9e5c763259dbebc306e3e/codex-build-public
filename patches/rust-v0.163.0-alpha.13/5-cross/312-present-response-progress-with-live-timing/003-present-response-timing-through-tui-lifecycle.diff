+//! Restore the selected thread's response observations through the shared page API.
+
+use super::App;
+use crate::app_event::AppEvent;
+use crate::app_server_session::AppServerSession;
+use codex_app_server_protocol::ClientRequest;
+use codex_app_server_protocol::RequestId;
+use codex_app_server_protocol::ResponseAttemptsReadParams;
+use codex_protocol::ThreadId;
+use std::time::Instant;
+use uuid::Uuid;
+
+impl App {
+    pub(super) fn refresh_response_timing(
+        &self,
+        app_server: &AppServerSession,
+        thread_id: ThreadId,
+    ) {
+        let handle = app_server.request_handle();
+        let events = self.app_event_tx.clone();
+        let requested_at = Instant::now();
+        tokio::spawn(async move {
+            let result = handle
+                .request_typed(ClientRequest::ResponseAttemptsRead {
+                    request_id: RequestId::String(Uuid::new_v4().to_string()),
+                    params: ResponseAttemptsReadParams {
+                        thread_id: Some(thread_id.to_string()),
+                        ..Default::default()
+                    },
+                })
+                .await
+                .map_err(|error| error.to_string());
+            events.send(AppEvent::ResponseTimingLoaded {
+                thread_id,
+                requested_at,
+                result,
+            });
+        });
+    }
+}
