+#[tokio::test]
+async fn active_turn_clock_survives_parent_agent_replay_and_steer() {
+    let now = chrono::Utc::now().timestamp();
+    for (turn_id, started, live) in [
+        ("parent-turn", now - 125, true),
+        ("agent-turn", now - 30, false),
+        ("parent-turn", now - 125, false),
+    ] {
+        let (mut chat, _events, mut ops) = make_chatwidget_manual(None).await;
+        let thread_id = ThreadId::new();
+        chat.thread_id = Some(thread_id);
+        let mut turn = app_server_turn(turn_id, AppServerTurnStatus::InProgress, None, None);
+        turn.started_at = Some(started);
+        if live {
+            chat.handle_server_notification(
+                ServerNotification::TurnStarted(TurnStartedNotification {
+                    thread_id: thread_id.to_string(),
+                    turn: turn.clone(),
+                }),
+                None,
+            );
+        } else {
+            chat.replay_thread_turns(vec![turn.clone()], ReplayKind::ThreadSnapshot);
+        }
+        let minimum = u64::try_from(now - started).unwrap();
+        let elapsed = chat.bottom_pane.status_elapsed().expect("active clock");
+        assert!(elapsed.as_secs() >= minimum && elapsed.as_secs() < minimum + 10);
+        let status = render_bottom_popup(&chat, 100);
+        assert!(
+            status.contains(&crate::status_indicator_widget::fmt_elapsed_compact(
+                elapsed.as_secs()
+            )),
+            "{status}"
+        );
+        while ops.try_recv().is_ok() {}
+        chat.submit_user_message(UserMessage::from("Continue this same turn"));
+        assert!(matches!(next_submit_op(&mut ops), Op::UserTurn { .. }));
+        assert_eq!(chat.turn_lifecycle.last_turn_id.as_deref(), Some(turn_id));
+        assert!(!chat.input_queue.pending_steers.is_empty());
+        assert!(chat.bottom_pane.status_elapsed().unwrap() >= elapsed);
+        turn.status = AppServerTurnStatus::Completed;
+        turn.completed_at = Some(started + 150);
+        turn.duration_ms = Some(150_000);
+        complete_turn(&mut chat, turn);
+        assert!(chat.bottom_pane.status_elapsed().is_none());
+        handle_turn_started(&mut chat, "next-turn");
+        assert!(chat.bottom_pane.status_elapsed().unwrap().as_secs() < 10);
+    }
+}
