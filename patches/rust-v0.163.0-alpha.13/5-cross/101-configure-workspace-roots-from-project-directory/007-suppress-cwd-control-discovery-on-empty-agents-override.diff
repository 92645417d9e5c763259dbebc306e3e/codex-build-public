+/// Whether the entered directory explicitly disables its local control roots.
+pub async fn has_empty_agents_override(
+    fs: &dyn ExecutorFileSystem,
+    cwd: &AbsolutePathBuf,
+) -> io::Result<bool> {
+    let path = cwd.join("AGENTS.override.md");
+    let uri = PathUri::from_abs_path(&path);
+    match fs
+        .get_metadata(&uri, Default::default(), /*sandbox*/ None)
+        .await
+    {
+        Ok(metadata) => Ok(metadata.is_file && metadata.size == 0),
+        Err(error) if error.kind() == io::ErrorKind::NotFound => Ok(false),
+        Err(error) => Err(error),
+    }
+}
