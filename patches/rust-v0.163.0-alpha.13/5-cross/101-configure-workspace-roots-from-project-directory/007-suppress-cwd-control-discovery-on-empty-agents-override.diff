+#[tokio::test]
+async fn empty_cwd_override_suppresses_only_cwd_control_skills() {
+    let temp_dir = TempDir::new().expect("temp dir");
+    let repository = absolute(temp_dir.path().join("repo"));
+    let cwd = repository.join("nested");
+    fs::create_dir_all(&cwd).expect("create cwd");
+    fs::write(repository.join(".git"), "gitdir: fake\n").expect("write git marker");
+    for root in [
+        repository.join(".codex/skills"),
+        repository.join(".agents/skills"),
+        cwd.join(".codex/skills"),
+        cwd.join(".agents/skills"),
+    ] {
+        fs::create_dir_all(&root).expect("create skill root");
+    }
+    let config_stack = stack(vec![
+        project_layer(&repository.join(".codex")),
+        project_layer(&cwd.join(".codex")),
+    ]);
+    let override_file = cwd.join("AGENTS.override.md");
+    fs::write(&override_file, "").expect("write empty override");
+
+    let roots = resolve_skill_roots_with_home_dir(
+        Some(Arc::clone(&LOCAL_FS)),
+        &config_stack,
+        &cwd,
+        /*home_dir*/ None,
+        Vec::new(),
+        Vec::new(),
+    )
+    .await;
+    let paths = roots.into_iter().map(|root| root.path).collect::<Vec<_>>();
+    assert!(paths.contains(&repository.join(".codex/skills")));
+    assert!(paths.contains(&repository.join(".agents/skills")));
+    assert!(!paths.contains(&cwd.join(".codex/skills")));
+    assert!(!paths.contains(&cwd.join(".agents/skills")));
+
+    fs::write(&override_file, "local instructions").expect("write nonempty override");
+    let roots = resolve_skill_roots_with_home_dir(
+        Some(Arc::clone(&LOCAL_FS)),
+        &config_stack,
+        &cwd,
+        /*home_dir*/ None,
+        Vec::new(),
+        Vec::new(),
+    )
+    .await;
+    let paths = roots.into_iter().map(|root| root.path).collect::<Vec<_>>();
+    assert!(paths.contains(&cwd.join(".codex/skills")));
+    assert!(paths.contains(&cwd.join(".agents/skills")));
+}
