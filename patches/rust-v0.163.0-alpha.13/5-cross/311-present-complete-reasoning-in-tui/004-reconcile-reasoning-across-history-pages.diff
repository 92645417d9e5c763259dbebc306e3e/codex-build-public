+#[tokio::test]
+async fn older_reasoning_reprojects_loaded_duplicates_without_crossing_turns() {
+    let mut app = make_test_app().await;
+    let cwd = app.config.cwd.clone();
+    let thread_id = ThreadId::new();
+    let reasoning = |id: &str, text: &str| ThreadItem::Reasoning {
+        id: id.into(),
+        summary: vec![text.into()],
+        content: Vec::new(),
+    };
+    let mut first = turn("first", TurnStatus::Completed, &[]);
+    first.items = vec![
+        reasoning("older", "## Inspect\n\nRetained paragraph."),
+        reasoning("newer", "**Inspect**\n\nRetained paragraph.\n\nNew detail."),
+    ];
+    let mut second = turn("second", TurnStatus::Completed, &[]);
+    second.items = vec![reasoning("next-turn", "**Inspect**\n\nRetained paragraph.")];
+    for item in first.items.iter().chain(&second.items) {
+        app.transcript_cells
+            .extend(thread_items_to_transcript_cells(
+                Some(thread_id),
+                &cwd,
+                [item.clone()],
+                RawReasoningVisibility::Hidden,
+                true,
+                Some(&app.config),
+            ));
+    }
+    let area = ratatui::layout::Rect::new(0, 0, 80, 2);
+    app.transcript_view.jump_to_entry(&app.transcript_cells, 1);
+    let mut before = ratatui::buffer::Buffer::empty(area);
+    app.transcript_view
+        .render(area, &mut before, &app.transcript_cells);
+    use crossterm::event::MouseButton;
+    use crossterm::event::MouseEventKind;
+    for (kind, column) in [
+        (MouseEventKind::Down(MouseButton::Left), 2),
+        (MouseEventKind::Drag(MouseButton::Left), 8),
+        (MouseEventKind::Up(MouseButton::Left), 8),
+    ] {
+        app.transcript_view.handle_mouse(
+            crossterm::event::MouseEvent {
+                kind,
+                column,
+                row: 0,
+                modifiers: crossterm::event::KeyModifiers::NONE,
+            },
+            &app.transcript_cells,
+        );
+    }
+    let selected = app.transcript_view.selected_text(&app.transcript_cells);
+    assert!(selected.as_ref().is_some_and(|text| !text.is_empty()));
+    app.transcript_view
+        .render(area, &mut before, &app.transcript_cells);
+    let turns = vec![first, second];
+    app.reproject_loaded_reasoning(&turns, thread_id, &cwd, RawReasoningVisibility::Hidden);
+    let mut after = ratatui::buffer::Buffer::empty(area);
+    app.transcript_view
+        .render(area, &mut after, &app.transcript_cells);
+    assert_eq!(after, before);
+    assert_eq!(
+        app.transcript_view.selected_text(&app.transcript_cells),
+        selected
+    );
+    let sources = app
+        .transcript_cells
+        .iter()
+        .map(|cell| {
+            let reasoning = cell
+                .as_any()
+                .downcast_ref::<history_cell::ReasoningSummaryCell>()
+                .unwrap();
+            (
+                reasoning.source_item_id().unwrap().to_owned(),
+                reasoning.markdown_source().to_owned(),
+            )
+        })
+        .collect::<Vec<_>>();
+    assert_eq!(
+        sources,
+        vec![
+            ("older".into(), "## Inspect\n\nRetained paragraph.".into()),
+            ("newer".into(), "New detail.".into()),
+            (
+                "next-turn".into(),
+                "**Inspect**\n\nRetained paragraph.".into()
+            )
+        ]
+    );
+    let retained = app.transcript_cells.clone();
+    app.reproject_loaded_reasoning(&turns, thread_id, &cwd, RawReasoningVisibility::Hidden);
+    assert!(
+        retained
+            .iter()
+            .zip(&app.transcript_cells)
+            .all(|(before, after)| Arc::ptr_eq(before, after))
+    );
+}
