+#[tokio::test]
+async fn older_reasoning_updates_pending_tool_details_and_later_completions() {
+    let (mut chat, mut rx, _ops) = make_chatwidget_manual(None).await;
+    drain_insert_history(&mut rx);
+    chat.turn_lifecycle.last_turn_id = Some("turn".into());
+    chat.on_task_started();
+    let command = |status: &str| {
+        serde_json::from_value(serde_json::json!({
+        "type": "commandExecution", "id": "pending", "command": "cat source.rs", "cwd": chat.config.cwd,
+        "source": "agent", "status": status,
+        "commandActions": [{"type": "read", "command": "cat source.rs", "name": "source.rs", "path": "source.rs"}],
+        "aggregatedOutput": "Complete command output", "exitCode": 0, "durationMs": 10
+    })).unwrap()
+    };
+    let started = command("inProgress");
+    let completed = command("completed");
+    let reasoning = |id: &str, text: &str| AppServerThreadItem::Reasoning {
+        id: id.into(),
+        summary: vec![text.into()],
+        content: Vec::new(),
+    };
+    let newer = reasoning("newer", "Shared paragraph.\n\nNew detail.");
+    chat.handle_command_execution_started_now(started);
+    chat.replay_thread_item(newer.clone(), "turn".into(), ReplayKind::ThreadSnapshot);
+    let before = chat.active_cell_transcript_lines(80).unwrap();
+    assert!(lines_to_single_string(&before).contains("Shared paragraph."));
+    chat.remember_older_reasoning(&[AppServerTurn {
+        items: vec![reasoning("older", "Shared paragraph."), newer],
+        ..app_server_turn("turn", AppServerTurnStatus::InProgress, None, None)
+    }]);
+    let active = lines_to_single_string(&chat.active_cell_transcript_lines(80).unwrap());
+    assert!(!active.contains("Shared paragraph."));
+    assert!(active.contains("New detail."));
+    chat.handle_command_execution_completed_now(completed);
+    chat.replay_thread_item(
+        reasoning("last", "Shared paragraph."),
+        "turn".into(),
+        ReplayKind::ThreadSnapshot,
+    );
+    let cells = take_history_cells(&mut rx);
+    let rendered = cells
+        .iter()
+        .flat_map(|cell| cell.raw_lines())
+        .map(|line| line.to_string())
+        .collect::<Vec<_>>()
+        .join("\n");
+    assert!(rendered.contains("Complete command output"));
+    assert_eq!(rendered.matches("New detail.").count(), 1);
+    assert!(!rendered.contains("Shared paragraph."));
+}
