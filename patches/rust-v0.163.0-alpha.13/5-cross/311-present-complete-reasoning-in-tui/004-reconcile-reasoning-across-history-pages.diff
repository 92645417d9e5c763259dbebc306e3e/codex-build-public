 use super::*;
 
 impl ChatWidget {
+    /// Older pages can reveal a duplicate before reasoning retained in an active tool group.
+    pub(crate) fn remember_older_reasoning(&mut self, turns: &[Turn]) {
+        if !self.local_settings.tui.fullscreen_transcript {
+            return;
+        }
+        let Some(turn) = turns
+            .iter()
+            .find(|turn| Some(&turn.id) == self.turn_lifecycle.last_turn_id.as_ref())
+        else {
+            return;
+        };
+        let mut seen = std::collections::BTreeSet::new();
+        let mut changed = false;
+        for item in &turn.items {
+            let ThreadItem::Reasoning {
+                id,
+                summary,
+                content,
+            } = item
+            else {
+                continue;
+            };
+            if self.status_state.reasoning_item_id.as_ref() == Some(id)
+                || self.is_realtime_delegated_reasoning_item(&turn.id, id)
+            {
+                continue;
+            }
+            let mut cell = history_cell::new_visible_reasoning_block(
+                summary.iter().chain(
+                    self.config
+                        .show_raw_agent_reasoning
+                        .then_some(content)
+                        .into_iter()
+                        .flatten(),
+                ),
+                self.config.cwd.as_path(),
+                &mut seen,
+            );
+            cell.set_source_item_id(id.clone());
+            if let Some(active) = self.transcript.active_cell.as_mut() {
+                if let Some(exec) = active.as_any_mut().downcast_mut::<ExecCell>() {
+                    changed |= exec.group.details.replace_reasoning(Arc::from(cell));
+                } else if let Some(computer) = active
+                    .as_any_mut()
+                    .downcast_mut::<history_cell::ComputerActivityCell>()
+                {
+                    changed |= computer.group.details.replace_reasoning(Arc::from(cell));
+                }
+            }
+        }
+        self.reasoning_seen_blocks.extend(seen);
+        if changed {
+            self.bump_active_cell_revision();
+        }
+    }
