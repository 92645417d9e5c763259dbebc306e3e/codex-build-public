+    /// Reconcile turn-scoped deduplication when a page reveals an earlier copy of a block.
+    fn reproject_loaded_reasoning(
+        &mut self,
+        turns: &[Turn],
+        thread_id: ThreadId,
+        cwd: &AbsolutePathBuf,
+        visibility: RawReasoningVisibility,
+    ) {
+        if !self.local_settings.tui.fullscreen_transcript {
+            return;
+        }
+        let projected = turns
+            .iter()
+            .flat_map(|turn| {
+                thread_items_to_transcript_cells(
+                    Some(thread_id),
+                    cwd,
+                    turn.items
+                        .iter()
+                        .filter(|item| matches!(item, ThreadItem::Reasoning { .. }))
+                        .cloned(),
+                    visibility,
+                    true,
+                    Some(&self.config),
+                )
+            })
+            .filter_map(|cell| {
+                let id = cell
+                    .as_any()
+                    .downcast_ref::<history_cell::ReasoningSummaryCell>()?
+                    .source_item_id()?
+                    .to_owned();
+                Some((id, cell))
+            })
+            .collect::<std::collections::BTreeMap<_, _>>();
+        for index in 0..self.transcript_cells.len() {
+            let Some(reasoning) = self.transcript_cells[index]
+                .as_any()
+                .downcast_ref::<history_cell::ReasoningSummaryCell>()
