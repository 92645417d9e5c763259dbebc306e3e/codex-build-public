@@ -8,6 +8,51 @@ use codex_config::types::AltScreenMode;
 use pretty_assertions::assert_eq;
 use std::collections::HashSet;
 
+#[tokio::test]
+async fn history_row_budget_reprojects_pages_with_turn_scoped_reasoning() {
+    let home = tempfile::tempdir().unwrap();
+    let config = ConfigBuilder::default()
+        .codex_home(home.path().to_owned())
+        .build()
+        .await
+        .unwrap();
+    let mut settings = LocalSettings::from(&config);
+    settings.tui.fullscreen_transcript = true;
+    let thread_id = codex_protocol::ThreadId::new();
+    let mut thread: codex_app_server_protocol::Thread = serde_json::from_value(serde_json::json!({
+        "id": thread_id.to_string(), "sessionId": thread_id.to_string(), "preview": "", "ephemeral": false,
+        "modelProvider": "openai", "createdAt": 0, "updatedAt": 0, "status": {"type": "idle"},
+        "cwd": config.cwd, "cliVersion": "test", "source": "cli", "turns": []
+    })).unwrap();
+    let reasoning = |id: &str| codex_app_server_protocol::ThreadItem::Reasoning {
+        id: id.into(),
+        summary: vec!["Complete paragraph.".into()],
+        content: Vec::new(),
+    };
+    thread.turns.push(codex_app_server_protocol::Turn {
+        id: "first".into(),
+        root_turn_id: None,
+        items: vec![reasoning("newer")],
+        items_view: codex_app_server_protocol::TurnItemsView::Full,
+        status: codex_app_server_protocol::TurnStatus::Completed,
+        error: None,
+        started_at: None,
+        completed_at: None,
+        duration_ms: None,
+    });
+    let rows = |thread: &codex_app_server_protocol::Thread| {
+        super::rendered_history_rows(thread_id, thread, &config, &settings, 80)
+    };
+    assert_eq!(rows(&thread), 1);
+    thread.turns[0].items.insert(0, reasoning("older"));
+    assert_eq!(rows(&thread), 1);
+    let mut next = thread.turns[0].clone();
+    next.id = "second".into();
+    next.items = vec![reasoning("next-turn")];
+    thread.turns.push(next);
+    assert_eq!(rows(&thread), 3);
+}
