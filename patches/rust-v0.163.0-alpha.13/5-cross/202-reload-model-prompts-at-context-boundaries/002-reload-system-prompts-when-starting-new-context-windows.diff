+#[test]
+fn new_window_instruction_replacement_keeps_rendering_and_snapshot_coherent() {
+    use crate::context::world_state::WorldState;
+    use crate::context_manager::updates::merge_world_state_updates;
+
+    for incremental_tools in [false, true] {
+        let model_state = |instructions: &str| {
+            if incremental_tools {
+                ModelInstructionsState::for_incremental_tools("current", instructions.into())
+            } else {
+                ModelInstructionsState::new("current", Some("previous"), instructions.into())
+            }
+        };
+        let mut captured = WorldState::default();
+        captured.add_section(model_state("captured prompt"));
+        let (captured_snapshot, captured_updates) = captured.render_full();
+        let captured_items = merge_world_state_updates(captured_updates);
+
+        for instructions in ["refreshed prompt", ""] {
+            let (snapshot, updates) = captured.render_full_with_model_instructions(instructions);
+            let items = merge_world_state_updates(updates);
+            let mut expected = WorldState::default();
+            expected.add_section(model_state(instructions));
+            let (expected_snapshot, expected_updates) = expected.render_full();
+            assert_eq!(snapshot, expected_snapshot);
+            assert_eq!(items, merge_world_state_updates(expected_updates));
+            assert!(
+                expected
+                    .render_history_diff(Some(&snapshot), items.iter())
+                    .1
+                    .is_empty(),
+                "the installed prompt must not be repeated as a later model update"
+            );
+        }
+
+        let (snapshot, updates) = captured.render_full();
+        assert_eq!(snapshot, captured_snapshot);
+        assert_eq!(merge_world_state_updates(updates), captured_items);
+    }
+}
