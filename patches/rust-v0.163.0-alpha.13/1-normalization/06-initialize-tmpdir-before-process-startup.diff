+/// Creates the selected temporary root and returns its canonical path.
+pub fn ensure_tmpdir(path: &std::path::Path) -> std::io::Result<AbsolutePathBuf> {
+    std::fs::create_dir_all(path)?;
+    AbsolutePathBuf::from_absolute_path(path.canonicalize()?)
+}
