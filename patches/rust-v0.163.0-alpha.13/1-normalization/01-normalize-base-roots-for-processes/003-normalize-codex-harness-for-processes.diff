@@ -14,6 +14,32 @@ use pretty_assertions::assert_eq;
 use tempfile::tempdir;
 use test_case::test_case;
 
+#[tokio::test]
+async fn config_manager_preserves_the_selected_process_roots() -> Result<()> {
+    let home = tempdir()?;
+    let manager = ConfigManager::without_managed_config_for_tests(home.path().to_path_buf());
+
+    let config = manager.load_latest_config(/*fallback_cwd*/ None).await?;
+
+    assert_eq!(config.codex_home.as_path(), home.path());
+    assert_eq!(config.codex_harness.as_path(), home.path().join("harness"));
+    for reloaded in [
+        manager
+            .load_latest_config_with_session_layers(
+                &config.config_layer_stack,
+                config.cwd.as_path(),
+            )
+            .await?,
+        manager
+            .load_retained_session_config(&config.config_layer_stack, config.cwd.as_path())
+            .await?,
+    ] {
+        assert_eq!(reloaded.codex_home, config.codex_home);
+        assert_eq!(reloaded.codex_harness, config.codex_harness);
+    }
+    Ok(())
+}
+
