+    /// Private WebSocket recovery applies only to signed-in personal accounts
+    /// using the official provider, with no configured endpoint override.
+    pub(crate) fn personal_chatgpt_websocket_enabled(&self) -> bool {
+        let provider = self.client.state.provider.info();
+        self.client.responses_websocket_enabled()
+            && provider.is_openai()
+            && provider.base_url.is_none()
+            && self
+                .client
+                .auth_manager()
+                .and_then(|manager| manager.auth_cached())
+                .is_some_and(|auth| {
+                    auth.auth_mode() == AuthMode::Chatgpt
+                        && matches!(
+                            auth.account_plan_type(),
+                            Some(PlanType::Plus | PlanType::Pro | PlanType::ProLite)
+                        )
+                })
+    }
