+#[tokio::test]
+async fn unexpected_http_status_restarts_each_exhausted_connection_cycle() {
+    let auth =
+        CodexAuth::from_external_chatgpt_tokens("header.e30.signature", "account", Some("plus"))
+            .expect("personal account auth");
+    let (session, turn_context, events) =
+        make_session_and_context_with_auth_and_config_and_rx(auth, Vec::new(), |config| {
+            config.model_provider = ModelProviderInfo::create_openai_provider(None)
+        })
+        .await;
+    let mut client_session = session.services.model_client.new_session();
+    let step_context = StepContext::for_test(turn_context);
+    let mut retry_state = ResponsesStreamRetryState::default();
+    let error = unexpected_service_unavailable();
+    assert!(matches!(
+        error.details(),
+        CodexErrorDetails::UnexpectedStatus(_)
+    ));
+    assert!(!aligned_capacity_retry_eligible(5, true, &error));
+    tokio::time::pause();
+
+    for _ in 0..2 {
+        for retry in 1..=5 {
+            handle_response_stream_error(
+                &mut retry_state,
+                5,
+                unexpected_service_unavailable(),
+                &mut client_session,
+                &session,
+                &step_context,
+                ResponsesStreamRequest::Sampling,
+            )
+            .await
+            .expect("ordinary connection retry");
+            assert_eq!(retry_state.retries, retry);
+            assert!(matches!(events.try_recv().expect("retry event").msg,
+                EventMsg::StreamError(error) if error.message == format!("Reconnecting... {retry}/5")));
+            assert!(events.try_recv().is_err());
+        }
+        {
+            let wait = handle_response_stream_error(
+                &mut retry_state,
+                5,
+                unexpected_service_unavailable(),
+                &mut client_session,
+                &session,
+                &step_context,
+                ResponsesStreamRequest::Sampling,
+            );
+            tokio::pin!(wait);
+            let event = tokio::select! {
+                event = events.recv() => event.expect("aligned connection retry event"),
+                result = &mut wait => panic!("connection cycle ended before its wait: {result:?}"),
+            };
+            assert!(matches!(event.msg, EventMsg::StreamError(error)
+                if error.message.starts_with("Reconnecting at ")
+                    && error.message.ends_with(" after 5 retries")));
+            assert!(futures::poll!(&mut wait).is_pending());
+            tokio::time::advance(Duration::from_secs(5 * 60)).await;
+            wait.await.expect("next connection cycle");
+        }
+        assert_eq!(retry_state.retries, 0);
+        assert!(events.try_recv().is_err());
+        assert!(session.services.model_client.responses_websocket_enabled());
+    }
+}
