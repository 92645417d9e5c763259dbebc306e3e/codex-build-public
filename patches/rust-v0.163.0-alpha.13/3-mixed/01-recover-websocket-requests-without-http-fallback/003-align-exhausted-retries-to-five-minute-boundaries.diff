+#[tokio::test]
+async fn aligned_websocket_waits_do_not_change_remote_compaction() {
+    let auth =
+        CodexAuth::from_external_chatgpt_tokens("header.e30.signature", "account", Some("plus"))
+            .expect("personal account auth");
+    let (session, turn_context, events) =
+        make_session_and_context_with_auth_and_config_and_rx(auth, Vec::new(), |config| {
+            config.model_provider = ModelProviderInfo::create_openai_provider(None)
+        })
+        .await;
+    let mut client_session = session.services.model_client.new_session();
+    let step_context = StepContext::for_test(turn_context);
+    for err in [
+        CodexErr::ServerOverloaded,
+        CodexErr::Stream("websocket closed".to_string()),
+        unexpected_service_unavailable(),
+    ] {
+        let expected_error = err.to_string();
+        let mut retry_state = ResponsesStreamRetryState {
+            retries: 5,
+            ..Default::default()
+        };
+        let retry = handle_response_stream_error(
+            &mut retry_state,
+            5,
+            err,
+            &mut client_session,
+            &session,
+            &step_context,
+            ResponsesStreamRequest::RemoteCompactionV2,
+        );
+        tokio::pin!(retry);
+        let Poll::Ready(result) = futures::poll!(&mut retry) else {
+            panic!("remote compaction must not enter a sampling-only retry wait");
+        };
+        assert_eq!(
+            result.expect_err("exhausted remote compaction").to_string(),
+            expected_error
+        );
+        assert!(events.try_recv().is_err());
+    }
+}
