+#[test]
+fn websocket_connection_cycle_requires_personal_account_after_five_retries() {
+    for disconnect in [
+        CodexErr::Stream("websocket closed".to_string()),
+        unexpected_service_unavailable(),
+    ] {
+        for retries in 0..5 {
+            assert!(!aligned_connection_cycle_eligible(
+                retries,
+                5,
+                true,
+                &disconnect
+            ));
+        }
+        assert!(aligned_connection_cycle_eligible(5, 5, true, &disconnect));
+        assert!(!aligned_connection_cycle_eligible(5, 5, false, &disconnect));
+        assert!(!aligned_connection_cycle_eligible(2, 2, true, &disconnect));
+    }
+    assert!(!aligned_connection_cycle_eligible(
+        5,
+        5,
+        true,
+        &CodexErr::InternalServerError
+    ));
+}
+
+#[tokio::test]
+async fn connection_cycle_resets_the_budget_only_after_the_wait() {
+    for (cancel, http_failure) in [(false, false), (true, false), (false, true), (true, true)] {
+        let auth = CodexAuth::from_external_chatgpt_tokens(
+            "header.e30.signature",
+            "account",
+            Some("plus"),
+        )
+        .expect("personal account auth");
+        let (session, turn_context, events) =
+            make_session_and_context_with_auth_and_config_and_rx(auth, Vec::new(), |config| {
+                config.model_provider = ModelProviderInfo::create_openai_provider(None)
+            })
+            .await;
+        session
+            .record_rate_limits_info(quota_snapshot(100.0, 100.0))
+            .await;
+        let mut client_session = session.services.model_client.new_session();
+        let step_context = StepContext::for_test(turn_context);
+        let cancellation = CancellationToken::new();
+        let mut retry_state = ResponsesStreamRetryState {
+            retries: 5,
+            ..Default::default()
+        };
+        tokio::time::pause();
+        let result: Result<(), CodexErr> = {
+            let wait = async {
+                handle_response_stream_error(
+                    &mut retry_state,
+                    5,
+                    if http_failure {
+                        unexpected_service_unavailable()
+                    } else {
+                        CodexErr::Stream("websocket closed".to_string())
+                    },
+                    &mut client_session,
+                    &session,
+                    &step_context,
+                    ResponsesStreamRequest::Sampling,
+                )
+                .or_cancel(&cancellation)
+                .await?
+            };
+            tokio::pin!(wait);
+            let event = tokio::select! {
+                event = events.recv() => event.expect("connection retry event"),
+                result = &mut wait => panic!("connection wait ended before its event: {result:?}"),
+            };
+            assert!(matches!(event.msg, EventMsg::StreamError(error)
+                if error.message.starts_with("Reconnecting at ")
+                    && error.message.ends_with(" after 5 retries")));
+            assert!(futures::poll!(&mut wait).is_pending());
+            if cancel {
+                cancellation.cancel();
+            } else {
+                tokio::time::advance(Duration::from_secs(5 * 60)).await;
+            }
+            wait.await
+        };
+        if cancel {
+            assert!(matches!(
+                result.expect_err("cancelled connection wait").details(),
+                CodexErrorDetails::TurnAborted
+            ));
+            assert_eq!(retry_state.retries, 5);
+        } else {
+            result.expect("aligned connection retry");
+            assert_eq!(retry_state.retries, 0);
+        }
+        assert!(events.try_recv().is_err());
+        tokio::time::resume();
+    }
+}
