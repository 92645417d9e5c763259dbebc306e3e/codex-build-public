+    #[test]
+    fn reset_transition_is_identity_bound_and_not_sliding_future_time() {
+        let mut state = MonitorState::default();
+        let alice = AccountIdentity {
+            auth_revision: 1,
+            account_id: Some("alice".to_string()),
+        };
+        assert_eq!(state.observe(alice.clone(), 100, 90).schedule_at, Some(100));
+        assert_eq!(
+            state.observe(alice.clone(), 200, 101).probe_identity,
+            Some(alice.clone())
+        );
+        assert!(
+            state
+                .observe(alice.clone(), 200, 101)
+                .probe_identity
+                .is_none()
+        );
+        assert!(
+            state
+                .observe(alice.clone(), 300, 101)
+                .probe_identity
+                .is_none()
+        );
+        let bob = AccountIdentity {
+            auth_revision: 2,
+            account_id: Some("bob".to_string()),
+        };
+        assert!(state.observe(bob, 300, 301).probe_identity.is_none());
+    }
