+    #[tokio::test]
+    async fn dropping_ephemeral_probe_stops_and_removes_the_native_thread() -> anyhow::Result<()> {
+        let server = start_websocket_server_with_headers(vec![WebSocketConnectionConfig {
+            requests: vec![
+                vec![ev_response_created("prewarm"), ev_completed("prewarm")],
+                vec![ev_response_created("probe")],
+            ],
+            response_headers: Vec::new(),
+            accept_delay: None,
+            close_after_requests: false,
+        }])
+        .await;
+        let (home, threads, config) = probe_runtime(server.uri()).await?;
+        let tasks = TaskTracker::new();
+        let probe = tokio::spawn({
+            let threads = Arc::clone(&threads);
+            let tasks = tasks.clone();
+            async move { run_ephemeral_probe(&threads, &config, "gpt-5.4", &tasks).await }
+        });
+        tokio::time::timeout(Duration::from_secs(10), server.wait_for_request(0, 1)).await?;
+        let ids = threads.list_thread_ids().await;
+        assert_eq!(ids.len(), 1);
+        let thread = threads.get_thread(ids[0]).await?;
+        assert!(thread.config_snapshot().await.ephemeral);
+        assert!(thread.rollout_path().is_none());
+        probe.abort();
+        assert!(
+            probe
+                .await
+                .expect_err("probe task cancelled")
+                .is_cancelled()
+        );
+        tasks.close();
+        tokio::time::timeout(Duration::from_secs(5), tasks.wait()).await?;
+        server.shutdown().await;
+        assert!(threads.list_thread_ids().await.is_empty());
+        assert!(!home.path().join("sessions").exists());
+        Ok(())
+    }
+
+    #[tokio::test]
+    async fn ephemeral_probe_preserves_the_output_limit() -> anyhow::Result<()> {
+        let server = start_websocket_server(vec![vec![
+            vec![ev_response_created("prewarm"), ev_completed("prewarm")],
+            vec![
+                ev_response_created("probe"),
+                ev_assistant_message("answer", &"x".repeat(MAX_PROBE_STREAM_BYTES + 1)),
+                ev_completed("probe"),
+            ],
+        ]])
+        .await;
+        let (_home, threads, config) = probe_runtime(server.uri()).await?;
+        let tasks = TaskTracker::new();
+        let result = tokio::time::timeout(
+            Duration::from_secs(10),
+            run_ephemeral_probe(&threads, &config, "gpt-5.4", &tasks),
+        )
+        .await?;
+        tasks.close();
+        tokio::time::timeout(Duration::from_secs(5), tasks.wait()).await?;
+        server.shutdown().await;
+        assert_eq!(
+            result,
+            Err("Responses probe exceeded stream limit".to_owned())
+        );
+        assert!(threads.list_thread_ids().await.is_empty());
+        Ok(())
+    }
