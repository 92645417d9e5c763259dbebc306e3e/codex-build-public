+    async fn probe_runtime(
+        base_url: &str,
+    ) -> anyhow::Result<(tempfile::TempDir, Arc<ThreadManager>, Config)> {
+        let home = tempfile::tempdir()?;
+        let mut config = core_test_support::load_default_config_for_test(&home).await;
+        let mut provider = ModelProviderInfo::create_openai_provider(Some(base_url.to_owned()));
+        provider.request_max_retries = Some(0);
+        provider.stream_max_retries = Some(0);
+        config.model_provider = provider.clone();
+        config
+            .model_providers
+            .insert(OPENAI_PROVIDER_ID.to_owned(), provider.clone());
+        config.developer_instructions = Some("parent-only-instructions".to_owned());
+        let threads = Arc::new(
+            codex_core::test_support::thread_manager_with_models_provider_and_home(
+                CodexAuth::create_dummy_chatgpt_auth_for_testing(),
+                provider,
+                home.path().to_path_buf(),
+                Arc::new(EnvironmentManager::default_for_tests()),
+            ),
+        );
+        Ok((home, threads, config))
+    }
+
+    #[test]
+    fn probe_scope_is_the_approved_personal_plans() -> anyhow::Result<()> {
+        for (plan, eligible) in [
+            ("plus", true),
+            ("pro", true),
+            ("prolite", true),
+            ("promax", false),
+            ("free", false),
+            ("business", false),
+            ("team", false),
+            ("enterprise", false),
+            ("unknown", false),
+        ] {
+            let token = encode_id_token(
+                &ChatGptIdTokenClaims::new()
+                    .chatgpt_account_id("account")
+                    .plan_type(plan),
+            )?;
+            let auth = CodexAuth::from_external_chatgpt_tokens(&token, "account", Some(plan))?;
+            assert_eq!(eligible_account(&auth), eligible, "plan {plan}");
+        }
+        assert!(!eligible_account(&CodexAuth::from_api_key("api-key")));
+        Ok(())
+    }
+
