+                    }
+                })]
+            };
+            let server = start_websocket_server(vec![vec![
+                vec![ev_response_created("prewarm"), ev_completed("prewarm")],
+                events,
+            ]])
+            .await;
+            let (home, threads, config) = probe_runtime(server.uri()).await?;
+            let tasks = TaskTracker::new();
+            let result = tokio::time::timeout(
+                Duration::from_secs(10),
+                run_ephemeral_probe(&threads, &config, "gpt-5.4", &tasks),
+            )
+            .await?;
+            tasks.close();
+            tokio::time::timeout(Duration::from_secs(5), tasks.wait()).await?;
+            let handshake = server.single_handshake();
+            let requests = server.single_connection();
+            server.shutdown().await;
+
+            assert_eq!(
+                result.is_ok(),
+                terminal == "response.completed",
+                "{result:?}"
+            );
+            assert_eq!(requests.len(), 2);
+            let prewarm = requests[0].body_json();
+            assert_eq!(prewarm["generate"], false);
+            let prewarm_input = prewarm["input"].to_string();
+            assert!(prewarm_input.contains(PROBE_INSTRUCTIONS));
+            assert!(!prewarm_input.contains("parent-only-instructions"));
+            assert!(prewarm["tools"].as_array().is_none_or(Vec::is_empty));
+            let request = requests[1].body_json();
+            assert_eq!(request["previous_response_id"], "prewarm");
+            assert_eq!(request["type"], "response.create");
+            assert_eq!(request["model"], "gpt-5.4");
+            assert_eq!(request["store"], false);
+            assert_ne!(request["generate"], false);
+            assert!(request["tools"].as_array().is_none_or(Vec::is_empty));
+            let input = request["input"].to_string();
+            assert!(input.contains(PROBE_PROMPT));
+            assert!(!input.contains("parent-only-instructions"));
+            assert_eq!(
+                handshake.header("chatgpt-account-id").as_deref(),
+                Some("account_id")
+            );
+            assert_eq!(
+                handshake.header("authorization").as_deref(),
+                Some("Bearer Access Token")
+            );
+            assert!(threads.list_thread_ids().await.is_empty());
+            assert!(!home.path().join("sessions").exists());
+        }
+        Ok(())
+    }
