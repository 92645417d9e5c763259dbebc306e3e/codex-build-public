+//! Activates model quota windows after the main weekly quota rolls over.
+//!
+//! This is not a usage cache: account/rateLimits/read retains its upstream
+//! request/response behavior. The monitor begins only after a real account
+//! snapshot identifies a primary weekly window.
+
+use super::AccountRequestProcessor;
+use codex_app_server_protocol::GetAccountRateLimitsParams;
+use codex_app_server_protocol::GetAccountRateLimitsResponse;
+use codex_app_server_protocol::RateLimitSnapshot;
+use codex_core::StartIfIdleSubmission;
+use codex_core::StartThreadOptions;
+use codex_core::ThreadManager;
+use codex_core::TurnInputRequest;
+use codex_core::config::Config;
+use codex_extension_api::SessionIsolation;
+use codex_extension_api::ToolPolicy;
+use codex_features::Feature;
+use codex_login::CodexAuth;
+use codex_model_provider_info::OPENAI_PROVIDER_ID;
+use codex_models_manager::manager::RefreshStrategy;
+use codex_protocol::account::PlanType;
+use codex_protocol::openai_models::ModelVisibility;
+use codex_protocol::protocol::EventMsg;
+use codex_protocol::protocol::ThreadSource;
+use codex_protocol::user_input::UserInput;
+use futures::StreamExt;
+use std::sync::Arc;
+use std::sync::Weak;
+use std::time::Duration;
+use std::time::SystemTime;
+use std::time::UNIX_EPOCH;
+use tokio::sync::Mutex;
+use tokio::time::Instant;
+use tokio_util::sync::CancellationToken;
+use tokio_util::task::TaskTracker;
+
+const WEEKLY_WINDOW_MINUTES: i64 = 7 * 24 * 60;
+const RESET_CHANGE_TOLERANCE_SECONDS: i64 = 30;
+const RESET_OBSERVATION_DELAY: Duration = Duration::from_secs(30);
+const RESET_VERIFICATION_RETRY: Duration = Duration::from_secs(30);
+const USAGE_READ_TIMEOUT: Duration = Duration::from_secs(15);
+const PROBE_TIMEOUT: Duration = Duration::from_secs(20);
+const PROBE_BATCH_TIMEOUT: Duration = Duration::from_secs(60);
+const PROBE_PROMPT: &str = "reply OK if everything is fine";
+const PROBE_INSTRUCTIONS: &str = "You are Codex. Respond directly to this health-check prompt.";
+const MAX_PROBE_STREAM_BYTES: usize = 1024 * 1024;
+
+#[derive(Clone, Debug, Eq, PartialEq)]
+struct AccountIdentity {
+    auth_revision: u64,
+    account_id: Option<String>,
+}
+
+#[derive(Default)]
+struct MonitorState {
+    identity: Option<AccountIdentity>,
+    primary_reset_at: Option<i64>,
+    last_probed_reset_at: Option<i64>,
+    scheduled_reset_at: Option<i64>,
+}
+
+struct Observation {
+    schedule_at: Option<i64>,
+    probe_identity: Option<AccountIdentity>,
+}
+
+impl MonitorState {
+    fn observe(&mut self, identity: AccountIdentity, reset_at: i64, now: i64) -> Observation {
+        if self.identity.as_ref() != Some(&identity) {
+            self.identity = Some(identity.clone());
+            self.primary_reset_at = None;
+            self.last_probed_reset_at = None;
+            self.scheduled_reset_at = None;
+        }
+        let previous = self.primary_reset_at.replace(reset_at);
+        let changed_after_reset = previous.is_some_and(|previous| {
+            previous <= now.saturating_add(RESET_CHANGE_TOLERANCE_SECONDS)
+                && reset_at > previous.saturating_add(RESET_CHANGE_TOLERANCE_SECONDS)
+                && self.last_probed_reset_at != Some(reset_at)
+        });
+        if changed_after_reset {
+            self.last_probed_reset_at = Some(reset_at);
+        }
+        let schedule_at = if previous != Some(reset_at) && reset_at > now {
+            self.scheduled_reset_at = Some(reset_at);
+            Some(reset_at)
+        } else {
+            None
+        };
+        Observation {
+            schedule_at,
+            probe_identity: changed_after_reset.then_some(identity),
+        }
+    }
+}
+
+#[derive(Clone, Default)]
+pub(super) struct WeeklyResetProbe {
+    state: Arc<Mutex<MonitorState>>,
+}
+
+impl WeeklyResetProbe {
+    pub(super) async fn observe(
+        &self,
+        owner: &Arc<AccountRequestProcessor>,
+        auth_revision: u64,
+        response: &GetAccountRateLimitsResponse,
+    ) {
+        if *owner.auth_manager.auth_change_receiver().borrow() != auth_revision {
+            return;
+        }
+        let Some(auth) = owner.auth_manager.auth_cached() else {
+            return;
+        };
+        if !eligible_account(&auth) {
+            return;
+        }
+        let account_id = auth.get_account_id();
+        if response
+            .account_id
+            .as_ref()
+            .is_some_and(|response_id| Some(response_id) != account_id.as_ref())
+        {
+            return;
+        }
+        let Some(reset_at) = main_weekly_reset_at(response) else {
+            return;
+        };
+        let Some(now) = unix_seconds(SystemTime::now()) else {
+            return;
+        };
+        let identity = AccountIdentity {
+            auth_revision,
+            account_id,
+        };
+        let observation = {
+            let mut state = self.state.lock().await;
+            state.observe(identity.clone(), reset_at, now)
+        };
+
+        if let Some(schedule_at) = observation.schedule_at {
+            self.schedule_verification(Arc::downgrade(owner), identity, schedule_at);
+        }
+        if let Some(identity) = observation.probe_identity {
+            self.start_probe(Arc::downgrade(owner), identity);
+        }
+    }
+
+    fn schedule_verification(
+        &self,
+        owner: Weak<AccountRequestProcessor>,
+        identity: AccountIdentity,
+        reset_at: i64,
+    ) {
+        let probe = self.clone();
+        tokio::spawn(async move {
+            let now = unix_seconds(SystemTime::now()).unwrap_or(reset_at);
+            let delay = Duration::from_secs(reset_at.saturating_sub(now).max(0) as u64)
+                .saturating_add(RESET_OBSERVATION_DELAY);
+            tokio::time::sleep_until(Instant::now() + delay).await;
+            for attempt in 0..3 {
+                if attempt != 0 {
+                    tokio::time::sleep(RESET_VERIFICATION_RETRY).await;
+                }
+                let Some(owner) = owner.upgrade() else {
+                    return;
+                };
+                {
+                    let state = probe.state.lock().await;
+                    if state.identity.as_ref() != Some(&identity)
+                        || state.scheduled_reset_at != Some(reset_at)
+                    {
+                        return;
+                    }
+                }
+                let auth_revision = *owner.auth_manager.auth_change_receiver().borrow();
+                if auth_revision != identity.auth_revision {
+                    return;
+                }
+                let result = tokio::time::timeout(
+                    USAGE_READ_TIMEOUT,
+                    owner.get_account_rate_limits_response(GetAccountRateLimitsParams {
+                        exclude_reset_credit_details: true,
+                        ..Default::default()
+                    }),
+                )
+                .await;
+                if let Ok(Ok(response)) = result {
+                    probe.observe(&owner, auth_revision, &response).await;
+                    if main_weekly_reset_at(&response) != Some(reset_at) {
+                        return;
+                    }
+                }
+            }
+            tracing::warn!("main weekly rate-limit reset could not be verified");
+        });
+    }
+
+    fn start_probe(&self, owner: Weak<AccountRequestProcessor>, identity: AccountIdentity) {
+        tokio::spawn(async move {
+            let Some(owner) = owner.upgrade() else {
+                return;
+            };
+            let tasks = TaskTracker::new();
+            let result = tokio::time::timeout(
+                PROBE_BATCH_TIMEOUT,
+                probe_enabled_models(&owner, &identity, &tasks),
+            )
+            .await;
+            tasks.close();
+            tasks.wait().await;
+            match result {
+                Ok(Ok(())) => tracing::info!("main weekly rate-limit probe completed"),
+                Ok(Err(error)) => tracing::warn!(%error, "main weekly rate-limit probe failed"),
+                Err(_) => tracing::warn!("main weekly rate-limit probe timed out"),
+            }
+        });
+    }
+}
+
+fn main_weekly_reset_at(response: &GetAccountRateLimitsResponse) -> Option<i64> {
+    let snapshot: &RateLimitSnapshot = response
+        .rate_limits_by_limit_id
+        .as_ref()
+        .and_then(|snapshots| snapshots.get("codex"))
+        .or_else(|| {
+            (response.rate_limits.limit_id.as_deref() == Some("codex"))
+                .then_some(&response.rate_limits)
+        })?;
+    let primary = snapshot.primary.as_ref()?;
+    (primary.window_duration_mins == Some(WEEKLY_WINDOW_MINUTES))
+        .then_some(primary.resets_at)
+        .flatten()
+}
+
+fn unix_seconds(time: SystemTime) -> Option<i64> {
+    time.duration_since(UNIX_EPOCH)
+        .ok()
+        .and_then(|duration| i64::try_from(duration.as_secs()).ok())
+}
+
+async fn probe_enabled_models(
+    owner: &AccountRequestProcessor,
+    identity: &AccountIdentity,
+    tasks: &TaskTracker,
+) -> Result<(), String> {
+    let mut auth_changes = owner.auth_manager.auth_change_receiver();
+    if *auth_changes.borrow() != identity.auth_revision {
+        return Err("account changed before weekly probe".to_string());
+    }
+    let auth = owner
+        .auth_manager
+        .auth()
+        .await
+        .ok_or_else(|| "weekly probe requires ChatGPT authentication".to_string())?;
+    if !eligible_account(&auth) || auth.get_account_id() != identity.account_id {
+        return Err("account changed before weekly probe".to_string());
+    }
+
+    let models_manager = owner.thread_manager.get_models_manager();
+    let mut catalog = models_manager
+        .raw_model_catalog(RefreshStrategy::Offline, owner.config.http_client_factory())
+        .await;
+    catalog.models.retain(|model| {
+        matches!(
+            model.visibility,
+            ModelVisibility::List | ModelVisibility::Hide
+        )
+    });
+    let mut models = models_manager.build_available_models(catalog.models);
+    models.sort_by(|left, right| left.model.cmp(&right.model));
+    models.dedup_by(|left, right| left.model == right.model);
+    if models.is_empty() {
+        return Err("weekly probe found no eligible models".to_string());
+    }
+    if *auth_changes.borrow() != identity.auth_revision {
+        return Err("account changed while selecting weekly probe models".to_string());
+    }
+
+    let probes = futures::stream::iter(models.into_iter().map(|model| async move {
+        let result = tokio::time::timeout(
+            PROBE_TIMEOUT,
+            run_ephemeral_probe(&owner.thread_manager, &owner.config, &model.model, tasks),
+        )
+        .await;
+        let result = match result {
+            Ok(result) => result,
+            Err(_) => Err("model probe timed out".to_string()),
+        };
+        (model.model, result)
+    }))
+    .buffer_unordered(4);
+    tokio::pin!(probes);
+    loop {
+        tokio::select! {
+            biased;
+            changed = auth_changes.changed() => {
+                let _ = changed;
+                return Err("account changed during weekly probe".to_string());
+            }
+            outcome = probes.next() => {
+                let Some((model, result)) = outcome else { break; };
+                match result {
+                    Ok(()) => tracing::info!(%model, "weekly model probe completed"),
+                    Err(error) => tracing::warn!(%model, %error, "weekly model probe failed"),
+                }
+            }
+        }
+    }
+    Ok(())
+}
+
+async fn run_ephemeral_probe(
+    thread_manager: &Arc<ThreadManager>,
+    config: &Config,
+    model: &str,
+    tasks: &TaskTracker,
+) -> Result<(), String> {
+    let mut config = config.clone();
+    config.model = Some(model.to_owned());
+    config.model_provider_id = OPENAI_PROVIDER_ID.to_owned();
+    config.model_provider = config
+        .model_providers
+        .get(OPENAI_PROVIDER_ID)
+        .cloned()
+        .ok_or_else(|| "weekly probe requires the OpenAI provider".to_owned())?;
+    config.ephemeral = true;
+    config.base_instructions = Some(PROBE_INSTRUCTIONS.to_owned());
+    config.developer_instructions = None;
+    config.include_permissions_instructions = false;
+    config.include_apps_instructions = false;
+    config.include_collaboration_mode_instructions = false;
+    config.include_skill_instructions = false;
+    config.model_reasoning_effort = None;
+    config.service_tier = None;
+    config.notify = None;
+    config.model_post_turn_compact_threshold_percent = 0;
+    config
+        .mcp_servers
+        .set(Default::default())
+        .map_err(|error| error.to_string())?;
+    for feature in [
+        Feature::CodexHooks,
+        Feature::Plugins,
+        Feature::ShellSnapshot,
+    ] {
+        config
+            .features
+            .disable(feature)
+            .map_err(|error| error.to_string())?;
+        if config.features.enabled(feature) {
+            return Err(format!(
+                "weekly probe cannot disable features.{}",
+                feature.key()
+            ));
+        }
+    }
+    let mut options = StartThreadOptions::new(config);
+    options.thread_source = Some(ThreadSource::Feature("weekly_reset_probe".to_owned()));
+    options.environments = Some(Vec::new());
+    options
+        .thread_extension_init
+        .insert(SessionIsolation::Isolated);
+    options.thread_extension_init.insert(ToolPolicy {
+        allowed_tools: Some(Vec::new()),
+        ..ToolPolicy::default()
+    });
+
+    // Native managed startup owns shutdown and deregistration even when the model
+    // deadline, batch deadline, or account change drops this future during startup.
+    let cancellation = CancellationToken::new();
+    let _cancel_on_exit = cancellation.clone().drop_guard();
+    let thread = thread_manager
+        .start_thread_until(options, cancellation.cancelled_owned(), tasks)
+        .await
+        .map_err(|error| error.to_string())?
+        .thread;
+    match thread
+        .start_turn_if_idle(TurnInputRequest::user_input(vec![UserInput::Text {
+            text: PROBE_PROMPT.to_owned(),
+            text_elements: Vec::new(),
+        }]))
+        .await
+        .map_err(|error| error.to_string())?
+    {
+        StartIfIdleSubmission::Started { .. } => {}
+        StartIfIdleSubmission::NotSubmitted { reason } => {
+            return Err(format!("weekly probe turn was not started: {reason:?}"));
+        }
+    }
+
+    let mut stream_bytes = 0usize;
+    let mut response_completed = false;
+    loop {
+        let event = thread
+            .next_event()
+            .await
+            .map_err(|error| error.to_string())?
+            .msg;
+        let bytes = match event {
+            EventMsg::RawResponseCompleted(_) => {
+                response_completed = true;
+                0
+            }
+            EventMsg::TurnComplete(completed) => {
+                if let Some(error) = completed.error {
+                    return Err(error.message);
+                }
+                return if response_completed {
+                    Ok(())
+                } else {
+                    Err("weekly probe ended without response completion".to_owned())
+                };
+            }
+            EventMsg::Error(error) => return Err(error.message),
+            EventMsg::TurnAborted(_) | EventMsg::ShutdownComplete => {
+                return Err("weekly probe stopped before turn completion".to_owned());
+            }
+            EventMsg::AgentMessageContentDelta(delta) => delta.delta.len(),
+            EventMsg::ReasoningContentDelta(delta) => delta.delta.len(),
+            EventMsg::ReasoningRawContentDelta(delta) => delta.delta.len(),
+            EventMsg::RawResponseItem(item) => serde_json::to_vec(&item.item)
+                .map_err(|error| error.to_string())?
+                .len(),
+            _ => 0,
+        };
+        stream_bytes = stream_bytes.saturating_add(bytes);
+        if stream_bytes > MAX_PROBE_STREAM_BYTES {
+            return Err("Responses probe exceeded stream limit".to_string());
+        }
+    }
+}
+
+fn eligible_account(auth: &CodexAuth) -> bool {
+    auth.is_chatgpt_auth()
+        && matches!(
+            auth.account_plan_type(),
+            Some(PlanType::Plus | PlanType::Pro | PlanType::ProLite)
+        )
+}
+
+#[cfg(test)]
