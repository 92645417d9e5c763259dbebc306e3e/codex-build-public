+        assert_eq!(child_turns[0].turn_id, parent_turns[0].turn_id);
+        assert_eq!(child_turns[1].turn_id, "child-turn");
+        assert_eq!(
+            thread_history::projection_state(&store, child_id)
+                .await
+                .expect("read child projection")
+                .expect("child projection")
+                .next_ordinal,
+            expected_next_ordinal
+        );
+        assert_eq!(
+            fs::read(&parent_path).expect("read unchanged parent"),
+            parent_bytes
+        );
+        assert_eq!(
+            fs::read(&child_path).expect("read unchanged child"),
+            child_bytes
+        );
+        let repeated = store
+            .migrate_rollouts(apply_options())
+            .await
+            .expect("repeat referenced rebuild");
+        assert!(
+            repeated
+                .outcomes
+                .iter()
+                .all(|outcome| outcome.status == RolloutMigrationStatus::AlreadyPaginated)
+        );
+    }
+}
