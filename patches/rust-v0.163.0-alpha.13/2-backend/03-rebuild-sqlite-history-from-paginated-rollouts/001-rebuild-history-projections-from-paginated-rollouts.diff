+#[tokio::test]
+async fn manual_migration_rebuilds_paginated_history_after_database_loss() {
+    let home = TempDir::new().expect("create Codex home");
+    let thread_id = ThreadId::new();
+    let path = write_rollout(
+        home.path(),
+        thread_id,
+        SessionSource::Cli,
+        vec![user_message("question"), agent_message("answer")],
+    );
+    let store = indexed_store(home.path()).await;
+    codex_rollout::append_thread_name(home.path(), thread_id, "my title")
+        .await
+        .expect("record thread name");
+    store
+        .migrate_rollouts(apply_options())
+        .await
+        .expect("migrate legacy rollout");
+    let paginated_bytes = fs::read(&path).expect("read paginated rollout");
+    let history_db_path = store.config.sqlite.thread_history_db_path();
+    store
+        .thread_history_db()
+        .await
+        .expect("open history database")
+        .close()
+        .await;
+    drop(store);
+    fs::remove_file(&history_db_path).expect("remove history database");
+
+    let store = indexed_store(home.path()).await;
+    store
+        .state_db()
+        .await
+        .expect("state database")
+        .update_thread_name(thread_id, /*name*/ None)
+        .await
+        .expect("clear SQLite name before rebuild");
+    let report = store
+        .migrate_rollouts(apply_options())
+        .await
+        .expect("rebuild paginated history");
+    assert_eq!(report.outcomes[0].status, RolloutMigrationStatus::Migrated);
+    assert_eq!(
+        fs::read(&path).expect("read unchanged rollout"),
+        paginated_bytes
+    );
+    assert_eq!(
+        list_active_summary_turns(&store, thread_id)
+            .await
+            .turns
+            .len(),
+        1
+    );
+    assert_eq!(
+        store
+            .state_db()
+            .await
+            .expect("state database")
+            .get_thread(thread_id)
+            .await
+            .expect("read thread metadata")
+            .expect("thread metadata")
+            .name
+            .as_deref(),
+        Some("my title")
+    );
+    let second = store
+        .migrate_rollouts(apply_options())
+        .await
+        .expect("repeat rebuilt migration");
+    assert_eq!(
+        second.outcomes[0].status,
+        RolloutMigrationStatus::AlreadyPaginated
+    );
+}
