+    let dir = tempdir().expect("tempdir");
+    let home = dir.path();
+    let runtime = codex_state::StateRuntime::init(
+        codex_state::SqliteConfig::new_for_testing(home.abs()),
+        "test-provider".to_string(),
+    )
+    .await
+    .expect("initialize runtime");
+    let mut threads = Vec::new();
+    for name in [Some("SQLite name"), None] {
+        let uuid = Uuid::new_v4();
+        let id = ThreadId::from_string(&uuid.to_string()).expect("thread id");
+        let path = write_rollout_in_sessions_with_cwd(
+            home,
+            "2026-01-27T12-34-56",
+            "2026-01-27T12:34:56Z",
+            uuid,
+            home.to_path_buf(),
+            None,
+            ThreadHistoryMode::Paginated,
+        );
+        let mut metadata = extract_metadata_from_rollout(&path, "test-provider")
+            .await
+            .expect("extract metadata")
+            .metadata;
+        metadata.name = name.map(str::to_string);
+        runtime
+            .upsert_thread(&metadata)
+            .await
+            .expect("existing row");
+        crate::session_index::append_thread_name(home, id, "stale indexed name")
+            .await
+            .expect("index name");
+        threads.push((id, name));
+    }
+
+    backfill_sessions(runtime.as_ref(), home, "test-provider").await;
+
+    for (id, name) in threads {
+        let stored = runtime
+            .get_thread(id)
+            .await
+            .expect("get thread")
+            .expect("existing row");
+        assert_eq!(stored.name.as_deref(), name);
+    }
+}
