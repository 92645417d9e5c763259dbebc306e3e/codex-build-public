+#[tokio::test]
+async fn unreadable_name_index_leaves_backfill_unfinished() {
+    let dir = tempdir().expect("tempdir");
+    let home = dir.path();
+    let uuid = Uuid::new_v4();
+    let id = ThreadId::from_string(&uuid.to_string()).expect("thread id");
+    write_rollout_in_sessions(
+        home,
+        "2026-01-27T12-34-56",
+        "2026-01-27T12:34:56Z",
+        uuid,
+        None,
+    );
+    let index_path = home.join("session_index.jsonl");
+    // Opening a directory can produce an empty seekable input on Linux. A socket
+    // keeps the path present while making the native file open fail.
+    let _socket = std::os::unix::net::UnixListener::bind(&index_path).expect("block index read");
+    assert!(File::open(&index_path).is_err());
+    let runtime = codex_state::StateRuntime::init(
+        codex_state::SqliteConfig::new_for_testing(home.abs()),
+        "test-provider".to_string(),
+    )
+    .await
+    .expect("initialize runtime");
+
+    backfill_sessions(runtime.as_ref(), home, "test-provider").await;
+
+    assert!(runtime.get_thread(id).await.expect("get thread").is_none());
+    let state = runtime.get_backfill_state().await.expect("backfill state");
+    assert_eq!(state.status, BackfillStatus::Running);
+    assert_eq!(state.last_watermark, None);
+}
