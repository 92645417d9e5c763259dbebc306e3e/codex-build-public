+#[tokio::test]
+async fn backfill_restores_indexed_names_for_active_and_archived_rows() {
+    let dir = tempdir().expect("tempdir");
+    let home = dir.path();
+    let runtime = codex_state::StateRuntime::init(
+        codex_state::SqliteConfig::new_for_testing(home.abs()),
+        "test-provider".to_string(),
+    )
+    .await
+    .expect("initialize runtime");
+    let mut threads = Vec::new();
+    for mode in [ThreadHistoryMode::Legacy, ThreadHistoryMode::Paginated] {
+        for archived in [false, true] {
+            let uuid = Uuid::new_v4();
+            let id = ThreadId::from_string(&uuid.to_string()).expect("thread id");
+            let path = write_rollout_in_sessions_with_cwd(
+                home,
+                "2026-01-27T12-34-56",
+                "2026-01-27T12:34:56Z",
+                uuid,
+                home.to_path_buf(),
+                None,
+                mode,
+            );
+            if archived {
+                let archive = home.join(ARCHIVED_SESSIONS_SUBDIR);
+                std::fs::create_dir_all(&archive).expect("create archive");
+                std::fs::rename(
+                    &path,
+                    archive.join(path.file_name().expect("rollout filename")),
+                )
+                .expect("archive rollout");
+            }
+            for name in ["previous name", "restored name"] {
+                crate::session_index::append_thread_name(home, id, name)
+                    .await
+                    .expect("index name");
+            }
+            threads.push((id, mode, archived));
+        }
+    }
+
+    backfill_sessions(runtime.as_ref(), home, "test-provider").await;
+
+    for (id, mode, archived) in threads {
+        let stored = runtime
+            .get_thread(id)
+            .await
+            .expect("get thread")
+            .expect("backfilled row");
+        assert_eq!(stored.name.as_deref(), Some("restored name"));
+        assert_eq!(stored.history_mode, mode);
+        assert_eq!(stored.archived_at.is_some(), archived);
+    }
+    assert_eq!(
+        runtime
+            .get_backfill_state()
+            .await
+            .expect("backfill state")
+            .status,
+        BackfillStatus::Complete
+    );
+}
