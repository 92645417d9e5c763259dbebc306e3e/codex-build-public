+#[tokio::test]
+async fn resolves_indexed_archived_ancestors_without_scanning_sessions() {
+    let home = TempDir::new().expect("temp dir");
+    let config = test_config(home.path());
+    let state_db = codex_state::StateRuntime::init(
+        config.sqlite.clone(),
+        config.default_model_provider_id.clone(),
+    )
+    .await
+    .expect("initialize state database");
+    let store = LocalThreadStore::new(config, Some(state_db.clone()));
+    let root = ThreadId::default();
+    let child = ThreadId::default();
+    let archived = home.path().join("archived_sessions");
+    let root_path = write_rollout_under(archived.clone(), root, None, 3);
+    let child_path = write_rollout_under(
+        archived,
+        child,
+        Some(history_position(root_path.as_path(), root, 3)),
+        2,
+    );
+    index_rollout(state_db.as_ref(), root, root_path.as_path()).await;
+    index_rollout(state_db.as_ref(), child, child_path.as_path()).await;
+    // An unrelated namespace cannot be listed. Indexed immutable ancestors must not need it.
+    fs::write(home.path().join("sessions"), "not a directory").expect("block session scan");
+
+    let lineage = store
+        .resolve_rollout_lineage(child, Some(child_path))
+        .await
+        .expect("resolve indexed ancestor without a directory scan");
+    assert_eq!(lineage.segments[0].rollout_path, root_path);
+
+    let compressed_path = root_path.with_extension("jsonl.zst");
+    let compressed = zstd::stream::encode_all(
+        fs::read(root_path.as_path())
+            .expect("read ancestor")
+            .as_slice(),
+        0,
+    )
+    .expect("compress ancestor");
+    fs::write(compressed_path.as_path(), compressed).expect("write compressed ancestor");
+    fs::remove_file(root_path.as_path()).expect("remove plain ancestor");
+
+    let lineage = store
+        .resolve_rollout_lineage_for_reference(child)
+        .await
+        .expect("resolve indexed compressed ancestor for another fork");
+    assert_eq!(lineage.segments[0].rollout_path, compressed_path);
+    assert!(!root_path.exists(), "shared ancestors stay compressed");
+}
