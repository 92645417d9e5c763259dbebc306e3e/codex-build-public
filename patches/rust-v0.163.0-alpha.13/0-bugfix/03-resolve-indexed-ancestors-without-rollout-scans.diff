+#[tokio::test]
+async fn resolves_original_ancestors_after_indexed_rollout_changes_or_disappears() {
+    let home = TempDir::new().expect("temp dir");
+    let config = test_config(home.path());
+    let state_db = codex_state::StateRuntime::init(
+        config.sqlite.clone(),
+        config.default_model_provider_id.clone(),
+    )
+    .await
+    .expect("initialize state database");
+    let store = LocalThreadStore::new(config, Some(state_db.clone()));
+    let root = ThreadId::default();
+    let child = ThreadId::default();
+    let root_path = write_rollout(home.path(), root, None, 3);
+    let child_path = write_rollout(
+        home.path(),
+        child,
+        Some(history_position(root_path.as_path(), root, 3)),
+        2,
+    );
+    let mut metadata = index_rollout(state_db.as_ref(), root, root_path.as_path()).await;
+    let replacement_path = root_path.with_file_name(format!(
+        "rollout-2026-07-16T00-00-00-{root}_{}.jsonl",
+        ThreadId::default()
+    ));
+    fs::copy(root_path.as_path(), replacement_path.as_path()).expect("create replacement rollout");
+    for indexed_path in [
+        replacement_path,
+        home.path()
+            .join("missing")
+            .join(root_path.file_name().expect("ancestor filename")),
+    ] {
+        metadata.rollout_path = indexed_path;
+        state_db
+            .upsert_thread(&metadata)
+            .await
+            .expect("change indexed rollout");
+
+        let lineage = store
+            .resolve_rollout_lineage(child, Some(child_path.clone()))
+            .await
+            .expect("resolve original immutable ancestor through filesystem fallback");
+        assert_eq!(lineage.segments[0].rollout_path, root_path);
+    }
+}
