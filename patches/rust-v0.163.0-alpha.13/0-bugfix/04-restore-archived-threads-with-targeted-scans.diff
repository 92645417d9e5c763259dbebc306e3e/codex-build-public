+#[tokio::test]
+async fn filtered_archived_scan_excludes_active_and_unrelated_rollouts() -> anyhow::Result<()> {
+    let home = TempDir::new()?;
+    let owner_uuid = Uuid::from_u128(60);
+    let owner_id = thread_id(owner_uuid)?;
+    let replacement_id = thread_id(Uuid::from_u128(61))?;
+    let original = archived_rollout_path(home.path(), owner_uuid);
+    let replacement = original.with_file_name(format!(
+        "rollout-2025-01-03T12-00-00-{owner_id}_{replacement_id}.jsonl"
+    ));
+    write_rollout(original.clone(), owner_id, None)?;
+    compress_now(&original)?;
+    write_rollout(replacement.clone(), owner_id, None)?;
+    write_rollout(active_rollout_path(home.path(), owner_uuid), owner_id, None)?;
+    let unrelated_uuid = Uuid::from_u128(62);
+    let unrelated_id = thread_id(unrelated_uuid)?;
+    let unrelated = archived_rollout_path(home.path(), unrelated_uuid);
+    write_rollout(unrelated.clone(), unrelated_id, None)?;
+    compress_now(&unrelated)?;
+
+    let index =
+        RolloutReferenceIndex::scan_threads(home.path(), &[owner_id], /*archived*/ true).await?;
+    let mut owned: Vec<_> = index
+        .rollouts_for_thread(owner_id)
+        .map(|(id, path)| (id, path.to_path_buf()))
+        .collect();
+    owned.sort_by_key(|(id, _)| id.to_string());
+    assert_eq!(
+        owned,
+        vec![
+            (owner_id, original.with_extension("jsonl.zst")),
+            (replacement_id, replacement),
+        ]
+    );
+    assert!(index.rollouts_for_thread(unrelated_id).next().is_none());
+    Ok(())
+}
