diff --git a/codex-rs/core/tests/suite/client_websockets_recording_tests.rs b/codex-rs/core/tests/suite/client_websockets_recording_tests.rs
new file mode 100644
--- /dev/null
+++ b/codex-rs/core/tests/suite/client_websockets_recording_tests.rs
@@ -0,0 +1,280 @@
+use super::*;
+use codex_protocol::response_metrics::ResponseAttemptEnd;
+use core_test_support::responses::ev_function_call;
+use core_test_support::responses::ev_output_text_delta;
+use core_test_support::responses::ev_reasoning_item;
+use core_test_support::responses::ev_reasoning_item_added;
+use core_test_support::responses::ev_reasoning_summary_text_delta;
+use pretty_assertions::assert_eq;
+
+fn personal_auth(plan: &str) -> CodexAuth {
+    CodexAuth::from_external_chatgpt_tokens("header.e30.signature", "selected-account", Some(plan))
+        .unwrap()
+}
+
+#[test_case::test_case(Some("plus"), true; "plus")]
+#[test_case::test_case(Some("pro"), true; "pro")]
+#[test_case::test_case(Some("prolite"), true; "prolite")]
+#[test_case::test_case(Some("promax"), false; "promax_unchanged")]
+#[test_case::test_case(Some("business"), false; "business_unchanged")]
+#[test_case::test_case(Some("free"), false; "free_unchanged")]
+#[test_case::test_case(None, false; "api_key_unchanged")]
+#[tokio::test]
+async fn failed_response_withholds_model_events_only_for_admitted_accounts(
+    plan: Option<&str>,
+    complete: bool,
+) {
+    skip_if_no_network!();
+    let server = start_websocket_server(vec![vec![vec![
+        ev_response_created("r1"),
+        ev_reasoning_summary_text_delta("Uncommitted reasoning"),
+        ev_output_text_delta("Uncommitted answer"),
+        ev_function_call("call-1", "exec_command", "{\"cmd\":\"should-not-run\"}"),
+    ]]])
+    .await;
+    let harness = websocket_harness_with_provider_options_and_auth(
+        websocket_provider(&server),
+        false,
+        false,
+        &[],
+        Some(plan.map_or_else(|| CodexAuth::from_api_key("dummy"), personal_auth)),
+    )
+    .await;
+    let mut session = harness.client.new_session();
+    let mut stream = session
+        .stream(
+            &prompt_with_input(vec![message_item("hello")]),
+            &harness.model_info,
+            &harness.session_telemetry,
+            harness.effort.clone(),
+            harness.summary,
+            None,
+            &turn_metadata(&harness, Some("turn-1")),
+            &InferenceTraceContext::disabled(),
+        )
+        .await
+        .unwrap();
+    let mut counts = (0, 0, 0);
+    let mut failed = false;
+    while let Some(event) = stream.next().await {
+        match event {
+            Ok(ResponseEvent::OutputItemDone(ResponseItem::FunctionCall { .. })) => counts.0 += 1,
+            Ok(ResponseEvent::ReasoningSummaryDelta { .. }) => counts.1 += 1,
+            Ok(ResponseEvent::OutputTextDelta(_)) => counts.2 += 1,
+            Err(_) => failed = true,
+            _ => {}
+        }
+    }
+    assert!(failed);
+    let expected = usize::from(!complete);
+    assert_eq!(counts, (expected, expected, expected));
+    let records = harness.client.response_attempts();
+    if complete {
+        assert_eq!(records.len(), 1);
+        assert_eq!(
+            records[0].end_reason,
+            Some(ResponseAttemptEnd::TransportClosed)
+        );
+        assert_eq!(records[0].account_id.as_deref(), Some("selected-account"));
+        assert!(records[0].ttfb_ms.is_some());
+        assert!(records[0].ttfc_ms.is_some());
+        assert_eq!(records[0].tokens.output, None);
+    } else {
+        assert!(records.is_empty());
+    }
+    server.shutdown().await;
+}
+
+#[tokio::test]
+async fn prewarm_is_excluded_and_committed_output_retains_native_reasoning_order() {
+    skip_if_no_network!();
+    let mut warm = ev_completed("warm");
+    warm["response"]["usage"] = json!({"input_tokens": 13318, "output_tokens": 0,
+        "input_tokens_details": {"cached_tokens": 0}, "output_tokens_details": {"reasoning_tokens": 0}, "total_tokens": 13318});
+    let mut completed = ev_completed("r1");
+    completed["response"]["usage"] = json!({"input_tokens": 100, "input_tokens_details": {"cached_tokens": 60, "cache_write_tokens": 10},
+        "output_tokens": 20, "output_tokens_details": {"reasoning_tokens": 15}, "total_tokens": 120});
+    let server = start_websocket_server(vec![vec![
+        vec![
+            ev_response_created("warm"),
+            json!({"type": "codex.rate_limits", "rate_limits": {
+            "secondary": {"used_percent": 42, "window_minutes": 10080, "reset_at": 1700000000}}}),
+            warm,
+        ],
+        vec![
+            ev_response_created("r1"),
+            ev_reasoning_item_added("reasoning", &[]),
+            json!({"type": "response.reasoning_summary_part.added", "summary_index": 0}),
+            ev_reasoning_summary_text_delta("First paragraph"),
+            ev_reasoning_summary_text_delta("\n\nSecond paragraph"),
+            ev_reasoning_item("reasoning", &["First paragraph\n\nSecond paragraph"], &[]),
+            ev_output_text_delta("Complete answer"),
+            ev_assistant_message("answer", "Complete answer"),
+            completed,
+        ],
+    ]])
+    .await;
+    let harness = websocket_harness_with_provider_options_and_auth(
+        websocket_provider(&server),
+        false,
+        false,
+        &[],
+        Some(personal_auth("plus")),
+    )
+    .await;
+    let mut session = harness.client.new_session();
+    let prompt = prompt_with_input(vec![message_item("hello")]);
+    session
+        .prewarm_websocket(
+            &prompt,
+            &harness.model_info,
+            &harness.session_telemetry,
+            harness.effort.clone(),
+            harness.summary,
+            None,
+            &prewarm_metadata(&harness, None),
+        )
+        .await
+        .unwrap();
+    assert!(harness.client.response_attempts().is_empty());
+    let mut stream = session
+        .stream(
+            &prompt,
+            &harness.model_info,
+            &harness.session_telemetry,
+            harness.effort.clone(),
+            harness.summary,
+            None,
+            &turn_metadata(&harness, Some("turn-1")),
+            &InferenceTraceContext::disabled(),
+        )
+        .await
+        .unwrap();
+    let mut output = Vec::new();
+    while let Some(event) = stream.next().await {
+        match event.unwrap() {
+            ResponseEvent::OutputItemAdded(ResponseItem::Reasoning { .. }) => {
+                output.push("reasoning started".into())
+            }
+            ResponseEvent::ReasoningSummaryPartAdded { summary_index: 0 } => {
+                output.push("summary started".into())
+            }
+            ResponseEvent::ReasoningSummaryDelta {
+                delta,
+                summary_index: 0,
+            } => output.push(delta),
+            ResponseEvent::OutputItemDone(ResponseItem::Reasoning { .. }) => {
+                output.push("reasoning done".into())
+            }
+            ResponseEvent::OutputTextDelta(delta) => output.push(delta),
+            ResponseEvent::OutputItemDone(ResponseItem::Message { .. }) => {
+                output.push("answer done".into())
+            }
+            ResponseEvent::Completed { .. } => output.push("response done".into()),
+            _ => {}
+        }
+    }
+    assert_eq!(
+        output,
+        vec![
+            "reasoning started",
+            "summary started",
+            "First paragraph",
+            "\n\nSecond paragraph",
+            "reasoning done",
+            "Complete answer",
+            "answer done",
+            "response done"
+        ]
+    );
+    let rows = harness.client.response_attempts();
+    assert_eq!(rows.len(), 1);
+    assert_eq!(rows[0].response_id.as_deref(), Some("r1"));
+    assert_eq!(rows[0].request_kind, "generation");
+    assert_eq!(
+        rows[0].tokens,
+        codex_protocol::response_metrics::ResponseTokenCounts {
+            input: Some(100),
+            cache_read: Some(60),
+            cache_write: Some(10),
+            output: Some(20),
+            reasoning: Some(15),
+        }
+    );
+    assert!(rows[0].rate_limits.is_empty());
+    assert_eq!(server.handshakes().len(), 1);
+    let requests = server.single_connection();
+    assert_eq!(requests[0].body_json()["generate"], false);
+    assert_eq!(requests[1].body_json()["previous_response_id"], "warm");
+    server.shutdown().await;
+}
+
+#[tokio::test]
+async fn interrupted_output_retains_usage_without_incremental_continuation() {
+    skip_if_no_network!();
+    let mut interrupted = ev_completed("r1");
+    interrupted["type"] = json!("response.incomplete");
+    interrupted["response"]["incomplete_details"] = json!({"reason": "interrupted"});
+    let server = start_websocket_server(vec![vec![
+        vec![
+            ev_response_created("r1"),
+            ev_assistant_message("m1", "discard this"),
+            interrupted,
+        ],
+        vec![
+            ev_response_created("r2"),
+            ev_assistant_message("m2", "complete answer"),
+            ev_completed("r2"),
+        ],
+    ]])
+    .await;
+    let harness = websocket_harness_with_provider_options_and_auth(
+        websocket_provider(&server),
+        false,
+        false,
+        &[],
+        Some(personal_auth("plus")),
+    )
+    .await;
+    let mut session = harness.client.new_session();
+    let mut stream = session
+        .stream(
+            &prompt_with_input(vec![message_item("hello")]),
+            &harness.model_info,
+            &harness.session_telemetry,
+            harness.effort.clone(),
+            harness.summary,
+            None,
+            &turn_metadata(&harness, Some("turn-1")),
+            &InferenceTraceContext::disabled(),
+        )
+        .await
+        .unwrap();
+    let mut saw_interrupted = false;
+    while let Some(event) = stream.next().await {
+        match event.unwrap() {
+            ResponseEvent::OutputItemAdded(_) | ResponseEvent::OutputItemDone(_) => {
+                panic!("interrupted output escaped")
+            }
+            ResponseEvent::Interrupted { token_usage, .. } => {
+                assert!(token_usage.is_some());
+                saw_interrupted = true;
+            }
+            _ => {}
+        }
+    }
+    assert!(saw_interrupted);
+    let rows = harness.client.response_attempts();
+    assert_eq!(rows[0].end_reason, Some(ResponseAttemptEnd::Interrupted));
+    assert!(rows[0].tokens.output.is_some());
+    stream_until_complete(
+        &mut session,
+        &harness,
+        &prompt_with_input(vec![message_item("hello"), message_item("updated input")]),
+    )
+    .await;
+    let next = server.single_connection()[1].body_json();
+    assert!(next["previous_response_id"].is_null());
+    assert_eq!(next["input"].as_array().unwrap().len(), 2);
+    server.shutdown().await;
+}
