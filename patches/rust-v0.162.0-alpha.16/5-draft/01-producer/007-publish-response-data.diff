+    pub fn page(
+        &self,
+        thread_id: Option<ThreadId>,
+        model: Option<&str>,
+        before: Option<Uuid>,
+        limit: usize,
+    ) -> ResponseAttemptsReadResponse {
+        let history = self.history.lock().expect("response history lock");
+        let mut data: Vec<_> = history
+            .recent
+            .values()
+            .rev()
+            .filter(|row| {
+                let record = &row.record;
+                before.is_none_or(|cursor| record.attempt_id < cursor)
+                    && thread_id.is_none_or(|id| record.thread_id == id)
+                    && model.is_none_or(|model| record.requested_model == model)
+            })
+            .take(limit + 1)
+            .map(PublishedAttempt::snapshot)
+            .collect();
+        let next_cursor = if data.len() > limit {
+            data.truncate(limit);
+            data.last().map(|row| row.attempt_id.to_string())
+        } else {
+            None
+        };
+        ResponseAttemptsReadResponse {
+            data,
+            next_cursor,
+            models: history.models.iter().cloned().collect(),
+            active_attempt_ids: history
+                .recent
+                .values()
+                .filter(|row| row.observed_at.is_some())
+                .map(|row| row.record.attempt_id)
+                .collect(),
+            last_generation: history
+                .last_generations
+                .values()
+                .filter(|last| thread_id.is_none_or(|id| id == last.thread_id))
+                .max_by_key(|last| last.attempt_id)
+                .cloned(),
+            quota: Vec::new(),
+            pricing_error: None,
+            persistence_error: None,
+        }
+    }
+
