+#[tokio::test(start_paused = true)]
+async fn pages_keep_live_identities_and_last_generation_outside_filters() {
+    let home = tempfile::tempdir().unwrap();
+    let metrics = Arc::new(ResponseMetrics::new(home.path()));
+    let first_context = context();
+    let thread_id = first_context.thread_id;
+    let first = metrics.start(first_context, Instant::now(), 1000);
+    first.sent(Instant::now());
+    first.received(
+        ResponseObservation {
+            served_model: Some("served".into()),
+            usage: Some(json!({"output_tokens": 0})),
+            terminal: Some(ResponseAttemptEnd::Failed),
+            ..Default::default()
+        },
+        Instant::now(),
+    );
+    let first_row = metrics.snapshot()[0].clone();
+    let second = metrics.start(context(), Instant::now(), 1000);
+    let second_id = metrics.snapshot()[0].attempt_id;
+    tokio::time::advance(Duration::from_secs(2)).await;
+    let page = metrics.page(None, None, None, 1);
+    assert_eq!(page.data.len(), 1);
+    assert_eq!(page.data[0].attempt_id, second_id);
+    assert_eq!(page.data[0].elapsed_ms, 2000);
+    assert_eq!(page.active_attempt_ids, vec![second_id]);
+    assert_eq!(
+        page.last_generation.unwrap().attempt_id,
+        first_row.attempt_id
+    );
+    let older = metrics.page(None, None, Some(second_id), 1);
+    assert_eq!(older.data, vec![first_row.clone()]);
+    assert_eq!(older.next_cursor, None);
+    let filtered = metrics.page(Some(thread_id), Some("model"), None, 1);
+    assert_eq!(filtered.data, vec![first_row]);
+    assert_eq!(filtered.active_attempt_ids, vec![second_id]);
+    assert_eq!(filtered.models, vec!["model"]);
+    assert!(metrics.page(None, Some("served"), None, 1).data.is_empty());
+    drop(second);
+    assert!(
+        metrics
+            .page(None, None, None, 1)
+            .active_attempt_ids
+            .is_empty()
+    );
+}
