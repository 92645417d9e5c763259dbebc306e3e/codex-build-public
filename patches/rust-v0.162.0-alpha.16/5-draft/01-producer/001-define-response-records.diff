+//! Per-response transport and accounting facts shared by history and presentation.
+
+use crate::ThreadId;
+use schemars::JsonSchema;
+use serde::Deserialize;
+use serde::Serialize;
+use ts_rs::TS;
+use uuid::Uuid;
+
+pub const RECENT_RESPONSE_LIMIT: usize = 1000;
+
+/// Counts reported by the provider, measured in tokens rather than content bytes.
+/// Missing or invalid usage is unknown, distinct from a reported zero.
+#[derive(Debug, Clone, Default, PartialEq, Eq, Serialize, Deserialize, JsonSchema, TS)]
+#[serde(rename_all = "camelCase")]
+pub struct ResponseTokenCounts {
+    #[ts(type = "number | null")]
+    pub input: Option<u64>,
+    #[ts(type = "number | null")]
+    pub cache_read: Option<u64>,
+    #[ts(type = "number | null")]
+    pub cache_write: Option<u64>,
+    #[ts(type = "number | null")]
+    pub output: Option<u64>,
+    #[ts(type = "number | null")]
+    pub reasoning: Option<u64>,
+}
+
+#[derive(
+    Debug,
+    Clone,
+    Copy,
+    PartialEq,
+    Eq,
+    Serialize,
+    Deserialize,
+    JsonSchema,
+    TS,
+    strum_macros::AsRefStr,
+    strum_macros::EnumString,
+)]
+#[serde(rename_all = "camelCase")]
+#[ts(rename_all = "camelCase")]
+#[strum(serialize_all = "camelCase")]
+pub enum ResponseAttemptEnd {
+    Completed,
+    Incomplete,
+    Failed,
+    Interrupted,
+    Canceled,
+    SetupFailed,
+    SendFailed,
+    TransportClosed,
+    ProgressTimeout,
+    ProtocolError,
+}
+
+/// Weekly quota facts ordered with request starts and usage receipts.
+#[derive(Debug, Clone, PartialEq, Serialize, Deserialize, JsonSchema, TS)]
+#[serde(rename_all = "camelCase")]
+pub struct ResponseQuotaObservation {
+    #[schemars(with = "String")]
+    pub sequence: Uuid,
+    pub limit_id: String,
+    /// Unknown when the receipt does not contain a valid weekly window.
+    pub used_percent: Option<f64>,
+    #[ts(type = "number | null")]
+    pub resets_at: Option<i64>,
+}
+
+#[derive(Debug, Clone, PartialEq, Eq, PartialOrd, Ord, Serialize, Deserialize, JsonSchema, TS)]
+#[serde(rename_all = "camelCase")]
+pub struct ResponseQuotaScope {
+    pub provider: String,
+    pub account_id: Option<String>,
+    pub limit_id: String,
+}
+
+/// Weekly quota evidence is independent of response-browser filters.
+#[derive(Debug, Clone, PartialEq, Serialize, Deserialize, JsonSchema, TS)]
+#[serde(rename_all = "camelCase")]
+pub struct ResponseQuotaEstimate {
+    pub scope: ResponseQuotaScope,
+    #[ts(type = "number | null")]
+    pub resets_at: Option<i64>,
+    pub remaining_percent: u8,
+    #[schemars(with = "String")]
+    pub last_sequence: Uuid,
+    pub observations: usize,
+    pub intervals: usize,
+    pub value: Option<ResponseQuotaEstimateRange>,
+}
+
+/// Descriptive spread of overlapping samples, not a confidence interval.
+#[derive(Debug, Clone, Copy, PartialEq, Serialize, Deserialize, JsonSchema, TS)]
+#[serde(rename_all = "camelCase")]
+pub struct ResponseQuotaEstimateRange {
+    pub center: f64,
+    pub low: f64,
+    pub high: f64,
+}
+
+/// One actual request attempt. Transport time excludes buffered output delivery.
+#[derive(Debug, Clone, PartialEq, Serialize, Deserialize, JsonSchema, TS)]
+#[serde(rename_all = "camelCase")]
+pub struct ResponseAttempt {
+    /// Internal time-ordered key for snapshots, storage, and pagination.
+    #[schemars(with = "String")]
+    pub attempt_id: Uuid,
+    /// Orders snapshots and notifications of the same attempt.
+    #[ts(type = "number")]
+    pub revision: u64,
+    pub thread_id: ThreadId,
+    /// Existing turn identity used to isolate live progress from other turns.
+    pub turn_id: Option<String>,
+    /// Official provider response ID, absent before the provider supplies it.
+    pub response_id: Option<String>,
+    pub request_kind: String,
+    pub provider: String,
+    pub account_id: Option<String>,
+    pub requested_model: String,
+    pub served_model: Option<String>,
+    pub reasoning_effort: Option<String>,
+    /// Unix seconds; elapsed fields use the monotonic transport clock.
+    #[ts(type = "number")]
+    pub started_at: i64,
+    /// Send to the first nonempty WebSocket text payload.
+    #[ts(type = "number | null")]
+    pub ttfb_ms: Option<u64>,
+    /// Send to the first nonempty model-content field.
+    #[ts(type = "number | null")]
+    pub ttfc_ms: Option<u64>,
+    #[schemars(with = "Option<String>")]
+    pub usage_observed_sequence: Option<Uuid>,
+    pub rate_limits: Vec<ResponseQuotaObservation>,
+    #[ts(type = "number | null")]
+    pub terminal_observed_offset_ms: Option<u64>,
+    /// Setup plus receipt time, frozen at the response boundary.
+    #[ts(type = "number")]
+    pub elapsed_ms: u64,
+    /// Model-protocol UTF-8 payload bytes, excluding transport overhead.
+    #[ts(type = "number | null")]
+    pub sent_payload_bytes: Option<u64>,
+    /// Model-protocol UTF-8 payload bytes, excluding transport overhead.
+    #[ts(type = "number")]
+    pub received_payload_bytes: u64,
+    /// None also represents an unfinished record retained from an earlier process.
+    pub end_reason: Option<ResponseAttemptEnd>,
+    pub tokens: ResponseTokenCounts,
+    /// Reported output tokens per send-to-usage second, including upstream waiting.
+    pub tps: Option<f64>,
+}
+
+/// Status-line facts retained after a full record leaves the recent queue.
+#[derive(Debug, Clone, PartialEq, Serialize, Deserialize, JsonSchema, TS)]
+#[serde(rename_all = "camelCase")]
+pub struct ResponsePerformance {
+    #[schemars(with = "String")]
+    pub attempt_id: Uuid,
+    pub thread_id: ThreadId,
+    #[ts(type = "number | null")]
+    pub ttfb_ms: Option<u64>,
+    #[ts(type = "number | null")]
+    pub ttfc_ms: Option<u64>,
+    pub tps: Option<f64>,
+}
+
+impl From<&ResponseAttempt> for ResponsePerformance {
+    fn from(row: &ResponseAttempt) -> Self {
+        Self {
+            attempt_id: row.attempt_id,
+            thread_id: row.thread_id,
+            ttfb_ms: row.ttfb_ms,
+            ttfc_ms: row.ttfc_ms,
+            tps: row.tps,
+        }
+    }
+}
