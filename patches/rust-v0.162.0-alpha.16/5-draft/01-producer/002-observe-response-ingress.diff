+use super::*;
+use pretty_assertions::assert_eq;
+use serde_json::json;
+
+fn observe(payload: Value) -> ResponseObservation {
+    let payload = payload.to_string();
+    ResponseObservation::from_event(&serde_json::from_str(&payload).unwrap(), &payload)
+}
+
+#[test]
+fn failed_response_retains_usage_without_treating_error_text_as_content() {
+    let usage = json!({"input_tokens": 100, "input_tokens_details": {"cached_tokens": 80},
+        "output_tokens": 12, "output_tokens_details": {"reasoning_tokens": 5}});
+    let observation = observe(json!({"type": "response.failed", "response": {
+        "id": "r1", "status": "failed", "model": "served-model", "usage": usage,
+        "error": {"code": "failure", "message": "not model output"}
+    }}));
+    assert_eq!(observation.terminal, Some(ResponseAttemptEnd::Failed));
+    assert!(!observation.has_content);
+    assert_eq!(observation.usage, Some(usage));
+    assert_eq!(observation.served_model.as_deref(), Some("served-model"));
+}
+
+#[test]
+fn quota_ingress_preserves_window_precision_without_model_content() {
+    let observation = observe(
+        json!({"type": "codex.rate_limits", "metered_limit_name": "codex",
+        "rate_limits": {"secondary": {"used_percent": 12.5,
+            "window_minutes": 10080, "reset_at": 1704074400}}}),
+    );
+    assert!(!observation.has_content);
+    assert_eq!(observation.terminal, None);
+    let quota = observation.rate_limits.unwrap();
+    assert_eq!(quota.limit_id.as_deref(), Some("codex"));
+    let weekly = quota.secondary.unwrap();
+    assert_eq!(weekly.used_percent, 12.5);
+    assert_eq!(weekly.window_minutes, Some(10080));
+    assert_eq!(weekly.resets_at, Some(1704074400));
+}
+
+#[test]
+fn model_progress_recognizes_native_content_without_counting_control_fields() {
+    for item in [
+        json!({"type": "message", "content": [{"type": "output_text", "text": "answer"}]}),
+        json!({"type": "reasoning", "summary": [{"type": "summary_text", "text": "reason"}]}),
+        json!({"type": "reasoning", "encrypted_content": "opaque"}),
+        json!({"type": "function_call", "arguments": "{}"}),
+        json!({"type": "function_call", "encrypted_function_args": ["opaque"]}),
+        json!({"type": "custom_tool_call", "input": "command"}),
+        json!({"type": "compaction", "encrypted_content": "opaque"}),
+    ] {
+        assert!(observe(json!({"type": "response.output_item.done", "item": item})).has_content);
+        assert!(
+            observe(json!({"type": "response.completed", "response": {"output": [item]}}))
+                .has_content
+        );
+    }
+    for payload in [
+        json!({"type": "response.created", "response": {"id": "r1"}}),
+        json!({"type": "codex.response.metadata", "headers": {"openai-model": "model"}}),
+        json!({"type": "response.output_item.added", "item": {"type": "function_call", "name": "tool", "arguments": ""}}),
+        json!({"type": "response.output_text.delta", "delta": ""}),
+        json!({"type": "error", "error": {"message": "failure"}}),
+    ] {
+        assert!(!observe(payload).has_content);
+    }
+    for payload in [
+        json!({"type": "response.output_text.delta", "delta": "a"}),
+        json!({"type": "response.reasoning_summary_text.delta", "delta": "b"}),
+        json!({"type": "response.function_call_arguments.delta", "delta": "{"}),
+        json!({"type": "response.custom_tool_call_input.done", "input": "command"}),
+        json!({"type": "response.content_part.done", "part": {"type": "refusal", "refusal": "declined"}}),
+    ] {
+        assert!(observe(payload).has_content);
+    }
+}
diff --git a/codex-rs/codex-api/src/response_progress.rs b/codex-rs/codex-api/src/response_progress.rs
new file mode 100644
--- /dev/null
+++ b/codex-rs/codex-api/src/response_progress.rs
@@ -0,0 +1,95 @@
+//! The socket pump owns the unfinished response's content deadline.
+
+use crate::ApiError;
+use crate::response_observation::ResponseObservation;
+use crate::response_observation::ResponseObserver;
+use crate::sse::ResponsesStreamEvent;
+use codex_protocol::response_metrics::ResponseAttemptEnd;
+use std::sync::Arc;
+use std::time::Duration;
+use tokio::time::Instant;
+
+const CONTENT_TIMEOUT: Duration = Duration::from_secs(300);
+
+pub(crate) struct ResponseProgress {
+    pub(crate) deadline: Instant,
+    response_id: Option<String>,
+    observer: Option<Arc<dyn ResponseObserver>>,
+}
+
+impl ResponseProgress {
+    pub(crate) fn sent(at: Instant, observer: Option<Arc<dyn ResponseObserver>>) -> Self {
+        if let Some(observer) = &observer {
+            observer.sent(at);
+        }
+        Self {
+            deadline: at + CONTENT_TIMEOUT,
+            response_id: None,
+            observer,
+        }
+    }
+
+    /// A terminal receipt stops the watchdog before downstream publication.
+    pub(crate) fn receive(&mut self, payload: &str, at: Instant) -> Result<bool, ApiError> {
+        if at > self.deadline {
+            self.end(ResponseAttemptEnd::ProgressTimeout, at);
+            return Err(ApiError::ResponseProgressTimeout);
+        }
+        let event = match serde_json::from_str::<ResponsesStreamEvent>(payload) {
+            Ok(event) => event,
+            Err(_) => {
+                if let Some(observer) = &self.observer {
+                    observer.received(
+                        ResponseObservation {
+                            payload_bytes: payload.len() as u64,
+                            ..Default::default()
+                        },
+                        at,
+                    );
+                }
+                return Ok(false);
+            }
+        };
+        let observation = ResponseObservation::from_event(&event, payload);
+        if let Some(id) = &observation.response_id {
+            if self
+                .response_id
+                .as_ref()
+                .is_some_and(|current| current != id)
+            {
+                self.end(ResponseAttemptEnd::ProtocolError, at);
+                return Err(ApiError::Stream(
+                    "response ID differs from the active response".into(),
+                ));
+            }
+            self.response_id.clone_from(&observation.response_id);
+        }
+        if observation.has_content {
+            self.deadline = at + CONTENT_TIMEOUT;
+        }
+        let terminal = observation.terminal.is_some();
+        if let Some(observer) = &self.observer {
+            observer.received(observation, at);
+        }
+        if terminal {
+            self.observer = None;
+        }
+        Ok(terminal)
+    }
+
+    pub(crate) fn end(&mut self, reason: ResponseAttemptEnd, at: Instant) {
+        if let Some(observer) = self.observer.take() {
+            observer.ended(reason, at);
+        }
+    }
+}
+
+impl Drop for ResponseProgress {
+    fn drop(&mut self) {
+        self.end(ResponseAttemptEnd::Canceled, Instant::now());
+    }
+}
+
+#[cfg(test)]
+#[path = "response_progress_tests.rs"]
+mod tests;
