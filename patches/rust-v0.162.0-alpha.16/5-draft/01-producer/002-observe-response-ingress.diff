+//! Request-scoped observations taken at wire receipt, before output publication.
+
+use crate::rate_limits::parse_rate_limit_event;
+use crate::sse::ResponsesStreamEvent;
+use codex_protocol::protocol::RateLimitSnapshot;
+use codex_protocol::response_metrics::ResponseAttemptEnd;
+use serde_json::Value;
+use tokio::time::Instant;
+
+/// Records facts synchronously without waiting on storage or UI consumers.
+/// Implementations do not control buffering or content-progress deadlines.
+pub trait ResponseObserver: Send + Sync {
+    /// Counts serialized model-protocol UTF-8 bytes without retaining the request.
+    fn prepared(&self, payload_bytes: u64);
+    /// Marks the socket pump's actual request-send origin.
+    fn sent(&self, at: Instant);
+    /// The served model may precede `sent` without timing or byte observations.
+    fn received(&self, observation: ResponseObservation, at: Instant);
+    /// Ends the attempt without replacing an already observed protocol ending.
+    fn ended(&self, reason: ResponseAttemptEnd, at: Instant);
+}
+
+#[derive(Debug, Default)]
+pub struct ResponseObservation {
+    pub payload_bytes: u64,
+    pub has_content: bool,
+    pub response_id: Option<String>,
+    pub served_model: Option<String>,
+    pub usage: Option<Value>,
+    pub rate_limits: Option<RateLimitSnapshot>,
+    pub terminal: Option<ResponseAttemptEnd>,
+}
+
+impl ResponseObservation {
+    pub(crate) fn from_event(event: &ResponsesStreamEvent, payload: &str) -> Self {
+        let response = event.response.as_ref();
+        let text_field = |field: &str| {
+            response
+                .and_then(|response| response.get(field))
+                .and_then(Value::as_str)
+                .map(str::to_owned)
+        };
+        let terminal = match event.kind() {
+            "response.completed" => Some(ResponseAttemptEnd::Completed),
+            "response.failed" => Some(ResponseAttemptEnd::Failed),
+            "response.incomplete" => Some(
+                if response
+                    .and_then(|response| response.pointer("/incomplete_details/reason"))
+                    .and_then(Value::as_str)
+                    == Some("interrupted")
+                {
+                    ResponseAttemptEnd::Interrupted
+                } else {
+                    ResponseAttemptEnd::Incomplete
+                },
+            ),
+            _ => None,
+        };
+        Self {
+            payload_bytes: payload.len() as u64,
+            has_content: has_content(event),
+            response_id: text_field("id").or_else(|| {
+                event
+                    .response_id
+                    .as_ref()
+                    .and_then(Value::as_str)
+                    .map(str::to_owned)
+            }),
+            served_model: event.response_model().or_else(|| text_field("model")),
+            usage: response
+                .and_then(|response| response.get("usage"))
+                .filter(|value| value.is_object())
+                .cloned(),
+            rate_limits: (event.kind() == "codex.rate_limits")
+                .then(|| parse_rate_limit_event(payload))
+                .flatten(),
+            terminal,
+        }
+    }
+}
+
+/// Detects actual model fields without retaining or counting their contents.
+fn has_content(event: &ResponsesStreamEvent) -> bool {
+    match event.kind() {
+        "response.completed" | "response.incomplete" | "response.failed" => event
+            .response
+            .as_ref()
+            .and_then(|response| response.get("output"))
+            .and_then(Value::as_array)
+            .is_some_and(|items| items.iter().any(item_has_content)),
+        "response.output_item.added" | "response.output_item.done" => {
+            event.item.as_ref().is_some_and(item_has_content)
+        }
+        "response.output_text.delta"
+        | "response.refusal.delta"
+        | "response.reasoning_text.delta"
+        | "response.reasoning_summary_text.delta"
+        | "response.function_call_arguments.delta"
+        | "response.custom_tool_call_input.delta" => {
+            event.delta.as_ref().is_some_and(|text| !text.is_empty())
+        }
+        "response.output_text.done"
+        | "response.reasoning_text.done"
+        | "response.reasoning_summary_text.done" => {
+            event.text.as_ref().is_some_and(|text| !text.is_empty())
+        }
+        "response.refusal.done" => nonempty(event.refusal.as_ref()),
+        "response.function_call_arguments.done" => nonempty(event.arguments.as_ref()),
+        "response.custom_tool_call_input.done" => nonempty(event.input.as_ref()),
+        "response.reasoning_summary_part.added" | "response.reasoning_summary_part.done" => {
+            nonempty(event.part.as_ref().and_then(|part| part.get("text")))
+        }
+        "response.content_part.added" | "response.content_part.done" => {
+            event.part.as_ref().is_some_and(part_has_content)
+        }
+        _ => false,
+    }
+}
+
+fn nonempty(value: Option<&Value>) -> bool {
+    value
+        .and_then(Value::as_str)
+        .is_some_and(|text| !text.is_empty())
+}
+
+fn part_has_content(part: &Value) -> bool {
+    matches!(
+        part.get("type").and_then(Value::as_str),
+        Some("output_text" | "refusal" | "summary_text" | "reasoning_text" | "text")
+    ) && (nonempty(part.get("text")) || nonempty(part.get("refusal")))
+}
+
+fn item_has_content(item: &Value) -> bool {
+    let kind = item.get("type").and_then(Value::as_str);
+    let content = match kind {
+        Some("message" | "reasoning") => ["content", "summary"].iter().any(|field| {
+            item.get(field)
+                .and_then(Value::as_array)
+                .is_some_and(|parts| parts.iter().any(part_has_content))
+        }),
+        Some("function_call") => {
+            nonempty(item.get("arguments"))
+                || item
+                    .get("encrypted_function_args")
+                    .and_then(Value::as_array)
+                    .is_some_and(|args| args.iter().any(|value| nonempty(Some(value))))
+        }
+        Some("custom_tool_call") => nonempty(item.get("input")),
+        _ => false,
+    };
+    content
+        || (matches!(
+            kind,
+            Some("reasoning" | "compaction" | "compaction_summary" | "context_compaction")
+        ) && nonempty(item.get("encrypted_content")))
+}
+
+#[cfg(test)]
+#[path = "response_observation_tests.rs"]
+mod tests;
