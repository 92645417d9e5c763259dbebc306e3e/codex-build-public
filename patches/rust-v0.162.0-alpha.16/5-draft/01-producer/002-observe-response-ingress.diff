+++ b/codex-rs/codex-api/src/response_progress_tests.rs
@@ -0,0 +1,146 @@
+use super::*;
+use pretty_assertions::assert_eq;
+use std::sync::Mutex;
+
+#[derive(Default)]
+struct Observations(Mutex<Vec<ResponseObservation>>);
+
+impl ResponseObserver for Observations {
+    fn prepared(&self, _: u64) {}
+    fn sent(&self, _: Instant) {}
+    fn received(&self, observation: ResponseObservation, _: Instant) {
+        self.0.lock().unwrap().push(observation);
+    }
+    fn ended(&self, reason: ResponseAttemptEnd, at: Instant) {
+        self.received(
+            ResponseObservation {
+                terminal: Some(reason),
+                ..Default::default()
+            },
+            at,
+        );
+    }
+}
+
+#[test]
+fn transport_close_ends_observation_once() {
+    let now = Instant::now();
+    let observations = Arc::new(Observations::default());
+    let mut progress = ResponseProgress::sent(now, Some(observations.clone()));
+    progress
+        .receive(
+            r#"{"type":"response.output_text.delta","delta":"partial answer"}"#,
+            now,
+        )
+        .unwrap();
+    progress.end(ResponseAttemptEnd::TransportClosed, now);
+    drop(progress);
+    let records = observations.0.lock().unwrap();
+    assert_eq!(records.len(), 2);
+    assert!(records[0].has_content);
+    assert_eq!(
+        records[1].terminal,
+        Some(ResponseAttemptEnd::TransportClosed)
+    );
+}
+
+#[test]
+fn controls_do_not_extend_the_content_deadline_without_an_observer() {
+    let now = Instant::now();
+    let mut progress = ResponseProgress::sent(now, None);
+    for payload in [
+        r#"{"type":"response.created","response":{"id":"r1"}}"#,
+        r#"{"type":"codex.response.metadata"}"#,
+        r#"{"type":"response.output_text.delta","delta":""}"#,
+    ] {
+        assert!(
+            !progress
+                .receive(payload, now + Duration::from_secs(299))
+                .unwrap()
+        );
+        assert_eq!(progress.deadline, now + CONTENT_TIMEOUT);
+    }
+    assert!(matches!(
+        progress.receive(
+            r#"{"type":"response.completed","response":{"id":"r1"}}"#,
+            now + Duration::from_secs(301),
+        ),
+        Err(ApiError::ResponseProgressTimeout)
+    ));
+}
+
+#[test]
+fn content_extends_progress_until_a_matching_terminal() {
+    let now = Instant::now();
+    let mut progress = ResponseProgress::sent(now, None);
+    assert!(
+        !progress
+            .receive(r#"{"type":"response.created","response":{"id":"r1"}}"#, now)
+            .unwrap()
+    );
+    assert!(!progress.receive(
+        r#"{"type":"response.output_item.done","item":{"type":"reasoning","encrypted_content":"opaque"}}"#,
+        now + Duration::from_secs(299),
+    ).unwrap());
+    assert_eq!(progress.deadline, now + Duration::from_secs(599));
+    assert!(
+        progress
+            .receive(
+                r#"{"type":"response.completed","response":{"id":"r1"}}"#,
+                now + Duration::from_secs(598)
+            )
+            .unwrap()
+    );
+}
+
+#[test]
+fn a_foreign_terminal_cannot_end_the_active_response() {
+    let now = Instant::now();
+    let observations = Arc::new(Observations::default());
+    let mut progress = ResponseProgress::sent(now, Some(observations.clone()));
+    progress
+        .receive(r#"{"type":"response.created","response":{"id":"r1"}}"#, now)
+        .unwrap();
+    assert!(
+        progress
+            .receive(
+                r#"{"type":"response.completed","response":{"id":"r2"}}"#,
+                now
+            )
+            .is_err()
+    );
+    drop(progress);
+    let records = observations.0.lock().unwrap();
+    assert_eq!(
+        records.last().unwrap().terminal,
+        Some(ResponseAttemptEnd::ProtocolError)
+    );
+    assert!(
+        !records
+            .iter()
+            .any(|row| row.terminal == Some(ResponseAttemptEnd::Completed))
+    );
+}
+
+#[test]
+fn terminal_usage_is_observed_before_cancellation_can_overwrite_it() {
+    let now = Instant::now();
+    let observations = Arc::new(Observations::default());
+    let mut progress = ResponseProgress::sent(now, Some(observations.clone()));
+    assert!(
+        progress
+            .receive(
+                r#"{"type":"response.failed","response":{"id":"r1","usage":{"output_tokens":0}}}"#,
+                now
+            )
+            .unwrap()
+    );
+    drop(progress);
+    let records = observations.0.lock().unwrap();
+    assert_eq!(records.len(), 1);
+    assert_eq!(records[0].terminal, Some(ResponseAttemptEnd::Failed));
+    assert_eq!(
+        records[0].usage,
+        Some(serde_json::json!({"output_tokens": 0}))
+    );
+}
