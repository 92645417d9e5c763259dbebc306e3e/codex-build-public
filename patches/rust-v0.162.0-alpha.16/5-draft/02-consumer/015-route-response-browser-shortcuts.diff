+#[tokio::test]
+async fn response_shortcut_respects_bindings_modals_and_legacy_vim_escape() -> anyhow::Result<()> {
+    let mut app = crate::app::test_support::make_test_app().await;
+    let mut tui = crate::tui::test_support::make_test_tui()?;
+    let key = KeyEvent::new(KeyCode::Char('/'), KeyModifiers::ALT);
+    assert!(!response_browser_shortcut(KeyEvent::new_with_kind(
+        KeyCode::Char('/'),
+        KeyModifiers::ALT,
+        KeyEventKind::Release
+    )));
+    assert!(app.route_key_chord_event(&mut tui, key).is_none());
+    let config = toml::from_str("[composer]\nsubmit = 'alt-/'")?;
+    app.keymap = crate::keymap::RuntimeKeymap::from_config(&config).expect("keymap");
+    app.chat_widget.apply_keymap_update(config, &app.keymap);
+    assert_eq!(app.route_key_chord_event(&mut tui, key), Some(key));
+    app.keymap = crate::keymap::RuntimeKeymap::defaults();
+    app.chat_widget.toggle_vim_mode_and_notify();
+    app.chat_widget.insert_str("abc");
+    app.chat_widget.handle_key_event(KeyCode::Char('i').into());
+    assert!(
+        app.chat_widget
+            .should_handle_vim_insert_escape(KeyCode::Esc.into())
+    );
+    assert!(!app.should_recover_vim_insert_escape(key));
+    app.chat_widget.open_keymap_debug(&app.keymap);
+    assert_eq!(app.route_key_chord_event(&mut tui, key), Some(key));
+    Ok(())
+}
