+#[tokio::test]
+async fn alt_slash_opens_and_refreshes_through_native_key_and_app_event_dispatch()
+-> crate::app::Result<()> {
+    let (mut app, mut events, mut ops) = crate::app::tests::make_test_app_with_channels().await;
+    let mut tui = crate::tui::test_support::make_test_tui()?;
+    let mut server = crate::start_embedded_app_server_for_picker(&app.config).await?;
+    for _ in 0..2 {
+        app.handle_tui_event(
+            &mut tui,
+            &mut server,
+            tui::TuiEvent::Key(KeyEvent::new(KeyCode::Char('/'), KeyModifiers::ALT)),
+        )
+        .await?;
+        let open = loop {
+            if let event @ AppEvent::OpenResponseBrowser =
+                events.try_recv().map_err(color_eyre::Report::msg)?
+            {
+                break event;
+            }
+        };
+        app.handle_event(&mut tui, &mut server, open).await?;
+        let id = loop {
+            if let AppEvent::ReadResponseAttempts { request_id, .. } =
+                events.try_recv().map_err(color_eyre::Report::msg)?
+            {
+                break request_id;
+            }
+        };
+        assert!(
+            matches!(&app.overlay, Some(Overlay::Responses(browser)) if browser.history.accepts(id))
+        );
+        assert!(
+            app.active_keymap_contexts()
+                .contains(crate::keymap::KeymapContext::List)
+        );
+        app.finish_response_attempts(id, Ok(page(Vec::new())), Ok(Prices::new()));
+    }
+    assert!(ops.try_recv().is_err());
+    server.shutdown().await?;
+    Ok(())
+}
