+//! One ordered writer keeps disk work outside response generation.
+
+use super::ResponseMetrics;
+use codex_protocol::response_metrics::RECENT_RESPONSE_LIMIT;
+use codex_protocol::response_metrics::ResponseAttempt;
+use codex_state::ResponseHistoryStore;
+use std::path::PathBuf;
+use std::sync::Weak;
+use tokio::sync::mpsc;
+use tokio::sync::oneshot;
+use tokio::sync::watch;
+
+#[derive(Debug)]
+pub(super) struct Backup {
+    sender: mpsc::UnboundedSender<Command>,
+    status: watch::Receiver<Option<Result<ResponseHistoryStore, String>>>,
+}
+
+enum Command {
+    Write(ResponseAttempt),
+    Flush(oneshot::Sender<Result<(), String>>),
+}
+
+impl Backup {
+    pub(super) fn start(home: PathBuf, metrics: Weak<ResponseMetrics>) -> Self {
+        let (sender, mut receiver) = mpsc::unbounded_channel();
+        let (status_tx, status) = watch::channel(None);
+        tokio::spawn(async move {
+            let store = async {
+                let store = ResponseHistoryStore::open(&home).await?;
+                restore(&store, metrics).await?;
+                anyhow::Ok(store)
+            }
+            .await;
+            let mut failure = store.as_ref().err().map(|error| format!("{error:#}"));
+            if let Some(error) = &failure {
+                tracing::warn!(%error, "response history unavailable");
+            }
+            status_tx.send_replace(Some(match &store {
+                Ok(store) => Ok(store.clone()),
+                Err(error) => Err(format!("{error:#}")),
+            }));
+            while let Some(command) = receiver.recv().await {
+                match command {
+                    Command::Write(record) => {
+                        if let Ok(store) = &store
+                            && let Err(error) = store.write(&record).await
+                        {
+                            let error = format!("{error:#}");
+                            tracing::warn!(%error, "could not persist response history");
+                            failure = Some(error.clone());
+                            status_tx.send_replace(Some(Err(error)));
+                        }
+                    }
+                    Command::Flush(reply) => {
+                        let _ = reply.send(failure.clone().map_or(Ok(()), Err));
+                    }
+                }
+            }
+        });
+        Self { sender, status }
+    }
+
+    pub(super) fn write(&self, record: ResponseAttempt) {
+        // The receiver drains until every service owner has released its sender.
+        if self.sender.send(Command::Write(record)).is_err() {
+            tracing::warn!("response history writer stopped");
+        }
+    }
+
+    pub(super) fn error(&self) -> Option<String> {
+        if self.sender.is_closed() {
+            return Some("response history writer stopped".into());
+        }
+        self.status
+            .borrow()
+            .as_ref()
+            .and_then(|status| status.as_ref().err())
+            .cloned()
+    }
+
+    pub(super) fn is_ready(&self) -> bool {
+        self.status.borrow().is_some()
+    }
+
+    pub(super) async fn ready(&self) -> Result<ResponseHistoryStore, String> {
+        let mut status = self.status.clone();
+        status
+            .wait_for(Option::is_some)
+            .await
+            .map_err(|_| "response history writer stopped".to_owned())?
+            .as_ref()
+            .expect("initialized response history")
+            .clone()
+    }
+
+    pub(super) async fn flush(&self) -> Result<(), String> {
+        let (reply, done) = oneshot::channel();
+        self.sender
+            .send(Command::Flush(reply))
+            .map_err(|_| "response history writer stopped".to_owned())?;
+        done.await
+            .map_err(|_| "response history writer stopped".to_owned())?
+    }
+}
+
+async fn restore(
+    store: &ResponseHistoryStore,
+    metrics: Weak<ResponseMetrics>,
+) -> anyhow::Result<()> {
+    let page = store.page(None, None, None, RECENT_RESPONSE_LIMIT).await?;
+    let models = store.models().await?;
+    let last_generations = store.last_generations().await?;
+    if let Some(metrics) = metrics.upgrade() {
+        metrics.restore(page, models, last_generations);
+    }
+    Ok(())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::response_metrics::tests::context;
+    use codex_api::ResponseObservation;
+    use codex_api::ResponseObserver;
+    use codex_protocol::response_metrics::ResponseAttemptEnd;
+    use pretty_assertions::assert_eq;
+    use std::sync::Arc;
+    use std::time::Duration;
+    use tokio::time::Instant;
+
+    #[tokio::test]
+    async fn recent_pages_do_not_wait_for_storage_initialization_or_writes() {
+        let home = tempfile::tempdir().unwrap();
+        let metrics = Arc::new(ResponseMetrics::new(home.path()));
+        let (sender, mut pending) = mpsc::unbounded_channel();
+        let (_status_tx, status) = watch::channel(None);
+        metrics.backup.set(Backup { sender, status }).unwrap();
+        let mut updates = metrics.subscribe();
+        let now = Instant::now();
+        let attempt = metrics.start(context(), now, 1000);
+        attempt.prepared(512);
+        attempt.sent(now);
+        attempt.received(
+            ResponseObservation {
+                payload_bytes: 300,
+                response_id: Some("resp-official".into()),
+                ..Default::default()
+            },
+            now + Duration::from_millis(200),
+        );
+        attempt.ended(ResponseAttemptEnd::Completed, now + Duration::from_secs(1));
+        let page =
+            tokio::time::timeout(Duration::from_secs(1), metrics.page(None, None, None, 100))
+                .await
+                .unwrap();
+        assert_eq!(page.data, metrics.snapshot());
+        assert_eq!(page.data[0].received_payload_bytes, 300);
+        assert!(page.next_cursor.is_some());
+        let mut saved = Vec::new();
+        while let Ok(Command::Write(record)) = pending.try_recv() {
+            saved.push(record);
+        }
+        let saved_record = saved.last().unwrap();
+        assert_eq!(saved_record, &page.data[0]);
+        assert_eq!(saved_record.sent_payload_bytes, Some(512));
+        assert_eq!(saved_record.response_id.as_deref(), Some("resp-official"));
+        assert_eq!(saved_record.elapsed_ms, 1000);
+        let mut last = None;
+        while let Ok(update) = updates.try_recv() {
+            last = Some(update);
+        }
+        assert_eq!(last, Some(saved_record.clone()));
+    }
+}
