@@ -0,0 +1,397 @@
+//! Feature-owned response history, independent of rollout and thread databases.
+
+use crate::SqliteConfig;
+use anyhow::Context;
+use codex_protocol::ThreadId;
+use codex_protocol::response_metrics::ResponseAttempt;
+use codex_protocol::response_metrics::ResponsePerformance;
+use codex_protocol::response_metrics::ResponseQuotaObservation;
+use codex_protocol::response_metrics::ResponseTokenCounts;
+use codex_utils_absolute_path::AbsolutePathBuf;
+use sqlx::QueryBuilder;
+use sqlx::Row;
+use sqlx::Sqlite;
+use sqlx::SqlitePool;
+use sqlx::migrate::Migrator;
+use sqlx::sqlite::SqliteRow;
+use std::num::TryFromIntError;
+use std::path::Path;
+use uuid::Uuid;
+
+static MIGRATOR: Migrator = sqlx_macros::migrate!("./response_history_migrations");
+
+#[derive(Clone, Debug)]
+pub struct ResponseHistoryStore {
+    pool: SqlitePool,
+}
+
+pub struct ResponseHistoryPage {
+    pub data: Vec<ResponseAttempt>,
+    pub next_cursor: Option<Uuid>,
+}
+
+impl ResponseHistoryStore {
+    pub async fn open(codex_home: &Path) -> anyhow::Result<Self> {
+        let sqlite = SqliteConfig::from_sqlite_home(AbsolutePathBuf::try_from(codex_home)?);
+        let sessions = codex_home.join("sessions");
+        tokio::fs::create_dir_all(&sessions)
+            .await
+            .with_context(|| format!("could not create {}", sessions.display()))?;
+        let path = sessions.join("responses.sqlite3");
+        let pool = sqlite
+            .open_read_write_pool(&path)
+            .await
+            .with_context(|| format!("could not open {}", path.display()))?;
+        MIGRATOR
+            .run(&pool)
+            .await
+            .with_context(|| format!("could not initialize {}", path.display()))?;
+        Ok(Self { pool })
+    }
+
+    /// The response service's single writer supplies snapshots in publication order.
+    pub async fn write(&self, record: &ResponseAttempt) -> anyhow::Result<()> {
+        let mut transaction = self.pool.begin().await?;
+        sqlx::query(
+            "INSERT INTO responses (id, revision, thread_id, turn_id, response_id, request_kind, \
+                provider, account_id, requested_model, served_model, reasoning_effort, \
+                started_at, ttfb_ms, ttfc_ms, usage_sequence, terminal_offset_ms, elapsed_ms, \
+                sent_bytes, received_bytes, end_reason, input_tokens, cache_read_tokens, \
+                cache_write_tokens, output_tokens, reasoning_tokens, tps) \
+             VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?) \
+             ON CONFLICT(id) DO UPDATE SET revision = excluded.revision, \
+                response_id = excluded.response_id, requested_model = excluded.requested_model, \
+                served_model = excluded.served_model, reasoning_effort = excluded.reasoning_effort, \
+                ttfb_ms = excluded.ttfb_ms, ttfc_ms = excluded.ttfc_ms, \
+                usage_sequence = excluded.usage_sequence, terminal_offset_ms = excluded.terminal_offset_ms, \
+                elapsed_ms = excluded.elapsed_ms, sent_bytes = excluded.sent_bytes, \
+                received_bytes = excluded.received_bytes, end_reason = excluded.end_reason, \
+                input_tokens = excluded.input_tokens, cache_read_tokens = excluded.cache_read_tokens, \
+                cache_write_tokens = excluded.cache_write_tokens, output_tokens = excluded.output_tokens, \
+                reasoning_tokens = excluded.reasoning_tokens, tps = excluded.tps",
+        )
+        .bind(record.attempt_id.to_string())
+        .bind(i64::try_from(record.revision)?)
+        .bind(record.thread_id.to_string())
+        .bind(&record.turn_id)
+        .bind(&record.response_id)
+        .bind(&record.request_kind)
+        .bind(&record.provider)
+        .bind(&record.account_id)
+        .bind(&record.requested_model)
+        .bind(&record.served_model)
+        .bind(&record.reasoning_effort)
+        .bind(record.started_at)
+        .bind(sql_count(record.ttfb_ms)?)
+        .bind(sql_count(record.ttfc_ms)?)
+        .bind(record.usage_observed_sequence.map(|sequence| sequence.to_string()))
+        .bind(sql_count(record.terminal_observed_offset_ms)?)
+        .bind(i64::try_from(record.elapsed_ms)?)
+        .bind(sql_count(record.sent_payload_bytes)?)
+        .bind(i64::try_from(record.received_payload_bytes)?)
+        .bind(record.end_reason.as_ref().map(AsRef::<str>::as_ref))
+        .bind(sql_count(record.tokens.input)?)
+        .bind(sql_count(record.tokens.cache_read)?)
+        .bind(sql_count(record.tokens.cache_write)?)
+        .bind(sql_count(record.tokens.output)?)
+        .bind(sql_count(record.tokens.reasoning)?)
+        .bind(record.tps)
+        .execute(&mut *transaction)
+        .await?;
+        for quota in &record.rate_limits {
+            sqlx::query(
+                "INSERT INTO response_quota_observations \
+                    (sequence, attempt_id, limit_id, used_percent, resets_at) \
+                 VALUES (?, ?, ?, ?, ?) ON CONFLICT(sequence) DO NOTHING",
+            )
+            .bind(quota.sequence.to_string())
+            .bind(record.attempt_id.to_string())
+            .bind(&quota.limit_id)
+            .bind(quota.used_percent)
+            .bind(quota.resets_at)
+            .execute(&mut *transaction)
+            .await?;
+        }
+        transaction.commit().await?;
+        Ok(())
+    }
+
+    /// Filters precede the exclusive cursor and page limit.
+    pub async fn page(
+        &self,
+        thread_id: Option<ThreadId>,
+        model: Option<&str>,
+        before: Option<Uuid>,
+        limit: usize,
+    ) -> anyhow::Result<ResponseHistoryPage> {
+        let mut query =
+            QueryBuilder::<Sqlite>::new("WITH page AS (SELECT * FROM responses WHERE 1 = 1");
+        if let Some(thread_id) = thread_id {
+            query
+                .push(" AND thread_id = ")
+                .push_bind(thread_id.to_string());
+        }
+        if let Some(model) = model {
+            query.push(" AND requested_model = ").push_bind(model);
+        }
+        if let Some(before) = before {
+            query.push(" AND id < ").push_bind(before.to_string());
+        }
+        query
+            .push(" ORDER BY id DESC LIMIT ")
+            .push_bind((limit + 1) as i64)
+            .push(
+                ") SELECT page.*, quota.sequence AS quota_sequence, \
+                quota.limit_id, quota.used_percent, quota.resets_at FROM page \
+                LEFT JOIN response_quota_observations AS quota ON quota.attempt_id = page.id \
+                ORDER BY page.id DESC, quota.sequence",
+            );
+        let rows = query.build().fetch_all(&self.pool).await?;
+        let mut data: Vec<ResponseAttempt> = Vec::new();
+        for row in rows {
+            let id = Uuid::parse_str(row.try_get("id")?)?;
+            if data.last().is_none_or(|record| record.attempt_id != id) {
+                data.push(read_response(&row, id)?);
+            }
+            if let Some(quota) = read_quota(&row)? {
+                data.last_mut()
+                    .expect("response for quota")
+                    .rate_limits
+                    .push(quota);
+            }
+        }
+        let has_more = data.len() > limit;
+        data.truncate(limit);
+        let next_cursor = has_more.then(|| data.last().expect("nonempty response page").attempt_id);
+        Ok(ResponseHistoryPage { data, next_cursor })
+    }
+
+    pub async fn models(&self) -> anyhow::Result<Vec<String>> {
+        Ok(sqlx::query_scalar(
+            "SELECT DISTINCT requested_model FROM responses ORDER BY requested_model",
+        )
+        .fetch_all(&self.pool)
+        .await?)
+    }
+
+    pub async fn last_generations(&self) -> anyhow::Result<Vec<ResponsePerformance>> {
+        let rows = sqlx::query(
+            "SELECT id, thread_id, ttfb_ms, ttfc_ms, tps FROM responses \
+             WHERE id IN (SELECT MAX(id) FROM responses \
+                WHERE request_kind = 'generation' AND end_reason IS NOT NULL GROUP BY thread_id)",
+        )
+        .fetch_all(&self.pool)
+        .await?;
+        rows.into_iter()
+            .map(|row| {
+                Ok(ResponsePerformance {
+                    attempt_id: Uuid::parse_str(row.try_get("id")?)?,
+                    thread_id: ThreadId::from_string(row.try_get("thread_id")?)?,
+                    ttfb_ms: read_count(&row, "ttfb_ms")?,
+                    ttfc_ms: read_count(&row, "ttfc_ms")?,
+                    tps: row.try_get("tps")?,
+                })
+            })
+            .collect()
+    }
+}
+
+fn sql_count(value: Option<u64>) -> Result<Option<i64>, TryFromIntError> {
+    value.map(i64::try_from).transpose()
+}
+
+fn read_count(row: &SqliteRow, column: &str) -> anyhow::Result<Option<u64>> {
+    Ok(row
+        .try_get::<Option<i64>, _>(column)?
+        .map(u64::try_from)
+        .transpose()?)
+}
+
+fn read_tokens(row: &SqliteRow) -> anyhow::Result<ResponseTokenCounts> {
+    Ok(ResponseTokenCounts {
+        input: read_count(row, "input_tokens")?,
+        cache_read: read_count(row, "cache_read_tokens")?,
+        cache_write: read_count(row, "cache_write_tokens")?,
+        output: read_count(row, "output_tokens")?,
+        reasoning: read_count(row, "reasoning_tokens")?,
+    })
+}
+
+fn read_quota(row: &SqliteRow) -> anyhow::Result<Option<ResponseQuotaObservation>> {
+    let Some(sequence) = row.try_get::<Option<&str>, _>("quota_sequence")? else {
+        return Ok(None);
+    };
+    Ok(Some(ResponseQuotaObservation {
+        sequence: Uuid::parse_str(sequence)?,
+        limit_id: row.try_get("limit_id")?,
+        used_percent: row.try_get("used_percent")?,
+        resets_at: row.try_get("resets_at")?,
+    }))
+}
+
+fn read_response(row: &SqliteRow, attempt_id: Uuid) -> anyhow::Result<ResponseAttempt> {
+    Ok(ResponseAttempt {
+        attempt_id,
+        revision: row.try_get::<i64, _>("revision")?.try_into()?,
+        thread_id: ThreadId::from_string(row.try_get("thread_id")?)?,
+        turn_id: row.try_get("turn_id")?,
+        response_id: row.try_get("response_id")?,
+        request_kind: row.try_get("request_kind")?,
+        provider: row.try_get("provider")?,
+        account_id: row.try_get("account_id")?,
+        requested_model: row.try_get("requested_model")?,
+        served_model: row.try_get("served_model")?,
+        reasoning_effort: row.try_get("reasoning_effort")?,
+        started_at: row.try_get("started_at")?,
+        ttfb_ms: read_count(row, "ttfb_ms")?,
+        ttfc_ms: read_count(row, "ttfc_ms")?,
+        usage_observed_sequence: row
+            .try_get::<Option<&str>, _>("usage_sequence")?
+            .map(Uuid::parse_str)
+            .transpose()?,
+        rate_limits: Vec::new(),
+        terminal_observed_offset_ms: read_count(row, "terminal_offset_ms")?,
+        elapsed_ms: row.try_get::<i64, _>("elapsed_ms")?.try_into()?,
+        sent_payload_bytes: read_count(row, "sent_bytes")?,
+        received_payload_bytes: row.try_get::<i64, _>("received_bytes")?.try_into()?,
+        end_reason: row
+            .try_get::<Option<&str>, _>("end_reason")?
+            .map(str::parse)
+            .transpose()?,
+        tokens: read_tokens(row)?,
+        tps: row.try_get("tps")?,
+    })
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use codex_protocol::response_metrics::ResponseAttemptEnd;
+    use pretty_assertions::assert_eq;
+    use serde_json::json;
+
+    fn record(thread_id: ThreadId, model: &str) -> ResponseAttempt {
+        serde_json::from_value(json!({
+            "attemptId": Uuid::now_v7(), "revision": 1, "threadId": thread_id,
+            "requestKind": "generation", "provider": "OpenAI",
+            "requestedModel": model, "startedAt": 1000, "elapsedMs": 10,
+            "receivedPayloadBytes": 100, "tokens": {"input": 0, "cacheRead": 0},
+            "rateLimits": [], "endReason": "failed"
+        }))
+        .unwrap()
+    }
+
+    #[tokio::test]
+    async fn typed_statistics_round_trip_without_serialized_records() -> anyhow::Result<()> {
+        let home = crate::runtime::test_support::unique_temp_dir();
+        tokio::fs::create_dir_all(&home).await?;
+        let _cleanup = scopeguard::guard(home.clone(), |home| {
+            let _ = std::fs::remove_dir_all(home);
+        });
+        let store = ResponseHistoryStore::open(&home).await?;
+        assert!(home.join("sessions/responses.sqlite3").is_file());
+        let mut record = record(ThreadId::new(), "requested");
+        record.turn_id = Some("turn-1".into());
+        record.response_id = Some("resp-official".into());
+        record.reasoning_effort = Some("high".into());
+        record.sent_payload_bytes = Some(2048);
+        record.ttfb_ms = Some(150);
+        record.ttfc_ms = Some(300);
+        record.terminal_observed_offset_ms = Some(500);
+        record.usage_observed_sequence = Some(Uuid::now_v7());
+        record.rate_limits = vec![
+            ResponseQuotaObservation {
+                sequence: Uuid::now_v7(),
+                limit_id: "codex".into(),
+                used_percent: Some(12.5),
+                resets_at: Some(9000),
+            },
+            ResponseQuotaObservation {
+                sequence: Uuid::now_v7(),
+                limit_id: "codex".into(),
+                used_percent: Some(13.0),
+                resets_at: Some(9000),
+            },
+        ];
+        store.write(&record).await?;
+        record.revision += 1;
+        record.served_model = Some("served".into());
+        record.end_reason = Some(ResponseAttemptEnd::SetupFailed);
+        store.write(&record).await?;
+        let reopened = ResponseHistoryStore::open(&home).await?;
+        assert_eq!(
+            reopened.page(None, None, None, 1).await?.data,
+            vec![record.clone()]
+        );
+        assert_eq!(reopened.models().await?, vec!["requested"]);
+        assert_eq!(
+            reopened
+                .page(None, Some("requested"), None, 100)
+                .await?
+                .data,
+            vec![record.clone()]
+        );
+        assert!(
+            reopened
+                .page(None, Some("served"), None, 100)
+                .await?
+                .data
+                .is_empty()
+        );
+        assert_eq!(record.tokens.input, Some(0));
+        assert_eq!(record.tokens.output, None);
+        assert_eq!(
+            reopened.last_generations().await?,
+            vec![ResponsePerformance::from(&record)]
+        );
+        let columns: Vec<String> =
+            sqlx::query_scalar("SELECT name FROM pragma_table_info('responses')")
+                .fetch_all(&store.pool)
+                .await?;
+        assert!(
+            !columns
+                .iter()
+                .any(|name| matches!(name.as_str(), "record" | "usage_json" | "diagnostics"))
+        );
+        let stored: (Option<String>, Option<i64>, Option<i64>) =
+            sqlx::query_as("SELECT response_id, input_tokens, output_tokens FROM responses")
+                .fetch_one(&store.pool)
+                .await?;
+        assert_eq!(stored, (Some("resp-official".into()), Some(0), None));
+        Ok(())
+    }
+
+    #[tokio::test]
+    async fn filters_precede_limits_and_cursors_exclude_newer_insertions() -> anyhow::Result<()> {
+        let home = crate::runtime::test_support::unique_temp_dir();
+        tokio::fs::create_dir_all(&home).await?;
+        let _cleanup = scopeguard::guard(home.clone(), |home| {
+            let _ = std::fs::remove_dir_all(home);
+        });
+        let store = ResponseHistoryStore::open(&home).await?;
+        let selected = ThreadId::new();
+        let other = ThreadId::new();
+        let first = record(selected, "selected-model");
+        let second = record(selected, "selected-model");
+        for row in [
+            &first,
+            &record(other, "selected-model"),
+            &second,
+            &record(selected, "other-model"),
+        ] {
+            store.write(row).await?;
+        }
+        let page = store
+            .page(Some(selected), Some("selected-model"), None, 1)
+            .await?;
+        assert_eq!(page.data, vec![second.clone()]);
+        assert_eq!(page.next_cursor, Some(second.attempt_id));
+        store.write(&record(selected, "selected-model")).await?;
+        let older = store
+            .page(Some(selected), Some("selected-model"), page.next_cursor, 1)
+            .await?;
+        assert_eq!(older.data, vec![first]);
+        assert_eq!(older.next_cursor, None);
+        Ok(())
+    }
+}
