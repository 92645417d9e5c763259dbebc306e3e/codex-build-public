+use super::tests::context;
+use super::*;
+use codex_protocol::response_metrics::RECENT_RESPONSE_LIMIT;
+use pretty_assertions::assert_eq;
+use serde_json::json;
+
+#[tokio::test]
+async fn ordered_backup_preserves_final_tokens_and_freezes_unfinished_records() {
+    let home = tempfile::tempdir().unwrap();
+    let metrics = Arc::new(ResponseMetrics::new(home.path()));
+    let mut updates = metrics.subscribe();
+    let attempt = metrics.start(context(), Instant::now(), 1000);
+    attempt.sent(Instant::now());
+    attempt.received(
+        ResponseObservation {
+            usage: Some(json!({"input_tokens": 80, "input_tokens_details": {
+            "cached_tokens": 40, "cache_write_tokens": 10}, "output_tokens": 30,
+            "output_tokens_details": {"reasoning_tokens": 20}})),
+            terminal: Some(ResponseAttemptEnd::Failed),
+            ..Default::default()
+        },
+        Instant::now(),
+    );
+    let unfinished = metrics.start(context(), Instant::now(), 1000);
+    unfinished.sent(Instant::now());
+    // No yield: the single-threaded executor has not run the database worker.
+    // Publication and completed accounting must still be available immediately.
+    assert!(updates.try_recv().is_ok());
+    let finished = metrics.snapshot()[1].clone();
+    assert_eq!(finished.tokens.reasoning, Some(20));
+    assert!(!home.path().join("sessions/responses.sqlite3").exists());
+    metrics.flush().await.unwrap();
+    assert!(home.path().join("sessions/responses.sqlite3").is_file());
+    let reopened = Arc::new(ResponseMetrics::new(home.path()));
+    let page = reopened.page(None, None, None, 100).await;
+    assert!(page.persistence_error.is_none());
+    assert_eq!(page.data[1], finished);
+    assert_eq!(page.data[0].end_reason, None);
+    assert!(page.active_attempt_ids.is_empty());
+    assert_eq!(
+        page.last_generation.unwrap().attempt_id,
+        finished.attempt_id
+    );
+    assert_eq!(reopened.notification_snapshot(), vec![finished]);
+    // Restored records have no live tracker or synthetic monotonic clock.
+    tokio::time::pause();
+    tokio::time::advance(Duration::from_secs(60)).await;
+    assert_eq!(reopened.page(None, None, None, 100).await.data, page.data);
+    drop(unfinished);
+}
+
+#[tokio::test]
+async fn filtered_history_survives_eviction_restart_and_newer_insertions() {
+    let home = tempfile::tempdir().unwrap();
+    let metrics = Arc::new(ResponseMetrics::new(home.path()));
+    let selected = context();
+    let thread_id = selected.thread_id;
+    let oldest = metrics.start(selected, Instant::now(), 1000);
+    oldest.ended(ResponseAttemptEnd::Completed, Instant::now());
+    let expected = metrics.snapshot()[0].clone();
+    for _ in 0..RECENT_RESPONSE_LIMIT {
+        let mut context = context();
+        context.requested_model = "other-model".into();
+        let attempt = metrics.start(context, Instant::now(), 1000);
+        attempt.ended(ResponseAttemptEnd::Completed, Instant::now());
+    }
+    metrics.flush().await.unwrap();
+    let reopened = Arc::new(ResponseMetrics::new(home.path()));
+    let first = reopened
+        .page(Some(thread_id), Some("model"), None, 100)
+        .await;
+    assert!(first.data.is_empty());
+    assert_eq!(first.models, vec!["model", "other-model"]);
+    assert_eq!(
+        first.last_generation.unwrap().attempt_id,
+        expected.attempt_id
+    );
+    let cursor = Uuid::parse_str(&first.next_cursor.unwrap()).unwrap();
+    let new = reopened.start(context(), Instant::now(), 1001);
+    let older = reopened
+        .page(Some(thread_id), Some("model"), Some(cursor), 100)
+        .await;
+    assert_eq!(older.data, vec![expected]);
+    assert_eq!(older.next_cursor, None);
+    assert_eq!(older.active_attempt_ids.len(), 1);
+    drop(new);
+    reopened.flush().await.unwrap();
+}
+
+#[tokio::test]
+async fn storage_failure_is_visible_without_losing_live_records() {
+    let home = tempfile::tempdir().unwrap();
+    std::fs::create_dir_all(home.path().join("sessions/responses.sqlite3")).unwrap();
+    let metrics = Arc::new(ResponseMetrics::new(home.path()));
+    let attempt = metrics.start(context(), Instant::now(), 1000);
+    attempt.ended(ResponseAttemptEnd::Canceled, Instant::now());
+    assert!(metrics.flush().await.is_err());
+    let page = metrics.page(None, None, None, 100).await;
+    assert_eq!(page.data, metrics.snapshot());
+    assert!(
+        page.persistence_error
+            .unwrap()
+            .contains("sessions/responses.sqlite3")
+    );
+}
