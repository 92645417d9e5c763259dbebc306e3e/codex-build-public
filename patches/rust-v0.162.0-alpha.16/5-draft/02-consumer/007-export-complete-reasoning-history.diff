+#[test]
+fn export_reasoning_deduplicates_across_steers_but_keeps_turn_boundaries() {
+    let reasoning = |id: &str| ThreadItem::Reasoning {
+        id: id.into(),
+        summary: vec!["**Inspect**\n\nRetained [link](https://example.com).".into()],
+        content: vec!["Private raw".into()],
+    };
+    let turn = |id: &str, items| Turn {
+        id: id.into(),
+        items,
+        items_view: TurnItemsView::Full,
+        status: TurnStatus::Completed,
+        error: None,
+        started_at: None,
+        completed_at: None,
+        duration_ms: None,
+    };
+    let turns = vec![
+        turn(
+            "first",
+            vec![
+                reasoning("one"),
+                ThreadItem::UserMessage {
+                    id: "steer".into(),
+                    client_id: None,
+                    content: vec![UserInput::Text {
+                        text: "Continue".into(),
+                        text_elements: Vec::new(),
+                    }],
+                },
+                reasoning("two"),
+            ],
+        ),
+        turn("second", vec![reasoning("three")]),
+    ];
+    let cells = super::export_turns_to_cells(
+        codex_protocol::ThreadId::new(),
+        &codex_utils_absolute_path::AbsolutePathBuf::current_dir().unwrap(),
+        turns,
+        crate::thread_transcript::RawReasoningVisibility::Hidden,
+        true,
+        None,
+    );
+    let markdown = render_markdown_transcript(&cells).unwrap();
+    assert_eq!(markdown.matches("## Reasoning").count(), 2);
+    assert_eq!(markdown.matches("**Inspect**").count(), 2);
+    assert_eq!(
+        markdown
+            .matches("Retained [link](https://example.com).")
+            .count(),
+        2
+    );
+    assert!(markdown.contains("## User\n\nContinue"));
+    assert!(!markdown.contains("Private raw"));
+}
