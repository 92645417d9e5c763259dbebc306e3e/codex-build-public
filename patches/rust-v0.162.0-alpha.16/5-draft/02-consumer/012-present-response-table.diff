+#[test]
+fn selected_columns_preserve_mismatch_red_and_hide_other_values() {
+    let now = Instant::now();
+    let mut row = attempt(1, Some(ResponseAttemptEnd::Failed));
+    row.served_model = Some("different".into());
+    row.response_id = Some("resp_official".into());
+    let observed = ObservedResponse::new(row, false, now);
+    let columns = [
+        ResponseColumn::Model,
+        ResponseColumn::Input,
+        ResponseColumn::Id,
+    ];
+    let table = ResponseTable::new(&[&observed], &columns, None, now);
+    let area = Rect::new(0, 0, 140, 1);
+    let mut buffer = Buffer::empty(area);
+    table.render_row(0, true, area, &mut buffer, 0);
+    assert!(buffer_text(&buffer).contains("resp_official"));
+    assert!(!buffer_text(&buffer).contains("different"));
+    let model_x = (table.widths[0] - observed.row.requested_model.len()) / 2;
+    assert_eq!(buffer[(model_x as u16, 0)].fg, Color::Red);
+    let input_x =
+        table.widths[0] + 2 + table.widths[1] - value(&table, 0, ResponseColumn::Input).len();
+    assert_eq!(
+        buffer[(input_x as u16, 0)].fg,
+        intensity_style(16).fg.unwrap()
+    );
+    assert!(
+        buffer
+            .content
+            .iter()
+            .all(|cell| cell.modifier.contains(Modifier::ITALIC))
+    );
+    let empty = ResponseTable::new(&[&observed], &[], None, now);
+    assert_eq!(empty.max_offset(80), 0);
+    empty.render_headers(area, &mut Buffer::empty(area), 0);
+    empty.render_row(0, false, area, &mut Buffer::empty(area), 0);
+}
