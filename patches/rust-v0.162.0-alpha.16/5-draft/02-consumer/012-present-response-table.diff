+//! Response facts projected into columns, with the session picker's row treatment.
+
+use crate::color::blend;
+use crate::line_truncation::truncate_line_with_ellipsis_if_overflow;
+use crate::local_usage::table::Cell;
+use crate::local_usage::table::shade_columns;
+use crate::response_timing::ObservedResponse;
+use crate::response_timing::seconds;
+use crate::response_timing::tps;
+use crate::resume_picker::dense_selected_style;
+use crate::resume_picker::dense_zebra_style;
+use crate::style::accent_style;
+use crate::style::readable_color_on;
+use crate::style::theme_color_on;
+use crate::terminal_palette::best_color;
+use crate::terminal_palette::default_bg;
+use codex_models_manager::model_pricing::Prices;
+use codex_protocol::response_metrics::ResponseAttempt;
+use codex_protocol::response_metrics::ResponseAttemptEnd;
+use ratatui::buffer::Buffer;
+use ratatui::layout::Rect;
+use ratatui::style::Color;
+use ratatui::style::Style;
+use ratatui::text::Line;
+use ratatui::text::Span;
+use ratatui::widgets::Paragraph;
+use ratatui::widgets::Widget;
+use std::time::Instant;
+use unicode_width::UnicodeWidthStr;
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq, strum_macros::AsRefStr, strum_macros::EnumString)]
+#[strum(serialize_all = "kebab-case")]
+pub(crate) enum ResponseColumn {
+    Time,
+    Model,
+    ServedModel,
+    Duration,
+    Received,
+    Input,
+    Read,
+    Write,
+    Output,
+    Reasoning,
+    Hit,
+    Tps,
+    Cost,
+    Ttfb,
+    Ttfc,
+    Effort,
+    Status,
+    Id,
+    Session,
+    Sent,
+}
+
+impl ResponseColumn {
+    pub(crate) const ALL: &[Self] = &[
+        Self::Time,
+        Self::Model,
+        Self::ServedModel,
+        Self::Duration,
+        Self::Received,
+        Self::Sent,
+        Self::Input,
+        Self::Read,
+        Self::Write,
+        Self::Output,
+        Self::Reasoning,
+        Self::Hit,
+        Self::Tps,
+        Self::Cost,
+        Self::Ttfb,
+        Self::Ttfc,
+        Self::Effort,
+        Self::Status,
+        Self::Id,
+        Self::Session,
+    ];
+
+    pub(crate) const DEFAULT: &[Self] = &[
+        Self::Time,
+        Self::Model,
+        Self::Status,
+        Self::Duration,
+        Self::Received,
+        Self::Input,
+        Self::Read,
+        Self::Output,
+        Self::Hit,
+        Self::Tps,
+        Self::Cost,
+        Self::Ttfb,
+    ];
+
+    pub(crate) fn presentation(self) -> (&'static str, &'static str) {
+        match self {
+            Self::Time => ("Time", "Request start in local time"),
+            Self::Model => (
+                "Requested model",
+                "Requested model; red when the served model differs",
+            ),
+            Self::ServedModel => ("Served model", "Model reported by the upstream server"),
+            Self::Duration => (
+                "Duration",
+                "Setup plus receipt time; frozen when receipt ends",
+            ),
+            Self::Received => ("Received", "Transport payload received, in KiB"),
+            Self::Input => ("Input", "Uncached input tokens, excluding Read and Write"),
+            Self::Read => ("Read", "Provider-reported cache-read tokens"),
+            Self::Write => ("Write", "Provider-reported cache-write tokens"),
+            Self::Output => (
+                "Output",
+                "Provider-reported output tokens, including reasoning",
+            ),
+            Self::Reasoning => (
+                "Reasoning",
+                "Provider-reported reasoning tokens within Output",
+            ),
+            Self::Hit => ("Hit", "Cache-read percentage of total input tokens"),
+            Self::Tps => ("TPS", "Output tokens per send-to-usage second"),
+            Self::Cost => ("Cost", "USD estimate using the served model's local prices"),
+            Self::Ttfb => ("TTFB", "Send to first nonempty transport payload"),
+            Self::Ttfc => ("TTFC", "Send to first model content"),
+            Self::Effort => ("Effort", "Requested reasoning effort"),
+            Self::Status => ("Status", "Request lifecycle and outcome"),
+            Self::Id => ("ID", "Official response ID for looking up diagnostic logs"),
+            Self::Session => ("Session", "Conversation identity"),
+            Self::Sent => ("Sent", "Transport payload sent, in KiB"),
+        }
+    }
+
+    /// A column's geometry never depends on arriving values or the viewport.
+    /// Unbounded labels and exceptional numeric values use the native ellipsis.
+    fn width(self) -> usize {
+        let format_width = match self {
+            Self::Time => 19,
+            Self::Model | Self::ServedModel => 32,
+            Self::Status => 14,
+            Self::Id => 64,
+            Self::Session => 36,
+            Self::Effort => 8,
+            Self::Hit => 7,
+            Self::Duration | Self::Ttfb | Self::Ttfc | Self::Tps => 12,
+            Self::Received | Self::Sent | Self::Cost => 16,
+            Self::Input | Self::Read | Self::Write | Self::Output | Self::Reasoning => 10,
+        };
+        format_width.max(self.presentation().0.width())
+    }
+}
+
+/// Fixed column geometry with numeric shades ranked over all loaded matching rows.
+pub(crate) struct ResponseTable {
+    columns: Vec<ResponseColumn>,
+    rows: Vec<Vec<Cell>>,
+    failed: Vec<bool>,
+    widths: Vec<usize>,
+}
+
+impl ResponseTable {
+    pub(crate) fn new(
+        attempts: &[&ObservedResponse],
+        columns: &[ResponseColumn],
+        prices: Option<&Prices>,
+        now: Instant,
+    ) -> Self {
+        let failed = attempts
+            .iter()
+            .map(|attempt| {
+                attempt.row.end_reason.is_some()
+                    && attempt.row.end_reason != Some(ResponseAttemptEnd::Completed)
+            })
+            .collect();
+        let mut rows = attempts
+            .iter()
+            .map(|attempt| {
+                columns
+                    .iter()
+                    .map(|column| cell(*column, attempt, prices, now))
+                    .collect()
+            })
+            .collect::<Vec<Vec<Cell>>>();
+        shade_columns(&mut rows, intensity_style);
+        let widths = columns.iter().map(|column| column.width()).collect();
+        Self {
+            columns: columns.to_vec(),
+            rows,
+            failed,
+            widths,
+        }
+    }
+
+    pub(crate) fn max_offset(&self, width: u16) -> u16 {
+        self.widths
+            .iter()
+            .sum::<usize>()
+            .saturating_add(2 * self.columns.len().saturating_sub(1))
+            .saturating_sub(usize::from(width))
+            .try_into()
+            .unwrap_or(u16::MAX)
+    }
+
+    pub(crate) fn render_headers(&self, area: Rect, buffer: &mut Buffer, offset: u16) {
+        let headers = self
+            .columns
+            .iter()
+            .map(|column| Cell {
+                style: accent_style(),
+                ..Cell::text(column.presentation().0)
+            })
+            .collect::<Vec<_>>();
+        Paragraph::new(self.line(&headers, None))
+            .scroll((0, offset))
+            .render(area, buffer);
+    }
+
+    pub(crate) fn render_row(
+        &self,
+        index: usize,
+        selected: bool,
+        area: Rect,
+        buffer: &mut Buffer,
+        offset: u16,
+    ) {
+        let style = if selected {
+            dense_selected_style()
+        } else if index.is_multiple_of(2) {
+            dense_zebra_style()
+        } else {
+            Style::default()
+        };
+        buffer.set_style(area, style);
+        Paragraph::new(self.line(&self.rows[index], style.bg))
+            .scroll((0, offset))
+            .render(area, buffer);
+        if self.failed[index] {
+            // Apply to the painted row, including padding and selected spans.
+            buffer.set_style(area, Style::default().italic());
+        }
+    }
+
+    fn line(&self, cells: &[Cell], background: Option<Color>) -> Line<'static> {
+        let mut spans = Vec::new();
+        for (index, (cell, width)) in cells.iter().zip(&self.widths).enumerate() {
+            let mut line = truncate_line_with_ellipsis_if_overflow(cell.lines[0].clone(), *width);
+            let padding = width.saturating_sub(line.width());
+            let left = if cell.right { padding } else { padding / 2 };
+            spans.push(Span::raw(" ".repeat(left)));
+            for span in &mut line.spans {
+                span.style = cell.style.patch(line.style).patch(span.style);
+                if let Some(color) = span.style.fg {
+                    span.style = span.style.fg(readable_color_on(color, background));
+                }
+            }
+            spans.extend(line.spans);
+            spans.push(Span::raw(" ".repeat(padding - left)));
+            if index + 1 < cells.len() {
+                spans.push(Span::raw("  "));
+            }
+        }
+        Line::from(spans)
+    }
+}
+
+fn cell(
+    column: ResponseColumn,
+    attempt: &ObservedResponse,
+    prices: Option<&Prices>,
+    now: Instant,
+) -> Cell {
+    let row = &attempt.row;
+    match column {
+        ResponseColumn::Time => text(
+            chrono::DateTime::from_timestamp(row.started_at, 0)
+                .map(|time| {
+                    time.with_timezone(&chrono::Local)
+                        .format("%Y-%m-%d %H:%M:%S")
+                        .to_string()
+                })
+                .unwrap_or_else(|| "--".into()),
+        ),
+        ResponseColumn::Model => {
+            let mut cell = text(row.requested_model.as_str());
+            if row
+                .served_model
+                .as_ref()
+                .is_some_and(|model| model != &row.requested_model)
+            {
+                cell.style = cell.style.red();
+            }
+            cell
+        }
+        ResponseColumn::ServedModel => optional(row.served_model.as_deref()),
+        ResponseColumn::Status => text(state(attempt)),
+        ResponseColumn::Duration => duration(Some(attempt.elapsed_ms(now))),
+        ResponseColumn::Received => bytes(Some(row.received_payload_bytes)),
+        ResponseColumn::Input => count(
+            match (
+                row.tokens.input,
+                row.tokens.cache_read,
+                row.tokens.cache_write,
+            ) {
+                (Some(input), Some(read), Some(write)) => {
+                    Some(input.saturating_sub(read).saturating_sub(write))
+                }
+                _ => None,
+            },
+        ),
+        ResponseColumn::Read => count(row.tokens.cache_read),
+        ResponseColumn::Write => count(row.tokens.cache_write),
+        ResponseColumn::Output => count(row.tokens.output),
+        ResponseColumn::Reasoning => count(row.tokens.reasoning),
+        ResponseColumn::Hit => {
+            let value = match (row.tokens.input, row.tokens.cache_read) {
+                (Some(input), Some(read)) if input > 0 => Some(read as f64 * 100.0 / input as f64),
+                _ => None,
+            };
+            Cell::value(
+                value,
+                value.map_or_else(|| "--".into(), |value| format!("{value:.2}%")),
+            )
+        }
+        ResponseColumn::Tps => Cell::value(row.tps, tps(row.tps)),
+        ResponseColumn::Cost => {
+            let value = cost(row, prices);
+            Cell::value(
+                value,
+                value.map_or_else(|| "--".into(), |usd| format!("${usd:.4}")),
+            )
+        }
+        ResponseColumn::Ttfb => duration(row.ttfb_ms),
+        ResponseColumn::Ttfc => duration(row.ttfc_ms),
+        ResponseColumn::Effort => optional(row.reasoning_effort.as_deref()),
+        ResponseColumn::Id => optional(row.response_id.as_deref()),
+        ResponseColumn::Session => text(row.thread_id.to_string()),
+        ResponseColumn::Sent => bytes(row.sent_payload_bytes),
+    }
+}
+
+fn state(attempt: &ObservedResponse) -> &'static str {
+    match attempt.row.end_reason {
+        None if attempt.is_running() => "Working",
+        None if attempt.row.terminal_observed_offset_ms.is_some() => "Received",
+        None => "Unfinished",
+        Some(ResponseAttemptEnd::Completed) => "Done",
+        Some(ResponseAttemptEnd::Incomplete) => "Incomplete",
+        Some(ResponseAttemptEnd::Failed) => "Failed",
+        Some(ResponseAttemptEnd::Interrupted) => "Interrupted",
+        Some(ResponseAttemptEnd::Canceled) => "Canceled",
+        Some(ResponseAttemptEnd::SetupFailed) => "Setup failed",
+        Some(ResponseAttemptEnd::SendFailed) => "Send failed",
+        Some(ResponseAttemptEnd::TransportClosed) => "Disconnected",
+        Some(ResponseAttemptEnd::ProgressTimeout) => "Timeout",
+        Some(ResponseAttemptEnd::ProtocolError) => "Protocol error",
+    }
+}
+
+fn count(value: Option<u64>) -> Cell {
+    Cell::value(
+        value.map(|value| value as f64),
+        value.map_or_else(|| "--".into(), |value| value.to_string()),
+    )
+}
+
+fn duration(value: Option<u64>) -> Cell {
+    Cell::value(value.map(|value| value as f64 / 1000.0), seconds(value))
+}
+
+fn bytes(value: Option<u64>) -> Cell {
+    Cell::value(
+        value.map(|value| value as f64),
+        value.map_or_else(
+            || "--".into(),
+            |value| format!("{:.1} KiB", value as f64 / 1024.0),
+        ),
+    )
+}
+
+fn text(value: impl Into<String>) -> Cell {
+    Cell::text(value.into().replace(['\r', '\n'], " "))
+}
+
+fn optional(value: Option<&str>) -> Cell {
+    text(value.unwrap_or("--"))
+}
+
+fn cost(row: &ResponseAttempt, prices: Option<&Prices>) -> Option<f64> {
+    let price = prices?.get(row.served_model.as_deref().unwrap_or(&row.requested_model))?;
+    if price.is_zero() {
+        return None;
+    }
+    Some(
+        price
+            .quote(
+                row.tokens.input?,
+                row.tokens.cache_read?,
+                row.tokens.cache_write?,
+                row.tokens.output?,
+            )
+            .usd,
+    )
+}
+
+fn intensity_style(level: usize) -> Style {
+    let color = theme_color_on(&["constant.numeric"], None);
+    let color = if let Color::Rgb(r, g, b) = color
+        && let Some(background) = default_bg()
+    {
+        best_color(blend((r, g, b), background, 0.5 + level as f32 / 32.0))
+    } else {
+        color
+    };
+    let style = Style::default().fg(color);
+    if level <= 5 {
+        style.dim()
+    } else if level >= 12 {
+        style.bold()
+    } else {
+        style
+    }
+}
+
