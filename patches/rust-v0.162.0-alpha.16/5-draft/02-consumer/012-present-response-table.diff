+use super::*;
+use crate::response_timing::tests::attempt;
+use pretty_assertions::assert_eq;
+use ratatui::style::Modifier;
+use serde_json::json;
+
+fn prices() -> Prices {
+    serde_json::from_value(json!({"served": {
+        "0": {"input": 2.0, "cache_read": 1.0, "cache_write": 3.0, "output": 4.0},
+        "1000": {"input": 4.0, "cache_read": 2.0, "cache_write": 6.0, "output": 8.0}
+    }}))
+    .unwrap()
+}
+
+fn buffer_text(buffer: &Buffer) -> String {
+    buffer.content.iter().map(|cell| cell.symbol()).collect()
+}
+
+fn value(table: &ResponseTable, row: usize, column: ResponseColumn) -> String {
+    table.rows[row][table
+        .columns
+        .iter()
+        .position(|candidate| *candidate == column)
+        .unwrap()]
+    .lines[0]
+        .to_string()
+}
+
+#[test]
+fn table_preserves_billing_units_unknowns_and_official_identity() {
+    let now = Instant::now();
+    let mut row = attempt(1, Some(ResponseAttemptEnd::Completed));
+    row.served_model = Some("served".into());
+    row.sent_payload_bytes = Some(2048);
+    row.response_id = Some("resp_official".into());
+    let session = row.thread_id.to_string();
+    let mut observed = ObservedResponse::new(row, false, now);
+    let prices = prices();
+    let table = ResponseTable::new(&[&observed], ResponseColumn::ALL, Some(&prices), now);
+    assert_eq!(value(&table, 0, ResponseColumn::Model), "gpt-5.4");
+    assert_eq!(value(&table, 0, ResponseColumn::ServedModel), "served");
+    assert_eq!(
+        [
+            ResponseColumn::Input,
+            ResponseColumn::Read,
+            ResponseColumn::Write,
+            ResponseColumn::Output,
+            ResponseColumn::Reasoning,
+            ResponseColumn::Hit,
+            ResponseColumn::Tps,
+            ResponseColumn::Cost
+        ]
+        .map(|column| value(&table, 0, column)),
+        [
+            "500", "400", "100", "100", "50", "40.00%", "50.0", "$0.0042"
+        ]
+    );
+    assert_eq!(value(&table, 0, ResponseColumn::Received), "0.5 KiB");
+    assert_eq!(value(&table, 0, ResponseColumn::Sent), "2.0 KiB");
+    assert_eq!(value(&table, 0, ResponseColumn::Id), "resp_official");
+    assert_eq!(value(&table, 0, ResponseColumn::Session), session);
+    assert_eq!(value(&table, 0, ResponseColumn::Duration), "2.10s");
+    observed.row.tokens.cache_write = None;
+    observed.row.response_id = None;
+    let unknown = ResponseTable::new(&[&observed], ResponseColumn::ALL, Some(&prices), now);
+    assert_eq!(value(&unknown, 0, ResponseColumn::Write), "--");
+    assert_eq!(value(&unknown, 0, ResponseColumn::Input), "--");
+    assert_eq!(value(&unknown, 0, ResponseColumn::Cost), "--");
+    assert_eq!(value(&unknown, 0, ResponseColumn::Id), "--");
+    observed.row.tokens.cache_write = Some(0);
+    observed.row.tokens.input = Some(0);
+    observed.row.tokens.cache_read = Some(0);
+    observed.row.tokens.output = Some(0);
+    let zero = ResponseTable::new(&[&observed], ResponseColumn::ALL, Some(&prices), now);
+    assert_eq!(value(&zero, 0, ResponseColumn::Input), "0");
+    assert_eq!(value(&zero, 0, ResponseColumn::Hit), "--");
+    assert_eq!(value(&zero, 0, ResponseColumn::Cost), "$0.0000");
+    assert_eq!(
+        cell(ResponseColumn::Cost, &observed, None, now).lines[0].to_string(),
+        "--"
+    );
+    let placeholders = serde_json::from_value(json!({"served": {
+        "0": {"input": 0.0, "cache_read": 0.0, "cache_write": 0.0, "output": 0.0}
+    }}))
+    .unwrap();
+    assert_eq!(
+        cell(ResponseColumn::Cost, &observed, Some(&placeholders), now).lines[0].to_string(),
+        "--"
+    );
+}
+
+#[test]
+fn horizontal_view_reaches_every_header_and_value_without_a_detail_panel() {
+    let now = Instant::now();
+    let mut row = attempt(1, Some(ResponseAttemptEnd::Completed));
+    row.requested_model = "a-long-requested-model-name".into();
+    row.served_model = Some("a-different-served-model-name".into());
+    let observed = ObservedResponse::new(row, false, now);
+    let table = ResponseTable::new(&[&observed], ResponseColumn::ALL, None, now);
+    let area = Rect::new(0, 0, 40, 1);
+    let mut offset = 0;
+    for (index, width) in table.widths.iter().enumerate() {
+        let mut header = Buffer::empty(area);
+        let mut body = Buffer::empty(area);
+        table.render_headers(area, &mut header, offset);
+        table.render_row(0, false, area, &mut body, offset);
+        assert!(
+            buffer_text(&header)
+                .trim_start()
+                .starts_with(table.columns[index].presentation().0)
+        );
+        assert!(
+            buffer_text(&body)
+                .trim_start()
+                .starts_with(&table.rows[0][index].lines[0].to_string())
+        );
+        offset += (*width + 2) as u16;
+    }
+    let mut end = Buffer::empty(area);
+    table.render_row(0, false, area, &mut end, table.max_offset(area.width));
+    assert!(
+        buffer_text(&end)
+            .trim_end()
+            .ends_with(&observed.row.thread_id.to_string())
+    );
+}
+
+#[test]
+fn themed_rows_keep_native_selection_stripes_and_whole_row_failure_italics() {
+    let original = crate::render::highlight::current_syntax_theme();
+    let mut numeric_colors = Vec::new();
+    for (theme, bg, fg) in [
+        ("ada", (20, 35, 50), (220, 230, 240)),
+        ("github", (250, 241, 235), (30, 40, 50)),
+    ] {
+        crate::render::highlight::set_syntax_theme(
+            crate::render::highlight::resolve_theme_by_name(theme, None).unwrap(),
+        );
+        crate::terminal_palette::with_test_default_colors(
+            crate::terminal_probe::DefaultColors { fg, bg },
+            || numeric_colors.push(assert_themed_rows()),
+        );
+    }
+    crate::render::highlight::set_syntax_theme(original);
+    assert_ne!(numeric_colors[0], numeric_colors[1]);
+}
+
+fn assert_themed_rows() -> Color {
+    let now = Instant::now();
+    let working = ObservedResponse::new(attempt(1, None), true, now);
+    let completed =
+        ObservedResponse::new(attempt(2, Some(ResponseAttemptEnd::Completed)), false, now);
+    let failed = ObservedResponse::new(attempt(3, Some(ResponseAttemptEnd::Failed)), false, now);
+    let table = ResponseTable::new(
+        &[&working, &completed, &failed],
+        ResponseColumn::DEFAULT,
+        None,
+        now,
+    );
+    let area = Rect::new(0, 0, 80, 3);
+    let mut buffer = Buffer::empty(area);
+    for index in 0..3 {
+        table.render_row(
+            index,
+            false,
+            Rect::new(0, index as u16, 80, 1),
+            &mut buffer,
+            0,
+        );
+    }
+    assert_ne!(buffer[(0, 0)].bg, buffer[(0, 1)].bg);
+    for y in 0..3 {
+        for x in 0..80 {
+            let cell = &buffer[(x, y)];
+            assert_eq!(cell.modifier.contains(Modifier::ITALIC), y == 2);
+        }
+    }
+    let line = Rect::new(0, 0, 80, 1);
+    let mut selected = Buffer::empty(line);
+    table.render_row(2, true, line, &mut selected, table.max_offset(80));
+    assert!(
+        selected
+            .content
+            .iter()
+            .all(|cell| cell.modifier.contains(Modifier::ITALIC))
+    );
+    assert!(!selected[(0, 0)].modifier.contains(Modifier::REVERSED));
+    assert_eq!(selected[(0, 0)].bg, dense_selected_style().bg.unwrap());
+    assert_ne!(selected[(0, 0)].bg, buffer[(0, 0)].bg);
+    let numeric = ResponseTable::new(&[&completed], &[ResponseColumn::Input], None, now);
+    let mut numeric_buffer = Buffer::empty(line);
+    numeric.render_row(0, true, line, &mut numeric_buffer, 0);
+    let x = (numeric.widths[0] - 1) as u16;
+    assert_eq!(
+        numeric_buffer[(x, 0)].fg,
+        readable_color_on(intensity_style(16).fg.unwrap(), dense_selected_style().bg)
+    );
+    let numeric_color = numeric_buffer[(x, 0)].fg;
+    let mut header = Buffer::empty(line);
+    numeric.render_headers(line, &mut header, 0);
+    let x = (numeric.widths[0] - "Input".len()) as u16 / 2;
+    assert_eq!(
+        header[(x, 0)].fg,
+        readable_color_on(accent_style().fg.unwrap(), None)
+    );
+    numeric_color
+}
