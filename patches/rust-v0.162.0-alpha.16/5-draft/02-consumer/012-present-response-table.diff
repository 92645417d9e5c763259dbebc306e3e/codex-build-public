+#[test]
+fn every_column_keeps_its_geometry_across_lifecycle_pages_filters_and_scroll() {
+    let now = Instant::now();
+    let empty = ResponseTable::new(&[], ResponseColumn::ALL, None, now);
+    let width = empty.widths.iter().sum::<usize>() + 2 * (empty.columns.len() - 1);
+    let area = Rect::new(0, 0, width as u16, 1);
+    let mut initial_headers = Buffer::empty(area);
+    empty.render_headers(area, &mut initial_headers, 0);
+    let initial_headers = buffer_text(&initial_headers);
+    let mut rows = vec![ObservedResponse::new(attempt(1, None), true, now)];
+    let mut received = attempt(2, None);
+    received.terminal_observed_offset_ms = Some(1000);
+    rows.push(ObservedResponse::new(received, true, now));
+    rows.push(ObservedResponse::new(attempt(3, None), false, now));
+    for (index, end) in [
+        ResponseAttemptEnd::Completed,
+        ResponseAttemptEnd::Incomplete,
+        ResponseAttemptEnd::Failed,
+        ResponseAttemptEnd::Interrupted,
+        ResponseAttemptEnd::Canceled,
+        ResponseAttemptEnd::SetupFailed,
+        ResponseAttemptEnd::SendFailed,
+        ResponseAttemptEnd::TransportClosed,
+        ResponseAttemptEnd::ProgressTimeout,
+        ResponseAttemptEnd::ProtocolError,
+    ]
+    .into_iter()
+    .enumerate()
+    {
+        let mut row = attempt(index as u64 + 4, Some(end));
+        row.requested_model = "long-model-".repeat(20);
+        row.served_model = Some("long-served-model-".repeat(20));
+        row.response_id = Some("resp_".repeat(30));
+        row.reasoning_effort = Some("very-long-effort".into());
+        row.elapsed_ms = u64::MAX;
+        row.ttfb_ms = Some(u64::MAX);
+        row.ttfc_ms = Some(u64::MAX);
+        row.received_payload_bytes = u64::MAX;
+        row.sent_payload_bytes = Some(u64::MAX);
+        row.tokens.input = Some(u64::MAX);
+        row.tokens.cache_read = Some(0);
+        row.tokens.cache_write = Some(0);
+        row.tokens.output = Some(u64::MAX);
+        row.tokens.reasoning = Some(u64::MAX);
+        row.tps = Some(1e20);
+        rows.push(ObservedResponse::new(row, false, now));
+    }
+    let prices = prices();
+    for loaded in 1..=rows.len() {
+        for filtered in [false, true] {
+            let matching = if filtered {
+                &rows[loaded - 1..loaded]
+            } else {
+                &rows[..loaded]
+            };
+            let table = ResponseTable::new(
+                &matching.iter().collect::<Vec<_>>(),
+                ResponseColumn::ALL,
+                Some(&prices),
+                now + std::time::Duration::from_secs(1000),
+            );
+            let mut headers = Buffer::empty(area);
+            table.render_headers(area, &mut headers, 0);
+            assert_eq!(buffer_text(&headers), initial_headers);
+            assert_eq!(table.max_offset(37), empty.max_offset(37));
+            for row in 0..matching.len() {
+                let mut body = Buffer::empty(area);
+                table.render_row(row, false, area, &mut body, 0);
+                let mut start = 0;
+                for (column, width) in table.widths.iter().enumerate() {
+                    let text = &table.rows[row][column];
+                    let content =
+                        truncate_line_with_ellipsis_if_overflow(text.lines[0].clone(), *width)
+                            .to_string();
+                    let left = if text.right {
+                        width - content.width()
+                    } else {
+                        (width - content.width()) / 2
+                    };
+                    let rendered = (start..start + width)
+                        .map(|x| body[(x as u16, 0)].symbol())
+                        .collect::<String>();
+                    assert_eq!(rendered.trim(), content);
+                    assert_eq!(rendered.find(&content).unwrap(), left);
+                    let header = table.columns[column].presentation().0;
+                    let header_x = initial_headers[start..start + width].find(header).unwrap();
+                    assert_eq!(header_x, (width - header.width()) / 2);
+                    start += width + 2;
+                }
+                for offset in [0, 8, table.max_offset(37)] {
+                    let viewport = Rect::new(0, 0, 37, 1);
+                    let mut scrolled = Buffer::empty(viewport);
+                    table.render_row(row, false, viewport, &mut scrolled, offset);
+                    for x in 0..viewport.width {
+                        assert_eq!(scrolled[(x, 0)].symbol(), body[(x + offset, 0)].symbol());
+                    }
+                }
+            }
+        }
+    }
+}
