+//! Local presentation clocks for published response records.
+
+use codex_protocol::response_metrics::ResponseAttempt;
+use codex_protocol::response_metrics::ResponsePerformance;
+use std::time::Instant;
+
+#[derive(Debug)]
+pub(crate) struct ObservedResponse {
+    pub(crate) row: ResponseAttempt,
+    observed_at: Instant,
+    active: bool,
+}
+
+impl ObservedResponse {
+    pub(crate) fn new(row: ResponseAttempt, active: bool, observed_at: Instant) -> Self {
+        Self {
+            row,
+            observed_at,
+            active,
+        }
+    }
+
+    pub(crate) fn is_running(&self) -> bool {
+        self.active
+            && self.row.end_reason.is_none()
+            && self.row.terminal_observed_offset_ms.is_none()
+    }
+
+    pub(crate) fn is_receiving(&self) -> bool {
+        self.is_running() && self.row.received_payload_bytes > 0
+    }
+
+    pub(crate) fn elapsed_ms(&self, now: Instant) -> u64 {
+        if self.is_running() {
+            self.progress().elapsed_ms(now)
+        } else {
+            self.row.elapsed_ms
+        }
+    }
+
+    pub(crate) fn update(&mut self, mut incoming: Self) {
+        if incoming.row.revision < self.row.revision {
+            return;
+        }
+        let now = incoming.observed_at;
+        if incoming.row.revision == self.row.revision
+            && incoming.active == self.active
+            && incoming.elapsed_ms(now) <= self.elapsed_ms(now)
+        {
+            return;
+        }
+        if incoming.is_running() {
+            // Page snapshots and notifications travel independently. Keep the
+            // displayed live clock monotonic; terminal records remain exact.
+            incoming.row.elapsed_ms = incoming.row.elapsed_ms.max(self.elapsed_ms(now));
+        }
+        *self = incoming;
+    }
+
+    pub(crate) fn snapshot_is_stale(&self, revision: u64, requested_at: Instant) -> bool {
+        self.row.revision >= revision && self.observed_at >= requested_at
+    }
+
+    pub(crate) fn progress(&self) -> LiveResponseProgress {
+        LiveResponseProgress {
+            elapsed_ms: self.row.elapsed_ms,
+            observed_at: self.observed_at,
+            received_payload_bytes: self.row.received_payload_bytes,
+        }
+    }
+}
+
+/// The status row retains only its clock and transport count, not usage payloads.
+#[derive(Debug, Clone, Copy)]
+pub(crate) struct LiveResponseProgress {
+    elapsed_ms: u64,
+    observed_at: Instant,
+    received_payload_bytes: u64,
+}
+
+impl LiveResponseProgress {
+    pub(crate) fn elapsed_ms(&self, now: Instant) -> u64 {
+        self.elapsed_ms.saturating_add(
+            now.saturating_duration_since(self.observed_at)
+                .as_millis()
+                .try_into()
+                .unwrap_or(u64::MAX),
+        )
+    }
+
+    pub(crate) fn receive_label(&self) -> String {
+        format!(
+            "Received {:.1}KiB",
+            self.received_payload_bytes as f64 / 1024.0
+        )
+    }
+}
+
+#[derive(Default)]
+pub(crate) struct ResponseTiming {
+    latest: Option<ObservedResponse>,
+    last: Option<ResponsePerformance>,
+}
+
+impl ResponseTiming {
+    pub(crate) fn has_observations(&self) -> bool {
+        self.latest.is_some() || self.last.is_some()
+    }
+
+    pub(crate) fn update(&mut self, row: ResponseAttempt, active: bool, observed_at: Instant) {
+        if row.end_reason.is_some() && row.request_kind == "generation" {
+            self.restore_performance(ResponsePerformance::from(&row));
+        }
+        match &mut self.latest {
+            Some(current) if current.row.attempt_id == row.attempt_id => {
+                current.update(ObservedResponse::new(row, active, observed_at));
+            }
+            Some(current) if current.row.attempt_id > row.attempt_id => {}
+            _ => self.latest = Some(ObservedResponse::new(row, active, observed_at)),
+        }
+    }
+
+    pub(crate) fn reset_turn(&mut self) {
+        self.latest = None;
+    }
+
+    pub(crate) fn restore_performance(&mut self, last: ResponsePerformance) {
+        // Ended records are immutable at the publisher. A late page may only
+        // advance the identity, never replace newer generation performance.
+        if self
+            .last
+            .as_ref()
+            .is_none_or(|current| current.attempt_id < last.attempt_id)
+        {
+            self.last = Some(last);
+        }
+    }
+
+    pub(crate) fn snapshot(
+        &mut self,
+        row: ResponseAttempt,
+        active: bool,
+        requested_at: Instant,
+        observed_at: Instant,
+    ) {
+        if self.latest.as_ref().is_some_and(|current| {
+            current.row.attempt_id == row.attempt_id
+                && current.snapshot_is_stale(row.revision, requested_at)
+        }) {
+            return;
+        }
+        self.update(row, active, observed_at);
+    }
+
+    pub(crate) fn latest(&self) -> Option<&ObservedResponse> {
+        self.latest.as_ref()
+    }
+
+    pub(crate) fn last_performance(&self) -> String {
+        format!(
+            "Last TTFB {} TPS {}",
+            seconds(self.last.as_ref().and_then(|row| row.ttfb_ms)),
+            tps(self.last.as_ref().and_then(|row| row.tps))
+        )
+    }
+
+    pub(crate) fn live_receive(&self) -> Option<String> {
+        self.latest
+            .as_ref()
+            .filter(|row| row.is_receiving())
+            .map(|row| row.progress().receive_label())
+    }
+
+    pub(crate) fn last_ttfc(&self) -> String {
+        seconds(self.last.as_ref().and_then(|row| row.ttfc_ms))
+    }
+
+    pub(crate) fn last_tps(&self) -> String {
+        tps(self.last.as_ref().and_then(|row| row.tps))
+    }
+}
+
+pub(crate) fn seconds(ms: Option<u64>) -> String {
+    ms.map_or_else(|| "--".into(), |ms| format!("{:.2}s", ms as f64 / 1000.0))
+}
+
+pub(crate) fn tps(rate: Option<f64>) -> String {
+    rate.map_or_else(|| "--".into(), |rate| format!("{rate:.1}"))
+}
+
