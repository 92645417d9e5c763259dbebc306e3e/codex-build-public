+#[tokio::test]
+async fn response_column_save_error_keeps_the_previous_selection_visible() -> anyhow::Result<()> {
+    let mut app = crate::app::test_support::make_test_app().await;
+    let mut tui = crate::tui::test_support::make_test_tui()?;
+    app.local_settings.tui.response_columns = Some(vec!["session".into()]);
+    app.open_response_browser(&mut tui);
+    app.local_settings.user_config_path = app.config.codex_home.clone();
+    app.save_response_columns(vec![ResponseColumn::Id]).await;
+    assert_eq!(
+        app.local_settings.tui.response_columns,
+        Some(vec!["session".into()])
+    );
+    let Some(Overlay::Responses(browser)) = &mut app.overlay else {
+        panic!("browser")
+    };
+    assert!(
+        browser
+            .history
+            .error
+            .as_deref()
+            .unwrap()
+            .contains("keeping previous selection")
+    );
+    let area = ratatui::layout::Rect::new(0, 0, 100, 20);
+    let mut buffer = ratatui::buffer::Buffer::empty(area);
+    browser.render(area, &mut buffer);
+    let y = crate::resume_picker::layout::areas(area).search.y;
+    let header = (0..area.width)
+        .map(|x| buffer[(x, y)].symbol())
+        .collect::<String>();
+    assert_eq!(header.trim(), "Session");
+    Ok(())
+}
