+use super::*;
+use crate::response_timing::tests::attempt;
+use crate::response_timing::tests::page;
+use pretty_assertions::assert_eq;
+
+#[tokio::test]
+async fn late_pages_cannot_replace_another_overlay_or_reopen_a_closed_browser() -> anyhow::Result<()>
+{
+    let (mut app, mut events, _) = crate::app::tests::make_test_app_with_channels().await;
+    let mut tui = crate::tui::test_support::make_test_tui()?;
+    app.open_response_browser(&mut tui);
+    let request_id = loop {
+        if let AppEvent::ReadResponseAttempts { request_id, .. } = events.try_recv()? {
+            break request_id;
+        }
+    };
+    app.finish_response_attempts(Uuid::new_v4(), Err("stale".into()), Ok(Prices::new()));
+    assert!(
+        matches!(&app.overlay, Some(Overlay::Responses(browser)) if browser.history.accepts(request_id))
+    );
+    app.overlay = Some(Overlay::new_static_with_lines(
+        vec!["other".into()],
+        "Other".into(),
+        app.keymap.pager.clone(),
+    ));
+    app.finish_response_attempts(request_id, Ok(page(Vec::new())), Ok(Prices::new()));
+    assert!(matches!(app.overlay, Some(Overlay::Static(_))));
+    app.overlay = None;
+    app.finish_response_attempts(request_id, Err("late".into()), Ok(Prices::new()));
+    assert!(app.overlay.is_none());
+    Ok(())
+}
+
+#[tokio::test]
+async fn native_page_read_and_global_notifications_reach_the_selected_browser()
+-> crate::app::Result<()> {
+    use codex_app_server_client::AppServerEvent;
+    use codex_app_server_protocol::ResponseAttemptUpdatedNotification;
+    use codex_app_server_protocol::ServerNotification;
+    use codex_protocol::response_metrics::ResponseAttemptEnd;
+    let (mut app, mut events, mut ops) = crate::app::tests::make_test_app_with_channels().await;
+    let mut tui = crate::tui::test_support::make_test_tui()?;
+    let mut server = crate::start_embedded_app_server_for_picker(&app.config).await?;
+    let mut row = attempt(1, Some(ResponseAttemptEnd::Completed));
+    row.response_id = Some("resp_recorded".into());
+    app.active_thread_id = Some(row.thread_id);
+    app.handle_event(&mut tui, &mut server, AppEvent::OpenResponseBrowser)
+        .await?;
+    for inject_live in [false, true] {
+        if inject_live {
+            app.open_response_browser(&mut tui);
+        }
+        tokio::time::timeout(std::time::Duration::from_secs(10), async {
+            loop {
+                let event = events.recv().await.expect("app event channel");
+                if let AppEvent::ReadResponseAttempts { params, .. } = &event {
+                    assert_eq!(params.thread_id, None);
+                    if inject_live {
+                        app.handle_app_server_event(
+                            &server,
+                            AppServerEvent::ServerNotification(Box::new(
+                                ServerNotification::ResponseAttemptUpdated(
+                                    ResponseAttemptUpdatedNotification {
+                                        thread_id: row.thread_id.to_string(),
+                                        attempt: row.clone(),
+                                        quota: None,
+                                    },
+                                ),
+                            )),
+                        )
+                        .await;
+                    }
+                }
+                let loaded = matches!(event, AppEvent::ResponseAttemptsLoaded { .. });
+                app.handle_event(&mut tui, &mut server, event).await?;
+                if loaded {
+                    break;
+                }
+            }
+            Ok::<_, color_eyre::Report>(())
+        })
+        .await
+        .map_err(color_eyre::Report::msg)??;
+        let Some(Overlay::Responses(browser)) = &mut app.overlay else {
+            panic!("browser")
+        };
+        assert_eq!(browser.history.count(), usize::from(inject_live));
+        assert!(!browser.history.is_loading());
+    }
+    app.handle_event(
+        &mut tui,
+        &mut server,
+        AppEvent::ResponseBrowserColumnsSelected {
+            columns: vec![
+                crate::response_table::ResponseColumn::Model,
+                crate::response_table::ResponseColumn::Id,
+            ],
+        },
+    )
+    .await?;
+    let Some(Overlay::Responses(browser)) = &mut app.overlay else {
+        panic!("browser")
+    };
+    let area = ratatui::layout::Rect::new(0, 0, 100, 20);
+    let mut buffer = ratatui::buffer::Buffer::empty(area);
+    browser.render(area, &mut buffer);
+    let areas = crate::resume_picker::layout::areas(area);
+    let line = |y| {
+        (0..area.width)
+            .map(|x| buffer[(x, y)].symbol())
+            .collect::<String>()
+    };
+    assert!(line(areas.search.y).contains("ID"));
+    assert!(!line(areas.search.y).contains("Input"));
+    assert!(line(areas.list.y).contains("resp_recorded"));
+    assert!(ops.try_recv().is_err());
+    server.shutdown().await?;
+    Ok(())
+}
+
+#[tokio::test]
+async fn response_column_order_and_empty_selection_survive_reopen_and_config_reload()
+-> anyhow::Result<()> {
+    let mut app = crate::app::test_support::make_test_app().await;
+    let mut tui = crate::tui::test_support::make_test_tui()?;
+    app.open_response_browser(&mut tui);
+    for columns in [
+        vec![
+            ResponseColumn::Session,
+            ResponseColumn::Model,
+            ResponseColumn::Id,
+        ],
+        vec![ResponseColumn::Id, ResponseColumn::Session],
+        Vec::new(),
+    ] {
+        app.save_response_columns(columns.clone()).await;
+        let ids = columns
+            .iter()
+            .map(|column| column.as_ref().to_owned())
+            .collect::<Vec<_>>();
+        assert_eq!(app.local_settings.tui.response_columns.as_ref(), Some(&ids));
+        for reload in [false, true] {
+            if reload {
+                let config = crate::legacy_core::config::ConfigBuilder::default()
+                    .codex_home(app.config.codex_home.to_path_buf())
+                    .loader_overrides(codex_config::LoaderOverrides {
+                        ignore_project_config: true,
+                        ..codex_config::LoaderOverrides::without_managed_config_for_tests()
+                    })
+                    .build()
+                    .await?;
+                assert_eq!(config.tui_response_columns.as_ref(), Some(&ids));
+                let bootstrap = crate::legacy_core::config::load_config_toml_with_layer_stack(
+                    app.config.codex_home.as_path(),
+                    None,
+                    Vec::new(),
+                    codex_config::LoaderOverrides {
+                        ignore_project_config: true,
+                        ..codex_config::LoaderOverrides::without_managed_config_for_tests()
+                    },
+                )
+                .await?;
+                app.local_settings = crate::local_settings::LocalSettings::from_bootstrap(
+                    &bootstrap,
+                    config.codex_home.clone(),
+                )?;
+                assert_eq!(app.local_settings.tui.response_columns.as_ref(), Some(&ids));
+            }
+            app.overlay = None;
+            app.open_response_browser(&mut tui);
+            let Some(Overlay::Responses(browser)) = &mut app.overlay else {
+                panic!("reopened browser")
+            };
+            let area = ratatui::layout::Rect::new(0, 0, 200, 20);
+            let mut buffer = ratatui::buffer::Buffer::empty(area);
+            browser.render(area, &mut buffer);
+            let y = crate::resume_picker::layout::areas(area).search.y;
+            let header = (0..area.width)
+                .map(|x| buffer[(x, y)].symbol())
+                .collect::<String>();
+            let actual = header.split_whitespace().collect::<Vec<_>>().join(" ");
+            let expected = columns
+                .iter()
+                .map(|column| column.presentation().0)
+                .collect::<Vec<_>>()
+                .join(" ");
+            assert_eq!(actual, expected);
+        }
+    }
+    Ok(())
+}
