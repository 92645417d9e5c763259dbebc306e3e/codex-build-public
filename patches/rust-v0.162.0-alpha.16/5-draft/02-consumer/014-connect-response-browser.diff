+//! The response browser shares the app-server page and notification owners.
+
+use super::App;
+use crate::app_event::AppEvent;
+use crate::app_server_session::AppServerSession;
+use crate::legacy_core::config::edit::ConfigEditsBuilder;
+use crate::legacy_core::config::edit::response_columns_edit;
+use crate::pager_overlay::Overlay;
+use crate::pager_overlay::ResponseBrowser;
+use crate::response_table::ResponseColumn;
+use crate::tui;
+use codex_app_server_protocol::ClientRequest;
+use codex_app_server_protocol::RequestId;
+use codex_app_server_protocol::ResponseAttemptsReadParams;
+use codex_app_server_protocol::ResponseAttemptsReadResponse;
+use codex_models_manager::model_pricing::Prices;
+use std::time::Instant;
+use uuid::Uuid;
+
+impl App {
+    pub(super) fn open_response_browser(&mut self, tui: &mut tui::Tui) {
+        if let Some(Overlay::Responses(browser)) = &mut self.overlay {
+            let request = browser.history.refresh(Instant::now());
+            browser.request(request);
+            return;
+        }
+        if !self.app_keymap_shortcuts_available() {
+            return;
+        }
+        let columns = match &self.local_settings.tui.response_columns {
+            None => ResponseColumn::DEFAULT.to_vec(),
+            Some(ids) => match ids
+                .iter()
+                .map(|id| {
+                    id.parse().map_err(|_| {
+                        format!("Unknown response column {id:?} in tui.response_columns")
+                    })
+                })
+                .collect::<Result<Vec<ResponseColumn>, _>>()
+            {
+                Ok(columns) => columns,
+                Err(error) => {
+                    self.chat_widget.add_error_message(error);
+                    tui.frame_requester().schedule_frame();
+                    return;
+                }
+            },
+        };
+        if let Err(error) = tui.enter_alt_screen() {
+            self.chat_widget
+                .add_error_message(format!("Could not open Model Responses: {error}"));
+            tui.frame_requester().schedule_frame();
+            return;
+        }
+        self.overlay = Some(Overlay::Responses(Box::new(ResponseBrowser::new(
+            columns,
+            self.keymap.list.clone(),
+            tui.frame_requester(),
+            self.app_event_tx.clone(),
+        ))));
+        tui.frame_requester().schedule_frame();
+    }
+
+    pub(super) async fn save_response_columns(&mut self, columns: Vec<ResponseColumn>) {
+        if !matches!(&self.overlay, Some(Overlay::Responses(browser)) if !browser.done) {
+            return;
+        }
+        let ids = columns
+            .iter()
+            .map(|column| column.as_ref().to_owned())
+            .collect::<Vec<_>>();
+        let result =
+            ConfigEditsBuilder::for_config_path(self.local_settings.user_config_path.as_path())
+                .with_edits([response_columns_edit(&ids)])
+                .apply()
+                .await;
+        if let Some(Overlay::Responses(browser)) = &mut self.overlay {
+            match result {
+                Ok(()) => {
+                    self.local_settings.tui.response_columns = Some(ids);
+                    browser.set_columns(columns);
+                }
+                Err(error) => {
+                    browser.history.error = Some(format!(
+                        "Failed to save response columns; keeping previous selection: {error}"
+                    ));
+                    browser.request(None);
+                }
+            }
+        }
+    }
+
+    pub(super) fn read_response_attempts(
+        &self,
+        app_server: &AppServerSession,
+        request_id: Uuid,
+        params: ResponseAttemptsReadParams,
+    ) {
+        if !matches!(&self.overlay, Some(Overlay::Responses(browser)) if !browser.done && browser.history.accepts(request_id))
+        {
+            return;
+        }
+        let handle = app_server.request_handle();
+        let home = self.config.codex_home.clone();
+        let events = self.app_event_tx.clone();
+        tokio::spawn(async move {
+            let prices = tokio::task::spawn_blocking(move || {
+                codex_models_manager::model_pricing::read_prices(&home)
+            });
+            let result = handle
+                .request_typed(ClientRequest::ResponseAttemptsRead {
+                    request_id: RequestId::String(request_id.to_string()),
+                    params,
+                })
+                .await
+                .map_err(|error| error.to_string());
+            let prices = prices
+                .await
+                .map_err(|error| format!("pricing task failed: {error}"))
+                .and_then(|result| result.map_err(|error| error.to_string()));
+            events.send(AppEvent::ResponseAttemptsLoaded {
+                request_id,
+                result,
+                prices,
+            });
+        });
+    }
+
+    pub(super) fn finish_response_attempts(
+        &mut self,
+        request_id: Uuid,
+        result: Result<ResponseAttemptsReadResponse, String>,
+        prices: Result<Prices, String>,
+    ) {
+        if let Some(Overlay::Responses(browser)) = &mut self.overlay
+            && !browser.done
+        {
+            let request = browser
+                .history
+                .finish(request_id, result, prices, Instant::now());
+            browser.request(request);
+        }
+    }
+}
+
