+#[tokio::test]
+async fn column_picker_searches_toggles_confirms_and_cancels_without_changing_history() {
+    let (mut browser, mut events) = browser();
+    events.try_recv().unwrap();
+    assert!(browser.columns.len() < ResponseColumn::ALL.len());
+    assert!(!browser.columns.contains(&ResponseColumn::ServedModel));
+    browser.handle_key(KeyCode::Char('c').into());
+    assert!(browser.column_picker.is_some());
+    let area = Rect::new(0, 0, 120, 24);
+    let mut buffer = Buffer::empty(area);
+    browser.render(area, &mut buffer);
+    assert!(
+        buffer
+            .content
+            .iter()
+            .map(|cell| cell.symbol())
+            .collect::<String>()
+            .contains("Response columns")
+    );
+    for c in "Session".chars() {
+        browser.handle_key(KeyCode::Char(c).into());
+    }
+    browser.handle_key(KeyCode::Char(' ').into());
+    browser.handle_key(KeyCode::Enter.into());
+    assert!(browser.column_picker.is_none());
+    let AppEvent::ResponseBrowserColumnsSelected { columns } = events.try_recv().unwrap() else {
+        panic!("selected columns")
+    };
+    assert!(columns.contains(&ResponseColumn::Session));
+    assert!(
+        ResponseColumn::DEFAULT
+            .iter()
+            .all(|column| columns.contains(column))
+    );
+    assert!(!columns.contains(&ResponseColumn::ServedModel));
+    browser.set_columns(columns.clone());
+    browser.handle_key(KeyCode::Char('c').into());
+    for c in "Session".chars() {
+        browser.handle_key(KeyCode::Char(c).into());
+    }
+    browser.handle_key(KeyCode::Char(' ').into());
+    browser.handle_key(KeyCode::Esc.into());
+    assert!(browser.column_picker.is_none());
+    assert_eq!(browser.columns, columns);
+    assert!(events.try_recv().is_err());
+    browser.handle_key(KeyCode::Char('c').into());
+    browser.handle_key(KeyEvent::new(KeyCode::Char('c'), KeyModifiers::CONTROL));
+    assert!(browser.column_picker.is_none());
+    assert!(!browser.done);
+    assert!(browser.history.is_loading());
+    browser.handle_key(KeyCode::Char('c').into());
+    browser.handle_key(KeyCode::Right.into());
+    browser.handle_key(KeyCode::Enter.into());
+    let AppEvent::ResponseBrowserColumnsSelected { columns: reordered } =
+        events.try_recv().unwrap()
+    else {
+        panic!("reordered columns")
+    };
+    let mut expected = columns;
+    expected.swap(0, 1);
+    assert_eq!(reordered, expected);
+    browser.set_columns(reordered.clone());
+    browser.handle_key(KeyCode::Char('c').into());
+    browser.handle_key(KeyCode::Enter.into());
+    let AppEvent::ResponseBrowserColumnsSelected { columns } = events.try_recv().unwrap() else {
+        panic!("reopened columns")
+    };
+    assert_eq!(columns, reordered);
+}
