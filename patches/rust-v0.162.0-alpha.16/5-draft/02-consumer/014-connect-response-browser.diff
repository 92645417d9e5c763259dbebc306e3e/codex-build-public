+use super::*;
+use crate::response_timing::tests::attempt;
+use crate::response_timing::tests::page;
+use codex_models_manager::model_pricing::Prices;
+use codex_protocol::response_metrics::ResponseAttemptEnd;
+use crossterm::event::KeyModifiers;
+use pretty_assertions::assert_eq;
+use ratatui::style::Modifier;
+
+fn browser() -> (
+    ResponseBrowser,
+    tokio::sync::mpsc::UnboundedReceiver<AppEvent>,
+) {
+    let (events, received) = tokio::sync::mpsc::unbounded_channel();
+    (
+        ResponseBrowser::new(
+            ResponseColumn::DEFAULT.to_vec(),
+            crate::keymap::RuntimeKeymap::defaults().list,
+            FrameRequester::test_dummy(),
+            AppEventSender::new(events),
+        ),
+        received,
+    )
+}
+
+fn line(buffer: &Buffer, y: u16) -> String {
+    (buffer.area.x..buffer.area.right())
+        .map(|x| buffer[(x, y)].symbol())
+        .collect()
+}
+
+#[tokio::test]
+async fn browser_reuses_native_theme_loading_footer_and_blank_bottom_row() {
+    let (mut browser, mut events) = browser();
+    let AppEvent::ReadResponseAttempts { request_id, params } = events.try_recv().unwrap() else {
+        panic!("initial page")
+    };
+    assert_eq!(params.thread_id, None);
+    let mut response = page(
+        (1..=30)
+            .map(|id| {
+                let mut row = attempt(id, Some(ResponseAttemptEnd::Completed));
+                row.requested_model = if id % 2 == 0 { "model-a" } else { "model-b" }.into();
+                row
+            })
+            .collect(),
+    );
+    response.next_cursor = Some("older".into());
+    browser
+        .history
+        .finish(request_id, Ok(response), Ok(Prices::new()), Instant::now());
+    let area = Rect::new(0, 0, 140, 20);
+    let areas = resume_picker::layout::areas(area);
+    for bg in [(20, 35, 50), (250, 241, 235)] {
+        crate::terminal_palette::with_test_default_colors(
+            crate::terminal_probe::DefaultColors {
+                fg: (180, 220, 255),
+                bg,
+            },
+            || {
+                let mut buffer = Buffer::empty(area);
+                browser.render(area, &mut buffer);
+                assert!(!line(&buffer, areas.toolbar.y).contains("Filter:"));
+                assert!(!line(&buffer, areas.toolbar.y).contains("Columns"));
+                assert!(line(&buffer, areas.toolbar.y).contains("Model:  All  model-a  model-b"));
+                assert!(line(&buffer, areas.search.y).contains("Requested model"));
+                assert!(!line(&buffer, areas.search.y).contains("Served model"));
+                assert!(line(&buffer, areas.footer.y - 1).contains("↓ more"));
+                assert!(line(&buffer, areas.footer.y).contains("1 / 30 · 0%"));
+                assert!(line(&buffer, areas.footer.y + 1).contains("columns"));
+                assert!(!line(&buffer, areas.footer.y + 1).contains("tab"));
+                assert!(line(&buffer, area.bottom() - 1).trim().is_empty());
+                let all_x = line(&buffer, areas.toolbar.y).find("All").unwrap() as u16;
+                assert!(
+                    buffer[(all_x, areas.toolbar.y)]
+                        .modifier
+                        .contains(Modifier::BOLD)
+                );
+                assert_ne!(
+                    buffer[(2, areas.list.y + 1)].bg,
+                    buffer[(2, areas.list.y + 2)].bg
+                );
+                let text = buffer
+                    .content
+                    .iter()
+                    .map(|cell| cell.symbol())
+                    .collect::<String>();
+                assert!(!text.contains(&attempt(1, None).thread_id.to_string()));
+                assert!(!text.contains("Type to search"));
+                assert_eq!(
+                    buffer[(2, areas.list.y)].bg,
+                    resume_picker::dense_selected_style().bg.unwrap()
+                );
+                assert_eq!(
+                    buffer[(2, areas.list.y + 2)].bg,
+                    resume_picker::dense_zebra_style().bg.unwrap()
+                );
+            },
+        );
+    }
+    browser.handle_key(KeyCode::End.into());
+    assert!(matches!(
+        events.try_recv().unwrap(),
+        AppEvent::ReadResponseAttempts { .. }
+    ));
+    let mut loading = Buffer::empty(area);
+    browser.render(area, &mut loading);
+    assert!(line(&loading, areas.list.y).contains("↑ more"));
+    assert!(line(&loading, areas.footer.y - 1).contains("↓ loading more"));
+    assert!(line(&loading, areas.footer.y).contains("30…"));
+    browser.handle_key(KeyCode::Right.into());
+    let AppEvent::ReadResponseAttempts { params, .. } = events.try_recv().unwrap() else {
+        panic!("model page")
+    };
+    assert_eq!(params.model.as_deref(), Some("model-a"));
+    assert_eq!(params.thread_id, None);
+    browser.handle_key(KeyCode::Tab.into());
+    browser.handle_key(KeyCode::Right.into());
+    let AppEvent::ReadResponseAttempts { params, .. } = events.try_recv().unwrap() else {
+        panic!("model page after Tab")
+    };
+    assert_eq!(params.model.as_deref(), Some("model-b"));
+}
+
+#[tokio::test]
+async fn browser_has_no_hidden_close_key_and_columns_remain_accessible_after_resize() {
+    let (mut browser, mut events) = browser();
+    let AppEvent::ReadResponseAttempts { request_id, .. } = events.try_recv().unwrap() else {
+        panic!("page")
+    };
+    let row = attempt(1, Some(ResponseAttemptEnd::Completed));
+    browser.history.finish(
+        request_id,
+        Ok(page(vec![row])),
+        Ok(Prices::new()),
+        Instant::now(),
+    );
+    for key in [
+        KeyCode::Char('q').into(),
+        KeyCode::Tab.into(),
+        KeyCode::BackTab.into(),
+        KeyCode::Enter.into(),
+        KeyEvent::new(KeyCode::Char('e'), KeyModifiers::CONTROL),
+    ] {
+        browser.handle_key(key);
+        assert!(!browser.done);
+        assert!(browser.column_picker.is_none());
+    }
+    browser.set_columns(ResponseColumn::ALL.to_vec());
+    for _ in 0..100 {
+        browser.handle_key(KeyEvent::new(KeyCode::Right, KeyModifiers::CONTROL));
+    }
+    let area = Rect::new(0, 0, 80, 16);
+    let areas = resume_picker::layout::areas(area);
+    let mut buffer = Buffer::empty(area);
+    browser.render(area, &mut buffer);
+    assert!(line(&buffer, areas.search.y).contains("Session"));
+    assert!(line(&buffer, areas.list.y).contains(&attempt(1, None).thread_id.to_string()));
+    for (width, height) in [(1, 1), (10, 4), (80, 10), (600, 20)] {
+        let area = Rect::new(0, 0, width, height);
+        browser.render(area, &mut Buffer::empty(area));
+    }
+    assert_eq!(browser.column_offset, 0);
+    browser.handle_key(KeyCode::Esc.into());
+    assert!(browser.done);
+}
