+#[tokio::test]
+async fn column_shortcut_respects_bindings_without_a_tab_control() {
+    let (mut browser, mut events) = browser();
+    let AppEvent::ReadResponseAttempts { request_id, .. } = events.try_recv().unwrap() else {
+        panic!("initial page")
+    };
+    browser.history.finish(
+        request_id,
+        Ok(page(vec![
+            attempt(1, Some(ResponseAttemptEnd::Completed)),
+            attempt(2, Some(ResponseAttemptEnd::Completed)),
+        ])),
+        Ok(Prices::new()),
+        Instant::now(),
+    );
+    // The full runtime also shares list navigation with approval overlays.
+    // Unbind their default `c` action before assigning the key to navigation.
+    let config = toml::from_str(
+        "[list]\nmove_down = 'c'\naccept = 'ctrl-s'\ncancel = 'q'\n[approval]\ncancel = []",
+    )
+    .unwrap();
+    browser.keymap = crate::keymap::RuntimeKeymap::from_config(&config)
+        .unwrap()
+        .list;
+    browser.handle_key(KeyCode::Char('c').into());
+    assert_eq!(browser.history.selected, 1);
+    assert!(browser.column_picker.is_none());
+    for key in [
+        KeyCode::Tab.into(),
+        KeyCode::BackTab.into(),
+        KeyEvent::new(KeyCode::Char('s'), KeyModifiers::CONTROL),
+    ] {
+        browser.handle_key(key);
+        assert!(browser.column_picker.is_none());
+        assert_eq!(browser.history.selected, 1);
+    }
+    assert!(!browser.toolbar(8).to_string().contains("Columns"));
+    assert!(browser.footer(200).iter().all(|line| {
+        let text = line.to_string();
+        !text.contains("choose columns") && !text.contains("focus controls")
+    }));
+    browser.handle_key(KeyCode::Char('q').into());
+    assert!(browser.done);
+}
