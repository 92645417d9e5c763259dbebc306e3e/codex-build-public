diff --git a/codex-rs/tui/src/pager_overlay/response_browser.rs b/codex-rs/tui/src/pager_overlay/response_browser.rs
new file mode 100644
--- /dev/null
+++ b/codex-rs/tui/src/pager_overlay/response_browser.rs
@@ -0,0 +1,408 @@
+//! Response rows in the real resume picker's geometry, controls, and footer.
+
+use crate::app_event::AppEvent;
+use crate::app_event_sender::AppEventSender;
+use crate::bottom_pane::BottomPaneView;
+use crate::bottom_pane::MultiSelectItem;
+use crate::bottom_pane::MultiSelectPicker;
+use crate::key_hint;
+use crate::keymap::ListAction;
+use crate::keymap::ListKeymap;
+use crate::response_history::ResponseHistory;
+use crate::response_history::ResponsePageRequest;
+use crate::response_table::ResponseColumn;
+use crate::response_table::ResponseTable;
+use crate::resume_picker;
+use crate::resume_picker::PickerFooterHint;
+use crate::tui;
+use crate::tui::FrameRequester;
+use crate::tui::TuiEvent;
+use crossterm::event::KeyCode;
+use crossterm::event::KeyEvent;
+use crossterm::event::KeyEventKind;
+use ratatui::buffer::Buffer;
+use ratatui::layout::Rect;
+use ratatui::style::Stylize;
+use ratatui::text::Line;
+use ratatui::widgets::Clear;
+use ratatui::widgets::Widget;
+use std::time::Duration;
+use std::time::Instant;
+
+pub(crate) struct ResponseBrowser {
+    pub(crate) history: ResponseHistory,
+    columns: Vec<ResponseColumn>,
+    column_picker: Option<MultiSelectPicker>,
+    column_offset: u16,
+    keymap: ListKeymap,
+    frames: FrameRequester,
+    events: AppEventSender,
+    pub(crate) done: bool,
+}
+
+impl ResponseBrowser {
+    pub(crate) fn new(
+        columns: Vec<ResponseColumn>,
+        keymap: ListKeymap,
+        frames: FrameRequester,
+        events: AppEventSender,
+    ) -> Self {
+        let mut browser = Self {
+            history: ResponseHistory::new(),
+            columns,
+            column_picker: None,
+            column_offset: 0,
+            keymap,
+            frames,
+            events,
+            done: false,
+        };
+        let request = browser.history.refresh(Instant::now());
+        browser.request(request);
+        browser
+    }
+
+    fn choose_columns(&mut self) {
+        self.column_picker = Some(
+            MultiSelectPicker::builder(
+                "Response columns".into(),
+                Some("Choose and reorder visible columns.".into()),
+                self.events.clone(),
+            )
+            .items(
+                self.columns
+                    .iter()
+                    .chain(
+                        ResponseColumn::ALL
+                            .iter()
+                            .filter(|column| !self.columns.contains(column)),
+                    )
+                    .map(|column| {
+                        let (name, description) = column.presentation();
+                        MultiSelectItem {
+                            id: column.as_ref().into(),
+                            name: name.into(),
+                            description: Some(description.into()),
+                            enabled: self.columns.contains(column),
+                            orderable: true,
+                            section_break_after: false,
+                        }
+                    })
+                    .collect(),
+            )
+            .enable_ordering()
+            .list_keymap(self.keymap.clone())
+            .on_confirm(|selected, events| {
+                events.send(AppEvent::ResponseBrowserColumnsSelected {
+                    columns: selected
+                        .iter()
+                        .map(|id| {
+                            id.parse()
+                                .expect("response column picker contains known columns")
+                        })
+                        .collect(),
+                });
+            })
+            .build(),
+        );
+    }
+
+    pub(crate) fn set_columns(&mut self, columns: Vec<ResponseColumn>) {
+        self.columns = columns;
+        self.column_offset = 0;
+        self.frames.schedule_frame();
+    }
+
+    pub(crate) fn request(&self, request: Option<ResponsePageRequest>) {
+        if let Some(request) = request {
+            self.events.send(AppEvent::ReadResponseAttempts {
+                request_id: request.id,
+                params: request.params,
+            });
+        }
+        self.frames.schedule_frame();
+    }
+
+    pub(crate) fn render(&mut self, area: Rect, buffer: &mut Buffer) {
+        Clear.render(area, buffer);
+        let areas = resume_picker::layout::areas(area);
+        let inset = |area: Rect, n| {
+            Rect::new(
+                area.x.saturating_add(n),
+                area.y,
+                area.width.saturating_sub(n * 2),
+                area.height,
+            )
+        };
+        let mut title = Line::from("Model Responses".bold());
+        let estimate = self
+            .history
+            .quota
+            .as_ref()
+            .and_then(|quota| quota.value)
+            .map_or_else(|| "--".into(), |value| format!("${:.2}", value.center));
+        title.push_span(format!(" | Estimated weekly quota: {estimate}"));
+        if let Some(quota) = &self.history.quota {
+            title.push_span(format!(" | {}% left", quota.remaining_percent));
+        }
+        for error in [
+            self.history.error.as_ref(),
+            self.history.persistence_error.as_ref(),
+            self.history.pricing_error.as_ref(),
+            self.history.prices.as_ref().err(),
+        ]
+        .into_iter()
+        .flatten()
+        {
+            title.push_span(format!(" | {error}"));
+        }
+        title.render(inset(areas.header, 1), buffer);
+        self.toolbar(areas.toolbar.width.saturating_sub(2))
+            .render(inset(areas.toolbar, 1), buffer);
+        let list = inset(areas.list, 2);
+        let request = self
+            .history
+            .update_viewport(usize::from(list.height), Instant::now());
+        if request.is_some() {
+            self.request(request);
+        }
+        let rows = self.history.rows().collect::<Vec<_>>();
+        let table = ResponseTable::new(
+            &rows,
+            &self.columns,
+            self.history.prices.as_ref().ok(),
+            Instant::now(),
+        );
+        self.column_offset = self.column_offset.min(table.max_offset(list.width));
+        table.render_headers(inset(areas.search, 2), buffer, self.column_offset);
+        let above = self.history.scroll_top > 0;
+        let below = self.history.more_below();
+        let capacity = usize::from(
+            list.height
+                .saturating_sub(u16::from(above) + u16::from(below)),
+        )
+        .min(self.history.visible_rows());
+        if rows.is_empty() {
+            Line::from(if self.history.is_loading() {
+                "Loading responses..."
+            } else {
+                "No matching responses."
+            })
+            .dim()
+            .render(list, buffer);
+        }
+        if above && list.height > 0 {
+            resume_picker::more_line("↑ more")
+                .render(Rect::new(list.x, list.y, list.width, 1), buffer);
+        }
+        if below && list.height > 0 {
+            resume_picker::more_line(if self.history.is_loading() {
+                "↓ loading more"
+            } else {
+                "↓ more"
+            })
+            .render(Rect::new(list.x, list.bottom() - 1, list.width, 1), buffer);
+        }
+        if areas.footer.height > 0 {
+            resume_picker::render_picker_footer_separator(
+                buffer,
+                Rect::new(areas.footer.x, areas.footer.y, areas.footer.width, 1),
+                resume_picker::footer_progress_label(
+                    self.history.selected,
+                    rows.len(),
+                    self.history.is_loading(),
+                    self.history.percent(),
+                    areas.footer.width,
+                ),
+            );
+            for (index, line) in self.footer(areas.footer.width).into_iter().enumerate() {
+                let y = areas.footer.y + 1 + index as u16;
+                if y < areas.footer.bottom() {
+                    line.render(Rect::new(area.x, y, area.width, 1), buffer);
+                }
+            }
+        }
+        for index in (self.history.scroll_top..rows.len()).take(capacity) {
+            table.render_row(
+                index,
+                index == self.history.selected,
+                Rect::new(
+                    list.x,
+                    list.y + u16::from(above) + (index - self.history.scroll_top) as u16,
+                    list.width,
+                    1,
+                ),
+                buffer,
+                self.column_offset,
+            );
+        }
+        if let Some(picker) = &self.column_picker {
+            use crate::render::renderable::Renderable;
+
+            let width = area.width.min(100);
+            let height = picker.desired_height(width).min(area.height);
+            let popup = Rect::new(
+                area.x + (area.width - width) / 2,
+                area.y + (area.height - height) / 2,
+                width,
+                height,
+            );
+            Clear.render(popup, buffer);
+            picker.render(popup, buffer);
+        }
+    }
+
+    fn toolbar(&self, width: u16) -> Line<'static> {
+        let mut model = vec![
+            "Model: ".into(),
+            resume_picker::toolbar_value("All", self.history.model().is_none(), true),
+        ];
+        model.extend(self.history.models.iter().map(|model| {
+            resume_picker::toolbar_value(model, self.history.model() == Some(model.as_str()), true)
+        }));
+        let line = Line::from(model);
+        if line.width() <= usize::from(width) {
+            return line;
+        }
+        Line::from(vec![
+            "Model: ".into(),
+            resume_picker::toolbar_value(self.history.model().unwrap_or("All"), true, true),
+        ])
+    }
+
+    fn footer(&self, width: u16) -> [Line<'static>; 2] {
+        let hint = |key: String, label: &str, priority| PickerFooterHint {
+            key,
+            wide_label: label.into(),
+            compact_label: label.into(),
+            priority,
+        };
+        let mut controls = vec![
+            hint(
+                key_hint::ctrl(KeyCode::Char('c')).display_label(),
+                "exit",
+                3,
+            ),
+            hint(
+                key_hint::alt(KeyCode::Char('/')).display_label(),
+                "refresh",
+                4,
+            ),
+        ];
+        if let Some(cancel) = self.keymap.primary_hint(ListAction::Cancel) {
+            controls.insert(0, hint(cancel.display_label(), "exit", 0));
+        }
+        if self.keymap.action_for(KeyCode::Char('c').into()).is_none() {
+            controls.push(hint("c".into(), "choose columns", 1));
+        }
+        let mut navigation = Vec::new();
+        for (actions, label, priority) in [
+            ([ListAction::MoveUp, ListAction::MoveDown], "browse", 0),
+            ([ListAction::PageUp, ListAction::PageDown], "page", 2),
+            (
+                [ListAction::JumpTop, ListAction::JumpBottom],
+                "top/bottom",
+                3,
+            ),
+            ([ListAction::MoveLeft, ListAction::MoveRight], "option", 1),
+        ] {
+            let keys = actions
+                .into_iter()
+                .filter_map(|action| self.keymap.primary_hint(action))
+                .map(key_hint::ShortcutHint::display_label)
+                .collect::<Vec<_>>()
+                .join("/");
+            if !keys.is_empty() {
+                navigation.push(hint(keys, label, priority));
+            }
+        }
+        let columns = [KeyCode::Left, KeyCode::Right]
+            .into_iter()
+            .filter(|code| {
+                self.keymap
+                    .action_for(KeyEvent::new(
+                        *code,
+                        crossterm::event::KeyModifiers::CONTROL,
+                    ))
+                    .is_none()
+            })
+            .map(|code| key_hint::ctrl(code).display_label())
+            .collect::<Vec<_>>()
+            .join("/");
+        if !columns.is_empty() {
+            controls.push(hint(columns, "scroll columns", 2));
+        }
+        [
+            resume_picker::hint_line_for_row(&controls, width),
+            resume_picker::hint_line_for_row(&navigation, width),
+        ]
+    }
+
+    fn handle_key(&mut self, key: KeyEvent) {
+        if key.kind == KeyEventKind::Release {
+            return;
+        }
+        if let Some(picker) = &mut self.column_picker {
+            if key_hint::ctrl(KeyCode::Char('c')).is_press(key) {
+                picker.on_ctrl_c();
+            } else {
+                picker.handle_key_event(key);
+            }
+            if picker.complete {
+                self.column_picker = None;
+            }
+            self.frames.schedule_frame();
+            return;
+        }
+        let action = self.keymap.action_for(key);
+        if action != Some(ListAction::PageDown) {
+            self.history.cancel_page_down();
+        }
+        let now = Instant::now();
+        let request = if action == Some(ListAction::Cancel)
+            || key_hint::ctrl(KeyCode::Char('c')).is_press(key)
+        {
+            self.done = true;
+            None
+        } else if action.is_none() && key_hint::plain(KeyCode::Char('c')).is_press(key) {
+            self.choose_columns();
+            None
+        } else if matches!(action, Some(ListAction::MoveLeft | ListAction::MoveRight)) {
+            self.history
+                .cycle_model(action == Some(ListAction::MoveRight), now)
+        } else if let Some(action) = action {
+            self.history.navigate(action, now)
+        } else if key_hint::ctrl(KeyCode::Left).is_press(key) {
+            self.column_offset = self.column_offset.saturating_sub(8);
+            None
+        } else if key_hint::ctrl(KeyCode::Right).is_press(key) {
+            self.column_offset = self.column_offset.saturating_add(8);
+            None
+        } else {
+            return;
+        };
+        self.request(request);
+    }
+
+    pub(crate) fn handle_event(
+        &mut self,
+        tui: &mut tui::Tui,
+        event: TuiEvent,
+    ) -> std::io::Result<()> {
+        match event {
+            TuiEvent::Key(key) => self.handle_key(key),
+            TuiEvent::Draw | TuiEvent::Resume | TuiEvent::Resize(_) | TuiEvent::FocusGained => {
+                tui.draw(u16::MAX, |frame| self.render(frame.area(), frame.buffer))?;
+                if self.history.rows().any(|row| row.is_running()) {
+                    self.frames.schedule_frame_in(Duration::from_millis(250));
+                }
+            }
+            _ => {}
+        }
+        Ok(())
+    }
+}
+
