+
+/// Keep the selected row visible using each consumer's actual rendered heights.
+pub(crate) fn scroll_top_for_selection(
+    selected: usize,
+    scroll_top: usize,
+    count: usize,
+    viewport_height: usize,
+    has_older: bool,
+    height_between: impl Fn(usize, usize) -> usize,
+) -> usize {
+    if count == 0 {
+        return 0;
+    }
+    let mut top = scroll_top.min(selected);
+    while height_between(top, selected)
+        > content_rows(
+            viewport_height.max(1),
+            top > 0,
+            has_older || selected + 1 < count,
+        )
+        && top < selected
+    {
+        top += 1;
+    }
+    top
+}
