--- /dev/null
+++ b/codex-rs/core/src/response_metrics/quota.rs
@@ -0,0 +1,285 @@
+//! Weekly quota estimates from ordered receipts, independent of browser retention.
+
+use codex_models_manager::model_pricing::Prices;
+use codex_protocol::protocol::RateLimitWindow;
+use codex_protocol::response_metrics::ResponseQuotaEstimate;
+use codex_protocol::response_metrics::ResponseQuotaEstimateRange;
+use codex_protocol::response_metrics::ResponseQuotaScope;
+use codex_protocol::response_metrics::ResponseTokenCounts;
+use codex_state::ResponseAccounting;
+use std::collections::BTreeMap;
+use std::collections::BTreeSet;
+use uuid::Uuid;
+
+const WEEK_MINUTES: i64 = 7 * 24 * 60;
+const PERCENT_UNCERTAINTY: f64 = 0.99;
+
+#[derive(Debug, Default)]
+pub(super) struct QuotaEstimator {
+    scopes: BTreeMap<ResponseQuotaScope, ReceiptWindow>,
+}
+
+#[derive(Debug, Default)]
+struct ReceiptWindow {
+    since: Option<Uuid>,
+    events: BTreeMap<Uuid, Receipt>,
+}
+
+#[derive(Debug)]
+enum Receipt {
+    Usage {
+        model: String,
+        tokens: ResponseTokenCounts,
+    },
+    Quota(RateLimitWindow),
+}
+
+#[derive(Clone, Copy)]
+struct Point {
+    used_percent: u8,
+    cost: f64,
+}
+
+struct Plateau {
+    first: Point,
+    last: Point,
+}
+
+impl QuotaEstimator {
+    pub(super) fn observe(&mut self, attempt: &ResponseAccounting) {
+        let mut limits: BTreeSet<_> = attempt
+            .rate_limits
+            .iter()
+            .map(|quota| quota.limit_id.as_str())
+            .collect();
+        if limits.is_empty() {
+            limits.insert("codex");
+        }
+        for limit_id in limits {
+            let scope = ResponseQuotaScope {
+                provider: attempt.provider.clone(),
+                account_id: attempt.account_id.clone(),
+                limit_id: limit_id.to_owned(),
+            };
+            let history = self.scopes.entry(scope).or_default();
+            if let Some(sequence) = attempt.usage_observed_sequence {
+                history.events.insert(
+                    sequence,
+                    Receipt::Usage {
+                        model: attempt.model.clone(),
+                        tokens: attempt.tokens.clone(),
+                    },
+                );
+            }
+            for quota in &attempt.rate_limits {
+                if quota.limit_id != limit_id {
+                    continue;
+                }
+                if let Some(used_percent) = quota.used_percent {
+                    history.events.insert(
+                        quota.sequence,
+                        Receipt::Quota(RateLimitWindow {
+                            used_percent,
+                            window_minutes: Some(WEEK_MINUTES),
+                            resets_at: quota.resets_at,
+                        }),
+                    );
+                }
+            }
+            history.prune();
+        }
+    }
+
+    pub(super) fn merge(&mut self, restored: Self) {
+        for (scope, mut older) in restored.scopes {
+            let current = self.scopes.entry(scope).or_default();
+            current.since = current.since.max(older.since);
+            current.events.append(&mut older.events);
+            current.prune();
+        }
+    }
+
+    pub(super) fn estimates(&self, prices: Option<&Prices>) -> Vec<ResponseQuotaEstimate> {
+        self.scopes
+            .iter()
+            .filter_map(|(scope, history)| history.estimate(scope, prices))
+            .collect()
+    }
+}
+
+impl ReceiptWindow {
+    fn prune(&mut self) {
+        let mut previous: Option<&RateLimitWindow> = None;
+        let mut first = self.since;
+        for (sequence, receipt) in &self.events {
+            if let Receipt::Quota(window) = receipt {
+                if previous.is_some_and(|previous| starts_interval(previous, window)) {
+                    first = Some(first.map_or(*sequence, |first| first.max(*sequence)));
+                }
+                previous = Some(window);
+            }
+        }
+        if let Some(first) = first {
+            // Preserve the reset cutoff while merging older startup facts with
+            // concurrent live receipts; discarded intervals must not return.
+            self.since = Some(first);
+            self.events = self.events.split_off(&first);
+        }
+    }
+
+    fn estimate(
+        &self,
+        scope: &ResponseQuotaScope,
+        prices: Option<&Prices>,
+    ) -> Option<ResponseQuotaEstimate> {
+        let mut cost = 0.0;
+        let mut priced = true;
+        let mut plateaus: Vec<Plateau> = Vec::new();
+        let mut latest: Option<ResponseQuotaEstimate> = None;
+        for (sequence, receipt) in &self.events {
+            let window = match receipt {
+                Receipt::Usage { model, tokens } => {
+                    // Usage before the first quota observation is not an interval.
+                    if latest.is_some() {
+                        match quote_usage(prices, model, tokens) {
+                            Some(usd) => cost += usd,
+                            None => priced = false,
+                        }
+                    }
+                    continue;
+                }
+                Receipt::Quota(window) => window,
+            };
+            let point = Point {
+                used_percent: window.used_percent.round() as u8,
+                cost,
+            };
+            if let Some(plateau) = plateaus.last_mut()
+                && plateau.last.used_percent == point.used_percent
+            {
+                plateau.last = point;
+            } else {
+                plateaus.push(Plateau {
+                    first: point,
+                    last: point,
+                });
+            }
+            let latest = latest.get_or_insert_with(|| ResponseQuotaEstimate {
+                scope: scope.clone(),
+                resets_at: window.resets_at,
+                remaining_percent: 100 - point.used_percent,
+                last_sequence: *sequence,
+                observations: 0,
+                intervals: 0,
+                value: None,
+            });
+            latest.observations += 1;
+            latest.remaining_percent = 100 - point.used_percent;
+            latest.last_sequence = *sequence;
+        }
+        let mut latest = latest?;
+        // Only the endpoints extend a flat percentage's observed cost range.
+        // The single continuous interval contains at most 202 such points.
+        let points: Vec<_> = plateaus
+            .into_iter()
+            .flat_map(|plateau| {
+                std::iter::once(plateau.first)
+                    .chain((plateau.last.cost != plateau.first.cost).then_some(plateau.last))
+            })
+            .collect();
+        if priced {
+            (latest.value, latest.intervals) = estimate_points(&points);
+        }
+        Some(latest)
+    }
+}
+
+fn starts_interval(previous: &RateLimitWindow, current: &RateLimitWindow) -> bool {
+    // Upstream can round the same reset time to adjacent whole seconds.
+    let reset_changed = match (previous.resets_at, current.resets_at) {
+        (Some(previous), Some(current)) => previous.abs_diff(current) > 1,
+        (previous, current) => previous != current,
+    };
+    reset_changed || current.used_percent.round() < previous.used_percent.round()
+}
+
+fn quote_usage(prices: Option<&Prices>, model: &str, tokens: &ResponseTokenCounts) -> Option<f64> {
+    let price = prices?.get(model).filter(|price| !price.is_zero())?;
+    Some(
+        price
+            .quote(
+                tokens.input?,
+                tokens.cache_read?,
+                tokens.cache_write?,
+                tokens.output?,
+            )
+            .usd,
+    )
+}
+
+fn estimate_points(points: &[Point]) -> (Option<ResponseQuotaEstimateRange>, usize) {
+    let mut spans: BTreeMap<u8, Vec<ResponseQuotaEstimateRange>> = BTreeMap::new();
+    let mut intervals = 0;
+    for (index, start) in points.iter().enumerate() {
+        for end in &points[index + 1..] {
+            let span = end.used_percent - start.used_percent;
+            if span == 0 {
+                continue;
+            }
+            let cost = (end.cost - start.cost) * 100.0;
+            let percent = f64::from(span);
+            spans
+                .entry(span)
+                .or_default()
+                .push(ResponseQuotaEstimateRange {
+                    center: cost / percent,
+                    low: cost / (percent + PERCENT_UNCERTAINTY),
+                    high: cost / (percent - PERCENT_UNCERTAINTY),
+                });
+            intervals += 1;
+        }
+    }
+    if spans.is_empty() {
+        return (None, intervals);
+    }
+    // Overlapping samples are not independent: give each distinct percentage
+    // span one median so repeated receipts cannot manufacture precision.
+    let mut centers = Vec::new();
+    let mut lows = Vec::new();
+    let mut highs = Vec::new();
+    for samples in spans.values() {
+        centers.push(quantile(
+            samples.iter().map(|sample| sample.center).collect(),
+            0.5,
+        ));
+        lows.push(quantile(
+            samples.iter().map(|sample| sample.low).collect(),
+            0.5,
+        ));
+        highs.push(quantile(
+            samples.iter().map(|sample| sample.high).collect(),
+            0.5,
+        ));
+    }
+    let center = quantile(centers.clone(), 0.5);
+    let low = quantile(lows, 0.5).min(quantile(centers.clone(), 0.25));
+    let high = quantile(highs, 0.5).max(quantile(centers, 0.75));
+    let value = (center > 0.0 && high.is_finite()).then_some(ResponseQuotaEstimateRange {
+        center,
+        low,
+        high,
+    });
+    (value, intervals)
+}
+
+fn quantile(mut values: Vec<f64>, fraction: f64) -> f64 {
+    values.sort_by(f64::total_cmp);
+    let position = (values.len() - 1) as f64 * fraction;
+    let lower = position.floor() as usize;
+    let upper = position.ceil() as usize;
+    values[lower] + (values[upper] - values[lower]) * position.fract()
+}
+
+#[cfg(test)]
+#[path = "quota_tests.rs"]
+mod tests;
