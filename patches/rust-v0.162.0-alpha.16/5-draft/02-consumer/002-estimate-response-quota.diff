+    /// Stream complete accounting once at startup, independently of browser pages.
+    pub async fn restore_accounting(
+        &self,
+        mut consume: impl FnMut(ResponseAccounting),
+    ) -> anyhow::Result<()> {
+        let mut rows = sqlx::query(
+            "SELECT responses.id, provider, account_id, \
+                COALESCE(served_model, requested_model) AS model, \
+                input_tokens, cache_read_tokens, cache_write_tokens, output_tokens, reasoning_tokens, \
+                usage_sequence, quota.sequence AS quota_sequence, \
+                quota.limit_id, quota.used_percent, quota.resets_at \
+             FROM responses LEFT JOIN response_quota_observations AS quota \
+                ON quota.attempt_id = responses.id \
+             WHERE usage_sequence IS NOT NULL OR quota.sequence IS NOT NULL \
+             ORDER BY responses.id, quota.sequence",
+        )
+        .fetch(&self.pool);
+        let mut pending: Option<(Uuid, ResponseAccounting)> = None;
+        while let Some(row) = std::future::poll_fn(|cx| rows.as_mut().poll_next(cx)).await {
+            let row = row?;
+            let id = Uuid::parse_str(row.try_get("id")?)?;
+            if pending.as_ref().is_none_or(|(previous, _)| *previous != id) {
+                if let Some((_, previous)) = pending.take() {
+                    consume(previous);
+                }
+                pending = Some((
+                    id,
+                    ResponseAccounting {
+                        provider: row.try_get("provider")?,
+                        account_id: row.try_get("account_id")?,
+                        model: row.try_get("model")?,
+                        tokens: read_tokens(&row)?,
+                        usage_observed_sequence: row
+                            .try_get::<Option<&str>, _>("usage_sequence")?
+                            .map(Uuid::parse_str)
+                            .transpose()?,
+                        rate_limits: Vec::new(),
+                    },
+                ));
+            }
+            if let Some(quota) = read_quota(&row)? {
+                pending
+                    .as_mut()
+                    .expect("accounting for quota")
+                    .1
+                    .rate_limits
+                    .push(quota);
+            }
+        }
+        if let Some((_, previous)) = pending {
+            consume(previous);
+        }
+        Ok(())
+    }
 }
 
