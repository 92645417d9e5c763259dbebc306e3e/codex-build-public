+use super::*;
+use pretty_assertions::assert_eq;
+use serde_json::json;
+
+fn scope() -> ResponseQuotaScope {
+    ResponseQuotaScope {
+        provider: "OpenAI".into(),
+        account_id: Some("account".into()),
+        limit_id: "codex".into(),
+    }
+}
+
+fn window(used: f64, reset: i64) -> RateLimitWindow {
+    RateLimitWindow {
+        used_percent: used,
+        window_minutes: Some(WEEK_MINUTES),
+        resets_at: Some(reset),
+    }
+}
+
+fn usage(output: u64) -> Receipt {
+    Receipt::Usage {
+        model: "model".into(),
+        tokens: ResponseTokenCounts {
+            input: Some(0),
+            cache_read: Some(0),
+            cache_write: Some(0),
+            output: Some(output),
+            reasoning: None,
+        },
+    }
+}
+
+fn prices() -> Prices {
+    serde_json::from_value(json!({"model": {"0": {
+        "input": 2, "cache_read": 1, "cache_write": 3, "output": 1
+    }}}))
+    .unwrap()
+}
+
+fn estimate(events: Vec<(u128, Receipt)>) -> ResponseQuotaEstimate {
+    let mut history = ReceiptWindow {
+        since: None,
+        events: events
+            .into_iter()
+            .map(|(sequence, receipt)| (Uuid::from_u128(sequence), receipt))
+            .collect(),
+    };
+    history.prune();
+    history.estimate(&scope(), Some(&prices())).unwrap()
+}
+
+#[test]
+fn longer_direct_spans_reduce_rounding_spread_without_exact_endpoints() {
+    for start in [0, 90] {
+        let short = [
+            Point {
+                used_percent: start,
+                cost: 0.0,
+            },
+            Point {
+                used_percent: start + 1,
+                cost: 1.0,
+            },
+        ];
+        let short = estimate_points(&short).0.unwrap();
+        let points: Vec<_> = (0..=10)
+            .map(|step| Point {
+                used_percent: start + step,
+                cost: f64::from(step),
+            })
+            .collect();
+        let (long, count) = estimate_points(&points);
+        let long = long.unwrap();
+        assert_eq!(long.center, 100.0);
+        assert_eq!(count, 55);
+        assert!(long.low < long.center && long.high > long.center);
+        assert!(long.high - long.low < short.high - short.low);
+    }
+}
+
+#[test]
+fn flat_steps_keep_both_endpoints_and_repeated_receipts_do_not_add_precision() {
+    let result = estimate(vec![
+        (1, Receipt::Quota(window(0.0, 100))),
+        (2, usage(600_000)),
+        (3, Receipt::Quota(window(0.0, 100))),
+        (4, usage(700_000)),
+        (5, Receipt::Quota(window(1.0, 100))),
+        (6, usage(900_000)),
+        (7, Receipt::Quota(window(2.0, 100))),
+    ]);
+    assert_eq!(result.observations, 4);
+    assert_eq!(result.intervals, 5);
+    let value = result.value.unwrap();
+    assert!(value.low < value.center && value.high > value.center);
+    assert!(value.low < 100.0 && value.high > 100.0);
+    let repeated = estimate(vec![
+        (1, Receipt::Quota(window(10.0, 100))),
+        (2, usage(1_000_000)),
+        (3, Receipt::Quota(window(20.0, 100))),
+        (4, Receipt::Quota(window(20.0, 100))),
+    ]);
+    assert_eq!(repeated.intervals, 1);
+    assert_eq!(repeated.value.unwrap().center, 10.0);
+}
+
+#[test]
+fn resets_and_remaining_increases_keep_only_the_latest_continuous_interval() {
+    for reset in [100, 200] {
+        let result = estimate(vec![
+            (1, Receipt::Quota(window(50.0, 100))),
+            (2, usage(100_000_000)),
+            (3, Receipt::Quota(window(60.0, 100))),
+            (4, Receipt::Quota(window(5.0, reset))),
+            (5, usage(2_000_000)),
+            (6, Receipt::Quota(window(15.0, reset))),
+        ]);
+        assert_eq!(result.observations, 2);
+        assert_eq!(result.intervals, 1);
+        assert_eq!(result.value.unwrap().center, 20.0);
+    }
+    let next_week = estimate(vec![
+        (1, Receipt::Quota(window(39.0, 10_000))),
+        (2, usage(1_000_000)),
+        (3, Receipt::Quota(window(40.0, 10_001))),
+        (4, Receipt::Quota(window(40.0, 10_000 + WEEK_MINUTES * 60))),
+    ]);
+    assert_eq!(next_week.observations, 1);
+    assert_eq!(next_week.remaining_percent, 60);
+    assert_eq!(next_week.value, None);
+}
+
+#[test]
+fn adjacent_reset_seconds_preserve_priced_one_percent_changes() {
+    let result = estimate(vec![
+        (1, Receipt::Quota(window(38.0, 10_000))),
+        (2, usage(500_000)),
+        (3, Receipt::Quota(window(38.0, 10_001))),
+        (4, usage(500_000)),
+        (5, Receipt::Quota(window(39.0, 10_000))),
+        (6, usage(1_000_000)),
+        (7, Receipt::Quota(window(39.0, 10_001))),
+    ]);
+    assert_eq!(result.observations, 4);
+    assert_eq!(result.remaining_percent, 61);
+    assert_eq!(result.intervals, 4);
+    assert_eq!(result.value.unwrap().center, 125.0);
+}
+
+#[test]
+fn inconsistent_consumption_is_descriptive_and_missing_consumption_is_not_invented() {
+    let points = [(10, 0.0), (11, 1.0), (20, 1.1), (25, 6.1), (30, 11.1)]
+        .map(|(used_percent, cost)| Point { used_percent, cost });
+    let (estimate, count) = estimate_points(&points);
+    assert_eq!(count, 10);
+    let estimate = estimate.unwrap();
+    assert!(estimate.low < estimate.center && estimate.high > estimate.center);
+    assert!(estimate.center < 100.0);
+    let empty = [
+        Point {
+            used_percent: 20,
+            cost: 0.0,
+        },
+        Point {
+            used_percent: 30,
+            cost: 0.0,
+        },
+    ];
+    assert_eq!(estimate_points(&empty).0, None);
+}
+
+#[test]
+fn flat_percentages_and_unpriced_usage_cannot_establish_a_value() {
+    let flat = estimate(vec![
+        (1, Receipt::Quota(window(100.0, 100))),
+        (2, usage(2_000_000)),
+        (3, Receipt::Quota(window(100.0, 100))),
+    ]);
+    assert_eq!(flat.remaining_percent, 0);
+    assert_eq!(flat.value, None);
+    let unknown = estimate(vec![
+        (1, Receipt::Quota(window(10.0, 100))),
+        (2, usage(1_000_000)),
+        (
+            3,
+            Receipt::Usage {
+                model: "unknown".into(),
+                tokens: ResponseTokenCounts::default(),
+            },
+        ),
+        (4, Receipt::Quota(window(20.0, 100))),
+    ]);
+    assert_eq!(unknown.remaining_percent, 80);
+    assert_eq!(unknown.value, None);
+    let tokens = ResponseTokenCounts {
+        input: Some(100),
+        cache_read: Some(20),
+        cache_write: Some(10),
+        output: Some(50),
+        reasoning: Some(40),
+    };
+    assert!((quote_usage(Some(&prices()), "model", &tokens).unwrap() - 0.00024).abs() < 1e-12);
+    assert_eq!(quote_usage(Some(&prices()), "absent", &tokens), None);
+    assert_eq!(
+        quote_usage(Some(&prices()), "model", &ResponseTokenCounts::default()),
+        None
+    );
+    let zero: Prices = serde_json::from_value(json!({"model": {"0": {
+        "input": 0, "cache_read": 0, "cache_write": 0, "output": 0
+    }}}))
+    .unwrap();
+    assert_eq!(quote_usage(Some(&zero), "model", &tokens), None);
+}
+
+fn accounting(
+    sequence: u128,
+    used: f64,
+    reset: i64,
+    account: &str,
+    limit: &str,
+) -> ResponseAccounting {
+    ResponseAccounting {
+        provider: "OpenAI".into(),
+        account_id: Some(account.into()),
+        model: "model".into(),
+        tokens: ResponseTokenCounts::default(),
+        usage_observed_sequence: None,
+        rate_limits: vec![codex_protocol::response_metrics::ResponseQuotaObservation {
+            sequence: Uuid::from_u128(sequence),
+            limit_id: limit.into(),
+            used_percent: Some(used),
+            resets_at: Some(reset),
+        }],
+    }
+}
+
+#[test]
+fn startup_merge_keeps_the_live_reset_cutoff_and_scopes_are_independent() {
+    let mut current = QuotaEstimator::default();
+    current.observe(&accounting(3, 70.0, 100, "account", "codex"));
+    current.observe(&accounting(4, 5.0, 200, "account", "codex"));
+    let expected = current.estimates(None);
+    let mut old = QuotaEstimator::default();
+    old.observe(&accounting(1, 50.0, 100, "account", "codex"));
+    old.observe(&accounting(2, 60.0, 100, "account", "codex"));
+    current.merge(old);
+    assert_eq!(current.estimates(None), expected);
+    // The same receipt arriving again must not create an additional observation.
+    current.observe(&accounting(4, 5.0, 200, "account", "codex"));
+    assert_eq!(current.estimates(None), expected);
+    current.observe(&accounting(5, 80.0, 100, "other", "codex"));
+    current.observe(&accounting(6, 90.0, 100, "account", "separate"));
+    let estimates = current.estimates(None);
+    assert_eq!(estimates.len(), 3);
+    assert_eq!(estimates[0], expected[0]);
+    assert_eq!(estimates[1].remaining_percent, 10);
+    assert_eq!(estimates[2].remaining_percent, 20);
+}
