+#[tokio::test]
+async fn response_status_preview_matches_live_values_colors_and_absence() {
+    use crate::response_timing::tests::attempt;
+    use codex_protocol::response_metrics::ResponseAttemptEnd;
+
+    let (mut chat, _rx, _ops) = make_chatwidget_manual(None).await;
+    chat.local_settings.tui.fullscreen_transcript = true;
+    let items = [
+        StatusLineItem::ResponsePerformance,
+        StatusLineItem::ResponseReceive,
+    ];
+    assert!(
+        chat.status_surface_preview_data()
+            .status_line_for_items(items, true)
+            .is_none()
+    );
+    let mut failed = attempt(2, Some(ResponseAttemptEnd::ProgressTimeout));
+    failed.revision += 1;
+    failed.ttfb_ms = None;
+    failed.tps = None;
+    for (row, expected) in [
+        (
+            attempt(1, Some(ResponseAttemptEnd::Completed)),
+            "Last TTFB 0.30s TPS 50.0",
+        ),
+        (attempt(2, None), "Last TTFB 0.30s TPS 50.0"),
+        (failed, "Last TTFB -- TPS --"),
+    ] {
+        let receiving = row.end_reason.is_none();
+        chat.response_timing.update(row, true, Instant::now());
+        assert_eq!(
+            chat.status_line_value_for_item(items[0]).as_deref(),
+            Some(expected)
+        );
+        assert_eq!(
+            chat.status_line_value_for_item(items[1]).as_deref(),
+            receiving.then_some("Received 0.5KiB")
+        );
+        for colors in [false, true] {
+            let preview = chat
+                .status_surface_preview_data()
+                .status_line_for_items(items, colors);
+            let thread_id = chat.thread_id;
+            let live = crate::bottom_pane::status_line_from_segments(
+                items
+                    .into_iter()
+                    .filter_map(|item| chat.status_line_value(item).map(|value| (item, value))),
+                colors,
+                thread_id,
+                crate::bottom_pane::StatusLineDetails::default(),
+            );
+            assert_eq!(preview, live);
+        }
+    }
+    chat.local_settings.tui.fullscreen_transcript = false;
+    assert!(
+        chat.status_surface_preview_data()
+            .status_line_for_items(items, true)
+            .is_none()
+    );
+}
