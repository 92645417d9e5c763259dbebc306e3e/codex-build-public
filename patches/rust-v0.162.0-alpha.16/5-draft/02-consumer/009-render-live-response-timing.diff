+#[test]
+fn active_turn_includes_waits_and_ignores_local_phase_restarts() {
+    let start = Instant::now();
+    let mut timer = StatusTimer {
+        turn_started_at: Some(start),
+        last_resume_at: start,
+        ..StatusTimer::default()
+    };
+    timer.pause_at(start + Duration::from_secs(5));
+    timer.display_started_at = Some(start + Duration::from_secs(8));
+    let now = start + Duration::from_secs(12);
+    assert_eq!(timer.elapsed_at(now), Duration::from_secs(12));
+    assert_eq!(timer.display_elapsed_at(now), Duration::from_secs(12));
+    assert!(timer.has_wall_clock());
+    timer.set_turn_started_at(None);
+    assert_eq!(timer.elapsed_at(now), Duration::from_secs(5));
+    assert_eq!(timer.display_elapsed_at(now), Duration::from_secs(4));
+}
