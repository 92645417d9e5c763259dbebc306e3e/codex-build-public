+//! Retained response pages and live observations share one ordered row owner.
+
+use crate::keymap::ListAction;
+use crate::response_timing::ObservedResponse;
+use crate::resume_picker::LOAD_NEAR_THRESHOLD;
+use crate::resume_picker::content_rows;
+use crate::resume_picker::scroll_percent;
+use crate::resume_picker::scroll_top_for_selection;
+use codex_app_server_protocol::ResponseAttemptsReadParams;
+use codex_app_server_protocol::ResponseAttemptsReadResponse;
+use codex_models_manager::model_pricing::Prices;
+use codex_protocol::response_metrics::ResponseAttempt;
+use codex_protocol::response_metrics::ResponseQuotaEstimate;
+use std::collections::BTreeMap;
+use std::collections::BTreeSet;
+use std::time::Instant;
+use uuid::Uuid;
+
+pub(crate) struct ResponsePageRequest {
+    pub(crate) id: Uuid,
+    pub(crate) params: ResponseAttemptsReadParams,
+}
+
+struct PendingPage {
+    id: Uuid,
+    requested_at: Instant,
+    older: bool,
+    percent: u8,
+}
+
+pub(crate) struct ResponseHistory {
+    query: ResponseAttemptsReadParams,
+    records: BTreeMap<Uuid, ObservedResponse>,
+    pub(crate) models: BTreeSet<String>,
+    pub(crate) prices: Result<Prices, String>,
+    pub(crate) quota: Option<ResponseQuotaEstimate>,
+    pub(crate) error: Option<String>,
+    pub(crate) persistence_error: Option<String>,
+    pub(crate) pricing_error: Option<String>,
+    next_cursor: Option<String>,
+    loaded: bool,
+    pending: Option<PendingPage>,
+    pub(crate) selected: usize,
+    pub(crate) scroll_top: usize,
+    viewport_height: usize,
+    pending_page_down_target: Option<usize>,
+}
+
+impl ResponseHistory {
+    pub(crate) fn new() -> Self {
+        Self {
+            query: ResponseAttemptsReadParams::default(),
+            records: BTreeMap::new(),
+            models: BTreeSet::new(),
+            prices: Ok(Prices::new()),
+            quota: None,
+            error: None,
+            persistence_error: None,
+            pricing_error: None,
+            next_cursor: None,
+            loaded: false,
+            pending: None,
+            selected: 0,
+            scroll_top: 0,
+            viewport_height: 0,
+            pending_page_down_target: None,
+        }
+    }
+
+    pub(crate) fn model(&self) -> Option<&str> {
+        self.query.model.as_deref()
+    }
+
+    pub(crate) fn rows(&self) -> impl Iterator<Item = &ObservedResponse> {
+        self.records
+            .values()
+            .rev()
+            .filter(|row| self.matches(&row.row))
+    }
+
+    pub(crate) fn count(&self) -> usize {
+        self.rows().count()
+    }
+
+    pub(crate) fn is_loading(&self) -> bool {
+        self.pending.is_some()
+    }
+
+    pub(crate) fn accepts(&self, id: Uuid) -> bool {
+        self.pending.as_ref().is_some_and(|page| page.id == id)
+    }
+
+    pub(crate) fn refresh(&mut self, now: Instant) -> Option<ResponsePageRequest> {
+        self.request(None, now)
+    }
+
+    fn request(&mut self, cursor: Option<String>, now: Instant) -> Option<ResponsePageRequest> {
+        if self.pending.is_some() {
+            return None;
+        }
+        let id = Uuid::new_v4();
+        self.pending = Some(PendingPage {
+            id,
+            requested_at: now,
+            older: cursor.is_some(),
+            percent: if self.count() == 0 { 0 } else { self.percent() },
+        });
+        let mut params = self.query.clone();
+        params.cursor = cursor;
+        self.error = None;
+        Some(ResponsePageRequest { id, params })
+    }
+
+    pub(crate) fn finish(
+        &mut self,
+        id: Uuid,
+        response: Result<ResponseAttemptsReadResponse, String>,
+        prices: Result<Prices, String>,
+        now: Instant,
+    ) -> Option<ResponsePageRequest> {
+        if !self.accepts(id) {
+            return None;
+        }
+        let pending = self.pending.take().expect("matching response page");
+        self.prices = prices;
+        let page = match response {
+            Ok(page) => page,
+            Err(error) => {
+                self.error = Some(error);
+                self.pending_page_down_target = None;
+                return None;
+            }
+        };
+        let anchors = self.anchors();
+        for row in page.data {
+            if self.records.get(&row.attempt_id).is_some_and(|current| {
+                current.snapshot_is_stale(row.revision, pending.requested_at)
+            }) {
+                continue;
+            }
+            let active = page.active_attempt_ids.contains(&row.attempt_id);
+            self.store(ObservedResponse::new(row, active, now));
+        }
+        self.models.extend(page.models);
+        self.update_quota(page.quota);
+        // Refreshing recent observations cannot rewind a cursor already advanced
+        // through older history. The server alone interprets cursor contents.
+        if !self.loaded || pending.older {
+            self.next_cursor = page.next_cursor;
+        }
+        self.loaded = true;
+        self.persistence_error = page.persistence_error;
+        self.pricing_error = page.pricing_error;
+        self.restore_selection(anchors);
+        if let Some(target) = self.pending_page_down_target {
+            if target >= self.count() && self.next_cursor.is_some() {
+                return self.load_more(now);
+            }
+            self.pending_page_down_target = None;
+            self.selected = target.min(self.count().saturating_sub(1));
+            self.ensure_visible();
+        }
+        self.fill_viewport(now)
+    }
+
+    pub(crate) fn update(
+        &mut self,
+        row: ResponseAttempt,
+        quota: Option<Vec<ResponseQuotaEstimate>>,
+        now: Instant,
+    ) {
+        let anchors = self.anchors();
+        self.store(ObservedResponse::new(row, true, now));
+        if let Some(quota) = quota {
+            self.update_quota(quota);
+        }
+        self.restore_selection(anchors);
+    }
+
+    fn store(&mut self, incoming: ObservedResponse) {
+        let row = &incoming.row;
+        if self
+            .records
+            .get(&row.attempt_id)
+            .is_some_and(|current| current.row.revision > row.revision)
+        {
+            return;
+        }
+        self.models.insert(row.requested_model.clone());
+        if let Some(current) = self.records.get_mut(&row.attempt_id) {
+            // Keep an observed record when its requested model changes out of the
+            // filter. Its revision still rejects late pages of the old model.
+            current.update(incoming);
+        } else if self.matches(row) {
+            self.records.insert(row.attempt_id, incoming);
+        }
+    }
+
+    fn matches(&self, row: &ResponseAttempt) -> bool {
+        self.model()
+            .is_none_or(|model| model == row.requested_model)
+    }
+
+    fn update_quota(&mut self, incoming: Vec<ResponseQuotaEstimate>) {
+        if let Some(latest) = incoming.into_iter().max_by_key(|quota| quota.last_sequence)
+            && self
+                .quota
+                .as_ref()
+                .is_none_or(|current| current.last_sequence <= latest.last_sequence)
+        {
+            self.quota = Some(latest);
+        }
+    }
+
+    pub(crate) fn cycle_model(
+        &mut self,
+        forward: bool,
+        now: Instant,
+    ) -> Option<ResponsePageRequest> {
+        let model = if forward {
+            self.models.iter().find(|model| {
+                self.query
+                    .model
+                    .as_ref()
+                    .is_none_or(|selected| *model > selected)
+            })
+        } else {
+            self.models.iter().rev().find(|model| {
+                self.query
+                    .model
+                    .as_ref()
+                    .is_none_or(|selected| *model < selected)
+            })
+        }
+        .cloned();
+        if model == self.query.model {
+            return None;
+        }
+        self.query.model = model;
+        self.reset_filter(now)
+    }
+
+    fn reset_filter(&mut self, now: Instant) -> Option<ResponsePageRequest> {
+        self.records.clear();
+        self.loaded = false;
+        self.next_cursor = None;
+        self.pending = None;
+        self.selected = 0;
+        self.scroll_top = 0;
+        self.pending_page_down_target = None;
+        self.request(None, now)
+    }
+
+    fn anchors(&self) -> (Option<Uuid>, Option<Uuid>) {
+        (
+            self.rows().nth(self.selected).map(|row| row.row.attempt_id),
+            self.rows()
+                .nth(self.scroll_top)
+                .map(|row| row.row.attempt_id),
+        )
+    }
+
+    fn restore_selection(&mut self, (selected, top): (Option<Uuid>, Option<Uuid>)) {
+        // The newest row follows live arrivals. A pending page-down already
+        // means the user is reading older history, even before it has arrived.
+        if self.selected == 0 && self.scroll_top == 0 && self.pending_page_down_target.is_none() {
+            return;
+        }
+        let previous = self.selected;
+        if let Some(index) =
+            selected.and_then(|id| self.rows().position(|row| row.row.attempt_id == id))
+        {
+            self.selected = index;
+        }
+        if let Some(index) = top.and_then(|id| self.rows().position(|row| row.row.attempt_id == id))
+        {
+            self.scroll_top = index;
+        }
+        self.selected = self.selected.min(self.count().saturating_sub(1));
+        if let Some(target) = &mut self.pending_page_down_target {
+            *target = target
+                .saturating_add(self.selected)
+                .saturating_sub(previous);
+        }
+        self.ensure_visible();
+    }
+
+    fn ensure_visible(&mut self) {
+        self.scroll_top = scroll_top_for_selection(
+            self.selected,
+            self.scroll_top,
+            self.count(),
+            self.viewport_height,
+            self.next_cursor.is_some(),
+            |start, end| end - start + 1,
+        );
+    }
+
+    pub(crate) fn visible_rows(&self) -> usize {
+        content_rows(
+            self.viewport_height,
+            self.scroll_top > 0,
+            self.next_cursor.is_some() || self.selected + 1 < self.count(),
+        )
+    }
+
+    pub(crate) fn more_below(&self) -> bool {
+        self.next_cursor.is_some()
+            || self.count().saturating_sub(self.scroll_top) > self.visible_rows()
+    }
+
+    pub(crate) fn percent(&self) -> u8 {
+        self.pending.as_ref().map_or_else(
+            || {
+                scroll_percent(
+                    self.count(),
+                    self.count().saturating_sub(self.scroll_top),
+                    self.scroll_top,
+                    self.visible_rows(),
+                )
+            },
+            |page| page.percent,
+        )
+    }
+
+    pub(crate) fn update_viewport(
+        &mut self,
+        height: usize,
+        now: Instant,
+    ) -> Option<ResponsePageRequest> {
+        self.viewport_height = height;
+        self.ensure_visible();
+        self.fill_viewport(now)
+    }
+
+    fn fill_viewport(&mut self, now: Instant) -> Option<ResponsePageRequest> {
+        if self.error.is_none() && self.count() < self.visible_rows() {
+            self.load_more(now)
+        } else {
+            None
+        }
+    }
+
+    fn load_more(&mut self, now: Instant) -> Option<ResponsePageRequest> {
+        self.request(Some(self.next_cursor.clone()?), now)
+    }
+
+    pub(crate) fn cancel_page_down(&mut self) {
+        self.pending_page_down_target = None;
+    }
+
+    pub(crate) fn navigate(
+        &mut self,
+        action: ListAction,
+        now: Instant,
+    ) -> Option<ResponsePageRequest> {
+        if action != ListAction::PageDown {
+            self.cancel_page_down();
+        }
+        let count = self.count();
+        match action {
+            ListAction::MoveUp => self.selected = self.selected.saturating_sub(1),
+            ListAction::MoveDown => {
+                self.selected = (self.selected + 1).min(count.saturating_sub(1))
+            }
+            ListAction::PageUp => {
+                self.selected = self.selected.saturating_sub(self.viewport_height.max(1))
+            }
+            ListAction::PageDown => {
+                let target = self.selected.saturating_add(self.viewport_height.max(1));
+                if target >= count && self.next_cursor.is_some() {
+                    self.pending_page_down_target = Some(target);
+                    return self.load_more(now);
+                }
+                self.selected = target.min(count.saturating_sub(1));
+            }
+            ListAction::JumpTop => self.selected = 0,
+            ListAction::JumpBottom => self.selected = count.saturating_sub(1),
+            _ => return None,
+        }
+        self.ensure_visible();
+        if matches!(
+            action,
+            ListAction::MoveDown | ListAction::PageDown | ListAction::JumpBottom
+        ) && count.saturating_sub(self.selected + 1) <= LOAD_NEAR_THRESHOLD
+        {
+            self.load_more(now)
+        } else {
+            None
+        }
+    }
+}
+
+#[cfg(test)]
+#[path = "response_history_tests.rs"]
+mod tests;
