+#[test]
+fn empty_filtered_pages_continue_and_quota_and_storage_errors_remain_independent() {
+    let now = Instant::now();
+    let mut history = ResponseHistory::new();
+    assert!(history.update_viewport(20, now).is_none());
+    let first = history.refresh(now).unwrap();
+    let mut response = page(Vec::new());
+    response.next_cursor = Some("history-after-empty-memory".into());
+    response.persistence_error = Some("storage unavailable".into());
+    response.pricing_error = Some("pricing unavailable".into());
+    let quota = ResponseQuotaEstimate {
+        scope: ResponseQuotaScope {
+            provider: "openai".into(),
+            account_id: None,
+            limit_id: "codex".into(),
+        },
+        resets_at: None,
+        remaining_percent: 42,
+        last_sequence: Uuid::from_u128(20),
+        observations: 2,
+        intervals: 1,
+        value: None,
+    };
+    response.quota.push(quota.clone());
+    let older = history
+        .finish(first.id, Ok(response), Ok(Prices::new()), now)
+        .unwrap();
+    assert_eq!(
+        older.params.cursor.as_deref(),
+        Some("history-after-empty-memory")
+    );
+    assert_eq!(
+        history.persistence_error.as_deref(),
+        Some("storage unavailable")
+    );
+    assert_eq!(
+        history.pricing_error.as_deref(),
+        Some("pricing unavailable")
+    );
+    assert_eq!(history.quota, Some(quota.clone()));
+    let mut other = attempt(2, None);
+    other.thread_id = ThreadId::new();
+    let mut stale_quota = quota.clone();
+    stale_quota.last_sequence = Uuid::from_u128(10);
+    history.update(other, Some(vec![stale_quota]), now);
+    assert_eq!(history.count(), 1);
+    assert_eq!(history.quota, Some(quota));
+    finish(&mut history, older, completed(1, 1), now);
+    assert_eq!(history.count(), 2);
+    assert_eq!(history.percent(), 100);
+}
