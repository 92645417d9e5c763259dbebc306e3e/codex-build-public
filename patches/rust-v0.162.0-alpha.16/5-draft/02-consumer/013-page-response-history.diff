+#[test]
+fn failed_older_page_waits_for_navigation_instead_of_retrying_on_each_frame() {
+    let now = Instant::now();
+    let mut history = ResponseHistory::new();
+    let first = history.refresh(now).unwrap();
+    let mut response = page(completed(9, 10));
+    response.next_cursor = Some("older".into());
+    history.finish(first.id, Ok(response), Ok(Prices::new()), now);
+    let older = history.update_viewport(20, now).unwrap();
+    assert!(
+        history
+            .finish(older.id, Err("read failed".into()), Ok(Prices::new()), now)
+            .is_none()
+    );
+    assert!(history.update_viewport(20, now).is_none());
+    assert!(history.update_viewport(40, now).is_none());
+    assert_eq!(history.count(), 2);
+    let retry = history.navigate(ListAction::MoveDown, now).unwrap();
+    assert_eq!(retry.params.cursor.as_deref(), Some("older"));
+    assert!(history.error.is_none());
+}
