+use super::*;
+use crate::response_timing::tests::attempt;
+use crate::response_timing::tests::page;
+use codex_protocol::ThreadId;
+use codex_protocol::response_metrics::ResponseAttemptEnd;
+use codex_protocol::response_metrics::ResponseQuotaScope;
+use pretty_assertions::assert_eq;
+use std::time::Duration;
+
+fn completed(first: u64, last: u64) -> Vec<ResponseAttempt> {
+    (first..=last)
+        .map(|id| attempt(id, Some(ResponseAttemptEnd::Completed)))
+        .collect()
+}
+
+fn finish(
+    history: &mut ResponseHistory,
+    request: ResponsePageRequest,
+    rows: Vec<ResponseAttempt>,
+    now: Instant,
+) {
+    assert!(
+        history
+            .finish(request.id, Ok(page(rows)), Ok(Prices::new()), now)
+            .is_none()
+    );
+}
+
+#[test]
+fn model_filter_keeps_all_sessions_and_ignores_superseded_requests() {
+    let now = Instant::now();
+    let mut rows = completed(1, 4);
+    let other = ThreadId::new();
+    for (index, row) in rows.iter_mut().enumerate() {
+        row.requested_model = if index % 2 == 0 { "model-a" } else { "model-b" }.into();
+        row.served_model = Some("served".into());
+        if index >= 2 {
+            row.thread_id = other;
+        }
+    }
+    let mut history = ResponseHistory::new();
+    let initial = history.refresh(now).unwrap();
+    assert_eq!(initial.params.thread_id, None);
+    let stale_id = initial.id;
+    finish(&mut history, initial, rows.clone(), now);
+    assert_eq!(history.count(), 4);
+    let model = history.cycle_model(true, now).unwrap();
+    assert_eq!(model.params.model.as_deref(), Some("model-a"));
+    assert_eq!(model.params.thread_id, None);
+    assert!(
+        history
+            .finish(
+                stale_id,
+                Err("stale failure".into()),
+                Err("stale prices".into()),
+                now
+            )
+            .is_none()
+    );
+    assert!(history.accepts(model.id));
+    assert!(history.error.is_none());
+    assert!(history.prices.is_ok());
+    finish(&mut history, model, rows.clone(), now);
+    assert_eq!(history.count(), 2);
+    let all_models = history.cycle_model(false, now).unwrap();
+    assert_eq!(all_models.params.model, None);
+    finish(&mut history, all_models, rows, now);
+    assert_eq!(history.count(), 4);
+}
+
+#[test]
+fn paging_and_refresh_preserve_history_selection_revisions_and_error_visibility() {
+    let now = Instant::now();
+    let mut history = ResponseHistory::new();
+    let first = history.refresh(now).unwrap();
+    history.update(attempt(21, None), None, now);
+    let mut response = page(completed(11, 20));
+    response.next_cursor = Some("older-boundary".into());
+    assert!(
+        history
+            .finish(first.id, Ok(response), Ok(Prices::new()), now)
+            .is_none()
+    );
+    history.update_viewport(5, now);
+    let older = history.navigate(ListAction::JumpBottom, now).unwrap();
+    let selected = history.anchors();
+    let percent = history.percent();
+    assert_eq!(older.params.cursor.as_deref(), Some("older-boundary"));
+    let mut ended = attempt(21, Some(ResponseAttemptEnd::Completed));
+    ended.revision += 1;
+    history.update(ended.clone(), None, now);
+    history.update(attempt(21, None), None, now);
+    assert_eq!(history.records[&ended.attempt_id].row, ended);
+    assert_eq!(history.anchors(), selected);
+    assert_eq!(history.percent(), percent);
+    finish(&mut history, older, completed(1, 10), now);
+    assert_eq!(history.count(), 21);
+    assert_eq!(history.anchors(), selected);
+    let refresh = history.refresh(now).unwrap();
+    let mut response = page(vec![attempt(22, None), attempt(21, None)]);
+    response.next_cursor = Some("recent-boundary".into());
+    history.finish(refresh.id, Ok(response), Ok(Prices::new()), now);
+    assert_eq!(history.next_cursor, None);
+    assert_eq!(history.count(), 22);
+    assert_eq!(history.anchors(), selected);
+    assert_eq!(history.records[&ended.attempt_id].row, ended);
+    let failed = history.refresh(now).unwrap();
+    assert!(
+        history
+            .finish(
+                failed.id,
+                Err("backup read failed".into()),
+                Err("bad prices".into()),
+                now
+            )
+            .is_none()
+    );
+    assert_eq!(history.count(), 22);
+    assert_eq!(history.anchors(), selected);
+    assert_eq!(history.error.as_deref(), Some("backup read failed"));
+    assert_eq!(history.prices.as_ref().unwrap_err(), "bad prices");
+    assert!(!history.is_loading());
+    assert!(
+        history.update_viewport(100, now).is_none(),
+        "rendering must not retry a failed read"
+    );
+}
+
+#[test]
+fn page_down_waits_across_batches_and_tracks_selection_when_new_rows_arrive() {
+    let now = Instant::now();
+    let mut history = ResponseHistory::new();
+    let first = history.refresh(now).unwrap();
+    let mut response = page(completed(9, 10));
+    response.next_cursor = Some("older".into());
+    history.finish(first.id, Ok(response), Ok(Prices::new()), now);
+    let older = history.update_viewport(5, now).unwrap();
+    assert!(
+        history.navigate(ListAction::PageDown, now).is_none(),
+        "one in-flight request"
+    );
+    assert_eq!(history.pending_page_down_target, Some(5));
+    history.update(attempt(11, None), None, now);
+    assert_eq!(history.pending_page_down_target, Some(6));
+    assert_eq!(history.anchors().0, Some(Uuid::from_u128(10)));
+    let mut response = page(completed(7, 8));
+    response.next_cursor = Some("oldest".into());
+    let oldest = history
+        .finish(older.id, Ok(response), Ok(Prices::new()), now)
+        .unwrap();
+    assert_eq!(oldest.params.cursor.as_deref(), Some("oldest"));
+    finish(&mut history, oldest, completed(1, 6), now);
+    assert_eq!(history.selected, 6);
+    assert_eq!(history.anchors().0, Some(Uuid::from_u128(5)));
+    assert!(history.pending_page_down_target.is_none());
+    assert!(history.selected >= history.scroll_top);
+    assert!(history.selected < history.scroll_top + history.visible_rows());
+}
+
+#[test]
+fn stale_pages_cannot_reanimate_restored_rows_or_replace_live_clocks_and_models() {
+    let now = Instant::now();
+    let later = now + Duration::from_secs(5);
+    let mut history = ResponseHistory::new();
+    let first = history.refresh(now).unwrap();
+    let mut response = page(vec![attempt(1, None)]);
+    response.active_attempt_ids.clear();
+    history.finish(first.id, Ok(response.clone()), Ok(Prices::new()), now);
+    assert_eq!(history.rows().next().unwrap().elapsed_ms(later), 2100);
+    let refresh = history.refresh(now).unwrap();
+    history.update(attempt(1, None), None, later);
+    history.finish(refresh.id, Ok(response), Ok(Prices::new()), later);
+    assert!(history.rows().next().unwrap().is_running());
+    assert_eq!(
+        history
+            .rows()
+            .next()
+            .unwrap()
+            .elapsed_ms(later + Duration::from_secs(5)),
+        7100
+    );
+    let model = history.cycle_model(true, later).unwrap();
+    assert_eq!(model.params.model.as_deref(), Some("gpt-5.4"));
+    history.update(attempt(1, None), None, later);
+    let mut changed = attempt(1, None);
+    changed.served_model = Some("served-other".into());
+    changed.revision += 1;
+    history.update(changed.clone(), None, later);
+    assert_eq!(history.count(), 1);
+    finish(&mut history, model, vec![attempt(1, None)], later);
+    assert_eq!(history.count(), 1);
+    assert_eq!(
+        history.rows().next().unwrap().row.served_model.as_deref(),
+        Some("served-other")
+    );
+    assert!(!history.models.contains("served-other"));
+    changed.requested_model = "requested-other".into();
+    changed.revision += 1;
+    history.update(changed, None, later);
+    assert_eq!(history.count(), 0);
+    let refresh = history.refresh(later).unwrap();
+    finish(&mut history, refresh, vec![attempt(1, None)], later);
+    assert_eq!(
+        history.count(),
+        0,
+        "an older requested-model page cannot resurrect a filtered-out revision"
+    );
+    assert!(history.models.contains("requested-other"));
+}
+
+#[test]
+fn newest_follows_notifications_and_refresh_but_older_selection_stays_anchored() {
+    let now = Instant::now();
+    let mut history = ResponseHistory::new();
+    let initial = history.refresh(now).unwrap();
+    finish(&mut history, initial, completed(1, 10), now);
+    history.update_viewport(6, now);
+    history.update(attempt(11, None), None, now);
+    assert_eq!((history.selected, history.scroll_top), (0, 0));
+    assert_eq!(history.anchors().0, Some(Uuid::from_u128(11)));
+    let refresh = history.refresh(now).unwrap();
+    finish(&mut history, refresh, vec![attempt(12, None)], now);
+    assert_eq!((history.selected, history.scroll_top), (0, 0));
+    assert_eq!(history.anchors().0, Some(Uuid::from_u128(12)));
+    history.navigate(ListAction::MoveDown, now);
+    let anchors = history.anchors();
+    history.update(attempt(13, None), None, now);
+    assert_eq!(history.anchors(), anchors);
+    history.navigate(ListAction::JumpTop, now);
+    history.update(attempt(14, None), None, now);
+    assert_eq!((history.selected, history.scroll_top), (0, 0));
+    assert_eq!(history.anchors().0, Some(Uuid::from_u128(14)));
+}
