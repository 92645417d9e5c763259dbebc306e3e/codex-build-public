+pub(crate) async fn store_manual_pairing(path: &Path, code: &str, expires_at: i64) -> Result<()> {
+    if code.is_empty() {
+        clear_manual_pairing(path).await?;
+        anyhow::bail!("manual pairing code was empty");
+    }
+    if expires_at <= unix_now()? {
+        clear_manual_pairing(path).await?;
+        anyhow::bail!("manual pairing code already expired");
+    }
+    let mut settings: Map<String, Value> = read_settings(path).await?;
+    settings.insert(
+        MANUAL_PAIRING_SETTING.to_string(),
+        json!({"code": code, "expiresAt": expires_at}),
+    );
+    write_settings(path, &settings).await
+}
+
+pub(crate) async fn clear_manual_pairing(path: &Path) -> Result<()> {
+    let mut settings: Map<String, Value> = read_settings(path).await?;
+    if settings.remove(MANUAL_PAIRING_SETTING).is_some() {
+        write_settings(path, &settings).await?;
     }
+    Ok(())
+}
+
+pub(crate) async fn clear_expired_manual_pairing(path: &Path) -> Result<()> {
+    let mut settings: Map<String, Value> = read_settings(path).await?;
+    let Some(pairing) = settings.get(MANUAL_PAIRING_SETTING) else {
+        return Ok(());
+    };
+    let expires_at = pairing.get("expiresAt").and_then(Value::as_i64);
+    let code = pairing.get("code").and_then(Value::as_str);
+    let now = unix_now()?;
+    if code.is_none_or(str::is_empty) || expires_at.is_none_or(|expiry| expiry <= now) {
+        settings.remove(MANUAL_PAIRING_SETTING);
+        write_settings(path, &settings).await?;
+    }
+    Ok(())
+}
+
+async fn write_settings(path: &Path, settings: &Map<String, Value>) -> Result<()> {
+    let parent = path
+        .parent()
+        .context("daemon settings path has no parent")?;
+    fs::create_dir_all(parent).await.with_context(|| {
+        format!(
+            "failed to create daemon settings directory {}",
+            parent.display()
+        )
+    })?;
+    let temporary = tempfile::Builder::new()
+        .prefix(".settings-")
+        .tempfile_in(parent)
+        .with_context(|| format!("failed to stage daemon settings in {}", parent.display()))?;
+    temporary
+        .as_file()
+        .set_permissions(std::fs::Permissions::from_mode(0o600))
+        .context("failed to protect staged daemon settings")?;
+    let contents = serde_json::to_vec_pretty(settings).context("failed to serialize settings")?;
+    fs::write(temporary.path(), contents)
+        .await
+        .with_context(|| {
+            format!(
+                "failed to write staged daemon settings {}",
+                temporary.path().display()
+            )
+        })?;
+    temporary
+        .persist(path)
+        .with_context(|| format!("failed to replace daemon settings {}", path.display()))?;
+    Ok(())
+}
+
+fn unix_now() -> Result<i64> {
+    let duration = SystemTime::now()
+        .duration_since(UNIX_EPOCH)
+        .context("system clock precedes Unix epoch")?;
+    i64::try_from(duration.as_secs()).context("system clock exceeds pairing expiry range")
 }
 
