+#[tokio::test]
+async fn manual_pairing_replaces_only_its_settings_and_protects_the_file() -> anyhow::Result<()> {
+    use std::os::unix::fs::PermissionsExt;
+
+    let temp = TempDir::new()?;
+    let path = temp.path().join("app-server-daemon/settings.json");
+    tokio::fs::create_dir_all(path.parent().expect("settings parent")).await?;
+    tokio::fs::write(&path, r#"{"remoteControlEnabled":true,"futureSetting":42}"#).await?;
+
+    let expiry = unix_now()? + 60;
+    store_manual_pairing(&path, "AAAA-BBBB", expiry).await?;
+    store_manual_pairing(&path, "CCCC-DDDD", expiry + 60).await?;
+
+    let contents: serde_json::Value = serde_json::from_slice(&tokio::fs::read(&path).await?)?;
+    assert_eq!(
+        contents,
+        serde_json::json!({
+            "remoteControlEnabled": true,
+            "futureSetting": 42,
+            "manualPairing": {"code": "CCCC-DDDD", "expiresAt": expiry + 60},
+        })
+    );
+    assert_eq!(
+        tokio::fs::metadata(&path).await?.permissions().mode() & 0o777,
+        0o600
+    );
+
+    let disabled = DaemonSettings {
+        remote_control_enabled: false,
+        ..DaemonSettings::load(&path).await?
+    };
+    disabled.save(&path).await?;
+    let contents: serde_json::Value = serde_json::from_slice(&tokio::fs::read(&path).await?)?;
+    assert_eq!(contents.get("manualPairing"), None);
+    assert_eq!(contents.get("futureSetting"), Some(&serde_json::json!(42)));
+    Ok(())
+}
+
