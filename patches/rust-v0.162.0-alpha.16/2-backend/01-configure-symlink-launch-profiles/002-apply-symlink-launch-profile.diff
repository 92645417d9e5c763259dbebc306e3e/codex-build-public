--- a/codex-rs/cli/src/symlink_launch.rs
+++ b/codex-rs/cli/src/symlink_launch.rs
@@ -44,3 +44,33 @@ pub(crate) fn load_profile(codex_home: &Path, name: &str) -> anyhow::Result<Vec<
 #[cfg(test)]
 #[path = "symlink_launch_tests.rs"]
 mod tests;
+
+pub(crate) fn arguments(
+    args: impl IntoIterator<Item = OsString>,
+    codex_home: &Path,
+) -> anyhow::Result<Option<Vec<OsString>>> {
+    let mut args = args.into_iter();
+    let executable = args.next().context("missing executable argument")?;
+    let invoked = Path::new(&executable);
+    let resolved = if invoked.components().count() > 1 {
+        invoked.to_path_buf()
+    } else {
+        which::which(&executable).context("failed to locate invoked executable")?
+    };
+    if !std::fs::symlink_metadata(&resolved)
+        .with_context(|| format!("failed to inspect {}", resolved.display()))?
+        .file_type()
+        .is_symlink()
+    {
+        return Ok(None);
+    }
+    let name = invoked
+        .file_name()
+        .and_then(|name| name.to_str())
+        .context("symlink launch name is not valid UTF-8")?;
+    let profile = load_profile(codex_home, name)?;
+    let mut expanded = vec![executable];
+    expanded.extend(profile);
+    expanded.extend(args);
+    Ok(Some(expanded))
+}
