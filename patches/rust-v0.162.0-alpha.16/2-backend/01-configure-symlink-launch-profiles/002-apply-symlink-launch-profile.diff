+#[test]
+fn direct_executable_does_not_read_or_create_profiles() {
+    let home = tempfile::tempdir().unwrap();
+    let executable = home.path().join("real-codex");
+    std::fs::write(&executable, "binary").unwrap();
+    assert_eq!(
+        arguments([executable.into_os_string()], home.path()).unwrap(),
+        None
+    );
+    assert!(!home.path().join("config.toml").exists());
+}
+
+#[test]
+fn symlink_invocation_uses_only_its_named_arguments() {
+    let home = tempfile::tempdir().unwrap();
+    let executable = home.path().join("real-codex");
+    std::fs::write(&executable, "binary").unwrap();
+    let symlink = home.path().join("codex-embedded");
+    std::os::unix::fs::symlink(&executable, &symlink).unwrap();
+    let expanded = arguments([symlink.into_os_string()], home.path())
+        .unwrap()
+        .unwrap();
+    assert_eq!(expanded[1..], [OsString::from("--no-daemon")]);
+    assert_eq!(
+        std::fs::read_to_string(home.path().join("config.toml")).unwrap(),
+        "[symlinks]\ncodex = []\ncodex-embedded = [\"--no-daemon\"]\n"
+    );
+}
+
+#[test]
+fn explicit_arguments_override_named_arguments() {
+    let home = tempfile::tempdir().unwrap();
+    let executable = home.path().join("real-codex");
+    std::fs::write(&executable, "binary").unwrap();
+    let symlink = home.path().join("codex");
+    std::os::unix::fs::symlink(&executable, &symlink).unwrap();
+    std::fs::write(
+        home.path().join("config.toml"),
+        "[symlinks]\ncodex = [\"--sandbox\", \"workspace-write\", \"--ask-for-approval\", \"never\"]\n",
+    )
+    .unwrap();
+    let expanded = arguments(
+        [
+            symlink.into_os_string(),
+            "--sandbox".into(),
+            "read-only".into(),
+            "--ask-for-approval".into(),
+            "on-request".into(),
+        ],
+        home.path(),
+    )
+    .unwrap()
+    .unwrap();
+    let matches = crate::MultitoolCli::command()
+        .args_override_self(true)
+        .try_get_matches_from(expanded)
+        .unwrap();
+    let cli = crate::MultitoolCli::from_arg_matches(&matches).unwrap();
+    assert!(matches!(
+        cli.interactive.shared.sandbox_mode,
+        Some(codex_utils_cli::SandboxModeCliArg::ReadOnly)
+    ));
+    assert!(matches!(
+        cli.interactive.approval_policy,
+        Some(codex_utils_cli::ApprovalModeCliArg::OnRequest)
+    ));
+}
