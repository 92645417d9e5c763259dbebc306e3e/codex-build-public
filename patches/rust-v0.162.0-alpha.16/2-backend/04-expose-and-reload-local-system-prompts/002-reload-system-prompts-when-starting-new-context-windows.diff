+fn write_prompt(home: &Path, model: &str, text: &str) {
+    let dir = home.join("instructions");
+    std::fs::create_dir_all(&dir).expect("create prompt directory");
+    std::fs::write(dir.join(format!("{model}.md")), text).expect("write prompt overlay");
+}
+
+#[test_case("gpt-5.5", "gpt-5", None; "catalog_model")]
+#[test_case("uncatalogued-model", "uncatalogued-model", None; "generic_fallback")]
+#[test_case("gpt-5.5", "gpt-5", Some("Explicit custom system prompt."); "custom_override")]
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn prompt_edits_apply_only_at_local_window_boundaries(
+    model: &'static str,
+    overlay: &'static str,
+    custom: Option<&'static str>,
+) -> Result<()> {
+    let server = start_mock_server().await;
+    let responses = mount_sse_sequence(
+        &server,
+        vec![
+            sse_completed("response-1"),
+            sse_completed("response-2"),
+            sse_completed("response-3"),
+            sse_completed("response-4"),
+        ],
+    )
+    .await;
+    let test = test_codex()
+        .with_pre_build_hook(move |home| write_prompt(home, overlay, "Initial model prompt."))
+        .with_config(move |config| {
+            config.base_instructions = custom.map(str::to_owned);
+            config.model = Some(model.to_string());
+            config
+                .features
+                .enable(Feature::TokenBudget)
+                .expect("enable local context windows");
+        })
+        .build_with_auto_env(&server)
+        .await?;
+
+    test.submit_text_turn("First window").await?;
+    write_prompt(test.codex_home_path(), overlay, "Second model prompt.");
+    test.submit_text_turn("Keep the current window").await?;
+    test.codex.submit(Op::Compact).await?;
+    wait_for_event(&test.codex, |event| {
+        matches!(event, EventMsg::TurnComplete(_))
+    })
+    .await;
+    test.submit_text_turn("Second window").await?;
+    write_prompt(test.codex_home_path(), overlay, "Third model prompt.");
+    test.codex.submit(Op::Compact).await?;
+    wait_for_event(&test.codex, |event| {
+        matches!(event, EventMsg::TurnComplete(_))
+    })
+    .await;
+    test.submit_text_turn("Third window").await?;
+
+    let requests = responses.requests();
+    assert_eq!(
+        requests.len(),
+        4,
+        "local rollover sends no compaction request"
+    );
+    for (request, expected) in requests.iter().zip([
+        "Initial model prompt.",
+        "Initial model prompt.",
+        "Second model prompt.",
+        "Third model prompt.",
+    ]) {
+        assert_eq!(request.instructions_text(), custom.unwrap_or(expected));
+    }
+    let windows = requests
+        .iter()
+        .map(|request| {
+            let metadata: Value = serde_json::from_str(
+                &request
+                    .header("x-codex-turn-metadata")
+                    .expect("turn metadata"),
+            )
+            .expect("valid turn metadata");
+            metadata["context_window_id"].clone()
+        })
+        .collect::<Vec<_>>();
+    assert!(!windows[0].is_null());
+    assert_eq!(windows[0], windows[1]);
+    assert_ne!(windows[1], windows[2]);
+    assert_ne!(windows[2], windows[3]);
+    assert_eq!(
+        std::fs::read_to_string(
+            test.codex_home_path()
+                .join("instructions")
+                .join(format!("{overlay}.md"))
+        )?,
+        "Third model prompt."
+    );
+    Ok(())
+}
+
+async fn switch_model_then_start_new_window(model: &'static str) -> Result<ResponsesRequest> {
+    let server = start_mock_server().await;
+    let initial = mount_sse_once(&server, sse_completed("first-model")).await;
+    let test = test_codex()
+        .with_pre_build_hook(move |home| {
+            write_prompt(home, "gpt-5.5", "First model prompt.");
+            write_prompt(home, model, "Captured second-model prompt.");
+        })
+        .with_config(|config| {
+            config.model = Some("gpt-5.5".to_string());
+            config
+                .features
+                .enable(Feature::TokenBudget)
+                .expect("enable local context windows");
+        })
+        .build_with_auto_env(&server)
+        .await?;
+    test.submit_text_turn("Begin with the first model").await?;
+    assert_eq!(
+        initial.single_request().instructions_text(),
+        "First model prompt."
+    );
+
+    let prompt_home = test.codex_home_path().to_path_buf();
+    Mock::given(method("POST"))
+        .and(path_regex(".*/responses$"))
+        .and(body_partial_json(json!({"model": model})))
+        .respond_with(move |_: &wiremock::Request| {
+            // This request has already captured the old model metadata. Edit
+            // its file before the model asks to leave that context window.
+            write_prompt(&prompt_home, model, "Refreshed second-model prompt.");
+            sse_response(sse(vec![
+                ev_response_created("second-model"),
+                ev_function_call("new-window", "new_context", "{}"),
+                ev_completed("second-model"),
+            ]))
+        })
+        .with_priority(1)
+        .up_to_n_times(1)
+        .expect(1)
+        .mount(&server)
+        .await;
+    let follow_up = mount_sse_once(&server, sse_completed("new-window-response")).await;
+    test.codex
+        .start_or_steer_turn(
+            TurnInputRequest::user_input(vec![UserInput::Text {
+                text: "Continue with the second model".to_string(),
+                text_elements: Vec::new(),
+            }])
+            .with_thread_settings(ThreadSettingsOverrides {
+                model: Some(model.to_string()),
+                ..Default::default()
+            }),
+        )
+        .await?;
+    wait_for_event(&test.codex, |event| {
+        matches!(event, EventMsg::TurnComplete(_))
+    })
+    .await;
+
+    let request = follow_up.single_request();
+    assert_eq!(request.body_json()["model"], model);
+    assert!(!request.body_contains_text("Captured second-model prompt."));
+    Ok(request)
+}
