 use super::session::Session;
+use super::step_context::StepContext;
 use super::turn_context::TurnContext;
 use crate::config::Config;
+use codex_prompts::render_model_instructions;
 use codex_protocol::config_types::AutoCompactTokenLimitScope;
+use codex_protocol::models::BaseInstructionsProvenance;
 use codex_protocol::openai_models::ModelInfo;
 
+/// Resolve only the model prompt again; the captured step's other metadata stays pinned.
+pub(super) async fn model_instructions_for_new_window(
+    sess: &Session,
+    step_context: &StepContext,
+) -> Option<String> {
+    let config = {
+        let state = sess.state.lock().await;
+        if !matches!(
+            state.base_instructions_provenance,
+            Some(BaseInstructionsProvenance::Model { .. })
+        ) {
+            return None;
+        }
+        state
+            .session_configuration
+            .model_info_overrides
+            .models_manager_config(step_context.settings.personality())
+    };
+    let model = sess
+        .services
+        .models_manager
+        .get_model_info(&step_context.settings.model_info.slug, &config)
+        .await;
+    Some(render_model_instructions(&model))
+}
