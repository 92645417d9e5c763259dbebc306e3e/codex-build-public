+    std::fs::create_dir_all(&cwd).unwrap();
+    let codex_home = base.path().join("codex");
+    let harness = base.path().join("harness");
+    let user_home = base.path().join("home");
+    let runtime_base = base.path().join("tmp");
+    let roots = StorageRoots::resolve(&cwd, &codex_home, &harness, |name| match name {
+        "HOME" => Some(user_home.as_os_str().to_owned()),
+        "TMPDIR" => Some(runtime_base.as_os_str().to_owned()),
+        _ => None,
+    })
+    .unwrap()
+    .ensure()
+    .unwrap();
+
+    for path in [
+        &roots.project_scratch_root,
+        &roots.project_runtime_root,
+        &roots.project_persistent_root,
+        &roots.repos_root,
+        &roots.skills_root,
+        &roots.skills_scratch_root,
+    ] {
+        assert!(path.is_dir());
+        assert_eq!(path.as_path(), path.as_path().canonicalize().unwrap());
+    }
+    let mut children = std::fs::read_dir(&roots.project_scratch_root)
+        .unwrap()
+        .map(|entry| entry.unwrap().file_name())
+        .collect::<Vec<_>>();
