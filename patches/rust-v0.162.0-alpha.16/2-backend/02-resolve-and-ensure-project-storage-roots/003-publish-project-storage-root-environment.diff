+#[test]
+fn published_environment_contains_each_selected_canonical_root() {
+    let base = tempfile::tempdir().unwrap();
+    let cwd = base.path().join("repos/project");
+    let runtime_base = base.path().join("tmp");
+    std::fs::create_dir_all(&cwd).unwrap();
+    let roots = StorageRoots::resolve(&cwd, base.path(), base.path(), |name| match name {
+        "HOME" => Some(base.path().as_os_str().to_owned()),
+        "TMPDIR" => Some(runtime_base.as_os_str().to_owned()),
+        _ => None,
+    })
+    .unwrap()
+    .ensure()
+    .unwrap();
+    let environment = roots.into_environment();
+    assert_eq!(
+        environment.each_ref().map(|(name, _)| *name),
+        [
+            "PROJECT_SCRATCH_ROOT",
+            "PROJECT_RUNTIME_ROOT",
+            "PROJECT_PERSISTENT_ROOT",
+            "REPOS_ROOT",
+            "SKILLS_ROOT",
+            "SKILLS_SCRATCH_ROOT",
+        ]
+    );
+    assert!(environment.iter().all(|(_, path)| path.is_dir()));
+}
