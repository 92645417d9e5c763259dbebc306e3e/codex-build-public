+use super::StorageRoots;
+use pretty_assertions::assert_eq;
+use std::path::Path;
+
+#[test]
+fn entered_cwd_maps_to_the_project_relative_directory() {
+    let roots = StorageRoots::resolve(
+        Path::new("/home/person/repos/codex"),
+        Path::new("/codex"),
+        Path::new("/harness"),
+        |name| match name {
+            "HOME" => Some("/home/person".into()),
+            "TMPDIR" => Some("/tmp".into()),
+            _ => None,
+        },
+    )
+    .unwrap();
+    assert_eq!(
+        roots.project_scratch_root.as_path(),
+        Path::new("/harness/repos/codex")
+    );
+    assert_eq!(
+        roots.project_runtime_root.as_path(),
+        Path::new("/tmp/codex")
+    );
+    assert_eq!(
+        roots.project_persistent_root.as_path(),
+        Path::new("/home/person/codex")
+    );
+    assert_eq!(roots.repos_root.as_path(), Path::new("/home/person/repos"));
+    assert_eq!(roots.skills_root.as_path(), Path::new("/codex/skills"));
+    assert_eq!(
+        roots.skills_scratch_root.as_path(),
+        Path::new("/harness/skills")
+    );
+}
+
+#[test]
+fn repos_root_is_independent_of_the_entered_cwd() {
+    let roots = StorageRoots::resolve(
+        Path::new("/worktrees/group/project"),
+        Path::new("/codex"),
+        Path::new("/harness"),
+        |name| match name {
+            "HOME" => Some("/home/person".into()),
+            "TMPDIR" => Some("/tmp".into()),
+            _ => None,
+        },
+    )
+    .unwrap();
+    assert_eq!(
+        roots.project_scratch_root.as_path(),
+        Path::new("/harness/group/project")
+    );
+    assert_eq!(roots.repos_root.as_path(), Path::new("/home/person/repos"));
+}
+
+#[test]
+fn explicit_absolute_roots_override_defaults_without_requiring_home() {
+    let roots = StorageRoots::resolve(
+        Path::new("/home/person/repos/codex"),
+        Path::new("/codex"),
+        Path::new("/harness"),
+        |name| match name {
+            "PROJECT_SCRATCH_ROOT" => Some("/work/scratch".into()),
+            "PROJECT_RUNTIME_ROOT" => Some("/work/runtime".into()),
+            "PROJECT_PERSISTENT_ROOT" => Some("/work/persistent".into()),
+            "REPOS_ROOT" => Some("/work/repos".into()),
+            _ => None,
+        },
+    )
+    .unwrap();
+    assert_eq!(
+        roots.project_scratch_root.as_path(),
+        Path::new("/work/scratch")
+    );
+    assert_eq!(roots.repos_root.as_path(), Path::new("/work/repos"));
+    assert_eq!(
+        roots.project_runtime_root.as_path(),
+        Path::new("/work/runtime")
+    );
+    assert_eq!(
+        roots.project_persistent_root.as_path(),
+        Path::new("/work/persistent")
+    );
+}
+
+#[test]
+fn derived_roots_require_their_base_environment() {
+    let cwd = Path::new("/home/person/repos/codex");
+    let root = Path::new("/harness");
+    assert!(
+        StorageRoots::resolve(cwd, root, root, |name| {
+            (name == "HOME").then(|| "/home/person".into())
+        })
+        .is_err()
+    );
+    assert!(
+        StorageRoots::resolve(cwd, root, root, |name| match name {
+            "TMPDIR" => Some("/tmp".into()),
+            "REPOS_ROOT" => Some("/home/person/repos".into()),
+            _ => None,
+        })
+        .is_err()
+    );
+}
+
+#[test]
+fn relative_root_override_is_rejected() {
+    assert!(
+        StorageRoots::resolve(
+            Path::new("/home/person/repos/codex"),
+            Path::new("/codex"),
+            Path::new("/harness"),
+            |name| match name {
+                "HOME" => Some("/home/person".into()),
+                "PROJECT_SCRATCH_ROOT" => Some("relative".into()),
+                _ => None,
+            },
+        )
+        .is_err()
+    );
+}
