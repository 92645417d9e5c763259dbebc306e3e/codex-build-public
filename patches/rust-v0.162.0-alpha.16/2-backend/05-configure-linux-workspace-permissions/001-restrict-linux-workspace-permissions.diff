diff --git a/codex-rs/core/src/config/workspace_permissions.rs b/codex-rs/core/src/config/workspace_permissions.rs
new file mode 100644
--- /dev/null
+++ b/codex-rs/core/src/config/workspace_permissions.rs
@@ -0,0 +1,161 @@
+use codex_protocol::permissions::FileSystemAccessMode;
+use codex_protocol::permissions::FileSystemPath;
+use codex_protocol::permissions::FileSystemSandboxEntry;
+use codex_protocol::permissions::FileSystemSandboxPolicy;
+use codex_protocol::permissions::FileSystemSpecialPath;
+use codex_protocol::permissions::PROTECTED_METADATA_PATH_NAMES;
+use codex_utils_absolute_path::AbsolutePathBuf;
+use std::ffi::OsString;
+use std::io;
+use std::path::PathBuf;
+
+const STORAGE_ROOT_VARIABLES: [&str; 6] = [
+    "PROJECT_SCRATCH_ROOT",
+    "PROJECT_RUNTIME_ROOT",
+    "PROJECT_PERSISTENT_ROOT",
+    "REPOS_ROOT",
+    "SKILLS_ROOT",
+    "SKILLS_SCRATCH_ROOT",
+];
+
+pub(super) fn published_storage_roots() -> io::Result<Option<Vec<AbsolutePathBuf>>> {
+    published_storage_roots_with(|name| std::env::var_os(name))
+}
+
+fn published_storage_roots_with(
+    mut variable: impl FnMut(&str) -> Option<OsString>,
+) -> io::Result<Option<Vec<AbsolutePathBuf>>> {
+    let selected =
+        STORAGE_ROOT_VARIABLES.map(|name| (name, variable(name).filter(|value| !value.is_empty())));
+    if selected.iter().all(|(_, value)| value.is_none()) {
+        return Ok(None);
+    }
+    selected
+        .into_iter()
+        .map(|(name, value)| {
+            let value = value.ok_or_else(|| {
+                io::Error::new(
+                    io::ErrorKind::InvalidInput,
+                    format!("{name} was not published with the other storage roots"),
+                )
+            })?;
+            AbsolutePathBuf::from_absolute_path_checked(PathBuf::from(value)).map_err(|error| {
+                io::Error::new(
+                    io::ErrorKind::InvalidInput,
+                    format!("{name} must be an absolute path: {error}"),
+                )
+            })
+        })
+        .collect::<io::Result<Vec<_>>>()
+        .map(Some)
+}
+
+pub(super) fn workspace_file_system(
+    cwd: &AbsolutePathBuf,
+    storage_roots: &[AbsolutePathBuf],
+) -> FileSystemSandboxPolicy {
+    let mut entries = vec![FileSystemSandboxEntry::new(
+        FileSystemPath::Special {
+            value: FileSystemSpecialPath::Root,
+        },
+        FileSystemAccessMode::Read,
+    )];
+    // Bind the entered cwd rather than symbolic workspace folders, which can change later.
+    for root in std::iter::once(cwd).chain(storage_roots) {
+        entries.push(FileSystemSandboxEntry::new(
+            root.clone().into(),
+            FileSystemAccessMode::Write,
+        ));
+        // Native policy gives these names implicit read-only protection unless explicitly granted.
+        for name in PROTECTED_METADATA_PATH_NAMES {
+            entries.push(FileSystemSandboxEntry::new(
+                root.join(name).into(),
+                FileSystemAccessMode::Write,
+            ));
+        }
+    }
+    FileSystemSandboxPolicy::restricted(entries)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::collections::HashMap;
+    use std::path::Path;
+
+    #[test]
+    fn published_roots_are_all_or_none_and_absolute() {
+        assert_eq!(published_storage_roots_with(|_| None).unwrap(), None);
+        let partial = published_storage_roots_with(|name| {
+            (name == "PROJECT_SCRATCH_ROOT").then(|| OsString::from("/scratch"))
+        })
+        .unwrap_err();
+        assert!(partial.to_string().contains("PROJECT_RUNTIME_ROOT"));
+        let relative = published_storage_roots_with(|name| {
+            Some(if name == "SKILLS_ROOT" {
+                OsString::from("codex/skills")
+            } else {
+                OsString::from(format!("/{name}"))
+            })
+        })
+        .unwrap_err();
+        assert!(
+            relative
+                .to_string()
+                .contains("SKILLS_ROOT must be an absolute path")
+        );
+    }
+
+    #[test]
+    fn workspace_and_six_storage_trees_are_fully_writable() {
+        let roots = HashMap::from([
+            ("PROJECT_SCRATCH_ROOT", "/harness/repos/project"),
+            ("PROJECT_RUNTIME_ROOT", "/harness/tmp/project"),
+            ("PROJECT_PERSISTENT_ROOT", "/harness/state/project"),
+            ("REPOS_ROOT", "/home/person/repos"),
+            ("SKILLS_ROOT", "/codex/skills"),
+            ("SKILLS_SCRATCH_ROOT", "/harness/skills"),
+        ]);
+        let roots = published_storage_roots_with(|name| roots.get(name).map(OsString::from))
+            .unwrap()
+            .unwrap();
+        let cwd = AbsolutePathBuf::from_absolute_path_checked("/workspace").unwrap();
+        let policy = workspace_file_system(&cwd, &roots);
+        for path in [
+            "/workspace/file",
+            "/workspace/.git/config",
+            "/workspace/.agents/skills/example",
+            "/workspace/.codex/config.toml",
+            "/workspace/.aws/config",
+            "/workspace/any/nested/path",
+            "/harness/repos/project/rust/target",
+            "/harness/tmp/project/socket",
+            "/harness/state/project/data",
+            "/home/person/repos/other/file",
+            "/codex/skills/example/SKILL.md",
+            "/harness/skills/topic.md",
+            "/harness/skills/.aws/config",
+        ] {
+            assert!(
+                policy.can_write_local_path_with_cwd(Path::new(path), Path::new("/workspace")),
+                "expected write access to {path}"
+            );
+        }
+        for path in [
+            "/codex/config.toml",
+            "/harness/app-server/runtime",
+            "/tmp/unrelated",
+            "/var/tmp/unrelated",
+        ] {
+            assert!(
+                !policy.can_write_local_path_with_cwd(Path::new(path), Path::new("/workspace")),
+                "unexpected write access to {path}"
+            );
+        }
+        let unrelated = AbsolutePathBuf::from_absolute_path_checked("/unrelated").unwrap();
+        let materialized = policy
+            .clone()
+            .materialize_project_roots_with_workspace_roots(&[unrelated]);
+        assert_eq!(materialized, policy);
+    }
+}
