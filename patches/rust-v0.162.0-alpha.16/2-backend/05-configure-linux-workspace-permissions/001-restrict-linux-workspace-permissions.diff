+#[tokio::test]
+async fn supplied_builtin_workspace_uses_published_storage_roots_when_available()
+-> std::io::Result<()> {
+    let Some(roots) = published_storage_roots()? else {
+        return Ok(());
+    };
+    let codex_home = TempDir::new()?;
+    let cwd = TempDir::new()?;
+    let supplied = PermissionProfile::workspace_write_with(
+        &[],
+        NetworkSandboxPolicy::Enabled,
+        /*exclude_tmpdir_env_var*/ false,
+        /*exclude_slash_tmp*/ false,
+    );
+    let mut config = Config::load_from_base_config_with_overrides(
+        ConfigToml::default(),
+        ConfigOverrides {
+            cwd: Some(cwd.path().to_path_buf()),
+            permission_profile: Some(supplied),
+            ..Default::default()
+        },
+        codex_home.abs(),
+    )
+    .await?;
+
+    let policy = config.permissions.file_system_sandbox_policy();
+    for path in [cwd.path().join(".git/config")]
+        .into_iter()
+        .chain(roots.iter().map(|root| root.as_path().join("nested/file")))
+    {
+        assert!(
+            policy.can_write_local_path_with_cwd(&path, cwd.path()),
+            "{path:?}"
+        );
+    }
+    assert!(
+        !policy.can_write_local_path_with_cwd(std::path::Path::new("/tmp/unrelated"), cwd.path())
+    );
+    assert_eq!(
+        config.permissions.network_sandbox_policy(),
+        NetworkSandboxPolicy::Enabled
+    );
+    config
+        .permissions
+        .set_workspace_roots(vec![codex_home.abs()]);
+    let policy = config.permissions.file_system_sandbox_policy();
+    assert!(!policy.can_write_local_path_with_cwd(codex_home.path(), cwd.path()));
+    assert!(policy.can_write_local_path_with_cwd(&cwd.path().join(".git/config"), cwd.path()));
     Ok(())
 }
 
