+//! Log naming and tail reads do not depend on process-launch platform support.
+
+use super::PidLogTail;
+use super::read_stderr_log_tail;
+use super::stderr_log_file_for_pid_file;
+use pretty_assertions::assert_eq;
+use tempfile::TempDir;
+
+#[tokio::test]
+async fn read_stderr_log_tail_returns_recent_complete_lines() {
+    let temp_dir = TempDir::new().expect("temp dir");
+    let pid_file = temp_dir.path().join(crate::DAEMON_PID_FILE_NAME);
+    let log_file = stderr_log_file_for_pid_file(&pid_file);
+    let contents = format!("{}\nrecent error\nusage", "x".repeat(4100));
+    tokio::fs::write(&log_file, contents)
+        .await
+        .expect("write stderr log");
+
+    assert_eq!(
+        read_stderr_log_tail(&pid_file)
+            .await
+            .expect("read stderr log"),
+        Some(PidLogTail {
+            path: log_file,
+            contents: "recent error\nusage".to_string(),
+        })
+    );
+}
+
+#[test]
+fn managed_daemon_log_is_renamed_without_renaming_updater_log() {
+    let temp_dir = TempDir::new().expect("temp dir");
+    assert_eq!(
+        stderr_log_file_for_pid_file(&temp_dir.path().join(crate::DAEMON_PID_FILE_NAME)),
+        temp_dir.path().join("daemon.log")
+    );
+    assert_eq!(
+        stderr_log_file_for_pid_file(&temp_dir.path().join(crate::DAEMON_UPDATE_PID_FILE_NAME)),
+        temp_dir.path().join("daemon-updater.stderr.log")
+    );
+}
