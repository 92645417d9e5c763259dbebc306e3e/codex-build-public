new file mode 100644
--- /dev/null
+++ b/codex-rs/app-server-daemon/src/daemon_log_tests.rs
@@ -0,0 +1,57 @@
+//! Managed log paths and diagnostics are independent of process lifecycle support.
+
+use super::Daemon;
+use pretty_assertions::assert_eq;
+use tempfile::TempDir;
+
+#[tokio::test]
+async fn not_ready_context_reports_daemon_app_server_before_stderr() {
+    let home = TempDir::new().expect("home");
+    let harness = TempDir::new().expect("harness");
+    let daemon = Daemon::from_roots(home.path(), harness.path()).expect("daemon roots");
+    let stderr_log = daemon.pid_file.with_extension("log");
+    tokio::fs::create_dir_all(stderr_log.parent().expect("stderr log parent"))
+        .await
+        .expect("stderr log directory");
+    tokio::fs::write(&stderr_log, "unexpected argument")
+        .await
+        .expect("write stderr log");
+
+    assert_eq!(
+        daemon.app_server_not_ready_context().await,
+        format!(
+            "app server did not become ready on {}\n\n\
+             Daemon used app-server:\n  path: {}\n  version: unknown\n\n\
+             Managed app-server stderr ({}):\n  unexpected argument",
+            daemon.socket_path.display(),
+            daemon.managed_codex_bin.display(),
+            stderr_log.display()
+        )
+    );
+}
+
+#[test]
+fn daemon_roots_keep_runtime_state_and_managed_install_separate() {
+    let temp = TempDir::new().expect("temp dir");
+    let home = temp.path().join("home");
+    let harness = temp.path().join("harness");
+    let daemon = Daemon::from_roots(&home, &harness).expect("daemon roots");
+
+    assert_eq!(daemon.codex_home, home);
+    assert_eq!(
+        daemon.socket_path,
+        harness.join("app-server-control/app-server-control.sock")
+    );
+    assert_eq!(
+        daemon.settings_file,
+        harness.join("app-server-daemon/settings.json")
+    );
+    assert_eq!(
+        daemon.managed_codex_bin,
+        home.join("packages/app-server-daemon/current/bin/codex")
+    );
+    assert_eq!(
+        daemon.pid_file.with_extension("log"),
+        harness.join("app-server-daemon/daemon.log")
+    );
+}
