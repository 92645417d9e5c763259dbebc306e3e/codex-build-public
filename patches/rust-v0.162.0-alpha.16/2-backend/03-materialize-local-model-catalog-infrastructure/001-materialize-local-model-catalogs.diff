+use codex_protocol::openai_models::ModelInfo;
+use codex_protocol::protocol::MultiAgentVersion;
+use serde::Deserialize;
+use serde::Serialize;
+use serde_json::Map;
+use serde_json::Value;
+use std::collections::BTreeSet;
+use std::fs;
+use std::io::Error;
+use std::io::ErrorKind;
+use std::io::Write;
+use std::path::Path;
+use std::path::PathBuf;
+use std::sync::atomic::AtomicU64;
+use std::sync::atomic::Ordering;
+use tracing::warn;
+
+use crate::model_info::local_model_defaults;
+
+const MODELS_FILE: &str = "models.json";
+static NEXT_TEMP_FILE_ID: AtomicU64 = AtomicU64::new(0);
+
+#[derive(Debug, Default, Deserialize, Serialize)]
+#[serde(deny_unknown_fields)]
+pub(super) struct ModelsDocument {
+    #[serde(default)]
+    models: Vec<Value>,
+    #[serde(default)]
+    pub(super) prices: Map<String, Value>,
+}
+
+#[derive(Debug, Deserialize)]
+struct ModelEntry {
+    slug: String,
+    #[serde(default = "default_enabled")]
+    enabled: bool,
+    #[serde(default)]
+    multi_agent_version: Option<MultiAgentVersion>,
+    #[serde(flatten)]
+    fields: Map<String, Value>,
+}
+
+const fn default_enabled() -> bool {
+    true
+}
+
+pub(crate) fn path(codex_home: &Path) -> PathBuf {
+    codex_home.join(MODELS_FILE)
+}
+
+pub(crate) fn ensure_default(path: &Path) {
+    if let Err(err) = ensure_default_inner(path) {
+        warn!(path = %path.display(), "failed to ensure local model catalog: {err}");
+    }
+}
+
+fn ensure_default_inner(path: &Path) -> Result<(), Error> {
+    if path.exists() {
+        return Ok(());
+    }
+    if let Some(parent) = path.parent() {
+        fs::create_dir_all(parent)?;
+    }
+    match fs::OpenOptions::new()
+        .write(true)
+        .create_new(true)
+        .open(path)
+    {
+        Ok(mut file) => {
+            file.write_all(b"{\n  \"models\": [],\n  \"prices\": {}\n}\n")?;
+            file.sync_all()
+        }
+        Err(err) if err.kind() == ErrorKind::AlreadyExists => Ok(()),
+        Err(err) => Err(err),
+    }
+}
+
+pub(super) fn read_document(path: &Path) -> Result<Option<ModelsDocument>, Error> {
+    match fs::read(path) {
+        Ok(contents) => serde_json::from_slice(&contents)
+            .map(Some)
+            .map_err(|err| Error::new(ErrorKind::InvalidData, err)),
+        Err(err) if err.kind() == ErrorKind::NotFound => Ok(None),
+        Err(err) => Err(err),
+    }
+}
+
+pub(super) fn write_document(path: &Path, document: &ModelsDocument) -> Result<bool, Error> {
+    let mut updated = serde_json::to_vec_pretty(document).map_err(Error::other)?;
+    updated.push(b'\n');
+    if fs::read(path).ok().as_deref() == Some(updated.as_slice()) {
+        return Ok(false);
+    }
+    write_atomically(path, &updated)?;
+    Ok(true)
+}
+
+pub(crate) fn apply(path: &Path, models: Vec<ModelInfo>) -> Vec<ModelInfo> {
+    let document = match read_document(path) {
+        Ok(Some(document)) => document,
+        Ok(None) => return models,
+        Err(err) => {
+            warn!(
+                path = %path.display(),
+                "failed to load local model catalog: {err}"
+            );
+            return models;
+        }
+    };
+
+    let entries = document
+        .models
+        .into_iter()
+        .enumerate()
+        .filter_map(
+            |(index, entry)| match serde_json::from_value::<ModelEntry>(entry) {
+                Ok(entry) => Some(entry),
+                Err(err) => {
+                    warn!(
+                        path = %path.display(),
+                        index,
+                        "invalid local model catalog entry: {err}"
+                    );
+                    None
+                }
+            },
+        )
+        .collect::<Vec<_>>();
+    let mut seen = BTreeSet::new();
+    if let Some(duplicate) = entries
+        .iter()
+        .map(|model| model.slug.as_str())
+        .find(|slug| !seen.insert(*slug))
+    {
+        warn!(
+            path = %path.display(),
+            model = duplicate,
+            "local model catalog contains a duplicate slug"
+        );
+        return models;
+    }
+
+    apply_entries(path, models, entries)
+}
+
+pub(crate) fn prune_stale_overlays(
+    path: &Path,
+    previous_official_models: &[ModelInfo],
+    official_models: &[ModelInfo],
+) {
+    if let Err(err) = prune_stale_overlays_inner(path, previous_official_models, official_models) {
+        warn!(
+            path = %path.display(),
+            "failed to prune stale local model overlays: {err}"
+        );
+    }
+}
+
+fn prune_stale_overlays_inner(
+    path: &Path,
+    previous_official_models: &[ModelInfo],
+    official_models: &[ModelInfo],
+) -> Result<bool, Error> {
+    let Some(mut document) = read_document(path)? else {
+        return Ok(false);
+    };
+    let entries = &mut document.models;
+    let official_slugs = official_models
+        .iter()
+        .map(|model| model.slug.as_str())
+        .collect::<BTreeSet<_>>();
+    let stale_official_slugs = previous_official_models
+        .iter()
+        .map(|model| model.slug.as_str())
+        .filter(|slug| !official_slugs.contains(slug))
+        .collect::<BTreeSet<_>>();
+    let original_len = entries.len();
+    entries.retain(|entry| {
+        entry
+            .get("slug")
+            .and_then(Value::as_str)
+            .is_none_or(|slug| !stale_official_slugs.contains(slug))
+    });
+    if entries.len() == original_len {
+        return Ok(false);
+    }
+
+    write_document(path, &document)
+}
+
+fn apply_entries(
+    path: &Path,
+    mut models: Vec<ModelInfo>,
+    entries: Vec<ModelEntry>,
+) -> Vec<ModelInfo> {
+    for entry in entries {
+        let Some(index) = models.iter().position(|model| model.slug == entry.slug) else {
+            if !entry.enabled {
+                continue;
+            }
+            let Some(model) = complete_model_from_entry(&entry) else {
+                warn!(path = %path.display(), model = entry.slug, "local model entry is neither an official overlay nor a complete model");
+                continue;
+            };
+            models.push(model);
+            continue;
+        };
+        if !entry.enabled {
+            models.remove(index);
+            continue;
+        }
+        if entry.fields.is_empty() && entry.multi_agent_version.is_none() {
+            continue;
+        }
+        if entry.fields.contains_key("model_messages") {
+            warn!(
+                model = entry.slug,
+                "official model overlays cannot replace instruction content; use the per-model Markdown overlay"
+            );
+            continue;
+        }
+
+        let original = models[index].clone();
+        let mut value = match serde_json::to_value(&original) {
+            Ok(value) => value,
+            Err(err) => {
+                warn!(
+                    model = entry.slug,
+                    "failed to prepare official model overlay: {err}"
+                );
+                continue;
+            }
+        };
+        let Some(object) = value.as_object_mut() else {
+            warn!(model = entry.slug, "model catalog target is not an object");
+            continue;
+        };
+        merge_object(object, &entry.fields);
+        let mut ignored_fields = Vec::new();
+        let patched: ModelInfo = match serde_ignored::deserialize(value, |path| {
+            ignored_fields.push(path.to_string());
+        }) {
+            Ok(patched) => patched,
+            Err(err) => {
+                warn!(model = entry.slug, "invalid official model overlay: {err}");
+                continue;
+            }
+        };
+        if !ignored_fields.is_empty()
+            || patched.slug != original.slug
+            || !patch_is_reflected(&entry.fields, &patched)
+        {
+            warn!(
+                model = entry.slug,
+                "official model overlay contains an unknown or non-round-tripping field"
+            );
+            continue;
+        }
+        let mut patched = patched;
+        apply_entry_capabilities(&entry, &mut patched);
+        models[index] = patched;
+    }
+    models
+}
+
+fn complete_model_from_entry(entry: &ModelEntry) -> Option<ModelInfo> {
+    if entry.fields.contains_key("base_instructions") {
+        return None;
+    }
+    let mut value = serde_json::to_value(local_model_defaults(&entry.slug)).ok()?;
+    let object = value.as_object_mut()?;
+    merge_object(object, &entry.fields);
+    object.insert("slug".to_string(), Value::String(entry.slug.clone()));
+    let mut ignored_fields = Vec::new();
+    let mut model: ModelInfo = serde_ignored::deserialize(value, |path| {
+        ignored_fields.push(path.to_string());
+    })
+    .ok()?;
+    if !ignored_fields.is_empty() {
+        return None;
+    }
+    model.used_fallback_model_metadata = false;
+    apply_entry_capabilities(entry, &mut model);
+    Some(model)
+}
+
+fn apply_entry_capabilities(entry: &ModelEntry, model: &mut ModelInfo) {
+    if let Some(version) = entry.multi_agent_version {
+        model.multi_agent_version = Some(version);
+    }
+}
+
+pub(crate) fn load_model(path: &Path, slug: &str) -> Result<Option<ModelInfo>, Error> {
+    let Some(document) = read_document(path)? else {
+        return Ok(None);
+    };
+    Ok(document.models.into_iter().find_map(|entry| {
+        let entry = serde_json::from_value::<ModelEntry>(entry).ok()?;
+        (entry.enabled && entry.slug == slug)
+            .then(|| complete_model_from_entry(&entry))
+            .flatten()
+    }))
+}
+
+pub(crate) fn reconcile_external_models(
+    path: &Path,
+    previous_slugs: &BTreeSet<String>,
+    models: &[ModelInfo],
+) -> Result<bool, Error> {
+    let mut document = read_document(path)?.unwrap_or_default();
+    let entries = &mut document.models;
+    entries.retain(|entry| {
+        entry
+            .get("slug")
+            .and_then(Value::as_str)
+            .is_none_or(|slug| !previous_slugs.contains(slug))
+    });
+    for model in models {
+        if entries
+            .iter()
+            .any(|entry| entry.get("slug").and_then(Value::as_str) == Some(model.slug.as_str()))
+        {
+            continue;
+        }
+        entries.push(sparse_external_model_entry(model)?);
+    }
+
+    write_document(path, &document)
+}
+
+fn sparse_external_model_entry(model: &ModelInfo) -> Result<Value, Error> {
+    let mut entry = serde_json::to_value(model).map_err(Error::other)?;
+    let defaults = serde_json::to_value(local_model_defaults(&model.slug)).map_err(Error::other)?;
+    let object = entry
+        .as_object_mut()
+        .ok_or_else(|| Error::new(ErrorKind::InvalidData, "model metadata is not an object"))?;
+    let defaults = defaults
+        .as_object()
+        .ok_or_else(|| Error::new(ErrorKind::InvalidData, "model defaults are not an object"))?;
+    object.remove("model_messages");
+    object.retain(|key, value| key == "slug" || defaults.get(key) != Some(value));
+
+    if let Some(version) = model.multi_agent_version {
+        object.insert(
+            "multi_agent_version".to_string(),
+            serde_json::to_value(version).map_err(Error::other)?,
+        );
+    }
+    Ok(entry)
+}
+
+fn write_atomically(path: &Path, contents: &[u8]) -> Result<(), Error> {
+    if let Some(parent) = path.parent() {
+        fs::create_dir_all(parent)?;
+    }
+    let temp_id = NEXT_TEMP_FILE_ID.fetch_add(1, Ordering::Relaxed);
+    let temp_path = path.with_file_name(format!(
+        ".{MODELS_FILE}.{}.{}.tmp",
+        std::process::id(),
+        temp_id
+    ));
+    let write_result = (|| {
+        let mut file = fs::OpenOptions::new()
+            .write(true)
+            .create_new(true)
+            .open(&temp_path)?;
+        file.write_all(contents)?;
+        file.sync_all()?;
+        fs::rename(&temp_path, path)
+    })();
+    if write_result.is_err() {
+        let _ = fs::remove_file(&temp_path);
+    }
+    write_result
+}
+
+fn merge_object(target: &mut Map<String, Value>, patch: &Map<String, Value>) {
+    for (key, patch_value) in patch {
+        match (target.get_mut(key), patch_value) {
+            (Some(Value::Object(target)), Value::Object(patch)) => merge_object(target, patch),
+            _ => {
+                target.insert(key.clone(), patch_value.clone());
+            }
+        }
+    }
+}
+
+fn patch_is_reflected(patch: &Map<String, Value>, model: &ModelInfo) -> bool {
+    let Ok(Value::Object(actual)) = serde_json::to_value(model) else {
+        return false;
+    };
+    patch.iter().all(|(key, expected)| {
+        expected.is_null()
+            || actual
+                .get(key)
+                .is_some_and(|actual| value_is_reflected(expected, actual))
+    })
+}
+
+fn value_is_reflected(expected: &Value, actual: &Value) -> bool {
+    match expected {
+        Value::Null => true,
+        Value::Object(expected) => actual.as_object().is_some_and(|actual| {
+            expected.iter().all(|(key, expected)| {
+                expected.is_null()
+                    || actual
+                        .get(key)
+                        .is_some_and(|actual| value_is_reflected(expected, actual))
+            })
+        }),
+        _ => expected == actual,
+    }
+}
