+//! Local prices in `models.json`, independent of response records and usage reports.
+
+use crate::model_catalog;
+use serde::Deserialize;
+use serde_json::Value;
+use std::collections::BTreeMap;
+use std::io;
+use std::path::Path;
+
+/// Model slugs map to inclusive input-token lower bounds and USD per million tokens.
+pub type Prices = BTreeMap<String, Price>;
+
+#[derive(Debug, Deserialize)]
+#[serde(try_from = "BTreeMap<u64, Rates>")]
+pub struct Price {
+    intervals: BTreeMap<u64, Rates>,
+}
+
+/// All rates are USD per million tokens. Cached tokens are subsets of input.
+#[derive(Debug, Deserialize, PartialEq)]
+pub struct Rates {
+    pub input: f64,
+    pub cache_read: f64,
+    pub cache_write: f64,
+    pub output: f64,
+}
+
+#[derive(Debug, PartialEq)]
+pub struct Quote {
+    pub usd: f64,
+    /// The inclusive lower bound of the interval used for this quote.
+    pub input_threshold: u64,
+}
+
+impl TryFrom<BTreeMap<u64, Rates>> for Price {
+    type Error = String;
+
+    fn try_from(intervals: BTreeMap<u64, Rates>) -> Result<Self, Self::Error> {
+        for (threshold, rates) in &intervals {
+            if [
+                rates.input,
+                rates.cache_read,
+                rates.cache_write,
+                rates.output,
+            ]
+            .into_iter()
+            .any(|rate| !rate.is_finite() || rate < 0.0)
+            {
+                return Err(format!(
+                    "invalid USD per million price in interval {threshold}"
+                ));
+            }
+        }
+        if !intervals.contains_key(&0) {
+            return Err("local model pricing requires interval 0".into());
+        }
+        Ok(Self { intervals })
+    }
+}
+
+impl Price {
+    /// Quote exclusive input/cache buckets and output using the total input interval.
+    /// Cache counts are capped to input; output already includes reasoning tokens.
+    pub fn quote(&self, input: u64, cache_read: u64, cache_write: u64, output: u64) -> Quote {
+        let cache_read = cache_read.min(input);
+        let cache_write = cache_write.min(input - cache_read);
+        let (&input_threshold, rates) = self
+            .intervals
+            .range(..=input)
+            .next_back()
+            .expect("validated pricing includes interval 0");
+        let cost = (input - cache_read - cache_write) as f64 * rates.input
+            + cache_read as f64 * rates.cache_read
+            + cache_write as f64 * rates.cache_write
+            + output as f64 * rates.output;
+        Quote {
+            usd: cost / 1_000_000.0,
+            input_threshold,
+        }
+    }
+
+    pub fn intervals(&self) -> impl Iterator<Item = (u64, &Rates)> {
+        self.intervals
+            .iter()
+            .map(|(&threshold, rates)| (threshold, rates))
+    }
+
+    /// Missing models are absent from `Prices`; zero placeholders remain distinguishable.
+    pub fn is_zero(&self) -> bool {
+        self.intervals.values().all(|rates| {
+            [
+                rates.input,
+                rates.cache_read,
+                rates.cache_write,
+                rates.output,
+            ]
+            .into_iter()
+            .all(|rate| rate == 0.0)
+        })
+    }
+}
+
+/// Read the `prices` object from `codex_home/models.json` without creating the file.
+/// Missing prices are empty; malformed documents or rates return an error.
+pub fn read_prices(codex_home: &Path) -> io::Result<Prices> {
+    let path = model_catalog::path(codex_home);
+    let document = model_catalog::read_document(&path)
+        .map_err(|err| {
+            io::Error::new(
+                err.kind(),
+                format!("could not read {}: {err}", path.display()),
+            )
+        })?
+        .unwrap_or_default();
+    serde_json::from_value(Value::Object(document.prices)).map_err(|err| {
+        io::Error::new(
+            io::ErrorKind::InvalidData,
+            format!("invalid prices in {}: {err}", path.display()),
+        )
+    })
+}
+
+/// Insert zero prices for absent slugs without adding them to the active `models` array.
+/// Re-read the document to preserve current model metadata, rates, and user fields.
+pub fn ensure_models<'a>(
+    codex_home: &Path,
+    models: impl IntoIterator<Item = &'a str>,
+) -> io::Result<()> {
+    let path = model_catalog::path(codex_home);
+    let existing = model_catalog::read_document(&path)?;
+    let missing = existing.is_none();
+    let mut document = existing.unwrap_or_default();
+    let before = document.prices.len();
+    for model in models {
+        document.prices.entry(model.to_owned()).or_insert_with(|| {
+            serde_json::json!({
+                "0": {"input": 0.0, "cache_read": 0.0, "cache_write": 0.0, "output": 0.0}
+            })
+        });
+    }
+    if missing || document.prices.len() != before {
+        model_catalog::write_document(&path, &document)?;
+    }
+    Ok(())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use pretty_assertions::assert_eq;
+    use serde_json::json;
+    use std::fs;
+
+    fn prices() -> Prices {
+        serde_json::from_value(json!({"model": {
+            "0": {"input": 2.0, "cache_read": 1.0, "cache_write": 3.0, "output": 4.0},
+            "272000": {"input": 4.0, "cache_read": 1.0, "cache_write": 3.0, "output": 4.0}
+        }}))
+        .unwrap()
+    }
+
+    #[test]
+    fn quotes_bill_exclusive_cache_buckets_and_output_once() {
+        let prices = prices();
+        let quote = prices["model"].quote(100, 20, 10, 50);
+        assert_eq!(quote.input_threshold, 0);
+        assert!((quote.usd - 0.000_39).abs() < 1e-12);
+        let capped = prices["model"].quote(100, 80, 90, 30);
+        assert!((capped.usd - 0.000_26).abs() < 1e-12);
+        assert_eq!(prices["model"].quote(0, 100, 100, 0).usd, 0.0);
+    }
+
+    #[test]
+    fn intervals_use_numeric_inclusive_lower_bounds() {
+        let prices: Prices = serde_json::from_value(json!({"model": {
+            "0": {"input": 2.0, "cache_read": 0.0, "cache_write": 0.0, "output": 0.0},
+            "100": {"input": 8.0, "cache_read": 0.0, "cache_write": 0.0, "output": 0.0},
+            "20": {"input": 4.0, "cache_read": 0.0, "cache_write": 0.0, "output": 0.0}
+        }}))
+        .unwrap();
+        for (input, rate, input_threshold) in [
+            (0, 2.0, 0),
+            (19, 2.0, 0),
+            (20, 4.0, 20),
+            (99, 4.0, 20),
+            (100, 8.0, 100),
+            (101, 8.0, 100),
+        ] {
+            assert_eq!(
+                prices["model"].quote(input, 0, 0, 0),
+                Quote {
+                    usd: input as f64 * rate / 1_000_000.0,
+                    input_threshold
+                },
+            );
+        }
+        assert_eq!(
+            prices["model"]
+                .intervals()
+                .map(|(threshold, _)| threshold)
+                .collect::<Vec<_>>(),
+            [0, 20, 100]
+        );
+        assert!(!prices.contains_key("missing-model"));
+    }
+
+    #[test]
+    fn inserting_prices_preserves_current_model_fields_and_existing_rates() {
+        let directory = tempfile::tempdir().unwrap();
+        let path = model_catalog::path(directory.path());
+        let existing = json!({
+            "models": [{"slug": "model", "enabled": false, "note": "user-owned"}],
+            "prices": {"model": {"0": {
+                "input": 1.0, "cache_read": 0.0, "cache_write": 0.0,
+                "output": 2.0, "note": "user-owned"
+            }}}
+        });
+        fs::write(&path, existing.to_string()).unwrap();
+        let old = read_prices(directory.path()).unwrap();
+        let mut edited = existing.clone();
+        edited["prices"]["model"]["0"]["input"] = json!(3.0);
+        edited["models"][0]["note"] = json!("latest edit");
+        fs::write(&path, edited.to_string()).unwrap();
+        ensure_models(directory.path(), ["model", "missing-model"]).unwrap();
+        let updated: Value = serde_json::from_slice(&fs::read(&path).unwrap()).unwrap();
+        assert_eq!(updated["models"], edited["models"]);
+        assert_eq!(updated["prices"]["model"], edited["prices"]["model"]);
+        let prices = read_prices(directory.path()).unwrap();
+        assert!(prices["missing-model"].is_zero());
+        assert_eq!(old["model"].quote(1_000_000, 0, 0, 0).usd, 1.0);
+        assert_eq!(prices["model"].quote(1_000_000, 0, 0, 0).usd, 3.0);
+        let unchanged = fs::read(&path).unwrap();
+        ensure_models(directory.path(), ["model", "missing-model"]).unwrap();
+        assert_eq!(fs::read(&path).unwrap(), unchanged);
+        assert!(
+            model_catalog::load_model(&path, "missing-model")
+                .unwrap()
+                .is_none()
+        );
+    }
+
+    #[test]
+    fn missing_file_is_read_only_until_prices_are_inserted() {
+        let directory = tempfile::tempdir().unwrap();
+        let path = model_catalog::path(directory.path());
+        assert!(read_prices(directory.path()).unwrap().is_empty());
+        assert!(!path.exists());
+        ensure_models(directory.path(), ["model"]).unwrap();
+        assert!(read_prices(directory.path()).unwrap()["model"].is_zero());
+        assert!(model_catalog::apply(&path, Vec::new()).is_empty());
+    }
+
+    #[test]
+    fn invalid_prices_are_errors_and_are_not_replaced() {
+        let directory = tempfile::tempdir().unwrap();
+        let path = model_catalog::path(directory.path());
+        for model in [
+            json!({"0": {"input": -1.0, "cache_read": 0.0, "cache_write": 0.0, "output": 1.0}}),
+            json!({"20": {"input": 1.0, "cache_read": 0.0, "cache_write": 0.0, "output": 1.0}}),
+            json!({"wide": {"input": 1.0, "cache_read": 0.0, "cache_write": 0.0, "output": 1.0}}),
+        ] {
+            let bytes = json!({"models": [], "prices": {"model": model}}).to_string();
+            fs::write(&path, &bytes).unwrap();
+            assert!(read_prices(directory.path()).is_err());
+            assert_eq!(fs::read_to_string(&path).unwrap(), bytes);
+        }
+        fs::write(&path, "not JSON").unwrap();
+        assert!(read_prices(directory.path()).is_err());
+        assert!(ensure_models(directory.path(), ["model"]).is_err());
+        assert_eq!(fs::read_to_string(&path).unwrap(), "not JSON");
+    }
+}
