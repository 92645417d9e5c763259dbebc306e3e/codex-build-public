+use codex_protocol::config_types::ShellEnvironmentPolicy;
+use std::io;
+
+const PUBLISHED_ROOT_VARIABLES: [&str; 9] = [
+    "CODEX_HOME",
+    "CODEX_HARNESS",
+    "TMPDIR",
+    "PROJECT_SCRATCH_ROOT",
+    "PROJECT_RUNTIME_ROOT",
+    "PROJECT_PERSISTENT_ROOT",
+    "REPOS_ROOT",
+    "SKILLS_ROOT",
+    "SKILLS_SCRATCH_ROOT",
+];
+
+pub(super) fn expand_published_root_references(
+    policy: ShellEnvironmentPolicy,
+) -> io::Result<ShellEnvironmentPolicy> {
+    expand_published_root_references_with(policy, |name| match std::env::var(name) {
+        Ok(value) if !value.is_empty() => Ok(value),
+        Ok(_) | Err(std::env::VarError::NotPresent) => Err(io::Error::new(
+            io::ErrorKind::InvalidInput,
+            format!("published root environment variable {name} is missing or empty"),
+        )),
+        Err(std::env::VarError::NotUnicode(_)) => Err(io::Error::new(
+            io::ErrorKind::InvalidInput,
+            format!("published root environment variable {name} is not valid UTF-8"),
+        )),
+    })
+}
+
+fn expand_published_root_references_with(
+    mut policy: ShellEnvironmentPolicy,
+    mut variable: impl FnMut(&str) -> io::Result<String>,
+) -> io::Result<ShellEnvironmentPolicy> {
+    for value in policy.r#set.values_mut() {
+        *value = expand_value(value, &mut variable)?;
+    }
+    Ok(policy)
+}
+
+fn expand_value(
+    input: &str,
+    variable: &mut impl FnMut(&str) -> io::Result<String>,
+) -> io::Result<String> {
+    let bytes = input.as_bytes();
+    let mut output = String::with_capacity(input.len());
+    let mut copied_until = 0;
+    let mut index = 0;
+    while index < bytes.len() {
+        if bytes[index] != b'$'
+            || bytes
+                .get(index + 1)
+                .copied()
+                .is_none_or(|byte| !is_variable_start(byte))
+        {
+            index += 1;
+            continue;
+        }
+        let start = index + 1;
+        let mut end = start + 1;
+        while bytes.get(end).copied().is_some_and(is_variable_continue) {
+            end += 1;
+        }
+        let name = &input[start..end];
+        if !PUBLISHED_ROOT_VARIABLES.contains(&name) {
+            return Err(io::Error::new(
+                io::ErrorKind::InvalidInput,
+                format!("unknown shell_environment_policy root reference ${name}"),
+            ));
+        }
+        output.push_str(&input[copied_until..index]);
+        output.push_str(&variable(name)?);
+        copied_until = end;
+        index = end;
+    }
+    if copied_until == 0 {
+        return Ok(input.to_string());
+    }
+    output.push_str(&input[copied_until..]);
+    Ok(output)
+}
+
+fn is_variable_start(byte: u8) -> bool {
+    byte == b'_' || byte.is_ascii_uppercase()
+}
+
+fn is_variable_continue(byte: u8) -> bool {
+    is_variable_start(byte) || byte.is_ascii_digit()
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::collections::HashMap;
+
+    fn policy(values: &[(&str, &str)]) -> ShellEnvironmentPolicy {
+        ShellEnvironmentPolicy {
+            r#set: values
+                .iter()
+                .map(|(name, value)| ((*name).to_string(), (*value).to_string()))
+                .collect(),
+            ..Default::default()
+        }
+    }
+
+    #[test]
+    fn expands_root_references_with_suffixes_nonrecursively() {
+        let values = HashMap::from([
+            ("PROJECT_SCRATCH_ROOT", "/harness/repos/project"),
+            ("CODEX_HOME", "/codex"),
+        ]);
+        let expanded = expand_published_root_references_with(
+            policy(&[
+                ("GOPATH", "$PROJECT_SCRATCH_ROOT/go"),
+                ("CONFIG", "$CODEX_HOME/config.toml"),
+                ("STATIC", "literal"),
+            ]),
+            |name| Ok(values[name].to_string()),
+        )
+        .unwrap();
+        assert_eq!(expanded.r#set["GOPATH"], "/harness/repos/project/go");
+        assert_eq!(expanded.r#set["CONFIG"], "/codex/config.toml");
+        assert_eq!(expanded.r#set["STATIC"], "literal");
+
+        let nonrecursive = expand_published_root_references_with(
+            policy(&[("VALUE", "$PROJECT_SCRATCH_ROOT/go")]),
+            |_| Ok("$CODEX_HOME/project".to_string()),
+        )
+        .unwrap();
+        assert_eq!(nonrecursive.r#set["VALUE"], "$CODEX_HOME/project/go");
+    }
+
+    #[test]
+    fn rejects_unknown_or_unpublished_root_references() {
+        let unknown = expand_published_root_references_with(
+            policy(&[("VALUE", "$HOME/cache")]),
+            |_| unreachable!(),
+        )
+        .unwrap_err();
+        assert!(unknown.to_string().contains("unknown"));
+
+        let missing = expand_published_root_references_with(
+            policy(&[("VALUE", "$SKILLS_ROOT/cache")]),
+            |name| {
+                Err(io::Error::new(
+                    io::ErrorKind::InvalidInput,
+                    format!("{name} missing"),
+                ))
+            },
+        )
+        .unwrap_err();
+        assert!(missing.to_string().contains("SKILLS_ROOT missing"));
+    }
+
+    #[test]
+    fn leaves_nonreference_dollar_signs_literal() {
+        let expanded = expand_published_root_references_with(
+            policy(&[("PRICE", "cost$-literal"), ("LOWER", "$not_a_root")]),
+            |_| unreachable!(),
+        )
+        .unwrap();
+        assert_eq!(expanded.r#set["PRICE"], "cost$-literal");
+        assert_eq!(expanded.r#set["LOWER"], "$not_a_root");
+    }
+}
