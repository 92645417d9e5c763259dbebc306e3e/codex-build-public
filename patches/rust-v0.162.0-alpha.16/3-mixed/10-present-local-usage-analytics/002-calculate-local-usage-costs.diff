+use super::*;
+use crate::local_usage::types::Tokens;
+use pretty_assertions::assert_eq;
+use serde_json::Value;
+use serde_json::json;
+use std::fs;
+
+fn usage(input: u64, output: u64) -> Value {
+    json!({"input_tokens":input,"output_tokens":output,"total_tokens":input+output})
+}
+
+fn count(at: &str, last: Value, total: Value) -> Value {
+    json!({"type":"event_msg","timestamp":at,"payload":{"type":"token_count",
+        "info":{"last_token_usage":last,"total_token_usage":total}}})
+}
+
+fn write_rollout(root: &Path, relative: &str, id: &str, parent: Option<&str>, events: &[Value]) {
+    let path = root.join(relative);
+    fs::create_dir_all(path.parent().unwrap()).unwrap();
+    let header = json!({"type":"session_meta","timestamp":"2026-02-01T00:00:00Z",
+        "payload":{"id":id,"forked_from_id":parent,"history_mode":"paginated"}});
+    let context = json!({"type":"turn_context","payload":{"model":"gpt-5.4","effort":"high"}});
+    let mut text = format!("{header}\n{context}\n");
+    for event in events {
+        text.push_str(&format!("{event}\n"));
+    }
+    fs::write(path, text).unwrap();
+}
+
+fn prices() -> Prices {
+    serde_json::from_value(json!({"gpt-5.4":{
+        "0": {"input":2.0,"output":4.0,"cache_read":1.0,"cache_write":3.0},
+        "272000": {"input":4.0,"output":4.0,"cache_read":1.0,"cache_write":3.0}
+    }}))
+    .unwrap()
+}
+
+fn report(root: &Path) -> UsageReport {
+    let now = DateTime::parse_from_rfc3339("2026-02-01T04:00:00Z")
+        .unwrap()
+        .timestamp_millis();
+    load(
+        root,
+        prices(),
+        FixedOffset::east_opt(8 * 3600).unwrap(),
+        now,
+    )
+    .unwrap()
+}
+
+#[test]
+fn migrated_parent_replay_and_archive_copy_are_counted_once() {
+    let directory = tempfile::tempdir().unwrap();
+    let root = directory.path();
+    let parent = count(
+        "2026-01-31T16:00:00Z",
+        usage(/*input*/ 100, /*output*/ 10),
+        usage(/*input*/ 100, /*output*/ 10),
+    );
+    write_rollout(
+        root,
+        "sessions/2026/01/31/parent.jsonl",
+        "parent",
+        /*parent*/ None,
+        &[parent.clone()],
+    );
+    write_rollout(
+        root,
+        "archived_sessions/2026/01/31/parent.jsonl",
+        "parent",
+        /*parent*/ None,
+        &[count(
+            "2026-01-31T16:00:00Z",
+            usage(/*input*/ 999, /*output*/ 1),
+            usage(/*input*/ 999, /*output*/ 1),
+        )],
+    );
+    let replay = count(
+        "2026-02-01T00:00:00Z",
+        usage(/*input*/ 100, /*output*/ 10),
+        usage(/*input*/ 100, /*output*/ 10),
+    );
+    let own = count(
+        "2026-02-01T00:00:03Z",
+        usage(/*input*/ 200, /*output*/ 20),
+        usage(/*input*/ 300, /*output*/ 30),
+    );
+    write_rollout(
+        root,
+        "sessions/2026/02/01/child.jsonl",
+        "child",
+        Some("parent"),
+        &[replay, own.clone(), own],
+    );
+    fs::write(
+        root.join("sessions/ignored.jsonl"),
+        "{\"type\":\"session_meta\",\"payload\":{\"history_mode\":\"linear\"}}\n",
+    )
+    .unwrap();
+    fs::write(
+        root.join("sessions/ignored.jsonl.zst"),
+        "not an admitted input",
+    )
+    .unwrap();
+    let daily = report(root);
+    assert_eq!(
+        daily.rows["2026-02-01"]["gpt-5.4"].tokens,
+        Tokens {
+            input: 300,
+            output: 30,
+            total: 330,
+            ..Tokens::default()
+        }
+    );
+    assert!((daily.rows["2026-02-01"]["gpt-5.4"].cost - 0.00072).abs() < 1e-12);
+    assert_eq!(daily.diagnostics.replayed_events, 1);
+    assert_eq!(daily.diagnostics.skipped_non_paginated, 1);
+    for (range, period) in [
+        (UsageRange::Today, "2026-02-01"),
+        (UsageRange::Weekly, "2026-01-26"),
+        (UsageRange::Monthly, "2026-02"),
+        (UsageRange::Yearly, "2026"),
+    ] {
+        assert_eq!(
+            daily
+                .periods(range)
+                .find(|(key, _)| key.as_str() == period)
+                .unwrap()
+                .1
+                .get("gpt-5.4"),
+            daily.rows["2026-02-01"].get("gpt-5.4")
+        );
+    }
+    assert!(daily.periods(UsageRange::Yesterday).next().is_none());
+}
+
+#[test]
+fn copied_metadata_merges_before_pricing() {
+    let directory = tempfile::tempdir().unwrap();
+    let event = count(
+        "2026-02-01T00:00:00Z",
+        usage(/*input*/ 280_000, /*output*/ 100),
+        usage(/*input*/ 280_000, /*output*/ 100),
+    );
+    for (file, effort, tier) in [("fast", "high", "fast"), ("standard", "low", "default")] {
+        let settings = json!({"type":"event_msg","timestamp":"2026-02-01T00:00:00Z",
+            "payload":{"type":"thread_settings_applied","thread_settings":{"service_tier":tier}}});
+        let context = json!({"type":"turn_context","payload":{"model":"gpt-5.4","effort":effort}});
+        write_rollout(
+            directory.path(),
+            &format!("sessions/{file}.jsonl"),
+            file,
+            /*parent*/ None,
+            &[context, settings, event.clone()],
+        );
+    }
+    let report = report(directory.path());
+    let usage = &report.rows["2026-02-01"]["gpt-5.4"];
+    assert_eq!(report.diagnostics.duplicate_events, 1);
+    assert_eq!(usage.tokens.total, 280_100);
+    assert_eq!(usage.long_tokens, usage.tokens);
+    assert_eq!(usage.short_cost, 0.0);
+    assert!((usage.long_cost - 1.1204).abs() < 1e-12);
+}
+
+#[test]
+fn mixed_context_totals_retain_token_partitions_and_the_prices_used() {
+    let directory = tempfile::tempdir().unwrap();
+    write_rollout(
+        directory.path(),
+        "sessions/mixed.jsonl",
+        "mixed",
+        None,
+        &[
+            count("2026-02-01T00:00:00Z", usage(100, 10), usage(100, 10)),
+            count(
+                "2026-02-01T00:01:00Z",
+                usage(280_000, 100),
+                usage(280_100, 110),
+            ),
+        ],
+    );
+    let report = report(directory.path());
+    let usage = &report.rows["2026-02-01"]["gpt-5.4"];
+    assert_eq!(usage.tokens.subtract(usage.long_tokens).input, 100);
+    assert_eq!(usage.long_tokens.input, 280_000);
+    assert_eq!(usage.long_tokens.output, 100);
+    let mut total = super::super::types::Usage::default();
+    total.add_usage(usage);
+    assert_eq!(&total, usage);
+    assert_eq!(
+        report.prices["gpt-5.4"]
+            .intervals()
+            .map(|(threshold, rates)| {
+                (
+                    threshold,
+                    [
+                        rates.input,
+                        rates.cache_read,
+                        rates.cache_write,
+                        rates.output,
+                    ],
+                )
+            })
+            .collect::<Vec<_>>(),
+        vec![(0, [2.0, 1.0, 3.0, 4.0]), (272_000, [4.0, 1.0, 3.0, 4.0]),]
+    );
+}
