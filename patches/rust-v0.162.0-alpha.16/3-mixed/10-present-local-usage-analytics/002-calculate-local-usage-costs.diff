@@ -88,6 +88,36 @@ pub(super) struct Observation {
     pub(super) used_percent: f64,
     pub(super) resets_at: i64,
 }
+
+#[derive(Clone, Debug, Default, PartialEq)]
+pub(super) struct Usage {
+    pub(super) tokens: Tokens,
+    pub(super) long_tokens: Tokens,
+    pub(super) cost: f64,
+    pub(super) short_cost: f64,
+    pub(super) long_cost: f64,
+}
+
+impl Usage {
+    pub(super) fn add(&mut self, tokens: Tokens, cost: f64, long: bool) {
+        self.tokens.add(tokens);
+        self.cost += cost;
+        if long {
+            self.long_tokens.add(tokens);
+            self.long_cost += cost;
+        } else {
+            self.short_cost += cost;
+        }
+    }
+
+    pub(super) fn add_usage(&mut self, other: &Self) {
+        self.tokens.add(other.tokens);
+        self.long_tokens.add(other.long_tokens);
+        self.cost += other.cost;
+        self.short_cost += other.short_cost;
+        self.long_cost += other.long_cost;
+    }
+}
