+use super::Error;
+use super::Rows;
+use super::UsageRange;
+use super::UsageReport;
+use super::reader;
+use super::types::Tier;
+use super::types::Usage;
+use chrono::DateTime;
+use chrono::Datelike;
+use chrono::Duration;
+use chrono::FixedOffset;
+use chrono::NaiveDate;
+use chrono::Utc;
+use codex_models_manager::model_pricing::Prices;
+use std::collections::BTreeMap;
+use std::collections::BTreeSet;
+use std::path::Path;
+
+fn period_date(date: NaiveDate, period: UsageRange) -> NaiveDate {
+    match period {
+        UsageRange::Today | UsageRange::Yesterday | UsageRange::Daily | UsageRange::Heatmap => date,
+        UsageRange::Weekly => {
+            date - Duration::days(i64::from(date.weekday().num_days_from_monday()))
+        }
+        UsageRange::Monthly => date.with_day(1).unwrap_or(date),
+        UsageRange::Yearly => NaiveDate::from_ymd_opt(date.year(), 1, 1).unwrap_or(date),
+    }
+}
+
+fn period_key(date: NaiveDate, period: UsageRange) -> String {
+    match period {
+        UsageRange::Today
+        | UsageRange::Yesterday
+        | UsageRange::Daily
+        | UsageRange::Weekly
+        | UsageRange::Heatmap => date.to_string(),
+        UsageRange::Monthly => date.format("%Y-%m").to_string(),
+        UsageRange::Yearly => date.format("%Y").to_string(),
+    }
+}
+
+pub(super) fn load(
+    home: &Path,
+    prices: Prices,
+    timezone: FixedOffset,
+    now: i64,
+) -> Result<UsageReport, Error> {
+    let refreshed_at = DateTime::<Utc>::from_timestamp_millis(now)
+        .ok_or("invalid report time")?
+        .with_timezone(&timezone);
+    let today = refreshed_at.date_naive();
+    let reader::Events {
+        mut events,
+        models,
+        observations: _,
+        mut diagnostics,
+    } = reader::load(home)?;
+    events.sort_unstable_by(|left, right| {
+        left.millis
+            .cmp(&right.millis)
+            .then_with(|| left.model.cmp(&right.model))
+            .then_with(|| left.tokens.cmp(&right.tokens))
+    });
+    let before = events.len();
+    events.dedup_by(|next, previous| {
+        if next.millis != previous.millis
+            || next.model != previous.model
+            || next.tokens != previous.tokens
+        {
+            return false;
+        }
+        previous.tier = Tier::merge(previous.tier, next.tier);
+        true
+    });
+    diagnostics.duplicate_events = before - events.len();
+    diagnostics.unique_events = events.len();
+    let mut groups = BTreeMap::<(NaiveDate, usize), Usage>::new();
+    let mut missing_prices = BTreeSet::new();
+    for event in events {
+        let Some(time) = DateTime::<Utc>::from_timestamp_millis(event.millis) else {
+            continue;
+        };
+        let date = time.with_timezone(&timezone).date_naive();
+        let model = &models[event.model];
+        let price = prices.get(model);
+        if price.is_none_or(|price| price.is_zero()) {
+            missing_prices.insert(model.clone());
+        }
+        let (cost, long) = price.map_or((0.0, false), |price| {
+            let tokens = event.tokens;
+            let quote = price.quote(
+                tokens.input,
+                tokens.cached,
+                tokens.cache_write,
+                tokens.output,
+            );
+            (quote.usd, quote.input_threshold != 0)
+        });
+        groups
+            .entry((date, event.model))
+            .or_default()
+            .add(event.tokens, cost, long);
+    }
+    let mut rows = Rows::new();
+    let mut weekly_rows = Rows::new();
+    let mut monthly_rows = Rows::new();
+    let mut yearly_rows = Rows::new();
+    for ((date, model), row) in groups {
+        for (period, rows) in [
+            (UsageRange::Daily, &mut rows),
+            (UsageRange::Weekly, &mut weekly_rows),
+            (UsageRange::Monthly, &mut monthly_rows),
+            (UsageRange::Yearly, &mut yearly_rows),
+        ] {
+            rows.entry(period_key(period_date(date, period), period))
+                .or_default()
+                .entry(models[model].clone())
+                .or_default()
+                .add_usage(&row);
+        }
+    }
+    Ok(UsageReport {
+        refreshed_at,
+        today,
+        timezone,
+        rows,
+        weekly_rows,
+        monthly_rows,
+        yearly_rows,
+        prices,
+        missing_prices,
+        diagnostics,
+    })
+}
+
+#[cfg(test)]
+#[path = "aggregate_tests.rs"]
+mod tests;
