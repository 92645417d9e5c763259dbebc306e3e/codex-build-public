+use chrono::DateTime;
+use chrono::FixedOffset;
+use schemars::JsonSchema;
+use serde::Deserialize;
+use serde::Serialize;
+use std::collections::BTreeMap;
+use std::collections::BTreeSet;
+use ts_rs::TS;
+
+pub type LocalUsageRows = BTreeMap<String, BTreeMap<String, LocalUsageTotals>>;
+
+/// A single server-local accounting snapshot, shared by all report views and clients.
+#[derive(Clone, Debug, Deserialize, JsonSchema, PartialEq, Serialize, TS)]
+#[serde(rename_all = "camelCase")]
+#[ts(export_to = "v2/")]
+pub struct LocalUsageReport {
+    /// Snapshot time and the local offset used for its calendar aggregation.
+    #[schemars(with = "String")]
+    #[ts(type = "string")]
+    pub refreshed_at: DateTime<FixedOffset>,
+    pub rows: LocalUsageRows,
+    pub weekly_rows: LocalUsageRows,
+    pub monthly_rows: LocalUsageRows,
+    pub yearly_rows: LocalUsageRows,
+    /// Model prices by inclusive input-token threshold, in USD per million tokens.
+    pub prices: BTreeMap<String, BTreeMap<u64, LocalUsagePriceRates>>,
+    pub quota: Vec<LocalUsageQuotaEstimate>,
+    pub missing_prices: BTreeSet<String>,
+    pub diagnostics: LocalUsageDiagnostics,
+}
+
+/// Input includes both cache buckets; reasoning is already included in output.
+#[derive(
+    Clone,
+    Copy,
+    Debug,
+    Default,
+    Deserialize,
+    Eq,
+    JsonSchema,
+    Ord,
+    PartialEq,
+    PartialOrd,
+    Serialize,
+    TS,
+)]
+#[serde(rename_all = "camelCase")]
+#[ts(export_to = "v2/")]
+pub struct LocalUsageTokens {
+    pub input: u64,
+    pub cached: u64,
+    pub cache_write: u64,
+    pub output: u64,
+    pub reasoning: u64,
+    pub total: u64,
+}
+
+impl LocalUsageTokens {
+    pub fn subtract(self, previous: Self) -> Self {
+        let input = self.input.saturating_sub(previous.input);
+        let cached = self.cached.saturating_sub(previous.cached).min(input);
+        Self {
+            input,
+            cached,
+            cache_write: self
+                .cache_write
+                .saturating_sub(previous.cache_write)
+                .min(input - cached),
+            output: self.output.saturating_sub(previous.output),
+            reasoning: self.reasoning.saturating_sub(previous.reasoning),
+            total: self.total.saturating_sub(previous.total),
+        }
+    }
+
+    pub fn is_empty(self) -> bool {
+        self.input == 0
+            && self.cached == 0
+            && self.cache_write == 0
+            && self.output == 0
+            && self.reasoning == 0
+    }
+
+    pub fn add(&mut self, other: Self) {
+        self.input += other.input;
+        self.cached += other.cached;
+        self.cache_write += other.cache_write;
+        self.output += other.output;
+        self.reasoning += other.reasoning;
+        self.total += other.total;
+    }
+}
+
+#[derive(Clone, Debug, Default, Deserialize, JsonSchema, PartialEq, Serialize, TS)]
+#[serde(rename_all = "camelCase")]
+#[ts(export_to = "v2/")]
+pub struct LocalUsageTotals {
+    pub tokens: LocalUsageTokens,
+    pub long_tokens: LocalUsageTokens,
+    pub cost: f64,
+    pub short_cost: f64,
+    pub long_cost: f64,
+}
+
+impl LocalUsageTotals {
+    pub fn add(&mut self, tokens: LocalUsageTokens, cost: f64, long: bool) {
+        self.tokens.add(tokens);
+        self.cost += cost;
+        if long {
+            self.long_tokens.add(tokens);
+            self.long_cost += cost;
+        } else {
+            self.short_cost += cost;
+        }
+    }
+
+    pub fn add_usage(&mut self, other: &Self) {
+        self.tokens.add(other.tokens);
+        self.long_tokens.add(other.long_tokens);
+        self.cost += other.cost;
+        self.short_cost += other.short_cost;
+        self.long_cost += other.long_cost;
+    }
+}
+
+#[derive(Clone, Debug, Default, Deserialize, JsonSchema, PartialEq, Serialize, TS)]
+#[serde(rename_all = "camelCase")]
+#[ts(export_to = "v2/")]
+pub struct LocalUsageDiagnostics {
+    pub files: usize,
+    pub skipped_non_paginated: usize,
+    pub malformed_records: usize,
+    pub incomplete_tails: usize,
+    pub replayed_events: usize,
+    pub duplicate_events: usize,
+    pub unique_events: usize,
+}
+
+#[derive(Clone, Debug, Deserialize, JsonSchema, PartialEq, Serialize, TS)]
+#[serde(rename_all = "camelCase")]
+#[ts(export_to = "v2/")]
+pub struct LocalUsagePriceRates {
+    pub input: f64,
+    pub cache_read: f64,
+    pub cache_write: f64,
+    pub output: f64,
+}
+
+#[derive(Clone, Copy, Debug, Deserialize, Eq, JsonSchema, PartialEq, Serialize, TS)]
+#[serde(rename_all = "camelCase")]
+#[ts(export_to = "v2/")]
+pub enum LocalUsageQuotaStatus {
+    Completed,
+    Provisional,
+}
+
+#[derive(Clone, Debug, Deserialize, JsonSchema, PartialEq, Serialize, TS)]
+#[serde(rename_all = "camelCase")]
+#[ts(export_to = "v2/")]
+pub struct LocalUsageQuotaEstimate {
+    pub started_at: String,
+    pub ended_at: String,
+    pub used_percent_start: f64,
+    pub used_percent_end: f64,
+    pub observed_cost_usd: f64,
+    pub estimated_weekly_cost_usd: f64,
+    pub sample_count: usize,
+    pub status: LocalUsageQuotaStatus,
+}
