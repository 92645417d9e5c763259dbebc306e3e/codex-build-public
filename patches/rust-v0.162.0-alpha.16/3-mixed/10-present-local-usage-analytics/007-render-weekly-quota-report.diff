+use super::cost_cell;
+use super::count;
+use super::number;
+use super::numeric_table;
+use crate::local_usage::table::Cell;
+use crate::render::renderable::Renderable;
+use chrono::DateTime;
+use chrono::FixedOffset;
+use codex_app_server_protocol::LocalUsageQuotaEstimate as Estimate;
+use codex_app_server_protocol::LocalUsageQuotaStatus as Status;
+use ratatui::style::Stylize;
+use ratatui::text::Line;
+
+pub(super) fn render(
+    estimates: &[Estimate],
+    timezone: FixedOffset,
+    width: u16,
+) -> Vec<Box<dyn Renderable>> {
+    let (quota, utilization) = if estimates.is_empty() {
+        ("--".to_owned(), "--".to_owned())
+    } else {
+        let cycles = estimates.len() as f64;
+        (
+            number(
+                estimates
+                    .iter()
+                    .map(|estimate| estimate.estimated_weekly_cost_usd)
+                    .sum::<f64>()
+                    / cycles,
+                2,
+                "$",
+                "",
+            ),
+            number(
+                estimates
+                    .iter()
+                    .map(|estimate| estimate.used_percent_end)
+                    .sum::<f64>()
+                    / cycles,
+                1,
+                "",
+                "%",
+            ),
+        )
+    };
+    let mut lines: Vec<Box<dyn Renderable>> = vec![
+        Line::from(format!(
+            " Average estimated quota {quota}   Average utilization {utilization}"
+        ))
+        .into(),
+    ];
+    if estimates.is_empty() {
+        lines.push(" No historical quota estimate available".dim().into());
+        return lines;
+    }
+    let mut ordered: Vec<_> = estimates.iter().collect();
+    ordered.sort_by_cached_key(|estimate| {
+        std::cmp::Reverse(
+            DateTime::parse_from_rfc3339(&estimate.started_at).expect("validated quota timestamp"),
+        )
+    });
+    let rows = ordered
+        .into_iter()
+        .map(|estimate| {
+            let started = DateTime::parse_from_rfc3339(&estimate.started_at)
+                .expect("validated quota timestamp");
+            let ended = DateTime::parse_from_rfc3339(&estimate.ended_at)
+                .expect("validated quota timestamp");
+            let seconds = (ended - started).num_seconds();
+            let status = match estimate.status {
+                Status::Completed => "completed",
+                Status::Provisional => "provisional",
+            };
+            vec![
+                Cell::number(local_date(started, timezone)),
+                Cell::number(local_date(ended, timezone)),
+                Cell::number(format!(
+                    "{}d {:02}:{:02}:{:02}",
+                    seconds / 86_400,
+                    seconds / 3_600 % 24,
+                    seconds / 60 % 60,
+                    seconds % 60,
+                )),
+                Cell::value(
+                    Some(estimate.used_percent_end),
+                    number(estimate.used_percent_end, 1, "", "%"),
+                ),
+                cost_cell(estimate.observed_cost_usd, true, false),
+                cost_cell(estimate.estimated_weekly_cost_usd, true, false),
+                Cell::text(status),
+                Cell::value(
+                    Some(estimate.sample_count as f64),
+                    count(estimate.sample_count as u64),
+                ),
+            ]
+        })
+        .collect();
+    lines.extend(numeric_table(
+        vec![
+            [
+                "Started",
+                "Ended",
+                "Duration",
+                "Used",
+                "Observed",
+                "Estimated",
+                "Status",
+                "Records",
+            ]
+            .into_iter()
+            .map(Cell::header)
+            .collect(),
+        ],
+        &[
+            (16, 16),
+            (16, 16),
+            (12, 12),
+            (6, 7),
+            (9, 12),
+            (9, 12),
+            (11, 11),
+            (7, 7),
+        ],
+        rows,
+        None,
+        width,
+    ));
+    lines
+}
+
+fn local_date(value: DateTime<FixedOffset>, timezone: FixedOffset) -> String {
+    value
+        .with_timezone(&timezone)
+        .format("%Y-%m-%d %H:%M")
+        .to_string()
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::local_usage::render::tests::report;
+    use crate::local_usage::table::intensity_style;
+    use crate::local_usage::table::tests::render_lines;
+    use itertools::Itertools;
+    use pretty_assertions::assert_eq;
+    use ratatui::style::Color;
+
+    #[test]
+    fn quota_cycles_keep_time_order_and_grayscale_with_only_two_leading_means() {
+        let report = report();
+        let lines = render_lines(
+            render(&report.quota, *report.refreshed_at.offset(), 120),
+            120,
+        );
+        let text = lines.iter().join("\n");
+        assert_eq!(
+            lines[0].to_string().trim(),
+            "Average estimated quota $533.33   Average utilization 60.0%"
+        );
+        assert!(!text.contains("last 90 days"));
+        assert!(text.contains("2026-09-30 00:30"));
+        assert!(lines[1].to_string().starts_with('┌'));
+        assert!(text.contains("Duration"));
+        assert_eq!(text.matches("$533.33").count(), 1);
+        assert!(text.contains("Status") && text.contains("Records"));
+        let rows = lines
+            .iter()
+            .filter(|line| {
+                let text = line.to_string();
+                text.starts_with('│') && text.contains('%')
+            })
+            .collect::<Vec<_>>();
+        assert_eq!(rows.len(), 3);
+        assert!(rows[0].to_string().contains("60.0%"));
+        assert!(rows[1].to_string().contains("100.0%"));
+        assert!(rows[2].to_string().contains("20.0%"));
+        for (row, expected) in rows
+            .iter()
+            .zip(["0d 16:30:00", "6d 00:00:00", "1d 00:00:00"])
+        {
+            assert_eq!(row.to_string().split('│').nth(3).unwrap().trim(), expected);
+        }
+        let colors = rows
+            .iter()
+            .flat_map(|line| &line.spans)
+            .filter(|span| span.content.trim().ends_with('%'))
+            .map(|span| span.style.fg)
+            .collect::<Vec<_>>();
+        assert_eq!(
+            colors,
+            [
+                intensity_style(8).fg,
+                intensity_style(16).fg,
+                intensity_style(1).fg
+            ]
+        );
+        assert!(
+            lines
+                .iter()
+                .flat_map(|line| &line.spans)
+                .all(|span| !matches!(span.style.fg, Some(Color::Yellow | Color::LightYellow)))
+        );
+        insta::assert_snapshot!("local_usage_quota", text);
+    }
+
+    #[test]
+    fn cycle_order_compares_instants_across_timezones() {
+        let mut report = report();
+        report.quota.truncate(2);
+        report.quota[0].started_at = "2026-09-29T01:00:00+02:00".into();
+        report.quota[0].ended_at = "2026-09-29T00:01:02Z".into();
+        report.quota[1].started_at = "2026-09-28T23:30:00Z".into();
+        let text = render_lines(
+            render(&report.quota, *report.refreshed_at.offset(), 120),
+            120,
+        )
+        .iter()
+        .join("\n");
+        assert!(text.find("60.0%").unwrap() < text.find("20.0%").unwrap());
+        assert!(text.contains("0d 01:01:02"));
+    }
+
+    #[test]
+    fn unavailable_history_keeps_both_means_unknown() {
+        let lines = render_lines(render(&[], FixedOffset::east_opt(0).unwrap(), 120), 120);
+        let text = lines.iter().join("\n");
+        assert_eq!(
+            lines[0].to_string().trim(),
+            "Average estimated quota --   Average utilization --"
+        );
+        assert!(text.contains("No historical quota estimate available"));
+        assert!(!text.contains('$') && !text.contains('%'));
+    }
+}
