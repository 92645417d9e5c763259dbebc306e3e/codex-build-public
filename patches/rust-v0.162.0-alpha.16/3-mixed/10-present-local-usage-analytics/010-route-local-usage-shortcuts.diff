diff --git a/codex-rs/tui/src/app/local_usage.rs b/codex-rs/tui/src/app/local_usage.rs
new file mode 100644
--- /dev/null
+++ b/codex-rs/tui/src/app/local_usage.rs
@@ -0,0 +1,90 @@
+//! Request the server-owned accounting snapshot and retain only the active overlay request.
+use super::App;
+use crate::app_event::AppEvent;
+use crate::local_usage::UsageRange;
+use crate::local_usage::UsageReport;
+use crate::pager_overlay::DashboardOverlay;
+use crate::pager_overlay::LocalUsageOverlay;
+use crate::pager_overlay::Overlay;
+use crate::tui;
+use crossterm::event::KeyCode;
+use crossterm::event::KeyEvent;
+use ratatui::style::Stylize;
+use std::sync::Arc;
+use uuid::Uuid;
+
+pub(super) fn local_usage_shortcut(key_event: KeyEvent) -> bool {
+    crate::key_hint::alt(KeyCode::Char('`')).is_press(key_event)
+}
+
+impl App {
+    pub(super) fn open_local_usage(
+        &mut self,
+        tui: &mut tui::Tui,
+        range: UsageRange,
+        refresh: bool,
+    ) {
+        if let Err(error) = tui.enter_alt_screen() {
+            self.chat_widget
+                .add_error_message(format!("Could not open local usage: {error}"));
+            tui.frame_requester().schedule_frame();
+            return;
+        }
+        let keymap = self.keymap.pager.clone();
+        let start_load = self.local_usage_request.is_none();
+        let request_id = self
+            .local_usage_request
+            .map(|(id, _)| id)
+            .unwrap_or_else(Uuid::new_v4);
+        self.local_usage_request = Some((request_id, range));
+        self.overlay = Some(Overlay::new_local_usage_loading(range, keymap, request_id));
+        if start_load {
+            self.app_event_tx.send(AppEvent::LoadLocalUsage {
+                request_id,
+                refresh,
+            });
+        }
+        tui.frame_requester().schedule_frame();
+    }
+
+    pub(super) fn finish_local_usage(
+        &mut self,
+        tui: &mut tui::Tui,
+        request_id: Uuid,
+        result: Result<Arc<UsageReport>, String>,
+    ) {
+        let Some((active, range)) = self.local_usage_request else {
+            return;
+        };
+        if active != request_id {
+            return;
+        }
+        self.local_usage_request = None;
+        if !self
+            .overlay
+            .as_ref()
+            .is_some_and(|overlay| overlay.accepts_usage_request(request_id) && !overlay.is_done())
+        {
+            return;
+        }
+        let width = tui.terminal.last_known_screen_size.width;
+        let keymap = self.keymap.pager.clone();
+        self.overlay = Some(match result {
+            Ok(report) => Overlay::LocalUsage(Box::new(LocalUsageOverlay::new(
+                report, range, keymap, width,
+            ))),
+            Err(error) => Overlay::Dashboard(DashboardOverlay::new(
+                vec![format!(" Local usage unavailable: {error}").gray().into()],
+                crate::local_usage::TITLE.to_owned(),
+                UsageRange::VIEWS.map(UsageRange::label).to_vec(),
+                range.index(),
+                keymap,
+            )),
+        });
+        tui.frame_requester().schedule_frame();
+    }
+}
