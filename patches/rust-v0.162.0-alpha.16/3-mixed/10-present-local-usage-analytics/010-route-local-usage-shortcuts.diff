+#[tokio::test]
+async fn stale_scan_cannot_replace_a_newer_or_closed_overlay() -> anyhow::Result<()> {
+    let mut app = crate::app::test_support::make_test_app().await;
+    let mut tui = crate::tui::test_support::make_test_tui()?;
+    let old_request = Uuid::new_v4();
+    let current_request = Uuid::new_v4();
+    app.local_usage_request = Some((current_request, UsageRange::Daily));
+    app.overlay = Some(Overlay::new_local_usage_loading(
+        UsageRange::Daily,
+        app.keymap.pager.clone(),
+        current_request,
+    ));
+    app.finish_local_usage(&mut tui, old_request, Err("stale".to_owned()));
+    assert!(
+        app.overlay
+            .as_ref()
+            .unwrap()
+            .accepts_usage_request(current_request)
+    );
+    app.finish_local_usage(&mut tui, current_request, Err("fixture error".to_owned()));
+    assert!(
+        !app.overlay
+            .as_ref()
+            .unwrap()
+            .accepts_usage_request(current_request)
+    );
+    app.overlay = None;
+    app.finish_local_usage(&mut tui, current_request, Err("late".to_owned()));
+    assert!(app.overlay.is_none());
+    Ok(())
+}
