+        }
+        for key in [
+            KeyCode::Char('q').into(),
+            KeyEvent::new(KeyCode::Char('c'), KeyModifiers::CONTROL),
+            KeyEvent::new_with_kind(KeyCode::Esc, KeyModifiers::NONE, KeyEventKind::Release),
+        ] {
+            app.overlay
+                .as_mut()
+                .unwrap()
+                .handle_event(&mut tui, crate::tui::TuiEvent::Key(key))?;
+            assert!(!app.overlay.as_ref().unwrap().is_done());
+        }
+        app.overlay
+            .as_mut()
+            .unwrap()
+            .handle_event(&mut tui, crate::tui::TuiEvent::Key(KeyCode::Esc.into()))?;
+        assert!(app.overlay.as_ref().unwrap().is_done());
+        app.overlay = None;
+    }
+    Ok(())
+}
+
+#[tokio::test]
+async fn closed_report_stays_closed_and_reopening_reuses_only_the_pending_request()
+-> anyhow::Result<()> {
+    let (mut app, mut events, _ops) = crate::app::tests::make_test_app_with_channels().await;
+    let mut tui = crate::tui::test_support::make_test_tui()?;
+    let request_id = Uuid::new_v4();
+    app.local_usage_request = Some((request_id, UsageRange::Daily));
+    let report = Arc::new(crate::local_usage::test_report());
+    app.finish_local_usage(&mut tui, request_id, Ok(report));
+    assert!(app.overlay.is_none());
+    assert!(app.local_usage_request.is_none());
+    app.open_local_usage(&mut tui, UsageRange::Daily, false);
+    let current = app.local_usage_request.unwrap().0;
+    // Reopening during the request keeps its owner and chooses the latest requested view.
+    app.open_local_usage(&mut tui, UsageRange::Monthly, false);
+    assert_eq!(
+        app.local_usage_request,
+        Some((current, UsageRange::Monthly))
+    );
+    let requests = std::iter::from_fn(|| events.try_recv().ok())
+        .filter_map(|event| match event {
+            AppEvent::LoadLocalUsage {
+                request_id,
+                refresh,
+            } => Some((request_id, refresh)),
+            _ => None,
+        })
+        .collect::<Vec<_>>();
+    assert_eq!(requests, vec![(current, false)]);
+    app.finish_local_usage(
+        &mut tui,
+        current,
+        Ok(Arc::new(crate::local_usage::test_report())),
+    );
+    assert!(app.local_usage_request.is_none());
+    assert!(
+        matches!(&app.overlay, Some(Overlay::LocalUsage(overlay)) if overlay.range == UsageRange::Monthly)
+    );
+    Ok(())
+}
