+#[tokio::test]
+async fn shortcut_requests_shared_reports_and_delivers_success_or_error_through_app_events()
+-> crate::app::Result<()> {
+    use chrono::Utc;
+    use ratatui::buffer::Buffer;
+    use ratatui::layout::Rect;
+    use std::time::Duration;
+
+    for invalid_prices in [false, true] {
+        let (mut app, mut events, mut ops) = crate::app::tests::make_test_app_with_channels().await;
+        let codex_home = app.config.codex_home.clone();
+        let home = codex_home.as_path();
+        let sessions = home.join("sessions");
+        std::fs::create_dir_all(&sessions)?;
+        let timestamp = Utc::now().to_rfc3339();
+        let records = [
+            serde_json::json!({
+                "timestamp": timestamp,
+                "type": "session_meta",
+                "payload": {"id": "usage-shortcut-fixture", "history_mode": "paginated"}
+            }),
+            serde_json::json!({
+                "timestamp": timestamp,
+                "type": "turn_context",
+                "payload": {"model": "local-accounting-model", "effort": "high"}
+            }),
+            serde_json::json!({
+                "timestamp": timestamp,
+                "type": "event_msg",
+                "payload": {
+                    "type": "token_count",
+                    "info": {"total_token_usage": {
+                        "input_tokens": 100, "output_tokens": 50, "total_tokens": 150
+                    }}
+                }
+            }),
+        ];
+        let mut jsonl = String::new();
+        for record in records {
+            jsonl.push_str(&serde_json::to_string(&record)?);
+            jsonl.push('\n');
+        }
+        std::fs::write(sessions.join("local-usage.jsonl"), jsonl)?;
+        if invalid_prices {
+            std::fs::write(home.join("models.json"), "not JSON")?;
+        }
+
+        let mut tui = crate::tui::test_support::make_test_tui()?;
+        let mut server = crate::start_embedded_app_server_for_picker(&app.config).await?;
+        app.handle_tui_event(
+            &mut tui,
+            &mut server,
+            crate::tui::TuiEvent::Key(KeyEvent::new(KeyCode::Char('`'), KeyModifiers::ALT)),
+        )
+        .await?;
+        assert!(matches!(app.overlay, Some(Overlay::Dashboard(_))));
+        // Deliver the server result through the native dispatcher, not a direct finish call.
+        let event = tokio::time::timeout(Duration::from_secs(10), async {
+            loop {
+                let event = events.recv().await.expect("app event channel");
+                if matches!(event, AppEvent::LocalUsageLoaded { .. }) {
+                    return Ok::<_, color_eyre::Report>(event);
+                }
+                app.handle_event(&mut tui, &mut server, event).await?;
+            }
+        })
+        .await??;
+        let AppEvent::LocalUsageLoaded { request_id, result } = &event else {
+            unreachable!();
+        };
+        let refreshed_at = result.as_ref().ok().map(|report| report.refreshed_at);
+        assert_eq!(result.is_err(), invalid_prices);
+        assert!(
+            app.overlay
+                .as_ref()
+                .unwrap()
+                .accepts_usage_request(*request_id)
+        );
+        app.handle_event(&mut tui, &mut server, event).await?;
+        assert!(ops.try_recv().is_err());
+        let area = Rect::new(0, 0, 200, 32);
+        let mut buffer = Buffer::empty(area);
+        match app.overlay.as_mut() {
+            Some(Overlay::Dashboard(overlay)) if invalid_prices => {
+                overlay.render(area, &mut buffer, None, &[])
+            }
+            Some(Overlay::LocalUsage(overlay)) if !invalid_prices => {
+                overlay.render(area, &mut buffer)
+            }
+            _ => panic!("local usage must keep the report or display its load error"),
+        }
+        let text = buffer
+            .content
+            .iter()
+            .map(|cell| cell.symbol())
+            .collect::<String>();
+        if invalid_prices {
+            assert!(text.contains("Local usage unavailable:"), "{text}");
+        } else {
+            assert!(text.contains("Peak 150 tokens"), "{text}");
+            assert!(!text.contains("Estimated cost"), "{text}");
+            assert!(text.contains("local-accounting-model"), "{text}");
+            assert!(!text.contains("Unpriced:"), "{text}");
+            assert!(text.contains("updated ") && text.contains("age "), "{text}");
+            let catalog: serde_json::Value =
+                serde_json::from_str(&std::fs::read_to_string(home.join("models.json"))?)?;
+            assert!(catalog["prices"].get("local-accounting-model").is_some());
+            assert!(
+                catalog["models"]
+                    .as_array()
+                    .unwrap()
+                    .iter()
+                    .all(|model| { model["slug"] != "local-accounting-model" })
+            );
+            std::fs::write(home.join("models.json"), "not JSON")?;
+            for _ in 0..2 {
+                app.handle_tui_event(
+                    &mut tui,
+                    &mut server,
+                    crate::tui::TuiEvent::Key(KeyCode::Esc.into()),
+                )
+                .await?;
+                assert!(app.overlay.is_none());
+                app.handle_tui_event(
+                    &mut tui,
+                    &mut server,
+                    crate::tui::TuiEvent::Key(KeyEvent::new(KeyCode::Char('`'), KeyModifiers::ALT)),
+                )
+                .await?;
+                assert!(matches!(app.overlay, Some(Overlay::Dashboard(_))));
+                let event = tokio::time::timeout(Duration::from_secs(10), async {
+                    loop {
+                        let event = events.recv().await.expect("app event channel");
+                        if let AppEvent::LocalUsageLoaded { result, .. } = &event {
+                            assert_eq!(
+                                Some(
+                                    result
+                                        .as_ref()
+                                        .expect("server cache survives invalid files")
+                                        .refreshed_at
+                                ),
+                                refreshed_at
+                            );
+                            return Ok::<_, color_eyre::Report>(event);
+                        }
+                        app.handle_event(&mut tui, &mut server, event).await?;
+                    }
+                })
+                .await??;
+                app.handle_event(&mut tui, &mut server, event).await?;
+                assert!(matches!(app.overlay, Some(Overlay::LocalUsage(_))));
+                assert!(app.local_usage_request.is_none());
+            }
+            app.handle_tui_event(
+                &mut tui,
+                &mut server,
+                crate::tui::TuiEvent::Key(KeyCode::Tab.into()),
+            )
+            .await?;
+            assert!(
+                matches!(&app.overlay, Some(Overlay::LocalUsage(overlay)) if overlay.range == UsageRange::Today)
+            );
+            app.handle_tui_event(
+                &mut tui,
+                &mut server,
+                crate::tui::TuiEvent::Key(KeyCode::Char('r').into()),
+            )
+            .await?;
+            assert!(app.local_usage_request.is_some());
+            assert!(matches!(app.overlay, Some(Overlay::Dashboard(_))));
+            let event = tokio::time::timeout(Duration::from_secs(10), async {
+                loop {
+                    let event = events.recv().await.expect("app event channel");
+                    if matches!(event, AppEvent::LocalUsageLoaded { .. }) {
+                        return Ok::<_, color_eyre::Report>(event);
+                    }
+                    app.handle_event(&mut tui, &mut server, event).await?;
+                }
+            })
+            .await??;
+            assert!(matches!(
+                &event,
+                AppEvent::LocalUsageLoaded { result: Err(_), .. }
+            ));
+            app.handle_event(&mut tui, &mut server, event).await?;
+            let Some(Overlay::Dashboard(overlay)) = &mut app.overlay else {
+                panic!("show refresh error")
+            };
+            overlay.render(area, &mut buffer, None, &[]);
+            let text = buffer
+                .content
+                .iter()
+                .map(|cell| cell.symbol())
+                .collect::<String>();
+            assert!(text.contains("Local usage unavailable:"), "{text}");
+        }
+        server.shutdown().await?;
+    }
+    Ok(())
+}
