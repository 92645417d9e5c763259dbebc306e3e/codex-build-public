+    #[tokio::test]
+    async fn every_report_exits_with_escape_and_ignores_key_release() -> Result<()> {
+        let mut tui = crate::tui::test_support::make_test_tui()?;
+        let mut report = crate::local_usage::test_report();
+        report.rows.clear();
+        report.quota.clear();
+        let report = Arc::new(report);
+        for range in [
+            UsageRange::Today,
+            UsageRange::Yesterday,
+            UsageRange::Daily,
+            UsageRange::Weekly,
+            UsageRange::Monthly,
+            UsageRange::Yearly,
+            UsageRange::Quota,
+            UsageRange::Heatmap,
+        ] {
+            let mut overlay = LocalUsageOverlay::new(
+                report.clone(),
+                range,
+                crate::keymap::RuntimeKeymap::defaults().pager,
+                120,
+            );
+            for key in [
+                KeyEvent::new_with_kind(KeyCode::Esc, KeyModifiers::NONE, KeyEventKind::Release),
+                KeyCode::Char('q').into(),
+                KeyEvent::new(KeyCode::Char('c'), KeyModifiers::CONTROL),
+            ] {
+                overlay.handle_event(&mut tui, TuiEvent::Key(key))?;
+                assert!(!overlay.is_done());
+            }
+            for key in [
+                KeyCode::Enter,
+                KeyCode::Char('w'),
+                KeyCode::Char('a'),
+                KeyCode::Char('s'),
+                KeyCode::Char('d'),
+            ] {
+                assert_eq!(overlay.handle_key(key.into()), range == UsageRange::Heatmap);
+                assert!(overlay.selected_day.is_none());
+            }
+            assert!(overlay.handle_key(KeyCode::Esc.into()));
+            assert!(overlay.is_done());
+        }
+        Ok(())
+    }
