@@ -0,0 +1,121 @@
+//! Local usage reports retain one fullscreen tab strip and native pager navigation.
+
+use super::PagerView;
+use crate::bottom_pane::render_filled_tab_bar;
+use crate::key_hint;
+use crate::keymap::PagerKeymap;
+use crate::line_truncation::truncate_line_with_ellipsis_if_overflow;
+use crate::render::renderable::Renderable;
+use crate::style::footer_hint_label_style;
+use crate::tui;
+use crate::tui::TuiEvent;
+use crossterm::event::KeyCode;
+use ratatui::buffer::Buffer;
+use ratatui::layout::Constraint;
+use ratatui::layout::Layout;
+use ratatui::layout::Margin;
+use ratatui::layout::Rect;
+use ratatui::style::Stylize;
+use ratatui::text::Line;
+use ratatui::text::Span;
+use ratatui::widgets::Clear;
+use ratatui::widgets::Widget;
+use std::io::Result;
+use uuid::Uuid;
+
+pub(crate) struct DashboardOverlay {
+    pub(super) view: PagerView,
+    pub(super) tabs: Vec<&'static str>,
+    pub(super) selected: usize,
+    pub(super) is_done: bool,
+    pub(super) request_id: Option<Uuid>,
+    pub(super) status: Option<Span<'static>>,
+}
+
+impl DashboardOverlay {
+    pub(crate) fn new(
+        renderables: Vec<Box<dyn Renderable>>,
+        title: String,
+        tabs: Vec<&'static str>,
+        selected: usize,
+        keymap: PagerKeymap,
+    ) -> Self {
+        Self {
+            view: PagerView::new(renderables, title, 0, keymap),
+            tabs,
+            selected,
+            is_done: false,
+            request_id: None,
+            status: None,
+        }
+    }
+
+    pub(crate) fn render(
+        &mut self,
+        area: Rect,
+        buf: &mut Buffer,
+        detail: Option<Span<'static>>,
+        hints: &[(&str, &str)],
+    ) {
+        Clear.render(area, buf);
+        let inner = area.inner(Margin::new(2, 0));
+        let [heading, tabs, rule, body, footer] = Layout::vertical([
+            Constraint::Length(1),
+            Constraint::Length(1),
+            Constraint::Length(1),
+            Constraint::Min(0),
+            Constraint::Length(1),
+        ])
+        .areas(inner);
+        let mut title = vec![self.view.title.clone().bold()];
+        title.extend(detail.or_else(|| self.status.clone()));
+        truncate_line_with_ellipsis_if_overflow(title.into(), usize::from(heading.width))
+            .render(heading, buf);
+        render_filled_tab_bar(&self.tabs, self.selected, tabs, buf);
+        Line::from("─".repeat(usize::from(rule.width)))
+            .dim()
+            .render(rule, buf);
+        // Overlap the two frame rows so page navigation never skips covered content.
+        self.view
+            .update_last_content_height(body.height.saturating_sub(2).max(1));
+        self.view.scroll_offset = self.view.scroll_offset.min(
+            self.view
+                .content_height(body.width)
+                .saturating_sub(usize::from(body.height)),
+        );
+        self.view.render_content(body, buf);
+        let mut line = Line::default();
+        for (key, description) in std::iter::once(("esc", "back")).chain(hints.iter().copied()) {
+            if !line.spans.is_empty() {
+                line.spans.push("  ".dim());
+            }
+            line.spans.extend(key_hint::key_label_spans(key));
+            line.spans.push(Span::styled(
+                format!(" {description}"),
+                footer_hint_label_style().not_bold(),
+            ));
+        }
+        truncate_line_with_ellipsis_if_overflow(line, usize::from(footer.width))
+            .render(footer, buf);
+    }
+
+    pub(super) fn handle_event(&mut self, tui: &mut tui::Tui, event: TuiEvent) -> Result<()> {
+        match event {
+            TuiEvent::Key(key) if key_hint::plain(KeyCode::Esc).is_press(key) => {
+                self.is_done = true
+            }
+            TuiEvent::Key(key) => self.view.handle_key_event(tui, key)?,
+            TuiEvent::Draw | TuiEvent::Resume | TuiEvent::Resize(_) | TuiEvent::FocusGained => {
+                tui.draw(u16::MAX, |frame| {
+                    self.render(frame.area(), frame.buffer, None, &[])
+                })?;
+            }
+            _ => {}
+        }
+        Ok(())
+    }
+
+    pub(super) fn is_done(&self) -> bool {
+        self.is_done
+    }
+}
