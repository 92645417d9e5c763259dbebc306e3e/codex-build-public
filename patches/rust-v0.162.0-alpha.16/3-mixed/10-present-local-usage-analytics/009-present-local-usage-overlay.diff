+        assert!(Arc::ptr_eq(&overlay.report, &report));
+        assert!(overlay.handle_key(KeyEvent::new(KeyCode::BackTab, KeyModifiers::SHIFT)));
+        assert_eq!(overlay.range, UsageRange::Heatmap);
+        assert!(overlay.handle_key(KeyCode::Char('w').into()));
+        assert!(overlay.selected_day.is_some());
+        assert!(overlay.handle_key(KeyCode::Esc.into()));
+        assert!(overlay.selected_day.is_none());
+        assert!(!overlay.is_done());
+        assert!(overlay.handle_key(KeyCode::Esc.into()));
+        assert!(overlay.is_done());
+        Ok(())
+    }
