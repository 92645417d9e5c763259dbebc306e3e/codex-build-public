+    #[tokio::test]
+    async fn constrained_pages_keep_every_usage_row_reachable_and_close_after_content() -> Result<()>
+    {
+        let mut tui = crate::tui::test_support::make_test_tui()?;
+        let mut report = crate::local_usage::test_report();
+        let usage = report.rows["2026-09-28"]["gpt-5.4"].clone();
+        let dates = (1..=8)
+            .map(|day| format!("2026-09-{day:02}"))
+            .collect::<Vec<_>>();
+        report.rows = dates
+            .iter()
+            .map(|day| {
+                (
+                    day.clone(),
+                    std::collections::BTreeMap::from([("gpt-5.4".into(), usage.clone())]),
+                )
+            })
+            .collect();
+        let report = Arc::new(report);
+        for body_height in 3..=10 {
+            let area = Rect::new(4, 3, 204, body_height + 4);
+            let mut buffer = Buffer::empty(Rect::new(0, 0, 220, 24));
+            let mut overlay = LocalUsageOverlay::new(
+                Arc::clone(&report),
+                UsageRange::Daily,
+                crate::keymap::RuntimeKeymap::defaults().pager,
+                area.width,
+            );
+            let mut seen = std::collections::BTreeSet::new();
+            let mut previous_offset = None;
+            for _ in 0..100 {
+                overlay.render(area, &mut buffer);
+                for y in area.y + 3..area.bottom() - 1 {
+                    let line = (area.x..area.right())
+                        .map(|x| buffer[(x, y)].symbol())
+                        .collect::<String>();
+                    for day in &dates {
+                        if line.contains(day) {
+                            seen.insert(day.clone());
+                        }
+                    }
+                    if line.trim().starts_with('└') && y > area.y + 3 {
+                        let above = (area.x..area.right())
+                            .map(|x| buffer[(x, y - 1)].symbol())
+                            .collect::<String>();
+                        assert!(
+                            !above.contains('─') || above.trim().starts_with('┌'),
+                            "{above}\n{line}"
+                        );
+                    }
+                }
+                if previous_offset == Some(overlay.pager.view.scroll_offset) {
+                    break;
+                }
+                previous_offset = Some(overlay.pager.view.scroll_offset);
+                overlay.handle_event(&mut tui, TuiEvent::Key(KeyCode::PageDown.into()))?;
+            }
+            assert_eq!(
+                seen,
+                dates.iter().cloned().collect(),
+                "body height {body_height}"
+            );
+            overlay.handle_event(&mut tui, TuiEvent::Key(KeyCode::Home.into()))?;
+            overlay.render(area, &mut buffer);
+            assert_eq!(overlay.pager.view.scroll_offset, 0);
+        }
+        Ok(())
+    }
