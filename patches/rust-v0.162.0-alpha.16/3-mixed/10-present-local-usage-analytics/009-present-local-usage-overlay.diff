+    #[test]
+    fn usage_dashboard_closes_tables_at_both_viewport_edges() {
+        let report = Arc::new(crate::local_usage::test_report());
+        // Six body rows cut the seven-row table before its natural bottom border.
+        let area = Rect::new(4, 3, 204, 10);
+        let mut overlay = LocalUsageOverlay::new(
+            report,
+            UsageRange::Daily,
+            crate::keymap::RuntimeKeymap::defaults().pager,
+            area.width,
+        );
+        let mut buffer = Buffer::empty(Rect::new(0, 0, 220, 20));
+        let row = |buffer: &Buffer, y| {
+            (area.x..area.right())
+                .map(|x| buffer[(x, y)].symbol())
+                .collect::<String>()
+        };
+        overlay.render(area, &mut buffer);
+        let bottom = row(&buffer, area.bottom() - 3);
+        assert!(
+            bottom.trim().starts_with('└') && bottom.trim().ends_with('┘'),
+            "{bottom}"
+        );
+        assert!(row(&buffer, area.bottom() - 2).trim().is_empty());
+        overlay.pager.view.scroll_offset = 3;
+        overlay.render(area, &mut buffer);
+        let top = row(&buffer, area.y + 3);
+        assert!(
+            top.trim().starts_with('┌') && top.trim().ends_with('┐'),
+            "{top}"
+        );
+        assert!(row(&buffer, area.bottom() - 1).contains("esc back"));
+        assert!(row(&buffer, area.y).contains("Local usage"));
+    }
