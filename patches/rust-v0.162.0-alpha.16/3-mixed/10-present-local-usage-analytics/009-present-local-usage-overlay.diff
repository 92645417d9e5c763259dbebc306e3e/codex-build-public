+    #[test]
+    fn dashboard_keeps_snapshot_age_and_moves_day_controls_with_heatmap_tab() {
+        let mut report = crate::local_usage::test_report();
+        report.rows.clear();
+        report.quota.clear();
+        report.refreshed_at = Local::now().fixed_offset() - Duration::seconds(90_123);
+        let timestamp = report.refreshed_at.format("%Y-%m-%d %H:%M:%S").to_string();
+        let mut overlay = LocalUsageOverlay::new(
+            Arc::new(report),
+            UsageRange::Heatmap,
+            crate::keymap::RuntimeKeymap::defaults().pager,
+            120,
+        );
+        let area = Rect::new(0, 0, 120, 24);
+        let mut buffer = Buffer::empty(area);
+        overlay.render(area, &mut buffer);
+        let row_text = |buffer: &Buffer, row| {
+            (0..120)
+                .map(|column| buffer[(column, row)].symbol())
+                .collect::<String>()
+        };
+        let title = row_text(&buffer, 0);
+        assert!(title.contains(&timestamp), "{title}");
+        assert!(title.starts_with("  Local usage analytics"), "{title}");
+        assert!(title.contains(" age 1d1h2m"), "{title}");
+        assert!(!title.contains('|'), "{title}");
+        let footer = row_text(&buffer, 23);
+        assert!(footer.contains("esc back") && footer.contains("a/w/s/d select day"));
+        let key_column = footer.find("a/w/s/d").unwrap() as u16;
+        assert!(
+            buffer[(key_column, 23)]
+                .modifier
+                .contains(ratatui::style::Modifier::BOLD)
+        );
+        assert!(
+            !buffer[(key_column + 8, 23)]
+                .modifier
+                .contains(ratatui::style::Modifier::BOLD)
+        );
+        for row in 0..23 {
+            assert!(!row_text(&buffer, row).contains("select day"));
+        }
+        assert!(overlay.handle_key(KeyCode::Tab.into()));
+        overlay.render(area, &mut buffer);
+        assert!(row_text(&buffer, 0).contains(&timestamp));
+        assert!(!row_text(&buffer, 23).contains("a/w/s/d"));
+    }
