+use super::*;
+use pretty_assertions::assert_eq;
+
+const BASE: i64 = 1_790_000_000_000;
+
+fn sample(seconds: i64, percent: f64, reset: i64) -> Observation {
+    let millis = BASE + seconds * 1_000;
+    Observation {
+        timestamp: chrono::DateTime::from_timestamp_millis(millis)
+            .unwrap()
+            .to_rfc3339(),
+        millis,
+        used_percent: percent,
+        resets_at: reset,
+    }
+}
+
+fn costs(entries: &[(i64, f64)]) -> BTreeMap<i64, f64> {
+    entries
+        .iter()
+        .map(|(seconds, cost)| (BASE + seconds * 1_000, *cost))
+        .collect()
+}
+
+#[test]
+fn reset_closes_previous_cycle_and_keeps_current_provisional() {
+    let mut observations = vec![
+        sample(
+            /*seconds*/ 0, /*percent*/ 0.0, /*reset*/ 10_000,
+        ),
+        sample(
+            /*seconds*/ 600, /*percent*/ 100.0, /*reset*/ 10_000,
+        ),
+        sample(
+            /*seconds*/ 700, /*percent*/ 0.0, /*reset*/ 20_000,
+        ),
+        sample(
+            /*seconds*/ 800, /*percent*/ 50.0, /*reset*/ 20_000,
+        ),
+    ];
+    let estimates = estimate(
+        &costs(&[(0, 99.0), (600, 100.0), (700, 99.0), (800, 50.0)]),
+        &mut observations,
+        BASE + 900_000,
+    );
+    assert_eq!(estimates.len(), 2);
+    assert_eq!(estimates[0].status, Status::Completed);
+    assert_eq!(estimates[1].status, Status::Provisional);
+    // The sample at the cycle start is excluded, not charged twice.
+    assert_eq!(estimates[0].observed_cost_usd, 100.0);
+    assert_eq!(estimates[1].observed_cost_usd, 50.0);
+    assert_eq!(estimates[1].estimated_weekly_cost_usd, 100.0);
+}
+
+#[test]
+fn stale_reset_horizon_freezes_until_a_real_new_cycle() {
+    let mut observations = vec![
+        sample(
+            /*seconds*/ 0, /*percent*/ 0.0, /*reset*/ 10_000,
+        ),
+        sample(
+            /*seconds*/ 600, /*percent*/ 20.0, /*reset*/ 10_000,
+        ),
+        sample(
+            /*seconds*/ 700, /*percent*/ 40.0, /*reset*/ 9_000,
+        ),
+        sample(
+            /*seconds*/ 800, /*percent*/ 70.0, /*reset*/ 10_000,
+        ),
+        sample(
+            /*seconds*/ 900, /*percent*/ 0.0, /*reset*/ 20_000,
+        ),
+        sample(
+            /*seconds*/ 1000, /*percent*/ 50.0, /*reset*/ 20_000,
+        ),
+    ];
+    let estimates = estimate(
+        &costs(&[(600, 20.0), (700, 30.0), (800, 50.0), (1000, 50.0)]),
+        &mut observations,
+        BASE + 1_100_000,
+    );
+    assert_eq!(estimates.len(), 2);
+    assert_eq!(estimates[0].used_percent_end, 20.0);
+    assert_eq!(estimates[0].observed_cost_usd, 20.0);
+    assert_eq!(estimates[0].sample_count, 2);
+}
+
+#[test]
+fn percentage_rollback_without_horizon_change_is_ignored() {
+    let mut observations = vec![
+        sample(
+            /*seconds*/ 0, /*percent*/ 0.0, /*reset*/ 10_000,
+        ),
+        sample(
+            /*seconds*/ 600, /*percent*/ 20.0, /*reset*/ 10_000,
+        ),
+        sample(
+            /*seconds*/ 700, /*percent*/ 5.0, /*reset*/ 10_000,
+        ),
+        sample(
+            /*seconds*/ 800, /*percent*/ 40.0, /*reset*/ 10_000,
+        ),
+    ];
+    let estimates = estimate(
+        &costs(&[(600, 20.0), (700, 10.0), (800, 10.0)]),
+        &mut observations,
+        BASE + 900_000,
+    );
+    assert_eq!(estimates.len(), 1);
+    assert_eq!(estimates[0].used_percent_end, 40.0);
+    assert_eq!(estimates[0].sample_count, 3);
+    assert_eq!(estimates[0].estimated_weekly_cost_usd, 100.0);
+}
+
+#[test]
+fn conflicting_instant_is_rejected_but_duplicate_observation_is_one_sample() {
+    let mut observations = vec![
+        sample(
+            /*seconds*/ 0, /*percent*/ 0.0, /*reset*/ 10_000,
+        ),
+        sample(
+            /*seconds*/ 600, /*percent*/ 10.0, /*reset*/ 10_000,
+        ),
+        sample(
+            /*seconds*/ 600, /*percent*/ 20.0, /*reset*/ 10_000,
+        ),
+        sample(
+            /*seconds*/ 800, /*percent*/ 40.0, /*reset*/ 10_000,
+        ),
+        sample(
+            /*seconds*/ 800, /*percent*/ 40.0, /*reset*/ 10_000,
+        ),
+    ];
+    let estimates = estimate(&costs(&[(800, 40.0)]), &mut observations, BASE + 900_000);
+    assert_eq!(estimates.len(), 1);
+    assert_eq!(estimates[0].sample_count, 2);
+    assert_eq!(estimates[0].estimated_weekly_cost_usd, 100.0);
+}
+
+#[test]
+fn late_previous_horizon_at_reset_handoff_does_not_freeze_new_cycle() {
+    let mut observations = vec![
+        sample(
+            /*seconds*/ 0, /*percent*/ 0.0, /*reset*/ 20_000,
+        ),
+        sample(
+            /*seconds*/ 60, /*percent*/ 100.0, /*reset*/ 10_000,
+        ),
+        sample(
+            /*seconds*/ 600, /*percent*/ 50.0, /*reset*/ 20_000,
+        ),
+    ];
+    let estimates = estimate(&costs(&[(600, 50.0)]), &mut observations, BASE + 900_000);
+    assert_eq!(estimates.len(), 1);
+    assert_eq!(estimates[0].used_percent_end, 50.0);
+    assert_eq!(estimates[0].sample_count, 2);
+}
+
+#[test]
+fn requires_more_than_five_points_and_uses_only_recent_nonfuture_samples() {
+    let mut observations = vec![
+        sample(
+            /*seconds*/ -91 * 86400,
+            /*percent*/ 0.0,
+            /*reset*/ 10_000,
+        ),
+        sample(
+            /*seconds*/ 0, /*percent*/ 20.0, /*reset*/ 20_000,
+        ),
+        sample(
+            /*seconds*/ 600, /*percent*/ 25.0, /*reset*/ 20_000,
+        ),
+        sample(
+            /*seconds*/ 1000, /*percent*/ 100.0, /*reset*/ 20_000,
+        ),
+    ];
+    let timeline = costs(&[(-91 * 86400, 1_000_000.0), (600, 10.0)]);
+    assert!(estimate(&timeline, &mut observations, BASE + 900_000).is_empty());
+    observations.push(sample(
+        /*seconds*/ 700, /*percent*/ 26.0, /*reset*/ 20_000,
+    ));
+    let estimates = estimate(&timeline, &mut observations, BASE + 900_000);
+    assert_eq!(estimates.len(), 1);
+    assert_eq!(estimates[0].used_percent_start, 20.0);
+    assert_eq!(estimates[0].used_percent_end, 26.0);
+    assert_eq!(estimates[0].observed_cost_usd, 10.0);
+}
