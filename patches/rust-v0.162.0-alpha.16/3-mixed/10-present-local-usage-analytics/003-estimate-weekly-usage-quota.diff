+#[test]
+fn weekly_quota_uses_priced_canonical_snapshots_without_counting_repeated_delivery() {
+    let directory = tempfile::tempdir().unwrap();
+    let reset = DateTime::parse_from_rfc3339("2026-02-08T00:00:00Z")
+        .unwrap()
+        .timestamp();
+    let mut events = Vec::new();
+    for (at, input, total, percent) in [
+        ("2026-02-01T00:00:00Z", 100, 100, 20.0),
+        ("2026-02-01T00:10:00Z", 100_000, 100_100, 40.0),
+    ] {
+        let mut event = count(at, usage(input, 0), usage(total, 0));
+        event["payload"]["rate_limits"] = json!({"primary":{
+            "used_percent":percent,"window_minutes":10080,"resets_at":reset
+        }});
+        events.push(event);
+    }
+    events.push(events[1].clone());
+    write_rollout(
+        directory.path(),
+        "sessions/quota.jsonl",
+        "quota",
+        None,
+        &events,
+    );
+    let report = report(directory.path());
+    assert_eq!(report.quota.len(), 1);
+    let cycle = &report.quota[0];
+    assert_eq!(cycle.sample_count, 2);
+    assert_eq!(cycle.status, quota::Status::Provisional);
+    assert!((cycle.observed_cost_usd - 0.2).abs() < 1e-12);
+    assert!((cycle.estimated_weekly_cost_usd - 1.0).abs() < 1e-12);
+    let now = DateTime::parse_from_rfc3339("2026-02-01T04:00:00Z")
+        .unwrap()
+        .timestamp_millis();
+    let unpriced = load(directory.path(), Prices::new(), report.timezone, now).unwrap();
+    assert!(unpriced.quota.is_empty());
+    assert!(unpriced.missing_prices.contains("gpt-5.4"));
+    assert_eq!(unpriced.rows["2026-02-01"]["gpt-5.4"].tokens.total, 100_100);
+}
