+use std::collections::BTreeMap;
+
+use super::types::Observation;
+
+pub(super) const RECENT_DAYS: i64 = 90;
+
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub(super) enum Status {
+    Completed,
+    Provisional,
+}
+
+#[derive(Clone, Debug)]
+pub(super) struct Estimate {
+    pub(super) started_at: String,
+    pub(super) ended_at: String,
+    pub(super) used_percent_start: f64,
+    pub(super) used_percent_end: f64,
+    pub(super) observed_cost_usd: f64,
+    pub(super) estimated_weekly_cost_usd: f64,
+    pub(super) sample_count: usize,
+    pub(super) status: Status,
+}
+
+struct Episode<'a> {
+    start: &'a Observation,
+    end: &'a Observation,
+    reset_horizon: i64,
+    count: usize,
+    frozen: bool,
+}
+
+impl<'a> Episode<'a> {
+    fn new(observation: &'a Observation) -> Self {
+        Self {
+            start: observation,
+            end: observation,
+            reset_horizon: observation.resets_at,
+            count: 1,
+            frozen: false,
+        }
+    }
+
+    fn estimate(&self, costs: &BTreeMap<i64, f64>, status: Status) -> Option<Estimate> {
+        let span = self.end.used_percent - self.start.used_percent;
+        // Small spans amplify rounding noise. Preserve the local usage threshold.
+        if span <= 5.0 {
+            return None;
+        }
+        let observed: f64 = costs
+            .range((self.start.millis + 1)..=self.end.millis)
+            .map(|(_, cost)| cost)
+            .sum();
+        if observed <= 0.0 {
+            return None;
+        }
+        Some(Estimate {
+            started_at: self.start.timestamp.clone(),
+            ended_at: self.end.timestamp.clone(),
+            used_percent_start: self.start.used_percent,
+            used_percent_end: self.end.used_percent,
+            observed_cost_usd: observed,
+            estimated_weekly_cost_usd: observed * 100.0 / span,
+            sample_count: self.count,
+            status,
+        })
+    }
+}
+
+pub(super) fn estimate(
+    costs: &BTreeMap<i64, f64>,
+    observations: &mut Vec<Observation>,
+    now: i64,
+) -> Vec<Estimate> {
+    let since = now.saturating_sub(RECENT_DAYS * 24 * 60 * 60 * 1_000);
+    observations.retain(|sample| {
+        sample.millis >= since
+            && sample.millis <= now
+            && (0.0..=100.0).contains(&sample.used_percent)
+    });
+    observations.sort_by(|left, right| {
+        left.millis
+            .cmp(&right.millis)
+            .then_with(|| left.used_percent.total_cmp(&right.used_percent))
+            .then_with(|| left.resets_at.cmp(&right.resets_at))
+    });
+    observations.dedup_by(|left, right| {
+        left.millis == right.millis
+            && left.used_percent == right.used_percent
+            && left.resets_at == right.resets_at
+    });
+    let mut estimates = Vec::new();
+    let mut episode: Option<Episode<'_>> = None;
+    let mut index = 0;
+    while index < observations.len() {
+        let sample = &observations[index];
+        let mut end = index + 1;
+        while end < observations.len() && observations[end].millis == sample.millis {
+            end += 1;
+        }
+        let conflicting = end != index + 1;
+        index = end;
+        if conflicting {
+            continue;
+        }
+        let Some(current) = episode.as_mut() else {
+            episode = Some(Episode::new(sample));
+            continue;
+        };
+        let advanced = sample.resets_at > current.reset_horizon.saturating_add(300);
+        let dropped = sample.used_percent + 0.5 < current.end.used_percent;
+        if advanced && (dropped || current.frozen) {
+            if let Some(estimate) = current.estimate(costs, Status::Completed) {
+                estimates.push(estimate);
+            }
+            episode = Some(Episode::new(sample));
+            continue;
+        }
+        if current.frozen {
+            continue;
+        }
+        if sample.resets_at < current.reset_horizon.saturating_sub(300) {
+            let handoff = sample.millis.saturating_sub(current.start.millis) <= 300_000
+                && current.end.used_percent <= current.start.used_percent + 0.5;
+            if !handoff {
+                current.frozen = true;
+            }
+            continue;
+        }
+        if dropped {
+            continue;
+        }
+        current.reset_horizon = current.reset_horizon.max(sample.resets_at);
+        current.end = sample;
+        current.count += 1;
+    }
+    if let Some(episode) = episode
+        && let Some(estimate) = episode.estimate(costs, Status::Provisional)
+    {
+        estimates.push(estimate);
+    }
+    estimates
+}
