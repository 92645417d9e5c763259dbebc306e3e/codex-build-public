+#[test]
+fn zero_pricing_is_visible_without_inventing_a_price() {
+    let mut report = report();
+    report.missing_prices.insert("unpriced-model".to_owned());
+    let models = report.rows.get_mut("2026-09-28").unwrap();
+    let usage = models.remove("gpt-5.4").unwrap();
+    models.insert("unpriced-model".into(), usage);
+    let text = render(&report, UsageRange::Daily, 140).iter().join("\n");
+    let model = text
+        .lines()
+        .find(|line| line.contains("unpriced-model"))
+        .unwrap();
+    assert!(model.contains("--") && !model.contains('$'));
+    assert!(
+        !text
+            .split("Prices - USD per 1M tokens")
+            .nth(1)
+            .unwrap()
+            .contains("Write")
+    );
+}
