+#[test]
+fn context_costs_share_their_token_groups_and_headers_are_merged() {
+    let lines = render(&report(), UsageRange::Daily, /*width*/ 200);
+    let text = lines.iter().join("\n");
+    let record = text.lines().find(|line| line.contains("gpt-5.4")).unwrap();
+    let cells = record
+        .split('│')
+        .skip(1)
+        .take(17)
+        .map(str::trim)
+        .collect::<Vec<_>>();
+    assert_eq!(cells[8], "$3.00");
+    assert_eq!(cells[15], "$1.20");
+    assert_eq!(cells[16], "$4.20");
+    assert_eq!(text.matches("Period").count(), 1);
+    assert!(text.contains("┌") && text.contains("┼") && text.contains("┘"));
+    assert!(text.contains("Cost"));
+    assert!(text.contains("Short context") && text.contains("Long context"));
+    assert!(!text.contains("Local usage -"));
+    assert!(text.contains("Read") && text.contains("Write") && text.contains("Hit"));
+    assert!(!text.contains("Cache") && text.contains("USD per 1M tokens"));
+    assert_eq!(text.matches("Total cost").count(), 1);
+    assert!(!text.contains("Subtotal"));
+    let highlighted = lines
+        .iter()
+        .flat_map(|line| &line.spans)
+        .filter(|span| matches!(span.style.fg, Some(Color::Yellow | Color::LightYellow)))
+        .map(|span| span.content.trim())
+        .collect::<Vec<_>>();
+    assert_eq!(highlighted, ["$4.20"]);
+    let prices = text.split("Prices - USD per 1M tokens").nth(1).unwrap();
+    let model = prices
+        .lines()
+        .find(|line| line.contains("gpt-5.4"))
+        .unwrap();
+    assert!(model.contains("$0.2000") && model.contains("$0.4000"));
+    assert!(!text.contains("0-271999") && !text.contains(">= 272000"));
+    assert!(!text.contains("Input range"));
+    assert!(text.contains("83.33%") && text.contains("75.00%"));
+    assert!(!text.contains("Weekly quota estimates"));
+    insta::assert_snapshot!("local_usage_daily", text);
+}
