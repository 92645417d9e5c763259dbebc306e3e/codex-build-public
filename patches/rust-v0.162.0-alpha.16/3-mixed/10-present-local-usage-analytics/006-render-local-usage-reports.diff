+#[test]
+fn zero_usage_and_rounded_zero_costs_render_as_dashes_without_changing_values() {
+    let usage = Usage {
+        cost: 0.001,
+        short_cost: 0.001,
+        ..Default::default()
+    };
+    let row = usage_row(
+        Some(Cell::number("day")),
+        "model",
+        &usage,
+        true,
+        ContextColumns::ShortAndLong,
+        [true, true],
+        false,
+    );
+    assert!(
+        row[2..]
+            .iter()
+            .flat_map(|cell| &cell.lines)
+            .all(|line| line.to_string() == "--")
+    );
+    assert_eq!(row.last().unwrap().value, Some(0.001));
+    assert_eq!(number(0.0, 1, "", "%"), "--");
+}
