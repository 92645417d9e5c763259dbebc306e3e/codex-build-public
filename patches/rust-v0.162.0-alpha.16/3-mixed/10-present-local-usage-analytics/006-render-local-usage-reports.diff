+#[test]
+fn empty_write_columns_disappear_independently_without_shifting_other_values() {
+    for (short_write, long_write, short_price, long_price) in [
+        (0, 0, 0.0, 0.0),
+        (400, 0, 2.5, 0.0),
+        (0, 100, 0.0, 5.0),
+        (400, 100, 2.5, 5.0),
+        (0, 0, 2.5, 5.0),
+        (400, 100, 0.0, 0.0),
+    ] {
+        let mut report = report();
+        let usage = report
+            .rows
+            .get_mut("2026-09-28")
+            .unwrap()
+            .get_mut("gpt-5.4")
+            .unwrap();
+        usage.tokens.cache_write = short_write + long_write;
+        usage.long_tokens.cache_write = long_write;
+        report.prices = serde_json::from_value(serde_json::json!({"gpt-5.4": {
+            "0": {"input":2.0,"cacheRead":0.2,"cacheWrite":short_price,"output":10.0},
+            "272000": {"input":4.0,"cacheRead":0.4,"cacheWrite":long_price,"output":20.0}
+        }}))
+        .unwrap();
+        let lines = render(&report, UsageRange::Daily, 200);
+        let text = lines.iter().join("\n");
+        let (usage, prices) = text.split_once("Prices - USD per 1M tokens").unwrap();
+        assert_eq!(
+            usage.matches("Write").count(),
+            usize::from(short_write > 0) + usize::from(long_write > 0)
+        );
+        assert_eq!(
+            prices.matches("Write").count(),
+            usize::from(short_price > 0.0) + usize::from(long_price > 0.0)
+        );
+        let row = usage.lines().find(|line| line.contains("gpt-5.4")).unwrap();
+        assert!(row.contains("$3.00") && row.contains("$1.20") && row.contains("$4.20"));
+        assert!(row.contains("83.33%") && row.contains("75.00%"));
+        assert!(prices.contains("$0.2000") && prices.contains("$0.4000"));
+        for section in [usage, prices] {
+            let table = section
+                .lines()
+                .filter(|line| line.starts_with(['┌', '│', '├', '└']))
+                .collect::<Vec<_>>();
+            let width = table[0].chars().count();
+            assert!(width <= 200);
+            assert!(table.iter().all(|line| line.chars().count() == width));
+        }
+    }
+}
