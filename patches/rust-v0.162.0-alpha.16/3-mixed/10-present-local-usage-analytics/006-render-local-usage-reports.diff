+#[test]
+fn day_views_follow_the_shared_snapshots_local_calendar() {
+    let mut report = report();
+    report.refreshed_at = DateTime::parse_from_rfc3339("2026-09-30T00:30:00+08:00").unwrap();
+    report.rows.insert("2026-09-29".into(), BTreeMap::new());
+    report.rows.insert("2026-09-30".into(), BTreeMap::new());
+    for (range, expected) in [
+        (UsageRange::Today, "2026-09-30"),
+        (UsageRange::Yesterday, "2026-09-29"),
+    ] {
+        assert_eq!(
+            crate::local_usage::periods(&report, range)
+                .map(|(day, _)| day.as_str())
+                .collect::<Vec<_>>(),
+            vec![expected]
+        );
+    }
+}
