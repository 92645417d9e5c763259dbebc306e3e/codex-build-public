+    assert!(older.find("zeta").unwrap() < older.find("alpha").unwrap());
+    let prices = text.split("Prices - USD per 1M tokens").nth(1).unwrap();
+    assert!(prices.find("zeta").unwrap() < prices.find("alpha").unwrap());
+    assert!(!text.contains("Short context") && !text.contains("Long context"));
+    assert!(!text.contains("All input"));
