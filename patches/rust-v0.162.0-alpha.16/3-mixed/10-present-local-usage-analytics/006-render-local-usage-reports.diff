+#[test]
+fn single_model_periods_omit_only_duplicate_totals() {
+    for (model_counts, expected_rows, expected_summaries) in [
+        (vec![1], 1, 1),
+        (vec![2], 3, 1),
+        (vec![1, 1], 3, 3),
+        (vec![2, 1], 5, 3),
+    ] {
+        let mut report = report();
+        let usage = report.rows["2026-09-28"]["gpt-5.4"].clone();
+        report.rows.clear();
+        for (day, count) in model_counts.into_iter().enumerate() {
+            report.rows.insert(
+                format!("2026-09-{}", 28 + day),
+                (0..count)
+                    .map(|model| (format!("model-{model}"), usage.clone()))
+                    .collect(),
+            );
+        }
+        let lines = render(&report, UsageRange::Daily, 200);
+        let text = lines.iter().join("\n");
+        let consumption = text.split("Prices - USD per 1M tokens").next().unwrap();
+        let rows = consumption
+            .lines()
+            .filter(|line| line.starts_with('│') && line.contains('$'))
+            .collect::<Vec<_>>();
+        assert_eq!(rows.len(), expected_rows);
+        let prices_start = lines
+            .iter()
+            .position(|line| line.to_string().contains("Prices - USD per 1M tokens"))
+            .unwrap();
+        let summaries = lines[..prices_start]
+            .iter()
+            .filter(|line| line.to_string().starts_with('│'))
+            .filter(|line| {
+                line.spans.iter().any(|span| {
+                    span.content.contains('$') && span.style.fg == Some(Color::LightYellow)
+                })
+            })
+            .count();
+        assert_eq!(summaries, expected_summaries);
+        assert!(
+            lines[prices_start..]
+                .iter()
+                .flat_map(|line| &line.spans)
+                .all(|span| { span.style.fg != Some(Color::LightYellow) })
+        );
+        if expected_rows > 1 {
+            let total = report
+                .rows
+                .values()
+                .flat_map(BTreeMap::values)
+                .map(|usage| usage.cost)
+                .sum::<f64>();
+            assert!(rows.last().unwrap().contains(&format!("${total:.2}")));
+        }
+    }
+}
