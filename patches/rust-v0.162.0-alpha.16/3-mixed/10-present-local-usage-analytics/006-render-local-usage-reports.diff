+use std::collections::BTreeMap;
+
+use crate::render::renderable::Renderable;
+use ratatui::style::Color;
+use ratatui::style::Stylize;
+use ratatui::text::Line;
+
+use super::UsageRange;
+use super::UsageReport;
+use super::table;
+use super::table::Cell;
+use codex_app_server_protocol::LocalUsageTotals as Usage;
+
+pub(crate) fn render(
+    report: &UsageReport,
+    range: UsageRange,
+    width: u16,
+) -> Vec<Box<dyn Renderable>> {
+    render_selected(report, range, width, None)
+}
+
+pub(crate) fn render_selected(
+    report: &UsageReport,
+    range: UsageRange,
+    width: u16,
+    selected: Option<chrono::NaiveDate>,
+) -> Vec<Box<dyn Renderable>> {
+    let selected = selected.filter(|_| range == UsageRange::Heatmap);
+    let mut lines = Vec::new();
+    if report.diagnostics.malformed_records != 0 || report.diagnostics.incomplete_tails != 0 {
+        lines.push(
+            format!(
+                " Skipped {} malformed records and {} unfinished tails",
+                count(report.diagnostics.malformed_records as u64),
+                count(report.diagnostics.incomplete_tails as u64)
+            )
+            .dim()
+            .into(),
+        );
+    }
+    match range {
+        UsageRange::Heatmap => lines.extend(super::heatmap::render(report, width, selected)),
+        UsageRange::Quota => lines.extend(quota::render(
+            &report.quota,
+            *report.refreshed_at.offset(),
+            width,
+        )),
+        _ => lines.extend(usage_tables(
+            report,
+            range,
+            &super::periods(report, range)
+                .rev()
+                .map(|(period, models)| (period.as_str(), models))
+                .collect::<Vec<_>>(),
+            width,
+        )),
+    }
+    lines
+}
+
+pub(super) fn combined_models<'a>(
+    rows: impl Iterator<Item = &'a BTreeMap<String, Usage>>,
+) -> BTreeMap<String, Usage> {
+    let mut combined = BTreeMap::<String, Usage>::new();
+    for (model, usage) in rows.flat_map(BTreeMap::iter) {
+        combined.entry(model.clone()).or_default().add_usage(usage);
+    }
+    combined
+}
+
+#[derive(Clone, Copy, PartialEq)]
+enum ContextColumns {
+    All,
+    ShortAndLong,
+}
+
+pub(super) fn usage_tables(
+    report: &UsageReport,
+    range: UsageRange,
+    periods: &[(&str, &BTreeMap<String, Usage>)],
+    width: u16,
+) -> Vec<Box<dyn Renderable>> {
+    if periods.iter().all(|(_, models)| models.is_empty()) {
+        return vec![" No local usage in this range".dim().into()];
+    }
+    let models = combined_models(periods.iter().map(|(_, models)| *models));
+    let contexts = if models.keys().any(|model| {
+        report
+            .prices
+            .get(model)
+            .is_some_and(|price| price.len() > 1)
+    }) {
+        ContextColumns::ShortAndLong
+    } else {
+        ContextColumns::All
+    };
+    let writes = if contexts == ContextColumns::ShortAndLong {
+        [
+            models
+                .values()
+                .any(|usage| usage.tokens.cache_write > usage.long_tokens.cache_write),
+            models
+                .values()
+                .any(|usage| usage.long_tokens.cache_write > 0),
+        ]
+    } else {
+        [
+            models.values().any(|usage| usage.tokens.cache_write > 0),
+            false,
+        ]
+    };
+    let period_column = range != UsageRange::Heatmap;
+    let mut rows = Vec::new();
+    let mut grand = Usage::default();
+    for (period, models) in periods {
+        let mut subtotal = Usage::default();
+        for (index, (model, usage)) in models.iter().rev().enumerate() {
+            subtotal.add_usage(usage);
+            rows.push(usage_row(
+                period_column.then(|| Cell::text(if index == 0 { *period } else { "" })),
+                model,
+                usage,
+                !report.missing_prices.contains(model),
+                contexts,
+                writes,
+                models.len() == 1,
+            ));
+        }
+        grand.add_usage(&subtotal);
+        if periods.len() > 1 && models.len() > 1 {
+            rows.push(usage_row(
+                period_column.then(|| Cell::text("")),
+                "",
+                &subtotal,
+                models
+                    .keys()
+                    .any(|model| !report.missing_prices.contains(model)),
+                contexts,
+                writes,
+                true,
+            ));
+        }
+    }
+    if periods
+        .iter()
+        .map(|(_, models)| models.len())
+        .sum::<usize>()
+        > 1
+    {
+        rows.push(usage_row(
+            period_column.then(|| Cell::text("")),
+            "",
+            &grand,
+            models
+                .keys()
+                .any(|model| !report.missing_prices.contains(model)),
+            contexts,
+            writes,
+            true,
+        ));
+    }
+    let labels = [
+        "Input",
+        "Read",
+        "Write",
+        "Output",
+        "Reasoning",
+        "Hit",
+        "Cost",
+    ];
+    let context_limits = [(6, 10), (6, 10), (6, 10), (6, 10), (9, 10), (7, 9), (9, 12)];
+    let mut limits = Vec::new();
+    let mut leading_headers = Vec::new();
+    if period_column {
+        limits.push((10, 10));
+        leading_headers.push(Cell::header("Period"));
+    }
+    limits.push((16, 30));
+    leading_headers.push(Cell::header("Model"));
+    let context_headers = |write: bool| {
+        labels
+            .iter()
+            .enumerate()
+            .filter(move |(index, _)| *index != 2 || write)
+            .map(|(_, label)| {
+                Cell::header(if *label == "Cost" && contexts == ContextColumns::All {
+                    "Total cost"
+                } else {
+                    label
+                })
+            })
+    };
+    limits.extend(
+        context_limits
+            .iter()
+            .enumerate()
+            .filter(|(index, _)| *index != 2 || writes[0])
+            .map(|(index, limit)| {
+                if index == 6 && contexts == ContextColumns::All {
+                    (10, 12)
+                } else {
+                    *limit
+                }
+            }),
+    );
+    let headers = if contexts == ContextColumns::ShortAndLong {
+        limits.extend(
+            context_limits
+                .iter()
+                .enumerate()
+                .filter(|(index, _)| *index != 2 || writes[1])
+                .map(|(_, limit)| *limit),
+        );
+        limits.push((10, 12));
+        let mut groups = leading_headers
+            .into_iter()
+            .map(|cell| cell.spanning(2, 1))
+            .collect::<Vec<_>>();
+        groups.extend([
+            Cell::header("Short context").spanning(1, 6 + usize::from(writes[0])),
+            Cell::header("Long context").spanning(1, 6 + usize::from(writes[1])),
+            Cell::header("Total cost").spanning(2, 1),
+        ]);
+        vec![
+            groups,
+            context_headers(writes[0])
+                .chain(context_headers(writes[1]))
+                .collect(),
+        ]
+    } else {
+        leading_headers.extend(context_headers(writes[0]));
+        vec![leading_headers]
+    };
+    let mut lines = numeric_table(
+        headers,
+        &limits,
+        rows,
+        Some(usize::from(period_column)),
+        width,
+    );
+    lines.push(Line::default().into());
+    lines.extend(price_table(report, &models, width));
+    lines
+}
+
+fn usage_row(
+    period: Option<Cell>,
+    model: &str,
+    usage: &Usage,
+    priced: bool,
+    contexts: ContextColumns,
+    writes: [bool; 2],
+    summary: bool,
+) -> Vec<Cell> {
+    let mut cells: Vec<_> = period.into_iter().collect();
+    cells.push(Cell::text(model));
+    let split = contexts == ContextColumns::ShortAndLong;
+    let first = if split {
+        (usage.tokens.subtract(usage.long_tokens), usage.short_cost)
+    } else {
+        (usage.tokens, usage.cost)
+    };
+    for (context, (tokens, cost)) in std::iter::once(first)
+        .chain(split.then_some((usage.long_tokens, usage.long_cost)))
+        .enumerate()
+    {
+        for (_, value) in [
+            tokens
+                .input
+                .saturating_sub(tokens.cached)
+                .saturating_sub(tokens.cache_write),
+            tokens.cached,
+            tokens.cache_write,
+            tokens.output,
+            tokens.reasoning,
+        ]
+        .into_iter()
+        .enumerate()
+        .filter(|(column, _)| *column != 2 || writes[context])
+        {
+            cells.push(Cell::value(Some(value as f64), count(value)));
+        }
+        let hit = (tokens.input > 0).then_some(tokens.cached as f64 * 100.0 / tokens.input as f64);
+        cells.push(Cell::value(
+            hit,
+            hit.map_or_else(|| "--".into(), |value| number(value, 2, "", "%")),
+        ));
+        cells.push(cost_cell(cost, priced, summary && !split));
+    }
+    if split {
+        cells.push(cost_cell(usage.cost, priced, summary));
+    }
+    cells
+}
+
+fn cost_cell(cost: f64, priced: bool, summary: bool) -> Cell {
+    let mut cell = Cell::value(
+        priced.then_some(cost),
+        if priced {
+            number(cost, 2, "$", "")
+        } else {
+            "--".into()
+        },
+    );
+    if summary {
+        cell.lines[0].style.fg = Some(Color::LightYellow);
+    }
+    cell
+}
+
+fn price_table(
+    report: &UsageReport,
+    models: &BTreeMap<String, Usage>,
+    width: u16,
+) -> Vec<Box<dyn Renderable>> {
+    let effective = |usage: &Usage| {
+        (usage.tokens.total > 0 && usage.cost > 0.0)
+            .then_some(usage.cost / usage.tokens.total as f64)
+    };
+    let highest = models.values().filter_map(effective).fold(0.0, f64::max);
+    let contexts = models
+        .keys()
+        .filter_map(|model| report.prices.get(model))
+        .map(BTreeMap::len)
+        .max()
+        .unwrap_or(1);
+    let writes: Vec<_> = (0..contexts)
+        .map(|index| {
+            models
+                .keys()
+                .filter_map(|model| report.prices.get(model))
+                .filter_map(|price| price.iter().nth(index))
+                .any(|(_, rates)| rates.cache_write > 0.0)
+        })
+        .collect();
+    let mut rows = Vec::new();
+    for (model, usage) in models.iter().rev() {
+        let intervals = report
+            .prices
+            .get(model)
+            .map(|price| price.iter().collect::<Vec<_>>())
+            .unwrap_or_default();
+        let efficiency = effective(usage).map(|cost| highest / cost);
+        let mut row = vec![Cell::text(model)];
+        for (index, write) in writes.iter().copied().enumerate() {
+            let Some((_, rates)) = intervals.get(index) else {
+                row.extend((0..3 + usize::from(write)).map(|_| Cell::number("--")));
+                continue;
+            };
+            row.extend(
+                [
+                    rates.input,
+                    rates.cache_read,
+                    rates.cache_write,
+                    rates.output,
+                ]
+                .into_iter()
+                .enumerate()
+                .filter(|(column, _)| *column != 2 || write)
+                .map(|(_, rate)| Cell::value(Some(rate), number(rate, 4, "$", ""))),
+            );
+        }
+        row.push(Cell::value(
+            efficiency,
+            efficiency.map_or_else(|| "--".into(), |value| number(value, 2, "", "")),
+        ));
+        rows.push(row);
+    }
+    let labels = ["Input", "Read", "Write", "Output"];
+    let mut limits = vec![(16, 30)];
+    for write in &writes {
+        limits.extend(std::iter::repeat_n((9, 11), 3 + usize::from(*write)));
+    }
+    limits.push((10, 10));
+    let context_labels = |write: bool| {
+        labels
+            .into_iter()
+            .enumerate()
+            .filter(move |(index, _)| *index != 2 || write)
+            .map(|(_, label)| label)
+    };
+    let headers = if contexts == 1 {
+        vec![
+            std::iter::once("Model")
+                .chain(context_labels(writes[0]))
+                .chain(["Efficiency"])
+                .map(Cell::header)
+                .collect(),
+        ]
+    } else {
+        let mut groups = vec![Cell::header("Model").spanning(2, 1)];
+        for (index, write) in writes.iter().enumerate() {
+            let label = match (contexts, index) {
+                (2, 0) => "Short context".to_owned(),
+                (2, 1) => "Long context".to_owned(),
+                _ => format!("Context {}", index + 1),
+            };
+            groups.push(Cell::header(&label).spanning(1, 3 + usize::from(*write)));
+        }
+        groups.push(Cell::header("Efficiency").spanning(2, 1));
+        vec![
+            groups,
+            writes
+                .into_iter()
+                .flat_map(|write| context_labels(write).map(Cell::header))
+                .collect(),
+        ]
+    };
+    let mut lines: Vec<Box<dyn Renderable>> =
+        vec![Line::from(" Prices - USD per 1M tokens").bold().into()];
+    lines.extend(numeric_table(headers, &limits, rows, Some(0), width));
+    lines
+}
+
+fn numeric_table(
+    mut headers: Vec<Vec<Cell>>,
+    limits: &[(usize, usize)],
+    mut rows: Vec<Vec<Cell>>,
+    model_column: Option<usize>,
+    width: u16,
+) -> Vec<Box<dyn Renderable>> {
+    let Some(widths) = table::widths(width, limits) else {
+        let minimum = limits.iter().map(|(min, _)| min + 3).sum::<usize>() + 1;
+        return vec![format!(" Table requires {minimum} columns").dim().into()];
+    };
+    if let Some(column) = model_column {
+        table::center_left_column(&mut rows, column, widths[column]);
+    }
+    table::shade_columns(&mut rows);
+    headers.extend(rows);
+    vec![table::render(&widths, &headers).into()]
+}
+
+pub(super) fn count(value: u64) -> String {
+    if value == 0 {
+        "--".into()
+    } else if value >= 1_000_000_000 {
+        format!("{:.2}B", value as f64 / 1_000_000_000.0)
+    } else if value >= 1_000_000 {
+        format!("{:.2}M", value as f64 / 1_000_000.0)
+    } else if value >= 1_000 {
+        format!("{:.2}K", value as f64 / 1_000.0)
+    } else {
+        value.to_string()
+    }
+}
+
+pub(super) fn number(value: f64, precision: usize, prefix: &str, suffix: &str) -> String {
+    if (value * 10_f64.powi(precision as i32)).round() == 0.0 {
+        "--".into()
+    } else {
+        format!("{prefix}{value:.precision$}{suffix}")
+    }
+}
