+#[test]
+fn period_values_are_centered_and_model_columns_share_a_centered_left_edge() {
+    let mut report = report();
+    let usage = report.rows["2026-09-28"]["gpt-5.4"].clone();
+    let models = BTreeMap::from([
+        ("alpha".to_owned(), usage.clone()),
+        ("zeta-extended".to_owned(), usage),
+    ]);
+    report.rows = BTreeMap::from([
+        ("2026-09-29".to_owned(), models.clone()),
+        ("2026-09-30".to_owned(), models.clone()),
+    ]);
+    report.weekly_rows = BTreeMap::from([("2026-W40".to_owned(), models.clone())]);
+    report.monthly_rows = BTreeMap::from([("2026-09".to_owned(), models.clone())]);
+    report.yearly_rows = BTreeMap::from([("2026".to_owned(), models.clone())]);
+    for (range, period) in [
+        (UsageRange::Today, "2026-09-30"),
+        (UsageRange::Yesterday, "2026-09-29"),
+        (UsageRange::Daily, "2026-09-30"),
+        (UsageRange::Weekly, "2026-W40"),
+        (UsageRange::Monthly, "2026-09"),
+        (UsageRange::Yearly, "2026"),
+    ] {
+        let lines = render(&report, range, 200);
+        let text = lines.iter().join("\n");
+        let (consumption, prices) = text.split_once("Prices - USD per 1M tokens").unwrap();
+        let period_row = consumption
+            .lines()
+            .find(|line| line.contains(period))
+            .unwrap();
+        let period_cell = period_row.split('│').nth(1).unwrap();
+        assert_eq!(
+            period_cell.len() - period_cell.trim_start().len(),
+            (period_cell.len() - period.len()) / 2,
+            "{range:?}: {period_row}"
+        );
+        for (table, column) in [(consumption, 2), (prices, 1)] {
+            let labels = table
+                .lines()
+                .filter_map(|line| line.split('│').nth(column))
+                .filter(|cell| matches!(cell.trim(), "alpha" | "zeta-extended"))
+                .collect::<Vec<_>>();
+            assert!(labels.len() >= 2, "{range:?}: {table}");
+            for label in labels {
+                assert_eq!(
+                    label.len() - label.trim_start().len(),
+                    (label.len() - "zeta-extended".len()) / 2,
+                    "{range:?}: {label}"
+                );
+            }
+        }
+    }
+    let lines = render_lines(
+        usage_tables(
+            &report,
+            UsageRange::Heatmap,
+            &[("2026-09-30", &models)],
+            200,
+        ),
+        200,
+    );
+    let labels = lines
+        .iter()
+        .map(ToString::to_string)
+        .filter(|line| line.contains("alpha") || line.contains("zeta-extended"))
+        .collect::<Vec<_>>();
+    assert_eq!(labels.len(), 4);
+    for line in labels {
+        let label = line.split('│').nth(1).unwrap();
+        assert_eq!(
+            label.len() - label.trim_start().len(),
+            (label.len() - "zeta-extended".len()) / 2
+        );
+    }
+}
