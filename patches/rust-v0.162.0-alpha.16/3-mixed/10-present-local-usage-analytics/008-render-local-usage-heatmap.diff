+use super::super::render::tests::report;
+use super::super::table::tests::render_lines;
+use super::*;
+use itertools::Itertools;
+use pretty_assertions::assert_eq;
+use ratatui::style::Color;
+
+fn render_selected(
+    report: &UsageReport,
+    range: UsageRange,
+    width: u16,
+    selected: Option<NaiveDate>,
+) -> Vec<Line<'static>> {
+    render_lines(
+        super::super::render::render_selected(report, range, width, selected),
+        width,
+    )
+}
+
+#[test]
+fn heatmap_keeps_activity_streaks_and_sixteen_positive_levels() {
+    let monday = NaiveDate::from_ymd_opt(2026, 9, 28).unwrap();
+    let tuesday = monday.succ_opt().unwrap();
+    let daily = BTreeMap::from([(monday, 10), (tuesday, 20)]);
+    assert_eq!(streaks(&daily, tuesday), (2, 2));
+    assert_eq!(streaks(&daily, tuesday + Duration::days(1)), (2, 2));
+    assert_eq!(streaks(&daily, tuesday + Duration::days(2)), (0, 2));
+    assert_eq!(
+        (0..=16)
+            .map(|value| level(value, &(1..=16).collect::<Vec<_>>()))
+            .collect::<Vec<_>>(),
+        (0..=16).collect::<Vec<_>>()
+    );
+    let text = render_selected(&report(), UsageRange::Heatmap, 40, None)
+        .iter()
+        .join("\n");
+    assert!(text.contains("Current streak -- days   Longest 1 days"));
+    assert!(text.contains("Activity - last 12 months"));
+    assert!(!text.contains("Estimated weekly quota"));
+    insta::assert_snapshot!(text);
+}
+
+#[test]
+fn calendar_keeps_weekday_geometry_and_future_days_blank() {
+    let today = NaiveDate::from_ymd_opt(2026, 9, 30).unwrap();
+    let daily = BTreeMap::from([(today - Duration::days(2), 100)]);
+    for width in [32, 40, 80, 120] {
+        let lines = calendar(&daily, today, width, None);
+        let weeks = (usize::from(width).saturating_sub(5) / 2).clamp(1, 52);
+        for row in &lines[2..=8] {
+            assert_eq!(row.width(), 5 + 2 * weeks);
+            assert!(row.width() <= usize::from(width));
+        }
+        for future in &lines[6..=8] {
+            assert_eq!(future.spans.last().unwrap().content, "  ");
+        }
+    }
+    for today in [
+        NaiveDate::from_ymd_opt(2026, 10, 4).unwrap(),
+        NaiveDate::from_ymd_opt(2026, 11, 1).unwrap(),
+    ] {
+        let lines = calendar(&daily, today, 109, Some(today));
+        let months = lines[1].to_string();
+        let names = months.split_whitespace().collect::<Vec<_>>();
+        assert_eq!(names.len(), 12);
+        assert_eq!(names.iter().copied().unique().count(), 12);
+        assert!(names.iter().all(|name| name.len() == 3));
+        assert!(lines[1].width() <= 109);
+        let selected = lines
+            .iter()
+            .flat_map(|line| &line.spans)
+            .find(|span| span.content == "■ ")
+            .unwrap();
+        assert!(
+            !selected
+                .style
+                .add_modifier
+                .contains(ratatui::style::Modifier::UNDERLINED)
+        );
+    }
+}
+
+#[test]
+fn selected_day_replaces_aggregate_tables_and_only_selection_enlarges() {
+    let mut report = report();
+    report.missing_prices.insert("older-model".into());
+    let selected = NaiveDate::from_ymd_opt(2026, 9, 28).unwrap();
+    report.rows.insert(
+        "2025-01-01".into(),
+        BTreeMap::from([(
+            "older-model".into(),
+            codex_app_server_protocol::LocalUsageTotals {
+                tokens: codex_app_server_protocol::LocalUsageTokens {
+                    input: 10,
+                    total: 10,
+                    ..Default::default()
+                },
+                ..Default::default()
+            },
+        )]),
+    );
+    let overview = render_selected(&report, UsageRange::Heatmap, 200, None);
+    let text = overview.iter().join("\n");
+    assert!(!text.contains('■'));
+    assert!(text.contains("older-model"));
+    assert!(!text.contains("All days") && !text.contains("Period"));
+    assert!(text.contains("USD per 1M tokens"));
+    assert!(text.contains("All dates: 2025-01-01 to 2026-09-28"));
+    assert!(!text.contains("Estimated weekly quota"));
+    let detail = render_selected(&report, UsageRange::Heatmap, 200, Some(selected));
+    assert_eq!(
+        detail
+            .iter()
+            .flat_map(|line| &line.spans)
+            .filter(|span| span.content.contains('■'))
+            .count(),
+        1
+    );
+    let text = detail.iter().join("\n");
+    assert!(text.contains("Selected day: 2026-09-28"));
+    assert!(text.contains("gpt-5.4") && text.contains("USD per 1M tokens"));
+    assert!(!text.contains("older-model") && !text.contains("Period"));
+    assert!(!text.contains("Esc:") && !text.contains("WASD"));
+    assert!(!text.contains("Estimated weekly quota"));
+    assert_eq!(text.matches("2026-09-28").count(), 1);
+    let scope_row = |lines: &[Line<'_>], label: &str| {
+        lines
+            .iter()
+            .position(|line| line.to_string().contains(label))
+            .unwrap()
+    };
+    assert_eq!(
+        scope_row(&overview, "All dates:"),
+        scope_row(&detail, "Selected day:")
+    );
+    assert_eq!(scope_row(&overview, "Model"), scope_row(&detail, "Model"));
+    for span in overview.iter().chain(&detail).flat_map(|line| &line.spans) {
+        let grayscale = match span.style.fg {
+            None
+            | Some(Color::Black | Color::DarkGray | Color::Gray | Color::White | Color::Reset) => {
+                true
+            }
+            Some(Color::Rgb(red, green, blue)) => red == green && green == blue,
+            Some(Color::Indexed(232..=255)) => true,
+            _ => false,
+        };
+        let total_cost =
+            span.style.fg == Some(Color::LightYellow) && span.content.trim().starts_with('$');
+        assert!(
+            grayscale || total_cost,
+            "unexpected usage highlight: {span:?}"
+        );
+    }
+    insta::assert_snapshot!(text);
+}
