+//! Daily activity and selected-day accounting share the report's local calendar.
+
+use super::UsageRange;
+use super::UsageReport;
+use super::render::combined_models;
+use super::render::count;
+use super::render::usage_tables;
+use super::table::intensity_style;
+use crate::render::renderable::Renderable;
+use chrono::Datelike;
+use chrono::Duration;
+use chrono::NaiveDate;
+use itertools::Itertools;
+use ratatui::style::Stylize;
+use ratatui::text::Line;
+use ratatui::text::Span;
+use std::collections::BTreeMap;
+
+pub(crate) fn heatmap_bounds(report: &UsageReport, width: u16) -> (NaiveDate, NaiveDate) {
+    let today = report.refreshed_at.date_naive();
+    (start(today, width), today)
+}
+
+pub(crate) fn day_has_usage(report: &UsageReport, day: NaiveDate) -> bool {
+    report
+        .rows
+        .get(&day.to_string())
+        .is_some_and(|models| models.values().any(|usage| usage.tokens.total > 0))
+}
+
+pub(super) fn render(
+    report: &UsageReport,
+    width: u16,
+    selected: Option<NaiveDate>,
+) -> Vec<Box<dyn Renderable>> {
+    let daily = super::periods(report, UsageRange::Heatmap)
+        .filter_map(|(date, models)| {
+            Some((
+                NaiveDate::parse_from_str(date, "%Y-%m-%d").ok()?,
+                models.values().map(|usage| usage.tokens.total).sum(),
+            ))
+        })
+        .collect();
+    let mut lines: Vec<Box<dyn Renderable>> =
+        calendar(&daily, report.refreshed_at.date_naive(), width, selected)
+            .into_iter()
+            .map(Into::into)
+            .collect();
+    lines.push(Line::default().into());
+    let label = if let Some(day) = selected {
+        format!(" Selected day: {day}")
+    } else {
+        let first = report.rows.first_key_value().map_or("--", |(day, _)| day);
+        let last = report.rows.last_key_value().map_or("--", |(day, _)| day);
+        format!(" All dates: {first} to {last}")
+    };
+    lines.push(Line::from(label).bold().into());
+    let selected_key = selected.map(|day| day.to_string());
+    let models = combined_models(
+        report
+            .rows
+            .iter()
+            .filter(|(day, _)| {
+                selected_key
+                    .as_ref()
+                    .is_none_or(|selected| selected == *day)
+            })
+            .map(|(_, models)| models),
+    );
+    lines.extend(usage_tables(
+        report,
+        UsageRange::Heatmap,
+        &[("", &models)],
+        width,
+    ));
+    lines
+}
+
+fn start(today: NaiveDate, width: u16) -> NaiveDate {
+    let weeks = (usize::from(width).saturating_sub(5) / 2).clamp(1, 52);
+    let end = today + Duration::days(6 - i64::from(today.weekday().num_days_from_sunday()));
+    end - Duration::days((weeks * 7 - 1) as i64)
+}
+
+fn calendar(
+    daily: &BTreeMap<NaiveDate, u64>,
+    today: NaiveDate,
+    width: u16,
+    selected: Option<NaiveDate>,
+) -> Vec<Line<'static>> {
+    if width < 7 {
+        return vec![" Widen terminal to show the heatmap.".dim().into()];
+    }
+    let weeks = (usize::from(width).saturating_sub(5) / 2).clamp(1, 52);
+    let start = start(today, width);
+    let peak = daily.values().copied().max().unwrap_or(0);
+    let scale = daily
+        .values()
+        .copied()
+        .filter(|value| *value > 0)
+        .sorted()
+        .dedup()
+        .collect::<Vec<_>>();
+    let mut lines = vec![Line::from(" Activity - last 12 months").bold()];
+    let mut months = vec![' '; (weeks * 2 + 1).min(usize::from(width) - 5)];
+    for week in 0..weeks {
+        let date = start + Duration::days((week * 7) as i64);
+        let month = (date + Duration::days(6)).with_day(1).unwrap();
+        let current_partial_month = week == 0 && month == today.with_day(1).unwrap();
+        if months.len() >= 3 && month <= today && (month >= date || current_partial_month) {
+            let column = (week * 2).min(months.len() - 3);
+            for (cell, letter) in months[column..]
+                .iter_mut()
+                .zip(month.format("%b").to_string().chars())
+            {
+                *cell = letter;
+            }
+        }
+    }
+    lines.push(
+        format!("     {}", months.into_iter().collect::<String>())
+            .dim()
+            .into(),
+    );
+    for weekday in 0..7 {
+        let mut spans = vec![Span::from(match weekday {
+            0 => " Sun ",
+            2 => " Tue ",
+            4 => " Thu ",
+            _ => "     ",
+        })];
+        for week in 0..weeks {
+            let date = start + Duration::days((week * 7 + weekday) as i64);
+            if date > today {
+                spans.push("  ".into());
+                continue;
+            }
+            let style = intensity_style(level(daily.get(&date).copied().unwrap_or(0), &scale));
+            spans.push(if selected == Some(date) {
+                Span::styled("■ ", style.bold())
+            } else {
+                Span::styled("▪ ", style)
+            });
+        }
+        lines.push(spans.into());
+    }
+    let (current, longest) = streaks(daily, today);
+    lines.push(
+        format!(
+            " Current streak {} days   Longest {} days   Peak {} tokens",
+            count(current),
+            count(longest),
+            count(peak)
+        )
+        .into(),
+    );
+    lines
+}
+
+fn streaks(daily: &BTreeMap<NaiveDate, u64>, today: NaiveDate) -> (u64, u64) {
+    let mut current = 0;
+    let mut longest = 0;
+    let mut previous: Option<NaiveDate> = None;
+    for (date, tokens) in daily {
+        if *tokens == 0 || *date > today {
+            continue;
+        }
+        current = if previous.and_then(|date| date.succ_opt()) == Some(*date) {
+            current + 1
+        } else {
+            1
+        };
+        longest = longest.max(current);
+        previous = Some(*date);
+    }
+    if previous != Some(today) && previous != today.pred_opt() {
+        current = 0;
+    }
+    (current, longest)
+}
+
+fn level(value: u64, scale: &[u64]) -> usize {
+    if value == 0 {
+        0
+    } else if scale.len() == 1 {
+        16
+    } else {
+        1 + scale.partition_point(|candidate| *candidate < value) * 15 / (scale.len() - 1)
+    }
+}
+
+#[cfg(test)]
+#[path = "heatmap_tests.rs"]
+mod tests;
