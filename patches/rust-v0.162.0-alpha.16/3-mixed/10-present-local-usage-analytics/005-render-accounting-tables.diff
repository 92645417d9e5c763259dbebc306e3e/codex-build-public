+//! Presentation of the app-server's shared local accounting snapshot.
+pub(crate) mod table;
+
+pub(crate) use codex_app_server_protocol::LocalUsageReport as UsageReport;
+use codex_app_server_protocol::LocalUsageTotals as Usage;
+use std::collections::BTreeMap;
+
+pub(crate) const TITLE: &str = "Local usage analytics";
+
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub(crate) enum UsageRange {
+    Today,
+    Yesterday,
+    Daily,
+    Weekly,
+    Monthly,
+    Yearly,
+    Heatmap,
+    Quota,
+}
+
+impl UsageRange {
+    pub(crate) const VIEWS: [Self; 8] = [
+        Self::Heatmap,
+        Self::Today,
+        Self::Yesterday,
+        Self::Daily,
+        Self::Weekly,
+        Self::Monthly,
+        Self::Yearly,
+        Self::Quota,
+    ];
+
+    pub(crate) fn index(self) -> usize {
+        Self::VIEWS
+            .iter()
+            .position(|range| *range == self)
+            .expect("every usage view is listed")
+    }
+
+    pub(crate) fn label(self) -> &'static str {
+        match self {
+            Self::Today => "today",
+            Self::Yesterday => "yesterday",
+            Self::Daily => "daily",
+            Self::Weekly => "weekly",
+            Self::Monthly => "monthly",
+            Self::Yearly => "yearly",
+            Self::Heatmap => "heatmap",
+            Self::Quota => "weekly quota",
+        }
+    }
+}
+
+fn periods(
+    report: &UsageReport,
+    range: UsageRange,
+) -> impl DoubleEndedIterator<Item = (&String, &BTreeMap<String, Usage>)> {
+    let rows = match range {
+        UsageRange::Weekly => &report.weekly_rows,
+        UsageRange::Monthly => &report.monthly_rows,
+        UsageRange::Yearly => &report.yearly_rows,
+        UsageRange::Today
+        | UsageRange::Yesterday
+        | UsageRange::Daily
+        | UsageRange::Heatmap
+        | UsageRange::Quota => &report.rows,
+    };
+    let today = report.refreshed_at.date_naive();
+    let bounds = match range {
+        UsageRange::Today => Some((today, today)),
+        UsageRange::Yesterday => {
+            let yesterday = today - chrono::Duration::days(1);
+            Some((yesterday, yesterday))
+        }
+        UsageRange::Heatmap => Some((today - chrono::Duration::days(364), today)),
+        UsageRange::Daily
+        | UsageRange::Weekly
+        | UsageRange::Monthly
+        | UsageRange::Yearly
+        | UsageRange::Quota => None,
+    }
+    .map(|(start, end)| (start.to_string(), end.to_string()));
+    rows.iter().filter(move |(date, _)| {
+        bounds
+            .as_ref()
+            .is_none_or(|(start, end)| *date >= start && *date <= end)
+    })
+}
