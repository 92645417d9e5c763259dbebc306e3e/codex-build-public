+use super::types::Diagnostics;
+use super::types::Observation;
+use super::wire::Event;
+use super::wire::ParsedFile;
+use super::wire::intern_model;
+use super::wire::read_lines;
+use super::wire::timestamp;
+use serde_json::Value;
+use std::collections::BTreeMap;
+use std::fs;
+use std::io::BufRead;
+use std::io::BufReader;
+use std::path::Path;
+use std::path::PathBuf;
+use std::thread;
+
+pub(super) struct Events {
+    pub(super) events: Vec<Event>,
+    pub(super) models: Vec<String>,
+    pub(super) observations: Vec<Observation>,
+    pub(super) diagnostics: Diagnostics,
+}
+
+struct FileMetadata {
+    path: PathBuf,
+    id: String,
+    parent: Option<String>,
+    own_start: Option<u64>,
+    forked_at: Option<i64>,
+    bytes: u64,
+}
+
+fn collect_files(
+    entries: fs::ReadDir,
+    base: &Path,
+    files: &mut BTreeMap<PathBuf, PathBuf>,
+) -> std::io::Result<()> {
+    for entry in entries {
+        let entry = entry?;
+        let path = entry.path();
+        let kind = entry.file_type()?;
+        if kind.is_dir() {
+            collect_files(fs::read_dir(&path)?, base, files)?;
+        } else if kind.is_file()
+            && path
+                .extension()
+                .is_some_and(|extension| extension == "jsonl")
+        {
+            let relative = path
+                .strip_prefix(base)
+                .expect("discovered under session root");
+            files.entry(relative.to_path_buf()).or_insert(path);
+        }
+    }
+    Ok(())
+}
+
+fn metadata(
+    path: PathBuf,
+    diagnostics: &mut Diagnostics,
+) -> Result<Option<FileMetadata>, super::Error> {
+    let file = fs::File::open(&path)?;
+    let stat = file.metadata()?;
+    let mut header = String::new();
+    BufReader::new(file).read_line(&mut header)?;
+    let value: Value = match serde_json::from_str(&header) {
+        Ok(value) => value,
+        Err(_) => {
+            diagnostics.malformed_records += 1;
+            return Ok(None);
+        }
+    };
+    let payload = &value["payload"];
+    if value["type"] != "session_meta" || payload["history_mode"] != "paginated" {
+        diagnostics.skipped_non_paginated += 1;
+        return Ok(None);
+    }
+    let parent = ["forked_from_id", "parent_thread_id"]
+        .into_iter()
+        .filter_map(|key| payload.get(key))
+        .chain(payload.pointer("/source/subagent/thread_spawn/parent_thread_id"))
+        .find_map(Value::as_str)
+        .filter(|id| !id.is_empty())
+        .map(str::to_owned);
+    Ok(Some(FileMetadata {
+        path,
+        id: payload["id"].as_str().unwrap_or("").to_owned(),
+        parent,
+        // Referenced forks contain only their own suffix. Copied subagent context has
+        // an explicit boundary. Neither is an ambiguous migrated replay prefix.
+        own_start: payload
+            .get("subagent_history_start_ordinal")
+            .into_iter()
+            .chain(payload.pointer("/history_base/end_ordinal_exclusive"))
+            .find_map(Value::as_u64),
+        forked_at: value["timestamp"].as_str().and_then(timestamp),
+        bytes: stat.len(),
+    }))
+}
+
+/// Read each file once for all report dimensions, bounded to its observed byte length.
+/// Compact records keep copied-prefix comparison off the filesystem and UI thread.
+pub(super) fn load(home: &Path) -> Result<Events, super::Error> {
+    // A relative-path collision prefers active over archived records.
+    let mut paths = BTreeMap::new();
+    for name in [
+        codex_rollout::SESSIONS_SUBDIR,
+        codex_rollout::ARCHIVED_SESSIONS_SUBDIR,
+    ] {
+        let root = home.join(name);
+        match fs::read_dir(&root) {
+            Ok(entries) => collect_files(entries, &root, &mut paths)?,
+            Err(error) if error.kind() == std::io::ErrorKind::NotFound => {}
+            Err(error) => return Err(error.into()),
+        }
+    }
+    let mut diagnostics = Diagnostics::default();
+    let mut files = Vec::new();
+    for path in paths.into_values() {
+        if let Some(file) = metadata(path, &mut diagnostics)? {
+            files.push(file);
+        }
+    }
+    diagnostics.files = files.len();
+    let mut by_id = BTreeMap::new();
+    for (index, file) in files.iter().enumerate() {
+        by_id.entry(file.id.as_str()).or_insert(index);
+    }
+    let parent_index = |index: usize| {
+        files[index]
+            .parent
+            .as_deref()
+            .and_then(|parent| by_id.get(parent))
+            .copied()
+            .filter(|parent| *parent != index)
+    };
+    let mut parsed: Vec<_> = (0..files.len()).map(|_| ParsedFile::default()).collect();
+    let mut jobs: Vec<_> = files.iter().zip(&mut parsed).collect();
+    let workers = thread::available_parallelism()
+        .map(usize::from)
+        .unwrap_or(1)
+        .min(16)
+        .min(jobs.len().max(1));
+    jobs.sort_unstable_by_key(|(file, _)| std::cmp::Reverse(file.bytes));
+    let mut shards: Vec<_> = (0..workers).map(|_| Vec::new()).collect();
+    let mut shard_bytes = vec![0_u64; workers];
+    for job in jobs {
+        let worker = (0..workers)
+            .min_by_key(|worker| shard_bytes[*worker])
+            .expect("at least one worker");
+        shard_bytes[worker] += job.0.bytes;
+        shards[worker].push(job);
+    }
+    thread::scope(|scope| -> Result<(), super::Error> {
+        let mut handles = Vec::with_capacity(shards.len());
+        for shard in shards {
+            handles.push(scope.spawn(move || -> Result<(), super::Error> {
+                for (metadata, parsed) in shard {
+                    let file = fs::File::open(&metadata.path)?;
+                    let reader = BufReader::with_capacity(
+                        128 * 1024,
+                        std::io::Read::take(file, metadata.bytes),
+                    );
+                    *parsed = read_lines(reader, metadata.own_start)?;
+                }
+                Ok(())
+            }));
+        }
+        for handle in handles {
+            handle
+                .join()
+                .map_err(|_| "usage reader worker panicked")??;
+        }
+        Ok(())
+    })?;
+    let cuts: Vec<_> = files
+        .iter()
+        .enumerate()
+        .map(|(index, file)| {
+            if file.own_start.is_some() {
+                return parsed[index].inherited_events;
+            }
+            let parent = parent_index(index)
+                .map(|index| parsed[index].events.as_slice())
+                .unwrap_or(&[]);
+            let limit = file.forked_at.map_or(parent.len(), |forked| {
+                parent
+                    .iter()
+                    .position(|event| event.millis > forked)
+                    .unwrap_or(parent.len())
+            });
+            replayed_prefix_length(file.parent.is_some(), &parent[..limit], &parsed[index])
+        })
+        .collect();
+    let capacity = parsed
+        .iter()
+        .zip(&cuts)
+        .map(|(file, cut)| file.events.len() - cut)
+        .sum();
+    let mut events = Vec::with_capacity(capacity);
+    let mut models = Vec::new();
+    let mut observations = Vec::new();
+    for (file, cut) in parsed.into_iter().zip(cuts) {
+        diagnostics.malformed_records += file.malformed;
+        diagnostics.incomplete_tails += file.incomplete;
+        diagnostics.replayed_events += cut;
+        let model_ids: Vec<_> = file
+            .models
+            .into_iter()
+            .map(|model| intern_model(&mut models, model.into()))
+            .collect();
+        events.extend(file.events.into_iter().skip(cut).map(|mut event| {
+            event.model = model_ids[event.model];
+            event
+        }));
+        observations.extend(
+            file.observations
+                .into_iter()
+                .filter_map(|(index, sample)| (index >= cut).then_some(sample)),
+        );
+    }
+    Ok(Events {
+        events,
+        models,
+        observations,
+        diagnostics,
+    })
+}
+
+fn replayed_prefix_length(has_parent: bool, parent: &[Event], child: &ParsedFile) -> usize {
+    if !has_parent {
+        return 0;
+    }
+    let matched = parent
+        .iter()
+        .zip(&child.events)
+        .take_while(|(parent, child)| parent.tokens == child.tokens)
+        .count();
+    if matched > 0 {
+        return matched;
+    }
+    let [first, second] = child.first_usage_times.as_slice() else {
+        return 0;
+    };
+    if !(0..=1_000).contains(&(second - first)) {
+        return 0;
+    }
+    let mut previous = *first;
+    child
+        .events
+        .iter()
+        .take_while(|event| {
+            let copied = (0..=1_000).contains(&(event.millis - previous));
+            previous = event.millis;
+            copied
+        })
+        .count()
+}
+
