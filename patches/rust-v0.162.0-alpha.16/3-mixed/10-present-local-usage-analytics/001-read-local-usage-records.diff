+/// Input includes both cache buckets; reasoning is already included in output.
+#[derive(Clone, Copy, Debug, Default, Eq, PartialEq, Ord, PartialOrd)]
+pub(super) struct Tokens {
+    pub(super) input: u64,
+    pub(super) cached: u64,
+    pub(super) cache_write: u64,
+    pub(super) output: u64,
+    pub(super) reasoning: u64,
+    pub(super) total: u64,
+}
+
+impl Tokens {
+    fn normalized(mut self) -> Self {
+        self.cached = self.cached.min(self.input);
+        self.cache_write = self.cache_write.min(self.input - self.cached);
+        self
+    }
+
+    pub(super) fn subtract(self, previous: Self) -> Self {
+        Self {
+            input: self.input.saturating_sub(previous.input),
+            cached: self.cached.saturating_sub(previous.cached),
+            cache_write: self.cache_write.saturating_sub(previous.cache_write),
+            output: self.output.saturating_sub(previous.output),
+            reasoning: self.reasoning.saturating_sub(previous.reasoning),
+            total: self.total.saturating_sub(previous.total),
+        }
+        .normalized()
+    }
+
+    pub(super) fn is_empty(self) -> bool {
+        self.input == 0
+            && self.cached == 0
+            && self.cache_write == 0
+            && self.output == 0
+            && self.reasoning == 0
+    }
+
+    pub(super) fn add(&mut self, other: Self) {
+        self.input += other.input;
+        self.cached += other.cached;
+        self.cache_write += other.cache_write;
+        self.output += other.output;
+        self.reasoning += other.reasoning;
+        self.total += other.total;
+    }
+}
+
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub(super) enum Tier {
+    Standard,
+    Fast,
+}
+
+impl Tier {
+    pub(super) fn read_str(value: &str) -> Option<Self> {
+        match value {
+            "default" | "standard" => Some(Self::Standard),
+            "fast" | "priority" => Some(Self::Fast),
+            _ => None,
+        }
+    }
+
+    pub(super) fn merge(left: Option<Self>, right: Option<Self>) -> Option<Self> {
+        match (left, right) {
+            (Some(Self::Standard), _) | (_, Some(Self::Standard)) => Some(Self::Standard),
+            (Some(Self::Fast), _) | (_, Some(Self::Fast)) => Some(Self::Fast),
+            _ => None,
+        }
+    }
+}
+
+#[derive(Debug, Default)]
+pub(super) struct Diagnostics {
+    pub(super) files: usize,
+    pub(super) skipped_non_paginated: usize,
+    pub(super) malformed_records: usize,
+    pub(super) incomplete_tails: usize,
+    pub(super) replayed_events: usize,
+    pub(super) duplicate_events: usize,
+    pub(super) unique_events: usize,
+}
+
+#[derive(Debug)]
+pub(super) struct Observation {
+    pub(super) timestamp: String,
+    pub(super) millis: i64,
+    pub(super) used_percent: f64,
+    pub(super) resets_at: i64,
+}
+#[cfg(test)]
+#[path = "types_tests.rs"]
+mod tests;
