+use super::*;
+use pretty_assertions::assert_eq;
+use serde_json::Value;
+use serde_json::json;
+
+fn parse_values(values: &[Value]) -> ParsedFile {
+    let text = values
+        .iter()
+        .map(|value| format!("{value}\n"))
+        .collect::<String>();
+    read_lines(std::io::Cursor::new(text), None).unwrap()
+}
+
+fn context() -> Value {
+    json!({"type":"turn_context", "payload":{"model":"gpt-5.4", "effort":"high"}})
+}
+fn usage() -> Value {
+    json!({"input_tokens":100,"cached_input_tokens":20,"cache_write_input_tokens":10,
+    "output_tokens":50,"reasoning_output_tokens":30,"total_tokens":150})
+}
+fn snapshot() -> Value {
+    json!({"type":"event_msg","timestamp":"2026-09-29T01:00:00.001Z",
+    "payload":{"type":"token_count","info":{"last_token_usage":usage(),"total_token_usage":usage()}}})
+}
+
+#[test]
+fn repeated_cumulative_snapshot_does_not_repeat_last_usage() {
+    let parsed = parse_values(&[context(), snapshot(), snapshot()]);
+    assert_eq!(parsed.events.len(), 1);
+    assert_eq!(parsed.events[0].tokens.total, 150);
+}
+
+#[test]
+fn response_record_and_snapshot_are_not_added_together() {
+    let response = json!({"type":"token_usage_record","timestamp":"2026-09-29T01:00:00.000Z",
+        "payload":{"usage":usage()}});
+    let parsed = parse_values(&[context(), response, snapshot()]);
+    assert_eq!(parsed.events.len(), 1);
+    assert_eq!(parsed.events[0].millis, 1_790_643_600_001);
+}
+
+#[test]
+fn canonical_usage_clamps_caches_and_derives_total_without_adding_reasoning() {
+    let tokens =
+        serde_json::from_value::<WireTokens>(json!({"input_tokens":100,"cached_input_tokens":80,
+        "cache_write_input_tokens":90,"output_tokens":30,"reasoning_output_tokens":20,
+        "total_tokens":0}))
+        .unwrap()
+        .tokens();
+    assert_eq!(
+        tokens,
+        Tokens {
+            input: 100,
+            cached: 80,
+            cache_write: 20,
+            output: 30,
+            reasoning: 20,
+            total: 130
+        }
+    );
+}
+
+#[test]
+fn negative_provider_counter_does_not_discard_the_other_token_fields() {
+    let tokens =
+        serde_json::from_value::<WireTokens>(json!({"input_tokens":100,"output_tokens":-12,
+        "total_tokens":88}))
+        .unwrap()
+        .tokens();
+    assert_eq!(
+        tokens,
+        Tokens {
+            input: 100,
+            total: 88,
+            ..Tokens::default()
+        }
+    );
+}
+
+#[test]
+fn unavailable_quota_reset_does_not_discard_valid_usage() {
+    let mut event = snapshot();
+    event["payload"]["rate_limits"] = json!({"primary":{
+        "used_percent":50.0,"window_minutes":10_080,"resets_at":null
+    }});
+    let parsed = parse_values(&[context(), event]);
+    assert_eq!(parsed.events.len(), 1);
+    assert_eq!(parsed.malformed, 0);
+    assert!(parsed.observations.is_empty());
+}
+
+#[test]
+fn missing_and_review_models_keep_their_recorded_uncertainty() {
+    let parsed = parse_values(&[snapshot()]);
+    assert_eq!(parsed.models, ["unknown model"]);
+    assert_eq!(parsed.events[0].tokens.total, 150);
+    for model in ["codex-auto-review", "custom \"model\""] {
+        let mut value = context();
+        value["payload"]["model"] = json!(model);
+        let parsed = parse_values(&[value, snapshot()]);
+        assert_eq!(parsed.models, [model]);
+        assert_eq!(parsed.events[0].tokens.total, 150);
+    }
+}
+
+#[test]
+fn explicit_inheritance_requires_usage_ordinals() {
+    let text = format!("{}\n{}\n", context(), snapshot());
+    let parsed = read_lines(std::io::Cursor::new(text), Some(4)).unwrap();
+    assert!(parsed.events.is_empty());
+    assert_eq!(parsed.malformed, 1);
+}
