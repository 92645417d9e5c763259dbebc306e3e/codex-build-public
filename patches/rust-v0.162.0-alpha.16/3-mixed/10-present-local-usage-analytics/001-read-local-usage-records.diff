+use super::*;
+use pretty_assertions::assert_eq;
+
+#[test]
+fn explicit_standard_tier_wins_conflicting_copies() {
+    assert_eq!(
+        Tier::merge(Some(Tier::Fast), Some(Tier::Standard)),
+        Some(Tier::Standard)
+    );
+    assert_eq!(
+        Tier::merge(Some(Tier::Standard), Some(Tier::Fast)),
