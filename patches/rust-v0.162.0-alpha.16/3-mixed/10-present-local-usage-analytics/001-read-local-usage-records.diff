+use super::types::Observation;
+use super::types::Tier;
+use super::types::Tokens;
+use chrono::DateTime;
+use serde::Deserialize;
+use std::borrow::Cow;
+use std::io::BufRead;
+
+#[derive(Debug)]
+pub(super) struct Event {
+    pub(super) millis: i64,
+    pub(super) model: usize,
+    pub(super) tokens: Tokens,
+    pub(super) tier: Option<Tier>,
+}
+
+#[derive(Default)]
+pub(super) struct ParsedFile {
+    pub(super) events: Vec<Event>,
+    pub(super) models: Vec<String>,
+    pub(super) observations: Vec<(usize, Observation)>,
+    pub(super) first_usage_times: Vec<i64>,
+    pub(super) inherited_events: usize,
+    pub(super) malformed: usize,
+    pub(super) incomplete: usize,
+}
+
+#[derive(Deserialize)]
+struct Entry<'a> {
+    #[serde(rename = "type")]
+    kind: &'a str,
+    timestamp: Option<&'a str>,
+    ordinal: Option<u64>,
+    #[serde(borrow)]
+    payload: Payload<'a>,
+}
+
+#[derive(Deserialize)]
+struct Payload<'a> {
+    #[serde(rename = "type")]
+    kind: Option<&'a str>,
+    #[serde(borrow)]
+    model: Option<Cow<'a, str>>,
+    info: Option<Info>,
+    #[serde(borrow)]
+    thread_settings: Option<Settings<'a>>,
+    rate_limits: Option<Limits>,
+}
+
+#[derive(Deserialize)]
+struct Settings<'a> {
+    service_tier: Option<&'a str>,
+}
+
+#[derive(Deserialize)]
+struct Limits {
+    primary: Option<Limit>,
+}
+
+#[derive(Deserialize)]
+struct Limit {
+    window_minutes: Option<i64>,
+    used_percent: f64,
+    resets_at: Option<i64>,
+}
+
+#[derive(Deserialize)]
+struct Info {
+    total_token_usage: Option<WireTokens>,
+    last_token_usage: Option<WireTokens>,
+}
+
+#[derive(Default, Deserialize)]
+#[serde(default)]
+struct WireTokens {
+    input_tokens: i64,
+    cached_input_tokens: i64,
+    cache_write_input_tokens: i64,
+    output_tokens: i64,
+    reasoning_output_tokens: i64,
+    total_tokens: i64,
+}
+
+impl WireTokens {
+    fn tokens(self) -> Tokens {
+        // Migrated canonical logs can preserve negative provider counters.
+        // Discard that field, not the remaining valid usage.
+        let input = self.input_tokens.max(0) as u64;
+        let output = self.output_tokens.max(0) as u64;
+        let cached = (self.cached_input_tokens.max(0) as u64).min(input);
+        Tokens {
+            input,
+            cached,
+            cache_write: (self.cache_write_input_tokens.max(0) as u64).min(input - cached),
+            output,
+            reasoning: self.reasoning_output_tokens.max(0) as u64,
+            total: if self.total_tokens <= 0 {
+                input.saturating_add(output)
+            } else {
+                self.total_tokens as u64
+            },
+        }
+    }
+}
+
+pub(super) fn timestamp(value: &str) -> Option<i64> {
+    Some(DateTime::parse_from_rfc3339(value).ok()?.timestamp_millis())
+}
+
+pub(super) fn intern_model(models: &mut Vec<String>, model: Cow<'_, str>) -> usize {
+    let text = model.trim();
+    if let Some(index) = models.iter().position(|known| known == text) {
+        return index;
+    }
+    let index = models.len();
+    models.push(if text.len() == model.len() {
+        model.into_owned()
+    } else {
+        text.to_owned()
+    });
+    index
+}
+
+pub(super) fn read_lines(
+    mut reader: impl BufRead,
+    own_start: Option<u64>,
+) -> Result<ParsedFile, super::Error> {
+    let mut line = String::new();
+    let mut parsed = ParsedFile::default();
+    let mut previous = None;
+    let mut model = None;
+    let mut tier = None;
+    loop {
+        line.clear();
+        if reader.read_line(&mut line)? == 0 {
+            break;
+        }
+        if !line.ends_with('\n') {
+            parsed.incomplete += 1;
+            break;
+        }
+        if !["token_count", "turn_context", "thread_settings_applied"]
+            .iter()
+            .any(|kind| line.contains(kind))
+        {
+            continue;
+        }
+        let value: Entry<'_> = match serde_json::from_str(&line) {
+            Ok(value) => value,
+            Err(_) => {
+                parsed.malformed += 1;
+                continue;
+            }
+        };
+        let payload = value.payload;
+        match value.kind {
+            "turn_context" => {
+                if let Some(recorded) = payload.model.filter(|model| !model.trim().is_empty()) {
+                    model = Some(intern_model(&mut parsed.models, recorded));
+                }
+            }
+            "event_msg" => match payload.kind {
+                Some("thread_settings_applied") => {
+                    if let Some(recorded) = payload
+                        .thread_settings
+                        .and_then(|settings| settings.service_tier)
+                    {
+                        tier = Tier::read_str(recorded);
+                    }
+                }
+                Some("token_count") => {
+                    let Some((recorded, millis)) = value
+                        .timestamp
+                        .and_then(|text| timestamp(text).map(|millis| (text, millis)))
+                    else {
+                        parsed.malformed += 1;
+                        continue;
+                    };
+                    let Some(info) = payload.info else {
+                        continue;
+                    };
+                    let cumulative = info.total_token_usage.map(WireTokens::tokens);
+                    let last = info.last_token_usage.map(WireTokens::tokens);
+                    if (cumulative.is_some() || last.is_some())
+                        && parsed.first_usage_times.len() < 2
+                    {
+                        parsed.first_usage_times.push(millis);
+                    }
+                    let advanced = cumulative.is_none() || cumulative != previous;
+                    let tokens = last.filter(|_| advanced).or_else(|| {
+                        cumulative.map(|current| current.subtract(previous.unwrap_or_default()))
+                    });
+                    if cumulative.is_some() {
+                        previous = cumulative;
+                    }
+                    let Some(tokens) = tokens.filter(|tokens| !tokens.is_empty()) else {
+                        continue;
+                    };
+                    if own_start.is_some() && value.ordinal.is_none() {
+                        parsed.malformed += 1;
+                        continue;
+                    }
+                    if let Some(recorded) = payload.model.filter(|model| !model.trim().is_empty()) {
+                        model = Some(intern_model(&mut parsed.models, recorded));
+                    }
+                    // Preserve the recorded identity. Missing model metadata is not proof
+                    // of a default model or a date-derived reviewer backend.
+                    let model_id = model.unwrap_or_else(|| {
+                        intern_model(&mut parsed.models, "unknown model".into())
+                    });
+                    if let Some(limits) = payload.rate_limits.and_then(|limits| limits.primary)
+                        && limits.window_minutes == Some(10_080)
+                        && (0.0..=100.0).contains(&limits.used_percent)
+                        && let Some(resets_at) = limits.resets_at
+                    {
+                        parsed.observations.push((
+                            parsed.events.len(),
+                            Observation {
+                                timestamp: recorded.to_owned(),
+                                millis,
+                                used_percent: limits.used_percent,
+                                resets_at,
+                            },
+                        ));
+                    }
+                    if own_start
+                        .is_some_and(|start| value.ordinal.is_some_and(|ordinal| ordinal < start))
+                    {
+                        parsed.inherited_events += 1;
+                    }
+                    parsed.events.push(Event {
+                        millis,
+                        model: model_id,
+                        tokens,
+                        tier,
+                    });
+                }
+                _ => {}
+            },
+            _ => {}
+        }
+    }
+    Ok(parsed)
+}
