+#[tokio::test]
+async fn connected_client_count_is_shown_only_in_fullscreen_status_line() {
+    use crate::bottom_pane::StatusLineItem::ActiveClients;
+    let (mut chat, _rx, _ops) = make_chatwidget_manual(/*model_override*/ None).await;
+    chat.local_settings.tui.fullscreen_transcript = true;
+    assert!(
+        chat.status_surface_preview_data()
+            .status_line_for_items([ActiveClients], true)
+            .is_none()
+    );
+    chat.set_app_server_connected_client_count(3);
+    assert_eq!(
+        chat.status_line_value_for_item(crate::bottom_pane::StatusLineItem::ActiveClients),
+        Some("3".to_string())
+    );
+    for colors in [false, true] {
+        let preview = chat
+            .status_surface_preview_data()
+            .status_line_for_items([ActiveClients], colors);
+        let live = crate::bottom_pane::status_line_from_segments(
+            [(ActiveClients, "3".to_string())],
+            colors,
+            chat.thread_id,
+            crate::bottom_pane::StatusLineDetails::default(),
+        );
+        assert_eq!(preview, live);
+    }
+
+    chat.local_settings.tui.fullscreen_transcript = false;
+    assert_eq!(
+        chat.status_line_value_for_item(crate::bottom_pane::StatusLineItem::ActiveClients),
+        None
+    );
+    assert!(
+        chat.status_surface_preview_data()
+            .status_line_for_items([ActiveClients], true)
+            .is_none()
+    );
+    chat.local_settings.tui.fullscreen_transcript = true;
+    chat.clear_app_server_connected_client_count();
+    assert_eq!(chat.app_server_connected_client_count(), None);
+    assert!(
+        chat.status_surface_preview_data()
+            .status_line_for_items([ActiveClients], true)
+            .is_none()
+    );
+}
