+#[tokio::test]
+async fn connected_client_count_routes_globally_and_clears_on_disconnect() -> Result<()> {
+    let (mut app, _events, _ops) = make_test_app_with_channels().await;
+    let app_server = crate::start_embedded_app_server_for_picker(&app.config).await?;
+    app.handle_app_server_event(
+        &app_server,
+        AppServerEvent::ServerNotification(Box::new(
+            ServerNotification::ConnectedClientCountChanged(
+                ConnectedClientCountChangedNotification {
+                    connected_client_count: 3,
+                },
+            ),
+        )),
+    )
+    .await;
+    assert_eq!(app.chat_widget.app_server_connected_client_count(), Some(3));
+    app.handle_app_server_event(
+        &app_server,
+        AppServerEvent::Disconnected {
+            message: "closed".to_string(),
+        },
+    )
+    .await;
+    assert_eq!(app.chat_widget.app_server_connected_client_count(), None);
+    app_server.shutdown().await?;
+    Ok(())
+}
