+/// Ask a managed local daemon to stop only if no turn is running or being admitted.
+pub async fn request_idle_shutdown(socket_path: &Path) -> Result<bool> {
+    timeout(CONTROL_SOCKET_RESPONSE_TIMEOUT, async {
+        let mut websocket =
+            connect_at(socket_path, "ws://localhost/daemon/shutdown-if-idle").await?;
+        websocket
+            .send(Message::Text("shutdown-if-idle".into()))
+            .await?;
+        let reply = websocket
+            .next()
+            .await
+            .context("idle-shutdown socket closed without a decision")??;
+        let accepted = match reply {
+            Message::Text(text) if text == "stopped" => true,
+            Message::Text(text) if text == "busy" => false,
+            other => return Err(anyhow!("unexpected idle-shutdown decision: {other:?}")),
+        };
+        websocket.close(None).await?;
+        Ok(accepted)
+    })
+    .await
+    .context("timed out waiting for managed app-server idle-shutdown decision")?
+}
