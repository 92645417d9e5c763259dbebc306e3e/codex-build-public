+async fn run_daemon_idle_shutdown(
+    mut websocket: tokio_tungstenite::WebSocketStream<UnixStream>,
+    transport_event_tx: mpsc::Sender<TransportEvent>,
+) {
+    if !matches!(websocket.next().await, Some(Ok(Message::Text(request))) if request == "shutdown-if-idle")
+    {
+        return;
+    }
+    let (response, result) = oneshot::channel();
+    let (acknowledgment, acknowledged) = oneshot::channel();
+    if transport_event_tx
+        .send(TransportEvent::DaemonIdleShutdown {
+            response,
+            acknowledged,
+        })
+        .await
+        .is_err()
+    {
+        return;
+    }
+    let Ok(accepted) = result.await else {
+        return;
+    };
+    let reply = if accepted { "stopped" } else { "busy" };
+    if websocket.send(Message::Text(reply.into())).await.is_ok() {
+        match tokio::time::timeout(Duration::from_secs(2), websocket.next()).await {
+            Ok(Some(Err(error))) => warn!("idle-shutdown close handshake failed: {error}"),
+            Ok(Some(Ok(_))) | Ok(None) | Err(_) => {}
+        }
+    }
+    if accepted && acknowledgment.send(()).is_err() {
+        warn!("idle-shutdown receiver stopped before socket acknowledgment");
+    }
+}
