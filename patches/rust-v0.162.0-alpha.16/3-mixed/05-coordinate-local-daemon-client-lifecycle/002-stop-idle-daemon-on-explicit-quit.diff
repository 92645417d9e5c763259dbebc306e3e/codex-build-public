+#[test]
+fn idle_drain_refuses_admissions_and_turns_without_closing_a_busy_gate() {
+    let admission = TurnAdmission::default();
+    let (running, running_turn_count) = watch::channel(0);
+    let in_flight = admission.admit().expect("request admitted");
+    assert!(!admission.begin_drain_if_idle(&running_turn_count));
+    let automatic = admission
+        .admit_turn_start()
+        .expect("busy refusal preserves admission");
+    running.send_replace(1);
+    drop(in_flight);
+    drop(automatic);
+    assert!(!admission.begin_drain_if_idle(&running_turn_count));
+    let permit = admission
+        .admit()
+        .expect("running refusal preserves admission");
+    drop(permit);
+    running.send_replace(0);
+    assert!(admission.begin_drain_if_idle(&running_turn_count));
+    assert!(admission.admit().is_err());
+    assert!(admission.admit_turn_start().is_none());
+    assert!(!admission.begin_drain_if_idle(&running_turn_count));
+}
 
