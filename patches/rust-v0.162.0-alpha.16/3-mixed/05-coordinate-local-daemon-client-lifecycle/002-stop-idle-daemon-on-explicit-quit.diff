+    /// Decide idle shutdown and reject later submissions under the same admission lock.
+    pub(crate) fn begin_drain_if_idle(&self, running_turn_count: &watch::Receiver<usize>) -> bool {
+        let mut state = self
+            .state
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
+        // An admitted submission can publish its running turn before releasing its permit.
+        // Checking active work first under this lock also prevents a new admission between
+        // observing idle and closing the gate.
+        if state.closed || state.active != 0 || *running_turn_count.borrow() != 0 {
+            return false;
+        }
+        state.closed = true;
+        true
+    }
+
     pub(crate) fn subscribe_active(&self) -> watch::Receiver<usize> {
         self.active_tx.subscribe()
     }
