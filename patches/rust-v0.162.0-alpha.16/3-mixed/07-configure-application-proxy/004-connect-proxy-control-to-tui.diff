diff --git a/codex-rs/tui/src/app_server_session/proxy_bootstrap_tests.rs b/codex-rs/tui/src/app_server_session/proxy_bootstrap_tests.rs
new file mode 100644
--- /dev/null
+++ b/codex-rs/tui/src/app_server_session/proxy_bootstrap_tests.rs
@@ -0,0 +1,62 @@
+use super::*;
+use crate::legacy_core::config::ConfigBuilder;
+use codex_app_server_protocol::JSONRPCMessage;
+use futures::SinkExt;
+use futures::StreamExt;
+use pretty_assertions::assert_eq;
+use serde_json::json;
+use tokio::net::TcpListener;
+use tokio_tungstenite::tungstenite::Message;
+
+#[tokio::test]
+async fn proxy_read_failure_is_reported_instead_of_a_disabled_status() -> Result<()> {
+    let codex_home = tempfile::tempdir()?;
+    let mut config = ConfigBuilder::default()
+        .codex_home(codex_home.path().to_path_buf())
+        .build()
+        .await?;
+    config.model = Some("fixture-model".to_owned());
+    let listener = TcpListener::bind("127.0.0.1:0").await?;
+    let endpoint = crate::resolve_remote_addr(&format!("ws://{}", listener.local_addr()?))?;
+    let server = tokio::spawn(async move {
+        let (stream, _) = listener.accept().await?;
+        let mut socket = tokio_tungstenite::accept_async(stream).await?;
+        let mut proxy_reads = 0;
+        while let Some(Ok(Message::Text(text))) = socket.next().await {
+            let JSONRPCMessage::Request(request) = serde_json::from_str(&text)? else {
+                continue;
+            };
+            let mut reply = match request.method.as_str() {
+                "initialize" => json!({"result": {"userAgent": "proxy-bootstrap-test"}}),
+                "account/read" => {
+                    json!({"result": {"account": null, "requiresOpenaiAuth": false}})
+                }
+                "model/list" => json!({"result": {"data": [], "nextCursor": null}}),
+                "collaborationMode/list" => json!({"result": {"data": []}}),
+                "configRequirements/read" => json!({"result": {"requirements": null}}),
+                "proxy/read" => {
+                    proxy_reads += 1;
+                    json!({"error": {"code": -32603, "message": "proxy state unavailable"}})
+                }
+                method => panic!("unexpected bootstrap request: {method}"),
+            };
+            reply["id"] = json!(request.id);
+            socket.send(Message::Text(reply.to_string().into())).await?;
+        }
+        Ok::<_, color_eyre::Report>(proxy_reads)
+    });
+    let mut session = AppServerSession::new(
+        crate::connect_remote_app_server(endpoint).await?,
+        ThreadParamsMode::Remote,
+    );
+    let error = match session.bootstrap(&config).await {
+        Ok(_) => panic!("a failed proxy read must not become a disabled status"),
+        Err(error) => error,
+    };
+    let message = error.to_string();
+    assert!(message.contains("proxy/read failed"));
+    assert!(message.contains("proxy state unavailable"));
+    session.shutdown().await?;
+    assert_eq!(server.await??, 1);
+    Ok(())
+}
