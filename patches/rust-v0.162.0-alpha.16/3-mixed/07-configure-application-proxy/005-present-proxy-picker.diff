+
+fn test_view(
+    config: ProxyConfig,
+) -> (
+    ProxyPickerView,
+    tokio::sync::mpsc::UnboundedReceiver<AppEvent>,
+) {
+    let (tx, rx) = unbounded_channel();
+    (
+        ProxyPickerView::new(
+            config,
+            AppEventSender::new(tx),
+            crate::keymap::RuntimeKeymap::defaults().list,
+            FrameRequester::test_dummy(),
+        ),
+        rx,
+    )
+}
+
+fn render(view: &ProxyPickerView) -> (Buffer, String) {
+    let area = Rect::new(0, 0, 80, view.desired_height(80));
+    let mut buffer = Buffer::empty(area);
+    view.render(area, &mut buffer);
+    let text = buffer.content.iter().map(|cell| cell.symbol()).collect();
+    (buffer, text)
+}
+
+fn alias_cell(buffer: &Buffer) -> &ratatui::buffer::Cell {
+    let y = (0..buffer.area.height)
+        .find(|&y| {
+            (0..buffer.area.width)
+                .map(|x| buffer[(x, y)].symbol())
+                .collect::<String>()
+                .contains("stable-lan")
+        })
+        .expect("proxy row");
+    &buffer[(8, y)]
+}
+
+fn configuration() -> ProxyConfig {
+    ProxyConfig {
+        enabled: false,
+        selected: None,
+        entries: vec![
+            ProxyDefinition {
+                alias: "stable-lan".to_string(),
+                url: "http://192.0.2.1:8080".to_string(),
+            },
+            ProxyDefinition {
+                alias: "backup".to_string(),
+                url: "https://user:secret@192.0.2.2:8443".to_string(),
+            },
+        ],
+    }
+}
+
+#[test]
+fn proxy_picker_stages_selection_and_deletion_until_apply() {
+    let (mut view, mut rx) = test_view(configuration());
+    view.handle_key_event(KeyEvent::new(KeyCode::Char(' '), KeyModifiers::NONE));
+    view.handle_key_event(KeyEvent::new(KeyCode::Down, KeyModifiers::NONE));
+    view.handle_key_event(KeyEvent::new(KeyCode::Char('d'), KeyModifiers::NONE));
+    assert!(rx.try_recv().is_err());
+    view.handle_key_event(KeyEvent::new(KeyCode::Enter, KeyModifiers::NONE));
+    let AppEvent::WriteProxyConfig {
+        config,
+        reopen_picker,
+    } = rx.try_recv().expect("apply")
+    else {
+        panic!("unexpected event");
+    };
+    let mut expected = configuration();
+    expected.enabled = true;
+    expected.selected = Some("backup".to_string());
+    expected.entries.remove(0);
+    assert_eq!(config, expected);
+    assert!(!reopen_picker);
+    assert!(view.is_complete());
+
+    let (mut view, mut rx) = test_view(configuration());
+    view.handle_key_event(KeyEvent::new(KeyCode::Char(' '), KeyModifiers::NONE));
+    view.handle_key_event(KeyEvent::new(KeyCode::Esc, KeyModifiers::NONE));
+    assert!(rx.try_recv().is_err());
+    assert!(view.is_complete());
+}
+
+#[test]
+fn proxy_picker_renders_enabled_and_disabled_selection() {
+    let (mut view, _rx) = test_view(configuration());
+    view.config.selected = Some("stable-lan".to_string());
+    for enabled in [false, true] {
+        if enabled {
+            view.handle_key_event(KeyEvent::from(KeyCode::Char(' ')));
+            view.handle_key_event(KeyEvent::from(KeyCode::Down));
+        }
+        let (buffer, text) = render(&view);
+        assert!(text.contains("[x] stable-lan"));
+        assert!(text.contains("Testing..."));
+        assert!(!text.contains("secret"));
+        assert!(!text.contains("Disabled"));
+        assert!(!text.contains("shell commands"));
+        let alias = alias_cell(&buffer);
+        assert_eq!(
+            alias.modifier.contains(ratatui::style::Modifier::DIM),
+            !enabled
+        );
+        if enabled {
+            let selected = super::super::picker_style::selection_style();
+            assert_eq!(
+                alias.bg,
+                selected.bg.unwrap_or(ratatui::style::Color::Reset)
+            );
+            assert_eq!(
+                alias.modifier.contains(ratatui::style::Modifier::REVERSED),
+                selected
+                    .add_modifier
+                    .contains(ratatui::style::Modifier::REVERSED)
+            );
+        }
+    }
+}
+
+#[test]
+fn proxy_picker_uses_configured_list_keys_and_ignores_release_events() {
+    let (mut view, mut rx) = test_view(configuration());
+    view.keymap.accept = vec![key_hint::plain(KeyCode::Char('x'))];
+    view.keymap.cancel = vec![key_hint::plain(KeyCode::Char('z'))];
+    let space = KeyEvent::new(KeyCode::Char(' '), KeyModifiers::NONE);
+    view.handle_key_event(space);
+    view.handle_key_event(KeyEvent {
+        kind: KeyEventKind::Release,
+        ..space
+    });
+    assert!(view.config.enabled);
+    assert!(rx.try_recv().is_err());
+    let (_, text) = render(&view);
+    assert!(text.contains("x apply"));
+    assert!(text.contains("z cancel"));
+    view.handle_key_event(KeyEvent::from(KeyCode::Enter));
+    assert!(!view.is_complete());
+    view.handle_key_event(KeyEvent::from(KeyCode::Char('x')));
+    assert!(
+        matches!(rx.try_recv(), Ok(AppEvent::WriteProxyConfig { config, .. }) if config.enabled)
+    );
+}
+
+#[test]
+fn deleting_a_scrolled_selected_proxy_keeps_selection_visible_and_disables_the_last_entry() {
+    let config = ProxyConfig {
+        entries: (0..25)
+            .map(|index| ProxyDefinition {
+                alias: format!("proxy-{index}"),
+                url: "http://127.0.0.1:8080".to_string(),
+            })
+            .collect(),
+        ..Default::default()
+    };
+    let (mut view, mut rx) = test_view(config);
+    view.handle_key_event(KeyEvent::from(KeyCode::Char(' ')));
+    view.handle_key_event(KeyEvent::from(KeyCode::Up));
+    view.handle_key_event(KeyEvent::from(KeyCode::Char(' ')));
+    assert_eq!(view.config.selected.as_deref(), Some("proxy-24"));
+    assert!(view.state.scroll_top > 0);
+    while !view.config.entries.is_empty() {
+        view.handle_key_event(KeyEvent::from(KeyCode::Char('d')));
+        if !view.config.entries.is_empty() {
+            let selected = view.state.selected_idx.expect("remaining proxy row");
+            assert!(selected < 1 + view.config.entries.len());
+            assert!(selected >= view.state.scroll_top);
+            assert!(selected < view.state.scroll_top + MAX_POPUP_ROWS);
+        }
+        assert!(rx.try_recv().is_err());
+    }
+    assert_eq!(view.config, ProxyConfig::default());
+    assert_eq!(view.state.scroll_top, 0);
+    assert_eq!(view.state.selected_idx, None);
+    assert!(view.rows().is_empty());
+    view.handle_key_event(KeyEvent::from(KeyCode::Enter));
+    assert!(
+        matches!(rx.try_recv(), Ok(AppEvent::WriteProxyConfig { config, .. }) if config == ProxyConfig::default())
+    );
+}
+
+#[test]
+fn empty_proxy_picker_shows_add_guidance_without_inactive_controls() {
+    let (mut view, mut rx) = test_view(ProxyConfig::default());
+    for code in [
+        KeyCode::Down,
+        KeyCode::Up,
+        KeyCode::Char(' '),
+        KeyCode::Char('d'),
+    ] {
+        view.handle_key_event(KeyEvent::from(code));
+    }
+    assert_eq!(view.state.selected_idx, None);
+    assert_eq!(view.config, ProxyConfig::default());
+    let (_, text) = render(&view);
+    assert!(text.contains("No proxy configured. Press a to add one."));
+    assert!(!text.contains("Enabled"));
+    assert!(!text.contains("toggle"));
+    assert!(!text.contains("delete"));
+    assert!(rx.try_recv().is_err());
+    view.handle_key_event(KeyEvent::from(KeyCode::Char('a')));
+    assert!(
+        matches!(rx.try_recv(), Ok(AppEvent::OpenProxyAddAlias { config }) if config == ProxyConfig::default())
+    );
+}
+
+#[test]
+fn adding_from_the_picker_preserves_the_staged_configuration_without_writing() {
+    let (mut view, mut rx) = test_view(configuration());
+    view.handle_key_event(KeyEvent::from(KeyCode::Char(' ')));
+    view.handle_key_event(KeyEvent::from(KeyCode::Char('a')));
+    let Ok(AppEvent::OpenProxyAddAlias { config }) = rx.try_recv() else {
+        panic!("expected alias step")
+    };
+    assert!(config.enabled);
+    assert_eq!(config.selected.as_deref(), Some("stable-lan"));
+    assert!(view.is_complete());
+    assert!(rx.try_recv().is_err());
+}
+
+#[test]
+fn proxy_trace_identity_requires_ip_and_location() {
+    assert_eq!(
+        parse_proxy_identity("fl=1\nip=203.0.113.7\nloc=SG\n"),
+        Ok(("203.0.113.7".to_string(), "SG".to_string()))
+    );
+    assert!(parse_proxy_identity("ip=203.0.113.7\n").is_err());
+}
