@@ -0,0 +1,57 @@
+use codex_app_server_protocol::ProxyConfig;
+use codex_app_server_protocol::ProxyDefinition;
+
+use super::*;
+use crate::bottom_pane::ProxyPickerView;
+use crate::bottom_pane::custom_prompt_view::CustomPromptView;
+
+impl ChatWidget {
+    pub(crate) fn open_proxy_menu(&mut self, config: ProxyConfig) {
+        self.bottom_pane.show_view(Box::new(ProxyPickerView::new(
+            config,
+            self.app_event_tx.clone(),
+            self.bottom_pane.list_keymap(),
+            self.frame_requester.clone(),
+        )));
+    }
+
+    pub(crate) fn open_proxy_add_alias(&mut self, config: ProxyConfig) {
+        let tx = self.app_event_tx.clone();
+        self.bottom_pane.show_view(Box::new(CustomPromptView::new(
+            "Add proxy".to_string(),
+            "Enter an alias".to_string(),
+            String::new(),
+            Some("This alias appears in /proxy and the status line.".to_string()),
+            Box::new(move |alias| {
+                let alias = alias.trim();
+                if !alias.is_empty() {
+                    tx.send(AppEvent::OpenProxyAddUrl {
+                        config: config.clone(),
+                        alias: alias.to_string(),
+                    });
+                }
+            }),
+        )));
+    }
+
+    pub(crate) fn open_proxy_add_url(&mut self, config: ProxyConfig, alias: String) {
+        let tx = self.app_event_tx.clone();
+        self.bottom_pane.show_view(Box::new(CustomPromptView::new(
+            "Add proxy".to_string(),
+            "Enter an http:// or https:// proxy URL".to_string(),
+            String::new(),
+            Some(format!("Alias: {alias}")),
+            Box::new(move |url| {
+                let mut config = config.clone();
+                config.entries.push(ProxyDefinition {
+                    alias: alias.clone(),
+                    url: url.trim().to_string(),
+                });
+                tx.send(AppEvent::WriteProxyConfig {
+                    config,
+                    reopen_picker: true,
+                });
+            }),
+        )));
+    }
+}
