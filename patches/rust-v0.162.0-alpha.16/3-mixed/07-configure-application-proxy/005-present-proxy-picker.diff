@@ -0,0 +1,72 @@
+use super::*;
+use codex_app_server_protocol::ProxyConfig;
+use codex_app_server_protocol::ProxyDefinition;
+
+#[tokio::test]
+async fn proxy_slash_command_opens_the_picker_without_writing_configuration() {
+    let (mut chat, mut rx, mut ops) = make_chatwidget_manual(None).await;
+    chat.dispatch_command(SlashCommand::Proxy);
+    assert_matches!(rx.try_recv(), Ok(AppEvent::OpenProxy));
+    assert!(rx.try_recv().is_err());
+    assert!(ops.try_recv().is_err());
+}
+
+#[tokio::test]
+async fn adding_a_proxy_uses_real_prompt_callbacks_and_preserves_staged_settings() {
+    let (mut chat, mut rx, _ops) = make_chatwidget_manual(None).await;
+    let config = ProxyConfig {
+        enabled: true,
+        selected: Some("existing".to_string()),
+        entries: vec![ProxyDefinition {
+            alias: "existing".to_string(),
+            url: "http://127.0.0.1:8080".to_string(),
+        }],
+    };
+    chat.open_proxy_add_alias(config.clone());
+    chat.handle_paste("  backup  ".to_string());
+    chat.handle_key_event(KeyEvent::from(KeyCode::Enter));
+    let AppEvent::OpenProxyAddUrl {
+        config: staged,
+        alias,
+    } = rx.try_recv().expect("URL step")
+    else {
+        panic!("expected URL step")
+    };
+    assert_eq!(staged, config);
+    assert_eq!(alias, "backup");
+    assert!(rx.try_recv().is_err());
+    chat.open_proxy_add_url(staged, alias);
+    chat.handle_paste(" https://user:secret@127.0.0.1:8443 ".to_string());
+    chat.handle_key_event(KeyEvent::from(KeyCode::Enter));
+    let AppEvent::WriteProxyConfig {
+        config: written,
+        reopen_picker,
+    } = rx.try_recv().expect("write")
+    else {
+        panic!("expected write")
+    };
+    let mut expected = config;
+    expected.entries.push(ProxyDefinition {
+        alias: "backup".to_string(),
+        url: "https://user:secret@127.0.0.1:8443".to_string(),
+    });
+    assert_eq!(written, expected);
+    assert!(reopen_picker);
+    assert!(!format!("{written:?}").contains("secret"));
+    assert!(rx.try_recv().is_err());
+}
+
+#[tokio::test]
+async fn cancelled_proxy_alias_and_url_prompts_do_not_write() {
+    for url_step in [false, true] {
+        let (mut chat, mut rx, _ops) = make_chatwidget_manual(None).await;
+        if url_step {
+            chat.open_proxy_add_url(ProxyConfig::default(), "lan".to_string());
+        } else {
+            chat.open_proxy_add_alias(ProxyConfig::default());
+        }
+        chat.handle_paste("unfinished".to_string());
+        chat.handle_key_event(KeyEvent::from(KeyCode::Esc));
+        assert!(rx.try_recv().is_err());
+    }
+}
