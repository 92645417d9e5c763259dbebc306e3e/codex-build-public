+use codex_app_server_protocol::ProxyConfig;
+use codex_http_client::HttpClientFactory;
+use codex_http_client::OutboundProxyPolicy;
+use crossterm::event::KeyCode;
+use crossterm::event::KeyEvent;
+use ratatui::buffer::Buffer;
+use ratatui::layout::Constraint;
+use ratatui::layout::Layout;
+use ratatui::layout::Rect;
+use ratatui::style::Stylize;
+use ratatui::text::Line;
+use ratatui::widgets::Block;
+use ratatui::widgets::Paragraph;
+use ratatui::widgets::Widget;
+use std::collections::BTreeMap;
+use std::sync::Arc;
+use std::sync::Mutex;
+use std::time::Duration;
+use std::time::Instant;
+
+use crate::app_event::AppEvent;
+use crate::app_event_sender::AppEventSender;
+use crate::key_hint;
+use crate::key_hint::KeyBindingListExt;
+use crate::keymap::ListAction;
+use crate::keymap::ListKeymap;
+use crate::render::Insets;
+use crate::render::RectExt as _;
+use crate::render::renderable::Renderable;
+use crate::style::user_message_style;
+use crate::tui::FrameRequester;
+
+use super::CancellationEvent;
+use super::bottom_pane_view::BottomPaneView;
+use super::picker_rows::measure_rows_height;
+use super::picker_rows::render_rows;
+use super::popup_consts::MAX_POPUP_ROWS;
+use super::scroll_state::ScrollState;
+use super::selection_popup_common::GenericDisplayRow;
+use super::selection_popup_common::wrap_styled_line;
+
+const TRACE_URL: &str = "https://www.cloudflare.com/cdn-cgi/trace";
+const PROXY_PROBE_TIMEOUT: Duration = Duration::from_secs(10);
+
+pub(crate) struct ProxyPickerView {
+    config: ProxyConfig,
+    state: ScrollState,
+    complete: bool,
+    app_event_tx: AppEventSender,
+    keymap: ListKeymap,
+    probe_descriptions: Arc<Mutex<BTreeMap<String, String>>>,
+    probe_tasks: Vec<tokio::task::JoinHandle<()>>,
+}
+
+impl ProxyPickerView {
+    pub(crate) fn new(
+        config: ProxyConfig,
+        app_event_tx: AppEventSender,
+        keymap: ListKeymap,
+        frame_requester: FrameRequester,
+    ) -> Self {
+        let mut state = ScrollState::new();
+        state.selected_idx = (!config.entries.is_empty()).then_some(0);
+        let probe_descriptions = Arc::new(Mutex::new(
+            config
+                .entries
+                .iter()
+                .map(|proxy| (proxy.alias.clone(), "Testing...".to_string()))
+                .collect(),
+        ));
+        let view = Self {
+            config,
+            state,
+            complete: false,
+            app_event_tx,
+            keymap,
+            probe_descriptions,
+            probe_tasks: Vec::new(),
+        };
+        #[cfg(not(test))]
+        {
+            let mut view = view;
+            view.start_probes(frame_requester);
+            view
+        }
+        #[cfg(test)]
+        {
+            let _ = frame_requester;
+            view
+        }
+    }
+
+    fn start_probes(&mut self, frame_requester: FrameRequester) {
+        for proxy in &self.config.entries {
+            let alias = proxy.alias.clone();
+            let proxy_url = proxy.url.clone();
+            let descriptions = Arc::clone(&self.probe_descriptions);
+            let frame_requester = frame_requester.clone();
+            self.probe_tasks.push(tokio::spawn(async move {
+                let description = probe_proxy_identity(&proxy_url)
+                    .await
+                    .map(|(ip, location, latency_ms)| {
+                        format!("{ip} | {location} | {latency_ms} ms")
+                    })
+                    .unwrap_or_else(|_| "Unavailable".to_string());
+                descriptions
+                    .lock()
+                    .expect("proxy probe descriptions")
+                    .insert(alias, description);
+                frame_requester.schedule_frame();
+            }));
+        }
+    }
+
+    fn toggle_or_select(&mut self) {
+        let Some(selected) = self.state.selected_idx else {
+            return;
+        };
+        match selected {
+            0 if self.config.enabled => self.config.enabled = false,
+            0 if !self.config.entries.is_empty() => {
+                if self.config.selected.is_none() {
+                    self.config.selected =
+                        self.config.entries.first().map(|proxy| proxy.alias.clone());
+                }
+                self.config.enabled = true;
+            }
+            0 => {}
+            index => {
+                if let Some(proxy) = self.config.entries.get(index - 1) {
+                    self.config.selected = Some(proxy.alias.clone());
+                }
+            }
+        }
+    }
+
+    fn delete_selected(&mut self) {
+        let Some(index) = self
+            .state
+            .selected_idx
+            .and_then(|index| index.checked_sub(1))
+        else {
+            return;
+        };
+        if index >= self.config.entries.len() {
+            return;
+        }
+        let removed = self.config.entries.remove(index);
+        if self.config.selected.as_deref() == Some(removed.alias.as_str()) {
+            self.config.selected = self.config.entries.first().map(|proxy| proxy.alias.clone());
+        }
+        if self.config.entries.is_empty() {
+            self.config.enabled = false;
+            self.state.reset();
+        } else {
+            self.state.selected_idx = Some((index + 1).min(self.config.entries.len()));
+        }
+        let len = self.row_count();
+        self.state.ensure_visible(len, MAX_POPUP_ROWS.min(len));
+    }
+
+    fn row_count(&self) -> usize {
+        self.config.entries.len() + usize::from(!self.config.entries.is_empty())
+    }
+
+    fn rows(&self) -> Vec<GenericDisplayRow> {
+        if self.config.entries.is_empty() {
+            return Vec::new();
+        }
+        let descriptions = self
+            .probe_descriptions
+            .lock()
+            .expect("proxy probe descriptions");
+        let entries = std::iter::once(("Enabled", self.config.enabled, None)).chain(
+            self.config.entries.iter().map(|proxy| {
+                (
+                    proxy.alias.as_str(),
+                    self.config.selected.as_deref() == Some(proxy.alias.as_str()),
+                    descriptions.get(&proxy.alias).cloned(),
+                )
+            }),
+        );
+        entries
+            .enumerate()
+            .map(|(index, (name, checked, description))| {
+                let focused = self.state.selected_idx == Some(index);
+                let cursor = if focused { '›' } else { ' ' };
+                let indent = if index == 0 { "" } else { "  " };
+                let checkbox = if checked { 'x' } else { ' ' };
+                GenericDisplayRow {
+                    name: format!("{cursor} {indent}[{checkbox}] {name}"),
+                    selection_style: Some(super::picker_style::selection_style()),
+                    wrap_indent: Some(if index == 0 { 6 } else { 8 }),
+                    description,
+                    is_disabled: index > 0 && !self.config.enabled && !focused,
+                    ..Default::default()
+                }
+            })
+            .collect()
+    }
+
+    fn footer_hint(&self) -> Line<'static> {
+        let mut hints = Vec::new();
+        if let Some(selected) = self.state.selected_idx {
+            hints.extend([
+                key_hint::plain(KeyCode::Char(' ')).into(),
+                if selected == 0 {
+                    " toggle · "
+                } else {
+                    " select · "
+                }
+                .dim(),
+            ]);
+        }
+        if let Some(hint) = self.keymap.primary_hint(ListAction::Accept) {
+            hints.extend(hint.spans());
+            hints.push(" apply · ".dim());
+        }
+        hints.extend([key_hint::plain(KeyCode::Char('a')).into(), " add".dim()]);
+        if self.state.selected_idx.is_some_and(|index| index > 0) {
+            hints.extend([
+                " · ".dim(),
+                key_hint::plain(KeyCode::Char('d')).into(),
+                " delete".dim(),
+            ]);
+        }
+        if let Some(hint) = self.keymap.primary_hint(ListAction::Cancel) {
+            hints.push(" · ".dim());
+            hints.extend(hint.spans());
+            hints.push(" cancel".dim());
+        }
+        Line::from(hints)
+    }
+}
+
+impl Drop for ProxyPickerView {
+    fn drop(&mut self) {
+        for task in &self.probe_tasks {
+            task.abort();
+        }
+    }
+}
+
+fn parse_proxy_identity(body: &str) -> Result<(String, String), String> {
+    let field = |name: &str| {
+        body.lines()
+            .find_map(|line| line.strip_prefix(name))
+            .map(str::trim)
+            .filter(|value| !value.is_empty())
+            .map(str::to_string)
+    };
+    let ip = field("ip=").ok_or_else(|| "trace response omitted ip".to_string())?;
+    let location = field("loc=").ok_or_else(|| "trace response omitted loc".to_string())?;
+    Ok((ip, location))
+}
+
+async fn probe_proxy_identity(proxy_url: &str) -> Result<(String, String, u64), String> {
+    let client = HttpClientFactory::new(OutboundProxyPolicy::ReqwestDefault)
+        .build_client_for_proxy_probe(proxy_url)
+        .map_err(|error| error.to_string())?;
+    let started_at = Instant::now();
+    let body = client
+        .get(TRACE_URL)
+        .timeout(PROXY_PROBE_TIMEOUT)
+        .send()
+        .await
+        .map_err(|error| error.to_string())?
+        .error_for_status()
+        .map_err(|error| error.to_string())?
+        .text()
+        .await
+        .map_err(|error| error.to_string())?;
+    let (ip, location) = parse_proxy_identity(&body)?;
+    let latency_ms = started_at
+        .elapsed()
+        .as_millis()
+        .max(1)
+        .min(u128::from(u64::MAX)) as u64;
+    Ok((ip, location, latency_ms))
+}
+
+impl BottomPaneView for ProxyPickerView {
+    fn keymap_contexts(&self) -> crate::keymap::KeymapContextSet {
+        crate::keymap::KeymapContextSet::new(crate::keymap::KeymapContext::List)
+    }
+
+    fn handle_key_event(&mut self, event: KeyEvent) {
+        let len = self.row_count();
+        let visible = MAX_POPUP_ROWS.min(len).max(1);
+        match event {
+            _ if self.keymap.move_up.is_pressed(event) => {
+                self.state.move_up_wrap(len);
+                self.state.ensure_visible(len, visible);
+            }
+            _ if self.keymap.move_down.is_pressed(event) => {
+                self.state.move_down_wrap(len);
+                self.state.ensure_visible(len, visible);
+            }
+            _ if self.keymap.page_up.is_pressed(event) => self.state.page_up_clamped(len, visible),
+            _ if self.keymap.page_down.is_pressed(event) => {
+                self.state.page_down_clamped(len, visible)
+            }
+            _ if self.keymap.jump_top.is_pressed(event) => self.state.jump_top(len, visible),
+            _ if self.keymap.jump_bottom.is_pressed(event) => self.state.jump_bottom(len, visible),
+            _ if key_hint::plain(KeyCode::Char(' ')).is_press(event) => self.toggle_or_select(),
+            _ if key_hint::plain(KeyCode::Char('a')).is_press(event) => {
+                self.app_event_tx.send(AppEvent::OpenProxyAddAlias {
+                    config: self.config.clone(),
+                });
+                self.complete = true;
+            }
+            _ if key_hint::plain(KeyCode::Char('d')).is_press(event) => self.delete_selected(),
+            _ if self.keymap.accept.is_pressed(event) => {
+                self.app_event_tx.send(AppEvent::WriteProxyConfig {
+                    config: self.config.clone(),
+                    reopen_picker: false,
+                });
+                self.complete = true;
+            }
+            _ if self.keymap.cancel.is_pressed(event) => self.complete = true,
+            _ => {}
+        }
+    }
+
+    fn is_complete(&self) -> bool {
+        self.complete
+    }
+
+    fn on_ctrl_c(&mut self) -> CancellationEvent {
+        self.complete = true;
+        CancellationEvent::Handled
+    }
+}
+
+impl Renderable for ProxyPickerView {
+    fn render(&self, area: Rect, buf: &mut Buffer) {
+        if area.is_empty() {
+            return;
+        }
+        let hint = self.footer_hint();
+        let hints = wrap_styled_line(&hint, area.width.saturating_sub(2));
+        let [content, footer] =
+            Layout::vertical([Constraint::Fill(1), Constraint::Length(hints.len() as u16)])
+                .areas(area);
+        Block::default()
+            .style(user_message_style())
+            .render(content, buf);
+        let rows = self.rows();
+        let [header, _, list] = super::picker_rows::layout(
+            content,
+            1,
+            0,
+            measure_rows_height(&rows, &self.state, MAX_POPUP_ROWS, content.width),
+        );
+        Line::from("Proxy".bold()).render(header, buf);
+        render_rows(
+            list,
+            buf,
+            &rows,
+            &self.state,
+            MAX_POPUP_ROWS,
+            "  No proxy configured. Press a to add one.",
+        );
+        Paragraph::new(hints).render(footer.inset(Insets::tlbr(0, 2, 0, 0)), buf);
+    }
+
+    fn desired_height(&self, width: u16) -> u16 {
+        measure_rows_height(&self.rows(), &self.state, MAX_POPUP_ROWS, width)
+            .saturating_add(5)
+            .saturating_add(
+                wrap_styled_line(&self.footer_hint(), width.saturating_sub(2)).len() as u16,
+            )
+    }
+}
