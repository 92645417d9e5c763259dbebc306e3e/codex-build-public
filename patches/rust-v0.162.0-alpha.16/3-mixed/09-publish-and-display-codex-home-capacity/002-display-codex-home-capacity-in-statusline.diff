+fn capacity_severity_color(bytes: u64) -> Color {
+    const MIB: u64 = 1024 * 1024;
+    const CRITICAL: u64 = 512 * MIB;
+    const LOW: u64 = 1024 * MIB;
+    const COMFORTABLE: u64 = 5 * LOW;
+    match bytes {
+        ..CRITICAL => Color::Red,
+        CRITICAL..LOW => Color::Rgb(249, 115, 22),
+        LOW..COMFORTABLE => Color::Yellow,
+        COMFORTABLE.. => Color::Green,
+    }
