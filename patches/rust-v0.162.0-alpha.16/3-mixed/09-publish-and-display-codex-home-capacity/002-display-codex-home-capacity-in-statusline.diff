+use super::*;
+use crate::chatwidget::status_surfaces::format_capacity_bytes;
+
+#[test]
+fn formats_capacity_at_display_thresholds() {
+    assert_eq!(format_capacity_bytes(0), "0.00B");
+    assert_eq!(format_capacity_bytes(512 * 1024 * 1024), "512.00MiB");
+    assert_eq!(format_capacity_bytes(1024 * 1024 * 1024), "1.00GiB");
+}
+
+#[tokio::test]
+async fn cached_capacity_preview_preserves_live_value_and_unavailable_state_without_io() {
+    for fullscreen in [true, false] {
+        for bytes in [
+            Some(0),
+            Some(512 * 1024 * 1024),
+            Some(200 * 1024 * 1024 * 1024),
+            None,
+        ] {
+            let (mut chat, _rx, _ops) = make_chatwidget_manual(None).await;
+            // A path that cannot be stat'ed proves rendering consumes the RPC cache.
+            let home = tempfile::tempdir().expect("create home");
+            chat.config.codex_home =
+                AbsolutePathBuf::from_absolute_path(home.path().join("missing-home"))
+                    .expect("absolute fixture home");
+            chat.local_settings.tui.fullscreen_transcript = fullscreen;
+            chat.local_settings.tui.status_line = Some(vec!["codex-home-capacity".into()]);
+            chat.on_home_disk_capacity(bytes.ok_or_else(|| "unavailable".to_string()));
+            let preview = chat.status_surface_preview_data();
+            let value = preview.value_for(StatusSurfacePreviewItem::CodexHomeCapacity);
+            if let Some(bytes) = bytes.filter(|_| fullscreen) {
+                assert_eq!(preview.capacity_bytes, Some(bytes));
+                assert_eq!(value, Some(format_capacity_bytes(bytes).as_str()));
+                assert_eq!(
+                    chat.bottom_pane.status_line_text(),
+                    Some(format_capacity_bytes(bytes))
+                );
+                for use_colors in [true, false] {
+                    let preview_line = preview
+                        .status_line_for_items([StatusLineItem::CodexHomeCapacity], use_colors);
+                    let live_line = crate::bottom_pane::status_line_from_segments(
+                        [(
+                            StatusLineItem::CodexHomeCapacity,
+                            format_capacity_bytes(bytes),
+                        )],
+                        use_colors,
+                        chat.thread_id,
+                        crate::bottom_pane::StatusLineDetails {
+                            capacity_bytes: Some(bytes),
+                            ..Default::default()
+                        },
+                    );
+                    assert_eq!(preview_line, live_line);
+                }
+            } else {
+                assert!(preview.capacity_bytes.is_none());
+                assert!(
+                    value.is_none(),
+                    "unavailable capacity must not show a placeholder"
+                );
+                assert!(
+                    preview
+                        .status_line_for_items([StatusLineItem::CodexHomeCapacity], true)
+                        .is_none()
+                );
+                assert!(
+                    chat.status_line_value_for_item(StatusLineItem::CodexHomeCapacity)
+                        .is_none()
+                );
+                assert!(chat.bottom_pane.status_line_text().is_none());
+            }
+        }
+    }
+}
