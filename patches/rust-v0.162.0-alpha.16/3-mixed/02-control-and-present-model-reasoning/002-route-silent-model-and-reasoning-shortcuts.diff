@@ -0,0 +1,81 @@
+//! Step through the models exposed by the active model picker.
+
+use super::*;
+use crate::key_hint::KeyBindingListExt;
+
+enum Direction {
+    Previous,
+    Next,
+}
+
+impl ChatWidget {
+    pub(super) fn handle_model_shortcut(&mut self, key_event: KeyEvent) -> bool {
+        let direction = if self.chat_keymap.previous_model.is_pressed(key_event) {
+            Direction::Previous
+        } else if self.chat_keymap.next_model.is_pressed(key_event) {
+            Direction::Next
+        } else {
+            return false;
+        };
+        if !self.bottom_pane.no_modal_or_popup_active() {
+            return false;
+        }
+        if self.blocks_direct_input {
+            self.add_error_message(PARENT_OWNED_INPUT_MESSAGE.to_string());
+            return true;
+        }
+        if self.bottom_pane.is_task_running() {
+            self.add_error_message(
+                "Cannot change models while a turn is running. Wait for it to finish or stop it first."
+                    .to_string(),
+            );
+            return true;
+        }
+        if !self.is_session_configured() {
+            return true;
+        }
+        if self.restrict_model_picker_to_luna_reserve() {
+            return true;
+        }
+
+        let Ok(presets) = self.model_catalog.try_list_models();
+        let (mut choices, other): (Vec<_>, Vec<_>) = presets
+            .into_iter()
+            .filter(|preset| preset.show_in_picker)
+            .partition(|preset| Self::is_auto_model(&preset.model));
+        choices.sort_by_key(|preset| Self::auto_model_order(&preset.model));
+        choices.extend(other);
+        let current = choices
+            .iter()
+            .position(|preset| preset.model == self.current_model());
+        let Some(index) = adjacent_index(choices.len(), current, direction) else {
+            return true;
+        };
+        let next = choices.swap_remove(index);
+        self.app_event_tx.send(AppEvent::UpdateModel(next.model));
+        let effort = Some(next.default_reasoning_effort);
+        if self.collaboration_modes_enabled() && self.active_mode_kind() == ModeKind::Plan {
+            self.app_event_tx
+                .send(AppEvent::UpdatePlanModeReasoningEffort(effort));
+        } else {
+            self.app_event_tx
+                .send(AppEvent::UpdateReasoningEffort(effort));
+        }
+        true
+    }
+}
+
+fn adjacent_index(len: usize, current: Option<usize>, direction: Direction) -> Option<usize> {
+    let last = len.checked_sub(1)?;
+    let next = match (direction, current) {
+        (Direction::Previous, Some(0) | None) => last,
+        (Direction::Previous, Some(index)) => index - 1,
+        (Direction::Next, Some(index)) => (index + 1) % len,
+        (Direction::Next, None) => 0,
+    };
+    Some(next)
+}
