+async fn model_punctuation_shortcuts_cycle_without_persisting_or_announcing() {
+    let (mut chat, mut rx, _op_rx) = make_chatwidget_manual(Some("gpt-5.5")).await;
+    chat.thread_id = Some(ThreadId::new());
+    chat.local_settings.tui.fullscreen_transcript = true;
+    let first = get_available_model(&chat, "gpt-5.5");
+    let mut second = first.clone();
+    second.id = "model-two".to_string();
+    second.model = second.id.clone();
+    chat.model_catalog = Arc::new(ModelCatalog::new(vec![first, second]));
+    while rx.try_recv().is_ok() {}
+
+    for (key, expected) in [('\'', "model-two"), (';', "gpt-5.5")] {
+        chat.handle_key_event(KeyEvent::new(KeyCode::Char(key), KeyModifiers::ALT));
+        let events = std::iter::from_fn(|| rx.try_recv().ok()).collect::<Vec<_>>();
+        assert!(events.iter().any(|event| matches!(
+            event, AppEvent::UpdateModel(model) if model == expected
+        )));
+        assert!(events.iter().all(|event| !matches!(
+            event,
+            AppEvent::PersistModelSelection { .. }
+                | AppEvent::PersistPlanModeReasoningEffort(_)
+                | AppEvent::InsertHistoryCell(_)
+        )));
+        chat.set_model(expected);
+        assert!(chat.composer_text_with_pending().is_empty());
+    }
+}
