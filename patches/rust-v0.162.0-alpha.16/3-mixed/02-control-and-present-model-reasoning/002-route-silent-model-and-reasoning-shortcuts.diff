+use super::*;
+use pretty_assertions::assert_eq;
+
+#[test]
+fn model_navigation_wraps_and_handles_missing_selection() {
+    assert_eq!(adjacent_index(0, None, Direction::Next), None);
+    assert_eq!(adjacent_index(3, Some(0), Direction::Previous), Some(2));
+    assert_eq!(adjacent_index(3, Some(2), Direction::Next), Some(0));
+    assert_eq!(adjacent_index(3, None, Direction::Next), Some(0));
+    assert_eq!(adjacent_index(3, None, Direction::Previous), Some(2));
+}
