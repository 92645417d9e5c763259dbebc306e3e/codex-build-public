+fn append_reasoning_strength_meter(
+    spans: &mut Vec<Span<'static>>,
+    effort: &ReasoningEffort,
+    use_theme_colors: bool,
+    leading_space: bool,
+) {
+    let filled = match effort {
+        ReasoningEffort::Low => 1,
+        ReasoningEffort::Medium => 2,
+        ReasoningEffort::High => 3,
+        ReasoningEffort::XHigh => 4,
+        ReasoningEffort::Max => 5,
+        ReasoningEffort::Ultra => 6,
+        ReasoningEffort::None
+        | ReasoningEffort::Minimal
+        | ReasoningEffort::Persistent
+        | ReasoningEffort::Custom(_) => 0,
+    };
+    let colors = [
+        Color::Rgb(250, 204, 21),
+        Color::Rgb(251, 168, 24),
+        Color::Rgb(249, 115, 22),
+        Color::Rgb(239, 68, 68),
+        Color::Rgb(225, 29, 72),
+        Color::Rgb(190, 18, 60),
+    ];
+    if leading_space {
+        spans.push(Span::raw(" "));
+    }
+    for (index, color) in colors.into_iter().enumerate() {
+        let style = if use_theme_colors {
+            Style::default().fg(if index < filled {
+                readable_color_on(color, /*background*/ None)
+            } else {
+                Color::DarkGray
+            })
+        } else if index < filled {
+            Style::default().add_modifier(Modifier::BOLD)
+        } else {
+            Style::default().add_modifier(Modifier::DIM)
+        };
+        spans.push(Span::styled("■", style));
+    }
+}
