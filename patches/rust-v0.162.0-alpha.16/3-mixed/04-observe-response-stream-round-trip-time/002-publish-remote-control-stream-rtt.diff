+
+    fn auth(plan: &str) -> CodexAuth {
+        let claims =
+            serde_json::json!({"https://api.openai.com/auth": {"chatgpt_user_id": "rtt-user"}});
+        let payload = base64::engine::general_purpose::URL_SAFE_NO_PAD.encode(claims.to_string());
+        CodexAuth::from_external_chatgpt_tokens(
+            &format!("header.{payload}.signature"),
+            "rtt-account",
+            Some(plan),
+        )
+        .unwrap()
+    }
+
+    #[test]
+    fn remote_control_rtt_only_uses_matching_pong_once() {
+        let (status, mut rx) = remote_control_status_channel();
+        status.publish_status(RemoteControlConnectionStatus::Connected);
+        rx.borrow_and_update();
+        let rtt = RemoteControlRtt::new(
+            RemoteControlAuth::capture(AuthManager::from_auth_for_testing(auth("plus"))).0,
+            status,
+        );
+        let payload = rtt.ping_payload(7);
+        rtt.observe_pong(&6_u64.to_be_bytes());
+        rtt.observe_pong(&[1, 2, 3]);
+        assert_eq!(rx.borrow().rtt_ms, None);
+        rtt.observe_pong(&payload);
+        assert!(rx.borrow_and_update().rtt_ms.is_some());
+        rtt.observe_pong(&payload);
+        assert!(!rx.has_changed().unwrap());
+    }
+
+    #[tokio::test]
+    async fn remote_control_rtt_preserves_upstream_heartbeats_after_scope_changes() {
+        let home = tempfile::TempDir::new().unwrap();
+        let initial = auth("plus");
+        let token = initial.get_token().unwrap();
+        let manager =
+            AuthManager::from_auth_for_testing_with_home(initial, home.path().to_path_buf());
+        let (status, rx) = remote_control_status_channel();
+        status.publish_status(RemoteControlConnectionStatus::Connected);
+        let rtt = RemoteControlRtt::new(RemoteControlAuth::capture(manager.clone()).0, status);
+        let payload = rtt.ping_payload(1);
+        rtt.observe_pong(&payload);
+        assert!(rx.borrow().rtt_ms.is_some());
+        for (account, plan) in [("rtt-account", "business"), ("replacement-account", "plus")] {
+            codex_login::auth::login_with_chatgpt_auth_tokens(
+                home.path(),
+                &token,
+                account,
+                Some(plan),
+            )
+            .unwrap();
+            // Reload reports auth-mode changes, not changes within the cached account.
+            assert!(!manager.reload().await);
+            assert_eq!(
+                manager.auth_cached().unwrap().get_account_id().as_deref(),
+                Some(account)
+            );
+            assert!(rtt.ping_payload(2).is_empty());
+            rtt.observe_pong(&payload);
+            assert_eq!(rx.borrow().rtt_ms, None);
+        }
+    }
+
+    #[test]
+    fn remote_control_rtt_scope_is_the_approved_personal_plans() {
+        for (plan, expected) in [
+            ("plus", true),
+            ("pro", true),
+            ("prolite", true),
+            ("promax", false),
+            ("business", false),
+            ("free", false),
+            ("unknown", false),
+        ] {
+            let rtt = RemoteControlRtt::new(
+                RemoteControlAuth::capture(AuthManager::from_auth_for_testing(auth(plan))).0,
+                remote_control_status_channel().0,
+            );
+            assert_eq!(!rtt.ping_payload(1).is_empty(), expected, "{plan}");
+        }
+    }
+}
