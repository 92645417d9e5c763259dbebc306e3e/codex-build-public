@@ -0,0 +1,156 @@
+//! RTT observations belong to one authenticated relay connection and its two workers.
+
+use super::super::auth::RemoteControlAuth;
+use super::RemoteControlStatusPublisher;
+use std::sync::Arc;
+use std::sync::Mutex;
+use std::time::Instant;
+
+#[derive(Clone)]
+pub(super) struct RemoteControlRtt {
+    auth: RemoteControlAuth,
+    status: RemoteControlStatusPublisher,
+    pending: Arc<Mutex<Option<(u64, Instant)>>>,
+}
+
+impl RemoteControlRtt {
+    pub(super) fn new(auth: RemoteControlAuth, status: RemoteControlStatusPublisher) -> Self {
+        Self {
+            auth,
+            status,
+            pending: Arc::new(Mutex::new(None)),
+        }
+    }
+
+    pub(super) fn ping_payload(&self, nonce: u64) -> Vec<u8> {
+        let mut pending = self.pending.lock().expect("pending ping lock poisoned");
+        if self.auth.should_measure_rtt() {
+            *pending = Some((nonce, Instant::now()));
+            nonce.to_be_bytes().to_vec()
+        } else {
+            *pending = None;
+            if self.auth.owner.is_current() {
+                self.status.publish_rtt_ms(None);
+            }
+            // Preserve upstream heartbeats outside the private account scope.
+            Vec::new()
+        }
+    }
+
+    pub(super) fn observe_pong(&self, payload: &[u8]) {
+        if !self.auth.should_measure_rtt() {
+            *self.pending.lock().expect("pending ping lock poisoned") = None;
+            if self.auth.owner.is_current() {
+                self.status.publish_rtt_ms(None);
+            }
+            return;
+        }
+        let Some(bytes) = payload.try_into().ok() else {
+            return;
+        };
+        let nonce = u64::from_be_bytes(bytes);
+        let mut pending = self.pending.lock().expect("pending ping lock poisoned");
+        if let Some((expected, sent_at)) = pending.as_ref()
+            && nonce == *expected
+        {
+            let rtt_ms = sent_at.elapsed().as_millis().try_into().unwrap_or(u64::MAX);
+            *pending = None;
+            if self.auth.should_measure_rtt() {
+                self.status.publish_rtt_ms(Some(rtt_ms));
+            }
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
