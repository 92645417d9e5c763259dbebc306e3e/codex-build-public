+#[tokio::test]
+async fn stream_rtt_scope_defaults_and_live_preview_are_consistent() {
+    let (mut chat, _rx, _ops) = make_chatwidget_manual(/*model_override*/ None).await;
+    let items = [
+        StatusLineItem::ResponsesStreamConnection,
+        StatusLineItem::RemoteControlStreamConnection,
+    ];
+    let mut snapshot = Vec::new();
+    for (plan, signed_in, fullscreen, enabled) in [
+        (Some(PlanType::Plus), true, true, true),
+        (Some(PlanType::Pro), true, true, true),
+        (Some(PlanType::ProLite), true, true, true),
+        (Some(PlanType::ProMax), true, true, false),
+        (Some(PlanType::Business), true, true, false),
+        (Some(PlanType::Unknown), true, true, false),
+        (None, true, true, false),
+        (Some(PlanType::Plus), false, true, false),
+        (Some(PlanType::Plus), true, false, false),
+    ] {
+        chat.update_account_state(
+            /*status_account_display*/ None, plan, signed_in, signed_in,
+        );
+        chat.local_settings.tui.fullscreen_transcript = fullscreen;
+        chat.local_settings.tui.status_line = None;
+        assert_eq!(
+            chat.configured_status_line_items()
+                .contains(&"responses-rtt".to_string()),
+            enabled
+        );
+        chat.local_settings.tui.status_line = Some(items.iter().map(ToString::to_string).collect());
+        chat.refresh_status_line();
+        assert!(
+            chat.status_surface_preview_data()
+                .status_line_for_items(items, /*use_theme_colors*/ true)
+                .is_none()
+        );
+        for (connected, sample) in [(true, None), (true, Some(42)), (false, None)] {
+            chat.set_responses_stream_connection_status(connected, sample);
+            chat.set_remote_control_connection_status(connected, sample.map(|rtt| rtt + 13));
+            let preview = chat.status_surface_preview_data();
+            assert_eq!(preview.stream_rtt_enabled, enabled);
+            for colors in [false, true] {
+                let thread_id = chat.thread_id;
+                let live = crate::bottom_pane::status_line_from_segments(
+                    items.into_iter().filter_map(|item| {
+                        chat.status_line_value_for_item(item)
+                            .map(|value| (item, value))
+                    }),
+                    colors,
+                    thread_id,
+                    crate::bottom_pane::StatusLineDetails::default(),
+                );
+                assert_eq!(preview.status_line_for_items(items, colors), live);
+            }
+            assert_eq!(
+                preview
+                    .status_line_for_items(items, /*use_theme_colors*/ true)
+                    .map(line_text),
+                chat.bottom_pane.status_line_text()
+            );
+            snapshot.push(format!("{plan:?} signed_in={signed_in} fullscreen={fullscreen} connected={connected} rtt={sample:?}: {:?}", chat.bottom_pane.status_line_text()));
+        }
+    }
+    insta::assert_snapshot!(snapshot.join("\n"));
+}
