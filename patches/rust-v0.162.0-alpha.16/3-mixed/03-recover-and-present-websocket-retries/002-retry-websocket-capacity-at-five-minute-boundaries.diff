+fn aligned_capacity_retry_eligible(
+    max_retries: u64,
+    personal_websocket: bool,
+    err: &CodexErr,
+) -> bool {
+    max_retries == 5
+        && personal_websocket
+        && matches!(err.details(), CodexErrorDetails::ServerOverloaded)
+}
+
+fn delay_until_next_five_minute_boundary(now: SystemTime) -> Duration {
+    let Ok(elapsed) = now.duration_since(UNIX_EPOCH) else {
+        return ALIGNED_WEBSOCKET_RETRY_INTERVAL;
+    };
+    let interval_millis = ALIGNED_WEBSOCKET_RETRY_INTERVAL.as_millis();
+    let remainder = elapsed.as_millis() % interval_millis;
+    let delay_millis = if remainder == 0 {
+        interval_millis
+    } else {
+        interval_millis - remainder
+    };
+    Duration::from_millis(u64::try_from(delay_millis).expect("bounded by five minutes"))
+}
+
