+        })
+        .await;
+    let mut client_session = session.services.model_client.new_session();
+    let step_context = StepContext::for_test(turn_context);
+    let mut retry_state = ResponsesStreamRetryState::default();
+    let cancellation = CancellationToken::new();
+    tokio::time::pause();
+    let wait = async {
+        handle_response_stream_error(
+            &mut retry_state,
+            5,
+            CodexErr::ServerOverloaded,
+            &mut client_session,
+            &session,
+            &step_context,
+            ResponsesStreamRequest::Sampling,
+        )
+        .or_cancel(&cancellation)
+        .await?
+    };
+    tokio::pin!(wait);
+    let event = tokio::select! {
+        event = events.recv() => event.expect("capacity warning event"),
+        result = &mut wait => panic!("capacity wait ended before its warning: {result:?}"),
+    };
+    assert!(matches!(event.msg, EventMsg::Warning(warning)
+        if warning.message.starts_with("External model limit reached. Retrying at ")));
+    assert!(events.try_recv().is_err());
+    assert!(futures::poll!(&mut wait).is_pending());
+    cancellation.cancel();
+    let result: Result<(), CodexErr> = wait.await;
+    assert!(matches!(
+        result.expect_err("cancelled capacity wait").details(),
+        CodexErrorDetails::TurnAborted
+    ));
+    assert!(events.try_recv().is_err());
+}
