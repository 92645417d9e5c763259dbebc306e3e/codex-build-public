+#[test]
+fn capacity_retry_uses_strict_five_minute_boundaries() {
+    let now = UNIX_EPOCH + Duration::from_secs(6 * 60 * 60 + 21 * 60 + 10);
+    assert_eq!(
+        delay_until_next_five_minute_boundary(now),
