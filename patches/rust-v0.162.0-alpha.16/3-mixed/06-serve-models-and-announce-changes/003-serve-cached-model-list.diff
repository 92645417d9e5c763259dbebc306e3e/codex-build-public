+#[tokio::test]
+async fn personal_model_list_uses_stale_same_account_snapshot_during_online_refresh() -> Result<()>
+{
+    let server = MockServer::start().await;
+    let models_mock = mount_models_once_with_delay(
+        &server,
+        ModelsResponse { models: Vec::new() },
+        Duration::from_secs(3),
+    )
+    .await;
+    let codex_home = TempDir::new()?;
+    std::fs::write(
+        codex_home.path().join("config.toml"),
+        format!(
+            "model = \"mock-model\"\napproval_policy = \"never\"\nsandbox_mode = \"read-only\"\nopenai_base_url = \"{}/v1\"\n",
+            server.uri()
+        ),
+    )?;
+    write_chatgpt_auth(
+        codex_home.path(),
+        ChatGptAuthFixture::new("chatgpt-access-token").plan_type("pro"),
+        AuthCredentialsStoreMode::File,
+    )?;
+    write_models_cache(codex_home.path()).await?;
+    let cache_path = codex_home.path().join("models_cache.json");
+    let mut cache: serde_json::Value = serde_json::from_slice(&std::fs::read(&cache_path)?)?;
+    cache["fetched_at"] = json!("2000-01-01T00:00:00Z");
+    cache["client_version"] = json!("different-client-version");
+    cache["models"][0]["slug"] = json!("cached-startup-only");
+    cache["models"][0]["display_name"] = json!("Cached Startup Only");
+    std::fs::write(&cache_path, serde_json::to_vec_pretty(&cache)?)?;
+
+    let mut mcp = TestAppServer::builder()
+        .with_codex_home(codex_home.path())
+        .without_auto_env()
+        .with_env_overrides(&[("OPENAI_API_KEY", None), ("CODEX_API_KEY", None)])
+        .build_initialized()
+        .await?;
+    timeout(DEFAULT_TIMEOUT, async {
+        while models_mock.requests().is_empty() {
+            tokio::task::yield_now().await;
+        }
+    })
+    .await
+    .expect("startup refresh should begin");
+
+    let response: ModelListResponse = timeout(
+        Duration::from_secs(1),
+        mcp.request(|request_id| ClientRequest::ModelList {
+            request_id,
+            params: ModelListParams {
+                limit: Some(100),
+                cursor: None,
+                include_hidden: None,
+            },
+        }),
+    )
+    .await
+    .expect("cached model/list should not block")?;
+    assert!(
+        response
+            .data
+            .iter()
+            .any(|model| model.id == "cached-startup-only")
+    );
+    assert!(response.next_cursor.is_none());
+    assert_eq!(models_mock.requests().len(), 1);
+    Ok(())
+}
