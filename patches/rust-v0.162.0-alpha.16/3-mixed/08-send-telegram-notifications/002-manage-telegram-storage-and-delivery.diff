+use super::*;
+use codex_http_client::OutboundProxyPolicy;
+use serde_json::Value;
+use wiremock::Mock;
+use wiremock::MockServer;
+use wiremock::ResponseTemplate;
+use wiremock::matchers::method;
+use wiremock::matchers::path;
+use wiremock::matchers::query_param;
+
+fn factory() -> HttpClientFactory {
+    HttpClientFactory::new(OutboundProxyPolicy::ReqwestDefault)
+}
+
+#[tokio::test]
+async fn telegram_and_github_use_the_shared_route_aware_client() {
+    let server = MockServer::start().await;
+    Mock::given(method("POST"))
+        .and(path("/bot123:secret/sendMessage"))
+        .respond_with(ResponseTemplate::new(200).set_body_json(serde_json::json!({"ok": true})))
+        .expect(1)
+        .mount(&server)
+        .await;
+    Mock::given(method("GET"))
+        .and(path("/repos/openai/codex/releases"))
+        .and(query_param("per_page", "10"))
+        .respond_with(
+            ResponseTemplate::new(200).set_body_json(serde_json::json!([{
+                "tag_name": "rust-v9.0.0-alpha.1",
+                "html_url": "https://example.invalid/release",
+                "draft": false,
+                "prerelease": true,
+                "body": "x".repeat(200 * 1024)
+            }])),
+        )
+        .expect(1)
+        .mount(&server)
+        .await;
+    let base = Url::parse(&server.uri()).expect("mock URL");
+    let http = TelegramHttp::with_urls(factory(), base.clone(), base);
+
+    http.send(Destination("123:secret", "chat-1"), "hello\nworld")
+        .await
+        .expect("Telegram send");
+    let probe = http.releases("github-token").await.expect("GitHub probe");
+    assert_eq!(
+        probe.release.expect("release").version,
+        Version::parse("9.0.0-alpha.1").expect("version")
+    );
+
+    let requests = server.received_requests().await.expect("requests");
+    let telegram: Value = serde_json::from_slice(
+        requests
+            .iter()
+            .find(|request| request.method.as_str() == "POST")
+            .expect("Telegram request")
+            .body
+            .as_slice(),
+    )
+    .expect("Telegram JSON");
+    assert_eq!(telegram["chat_id"], "chat-1");
+    assert_eq!(telegram["text"], "hello\nworld");
+    let github = requests
+        .iter()
+        .find(|request| request.method.as_str() == "GET")
+        .expect("GitHub request");
+    assert_eq!(
+        github.headers["authorization"].to_str().ok(),
+        Some("Bearer github-token")
+    );
+}
+
+#[tokio::test]
+async fn release_probe_selects_the_newest_stable_or_prerelease_from_ten_results() {
+    let server = MockServer::start().await;
+    Mock::given(method("GET"))
+        .and(path("/repos/openai/codex/releases"))
+        .and(query_param("per_page", "10"))
+        .respond_with(ResponseTemplate::new(200).set_body_json(serde_json::json!([
+            {
+                "tag_name": "rust-v9.0.0",
+                "html_url": "https://example.invalid/stable",
+                "draft": false
+            },
+            {
+                "tag_name": "rust-v9.1.0-alpha.1",
+                "html_url": "https://example.invalid/alpha",
+                "draft": false
+            }
+        ])))
+        .expect(1)
+        .mount(&server)
+        .await;
+    let base = Url::parse(&server.uri()).expect("mock URL");
+    let http = TelegramHttp::with_urls(factory(), base.clone(), base);
+
+    let probe = http.releases("github-token").await.expect("GitHub probe");
+
+    assert_eq!(
+        probe.release.expect("release").version,
+        Version::parse("9.1.0-alpha.1").expect("version")
+    );
+}
+
+#[tokio::test]
+async fn secret_bearing_telegram_requests_do_not_follow_redirects() {
+    let server = MockServer::start().await;
+    Mock::given(method("POST"))
+        .and(path("/bot123:secret/sendMessage"))
+        .respond_with(
+            ResponseTemplate::new(307)
+                .insert_header("location", format!("{}/redirected", server.uri())),
+        )
+        .expect(1)
+        .mount(&server)
+        .await;
+    Mock::given(path("/redirected"))
+        .respond_with(ResponseTemplate::new(200).set_body_json(serde_json::json!({"ok": true})))
+        .expect(0)
+        .mount(&server)
+        .await;
+    let base = Url::parse(&server.uri()).expect("URL");
+    let http = TelegramHttp::with_urls(factory(), base.clone(), base);
+    assert!(
+        http.send(Destination("123:secret", "chat"), "notice")
+            .await
+            .is_err()
+    );
+}
+
+#[tokio::test]
+async fn telegram_and_github_reject_oversized_response_bodies() {
+    let server = MockServer::start().await;
+    Mock::given(method("POST"))
+        .and(path("/bot123:secret/sendMessage"))
+        .respond_with(ResponseTemplate::new(200).set_body_json(serde_json::json!({
+            "ok": true,
+            "padding": "x".repeat(4096),
+        })))
+        .expect(1)
+        .mount(&server)
+        .await;
+    Mock::given(method("GET"))
+        .and(path("/repos/openai/codex/releases"))
+        .respond_with(
+            ResponseTemplate::new(200).set_body_json(serde_json::json!([{
+                "tag_name": "rust-v9.0.0",
+                "html_url": "x".repeat(GITHUB_RESPONSE_LIMIT),
+                "draft": false,
+            }])),
+        )
+        .expect(1)
+        .mount(&server)
+        .await;
+    let base = Url::parse(&server.uri()).expect("URL");
+    let http = TelegramHttp::with_urls(factory(), base.clone(), base);
+    assert!(
+        http.send(Destination("123:secret", "chat"), "notice")
+            .await
+            .is_err()
+    );
+    assert!(http.releases("github-token").await.is_err());
+}
