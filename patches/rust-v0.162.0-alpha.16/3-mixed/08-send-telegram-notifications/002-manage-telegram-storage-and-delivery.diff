+use serde::Deserialize;
+use serde::Serialize;
+use std::io;
+use std::path::Path;
+use std::path::PathBuf;
+
+pub(super) const DEFAULT_VERSION_CHECK_INTERVAL_HOURS: u16 = 20;
+pub(super) const MIN_VERSION_CHECK_INTERVAL_HOURS: u16 = 1;
+pub(super) const MAX_VERSION_CHECK_INTERVAL_HOURS: u16 = 168;
+
+pub(super) struct TelegramStore {
+    path: PathBuf,
+}
+
+#[derive(Serialize, Deserialize)]
+pub(super) struct TelegramConfig {
+    pub(super) bot_token: String,
+    pub(super) chat_id: String,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub(super) github_token: Option<String>,
+    #[serde(default)]
+    pub(super) notify_version_updates: bool,
+    #[serde(default = "default_version_check_interval_hours")]
+    pub(super) version_check_interval_hours: u16,
+    #[serde(default = "default_completion_min_duration_ms")]
+    pub(super) completion_min_duration_ms: u64,
+}
+
+impl TelegramStore {
+    pub(super) fn new(codex_home: PathBuf) -> Self {
+        Self {
+            path: codex_home.join("telegram.json"),
+        }
+    }
+
+    pub(super) fn load(&self) -> io::Result<Option<TelegramConfig>> {
+        reject_symlink(&self.path)?;
+        match std::fs::read(&self.path) {
+            Ok(contents) => serde_json::from_slice(&contents)
+                .map_err(|error| io::Error::new(io::ErrorKind::InvalidData, error))
+                .and_then(|config: TelegramConfig| {
+                    config.validate()?;
+                    Ok(config)
+                })
+                .map(Some),
+            Err(error) if error.kind() == io::ErrorKind::NotFound => Ok(None),
+            Err(error) => Err(error),
+        }
+    }
+
+    pub(super) fn persist(&self, config: Option<&TelegramConfig>) -> io::Result<()> {
+        reject_symlink(&self.path)?;
+        if let Some(config) = config {
+            config.validate()?;
+            let contents = serde_json::to_string_pretty(config)
+                .map_err(|error| io::Error::new(io::ErrorKind::InvalidData, error))?;
+            codex_core::path_utils::write_atomically(&self.path, &contents)
+        } else {
+            match std::fs::remove_file(&self.path) {
+                Ok(()) => Ok(()),
+                Err(error) if error.kind() == io::ErrorKind::NotFound => Ok(()),
+                Err(error) => Err(error),
+            }
+        }
+    }
+}
+
+impl TelegramConfig {
+    #[cfg(test)]
+    pub(super) fn new(bot_token: String, chat_id: String) -> Self {
+        Self {
+            bot_token,
+            chat_id,
+            github_token: None,
+            notify_version_updates: false,
+            version_check_interval_hours: DEFAULT_VERSION_CHECK_INTERVAL_HOURS,
+            completion_min_duration_ms: default_completion_min_duration_ms(),
+        }
+    }
+
+    pub(super) fn configured(
+        bot_token: String,
+        chat_id: String,
+        github_token: String,
+        notify_version_updates: bool,
+        version_check_interval_hours: u16,
+    ) -> Self {
+        Self {
+            bot_token,
+            chat_id,
+            github_token: Some(github_token),
+            notify_version_updates,
+            version_check_interval_hours,
+            completion_min_duration_ms: default_completion_min_duration_ms(),
+        }
+    }
+
+    fn validate(&self) -> io::Result<()> {
+        if !(MIN_VERSION_CHECK_INTERVAL_HOURS..=MAX_VERSION_CHECK_INTERVAL_HOURS)
+            .contains(&self.version_check_interval_hours)
+        {
+            return Err(io::Error::new(
+                io::ErrorKind::InvalidData,
+                "version_check_interval_hours is out of range",
+            ));
+        }
+        Ok(())
+    }
+}
+
+fn reject_symlink(path: &Path) -> io::Result<()> {
+    if std::fs::symlink_metadata(path).is_ok_and(|metadata| metadata.file_type().is_symlink()) {
+        return Err(io::Error::new(
+            io::ErrorKind::InvalidInput,
+            "symlink rejected",
+        ));
+    }
+    Ok(())
+}
+
+fn default_completion_min_duration_ms() -> u64 {
+    30_000
+}
+
+fn default_version_check_interval_hours() -> u16 {
+    DEFAULT_VERSION_CHECK_INTERVAL_HOURS
+}
+
