+use codex_http_client::ClientRouteClass;
+use codex_http_client::HttpClientFactory;
+use codex_http_client::HttpResponse;
+use codex_http_client::RouteAwareClientPool;
+use codex_login::default_client::default_headers;
+use semver::Version;
+use serde::Deserialize;
+use serde::Serialize;
+use std::time::Duration;
+use url::Url;
+
+const TIMEOUT: Duration = Duration::from_secs(10);
+const GITHUB_RESPONSE_LIMIT: usize = 4 * 1024 * 1024;
+pub(crate) struct TelegramHttp {
+    pool: RouteAwareClientPool,
+    github: Url,
+    telegram: Url,
+}
+
+pub(crate) struct Destination<'a>(pub(crate) &'a str, pub(crate) &'a str);
+
+pub(crate) struct Release {
+    pub(crate) version: Version,
+    pub(crate) url: String,
+}
+
+pub(crate) struct Probe {
+    pub(crate) release: Option<Release>,
+    pub(crate) remaining: Option<u64>,
+}
+
+#[derive(Deserialize)]
+struct GitHubRelease {
+    tag_name: String,
+    html_url: String,
+    draft: bool,
+}
+
+#[derive(Serialize)]
+struct SendMessage<'a> {
+    chat_id: &'a str,
+    text: &'a str,
+}
+
+#[derive(Deserialize)]
+struct SendResult {
+    ok: bool,
+}
+
+impl TelegramHttp {
+    pub(crate) fn new(factory: HttpClientFactory) -> Self {
+        Self {
+            pool: RouteAwareClientPool::new_without_redirects_or_request_logging(
+                factory,
+                ClientRouteClass::Other,
+            ),
+            github: Url::parse("https://api.github.com").expect("valid GitHub URL"),
+            telegram: Url::parse("https://api.telegram.org").expect("valid Telegram URL"),
+        }
+    }
+
+    #[cfg(test)]
+    pub(crate) fn with_urls(factory: HttpClientFactory, github: Url, telegram: Url) -> Self {
+        Self {
+            pool: RouteAwareClientPool::new_without_redirects_or_request_logging(
+                factory,
+                ClientRouteClass::Other,
+            ),
+            github,
+            telegram,
+        }
+    }
+
+    pub(crate) async fn send(&self, to: Destination<'_>, text: &str) -> Result<(), ()> {
+        let mut url = self.telegram.clone();
+        url.path_segments_mut()
+            .map_err(|_| ())?
+            .clear()
+            .push(&format!("bot{}", to.0))
+            .push("sendMessage");
+        let response = self
+            .pool
+            .post(url)
+            .timeout(TIMEOUT)
+            .json(&SendMessage {
+                chat_id: to.1,
+                text,
+            })
+            .send()
+            .await
+            .map_err(|_| ())?;
+        let status = response.status().as_u16();
+        let body = bounded(response, 4096).await?;
+        let result: SendResult = serde_json::from_slice(&body).map_err(|_| ())?;
+        (status == 200 && result.ok).then_some(()).ok_or(())
+    }
+
+    pub(crate) async fn releases(&self, token: &str) -> Result<Probe, ()> {
+        if token.trim().is_empty() {
+            return Err(());
+        }
+        let mut url = self.github.clone();
+        url.path_segments_mut()
+            .map_err(|_| ())?
+            .clear()
+            .extend(["repos", "openai", "codex", "releases"]);
+        url.query_pairs_mut().append_pair("per_page", "10");
+        let response = self
+            .pool
+            .get(url)
+            .headers(default_headers())
+            .header("accept", "application/vnd.github+json")
+            .header("x-github-api-version", "2022-11-28")
+            .header("authorization", format!("Bearer {}", token.trim()))
+            .timeout(TIMEOUT)
+            .send()
+            .await
+            .map_err(|_| ())?;
+        let remaining = response
+            .headers()
+            .get("x-ratelimit-remaining")
+            .and_then(|value| value.to_str().ok()?.parse().ok());
+        if response.status().as_u16() != 200 {
+            return Err(());
+        }
+        let body = bounded(response, GITHUB_RESPONSE_LIMIT).await?;
+        let release = serde_json::from_slice::<Vec<GitHubRelease>>(&body)
+            .map_err(|_| ())?
+            .into_iter()
+            .filter(|release| !release.draft)
+            .filter_map(|release| {
+                let version: Version = release.tag_name.strip_prefix("rust-v")?.parse().ok()?;
+                Some(Release {
+                    version,
+                    url: release.html_url,
+                })
+            })
+            .max_by(|left, right| left.version.cmp(&right.version));
+        Ok(Probe { release, remaining })
+    }
+}
+
+async fn bounded(mut response: HttpResponse, limit: usize) -> Result<Vec<u8>, ()> {
+    let mut body = Vec::new();
+    while let Some(chunk) = response.chunk().await.map_err(|_| ())? {
+        if chunk.len() > limit.saturating_sub(body.len()) {
+            return Err(());
+        }
+        body.extend_from_slice(&chunk);
+    }
+    Ok(body)
+}
+
