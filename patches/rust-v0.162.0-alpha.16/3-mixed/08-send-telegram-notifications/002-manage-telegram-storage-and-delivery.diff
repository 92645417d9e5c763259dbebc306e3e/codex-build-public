+use super::*;
+use std::os::unix::fs::MetadataExt;
+
+#[test]
+fn telegram_store_uses_snake_case_private_atomic_state() {
+    let home = tempfile::tempdir().expect("tempdir");
+    let store = TelegramStore::new(home.path().to_path_buf());
+    let mut config = TelegramConfig::new("bot".to_string(), "chat".to_string());
+    config.github_token = Some("github".to_string());
+    config.notify_version_updates = true;
+    store.persist(Some(&config)).expect("persist");
+
+    let path = home.path().join("telegram.json");
+    let contents = std::fs::read_to_string(&path).expect("read");
+    assert!(contents.contains("\"bot_token\""));
+    assert!(contents.contains("\"github_token\""));
+    assert!(!contents.contains("BotToken"));
+    assert_eq!(
+        std::fs::metadata(&path).expect("metadata").mode() & 0o777,
+        0o600
+    );
+    let loaded = store.load().expect("load").expect("config");
+    assert_eq!(loaded.completion_min_duration_ms, 30_000);
+    assert_eq!(loaded.version_check_interval_hours, 20);
+    assert!(!home.path().join("telegram.json.lock").exists());
+
+    store.persist(None).expect("disable");
+    assert!(!path.exists());
+}
+
+#[test]
+fn telegram_store_rejects_out_of_range_version_intervals() {
+    let home = tempfile::tempdir().expect("tempdir");
+    let path = home.path().join("telegram.json");
+    std::fs::write(
+        &path,
+        r#"{"bot_token":"bot","chat_id":"chat","version_check_interval_hours":0}"#,
+    )
+    .expect("write config");
+
+    let error = match TelegramStore::new(home.path().to_path_buf()).load() {
+        Err(error) => error,
+        Ok(_) => panic!("zero interval must be rejected"),
+    };
+
+    assert_eq!(error.kind(), io::ErrorKind::InvalidData);
+}
+
+#[test]
+fn telegram_store_rejects_symlinks() {
+    let home = tempfile::tempdir().expect("tempdir");
+    std::os::unix::fs::symlink("target", home.path().join("telegram.json")).expect("symlink");
+    let store = TelegramStore::new(home.path().to_path_buf());
+    let error = match store.load() {
+        Err(error) => error,
+        Ok(_) => panic!("symlink must be rejected"),
+    };
+    assert_eq!(error.kind(), io::ErrorKind::InvalidInput);
+}
