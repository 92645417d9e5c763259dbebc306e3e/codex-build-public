+#[tokio::test]
+async fn only_successful_primary_completions_publish_telegram_commands() -> color_eyre::Result<()> {
+    let mut app = make_test_app().await;
+    let (tx, mut rx) = tokio::sync::mpsc::unbounded_channel();
+    app.app_event_tx = AppEventSender::new(tx);
+    let mut server = crate::start_embedded_app_server_for_picker(&app.config).await?;
+    let primary = server.start_thread(&app.config).await?;
+    let primary_id = primary.session.thread_id;
+    app.primary_thread_id = Some(primary_id);
+    app.ensure_thread_channel(primary_id)
+        .store
+        .lock()
+        .await
+        .set_session(primary.session, primary.turns);
+    let other = server.start_thread(&app.config).await?;
+    let other_id = other.session.thread_id;
+    app.ensure_thread_channel(other_id)
+        .store
+        .lock()
+        .await
+        .set_session(other.session, other.turns);
+    for (thread_id, status) in [
+        (primary_id, TurnStatus::Failed),
+        (primary_id, TurnStatus::Interrupted),
+        (other_id, TurnStatus::Completed),
+        (primary_id, TurnStatus::Completed),
+    ] {
+        app.handle_app_server_event(&server, completion(thread_id, status, Some(30_000)))
+            .await;
+    }
+    let commands = std::iter::from_fn(|| rx.try_recv().ok())
+        .filter_map(|event| match event {
+            AppEvent::TelegramCommand { params } => Some(params),
+            _ => None,
+        })
+        .collect::<Vec<_>>();
+    let [TelegramCommandParams::Completion { text, duration_ms }] = commands.as_slice() else {
+        panic!("expected one successful completion notification");
+    };
+    assert_eq!(*duration_ms, 30_000);
+    assert!(text.contains(&format!("SessionID: {primary_id}")));
+    assert!(text.contains("TurnID: telegram-turn"));
+    assert!(text.contains("Duration: 30s"));
+    assert!(text.contains(&format!("WorkingDir: {}", app.config.cwd.display())));
+    server.shutdown().await?;
+    Ok(())
+}
