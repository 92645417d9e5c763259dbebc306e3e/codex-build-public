@@ -0,0 +1,119 @@
+use crate::app::App;
+use crate::app::test_support::make_test_app;
+use crate::app_event::AppEvent;
+use crate::app_event_sender::AppEventSender;
+use crate::app_server_session::AppServerSession;
+use crate::chatwidget::tests::helpers::render_bottom_popup;
+use codex_app_server_protocol::TelegramCommandKind;
+use codex_app_server_protocol::TelegramCommandParams;
+use codex_app_server_protocol::TelegramCommandResponse;
+use pretty_assertions::assert_eq;
+use std::time::Duration;
+use tokio::sync::mpsc::UnboundedReceiver;
+
+async fn finish_command(
+    app: &mut App,
+    tui: &mut crate::tui::Tui,
+    server: &mut AppServerSession,
+    rx: &mut UnboundedReceiver<AppEvent>,
+    expected: TelegramCommandKind,
+) -> color_eyre::Result<AppEvent> {
+    Ok(tokio::time::timeout(Duration::from_secs(10), async {
+        loop {
+            tokio::select! {
+                Some(event) = rx.recv() => {
+                    if matches!(&event, AppEvent::TelegramCommandFinished { kind, .. } if *kind == expected) {
+                        break Ok::<_, color_eyre::eyre::Report>(event);
+                    }
+                    app.handle_event(tui, server, event).await?;
+                }
+                Some(event) = server.next_event() => app.handle_app_server_event(server, event).await,
+            }
+        }
+    }).await??)
+}
+
+#[tokio::test]
+async fn telegram_menu_round_trip_uses_embedded_server_and_saved_configuration()
+-> color_eyre::Result<()> {
+    let mut app = make_test_app().await;
+    let (tx, mut rx) = tokio::sync::mpsc::unbounded_channel();
+    app.app_event_tx = AppEventSender::new(tx);
+    let mut tui = crate::tui::test_support::make_test_tui()?;
+    let mut server = crate::start_embedded_app_server_for_picker(&app.config).await?;
+    app.handle_event(&mut tui, &mut server, AppEvent::OpenTelegram)
+        .await?;
+    let event = finish_command(
+        &mut app,
+        &mut tui,
+        &mut server,
+        &mut rx,
+        TelegramCommandKind::Read,
+    )
+    .await?;
+    let AppEvent::TelegramCommandFinished { result, .. } = &event else {
+        panic!("expected result")
+    };
+    assert_eq!(
+        result.as_ref().expect("unconfigured read"),
+        &TelegramCommandResponse::default()
+    );
+    app.handle_event(&mut tui, &mut server, event).await?;
+    assert!(render_bottom_popup(&app.chat_widget, 80).contains("Bot token"));
+
+    let path = app.config.codex_home.join("telegram.json");
+    std::fs::write(
+        &path,
+        r#"{"bot_token":"bot-secret","chat_id":"chat-secret","github_token":"github-secret","notify_version_updates":false,"version_check_interval_hours":20}"#,
+    )?;
+    app.handle_event(&mut tui, &mut server, AppEvent::OpenTelegram)
+        .await?;
+    let event = finish_command(
+        &mut app,
+        &mut tui,
+        &mut server,
+        &mut rx,
+        TelegramCommandKind::Read,
+    )
+    .await?;
+    let AppEvent::TelegramCommandFinished { result, .. } = &event else {
+        panic!("expected result")
+    };
+    let response = result.as_ref().expect("configured read");
+    assert!(response.configured);
+    assert!(response.github_token_configured);
+    assert_eq!(response.version_check_interval_hours, 20);
+    app.handle_event(&mut tui, &mut server, event).await?;
+    let popup = render_bottom_popup(&app.chat_widget, 80);
+    assert!(popup.contains("Telegram notifications"));
+    assert!(popup.contains("GitHub release updates"));
+    for secret in ["bot-secret", "chat-secret", "github-secret"] {
+        assert!(!popup.contains(secret));
+    }
+    app.handle_event(
+        &mut tui,
+        &mut server,
+        AppEvent::TelegramCommand {
+            params: TelegramCommandParams::Disable {},
+        },
+    )
+    .await?;
+    let event = finish_command(
+        &mut app,
+        &mut tui,
+        &mut server,
+        &mut rx,
+        TelegramCommandKind::Disable,
+    )
+    .await?;
+    let AppEvent::TelegramCommandFinished { result, .. } = event else {
+        panic!("expected result")
+    };
+    assert_eq!(
+        result.expect("disabled"),
+        TelegramCommandResponse::default()
+    );
+    assert!(!path.exists());
+    server.shutdown().await?;
+    Ok(())
+}
