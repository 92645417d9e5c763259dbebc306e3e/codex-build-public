+#[test]
+fn masked_prompt_does_not_render_secret_text_but_submits_original_input() {
+    let (submitted, receiver) = std::sync::mpsc::channel();
+    let mut view = CustomPromptView::new_masked(
+        "Token".to_string(),
+        "Enter token".to_string(),
+        None,
+        Box::new(move |text| submitted.send(text).expect("submit")),
+    );
+    assert!(view.handle_paste("super-secret".to_string()));
+    let area = Rect::new(0, 0, 40, view.desired_height(40));
+    let mut buffer = Buffer::empty(area);
+    view.render(area, &mut buffer);
+    let rendered = buffer
+        .content
+        .iter()
+        .map(|cell| cell.symbol())
+        .collect::<String>();
+    assert!(!rendered.contains("super-secret"));
+    assert!(rendered.contains("************"));
+    view.handle_key_event(KeyEvent::from(KeyCode::Enter));
+    assert_eq!(receiver.try_recv(), Ok("super-secret".to_string()));
+    assert_eq!(view.completion(), Some(ViewCompletion::Accepted));
+}
