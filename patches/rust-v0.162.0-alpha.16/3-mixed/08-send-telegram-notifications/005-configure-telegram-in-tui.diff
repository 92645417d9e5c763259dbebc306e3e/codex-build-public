@@ -0,0 +1,162 @@
+use super::*;
+use codex_app_server_protocol::TelegramCommandParams;
+use codex_app_server_protocol::TelegramCommandResponse;
+use codex_app_server_protocol::TelegramSetup;
+
+#[tokio::test]
+async fn slash_telegram_opens_configuration_without_publishing_setup() {
+    let (mut chat, mut rx, mut ops) = make_chatwidget_manual(None).await;
+    chat.dispatch_command(SlashCommand::Telegram);
+    assert_matches!(rx.try_recv(), Ok(AppEvent::OpenTelegram));
+    assert!(rx.try_recv().is_err());
+    assert!(ops.try_recv().is_err());
+}
+
+#[tokio::test]
+async fn setup_masks_tokens_and_publishes_one_complete_configuration() {
+    let (mut chat, mut rx, _ops) = make_chatwidget_manual(None).await;
+    chat.open_telegram_menu(TelegramCommandResponse::default());
+    chat.handle_paste("bot-secret".to_string());
+    let popup = render_bottom_popup(&chat, 80);
+    assert!(popup.contains("Bot token"));
+    assert!(!popup.contains("bot-secret"));
+    assert!(popup.contains("**********"));
+    assert!(rx.try_recv().is_err());
+    chat.handle_key_event(KeyEvent::from(KeyCode::Enter));
+    let AppEvent::OpenTelegramChat { draft } = rx.try_recv().expect("chat step") else {
+        panic!("expected chat step")
+    };
+    assert!(!format!("{draft:?}").contains("bot-secret"));
+    chat.open_telegram_chat(draft);
+    chat.handle_paste("chat-id".to_string());
+    chat.handle_key_event(KeyEvent::from(KeyCode::Enter));
+    let AppEvent::OpenTelegramGithubToken { draft } = rx.try_recv().expect("GitHub step") else {
+        panic!("expected GitHub step")
+    };
+    chat.open_telegram_github_token(draft);
+    chat.handle_paste("github-secret".to_string());
+    let popup = render_bottom_popup(&chat, 80);
+    assert!(popup.contains("GitHub token"));
+    assert!(!popup.contains("github-secret"));
+    assert!(popup.contains("*************"));
+    chat.handle_key_event(KeyEvent::from(KeyCode::Enter));
+    let AppEvent::OpenTelegramSetup {
+        draft,
+        notify_version_updates,
+    } = rx.try_recv().expect("setup step")
+    else {
+        panic!("expected setup step")
+    };
+    assert!(notify_version_updates);
+    let debug = format!("{draft:?}");
+    for secret in ["bot-secret", "chat-id", "github-secret"] {
+        assert!(!debug.contains(secret));
+    }
+    assert_eq!(debug.matches("<redacted>").count(), 3);
+    chat.open_telegram_setup(draft, notify_version_updates);
+    chat.handle_key_event(KeyEvent::from(KeyCode::Char(' ')));
+    let AppEvent::OpenTelegramSetup {
+        draft,
+        notify_version_updates,
+    } = rx.try_recv().expect("toggle setup")
+    else {
+        panic!("expected setup toggle")
+    };
+    assert!(!notify_version_updates);
+    chat.open_telegram_setup(draft, notify_version_updates);
+    chat.handle_key_event(KeyEvent::from(KeyCode::Down));
+    chat.handle_key_event(KeyEvent::from(KeyCode::Enter));
+    let AppEvent::TelegramCommand { params } = rx.try_recv().expect("configure command") else {
+        panic!("expected configure")
+    };
+    assert_eq!(
+        params,
+        TelegramCommandParams::Configure {
+            setup: TelegramSetup {
+                bot_token: "bot-secret".to_string(),
+                chat_id: "chat-id".to_string(),
+                github_token: "github-secret".to_string(),
+                notify_version_updates: false,
+                version_check_interval_hours: 20,
+            },
+        }
+    );
+    assert!(rx.try_recv().is_err());
+}
+
+#[tokio::test]
+async fn cancelled_setup_does_not_publish_credentials_and_disable_has_no_extras() {
+    let (mut chat, mut rx, _ops) = make_chatwidget_manual(None).await;
+    chat.open_telegram_configure();
+    chat.handle_paste("bot-secret".to_string());
+    chat.handle_key_event(KeyEvent::from(KeyCode::Esc));
+    assert!(rx.try_recv().is_err());
+    chat.open_telegram_menu(TelegramCommandResponse {
+        configured: true,
+        ..Default::default()
+    });
+    chat.handle_key_event(KeyEvent::from(KeyCode::Down));
+    chat.handle_key_event(KeyEvent::from(KeyCode::Enter));
+    let AppEvent::TelegramCommand { params } = rx.try_recv().expect("disable") else {
+        panic!("expected disable")
+    };
+    assert_eq!(params, TelegramCommandParams::Disable {});
+    assert!(rx.try_recv().is_err());
+}
+
+#[tokio::test]
+async fn version_settings_keep_toggle_interval_and_probe_commands_distinct() {
+    let (mut chat, mut rx, _ops) = make_chatwidget_manual(None).await;
+    let mut config = TelegramCommandResponse {
+        configured: true,
+        github_token_configured: true,
+        notify_version_updates: true,
+        version_check_interval_hours: 20,
+        message: None,
+    };
+    chat.open_telegram_version(config.clone());
+    chat.handle_key_event(KeyEvent::from(KeyCode::Char(' ')));
+    let AppEvent::TelegramCommand { params } = rx.try_recv().expect("toggle version") else {
+        panic!("expected settings")
+    };
+    assert_eq!(
+        params,
+        TelegramCommandParams::SetVersionSettings {
+            notify_version_updates: false,
+            version_check_interval_hours: 20,
+        }
+    );
+    config.notify_version_updates = false;
+    chat.open_telegram_version(config.clone());
+    chat.handle_key_event(KeyEvent::from(KeyCode::Down));
+    chat.handle_key_event(KeyEvent::from(KeyCode::Enter));
+    let AppEvent::OpenTelegramInterval { config } = rx.try_recv().expect("interval picker") else {
+        panic!("expected interval picker")
+    };
+    chat.open_telegram_interval(config);
+    chat.handle_key_event(KeyEvent::from(KeyCode::Down));
+    chat.handle_key_event(KeyEvent::from(KeyCode::Enter));
+    let AppEvent::TelegramCommand { params } = rx.try_recv().expect("change interval") else {
+        panic!("expected settings")
+    };
+    assert_eq!(
+        params,
+        TelegramCommandParams::SetVersionSettings {
+            notify_version_updates: false,
+            version_check_interval_hours: 24,
+        }
+    );
+    chat.handle_key_event(KeyEvent::from(KeyCode::Esc));
+    chat.handle_key_event(KeyEvent::from(KeyCode::Down));
+    chat.handle_key_event(KeyEvent::from(KeyCode::Enter));
+    let AppEvent::TelegramCommand { params } = rx.try_recv().expect("GitHub probe") else {
+        panic!("expected probe")
+    };
+    assert_eq!(params, TelegramCommandParams::ProbeGithub {});
+    chat.handle_key_event(KeyEvent::from(KeyCode::Down));
+    chat.handle_key_event(KeyEvent::from(KeyCode::Enter));
+    let AppEvent::TelegramCommand { params } = rx.try_recv().expect("manual version check") else {
+        panic!("expected version check")
+    };
+    assert_eq!(params, TelegramCommandParams::CheckVersion {});
+}
