+/// Creates the selected Codex home and returns its canonical path.
+pub fn ensure_codex_home() -> std::io::Result<AbsolutePathBuf> {
+    let codex_home_env = std::env::var("CODEX_HOME")
+        .ok()
+        .filter(|val| !val.is_empty());
+    ensure_codex_home_from_env(codex_home_env.as_deref())
+}
+
+fn ensure_codex_home_from_env(codex_home_env: Option<&str>) -> std::io::Result<AbsolutePathBuf> {
+    let path = codex_home_env.map_or_else(|| PathBuf::from(DEFAULT_CODEX_HOME), PathBuf::from);
+    std::fs::create_dir_all(&path)?;
+    AbsolutePathBuf::from_absolute_path(path.canonicalize()?)
+}
+
 fn find_codex_home_from_env(codex_home_env: Option<&str>) -> std::io::Result<AbsolutePathBuf> {
