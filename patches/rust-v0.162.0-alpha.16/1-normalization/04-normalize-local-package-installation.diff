+#[test]
+fn local_selection_uses_the_short_link_and_observes_dist_switches() {
+    let temporary = tempfile::TempDir::new().expect("temporary directory");
+    let home = temporary.path().join("home");
+    let dist = temporary.path().join("build/dist");
+    std::fs::create_dir(&home).expect("home");
+    for version in ["first", "second"] {
+        let binary = dist.join(version).join("bin/codex");
+        std::fs::create_dir_all(binary.parent().expect("binary parent"))
+            .expect("package bin directory");
+        std::fs::write(binary, version).expect("package executable");
+        let package = dist.join(version);
+        std::fs::write(
+            package.join("codex-package.json"),
+            br#"{"version":"0.161.0-alpha.3"}"#,
+        )
+        .expect("package metadata");
+        for helper in [
+            "bin/codex-code-mode-host",
+            "codex-path/rg",
+            "codex-path/shuck",
+            "codex-path/tokei",
+            "codex-path/ccusage",
+            "codex-resources/bwrap",
+            "codex-resources/voice/bin/codex-voice-host",
+        ] {
+            let path = package.join(helper);
+            std::fs::create_dir_all(path.parent().expect("helper parent"))
+                .expect("helper directory");
+            std::fs::write(path, b"helper").expect("package helper");
+        }
+    }
+    let current = dist.join("current");
+    std::os::unix::fs::symlink("first", &current).expect("dist selection");
+    let home_release = home.join("release");
+    std::os::unix::fs::symlink(&current, &home_release).expect("stable home link");
+    assert_eq!(super::package_root(&home), home.clone());
+    assert_eq!(
+        super::managed_codex_bin(&home),
+        home_release.join("bin/codex")
+    );
+    assert_eq!(
+        super::managed_codex_bin(&home).canonicalize().unwrap(),
+        dist.join("first/bin/codex")
+    );
+    let replacement = dist.join(".current");
+    std::os::unix::fs::symlink("second", &replacement).expect("next selection");
+    std::fs::rename(replacement, &current).expect("atomic selection");
+    assert_eq!(std::fs::read_link(&home_release).unwrap(), current);
+    assert_eq!(
+        super::managed_codex_bin(&home).canonicalize().unwrap(),
+        dist.join("second/bin/codex")
+    );
+    let context = codex_install_context::InstallContext::from_exe(
+        /*is_macos*/ false,
+        Some(&super::managed_codex_bin(&home)),
+        /*method_override*/ None,
+    );
+    assert_eq!(
+        (
+            context.rg_command(),
+            context.code_mode_host_program(),
+            context.bundled_resource("bwrap").unwrap().into_path_buf(),
+            context
+                .bundled_resource("voice/bin/codex-voice-host")
+                .unwrap()
+                .into_path_buf(),
+            context
+                .package_layout
+                .as_ref()
+                .unwrap()
+                .path_dir
+                .as_ref()
+                .unwrap()
+                .to_path_buf(),
+        ),
+        (
+            dist.join("second/codex-path/rg"),
+            dist.join("second/bin/codex-code-mode-host"),
+            dist.join("second/codex-resources/bwrap"),
+            dist.join("second/codex-resources/voice/bin/codex-voice-host"),
+            dist.join("second/codex-path"),
+        )
+    );
+    assert!(!super::is_stable_standalone_release(
+        &home,
+        &super::managed_codex_bin(&home)
+    ));
+    assert!(!home.join("packages").exists());
+}
