+#[tokio::test]
+async fn short_local_selection_is_not_copied_or_replaced() {
+    let temporary = tempfile::TempDir::new().expect("temporary directory");
+    let home = temporary.path().join("home");
+    std::fs::create_dir(&home).expect("home");
+    let selected = temporary.path().join("build/dist/selected");
+    let selected_binary = package(&selected, "0.160.0");
+    let current = home.join("release");
+    std::os::unix::fs::symlink(&selected, &current).expect("local selection");
+    let source = temporary.path().join("other-package");
+    let source_binary = package(&source, "0.161.0");
+    let daemon = daemon(&home);
+    assert!(
+        prepare_from_package(
+            &daemon,
+            &DaemonSettings::default(),
+            InstallMode::Missing,
+            Some(&source),
+            &source_binary,
+            |_| panic!("local selection must not request installation"),
+        )
+        .await
+        .expect("reuse local package")
+    );
+    assert_eq!(std::fs::read_link(&current).unwrap(), selected);
+    assert_eq!(
+        crate::managed_install::managed_codex_bin(&home)
+            .canonicalize()
+            .unwrap(),
+        selected_binary
+    );
+    assert!(!home.join("packages").exists());
+    let error = prepare_from_package(
+        &daemon,
+        &DaemonSettings::default(),
+        InstallMode::Replace,
+        Some(&source),
+        &source_binary,
+        |_| panic!("local selection must not request replacement"),
+    )
+    .await
+    .expect_err("local installer owns selection");
+    assert!(error.to_string().contains("local build installer"));
+    assert_eq!(std::fs::read_link(&current).unwrap(), selected);
+    assert!(!home.join("packages").exists());
+}
