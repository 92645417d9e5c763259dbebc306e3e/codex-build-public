+#[tokio::test]
+async fn rejects_a_release_store_inside_its_source_before_staging() {
+    let temporary = tempfile::TempDir::new().expect("temporary directory");
+    let home = temporary.path().join("home");
+    let source = temporary.path().join("source");
+    let binary = package(&source, "0.161.0");
+    let root = home.join("packages/app-server-daemon");
+    std::fs::create_dir_all(&root).expect("daemon package root");
+    let releases = root.join("releases");
+    std::os::unix::fs::symlink(&source, &releases).expect("unsafe releases link");
+    let error = prepare_from_package(
+        &daemon(&home),
+        &DaemonSettings::default(),
+        InstallMode::Missing,
+        Some(&source),
+        &binary,
+        |_| panic!("missing installation must not request replacement"),
+    )
+    .await
+    .expect_err("source cannot contain its staging directory");
+    assert!(
+        error
+            .to_string()
+            .contains("release store must be outside the source CLI package")
+    );
+    assert_eq!(std::fs::read_link(&releases).unwrap(), source);
+    assert!(!root.join("current").exists());
+    let mut entries = std::fs::read_dir(&source)
+        .unwrap()
+        .map(|entry| entry.unwrap().file_name())
+        .collect::<Vec<_>>();
+    entries.sort();
+    assert_eq!(
+        entries,
+        ["bin", "codex-package.json", "codex-path", "codex-resources"]
+            .map(std::ffi::OsString::from)
+    );
+}
