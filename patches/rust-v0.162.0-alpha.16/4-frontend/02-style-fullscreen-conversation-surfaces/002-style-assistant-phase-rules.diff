+#[test]
+fn assistant_gutter_covers_raw_and_detailed_rows_without_changing_scrollback() {
+    let source = "first **answer**\n\nlast 界 answer";
+    let cell =
+        crate::history_cell::AgentMarkdownCell::new(source.into(), std::path::Path::new("."));
+    let scrollback = cell.display_lines(24);
+    assert!(scrollback[0].to_string().starts_with("• "));
+    assert!(
+        scrollback
+            .iter()
+            .all(|line| !line.to_string().contains('▌'))
+    );
+    let cells: Vec<Arc<dyn HistoryCell>> = vec![Arc::new(cell)];
+    for detailed in [false, true] {
+        let mut view = TranscriptView::default();
+        view.set_presentation(detailed, HistoryRenderMode::Raw);
+        let area = Rect::new(0, 0, 12, 20);
+        let mut buffer = Buffer::empty(area);
+        view.render(area, &mut buffer, &cells);
+        let layout = view.layout(&cells, 0).unwrap();
+        assert_eq!(
+            layout.text(),
+            if detailed {
+                "first answer\n\nlast 界 answer"
+            } else {
+                source
+            }
+        );
+        for y in 0..layout.row_count() as u16 {
+            assert_eq!(buffer[(0, y)].symbol(), "▌");
+        }
+        assert_eq!(cells[0].copy_source(), Some(source));
+    }
+}
