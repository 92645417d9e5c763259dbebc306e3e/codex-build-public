+                                },
+                            })
+                            .collect(),
+                        ..Default::default()
+                    });
+                    for width in [24, 60, 24] {
+                        let area = Rect::new(0, 0, width, 60);
+                        let mut buffer = Buffer::empty(area);
+                        view.render(area, &mut buffer, &cells);
+                        let color = crate::terminal_palette::rgb_color(
+                            if phase == Some(MessagePhase::Commentary) {
+                                commentary
+                            } else {
+                                final_answer
+                            },
+                        );
+                        let layout = view.layout(&cells, 0).unwrap();
+                        let mut native_lines = cells[0].retained_hyperlink_lines(width - 2, true);
+                        for line in &mut native_lines {
+                            line.source
+                                .get_or_insert_with(|| {
+                                    crate::terminal_hyperlinks::LogicalLineSource::from_line(
+                                        &line.line,
+                                    )
+                                })
+                                .right_reserve = 2;
+                        }
+                        let native = TextLayout::new(native_lines, width);
+                        let mut expected = Buffer::empty(area);
+                        native.render(area, &mut expected, 0);
+                        assert_eq!(layout.text(), native.text());
+                        assert_eq!(layout.row_count(), native.row_count());
+                        for y in 0..layout.row_count() as u16 {
+                            assert_eq!(buffer[(0, y)].symbol(), "▌");
+                            assert_eq!(buffer[(0, y)].fg, color);
+                            for x in 2..width {
+                                assert_eq!(buffer[(x, y)], expected[(x, y)], "body at ({x}, {y})");
+                            }
+                        }
+                        for row in buffer.content.chunks(usize::from(width)) {
+                            assert_eq!(row[usize::from(width - 2)].symbol(), " ");
+                            assert_eq!(row[usize::from(width - 1)].symbol(), " ");
+                        }
+                        assert!(layout.text().starts_with("same answer with a link"));
+                        assert_eq!(layout.rewrap(width).text(), layout.text());
+                        assert!(!layout.text().contains('▌'));
+                        assert_eq!(cells[0].copy_source(), Some(source));
+                        assert!(
+                            buffer
+                                .content
+                                .iter()
+                                .any(|cell| cell.modifier.contains(ratatui::style::Modifier::BOLD))
+                        );
+                        assert!((0..layout.row_count()).all(|row| {
+                            [0, 1, width - 2, width - 1]
+                                .into_iter()
+                                .all(|column| layout.link_at(row, column).is_none())
+                        }));
+                        assert!((0..layout.row_count()).any(|row| {
+                            (2..width - 2).any(|column| layout.link_at(row, column).is_some())
+                        }));
+                        let rewrapped = layout.rewrap(18);
+                        let area = Rect::new(0, 0, 18, rewrapped.row_count() as u16);
+                        let mut resized = Buffer::empty(area);
+                        rewrapped.render(area, &mut resized, 0);
+                        assert_eq!(rewrapped.text(), layout.text());
+                        for y in 0..area.height {
+                            assert_eq!(resized[(0, y)].symbol(), "▌");
+                            assert_eq!(resized[(0, y)].fg, color);
+                        }
+                    }
+                }
+            }
+        },
+    );
+    crate::render::highlight::set_syntax_theme(original);
+}
