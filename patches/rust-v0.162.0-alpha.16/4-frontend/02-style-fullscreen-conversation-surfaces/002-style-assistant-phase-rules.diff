+/// Resolve a conversation role from the active theme on its painted surface.
+/// Themes without that scope use their default foreground, not a fixed UI palette.
+pub(crate) fn theme_color_on(scopes: &[&str], background: Option<Color>) -> Color {
+    let preferred = crate::render::highlight::foreground_style_for_scopes(scopes)
+        .and_then(|style| style.fg)
+        .or_else(|| {
+            crate::render::highlight::current_syntax_theme()
+                .settings
+                .foreground
+                .and_then(crate::render::highlight::convert_syntect_color)
+        })
+        .unwrap_or(Color::Reset);
+    readable_color_on(preferred, background)
+}
