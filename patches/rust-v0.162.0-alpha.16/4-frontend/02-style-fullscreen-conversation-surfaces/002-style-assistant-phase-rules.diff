+        || {
+            for phase in [
+                Some(MessagePhase::Commentary),
+                Some(MessagePhase::FinalAnswer),
+                None,
+            ] {
+                let source = "same **answer** with [a link](https://example.com/docs)\n\n| Name | Value |\n| --- | --- |\n| Alpha | Beta |\n\n```rust\nlet answer = \"native syntax\";\n```";
+                let cells: Vec<Arc<dyn HistoryCell>> = vec![Arc::new(
+                    AgentMarkdownCell::new(source.into(), std::path::Path::new("."))
+                        .with_phase(phase.clone()),
