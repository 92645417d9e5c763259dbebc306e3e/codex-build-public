+#[tokio::test]
+async fn assistant_phase_reaches_live_consolidation_and_historical_text() -> Result<()> {
+    use codex_app_server_protocol::ItemCompletedNotification;
+    use codex_app_server_protocol::ServerNotification;
+    use codex_app_server_protocol::ThreadItem;
+    use codex_protocol::models::MessagePhase;
+
+    for (phase, scope) in [
+        (Some(MessagePhase::Commentary), "keyword"),
+        (Some(MessagePhase::FinalAnswer), "string"),
+        (None, "string"),
+    ] {
+        let color = crate::style::theme_color_on(&[scope], None);
+        let (mut app, mut events, _op_rx) = make_test_app_with_channels().await;
+        let thread_id = ThreadId::new();
+        attach_thread(&mut app, thread_id);
+        let mut tui = crate::tui::test_support::make_test_tui()?;
+        tui.set_owned_screen(/*owned*/ true)?;
+        let size = tui.terminal.last_known_screen_size;
+        let item = ThreadItem::AgentMessage {
+            id: "phase-message".into(),
+            text: "Phase-specific answer".into(),
+            phase: phase.clone(),
+            memory_citation: None,
+            delivery: None,
+            questions: None,
+        };
+        let historical = crate::thread_transcript::thread_items_to_transcript_cells(
+            Some(thread_id),
+            &app.config.cwd,
+            [item.clone()],
+            crate::thread_transcript::RawReasoningVisibility::Hidden,
+            Some(&app.config),
+        );
+        assert_eq!(historical.len(), 1);
+        assert_eq!(
+            historical[0]
+                .as_any()
+                .downcast_ref::<history_cell::AgentMarkdownCell>()
+                .unwrap()
+                .phase,
+            phase
+        );
+        app.chat_widget.handle_server_notification(
+            ServerNotification::ItemCompleted(ItemCompletedNotification {
+                thread_id: thread_id.to_string(),
+                turn_id: "phase-turn".into(),
+                completed_at_ms: 0,
+                item,
+            }),
+            None,
+        );
+        let mut consolidations = 0;
+        while let Ok(event) = events.try_recv() {
+            match event {
+                AppEvent::InsertHistoryCell(cell) => app.insert_history_cell(&mut tui, cell),
+                AppEvent::ConsolidateAgentMessage {
+                    source,
+                    copy_source,
+                    cwd,
+                    phase: completed_phase,
+                    inline_visualization_context,
+                    scrollback_reflow,
+                    deferred_history_cell,
+                } => {
+                    consolidations += 1;
+                    assert_eq!(completed_phase, phase);
+                    app.handle_consolidate_agent_message(
+                        &mut tui,
+                        history_cell::AgentMarkdownCell::new_with_inline_visualizations(
+                            source,
+                            &cwd,
+                            inline_visualization_context,
+                        )
+                        .with_copy_source(copy_source)
+                        .with_phase(completed_phase),
+                        scrollback_reflow,
+                        deferred_history_cell,
+                    )?;
+                }
+                _ => {}
+            }
+        }
+        assert_eq!(consolidations, 1);
+        let retained = app
+            .transcript_cells
+            .iter()
+            .filter_map(|cell| {
+                cell.as_any()
+                    .downcast_ref::<history_cell::AgentMarkdownCell>()
+            })
+            .collect::<Vec<_>>();
+        assert_eq!(retained.len(), 1);
+        assert_eq!(retained[0].phase, phase);
+        assert_eq!(retained[0].raw_lines(), historical[0].raw_lines());
+        for cells in [app.transcript_cells.clone(), historical] {
+            app.transcript_cells = cells;
+            app.render_owned_transcript(&mut tui, size)?;
+            let buffer = crate::custom_terminal::test_support::last_rendered_buffer(&tui.terminal);
+            let row = buffer
+                .content
+                .chunks(usize::from(size.width))
+                .find(|row| {
+                    row.iter()
+                        .map(ratatui::buffer::Cell::symbol)
+                        .collect::<String>()
+                        .contains("Phase-specific answer")
+                })
+                .expect("assistant body with a phase-colored gutter");
+            assert_eq!(row[0].symbol(), "▌");
+            assert_eq!(row[0].fg, color);
+            assert_eq!(row[2].fg, ratatui::style::Color::Reset);
+            assert!(
+                !buffer
+                    .content
+                    .chunks(usize::from(size.width))
+                    .any(|row| row.iter().all(|cell| cell.symbol() == "─"))
+            );
+        }
+        tui.set_owned_screen(/*owned*/ false)?;
+    }
+    Ok(())
+}
