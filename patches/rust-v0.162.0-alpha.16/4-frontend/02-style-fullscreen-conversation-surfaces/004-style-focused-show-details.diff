+#[test]
+fn switching_theme_updates_focused_activity_without_changing_text_or_emphasis() {
+    use syntect::highlighting::Color;
+    use syntect::highlighting::StyleModifier;
+    use syntect::highlighting::Theme;
+    use syntect::highlighting::ThemeItem;
+
+    let original = crate::render::highlight::current_syntax_theme();
+    crate::terminal_palette::with_test_default_colors(
+        crate::terminal_probe::DefaultColors {
+            fg: (220, 220, 220),
+            bg: (0, 0, 0),
+        },
+        || {
+            let mut view = TranscriptView::default();
+            view.disclosure.focused = Some(vec!["tool".to_owned()]);
+            let layout = TextLayout::new(vec![HyperlinkLine::from("$ echo ready")], 32)
+                .with_disclosure_control("+ Show details".to_owned())
+                .with_leading_separator();
+            let area = Rect::new(0, 0, 32, 3);
+            for (muted, accent) in [
+                ((180, 180, 180), (100, 190, 255)),
+                ((200, 180, 160), (220, 170, 255)),
+            ] {
+                crate::render::highlight::set_syntax_theme(Theme {
+                    scopes: [("comment", muted), ("codex.accent", accent)]
+                        .into_iter()
+                        .map(|(scope, (r, g, b))| ThemeItem {
+                            scope: scope.parse().unwrap(),
+                            style: StyleModifier {
+                                foreground: Some(Color { r, g, b, a: 255 }),
+                                ..Default::default()
+                            },
+                        })
+                        .collect(),
+                    ..Default::default()
+                });
+                let mut buffer = Buffer::empty(area);
+                layout.render(area, &mut buffer, 0);
+                for row in [1, 2] {
+                    view.render_disclosure(
+                        &["tool".to_owned()],
+                        &layout,
+                        row,
+                        Rect::new(0, row as u16, 32, 1),
+                        &mut buffer,
+                    );
+                }
+                assert_eq!(buffer[(0, 1)].fg, crate::terminal_palette::rgb_color(muted));
+                assert_eq!(buffer[(0, 1)].modifier, Modifier::ITALIC);
+                assert_eq!(
+                    buffer[(4, 2)].fg,
+                    crate::terminal_palette::rgb_color(accent)
+                );
+                assert_eq!(buffer[(4, 2)].modifier, Modifier::BOLD);
+                assert_eq!(layout.text(), "$ echo ready");
+            }
+        },
+    );
+    crate::render::highlight::set_syntax_theme(original);
+}
