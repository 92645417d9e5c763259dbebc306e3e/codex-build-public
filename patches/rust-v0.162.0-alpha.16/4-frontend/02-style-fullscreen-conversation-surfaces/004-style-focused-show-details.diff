+#[test]
+fn focused_activity_command_uses_theme_muted_text_while_its_control_keeps_emphasis() {
+    let mut view = TranscriptView::default();
+    view.disclosure.focused = Some(vec!["tool".to_owned()]);
+    let layout = TextLayout::new(vec![HyperlinkLine::from("$ echo ready")], 32)
+        .with_disclosure_control("+ Show details".to_owned())
+        .with_leading_separator();
+    let area = Rect::new(
+        /*x*/ 0, /*y*/ 0, /*width*/ 32, /*height*/ 3,
+    );
+    let mut buffer = Buffer::empty(area);
+    layout.render(area, &mut buffer, /*start_row*/ 0);
+    for row in [1, 2] {
+        view.render_disclosure(
+            &["tool".to_owned()],
+            &layout,
+            row,
+            Rect::new(0, row as u16, 32, 1),
+            &mut buffer,
+        );
+    }
+    let command = &buffer[(0, 1)];
+    assert_eq!(command.fg, crate::style::theme_color_on(&["comment"], None));
+    assert_eq!(command.modifier, Modifier::ITALIC);
+    let control = &buffer[(4, 2)];
+    assert_eq!(
+        control.fg,
+        crate::style::theme_color_on(&["codex.accent", "keyword"], None)
+    );
+    assert_eq!(control.modifier, Modifier::BOLD);
+    insta::assert_snapshot!(format!("{buffer:?}"));
+}
