+
+#[test]
+fn offscreen_prompt_has_gray_padding_right_margin_and_one_source_free_separator() {
+    let cells = vec![user("Previous question"), cell("answer continues")];
+    for width in [16, 30] {
+        for height in [7, 10] {
+            let mut view = TranscriptView::default();
+            view.jump_to_entry(&cells, /*index*/ 1);
+            let buffer = render(&mut view, &cells, width, height);
+            assert_eq!(view.area.y, 4);
+            let background = crate::style::history_prompt_style()
+                .bg
+                .unwrap_or(Color::Reset);
+            assert_eq!(buffer[(0, 1)].symbol(), "›");
+            for x in 0..width {
+                for y in 0..3 {
+                    assert_eq!(buffer[(x, y)].bg, background);
+                    assert_ne!(buffer[(x, y)].symbol(), "─");
+                }
+                for y in [0, 2, 3] {
+                    assert_eq!(buffer[(x, y)].symbol(), " ");
+                }
+                assert_eq!(buffer[(x, 3)].bg, Color::Reset);
+            }
+            for x in [width - 2, width - 1] {
+                assert_eq!(buffer[(x, 1)].symbol(), " ");
+            }
+            assert!(
+                view.visible
+                    .iter()
+                    .all(|row| row.layout.text() == "answer continues")
+            );
+            assert_eq!(view.visible[0].index, 1);
+        }
     }
 }
