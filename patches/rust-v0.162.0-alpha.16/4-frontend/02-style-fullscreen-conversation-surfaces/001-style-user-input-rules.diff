+
+#[test]
+fn user_prompt_keeps_upstream_background_without_rules_and_reserves_right_margin() {
+    let prompt = new_user_prompt("hello".into(), Vec::new(), Vec::new(), Vec::new());
+    let layout = TextLayout::new(prompt.display_hyperlink_lines(/*width*/ 20), 20);
+    assert_eq!(layout.text(), "\nhello\n");
+    let area = Rect::new(
+        /*x*/ 0, /*y*/ 0, /*width*/ 20, /*height*/ 3,
+    );
+    let mut buffer = Buffer::empty(area);
+    let cells: Vec<std::sync::Arc<dyn HistoryCell>> = vec![std::sync::Arc::new(prompt)];
+    let mut view = crate::transcript_view::TranscriptView::default();
+    view.render(area, &mut buffer, &cells);
+    let mut expected = Buffer::empty(area);
+    layout.render(area, &mut expected, /*start_row*/ 0);
+    assert_eq!(buffer, expected);
+    let body_bg = crate::style::history_prompt_style()
+        .bg
+        .unwrap_or(Color::Reset);
+    assert_eq!(buffer[(0, 1)].bg, body_bg);
+    assert_eq!(buffer[(19, 1)].bg, body_bg);
+    for y in 0..3 {
+        assert_eq!(buffer[(18, y)].symbol(), " ");
+        assert_eq!(buffer[(19, y)].symbol(), " ");
+    }
+    insta::assert_snapshot!(format!("{buffer:?}"));
+}
