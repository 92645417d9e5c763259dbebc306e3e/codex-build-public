+/// Resolve the configured editor command, falling back to `VISUAL` then `EDITOR`.
+pub(crate) fn resolve_editor_command(
+    configured: Option<&str>,
+) -> std::result::Result<Vec<String>, EditorError> {
+    let environment_command;
