+#[tokio::test]
+async fn external_editor_setting_uses_local_path_and_preserves_command_on_rejection() -> Result<()>
+{
+    let mut app = make_test_app().await;
+    let mut app_server = start_config_write_test_app_server(&app).await?;
+    let mut tui = crate::tui::test_support::make_test_tui()?;
+    let local_directory = tempdir()?;
+    let other_home = tempdir()?;
+    let local_path = local_directory.path().join("client-config.toml");
+    app.local_settings.user_config_path = local_path.abs();
+    app.config.codex_home = other_home.path().to_path_buf().abs();
+    app.reconnect.offline = true;
+
+    Box::pin(app.handle_event(
+        &mut tui,
+        &mut app_server,
+        AppEvent::ConfigureExternalEditor {
+            command: "nano --nowrap".to_string(),
+        },
+    ))
+    .await?;
+
+    assert_eq!(
+        app.local_settings.tui.external_editor.as_deref(),
+        Some("nano --nowrap")
+    );
+    let persisted = std::fs::read_to_string(&local_path)?;
+    let value: TomlValue = toml::from_str(&persisted)?;
+    assert_eq!(
+        value["tui"]["external_editor"].as_str(),
+        Some("nano --nowrap")
+    );
+    assert!(!other_home.path().join("config.toml").exists());
+    for command in ["", "'unterminated"] {
+        Box::pin(app.handle_event(
+            &mut tui,
+            &mut app_server,
+            AppEvent::ConfigureExternalEditor {
+                command: command.to_string(),
+            },
+        ))
+        .await?;
+        assert_eq!(
+            app.local_settings.tui.external_editor.as_deref(),
+            Some("nano --nowrap")
+        );
+        assert_eq!(std::fs::read_to_string(&local_path)?, persisted);
+    }
+    let blocked_path = local_directory.path().join("not-a-directory");
+    std::fs::write(&blocked_path, "preserve this file")?;
+    app.local_settings.user_config_path = blocked_path.join("config.toml").abs();
+    Box::pin(app.handle_event(
+        &mut tui,
+        &mut app_server,
+        AppEvent::ConfigureExternalEditor {
+            command: "other-editor".to_string(),
+        },
+    ))
+    .await?;
+    assert_eq!(
+        app.local_settings.tui.external_editor.as_deref(),
+        Some("nano --nowrap")
+    );
+    assert_eq!(std::fs::read_to_string(blocked_path)?, "preserve this file");
+    app_server.shutdown().await?;
+    Ok(())
+}
