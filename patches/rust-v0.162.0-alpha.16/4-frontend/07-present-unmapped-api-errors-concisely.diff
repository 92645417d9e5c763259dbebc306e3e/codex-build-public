+#[tokio::test]
+async fn live_unmapped_http_error_is_concise_with_private_full_body() {
+    let (mut chat, mut rx, _op_rx) = make_chatwidget_manual(/*model_override*/ None).await;
+    let message = r#"{"status":400,"error":{"message":"private provider body"}}"#;
+    let log_path = chat.config.log_dir.join("api-errors.log");
+    std::fs::create_dir_all(&chat.config.log_dir).unwrap();
+    std::fs::write(&log_path, "previous private body\n").unwrap();
+
+    handle_error(&mut chat, message, Some(CodexErrorInfo::BadRequest));
+
+    let lines = drain_insert_history(&mut rx)
+        .into_iter()
+        .flatten()
+        .collect::<Vec<_>>();
+    assert_eq!(lines_to_single_string(&lines), "■ HTTP 400\n");
+    assert_eq!(
+        std::fs::read_to_string(&log_path).expect("read private API error log"),
+        format!("previous private body\n{message}\n")
+    );
+    {
+        use std::os::unix::fs::PermissionsExt;
+
+        assert_eq!(
+            std::fs::metadata(log_path)
+                .expect("private API error log metadata")
+                .permissions()
+                .mode()
+                & 0o777,
+            0o600
+        );
+    }
+}
