+fn leading_http_status(value: &str) -> Option<u16> {
+    let digits = value
+        .as_bytes()
+        .iter()
+        .take_while(|byte| byte.is_ascii_digit())
+        .count();
+    value
+        .get(..digits)?
+        .parse::<u16>()
+        .ok()
+        .filter(|status| (100..=599).contains(status))
+}
+
+fn explicit_http_status(message: &str) -> Option<u16> {
+    let message = message.trim();
+    if let Some(value) = message.strip_prefix("unexpected status ") {
+        return leading_http_status(value);
+    }
+    if let Some((_, value)) = message.split_once("HTTP ") {
+        return leading_http_status(value);
+    }
+    let response = serde_json::from_str::<serde_json::Value>(message).ok()?;
+    response.get("error")?;
+    let status = response.get("status")?;
+    status
+        .as_u64()
+        .and_then(|value| u16::try_from(value).ok())
+        .filter(|value| (100..=599).contains(value))
+        .or_else(|| status.as_str().and_then(leading_http_status))
+}
+
+fn unmapped_http_status(message: &str, info: Option<&AppServerCodexErrorInfo>) -> Option<u16> {
+    match info {
+        Some(
+            AppServerCodexErrorInfo::HttpConnectionFailed { http_status_code }
+            | AppServerCodexErrorInfo::ResponseStreamConnectionFailed { http_status_code }
+            | AppServerCodexErrorInfo::ResponseStreamDisconnected { http_status_code }
+            | AppServerCodexErrorInfo::ResponseTooManyFailedAttempts { http_status_code },
+        ) => http_status_code
+            .filter(|status| (100..=599).contains(status))
+            .or_else(|| explicit_http_status(message)),
+        Some(AppServerCodexErrorInfo::Other)
+        | Some(AppServerCodexErrorInfo::BadRequest)
+        | Some(AppServerCodexErrorInfo::Unauthorized)
+        | Some(AppServerCodexErrorInfo::InternalServerError)
+        | None => explicit_http_status(message),
+        Some(AppServerCodexErrorInfo::ContextWindowExceeded)
+        | Some(AppServerCodexErrorInfo::SessionBudgetExceeded)
+        | Some(AppServerCodexErrorInfo::UsageLimitExceeded)
+        | Some(AppServerCodexErrorInfo::RateLimitExceeded)
+        | Some(AppServerCodexErrorInfo::ServerOverloaded)
+        | Some(AppServerCodexErrorInfo::CyberPolicy)
+        | Some(AppServerCodexErrorInfo::MisalignmentPolicyViolation)
+        | Some(AppServerCodexErrorInfo::ThreadRollbackFailed)
+        | Some(AppServerCodexErrorInfo::SandboxError)
+        | Some(AppServerCodexErrorInfo::FlexUnavailable)
+        | Some(AppServerCodexErrorInfo::TooManyDenials)
+        | Some(AppServerCodexErrorInfo::ActiveTurnNotSteerable { .. }) => None,
+    }
+}
+
+fn append_api_error(log_dir: &Path, message: &str) -> std::io::Result<()> {
+    std::fs::create_dir_all(log_dir)?;
+    let path = log_dir.join(API_ERROR_LOG_FILE);
+    let mut options = std::fs::OpenOptions::new();
+    options.create(true).append(true).mode(0o600);
+    let mut file = options.open(&path)?;
+    file.set_permissions(std::fs::Permissions::from_mode(0o600))?;
+    writeln!(file, "{message}")
+}
