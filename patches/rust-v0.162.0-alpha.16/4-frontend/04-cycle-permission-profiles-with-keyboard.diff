+#[tokio::test]
+async fn default_permission_keys_cycle_custom_profiles_and_skip_disabled_choices() {
+    let (mut chat, mut events, _ops) = make_chatwidget_manual(/*model_override*/ None).await;
+    let thread_id = ThreadId::new();
+    chat.thread_id = Some(thread_id);
+    chat.set_approval_policy(AskForApproval::OnRequest);
+    chat.config
+        .permissions
+        .set_permission_profile_from_session_snapshot(PermissionProfileSnapshot::active(
+            PermissionProfile::read_only(),
+            ActivePermissionProfile::new(":read-only"),
+        ))
+        .expect("current read-only profile");
+    let mut discovery = crate::permission_discovery::PermissionDiscovery::local(&chat.config);
+    for (id, allowed) in [("blocked", false), ("server-only", true)] {
+        discovery
+            .profiles
+            .push(codex_app_server_protocol::PermissionProfileSummary {
+                id: id.to_string(),
+                description: None,
+                allowed,
+            });
+    }
+    chat.handle_key_event(KeyEvent::new(KeyCode::Char('='), KeyModifiers::ALT));
+    let request_id = assert_matches!(events.try_recv(), Ok(AppEvent::FetchPermissionProfiles { request_id, .. }) => request_id);
+    chat.handle_key_event(KeyEvent::new(KeyCode::Char('-'), KeyModifiers::ALT));
+    assert!(
+        events.try_recv().is_err(),
+        "retain the first direction while loading"
+    );
+    chat.on_permission_profiles_loaded(request_id, Ok(discovery.clone()));
+    assert!(!chat.bottom_pane.has_active_view());
+    let AppEvent::ApplyPermissionShortcut { selection, .. } =
+        events.try_recv().expect("next custom profile")
+    else {
+        panic!("expected session permission selection");
+    };
+    assert_eq!(selection.profile_id, "server-only");
+    assert_eq!(selection.approval_policy, None);
+    assert_eq!(selection.approvals_reviewer, None);
+    chat.complete_permission_shortcut(thread_id);
+    chat.config
+        .permissions
+        .set_permission_profile_from_session_snapshot(PermissionProfileSnapshot::active(
+            PermissionProfile::read_only(),
+            ActivePermissionProfile::new("server-only"),
+        ))
+        .expect("server-applied profile");
+    chat.permission_discovery = None;
+    chat.handle_key_event(KeyEvent::new(KeyCode::Char('-'), KeyModifiers::ALT));
+    let request_id = assert_matches!(events.try_recv(), Ok(AppEvent::FetchPermissionProfiles { request_id, .. }) => request_id);
+    chat.on_permission_profiles_loaded(request_id, Ok(discovery));
+    assert!(!chat.bottom_pane.has_active_view());
+    let AppEvent::ApplyPermissionShortcut { selection, .. } =
+        events.try_recv().expect("previous available profile")
+    else {
+        panic!("expected session permission selection");
+    };
+    assert_eq!(selection.profile_id, ":read-only");
+    assert_eq!(selection.approval_policy, Some(AskForApproval::OnRequest));
+    assert!(events.try_recv().is_err());
+}
