+#[tokio::test]
+async fn fullscreen_quota_warnings_do_not_enter_history_or_warning_notice() {
+    let (mut chat, mut rx, _) = make_chatwidget_manual(Some("gpt-5")).await;
+    assert!(chat.local_settings.tui.fullscreen_transcript);
+    chat.has_chatgpt_account = true;
+    for (used_percent, threshold_index, should_prompt) in
+        [(75.0, 2, false), (90.0, 3, true), (95.0, 4, true)]
+    {
+        chat.on_rate_limit_snapshot(Some(snapshot(used_percent)));
+        assert!(drain_insert_history(&mut rx).is_empty());
+        assert_eq!(chat.usage_notice(/*width*/ 120), None);
+        assert_eq!(
+            chat.rate_limit_snapshots_by_limit_id["codex"]
+                .primary
+                .as_ref()
+                .unwrap()
+                .used_percent,
+            used_percent,
+        );
+        assert_eq!(chat.rate_limit_warnings.primary_index, threshold_index);
+        // The native switch prompt starts at 90%, independently of quota warnings.
+        if should_prompt {
+            assert!(matches!(
+                chat.rate_limit_switch_prompt,
+                RateLimitSwitchPromptState::Pending
+            ));
+        } else {
+            assert!(matches!(
+                chat.rate_limit_switch_prompt,
+                RateLimitSwitchPromptState::Idle
+            ));
+        }
+    }
+
+    // Quota suppression is at its producer, not the shared warning-cell route.
+    chat.add_to_history(history_cell::new_warning_event("ordinary warning".into()));
+    chat.add_to_history(history_cell::new_usage_warning_event(
+        "retained warning".into(),
+    ));
+    assert_eq!(drain_insert_history(&mut rx).len(), 2);
+
+    let mut funded = snapshot(/*percent*/ 95.0);
+    funded.credits = Some(CreditsSnapshot {
+        has_credits: true,
+        unlimited: false,
+        balance: Some("25.00".into()),
+    });
+    chat.on_rate_limit_snapshot(Some(funded));
+    assert!(matches!(
+        chat.rate_limit_switch_prompt,
+        RateLimitSwitchPromptState::Idle
+    ));
+    assert!(drain_insert_history(&mut rx).is_empty());
+    assert_eq!(chat.usage_notice(/*width*/ 120), None);
+}
