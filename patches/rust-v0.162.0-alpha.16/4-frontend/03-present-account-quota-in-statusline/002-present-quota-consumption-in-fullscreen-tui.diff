 impl RateLimitWindowDisplay {
+    /// Compare quota use with elapsed time in this same, still-active window.
+    pub(crate) fn consumption(&self, now: i64) -> Option<RateLimitConsumption> {
+        let duration = self.window_minutes?.checked_mul(60)?;
+        let remaining = self.resets_at_unix?.checked_sub(now)?;
+        if duration <= 0 || remaining <= 0 || remaining > duration {
+            return None;
+        }
+        let elapsed = (duration - remaining) as f64 / duration as f64 * 100.0;
+        let used = self.used_percent.clamp(0.0, 100.0);
+        Some(RateLimitConsumption {
+            pace: (elapsed - used).round() as i32,
+            usage_rate: (elapsed > 0.0).then(|| used / elapsed),
+        })
+    }
