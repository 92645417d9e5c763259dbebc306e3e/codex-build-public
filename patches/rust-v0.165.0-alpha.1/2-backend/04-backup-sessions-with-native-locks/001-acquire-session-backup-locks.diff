+#[tokio::test]
+async fn backup_excludes_reference_materialization_until_release() {
+    let home = TempDir::new().unwrap();
+    let harness = TempDir::new().unwrap();
+    let plain = home.path().join("source.jsonl");
+    let compressed = plain.with_extension("jsonl.zst");
+    fs::write(
+        &compressed,
+        zstd::stream::encode_all(&b"source bytes\n"[..], 0).unwrap(),
+    )
+    .unwrap();
+    let backup = super::try_acquire_session_backup_lock(home.path(), harness.path()).unwrap();
+    let materialize_harness = harness.path().to_path_buf();
+    let source = compressed.clone();
+    let mut materialize = tokio::spawn(async move {
+        crate::materialize_rollout_for_reference(&source, &materialize_harness).await
+    });
+    assert!(
+        tokio::time::timeout(std::time::Duration::from_millis(30), &mut materialize)
+            .await
+            .is_err()
+    );
+    assert!(!plain.exists());
+    assert!(compressed.exists());
+    drop(backup);
+    assert_eq!(materialize.await.unwrap().unwrap(), plain);
+    assert_eq!(fs::read(&plain).unwrap(), b"source bytes\n");
+    assert!(!compressed.exists());
+}
