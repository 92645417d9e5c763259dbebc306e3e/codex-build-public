+    let backup = super::try_acquire_session_backup_lock(home.path(), harness.path()).unwrap();
+    let update_home = home.path().to_path_buf();
+    let thread_id = ThreadId::default();
+    let mut update = tokio::spawn(async move {
+        crate::append_thread_name(&update_home, thread_id, "after backup").await
+    });
+    assert!(
+        tokio::time::timeout(std::time::Duration::from_millis(30), &mut update)
+            .await
+            .is_err()
+    );
+    assert!(!home.path().join("session_index.jsonl").exists());
+    drop(backup);
+    update.await.unwrap().unwrap();
+    assert_eq!(
+        crate::find_thread_name_by_id(home.path(), &thread_id)
+            .await
+            .unwrap(),
+        Some("after backup".to_string())
+    );
+}
