+/// Excludes live writers, publication, maintenance and session-name updates together.
+/// Raw writer files must close before coordination; WriterLockGuard's cleanup would relock it.
+pub struct SessionBackupGuard {
+    _writers: Vec<File>,
+    _session_index: File,
+    _coordination: File,
+    _maintenance: crate::RolloutMaintenanceGuard,
+}
+
+/// Acquires the native session-data locks without waiting or removing lock files.
+/// Returns `WouldBlock` when any owner is active and releases every partial acquisition.
+/// The harness must be the namespace used by the selected home's writers and maintenance.
+pub fn try_acquire_session_backup_lock(
+    codex_home: &Path,
+    codex_harness: &Path,
+) -> io::Result<SessionBackupGuard> {
+    let maintenance =
+        crate::try_acquire_rollout_maintenance_lock(codex_harness)?.ok_or_else(|| {
+            io::Error::new(io::ErrorKind::WouldBlock, "rollout maintenance is active")
+        })?;
+    let coordinator = WriterLockCoordinator::new(codex_harness);
+    let coordination = coordinator.open_coordination()?;
+    try_backup_lock(&coordination, "thread writer coordination is active")?;
+    let paths = thread_lock_paths(&coordinator.directory)?;
+    let mut writers = Vec::with_capacity(paths.len());
+    for path in &paths {
+        let file = OpenOptions::new().read(true).write(true).open(path)?;
+        try_backup_lock(&file, &format!("active thread writer: {}", path.display()))?;
+        writers.push(file);
+    }
+    // Index updates lock the home directory, so atomic index replacement keeps one lock inode.
+    let session_index = File::open(codex_home)?;
+    try_backup_lock(&session_index, "session index update is active")?;
+    if paths != thread_lock_paths(&coordinator.directory)? {
+        return Err(io::Error::new(
+            io::ErrorKind::WouldBlock,
+            "thread writer lock set changed during backup acquisition",
+        ));
+    }
+    Ok(SessionBackupGuard {
+        _writers: writers,
+        _session_index: session_index,
+        _coordination: coordination,
+        _maintenance: maintenance,
+    })
+}
+
+fn try_backup_lock(file: &File, busy: &str) -> io::Result<()> {
+    file.try_lock().map_err(|error| match error {
+        fs::TryLockError::WouldBlock => io::Error::new(io::ErrorKind::WouldBlock, busy),
+        fs::TryLockError::Error(error) => error,
+    })
+}
+
+fn thread_lock_paths(directory: &Path) -> io::Result<Vec<PathBuf>> {
+    let mut paths = Vec::new();
+    for entry in fs::read_dir(directory)? {
+        let entry = entry?;
+        if entry
+            .file_name()
+            .to_str()
+            .and_then(|name| name.strip_suffix(".lock"))
+            .is_some_and(|id| ThreadId::from_string(id).is_ok())
+        {
+            paths.push(entry.path());
+        }
+    }
+    paths.sort();
+    Ok(paths)
+}
