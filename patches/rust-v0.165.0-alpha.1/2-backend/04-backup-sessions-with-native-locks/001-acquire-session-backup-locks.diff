 use pretty_assertions::assert_eq;
 use std::io::ErrorKind;
 
+#[test]
+fn backup_requires_every_native_lock_and_releases_partial_acquisitions() {
+    let home = TempDir::new().unwrap();
+    let harness = TempDir::new().unwrap();
+    let coordinator = Arc::new(WriterLockCoordinator::new(harness.path()));
+    let thread_id = ThreadId::default();
+    let writer = coordinator.acquire(thread_id).unwrap();
+    let attempt = || {
+        super::try_acquire_session_backup_lock(home.path(), harness.path())
+            .err()
+            .expect("backup must refuse a busy native lock")
+    };
+    assert_eq!(attempt().kind(), ErrorKind::WouldBlock);
+    drop(writer);
+
+    let maintenance = crate::try_acquire_rollout_maintenance_lock(harness.path())
+        .unwrap()
+        .unwrap();
+    assert_eq!(attempt().kind(), ErrorKind::WouldBlock);
+    drop(maintenance);
+
+    let coordination = coordinator.lock_coordination().unwrap();
+    assert_eq!(attempt().kind(), ErrorKind::WouldBlock);
+    drop(coordination);
+
+    let index = fs::File::open(home.path()).unwrap();
+    index.lock().unwrap();
+    assert_eq!(attempt().kind(), ErrorKind::WouldBlock);
+    drop(index);
+
+    let stale = harness
+        .path()
+        .join(WRITER_LOCK_DIR)
+        .join(format!("{thread_id}.lock"));
+    fs::File::create(&stale).unwrap();
+    let backup = super::try_acquire_session_backup_lock(home.path(), harness.path()).unwrap();
+    assert!(
+        crate::try_acquire_rollout_maintenance_lock(harness.path())
+            .unwrap()
+            .is_none()
+    );
+    let coordination = coordinator.open_coordination().unwrap();
+    assert!(matches!(
+        coordination.try_lock(),
+        Err(fs::TryLockError::WouldBlock)
+    ));
+    let index = fs::File::open(home.path()).unwrap();
+    assert!(matches!(
+        index.try_lock(),
+        Err(fs::TryLockError::WouldBlock)
+    ));
+    let thread = fs::File::open(&stale).unwrap();
+    assert!(matches!(
+        thread.try_lock(),
+        Err(fs::TryLockError::WouldBlock)
+    ));
+    drop(thread);
+    drop(index);
+    drop(coordination);
+    drop(backup);
+    assert!(
+        stale.exists(),
+        "backup must not take over or remove native locks"
+    );
+    drop(coordinator.acquire(thread_id).unwrap());
+    drop(super::try_acquire_session_backup_lock(home.path(), harness.path()).unwrap());
+}
+
+#[tokio::test]
