@@ -875,11 +875,22 @@ impl ThreadRequestProcessor {
 
     pub(crate) async fn thread_list(
         &self,
-        params: ThreadListParams,
+        mut params: ThreadListParams,
+        app_server_client_name: Option<&str>,
     ) -> Result<Option<ClientResponsePayload>, JSONRPCErrorError> {
-        self.thread_list_response_inner(params)
-            .await
-            .map(|response| Some(response.into()))
+        let limit_to_recent = app_server_client_name != Some("codex-tui");
+        if limit_to_recent {
+            params.cursor = None;
+            params.limit = Some(5);
+            params.sort_key = Some(ThreadSortKey::UpdatedAt);
+            params.sort_direction = Some(SortDirection::Desc);
+        }
+        let mut response = self.thread_list_response_inner(params).await?;
+        if limit_to_recent {
+            response.next_cursor = None;
+            response.backwards_cursor = None;
+        }
+        Ok(Some(response.into()))
     }
 
