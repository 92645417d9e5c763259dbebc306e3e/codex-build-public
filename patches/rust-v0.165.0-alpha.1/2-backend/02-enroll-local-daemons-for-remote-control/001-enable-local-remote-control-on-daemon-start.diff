+#[tokio::test]
+async fn managed_auto_start_leaves_existing_daemon_remote_policy_unchanged() {
+    let home = TempDir::new().unwrap();
+    let (daemon, _) = manual_update_daemon(&home);
+    let args_path = home.path().join("launch-args");
+    std::fs::write(
+        &daemon.settings_file,
+        r#"{"remoteControlEnabled":false,"updater":{"autoUpdateEnabled":false}}"#,
+    )
+    .unwrap();
+    codex_utils_cargo_bin::write_executable(
+        &daemon.managed_codex_bin,
+        &format!(
+            "#!/bin/sh\nif [ \"$1\" = --version ]; then echo codex 1.0.0; exit; fi\nif [ \"$3\" = --help ]; then exit; fi\nprintf '%s\\n' \"$@\" > '{}'\nexec sleep 30\n",
+            args_path.display(),
+        ),
+    )
+    .unwrap();
+    let control = async {
+        let deadline = tokio::time::Instant::now() + Duration::from_secs(10);
+        while !args_path.exists() {
+            assert!(
+                tokio::time::Instant::now() < deadline,
+                "daemon did not launch"
+            );
+            tokio::time::sleep(Duration::from_millis(20)).await;
+        }
+        test_control_server(&daemon, home.path())
+            .await
+            .abort_handle()
+    };
+    let features = std::collections::BTreeMap::new();
+    let (started, server) = tokio::join!(
+        daemon.start(&features, crate::StartIntent::Internal),
+        control
+    );
+    assert_eq!(started.unwrap().status, crate::LifecycleStatus::Started);
+    let original_args = std::fs::read_to_string(&args_path).unwrap();
+    assert!(!original_args.contains("--remote-control"));
+
+    let reused = daemon
+        .start(&features, crate::StartIntent::ManagedAutoStart)
+        .await
+        .unwrap();
+    assert_eq!(reused.status, crate::LifecycleStatus::AlreadyRunning);
+    assert!(!daemon.load_settings().await.unwrap().remote_control_enabled);
+    assert_eq!(std::fs::read_to_string(&args_path).unwrap(), original_args);
+    daemon.stop().await.unwrap();
+    server.abort();
+}
