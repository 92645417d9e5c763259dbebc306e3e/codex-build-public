+#[tokio::test]
+async fn search_keeps_active_and_archived_rollouts_separate() -> io::Result<()> {
+    let home = TempDir::new()?;
+    let active = home.path().join("sessions/2026/10/24");
+    let archived = home.path().join("sessions/archives");
+    let line = br#"{"timestamp":"2025-01-01T00:00:00Z","type":"event_msg","payload":{"type":"agent_message","message":"needle"}}"#;
+    let compressed = zstd::stream::encode_all(&line[..], 3)?;
+    for root in [&active, &archived] {
+        std::fs::create_dir_all(root)?;
+        std::fs::write(root.join("rollout-plain.jsonl"), line)?;
+        std::fs::write(root.join("rollout-compressed.jsonl.zst"), &compressed)?;
+    }
+    assert!(
+        ripgrep_rollout_paths(Path::new("rg"), &active, false, "needle")
+            .await?
+            .is_some()
+    );
+    let missing_rg = home.path().join("missing-rg");
+    for rg in [Path::new("rg"), missing_rg.as_path()] {
+        for (is_archived, root) in [(false, &active), (true, &archived)] {
+            assert_eq!(
+                search_rollout_paths(rg, home.path(), is_archived, "needle").await?,
+                HashSet::from([
+                    root.join("rollout-plain.jsonl"),
+                    root.join("rollout-compressed.jsonl"),
+                ]),
+            );
+        }
+    }
+    Ok(())
+}
