+#[tokio::test]
+async fn backfill_prefers_active_metadata_before_and_after_archive_checkpoints() {
+    for history_mode in [ThreadHistoryMode::Legacy, ThreadHistoryMode::Paginated] {
+        for checkpoint_archived in [None, Some(true), Some(false)] {
+            let dir = tempdir().expect("tempdir");
+            let home = dir.path();
+            let uuid = Uuid::new_v4();
+            let id = ThreadId::from_string(&uuid.to_string()).expect("thread id");
+            let archive_source = write_rollout_in_sessions_with_cwd(
+                home,
+                "2026-01-27T12-34-56",
+                "2026-01-27T12:34:56Z",
+                uuid,
+                home.join("old-workspace"),
+                Some(GitInfo {
+                    commit_hash: None,
+                    branch: Some("retained-branch".into()),
+                    repository_url: None,
+                }),
+                history_mode,
+            );
+            let archived_path = home
+                .join(ARCHIVED_SESSIONS_SUBDIR)
+                .join(archive_source.file_name().expect("archive filename"));
+            std::fs::create_dir_all(archived_path.parent().expect("archive parent"))
+                .expect("create archive directory");
+            std::fs::rename(&archive_source, &archived_path).expect("archive rollout");
+            let active_source = write_rollout_in_sessions_with_cwd(
+                home,
+                "2026-01-27T12-35-56",
+                "2026-01-27T12:35:56Z",
+                uuid,
+                home.join("active-workspace"),
+                None,
+                history_mode,
+            );
+            let active_path = home
+                .join("sessions/2026/01/27")
+                .join(active_source.file_name().expect("active filename"));
+            std::fs::create_dir_all(active_path.parent().expect("active parent"))
+                .expect("create active date directory");
+            std::fs::rename(&active_source, &active_path).expect("place active rollout");
+            let runtime = codex_state::StateRuntime::init(
+                codex_state::SqliteConfig::new_for_testing(home.abs()),
+                "test-provider".to_string(),
+            )
+            .await
+            .expect("initialize runtime");
+
+            if let Some(archived) = checkpoint_archived {
+                let path = if archived {
+                    &archived_path
+                } else {
+                    &active_path
+                };
+                let mut metadata = extract_metadata_from_rollout(path, "test-provider")
+                    .await
+                    .expect("extract checkpoint metadata")
+                    .metadata;
+                if archived {
+                    metadata.archived_at = Some(metadata.updated_at);
+                }
+                runtime
+                    .upsert_thread(&metadata)
+                    .await
+                    .expect("seed checkpoint row");
+                runtime
+                    .checkpoint_backfill(&backfill_watermark_for_path(home, path))
+                    .await
+                    .expect("checkpoint processed rollout");
+            }
+
+            backfill_sessions_with_lease(runtime.as_ref(), home, "test-provider", 0).await;
+
+            let stored = runtime
+                .get_thread(id)
+                .await
+                .expect("get thread")
+                .expect("backfilled row");
+            assert_eq!(stored.rollout_path, active_path);
+            assert_eq!(stored.cwd, home.join("active-workspace"));
+            assert_eq!(stored.archived_at, None);
+            assert_eq!(stored.history_mode, history_mode);
+            assert_eq!(
+                stored.git_branch.as_deref(),
+                if checkpoint_archived == Some(false) {
+                    None
+                } else {
+                    Some("retained-branch")
+                },
+                "archives still seed retained Git fields before active metadata replaces the row",
+            );
+            let state = runtime.get_backfill_state().await.expect("backfill state");
+            assert_eq!(state.status, BackfillStatus::Complete);
+            assert_eq!(
+                state.last_watermark,
+                Some(backfill_watermark_for_path(home, &active_path)),
+            );
+        }
+    }
+}
