+#[tokio::test]
+async fn pruning_retains_busy_writers_and_preserves_stale_lock_files() -> std::io::Result<()> {
+    let home = TempDir::new()?;
+    let harness = TempDir::new()?;
+    let busy_id = ThreadId::new();
+    let stale_id = ThreadId::new();
+    let coordinator = Arc::new(crate::WriterLockCoordinator::new(harness.path()));
+    let writer = coordinator.acquire(busy_id)?;
+    let stale_lock = harness
+        .path()
+        .join("thread-writer-locks")
+        .join(format!("{stale_id}.lock"));
+    std::fs::write(&stale_lock, b"stale lock")?;
+    append_thread_name(home.path(), busy_id, "busy").await?;
+    append_thread_name(home.path(), stale_id, "stale").await?;
+    let index_path = session_index_path(home.path());
+    std::fs::OpenOptions::new()
+        .append(true)
+        .open(&index_path)?
+        .write_all(b"malformed\n")?;
+    let maintenance = Arc::new(
+        crate::try_acquire_rollout_maintenance_lock(harness.path())?.expect("maintenance lock"),
+    );
+
+    prune_thread_names_without_rollouts(home.path(), harness.path(), Arc::clone(&maintenance))
+        .await?;
+    assert_eq!(
+        find_thread_names_by_ids(home.path(), &HashSet::from([busy_id, stale_id])).await?,
+        HashMap::from([(busy_id, "busy".to_string())]),
+    );
+    assert_eq!(std::fs::read(&stale_lock)?, b"stale lock");
+    assert!(std::fs::read_to_string(&index_path)?.contains("malformed\n"));
+
+    drop(writer);
+    prune_thread_names_without_rollouts(home.path(), harness.path(), maintenance).await?;
+    assert_eq!(find_thread_name_by_id(home.path(), &busy_id).await?, None);
+    Ok(())
+}
