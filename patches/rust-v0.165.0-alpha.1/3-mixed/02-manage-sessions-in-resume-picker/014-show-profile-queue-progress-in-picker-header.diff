 impl ProfileQueue {
     pub(super) fn is_running(&self) -> bool {
         !self.pending.is_empty()
     }
+
+    pub(super) fn progress_label(&self) -> Option<String> {
+        let total = self.finished + self.pending.len();
+        if total == 0 {
+            return None;
+        }
+        Some(format!("apply {}/{total}", self.finished))
+    }
 }
 
