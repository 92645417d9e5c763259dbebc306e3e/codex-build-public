+#[test]
+fn profile_progress_follows_header_percentage_without_changing_shortcut_hints() {
+    for width in [50u16, 80, 220] {
+        let (mut state, _) = test_picker();
+        state.view_persistence = Some(SessionPickerViewPersistence {
+            codex_home: PathBuf::from("/tmp/profile-home"),
+        });
+        state.profile_names = (0..=9).map(|slot| (slot, format!("p{slot}"))).collect();
+        state.all_rows = (0..3).map(|_| test_row(ThreadId::new())).collect();
+        state.apply_filter();
+        let hints = profiles::hint_lines(&state.profile_names, width);
+        let header_width = width.saturating_sub(state.action.title().width() as u16 + 4);
+        assert!(!picker_footer_progress_label(&state, 6, header_width).contains("apply"));
+        for index in 0..3 {
+            state.selected = index;
+            state.request_profile(index as u8);
+            assert_eq!(footer_hint_lines(&state, width)[2..], hints);
+            let label = picker_footer_progress_label(&state, 6, header_width);
+            assert!(label.contains(&format!("% · apply 0/{}", index + 1)));
+            assert!(UnicodeWidthStr::width(label.as_str()) < usize::from(header_width));
+        }
+        let first = state.filtered_rows[0].thread_id.unwrap();
+        state.finish_profile(first, Err(std::io::Error::other("settings rejected")));
+        assert_eq!(footer_hint_lines(&state, width)[2..], hints);
+        assert!(picker_footer_progress_label(&state, 6, header_width).contains("% · apply 1/3"));
+        assert!(
+            state
+                .inline_error
+                .as_ref()
+                .unwrap()
+                .contains("settings rejected")
+        );
+        for row in state.filtered_rows.clone().into_iter().skip(1) {
+            state.finish_profile(row.thread_id.unwrap(), Ok(()));
+        }
+        assert_eq!(footer_hint_lines(&state, width)[2..], hints);
+        assert!(picker_footer_progress_label(&state, 6, header_width).contains("% · apply 3/3"));
+        assert!(
+            state
+                .inline_error
+                .as_ref()
+                .unwrap()
+                .contains("settings rejected")
+        );
+        for line in footer_hint_lines(&state, width) {
+            let line = line.to_string();
+            assert!(!line.contains("saving"));
+            assert!(!line.contains("applying"));
+            assert!(!line.contains("failed"));
+        }
+        state.action = SessionPickerAction::Fork;
+        assert!(!picker_footer_progress_label(&state, 6, width).contains("apply"));
+        assert_eq!(footer_hint_lines(&state, width).len(), 2);
+    }
+}
