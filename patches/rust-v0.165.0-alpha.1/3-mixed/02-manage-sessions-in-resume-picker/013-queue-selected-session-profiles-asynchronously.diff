+#[tokio::test]
+async fn queued_sessions_stay_in_place_until_their_profile_completion() -> Result<()> {
+    for status in [SessionStatus::Active, SessionStatus::Archived] {
+        let (mut state, requests) = test_picker();
+        state.status = status;
+        state.view_persistence = Some(SessionPickerViewPersistence {
+            codex_home: PathBuf::from("/tmp/profile-home"),
+        });
+        state.profile_names.insert(1, "inspect".into());
+        state.all_rows = (0..3).map(|_| test_row(ThreadId::new())).collect();
+        state.apply_filter();
+        let original_rows = state.filtered_rows.clone();
+        for index in 1..3 {
+            state.selected = index;
+            state
+                .handle_key(KeyEvent::new(KeyCode::Char('1'), KeyModifiers::ALT))
+                .await?;
+            assert_eq!(state.filtered_rows, original_rows);
+            assert_eq!(state.all_rows, original_rows);
+            assert_eq!(state.selected, index);
+            assert_eq!(state.profile_queue.pending.len(), index);
+        }
+        let first = original_rows[1].thread_id.unwrap();
+        let second = original_rows[2].thread_id.unwrap();
+        assert!(matches!(requests.lock().unwrap().pop(),
+            Some(PickerLoadRequest::ApplyProfile { thread_id, archived, .. })
+            if thread_id == first && archived == (status == SessionStatus::Archived)));
+        assert!(requests.lock().unwrap().is_empty());
+        let applied_status = if status == SessionStatus::Archived {
+            SessionStatus::Active
+        } else {
+            SessionStatus::Archived
+        };
+        state
+            .handle_background_event(BackgroundEvent::ProfileApplied {
+                thread_id: first,
+                status: applied_status,
+                thread: None,
+                result: Ok(()),
+            })
+            .await?;
+        assert_eq!(
+            state.filtered_rows,
+            vec![original_rows[0].clone(), original_rows[2].clone()]
+        );
+        assert_eq!(
+            state.profile_queue.pending.front().unwrap().thread_id,
+            second
+        );
+        assert!(matches!(requests.lock().unwrap().pop(),
+            Some(PickerLoadRequest::ApplyProfile { thread_id, archived, .. })
+            if thread_id == second && archived == (status == SessionStatus::Archived)));
+        state
+            .handle_background_event(BackgroundEvent::ProfileApplied {
+                thread_id: second,
+                status: applied_status,
+                thread: None,
+                result: Ok(()),
+            })
+            .await?;
+        assert_eq!(state.filtered_rows, vec![original_rows[0].clone()]);
+        assert!(!state.profile_queue.is_running());
+        assert!(requests.lock().unwrap().is_empty());
+    }
+    Ok(())
+}
