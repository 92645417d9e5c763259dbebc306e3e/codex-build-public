+#[tokio::test]
+async fn selected_profiles_allow_incomplete_lists_and_closing_discards_unstarted_targets()
+-> Result<()> {
+    for (status, incomplete) in [SessionStatus::Active, SessionStatus::Archived]
+        .into_iter()
+        .flat_map(|status| (0..4).map(move |incomplete| (status, incomplete)))
+    {
+        let (mut state, requests) = test_picker();
+        state.status = status;
+        state.view_persistence = Some(SessionPickerViewPersistence {
+            codex_home: PathBuf::from("/tmp/profile-home"),
+        });
+        state.profile_names.insert(1, "inspect".into());
+        state.all_rows = (0..3).map(|_| test_row(ThreadId::new())).collect();
+        state.apply_filter();
+        match incomplete {
+            0 => state
+                .pagination
+                .start_load(19, None, PageLoadMode::StoreDefault),
+            1 => state.pagination.next_cursor = Some(PageCursor::AppServer("more".into())),
+            2 => state.pagination.reached_scan_cap = true,
+            _ => {
+                state
+                    .pagination
+                    .start_load(19, None, PageLoadMode::StoreDefault);
+                state
+                    .handle_background_event(BackgroundEvent::Page {
+                        request_token: 19,
+                        search_token: None,
+                        page: Err(std::io::Error::other("page failed")),
+                    })
+                    .await?;
+                state
