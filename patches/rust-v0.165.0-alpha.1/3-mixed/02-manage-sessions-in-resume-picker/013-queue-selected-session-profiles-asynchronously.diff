+#[tokio::test]
+async fn profile_completion_during_reload_wins_over_late_pages_in_each_directory_scope()
+-> Result<()> {
+    for status in [SessionStatus::Active, SessionStatus::Archived] {
+        for mode in [
+            SessionFilterMode::All,
+            SessionFilterMode::Cwd,
+            SessionFilterMode::Other,
+        ] {
+            for new_cwd in ["/current", "/changed"] {
+                let (mut state, requests) = test_picker();
+                state.status = status;
+                state.filter_cwd = Some(PathBuf::from("/current"));
+                state.local_filter_cwd = state.filter_cwd.clone();
+                state.view_persistence = Some(SessionPickerViewPersistence {
+                    codex_home: PathBuf::from("/tmp/profile-home"),
+                });
+                state.profile_names.insert(1, "inspect".into());
+                let thread_id = ThreadId::new();
+                let old_cwd = if mode == SessionFilterMode::Cwd {
+                    "/current"
+                } else {
+                    "/elsewhere"
+                };
+                let old = Row {
+                    cwd: Some(PathBuf::from(old_cwd)),
+                    thread_name: Some("old title".into()),
+                    ..test_row(thread_id)
+                };
+                state.all_rows.push(old.clone());
+                state.apply_filter();
+                state.request_profile(1);
+                assert!(matches!(
+                    requests.lock().unwrap().pop(),
+                    Some(PickerLoadRequest::ApplyProfile { .. })
+                ));
+                state.filter_mode = mode;
+                state.start_initial_load();
+                let Some(PickerLoadRequest::Page(request)) = requests.lock().unwrap().pop() else {
+                    panic!("reload must request its first page")
+                };
+                assert!(state.all_rows.is_empty());
+                let thread = updated_thread(thread_id, new_cwd, 1, 10);
+                let updated = row_from_app_server_thread(thread.clone()).unwrap();
+                state
+                    .handle_background_event(BackgroundEvent::ProfileApplied {
+                        thread_id,
+                        status,
+                        thread: Some(Box::new(thread)),
+                        result: Ok(()),
+                    })
+                    .await?;
+                assert!(!state.profile_queue.is_running());
+                let matching = mode == SessionFilterMode::All
+                    || (new_cwd == "/current") == (mode == SessionFilterMode::Cwd);
+                assert_eq!(state.filtered_rows.len(), usize::from(matching));
+                let neighbor = Row {
+                    cwd: Some(PathBuf::from(if mode == SessionFilterMode::Cwd {
+                        "/current"
+                    } else {
+                        "/zzz"
+                    })),
+                    thread_name: Some("neighbor title".into()),
+                    ..test_row(ThreadId::new())
+                };
+                state
+                    .handle_background_event(BackgroundEvent::Page {
+                        request_token: request.request_token,
+                        search_token: request.search_token,
+                        page: Ok(PickerPage {
+                            rows: vec![old, neighbor.clone()],
+                            history_modes: HashMap::new(),
+                            next_cursor: None,
+                            num_scanned_files: 2,
+                            reached_scan_cap: false,
+                        }),
+                    })
+                    .await?;
+                assert_eq!(state.filtered_rows.len(), 1 + usize::from(matching));
+                assert_eq!(
+                    state
+                        .all_rows
+                        .iter()
+                        .find(|row| row.thread_id == Some(thread_id)),
+                    matching.then_some(&updated)
+                );
+                if matching {
+                    assert_eq!(state.filtered_rows[0], updated);
+                }
+                assert_eq!(state.filtered_rows.last(), Some(&neighbor));
+                state.set_query("saved profile".into());
+                assert_eq!(
+                    state.filtered_rows,
+                    if matching { vec![updated] } else { Vec::new() }
+                );
+                assert!(requests.lock().unwrap().is_empty());
+            }
+        }
+    }
+    Ok(())
+}
