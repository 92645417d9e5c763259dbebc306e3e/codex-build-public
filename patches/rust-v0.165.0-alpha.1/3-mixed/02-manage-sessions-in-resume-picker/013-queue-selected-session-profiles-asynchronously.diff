+#[tokio::test]
+async fn pending_profile_allows_page_loading_and_finishes_after_picker_close() -> Result<()> {
+    tokio::time::timeout(std::time::Duration::from_secs(20), async {
+        let home = tempfile::tempdir()?;
+        std::fs::write(home.path().join(PROFILE_FILE),
+            r#"{"1":{"name":"inspect","model":"gpt-6-luna","title":"saved title"}}"#)?;
+        let listener = tokio::net::TcpListener::bind("127.0.0.1:0").await?;
+        let address = listener.local_addr()?;
+        let (requests_tx, mut requests_rx) = mpsc::unbounded_channel();
+        let (release_tx, release_rx) = oneshot::channel();
+        let server = tokio::spawn(async move {
+            let (stream, _) = listener.accept().await.unwrap();
+            let mut socket = tokio_tungstenite::accept_async(stream).await.unwrap();
+            let mut pending = None;
+            let mut release = Some(release_rx);
+            while let Some(frame) = futures::StreamExt::next(&mut socket).await {
+                let frame = frame.unwrap();
+                if frame.is_close() { break; }
+                if !frame.is_text() { continue; }
+                let request: serde_json::Value = serde_json::from_str(frame.to_text().unwrap()).unwrap();
+                let method = request["method"].as_str().unwrap();
+                let result = match method {
+                    "initialize" => json!({"userAgent":"profile-test","codexHome":"/server/.codex"}),
+                    "initialized" => continue,
+                    "thread/settings/update" => {
+                        requests_tx.send(request.clone()).unwrap();
+                        pending = Some(request["id"].clone());
+                        continue;
+                    }
+                    "thread/list" => json!({"data":[],"nextCursor":null}),
+                    "thread/name/set" => json!({}),
+                    "thread/read" => {
+                        requests_tx.send(request.clone()).unwrap();
+                        socket.send(Message::Text(json!({"id":request["id"],"error":{"code":-32603,"message":"refresh unavailable"}}).to_string().into())).await.unwrap();
+                        continue;
+                    }
+                    _ => panic!("unexpected profile request: {method}"),
+                };
+                socket.send(Message::Text(json!({"id":request["id"],"result":result}).to_string().into())).await.unwrap();
+                if method != "initialize" { requests_tx.send(request.clone()).unwrap(); }
+                if method == "thread/list" {
+                    release.take().unwrap().await.unwrap();
+                    socket.send(Message::Text(json!({"id":pending.take().unwrap(),"result":{}}).to_string().into())).await.unwrap();
+                }
+            }
+        });
+        let client = RemoteAppServerClient::connect(RemoteAppServerConnectArgs {
+            endpoint: RemoteAppServerEndpoint::WebSocket { websocket_url: format!("ws://{address}"), auth_token: None },
+            client_name: "profile-test".into(), client_version: "test".into(),
+            experimental_api: true, mcp_server_openai_form_elicitation: false,
+            opt_out_notification_methods: Vec::new(), channel_capacity: 8,
+        }).await?;
+        let session = AppServerSession::new(
+            crate::backend_id::BackendId::new(), AppServerClient::Remote(client),
+            crate::app_server_session::ThreadParamsMode::Remote,
+        );
+        let (bg_tx, mut bg_rx) = mpsc::unbounded_channel();
+        let handle = session.request_handle();
+        let (loader, worker) = spawn_app_server_page_loader(true, session, handle,
+            false, RawReasoningVisibility::Hidden, None, bg_tx);
+        let thread_id = ThreadId::new();
+        loader(PickerLoadRequest::ApplyProfile {
+            thread_id, codex_home: home.path().to_path_buf(), slot: 1,
+            archived: false, is_current: false,
+        });
+        assert_eq!(requests_rx.recv().await.unwrap()["method"], "thread/settings/update");
+        loader(PickerLoadRequest::Page(PageLoadRequest {
+            cursor: None, request_token: 12, search_token: None,
+            mode: PageLoadMode::StoreDefault, cwd_filter: None, filter_mode: SessionFilterMode::All,
+            status: SessionStatus::Active, provider_filter: ProviderFilter::Any,
+            sort_key: ThreadSortKey::CreatedAt,
+        }));
+        assert_eq!(requests_rx.recv().await.unwrap()["method"], "thread/list");
+        assert!(matches!(bg_rx.recv().await, Some(BackgroundEvent::Page {
+            request_token: 12, page: Ok(_), ..
+        })));
+        assert!(bg_rx.try_recv().is_err());
+        drop(loader);
+        drop(bg_rx);
+        assert!(!worker.is_finished());
+        release_tx.send(()).unwrap();
+        let rename = requests_rx.recv().await.unwrap();
+        assert_eq!(rename["method"], "thread/name/set");
+        assert_eq!(rename["params"]["threadId"], thread_id.to_string());
+        assert_eq!(rename["params"]["name"], "saved title");
+        let refresh = requests_rx.recv().await.unwrap();
+        assert_eq!(refresh["method"], "thread/read");
+        let params: ThreadReadParams = serde_json::from_value(refresh["params"].clone())?;
+        assert!(!params.include_turns);
+        assert_eq!(params.thread_id, thread_id.to_string());
+        worker.await?;
+        server.await?;
+        assert!(requests_rx.try_recv().is_err());
+        Ok::<_, color_eyre::Report>(())
+    }).await?
+}
