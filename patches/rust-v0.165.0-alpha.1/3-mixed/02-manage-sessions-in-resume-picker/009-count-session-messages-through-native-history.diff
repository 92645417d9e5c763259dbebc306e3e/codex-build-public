+    pub(crate) async fn thread_message_count_read(
+        &self,
+        params: ThreadMessageCountReadParams,
+    ) -> Result<Option<ClientResponsePayload>, JSONRPCErrorError> {
+        let thread_id = ThreadId::from_string(&params.thread_id)
+            .map_err(|err| invalid_request(format!("invalid thread id: {err}")))?;
+        let history_mode = self
+            .read_stored_thread_for_read(thread_id, /*include_history*/ false)
+            .await
+            .map_err(thread_read_view_error)?
+            .ok_or_else(|| invalid_request(format!("no rollout found for thread id {thread_id}")))?
+            .history_mode;
+        let message_count = match history_mode {
+            ThreadHistoryMode::Legacy => {
+                let items = self
+                    .load_thread_turns_list_history(thread_id)
+                    .await
+                    .map_err(thread_read_view_error)?;
+                // Native rollout reading already offloads decoding. Reconstructing the legacy
+                // message view must also leave the async executor available to other requests.
+                tokio::task::spawn_blocking(move || {
+                    build_legacy_api_turns_from_rollout_items(&items)
+                        .into_iter()
+                        .flat_map(|turn| turn.items)
+                        .filter(|item| {
+                            matches!(
+                                item,
+                                ThreadItem::UserMessage { .. } | ThreadItem::AgentMessage { .. }
+                            )
+                        })
+                        .count() as u64
+                })
+                .await
+                .map_err(|err| internal_error(format!("failed to count thread messages: {err}")))?
+            }
+            ThreadHistoryMode::Paginated => {
+                let mut cursor = None;
+                let mut count = 0;
+                loop {
+                    let page = self
+                        .thread_store
+                        .list_items(StoreListItemsParams {
+                            item_ids: None,
+                            thread_id,
+                            turn_id: None,
+                            include_archived: true,
+                            position: cursor.map(StoreListItemsPosition::Cursor),
+                            page_size: THREAD_ITEMS_MAX_LIMIT,
+                            sort_direction: StoreSortDirection::Asc,
+                            sort_key: StoreItemSortKey::CreatedAtOrdinal,
+                            after_updated_at_ordinal: None,
+                        })
+                        .await
+                        .map_err(paginated_history_list_error)?;
+                    let next_cursor = page.next_cursor;
+                    count += tokio::task::spawn_blocking(move || {
+                        page.items.into_iter().try_fold(0_u64, |count, item| {
+                            let item = deserialize_stored_thread_item(item)?;
+                            Ok::<_, JSONRPCErrorError>(
+                                count
+                                    + u64::from(matches!(
+                                        item,
+                                        ThreadItem::UserMessage { .. }
+                                            | ThreadItem::AgentMessage { .. }
+                                    )),
+                            )
+                        })
+                    })
+                    .await
+                    .map_err(|err| {
+                        internal_error(format!("failed to count thread messages: {err}"))
+                    })??;
+                    let Some(next_cursor) = next_cursor else {
+                        break count;
+                    };
+                    cursor = Some(next_cursor);
+                }
+            }
+        };
+        Ok(Some(
+            ThreadMessageCountReadResponse { message_count }.into(),
+        ))
+    }
