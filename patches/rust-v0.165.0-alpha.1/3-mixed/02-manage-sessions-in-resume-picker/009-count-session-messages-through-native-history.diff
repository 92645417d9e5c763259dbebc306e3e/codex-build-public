+#[tokio::test]
+async fn message_count_read_pages_visible_history_and_respects_fork_revert_boundaries() -> Result<()>
+{
+    let server = create_mock_responses_server_repeating_assistant("Done").await;
+    let codex_home = TempDir::new()?;
+    MockResponsesConfig::new(&server.uri()).write(codex_home.path())?;
+    let (store, thread_id) = message_count_store(
+        codex_home.path(),
+        codex_protocol::protocol::ThreadHistoryMode::Paginated,
+    )
+    .await?;
+    let mut items = vec![paginated_turn_started("first-turn")];
+    for (turn_id, user_id) in [("first-turn", "first-user"), ("second-turn", "second-user")] {
+        if turn_id == "second-turn" {
+            items.push(paginated_turn_completed("first-turn"));
+            items.push(paginated_turn_started("second-turn"));
+        }
+        items.push(paginated_completed_item(
+            thread_id,
+            turn_id,
+            CoreTurnItem::UserMessage(UserMessageItem {
+                id: user_id.into(),
+                client_id: None,
+                content: vec![codex_protocol::user_input::UserInput::Text {
+                    text: format!("question for {turn_id}"),
+                    text_elements: Vec::new(),
+                }],
+            }),
+        ));
+        for (index, phase) in [
+            Some(MessagePhase::Commentary),
+            Some(MessagePhase::PartialAnswer),
+            Some(MessagePhase::FinalAnswer),
+            None,
+        ]
+        .into_iter()
+        .enumerate()
+        {
+            items.push(paginated_completed_item(
+                thread_id,
+                turn_id,
+                CoreTurnItem::AgentMessage(AgentMessageItem {
+                    id: format!("{turn_id}-agent-{index}"),
+                    content: vec![AgentMessageContent::Text {
+                        text: "answer".into(),
+                    }],
+                    phase,
+                    memory_citation: None,
+                    delivery: None,
+                    questions: None,
+                }),
+            ));
+        }
+        // Both turns exceed a native item page, independently of the summary items.
+        for index in 0..128 {
+            items.push(paginated_completed_item(
+                thread_id,
+                turn_id,
+                CoreTurnItem::AgentMessage(AgentMessageItem {
+                    id: format!("{turn_id}-commentary-{index}"),
+                    content: vec![AgentMessageContent::Text {
+                        text: "progress".into(),
+                    }],
+                    phase: Some(MessagePhase::Commentary),
+                    memory_citation: None,
+                    delivery: None,
+                    questions: None,
+                }),
+            ));
+        }
+        items.push(paginated_completed_item(
+            thread_id,
+            turn_id,
+            CoreTurnItem::Reasoning(ReasoningItem {
+                id: format!("{turn_id}-reasoning"),
+                summary_text: vec!["not a dialogue message".into()],
+                raw_content: Vec::new(),
+            }),
+        ));
+        items.push(paginated_completed_item(
+            thread_id,
+            turn_id,
+            CoreTurnItem::FunctionCallOutput(FunctionCallOutputItem {
+                id: format!("{turn_id}-tool-output"),
+                name: "shell".into(),
+                namespace: None,
+                output: FunctionCallOutputBody::Text("not a dialogue message".into()),
+            }),
+        ));
+        // A later snapshot of an existing message is still one message.
+        items.push(paginated_completed_item(
+            thread_id,
+            turn_id,
+            CoreTurnItem::AgentMessage(AgentMessageItem {
+                id: format!("{turn_id}-agent-0"),
+                content: vec![AgentMessageContent::Text {
+                    text: "updated commentary".into(),
+                }],
+                phase: Some(MessagePhase::Commentary),
+                memory_citation: None,
+                delivery: None,
+                questions: None,
+            }),
+        ));
+    }
+    items.push(paginated_turn_completed("second-turn"));
+    store
+        .append_items(AppendThreadItemsParams { thread_id, items })
+        .await?;
+    store.shutdown_thread(thread_id).await?;
+    let mut mcp = TestAppServer::builder()
+        .with_codex_home(codex_home.path())
+        .without_auto_env()
+        .build_initialized()
+        .await?;
+    let count: ThreadMessageCountReadResponse = mcp
+        .request(|request_id| ClientRequest::ThreadMessageCountRead {
+            request_id,
+            params: ThreadMessageCountReadParams {
+                thread_id: thread_id.to_string(),
+            },
+        })
+        .await?;
+    assert_eq!(count.message_count, 266);
+    let fork: ThreadForkResponse = mcp
+        .request(|request_id| ClientRequest::ThreadFork {
+            request_id,
+            params: ThreadForkParams {
+                thread_id: thread_id.to_string(),
+                exclude_turns: true,
+                ..Default::default()
+            },
+        })
+        .await?;
+    let fork_id = fork.thread.id;
+    let count: ThreadMessageCountReadResponse = mcp
+        .request(|request_id| ClientRequest::ThreadMessageCountRead {
+            request_id,
+            params: ThreadMessageCountReadParams {
+                thread_id: fork_id.clone(),
+            },
+        })
+        .await?;
+    assert_eq!(count.message_count, 266);
+    let _: ThreadRevertResponse = mcp
+        .request(|request_id| ClientRequest::ThreadRevert {
+            request_id,
+            params: ThreadRevertParams {
+                thread_id: fork_id.clone(),
+                before_turn_id: "second-turn".into(),
+            },
+        })
+        .await?;
+    for (id, expected) in [(fork_id, 133), (thread_id.to_string(), 266)] {
+        let count: ThreadMessageCountReadResponse = mcp
+            .request(|request_id| ClientRequest::ThreadMessageCountRead {
+                request_id,
+                params: ThreadMessageCountReadParams { thread_id: id },
+            })
+            .await?;
+        assert_eq!(count.message_count, expected);
+    }
+    Ok(())
+}
