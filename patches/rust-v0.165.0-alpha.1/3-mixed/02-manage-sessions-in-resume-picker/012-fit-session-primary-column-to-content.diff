+fn dense_primary_width(state: &PickerState, width: u16) -> usize {
+    let available = usize::from(width).saturating_sub(2);
+    let mut primary = SESSION_META_DATE_WIDTH;
+    let mut title = 0;
+    for row in state
+        .filtered_rows
+        .iter()
+        .skip(state.scroll_top)
+        .take(state.view_rows.unwrap_or(state.filtered_rows.len()))
+    {
+        primary = primary.max(crate::width::display_width(&row_primary_value(row, state)) + 1);
+        title = title.max(crate::width::display_width(row.display_preview()) + 1);
+    }
+    primary.min(available.saturating_sub(title.min(available / 2)))
