+/// Immutable trust bypasses selected when the app server starts.
+#[derive(Debug, Default, Serialize, Deserialize, Clone, Copy, PartialEq, Eq, JsonSchema, TS)]
+#[serde(rename_all = "camelCase")]
+pub struct TrustPolicy {
+    pub bypass_project_trust: bool,
+    pub bypass_hook_trust: bool,
+}
+
+impl TrustPolicy {
+    /// Omitted client values inherit the server policy; explicit values only assert it.
+    pub fn check_request(self, project: Option<bool>, hooks: Option<bool>) -> Result<(), String> {
+        for (flag, requested, running) in [
+            ("project", project, self.bypass_project_trust),
+            ("hook", hooks, self.bypass_hook_trust),
+        ] {
+            if let Some(requested) = requested
+                && requested != running
+            {
+                return Err(format!(
+                    "--dangerously-bypass-{flag}-trust={requested} conflicts with the app server startup value {running}. Stop the server and start it with the desired policy; the running server was not changed."
+                ));
+            }
+        }
+        Ok(())
+    }
+}
