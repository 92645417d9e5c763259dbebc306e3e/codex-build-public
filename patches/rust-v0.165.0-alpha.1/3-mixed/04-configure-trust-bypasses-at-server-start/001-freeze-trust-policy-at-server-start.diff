+#[tokio::test]
+async fn startup_trust_policy_survives_all_config_reload_paths() -> Result<()> {
+    let home = tempdir()?;
+    let policy = codex_protocol::config_types::TrustPolicy {
+        bypass_project_trust: true,
+        bypass_hook_trust: true,
+    };
+    let manager = ConfigManager::without_managed_config_for_tests(home.path().to_path_buf())
+        .with_trust_policy(policy);
+    let config = manager.load_latest_config(None).await?;
+    for reloaded in [
+        config.clone(),
+        manager
+            .load_for_cwd(
+                None,
+                ConfigOverrides::default(),
+                Some(home.path().to_path_buf()),
+            )
+            .await?,
+        manager.load_default_config().await?,
+        manager
+            .load_latest_config_with_session_layers(&config.config_layer_stack, &config.cwd)
+            .await?,
+        manager
+            .load_retained_session_config(&config.config_layer_stack, &config.cwd)
+            .await?,
+    ] {
+        assert!(reloaded.bypass_project_trust);
+        assert!(reloaded.bypass_hook_trust);
+    }
+    for key in ["bypass_project_trust", "bypass_hook_trust"] {
+        let error = manager
+            .load_with_overrides(
+                Some(HashMap::from([(key.to_string(), serde_json::json!(false))])),
+                ConfigOverrides::default(),
+            )
+            .await
+            .unwrap_err();
+        assert_eq!(error.kind(), std::io::ErrorKind::InvalidInput);
+    }
+    let inherited = manager.load_latest_config(None).await?;
+    assert!(inherited.bypass_project_trust && inherited.bypass_hook_trust);
+    Ok(())
+}
