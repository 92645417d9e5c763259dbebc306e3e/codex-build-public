+#[tokio::test]
+async fn project_trust_bypass_preserves_recorded_trust_and_permissions() -> std::io::Result<()> {
+    let home = TempDir::new()?;
+    let project = home.path().join("project");
+    std::fs::create_dir_all(project.join(".codex"))?;
+    std::fs::write(project.join(".codex/config.toml"), "model='project-model'")?;
+    let key = toml::Value::String(project.to_string_lossy().into_owned());
+    let user = format!("[projects.{key}]\ntrust_level='untrusted'\n");
+    std::fs::write(home.path().join("config.toml"), &user)?;
+    let load = |bypass| {
+        ConfigBuilder::without_managed_config_for_tests()
+            .codex_home(home.path().to_path_buf())
+            .harness_overrides(ConfigOverrides {
+                cwd: Some(project.clone()),
+                bypass_project_trust: Some(bypass),
+                ..Default::default()
+            })
+            .build()
+    };
+    let restricted = load(false).await?;
+    let bypassed = load(true).await?;
+    assert_eq!(bypassed.model.as_deref(), Some("project-model"));
+    assert!(bypassed.active_project.is_untrusted());
+    assert!(!bypassed.bypass_hook_trust);
+    assert_eq!(
+        bypassed.permissions.effective_permission_profile(),
+        restricted.permissions.effective_permission_profile()
+    );
+    assert_eq!(
+        bypassed.permissions.approval_policy.value(),
+        restricted.permissions.approval_policy.value()
+    );
+    assert_eq!(
+        std::fs::read_to_string(home.path().join("config.toml"))?,
+        user
+    );
+    Ok(())
+}
