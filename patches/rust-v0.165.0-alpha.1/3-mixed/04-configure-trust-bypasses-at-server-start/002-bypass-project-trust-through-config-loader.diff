+#[tokio::test]
+async fn project_trust_bypass_loads_local_layers_without_persisting_trust() {
+    let tmp = tempdir().expect("tempdir");
+    let home = tmp.path().join("home");
+    let project = tmp.path().join("project");
+    std::fs::create_dir_all(&home).expect("home");
+    std::fs::create_dir_all(project.join(".codex")).expect("project config");
+    std::fs::write(project.join(".project-root"), "").expect("marker");
+    let project_key = TomlValue::String(project_trust_key(&project)).to_string();
+    let user = format!(
+        "project_root_markers=['.project-root']\n[projects.{project_key}]\ntrust_level='untrusted'\n"
+    );
+    let user_path = home.join(CONFIG_TOML_FILE);
+    std::fs::write(&user_path, &user).expect("user config");
+    std::fs::write(project.join(".codex/config.toml"), "model='project-model'")
+        .expect("project config");
+    let cwd = AbsolutePathBuf::from_absolute_path(&project).expect("absolute cwd");
+    for bypass in [false, true] {
+        let mut overrides = LoaderOverrides::without_managed_config_for_tests();
+        overrides.bypass_project_trust = bypass;
+        let local = local::load_local_config_layers_with_overrides(
+            &TestFileSystem,
+            &home,
+            &cwd,
+            &overrides,
+        )
+        .await
+        .expect("local layers");
+        assert_eq!(
+            local
+                .config
+                .layers
+                .iter()
+                .any(|layer| matches!(layer.source, ConfigLayerSource::Project { .. })),
+            bypass
+        );
+        let stack = load_config_layers_state(
+            &TestFileSystem,
+            &home,
+            Some(cwd.clone()),
+            &[],
+            overrides,
+            &crate::NoopThreadConfigLoader,
+        )
+        .await
+        .expect("effective layers");
+        assert_eq!(
+            stack
+                .effective_config()
+                .get("model")
+                .and_then(TomlValue::as_str),
+            bypass.then_some("project-model")
+        );
+        assert_eq!(
+            std::fs::read_to_string(&user_path).expect("unchanged trust"),
+            user
+        );
+    }
+}
