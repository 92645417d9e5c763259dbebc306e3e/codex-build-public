 use super::SharedCliOptions;
 
+#[test]
+fn explicit_trust_choices_override_inheritance_in_both_directions() {
+    let root = SharedCliOptions {
+        bypass_project_trust: Some(true),
+        bypass_hook_trust: Some(false),
+        ..Default::default()
+    };
+    let mut inherited = SharedCliOptions::default();
+    inherited.inherit_exec_root_options(&root);
+    assert_eq!(inherited.bypass_project_trust, Some(true));
+    assert_eq!(inherited.bypass_hook_trust, Some(false));
+    let explicit = SharedCliOptions {
+        bypass_project_trust: Some(false),
+        bypass_hook_trust: Some(true),
+        ..Default::default()
+    };
+    let mut child = explicit.clone();
+    child.inherit_exec_root_options(&root);
+    assert_eq!(child.bypass_project_trust, Some(false));
+    assert_eq!(child.bypass_hook_trust, Some(true));
+    inherited.apply_subcommand_overrides(explicit);
+    inherited.apply_subcommand_overrides(SharedCliOptions::default());
+    assert_eq!(inherited.bypass_project_trust, Some(false));
+    assert_eq!(inherited.bypass_hook_trust, Some(true));
+}
