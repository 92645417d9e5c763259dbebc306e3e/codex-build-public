+#[tokio::test]
+async fn trust_mismatch_never_enters_daemon_recovery_or_fallback() -> anyhow::Result<()> {
+    use futures::SinkExt;
+    use futures::StreamExt;
+    use tokio_tungstenite::tungstenite::Message;
+    let home = TempDir::new()?;
+    let config = ConfigBuilder::default()
+        .codex_home(home.path().to_path_buf())
+        .loader_overrides(LoaderOverrides::without_managed_config_for_tests())
+        .build()
+        .await?;
+    for allow_embedded_fallback in [false, true] {
+        for (project, hooks, matches) in [
+            (None, None, true),
+            (Some(true), Some(false), true),
+            (Some(false), None, false),
+            (None, Some(true), false),
+        ] {
+            let listener = tokio::net::TcpListener::bind("127.0.0.1:0").await?;
+            let target = AppServerTarget::LocalDaemon {
+                endpoint: RemoteAppServerEndpoint::WebSocket {
+                    websocket_url: format!("ws://{}", listener.local_addr()?),
+                    auth_token: None,
+                },
+                allow_embedded_fallback,
+            };
+            let server = tokio::spawn(async move {
+                let (stream, _) = listener.accept().await.unwrap();
+                let mut socket = tokio_tungstenite::accept_async(stream).await.unwrap();
+                while let Some(Ok(Message::Text(text))) = socket.next().await {
+                    let message: codex_app_server_protocol::JSONRPCMessage =
+                        serde_json::from_str(&text).unwrap();
+                    if let codex_app_server_protocol::JSONRPCMessage::Request(request) = message {
+                        assert_eq!(request.method, "initialize");
+                        let response = serde_json::json!({"id": request.id, "result": {
+                            "trustPolicy": {"bypassProjectTrust": true, "bypassHookTrust": false}
+                        }});
+                        socket
+                            .send(Message::Text(response.to_string().into()))
+                            .await
+                            .unwrap();
+                    }
+                }
+            });
+            let result =
+                daemon_startup::compatibility_warning(&target, &config, &[], project, hooks).await;
+            if matches {
+                assert_eq!(result?, None);
+            } else {
+                assert!(matches!(
+                    result,
+                    Err(daemon_startup::StartupError::TrustPolicy(_))
+                ));
+            }
+            server.await?;
+        }
+    }
+    Ok(())
+}
