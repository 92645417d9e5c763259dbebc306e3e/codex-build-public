+#[tokio::test]
+async fn note_failures_remain_visible_as_bullets_and_warning_entries() {
+    let message = "Context management: unable to read a note.";
+    for (startup_complete, fullscreen_transcript) in
+        [(false, false), (false, true), (true, false), (true, true)]
+    {
+        let (mut chat, mut rx, _op_rx) = make_chatwidget_manual(/*model_override*/ None).await;
+        chat.warning_display_state.startup_complete = startup_complete;
+        chat.local_settings.tui.fullscreen_transcript = fullscreen_transcript;
+        chat.handle_server_notification(
+            ServerNotification::Warning(WarningNotification {
+                thread_id: Some("thread-1".to_string()),
+                message: message.to_string(),
+            }),
+            /*replay_kind*/ None,
+        );
+        let cells: Vec<Arc<dyn HistoryCell>> = std::iter::from_fn(|| rx.try_recv().ok())
+            .filter_map(|event| match event {
+                AppEvent::InsertHistoryCell(cell) => Some(Arc::from(cell)),
+                _ => None,
+            })
+            .collect();
+        assert_eq!(cells.len(), 1);
+        let rich = cells[0].display_lines(/*width*/ 80);
+        assert_eq!(lines_to_single_string(&rich), format!("• {message}\n"));
+        assert_eq!(
+            rich[0].spans[0].style,
+            crate::style::status_style(crate::style::StatusTone::Attention)
+        );
+        assert_eq!(rich, cells[0].transcript_lines(/*width*/ 80));
+        assert_eq!(
+            crate::terminal_hyperlinks::visible_lines(
+                cells[0].compact_hyperlink_lines(/*width*/ 80)
+            ),
+            rich
+        );
+        assert_eq!(
+            lines_to_single_string(
+                &cells[0].display_lines_for_mode(
+                    /*width*/ 80,
+                    history_cell::HistoryRenderMode::Raw,
+                )
+            ),
+            format!("{message}\n")
+        );
+        assert_eq!(history_cell::warning_count(&cells), 1);
+        assert_eq!(history_cell::warning_entries(&cells)[0].details, message);
+        chat.open_warnings(&cells);
+        assert!(super::helpers::render_bottom_popup(&chat, /*width*/ 80).contains(message));
+    }
+}
