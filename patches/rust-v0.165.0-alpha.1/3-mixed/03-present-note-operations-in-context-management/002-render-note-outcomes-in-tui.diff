+#[tokio::test]
+async fn successful_note_operations_show_each_routine_bullet_without_warning_entries() {
+    let message = "Context management: read a note.";
+    for (startup_complete, fullscreen_transcript) in
+        [(false, false), (false, true), (true, false), (true, true)]
+    {
+        let (mut chat, mut rx, _op_rx) = make_chatwidget_manual(/*model_override*/ None).await;
+        chat.warning_display_state.startup_complete = startup_complete;
+        chat.local_settings.tui.fullscreen_transcript = fullscreen_transcript;
+        for _ in 0..2 {
+            chat.handle_server_notification(
+                ServerNotification::ContextManagementNotice(ContextManagementNoticeNotification {
+                    thread_id: "thread-1".to_string(),
+                    message: message.to_string(),
+                }),
+                /*replay_kind*/ None,
+            );
+        }
+        let cells: Vec<Arc<dyn HistoryCell>> = std::iter::from_fn(|| rx.try_recv().ok())
+            .filter_map(|event| match event {
+                AppEvent::InsertHistoryCell(cell) => Some(Arc::from(cell)),
+                _ => None,
+            })
+            .collect();
+        assert_eq!(cells.len(), 2);
+        for cell in &cells {
+            let rich = cell.display_lines(/*width*/ 80);
+            assert_eq!(lines_to_single_string(&rich), format!("• {message}\n"));
+            assert_eq!(
+                rich[0].spans[0].style,
+                ratatui::style::Style::default().dim()
+            );
+            assert_eq!(rich, cell.transcript_lines(/*width*/ 80));
+            assert_eq!(
+                crate::terminal_hyperlinks::visible_lines(
+                    cell.compact_hyperlink_lines(/*width*/ 80)
+                ),
+                rich,
+            );
+            assert_eq!(
+                lines_to_single_string(&cell.display_lines_for_mode(
+                    /*width*/ 80,
+                    history_cell::HistoryRenderMode::Raw,
+                )),
+                format!("• {message}\n"),
+            );
+        }
+        assert_eq!(history_cell::warning_count(&cells), 0);
+        assert!(history_cell::warning_entries(&cells).is_empty());
+    }
+}
