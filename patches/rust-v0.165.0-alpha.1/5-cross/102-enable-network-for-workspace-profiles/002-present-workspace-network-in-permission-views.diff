+#[tokio::test]
+async fn workspace_network_permission_matches_live_status_and_preview() {
+    let (mut chat, _rx, _op_rx) = make_chatwidget_manual(/*model_override*/ None).await;
+    chat.config.workspace_roots = vec![chat.config.cwd.clone()];
+    chat.config
+        .permissions
+        .set_workspace_roots(chat.config.workspace_roots.clone());
+    chat.set_permission_profile_from_session_snapshot(PermissionProfileSnapshot::active(
+        PermissionProfile::workspace_write(),
+        codex_protocol::models::ActivePermissionProfile::new(":workspace"),
+    ))
+    .unwrap();
+    chat.local_settings.tui.status_line = Some(vec!["permissions".to_string()]);
+    chat.refresh_status_line();
+
+    assert_eq!(
+        chat.bottom_pane.status_line_text().as_deref(),
+        Some("Workspace with network access")
+    );
+    assert_eq!(
+        status_preview_line(&mut chat, &[StatusLineItem::Permissions]),
+        "Workspace with network access"
+    );
+}
