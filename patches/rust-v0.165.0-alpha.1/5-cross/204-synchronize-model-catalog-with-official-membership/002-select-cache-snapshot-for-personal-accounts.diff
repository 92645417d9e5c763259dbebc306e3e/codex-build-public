+            Some(plan)
+        ));
+        assert!(!personal_chatgpt_account(
+            Some(AuthMode::ApiKey),
+            Some(plan)
+        ));
+    }
+    for plan in [
+        PlanType::Free,
+        PlanType::SelfServeBusinessProLite,
+        PlanType::Enterprise,
+    ] {
+        assert!(!personal_chatgpt_account(
+            Some(AuthMode::Chatgpt),
+            Some(plan)
+        ));
+    }
+    assert!(!personal_chatgpt_account(Some(AuthMode::Chatgpt), None));
+}
