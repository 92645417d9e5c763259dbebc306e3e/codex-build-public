+#[tokio::test]
+async fn cached_snapshot_accepts_stale_same_identity_and_rejects_other_identity() {
+    let codex_home = tempdir().expect("temp dir");
+    let seed = openai_manager_for_tests(
+        codex_home.path().to_path_buf(),
+        TestModelsEndpoint::new(vec![vec![remote_model("cached", "Cached", 0)]]),
+    );
+    seed.refresh_available_models(RefreshStrategy::Online, &DEFAULT_HTTP_CLIENT_FACTORY)
+        .await
+        .expect("seed online cache");
+    mutate_file_cache_for_test(codex_home.path(), |entry| {
+        entry.fetched_at = Utc::now() - chrono::Duration::hours(1);
+        entry.client_version = Some("old-version".to_string());
+    })
+    .await;
+
+    let endpoint = TestModelsEndpoint::new(vec![vec![remote_model("online", "Online", 0)]]);
+    let manager = openai_manager_for_tests(codex_home.path().to_path_buf(), endpoint.clone());
+    assert!(manager.try_load_cache(/*read_snapshot*/ true).await);
+    assert_eq!(endpoint.fetch_count(), 0);
+    assert!(
+        manager
+            .get_remote_models()
+            .await
+            .iter()
+            .any(|model| model.slug == "cached")
+    );
+
+    mutate_file_cache_for_test(codex_home.path(), |entry| {
+        entry.identity = Some("another-account".to_string());
+    })
+    .await;
+    let other = openai_manager_for_tests(codex_home.path().to_path_buf(), endpoint);
+    assert!(!other.try_load_cache(/*read_snapshot*/ true).await);
+}
+
+#[tokio::test]
+async fn cached_snapshot_preserves_upstream_invalidation() {
+    let codex_home = tempdir().expect("temp dir");
+    let endpoint = TestModelsEndpoint::new(vec![vec![remote_model("cached", "Cached", 0)]]);
+    let seed = openai_manager_for_tests(codex_home.path().to_path_buf(), endpoint.clone());
+    seed.refresh_available_models(RefreshStrategy::Online, &DEFAULT_HTTP_CLIENT_FACTORY)
+        .await
+        .expect("seed online cache");
+
+    let manager = openai_manager_for_tests(codex_home.path().to_path_buf(), endpoint.clone());
+    {
+        let mut current = manager.remote_models.write().await;
+        current.base.fetched_at = chrono::DateTime::<Utc>::MIN_UTC;
+        current.base.models.clear();
+        current.active_models.clear();
+    }
+    let before = manager.get_remote_models().await;
+    assert!(!manager.try_load_cache(/*read_snapshot*/ true).await);
+    assert_eq!(manager.get_remote_models().await, before);
+
+    mutate_file_cache_for_test(codex_home.path(), |entry| {
+        entry.fetched_at = chrono::DateTime::<Utc>::MIN_UTC;
+    })
+    .await;
+    let restarted = openai_manager_for_tests(codex_home.path().to_path_buf(), endpoint.clone());
+    let before = restarted.get_remote_models().await;
+    assert!(!restarted.try_load_cache(/*read_snapshot*/ true).await);
+    assert_eq!(restarted.get_remote_models().await, before);
+    assert_eq!(endpoint.fetch_count(), 1);
+}
