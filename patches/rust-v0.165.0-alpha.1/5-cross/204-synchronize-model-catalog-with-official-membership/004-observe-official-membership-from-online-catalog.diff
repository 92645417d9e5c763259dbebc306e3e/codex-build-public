+#[tokio::test]
+async fn online_observation_uses_only_successful_official_membership() {
+    let codex_home = tempdir().expect("temp dir");
+    write_models_document(
+        codex_home.path(),
+        json!({"models": [{"slug": "local-only", "display_name": "Local"}]}),
+    );
+    let manager = openai_manager_for_tests(
+        codex_home.path().to_path_buf(),
+        TestModelsEndpoint::new(vec![
+            vec![remote_model("official-a", "Official A", 0)],
+            vec![remote_model("official-b", "Official B", 0)],
+        ]),
+    );
+
+    let first = manager
+        .observe_official_online_models(DEFAULT_HTTP_CLIENT_FACTORY)
+        .await
+        .expect("first online response");
+    assert_eq!(first.identity, "test-provider");
+    assert_eq!(
+        first.slugs,
+        std::collections::BTreeSet::from(["official-a".to_string()])
+    );
+
+    let second = manager
+        .observe_official_online_models(DEFAULT_HTTP_CLIENT_FACTORY)
+        .await
+        .expect("second online response");
+    assert_eq!(
+        second.slugs,
+        std::collections::BTreeSet::from(["official-b".to_string()])
+    );
+}
+
+#[tokio::test]
+async fn online_observation_reuses_native_refresh_admission_and_failure_policy() {
+    let codex_home = tempdir().expect("temp dir");
+    let endpoint =
+        TestModelsEndpoint::without_refresh(vec![vec![remote_model("unused", "Unused", 0)]]);
+    let manager = openai_manager_for_tests(codex_home.path().to_path_buf(), endpoint.clone());
+    assert_eq!(
+        manager
+            .observe_official_online_models(DEFAULT_HTTP_CLIENT_FACTORY)
+            .await,
+        None
+    );
+    assert_eq!(endpoint.fetch_count(), 0);
+
+    for (error, invalidated) in [
+        (CodexErr::Stream("catalog fetch failed".into()), false),
+        (catalog_http_error(/*status*/ 401), true),
+    ] {
+        let models = vec![remote_model("old", "Old", 0)];
+        let endpoint = TestModelsEndpoint::with_command_auth(vec![Ok(models.clone()), Err(error)]);
+        let manager = openai_manager_for_tests(codex_home.path().to_path_buf(), endpoint.clone())
+            .with_provider_catalog();
+        assert!(
+            manager
+                .observe_official_online_models(DEFAULT_HTTP_CLIENT_FACTORY)
+                .await
+                .is_some()
+        );
+        assert_eq!(
+            manager
+                .observe_official_online_models(DEFAULT_HTTP_CLIENT_FACTORY)
+                .await,
+            None
+        );
+        assert_eq!(
+            manager.get_remote_models().await,
+            if invalidated { Vec::new() } else { models },
+        );
+        assert_eq!(
+            manager.try_load_cache(/*read_snapshot*/ true).await,
+            !invalidated
+        );
+        assert_eq!(endpoint.fetch_count(), 2);
+    }
+}
