+    #[test]
+    fn external_reconciliation_adds_current_and_removes_only_explicitly_stale_models() {
+        let codex_home = tempdir().expect("temp dir");
+        let catalog_path = path(codex_home.path());
+        let prices = json!({"external-stale": {"0": {
+            "input": 1.0, "cache_read": 0.0, "cache_write": 0.0, "output": 2.0
+        }}});
+        write_document(
+            &catalog_path,
+            json!({"models": [
+                {"slug": "official", "enabled": false},
+                complete_external_model("external-stale")
+            ], "prices": prices}),
+        );
+        let mut current = bundled_model("gpt-5.6-sol");
+        current.slug = "external-current".to_string();
+        current
+            .model_messages
+            .as_mut()
+            .expect("bundled model has messages")
+            .instructions_template = Some("must not persist".to_string());
+
+        assert!(
+            reconcile_external_models(
+                &catalog_path,
+                &BTreeSet::from(["external-stale".to_string()]),
+                &[current],
+            )
+            .expect("reconcile external models")
+        );
+
+        let document: Value =
+            serde_json::from_slice(&fs::read(&catalog_path).expect("read reconciled catalog"))
+                .expect("parse reconciled catalog");
+        let models = document["models"].as_array().expect("models array");
+        assert!(models.iter().any(|entry| entry["slug"] == "official"));
+        assert!(!models.iter().any(|entry| entry["slug"] == "external-stale"));
+        let current = models
+            .iter()
+            .find(|entry| entry["slug"] == "external-current")
+            .expect("current external model");
+        assert!(current.get("model_messages").is_none());
+        assert_eq!(document["prices"], prices);
+        assert!(
+            load_model(&catalog_path, "external-stale")
+                .unwrap()
+                .is_none()
+        );
+    }
