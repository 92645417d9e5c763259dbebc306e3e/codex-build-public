+    write_models_document(
+        codex_home.path(),
+        json!({"models": [serde_json::to_value(&external).expect("serialize model")]}),
+    );
+
+    let manager = openai_manager_for_tests(
+        codex_home.path().to_path_buf(),
+        TestModelsEndpoint::new(Vec::new()),
