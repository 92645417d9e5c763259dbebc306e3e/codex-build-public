+    fn external_reconciliation_replaces_refreshed_metadata_for_the_same_slug() -> std::io::Result<()>
+    {
+        let codex_home = tempdir().expect("temp dir");
+        let catalog_path = path(codex_home.path());
+        let prices = json!({"external-model": {"0": {
+            "input": 3.0, "cache_read": 1.0, "cache_write": 0.0, "output": 4.0
+        }}});
+        write_document(
+            &catalog_path,
+            json!({"models": [{
+                "slug": "external-model",
+                "display_name": "Old name",
+                "context_window": 100000
+            }], "prices": prices}),
+        );
+        let mut refreshed = local_model_defaults("external-model");
+        refreshed.display_name = "New name".to_string();
+        refreshed.context_window = Some(500_000);
+
+        assert!(
+            reconcile_external_models(
+                &catalog_path,
+                &BTreeSet::from(["external-model".to_string()]),
+                &[refreshed],
+            )
+            .expect("reconcile refreshed model")
+        );
+
+        let model =
+            load_model(&catalog_path, "external-model")?.expect("refreshed model should load");
+        assert_eq!(model.display_name, "New name");
+        assert_eq!(model.context_window, Some(500_000));
+        let document: Value = serde_json::from_slice(&fs::read(&catalog_path)?)?;
+        assert_eq!(document["prices"], prices);
+        Ok(())
+    }
