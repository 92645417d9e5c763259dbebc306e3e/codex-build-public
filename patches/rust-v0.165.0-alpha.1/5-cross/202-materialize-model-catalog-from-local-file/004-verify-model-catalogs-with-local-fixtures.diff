+    fn bundled_model(slug: &str) -> ModelInfo {
+        crate::bundled_models_response()
+            .expect("bundled catalog should parse")
+            .models
+            .into_iter()
+            .find(|model| model.slug == slug)
+            .expect("bundled model should exist")
+    }
+
+    fn fixture_model_with_slug(slug: &str) -> ModelInfo {
+        let mut model = bundled_model("gpt-5.6-sol");
+        model.slug = slug.to_string();
+        model
+    }
+
+    fn write_document(path: &Path, document: Value) {
+        fs::create_dir_all(path.parent().expect("catalog path should have a parent"))
+            .expect("create catalog directory");
+        fs::write(
+            path,
+            serde_json::to_vec_pretty(&document).expect("serialize catalog"),
+        )
+        .expect("write catalog");
+    }
