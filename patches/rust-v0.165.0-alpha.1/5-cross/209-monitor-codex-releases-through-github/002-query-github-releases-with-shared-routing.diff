+use super::*;
+use codex_http_client::OutboundProxyPolicy;
+use pretty_assertions::assert_eq;
+use serde_json::Value;
+use serde_json::json;
+use wiremock::Mock;
+use wiremock::MockServer;
+use wiremock::ResponseTemplate;
+use wiremock::matchers::body_json;
+use wiremock::matchers::method;
+use wiremock::matchers::path;
+
+fn client(server: &MockServer) -> GithubHttp {
+    GithubHttp::with_url(
+        HttpClientFactory::new(OutboundProxyPolicy::ReqwestDefault),
+        Url::parse(&server.uri()).expect("mock URL"),
+    )
+}
+
+#[tokio::test]
+async fn release_query_selects_only_required_fields_and_independent_channels() {
+    let server = MockServer::start().await;
+    Mock::given(method("POST"))
+        .and(path("/graphql"))
+        .and(body_json(json!({"query": RELEASE_QUERY})))
+        .respond_with(
+            ResponseTemplate::new(200)
+                .insert_header("x-ratelimit-remaining", "4999")
+                .set_body_json(json!({
+                    "data": { "repository": { "releases": { "nodes":
+                        (1..=10).map(|number| json!({
+                            "tagName": format!("rust-v9.1.0-alpha.{number}"),
+                            "url": format!("https://example.invalid/alpha/{number}"),
+                            "isDraft": false
+                        })).collect::<Vec<_>>()
+                    } } }
+                })),
+        )
+        .expect(1)
+        .mount(&server)
+        .await;
+    Mock::given(method("POST"))
+        .and(path("/graphql"))
+        .and(body_json(json!({"query": STABLE_RELEASE_QUERY})))
+        .respond_with(
+            ResponseTemplate::new(200)
+                .insert_header("x-ratelimit-remaining", "4998")
+                .set_body_json(json!({
+                    "data": { "repository": { "latestRelease": {
+                        "tagName": "rust-v9.0.0", "url": "https://example.invalid/stable", "isDraft": false
+                    } } }
+                })),
+        )
+        .expect(1)
+        .mount(&server)
+        .await;
+
+    let status = client(&server)
+        .releases("github-token")
+        .await
+        .expect("GitHub observation");
+    assert_eq!(status.remaining, Some(4998));
+    assert!(status.checked_at > 0);
+    assert_eq!(
+        status.latest_release,
+        Some(GithubRelease {
+            version: "9.0.0".into(),
+            url: "https://example.invalid/stable".into(),
+        })
+    );
+    assert_eq!(
+        status.latest_prerelease,
+        Some(GithubRelease {
+            version: "9.1.0-alpha.10".into(),
+            url: "https://example.invalid/alpha/10".into(),
+        })
+    );
+    let requests = server.received_requests().await.expect("requests");
+    assert_eq!(requests.len(), 2);
+    for (index, request) in requests.iter().enumerate() {
+        assert_eq!(
+            request.headers["authorization"].to_str().ok(),
+            Some("Bearer github-token")
+        );
+        let body: Value = serde_json::from_slice(&request.body).expect("GraphQL JSON");
+        let query = body["query"].as_str().expect("query");
+        if index == 0 {
+            assert!(query.contains("first: 10") && query.contains("CREATED_AT"));
+        } else {
+            assert!(query.contains("latestRelease"));
+        }
+        for field in ["tagName", "url", "isDraft"] {
+            assert!(query.contains(field), "{field}");
+        }
+        for unused in ["releaseAssets", "description", "author"] {
+            assert!(!query.contains(unused), "{unused}");
+        }
+    }
+}
+
+#[tokio::test]
+async fn secret_bearing_github_requests_do_not_follow_redirects() {
+    let server = MockServer::start().await;
+    Mock::given(method("POST"))
+        .and(path("/graphql"))
+        .respond_with(
+            ResponseTemplate::new(307)
+                .insert_header("location", format!("{}/redirected", server.uri())),
+        )
+        .expect(1)
+        .mount(&server)
+        .await;
+    Mock::given(path("/redirected"))
+        .respond_with(ResponseTemplate::new(200))
+        .expect(0)
+        .mount(&server)
+        .await;
+    assert!(client(&server).releases("github-token").await.is_err());
+}
+
+#[tokio::test]
+async fn github_rejects_oversized_response_bodies() {
+    let server = MockServer::start().await;
+    Mock::given(method("POST"))
+        .and(path("/graphql"))
+        .respond_with(ResponseTemplate::new(200).set_body_json(json!({
+            "data": { "repository": { "releases": { "nodes": [{
+                "tagName": "rust-v9.0.0",
+                "url": "x".repeat(RESPONSE_LIMIT),
+                "isDraft": false
+            }] } } }
+        })))
+        .expect(1)
+        .mount(&server)
+        .await;
+    assert!(client(&server).releases("github-token").await.is_err());
+}
+
+#[tokio::test]
+async fn graphql_errors_reject_absent_and_partial_observations() {
+    for failed_query in [RELEASE_QUERY, STABLE_RELEASE_QUERY] {
+        for data in [
+            Value::Null,
+            json!({"repository": {"releases": {"nodes": []}}}),
+        ] {
+            let server = MockServer::start().await;
+            Mock::given(method("POST"))
+                .and(path("/graphql"))
+                .and(body_json(json!({"query": failed_query})))
+                .respond_with(ResponseTemplate::new(200).set_body_json(json!({
+                    "data": data,
+                    "errors": [{"message": "Resource not accessible"}]
+                })))
+                .expect(1)
+                .mount(&server)
+                .await;
+            if failed_query == STABLE_RELEASE_QUERY {
+                Mock::given(method("POST"))
+                    .and(path("/graphql"))
+                    .and(body_json(json!({"query": RELEASE_QUERY})))
+                    .respond_with(ResponseTemplate::new(200).set_body_json(json!({
+                        "data": {"repository": {"releases": {"nodes": []}}}
+                    })))
+                    .expect(1)
+                    .mount(&server)
+                    .await;
+            }
+            assert!(client(&server).releases("github-token").await.is_err());
+        }
+    }
+}
+
+#[tokio::test]
+async fn release_queries_preserve_absent_stable_and_reject_invalid_channel_tags() {
+    for stable in [
+        Value::Null,
+        json!({"tagName": "rust-v9.0.0", "url": "stable", "isDraft": true}),
+        json!({"tagName": "rust-v9.1.0-alpha.1", "url": "alpha", "isDraft": false}),
+        json!({"tagName": "other-v9.0.0", "url": "other", "isDraft": false}),
+        json!({"tagName": "rust-vinvalid", "url": "invalid", "isDraft": false}),
+    ] {
+        let server = MockServer::start().await;
+        Mock::given(method("POST"))
+            .and(path("/graphql"))
+            .and(body_json(json!({"query": RELEASE_QUERY})))
+            .respond_with(ResponseTemplate::new(200).set_body_json(json!({
+                "data": {"repository": {"releases": {"nodes": [
+                    {"tagName": "rust-v10.0.0-alpha.1", "url": "draft", "isDraft": true},
+                    {"tagName": "other-v11.0.0-alpha.1", "url": "other", "isDraft": false},
+                    {"tagName": "rust-vinvalid", "url": "invalid", "isDraft": false},
+                    {"tagName": "rust-v9.0.0", "url": "stable", "isDraft": false},
+                    {"tagName": "rust-v9.1.0-alpha.1", "url": "alpha", "isDraft": false}
+                ]}}}
+            })))
+            .expect(1)
+            .mount(&server)
+            .await;
+        Mock::given(method("POST"))
+            .and(path("/graphql"))
+            .and(body_json(json!({"query": STABLE_RELEASE_QUERY})))
+            .respond_with(ResponseTemplate::new(200).set_body_json(json!({
+                "data": {"repository": {"latestRelease": stable}}
+            })))
+            .expect(1)
+            .mount(&server)
+            .await;
+        let status = client(&server).releases("github-token").await.unwrap();
+        assert_eq!(status.latest_release, None);
+        assert_eq!(status.latest_prerelease.unwrap().version, "9.1.0-alpha.1");
+        assert_eq!(status.remaining, None);
+    }
+}
