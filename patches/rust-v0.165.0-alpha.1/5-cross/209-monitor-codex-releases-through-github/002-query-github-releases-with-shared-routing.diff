+use codex_app_server_protocol::GithubRelease;
+use codex_app_server_protocol::GithubStatus;
+use codex_http_client::ClientRouteClass;
+use codex_http_client::HttpClientFactory;
+use codex_http_client::RouteAwareClientPool;
+use codex_login::default_client::default_headers;
+use semver::Version;
+use serde::Deserialize;
+use serde::de::DeserializeOwned;
+use std::time::Duration;
+use url::Url;
+
+const TIMEOUT: Duration = Duration::from_secs(10);
+const RESPONSE_LIMIT: usize = 4 * 1024 * 1024;
+const RELEASE_QUERY: &str = r#"{
+  repository(owner: "openai", name: "codex") {
+    releases(first: 10, orderBy: {field: CREATED_AT, direction: DESC}) {
+      nodes { tagName url isDraft }
+    }
+  }
+}"#;
+const STABLE_RELEASE_QUERY: &str = r#"{
+  repository(owner: "openai", name: "codex") {
+    latestRelease { tagName url isDraft }
+  }
+}"#;
+
+pub(crate) struct GithubHttp {
+    pool: RouteAwareClientPool,
+    base: Url,
+}
+
+#[derive(Deserialize)]
+struct GithubResponse<T> {
+    data: Option<GithubData<T>>,
+    #[serde(default)]
+    errors: Vec<serde::de::IgnoredAny>,
+}
+
+#[derive(Deserialize)]
+struct GithubData<T> {
+    repository: T,
+}
+
+#[derive(Deserialize)]
+struct GithubRepository {
+    releases: GithubReleases,
+}
+
+#[derive(Deserialize)]
+struct GithubReleases {
+    nodes: Vec<Release>,
+}
+
+#[derive(Deserialize)]
+#[serde(rename_all = "camelCase")]
+struct GithubStableRepository {
+    latest_release: Option<Release>,
+}
+
+#[derive(Deserialize)]
+#[serde(rename_all = "camelCase")]
+struct Release {
+    tag_name: String,
+    url: String,
+    is_draft: bool,
+}
+
+impl Release {
+    fn version(self) -> Option<(Version, String)> {
+        if self.is_draft {
+            return None;
+        }
+        let version = self.tag_name.strip_prefix("rust-v")?.parse().ok()?;
+        Some((version, self.url))
+    }
+}
+
+impl GithubHttp {
+    pub(crate) fn new(factory: HttpClientFactory) -> Self {
+        Self {
+            pool: RouteAwareClientPool::new_without_redirects_or_request_logging(
+                factory,
+                ClientRouteClass::Other,
+            ),
+            base: Url::parse("https://api.github.com").expect("valid GitHub URL"),
+        }
+    }
+
+    #[cfg(test)]
+    pub(crate) fn with_url(factory: HttpClientFactory, base: Url) -> Self {
+        Self {
+            base,
+            ..Self::new(factory)
+        }
+    }
+
+    pub(crate) async fn releases(&self, token: &str) -> Result<GithubStatus, ()> {
+        let (recent, _) = self.query::<GithubRepository>(token, RELEASE_QUERY).await?;
+        let (stable, remaining) = self
+            .query::<GithubStableRepository>(token, STABLE_RELEASE_QUERY)
+            .await?;
+        let latest_release = stable
+            .latest_release
+            .and_then(Release::version)
+            .filter(|(version, _)| version.pre.is_empty());
+        let latest_prerelease = recent
+            .releases
+            .nodes
+            .into_iter()
+            .filter_map(Release::version)
+            .filter(|(version, _)| !version.pre.is_empty())
+            .max_by(|(left, _), (right, _)| left.cmp(right));
+        let public_release = |(version, url): (Version, String)| GithubRelease {
+            version: version.to_string(),
+            url,
+        };
+        Ok(GithubStatus {
+            latest_release: latest_release.map(public_release),
+            latest_prerelease: latest_prerelease.map(public_release),
+            checked_at: chrono::Utc::now().timestamp(),
+            remaining,
+        })
+    }
+
+    async fn query<T: DeserializeOwned>(
+        &self,
+        token: &str,
+        query: &str,
+    ) -> Result<(T, Option<u64>), ()> {
+        let mut url = self.base.clone();
+        url.path_segments_mut()
+            .map_err(|_| ())?
+            .clear()
+            .push("graphql");
+        let mut response = self
+            .pool
+            .post(url)
+            .headers(default_headers())
+            .header("authorization", format!("Bearer {}", token.trim()))
+            .json(&serde_json::json!({ "query": query }))
+            .timeout(TIMEOUT)
+            .send()
+            .await
+            .map_err(|_| ())?;
+        if response.status().as_u16() != 200 {
+            return Err(());
+        }
+        let remaining = response
+            .headers()
+            .get("x-ratelimit-remaining")
+            .and_then(|value| value.to_str().ok()?.parse().ok());
+        let mut body = Vec::new();
+        while let Some(chunk) = response.chunk().await.map_err(|_| ())? {
+            if chunk.len() > RESPONSE_LIMIT.saturating_sub(body.len()) {
+                return Err(());
+            }
+            body.extend_from_slice(&chunk);
+        }
+        let response: GithubResponse<T> = serde_json::from_slice(&body).map_err(|_| ())?;
+        if !response.errors.is_empty() {
+            return Err(());
+        }
+        Ok((response.data.ok_or(())?.repository, remaining))
+    }
+}
+
