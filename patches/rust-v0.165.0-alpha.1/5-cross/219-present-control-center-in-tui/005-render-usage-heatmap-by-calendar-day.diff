+use super::super::render::tests::report;
+use super::*;
+use crate::control_center_table::tests::render_lines;
+use itertools::Itertools;
+use pretty_assertions::assert_eq;
+
+fn render_selected(
+    report: &UsageReport,
+    width: u16,
+    selected: Option<NaiveDate>,
+) -> Vec<Line<'static>> {
+    render_lines(
+        super::super::render::render_summary(report, width, selected),
+        width,
+    )
+}
+
+#[test]
+fn heatmap_keeps_sixteen_positive_levels_without_activity_labels() {
+    assert_eq!(
+        (0..=16)
+            .map(|value| level(value, &(1..=16).collect::<Vec<_>>()))
+            .collect::<Vec<_>>(),
+        (0..=16).collect::<Vec<_>>()
+    );
+    let text = render_selected(&report(), 40, latest_usage_day(&report()))
+        .iter()
+        .join("\n");
+    for removed in [
+        "Current streak",
+        "Longest",
+        "Peak",
+        "Activity",
+        "Less",
+        "More",
+    ] {
+        assert!(!text.contains(removed));
+    }
+    insta::assert_snapshot!(text);
+}
+
+#[test]
+fn calendar_shades_follow_theme_without_changing_selected_day_geometry() {
+    let original = crate::render::highlight::current_syntax_theme();
+    let today = NaiveDate::from_ymd_opt(2026, 9, 30).unwrap();
+    let lower = today - Duration::days(2);
+    let selected = today - Duration::days(1);
+    let daily = BTreeMap::from([(lower, 100), (selected, 200)]);
+    let mut rendered = Vec::new();
+    for (theme, bg, fg) in [
+        ("nord", (20, 35, 50), (220, 230, 240)),
+        ("github", (250, 241, 235), (30, 40, 50)),
+    ] {
+        crate::render::highlight::set_syntax_theme(
+            crate::render::highlight::resolve_theme_by_name(theme, None).unwrap(),
+        );
+        rendered.push(crate::terminal_palette::with_test_default_colors(
+            crate::terminal_probe::DefaultColors { fg, bg },
+            || {
+                let palette = Palette::current();
+                let lines = calendar(&daily, today, 40, Some(selected), &palette);
+                for (day, rank, symbol) in
+                    [(lower, 1, "▪ "), (selected, 16, "■ "), (today, 0, "▪ ")]
+                {
+                    let weekday = day.weekday().num_days_from_sunday() as usize;
+                    let week = (day - start(today, 40)).num_days() as usize / 7;
+                    let cell = &lines[weekday].spans[1 + week];
+                    assert_eq!(cell.content, symbol);
+                    assert_eq!(cell.style.fg, palette.intensity(rank).fg);
+                }
+                assert_ne!(palette.intensity(0), palette.intensity(1));
+                assert_eq!(lines.len(), 7);
+                (lines.iter().join("\n"), palette.intensity(16).fg)
+            },
+        ));
+    }
+    crate::render::highlight::set_syntax_theme(original);
+    assert_eq!(rendered[0].0, rendered[1].0);
+    assert_ne!(rendered[0].1, rendered[1].1);
+}
+
+#[test]
+fn calendar_keeps_weekday_geometry_and_future_days_blank() {
+    let today = NaiveDate::from_ymd_opt(2026, 9, 30).unwrap();
+    let daily = BTreeMap::from([(today - Duration::days(2), 100)]);
+    for width in [32, 40, 80, 120] {
+        let lines = calendar(&daily, today, width, None, &Palette::current());
+        let weeks = (usize::from(width).saturating_sub(5) / 2).clamp(1, 52);
+        assert_eq!(lines.len(), 7);
+        assert_eq!(
+            lines
+                .iter()
+                .map(|row| row.spans[0].content.trim())
+                .collect::<Vec<_>>(),
+            ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"]
+        );
+        for row in &lines {
+            assert_eq!(row.width(), 5 + 2 * weeks);
+            assert!(row.width() <= usize::from(width));
+        }
+        for future in &lines[4..=6] {
+            assert_eq!(future.spans.last().unwrap().content, "  ");
+        }
+    }
+    for today in [
+        NaiveDate::from_ymd_opt(2026, 10, 4).unwrap(),
+        NaiveDate::from_ymd_opt(2026, 11, 1).unwrap(),
+    ] {
+        let lines = calendar(&daily, today, 109, Some(today), &Palette::current());
+        assert_eq!(lines.len(), 7);
+        assert_eq!(lines[0].spans[0].content, " Sun ");
+        let selected = lines
+            .iter()
+            .flat_map(|line| &line.spans)
+            .find(|span| span.content == "■ ")
+            .unwrap();
+        assert!(
+            !selected
+                .style
+                .add_modifier
+                .contains(ratatui::style::Modifier::UNDERLINED)
+        );
+    }
+}
+
+#[test]
+fn latest_day_and_heatmap_selection_share_the_daily_table() {
+    let mut report = report();
+    report.missing_prices.insert("older-model".into());
+    let selected = NaiveDate::from_ymd_opt(2026, 9, 28).unwrap();
+    report.rows.insert(
+        "2025-01-01".into(),
+        BTreeMap::from([(
+            "older-model".into(),
+            codex_app_server_protocol::UsageTotals {
+                tokens: codex_app_server_protocol::UsageTokens {
+                    input: 10,
+                    total: 10,
+                    ..Default::default()
+                },
+                ..Default::default()
+            },
+        )]),
+    );
+    report.rows.insert("2026-09-30".into(), BTreeMap::new());
+    assert_eq!(latest_usage_day(&report), Some(selected));
+    let overview = render_selected(&report, 200, latest_usage_day(&report));
+    let text = overview.iter().join("\n");
+    assert!(text.contains('■'));
+    assert!(!text.contains("older-model"));
+    assert!(!text.contains("All days") && !text.contains("Period"));
+    assert!(!text.contains("Prices") && !text.contains("USD per 1M tokens"));
+    assert!(!text.contains("All dates:"));
+    assert!(!text.contains("Estimated weekly quota"));
+    assert!(!text.contains("Started") && !text.contains("Provisional"));
+    let detail = render_selected(&report, 200, Some(selected));
+    assert_eq!(
+        detail
+            .iter()
+            .flat_map(|line| &line.spans)
+            .filter(|span| span.content.contains('■'))
+            .count(),
+        1
+    );
+    let text = detail.iter().join("\n");
+    assert!(text.contains("2026-09-28") && !text.contains("Selected day"));
+    assert!(text.contains("gpt-5.4") && !text.contains("USD per 1M tokens"));
+    assert!(!text.contains("older-model") && !text.contains("Period"));
+    assert!(!text.contains("Esc:") && !text.contains("WASD"));
+    assert!(!text.contains("Estimated weekly quota"));
+    assert!(!text.contains("Started") && !text.contains("Provisional"));
+    assert_eq!(text.matches("2026-09-28").count(), 1);
+    let scope_row = |lines: &[Line<'_>], label: &str| {
+        lines
+            .iter()
+            .position(|line| line.to_string().contains(label))
+            .unwrap()
+    };
+    assert_eq!(
+        scope_row(&overview, "2026-09-28"),
+        scope_row(&detail, "2026-09-28")
+    );
+    assert_eq!(scope_row(&overview, "Model"), scope_row(&detail, "Model"));
+    let mut daily_report = report.clone();
+    daily_report.rows.retain(|day, _| day == "2026-09-28");
+    let daily = render_lines(
+        super::super::render::render(&daily_report, super::super::UsageRange::Daily, 200),
+        200,
+    );
+    let table_start = detail
+        .iter()
+        .position(|line| line.to_string().starts_with('┌'))
+        .unwrap();
+    assert_eq!(&detail[table_start..], daily.as_slice());
+    let selected_cell = detail
+        .iter()
+        .flat_map(|line| &line.spans)
+        .find(|span| span.content.contains('■'))
+        .unwrap();
+    assert_eq!(
+        selected_cell.style.fg.unwrap_or_default(),
+        Palette::current().intensity(16).fg.unwrap_or_default()
+    );
+    assert!(
+        selected_cell
+            .style
+            .add_modifier
+            .contains(ratatui::style::Modifier::BOLD)
+    );
+    insta::assert_snapshot!(text);
+}
