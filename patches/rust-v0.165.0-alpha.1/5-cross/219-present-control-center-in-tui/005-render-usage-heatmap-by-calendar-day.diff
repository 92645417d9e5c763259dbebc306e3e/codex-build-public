+//! Daily activity and selected-day accounting share the report's local calendar.
+
+use super::UsageReport;
+use super::render::usage_tables;
+use crate::control_center_table::Palette;
+use crate::render::renderable::Renderable;
+use chrono::Datelike;
+use chrono::Duration;
+use chrono::NaiveDate;
+use itertools::Itertools;
+use ratatui::style::Stylize;
+use ratatui::text::Line;
+use ratatui::text::Span;
+use std::collections::BTreeMap;
+
+pub(crate) fn heatmap_bounds(report: &UsageReport, width: u16) -> (NaiveDate, NaiveDate) {
+    let today = report.refreshed_at.date_naive();
+    (start(today, width), today)
+}
+
+pub(crate) fn day_has_usage(report: &UsageReport, day: NaiveDate) -> bool {
+    report
+        .rows
+        .get(&day.to_string())
+        .is_some_and(|models| models.values().any(|usage| usage.tokens.total > 0))
+}
+
+pub(crate) fn latest_usage_day(report: &UsageReport) -> Option<NaiveDate> {
+    report.rows.iter().rev().find_map(|(date, models)| {
+        let day = NaiveDate::parse_from_str(date, "%Y-%m-%d").ok()?;
+        (day <= report.refreshed_at.date_naive()
+            && models.values().any(|usage| usage.tokens.total > 0))
+        .then_some(day)
+    })
+}
+
+pub(super) fn render(
+    report: &UsageReport,
+    width: u16,
+    selected: Option<NaiveDate>,
+    palette: &Palette,
+) -> Vec<Box<dyn Renderable>> {
+    let today = report.refreshed_at.date_naive();
+    let daily = report
+        .rows
+        .iter()
+        .filter_map(|(date, models)| {
+            let day = NaiveDate::parse_from_str(date, "%Y-%m-%d").ok()?;
+            ((today - Duration::days(364)..=today).contains(&day))
+                .then_some((day, models.values().map(|usage| usage.tokens.total).sum()))
+        })
+        .collect();
+    let mut lines: Vec<Box<dyn Renderable>> = calendar(
+        &daily,
+        report.refreshed_at.date_naive(),
+        width,
+        selected,
+        palette,
+    )
+    .into_iter()
+    .map(Into::into)
+    .collect();
+    lines.push(Line::default().into());
+    let selected_key = selected.map(|day| day.to_string());
+    let periods = selected_key
+        .as_ref()
+        .and_then(|day| report.rows.get(day).map(|models| (day.as_str(), models)))
+        .into_iter()
+        .collect::<Vec<_>>();
+    lines.extend(usage_tables(report, &periods, width, palette));
+    lines
+}
+
+fn start(today: NaiveDate, width: u16) -> NaiveDate {
+    let weeks = (usize::from(width).saturating_sub(5) / 2).clamp(1, 52);
+    let end = today + Duration::days(6 - i64::from(today.weekday().num_days_from_sunday()));
+    end - Duration::days((weeks * 7 - 1) as i64)
+}
+
+fn calendar(
+    daily: &BTreeMap<NaiveDate, u64>,
+    today: NaiveDate,
+    width: u16,
+    selected: Option<NaiveDate>,
+    palette: &Palette,
+) -> Vec<Line<'static>> {
+    if width < 7 {
+        return vec![" Widen terminal to show the heatmap.".dim().into()];
+    }
+    let weeks = (usize::from(width).saturating_sub(5) / 2).clamp(1, 52);
+    let start = start(today, width);
+    let scale = daily
+        .values()
+        .copied()
+        .filter(|value| *value > 0)
+        .sorted()
+        .dedup()
+        .collect::<Vec<_>>();
+    let mut lines = Vec::new();
+    for (weekday, label) in [
+        " Sun ", " Mon ", " Tue ", " Wed ", " Thu ", " Fri ", " Sat ",
+    ]
+    .into_iter()
+    .enumerate()
+    {
+        let mut spans = vec![Span::from(label)];
+        for week in 0..weeks {
+            let date = start + Duration::days((week * 7 + weekday) as i64);
+            if date > today {
+                spans.push("  ".into());
+                continue;
+            }
+            let style = palette.intensity(level(daily.get(&date).copied().unwrap_or(0), &scale));
+            spans.push(if selected == Some(date) {
+                Span::styled("■ ", style.bold())
+            } else {
+                Span::styled("▪ ", style)
+            });
+        }
+        lines.push(spans.into());
+    }
+    lines
+}
+
+fn level(value: u64, scale: &[u64]) -> usize {
+    if value == 0 {
+        0
+    } else if scale.len() == 1 {
+        16
+    } else {
+        1 + scale.partition_point(|candidate| *candidate < value) * 15 / (scale.len() - 1)
+    }
+}
+
