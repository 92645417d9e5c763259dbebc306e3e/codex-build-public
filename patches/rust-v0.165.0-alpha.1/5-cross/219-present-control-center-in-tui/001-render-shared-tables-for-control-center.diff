+//! Presentation of the app-server's shared local accounting snapshot.
+
+pub(crate) use codex_app_server_protocol::UsageReport;
+use codex_app_server_protocol::UsageTotals as Usage;
+use std::collections::BTreeMap;
+
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub(crate) enum UsageRange {
+    Daily,
+    Weekly,
+    Monthly,
+    Yearly,
+    Summary,
+    Quota,
+}
+
+impl UsageRange {
+    pub(crate) const VIEWS: [Self; 6] = [
+        Self::Summary,
+        Self::Daily,
+        Self::Weekly,
+        Self::Monthly,
+        Self::Yearly,
+        Self::Quota,
+    ];
+
+    pub(crate) fn index(self) -> usize {
+        Self::VIEWS
+            .iter()
+            .position(|range| *range == self)
+            .expect("every usage view is listed")
+    }
+
+    pub(crate) fn label(self) -> &'static str {
+        match self {
+            Self::Daily => "Daily",
+            Self::Weekly => "Weekly",
+            Self::Monthly => "Monthly",
+            Self::Yearly => "Yearly",
+            Self::Summary => "Summary",
+            Self::Quota => "Weekly quota",
+        }
+    }
+}
+
+fn periods(
+    report: &UsageReport,
+    range: UsageRange,
+) -> impl DoubleEndedIterator<Item = (&String, &BTreeMap<String, Usage>)> {
+    let rows = match range {
+        UsageRange::Weekly => &report.weekly_rows,
+        UsageRange::Monthly => &report.monthly_rows,
+        UsageRange::Yearly => &report.yearly_rows,
+        UsageRange::Daily | UsageRange::Summary | UsageRange::Quota => &report.rows,
+    };
+    let today = report.refreshed_at.date_naive();
+    let bounds = match range {
+        UsageRange::Summary => Some((today - chrono::Duration::days(364), today)),
+        UsageRange::Daily
+        | UsageRange::Weekly
+        | UsageRange::Monthly
+        | UsageRange::Yearly
+        | UsageRange::Quota => None,
+    }
+    .map(|(start, end)| (start.to_string(), end.to_string()));
+    rows.iter().filter(move |(date, _)| {
+        bounds
+            .as_ref()
+            .is_none_or(|(start, end)| *date >= start && *date <= end)
+    })
+}
