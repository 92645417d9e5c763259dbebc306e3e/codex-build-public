+//! Shared control-center cells, numeric shading, and bounded tables with merged cells.
+
+use crate::color::blend;
+use crate::render::highlight::convert_syntect_color;
+use crate::render::highlight::current_syntax_theme;
+use crate::render::highlight::foreground_style_for_scopes;
+use crate::render::renderable::Renderable;
+use crate::style::accent_style;
+use crate::style::readable_color_on;
+use crate::style::table_separator_style;
+use crate::style::theme_color_on;
+use crate::terminal_palette::best_color;
+use crate::terminal_palette::default_bg;
+use itertools::Itertools;
+use ratatui::buffer::Buffer;
+use ratatui::layout::Rect;
+use ratatui::style::Color;
+use ratatui::style::Style;
+use ratatui::style::Stylize;
+use ratatui::text::Line;
+use ratatui::text::Span;
+use ratatui::widgets::Paragraph;
+use ratatui::widgets::Widget;
+use unicode_width::UnicodeWidthStr;
+
+// Two interior padding cells and the next border belong to each physical column.
+const COLUMN_SPACING: usize = 3;
+
+/// Resolve theme scopes once for a complete report or response-table frame.
+pub(crate) struct Palette {
+    header: Style,
+    separator: Style,
+    intensities: [Style; 17],
+    models: Vec<Style>,
+    pub(crate) effort: Style,
+    pub(crate) success: Style,
+    pub(crate) attention: Style,
+    pub(crate) failure: Style,
+}
+
+impl Palette {
+    pub(crate) fn current() -> Self {
+        let mut header = accent_style();
+        if let Some(color) = header.fg {
+            header = header.fg(readable_color_on(color, None));
+        }
+        let numeric = foreground_style_for_scopes(&["constant.numeric"])
+            .and_then(|style| style.fg)
+            .or_else(|| {
+                current_syntax_theme()
+                    .settings
+                    .foreground
+                    .and_then(convert_syntect_color)
+            })
+            .unwrap_or(Color::Reset);
+        Self {
+            header,
+            separator: table_separator_style(),
+            intensities: std::array::from_fn(|level| intensity_style(numeric, level)),
+            models: [
+                "entity.name.type",
+                "string",
+                "constant.numeric",
+                "keyword",
+                "entity.name.function",
+                "variable.parameter",
+                "storage.modifier",
+            ]
+            .into_iter()
+            .map(|scope| theme_color_on(&[scope], None))
+            .unique()
+            .map(|color| Style::default().fg(color))
+            .collect(),
+            effort: Style::default().fg(theme_color_on(&["storage.modifier"], None)),
+            success: Style::default().fg(theme_color_on(&["string"], None)),
+            attention: Style::default().fg(theme_color_on(&["keyword"], None)),
+            failure: Style::default().fg(theme_color_on(&["invalid"], None)),
+        }
+    }
+
+    pub(crate) fn header(&self, text: &str) -> Cell {
+        Cell {
+            style: self.header,
+            ..Cell::text(text)
+        }
+    }
+
+    pub(crate) fn intensity(&self, level: usize) -> Style {
+        self.intensities[level]
+    }
+
+    pub(crate) fn model(&self, index: usize) -> Style {
+        self.models[index % self.models.len()]
+    }
+}
+
+pub(crate) struct Cell {
+    pub(crate) lines: Vec<Line<'static>>,
+    pub(crate) value: Option<f64>,
+    pub(crate) right: bool,
+    pub(crate) rows: usize,
+    pub(crate) columns: usize,
+    pub(crate) style: Style,
+}
+
+impl Cell {
+    pub(crate) fn text(text: impl Into<String>) -> Self {
+        Self::lines(
+            text.into()
+                .split('\n')
+                .map(|line| line.to_owned().into())
+                .collect(),
+        )
+    }
+
+    pub(crate) fn lines(lines: Vec<Line<'static>>) -> Self {
+        Self {
+            lines,
+            value: None,
+            right: false,
+            rows: 1,
+            columns: 1,
+            style: Style::default(),
+        }
+    }
+
+    pub(crate) fn number(text: impl Into<String>) -> Self {
+        Self {
+            right: true,
+            ..Self::text(text)
+        }
+    }
+
+    pub(crate) fn spanning(mut self, rows: usize, columns: usize) -> Self {
+        self.rows = rows;
+        self.columns = columns;
+        self
+    }
+
+    pub(crate) fn value(value: Option<f64>, text: impl Into<String>) -> Self {
+        Self {
+            value,
+            ..Self::number(text)
+        }
+    }
+}
+
+pub(crate) fn compact_count(value: u64) -> String {
+    if value >= 1_000_000_000 {
+        format!("{:.2}B", value as f64 / 1_000_000_000.0)
+    } else if value >= 1_000_000 {
+        format!("{:.2}M", value as f64 / 1_000_000.0)
+    } else if value >= 1_000 {
+        format!("{:.2}K", value as f64 / 1_000.0)
+    } else {
+        value.to_string()
+    }
+}
+
+/// Order logical rows before formatting, clipping, shading, or adding headers and totals.
+pub(crate) fn descending_rows<T, K: Ord>(
+    rows: impl IntoIterator<Item = T>,
+    mut key: impl FnMut(&T) -> K,
+) -> Vec<T> {
+    let mut rows: Vec<_> = rows.into_iter().collect();
+    rows.sort_by_cached_key(|row| std::cmp::Reverse(key(row)));
+    rows
+}
+
+/// Content widths exclude padding and borders. A presentation limit retains the full
+/// logical value for copying while bounding exceptional values with the table's ellipsis.
+#[derive(Clone, Copy)]
+pub(crate) struct Column {
+    minimum: usize,
+    maximum: usize,
+}
+
+impl Column {
+    /// Reserve format-sized bounds, including at most one cell for symmetric headers.
+    /// Matching label parity lets every later growth step preserve equal padding.
+    pub(crate) fn new(label: &str, minimum: usize, maximum: usize) -> Self {
+        let label_width = label.width();
+        let maximum = maximum.max(label_width);
+        let maximum = maximum + maximum.abs_diff(label_width) % 2;
+        let minimum = minimum.max(label_width).min(maximum);
+        Self {
+            minimum: minimum + minimum.abs_diff(label_width) % 2,
+            maximum,
+        }
+    }
+
+    pub(crate) fn maximum(self) -> usize {
+        self.maximum
+    }
+}
+
+/// Allocate from format-derived floors toward actual content, including merged cells.
+/// A narrow viewport never shrinks a floor; horizontal scrolling owns the overflow.
+pub(crate) fn widths(available: u16, columns: &[Column], rows: &[Vec<Cell>]) -> Vec<usize> {
+    let (placed, _) = place_cells(columns.len(), rows);
+    let mut desired: Vec<_> = columns.iter().map(|column| column.minimum).collect();
+    let maxima: Vec<_> = columns.iter().map(|column| column.maximum).collect();
+    for entry in &placed {
+        if entry.cell.columns == 1 {
+            let needed = desired[entry.column]
+                .max(entry.cell.lines.iter().map(Line::width).max().unwrap_or(0))
+                .min(columns[entry.column].maximum);
+            desired[entry.column] = needed + needed.abs_diff(columns[entry.column].minimum) % 2;
+        }
+    }
+    for entry in &placed {
+        if entry.cell.columns > 1 {
+            let range = entry.column..entry.column + entry.cell.columns;
+            let needed = entry.cell.lines.iter().map(Line::width).max().unwrap_or(0);
+            let present = desired[range.clone()].iter().sum::<usize>()
+                + (entry.cell.columns - 1) * COLUMN_SPACING;
+            grow_columns(
+                &mut desired[range.clone()],
+                &maxima[range],
+                needed.saturating_sub(present).next_multiple_of(2),
+            );
+        }
+    }
+    let room = usize::from(available).saturating_sub(columns.len() * COLUMN_SPACING + 1);
+    let mut widths: Vec<_> = columns.iter().map(|column| column.minimum).collect();
+    let remaining = room.saturating_sub(widths.iter().sum());
+    grow_columns(&mut widths, &desired, remaining);
+    widths
+}
+
+fn grow_columns(widths: &mut [usize], desired: &[usize], mut remaining: usize) {
+    while remaining >= 2 {
+        let mut grew = false;
+        for (width, desired) in widths.iter_mut().zip(desired) {
+            if remaining >= 2 && *width < *desired {
+                *width += 2;
+                remaining -= 2;
+                grew = true;
+            }
+        }
+        if !grew {
+            break;
+        }
+    }
+}
+
+struct Placed<'a> {
+    cell: &'a Cell,
+    row: usize,
+    column: usize,
+}
+
+fn place_cells(columns: usize, rows: &[Vec<Cell>]) -> (Vec<Placed<'_>>, Vec<Vec<usize>>) {
+    let mut placed = Vec::new();
+    let mut owners = vec![vec![usize::MAX; columns]; rows.len()];
+    for (row, cells) in rows.iter().enumerate() {
+        let mut column = 0;
+        for cell in cells {
+            while column < columns && owners[row][column] != usize::MAX {
+                column += 1;
+            }
+            assert!(cell.rows > 0 && cell.columns > 0);
+            assert!(row + cell.rows <= rows.len() && column + cell.columns <= columns);
+            for occupied in &mut owners[row..row + cell.rows] {
+                for slot in &mut occupied[column..column + cell.columns] {
+                    assert_eq!(*slot, usize::MAX, "overlapping table cells");
+                    *slot = placed.len();
+                }
+            }
+            placed.push(Placed { cell, row, column });
+            column += cell.columns;
+        }
+        assert!(owners[row].iter().all(|owner| *owner != usize::MAX));
+    }
+    (placed, owners)
+}
+
+/// Center the longest visible label, then align every label to its left edge.
+pub(crate) fn center_left_column(rows: &mut [Vec<Cell>], column: usize, width: usize) {
+    let text_width = rows
+        .iter()
+        .flat_map(|row| &row[column].lines)
+        .map(Line::width)
+        .max()
+        .unwrap_or_default()
+        .min(width);
+    for row in rows {
+        for line in &mut row[column].lines {
+            let padding = text_width.saturating_sub(line.width());
+            if padding > 0 {
+                line.spans.push(Span::from(" ".repeat(padding)));
+            }
+        }
+    }
+}
+
+pub(crate) fn shade_columns(rows: &mut [Vec<Cell>], palette: &Palette) {
+    for column in 0..rows.iter().map(Vec::len).max().unwrap_or(0) {
+        let scale = rows
+            .iter()
+            .filter_map(|row| row.get(column)?.value)
+            .filter(|value| *value > 0.0)
+            .sorted_by(f64::total_cmp)
+            .dedup()
+            .collect::<Vec<_>>();
+        for cell in rows.iter_mut().filter_map(|row| row.get_mut(column)) {
+            if let Some(value) = cell.value.filter(|value| *value > 0.0) {
+                let rank = scale.partition_point(|candidate| *candidate < value);
+                cell.style = cell.style.patch(palette.intensity(if scale.len() == 1 {
+                    16
+                } else {
+                    1 + rank * 15 / (scale.len() - 1)
+                }));
+            }
+        }
+    }
+}
+
+pub(crate) struct Table {
+    lines: Vec<Line<'static>>,
+    separator: Style,
+    // Physical row starts and their column edges preserve merged cells at viewport cuts.
+    row_edges: Vec<(usize, Vec<usize>)>,
+}
+
+impl Table {
+    fn cap(&self, after: usize, bottom: bool) -> Line<'static> {
+        let row = self.row_edges.partition_point(|(start, _)| *start <= after) - 1;
+        let columns = &self.row_edges[row].1;
+        let style = self.separator;
+        let mut spans = vec![Span::styled(if bottom { "└" } else { "┌" }, style)];
+        for (index, pair) in columns.windows(2).enumerate() {
+            spans.push(Span::styled("─".repeat(pair[1] - pair[0] - 1), style));
+            let edge = if index + 2 == columns.len() {
+                if bottom { "┘" } else { "┐" }
+            } else if bottom {
+                "┴"
+            } else {
+                "┬"
+            };
+            spans.push(Span::styled(edge, style));
+        }
+        spans.into()
+    }
+}
+
+impl Renderable for Table {
+    fn desired_width(&self) -> u16 {
+        self.lines
+            .first()
+            .map_or(0, Line::width)
+            .min(usize::from(u16::MAX)) as u16
+    }
+
+    fn desired_height(&self, _width: u16) -> u16 {
+        self.lines.len().min(usize::from(u16::MAX)) as u16
+    }
+
+    fn render(&self, area: Rect, buf: &mut Buffer) {
+        self.render_scrolled(area, buf, 0);
+    }
+
+    fn render_scrolled(&self, area: Rect, buf: &mut Buffer, scroll_offset: u16) -> bool {
+        self.render_viewport(area, buf, scroll_offset, 0)
+    }
+}
+
+impl Table {
+    pub(crate) fn render_viewport(
+        &self,
+        area: Rect,
+        buf: &mut Buffer,
+        scroll_offset: u16,
+        horizontal_offset: u16,
+    ) -> bool {
+        let offset = usize::from(scroll_offset);
+        let mut height = usize::from(area.height).min(self.lines.len().saturating_sub(offset));
+        if offset + height < self.lines.len()
+            && height > 2
+            && self
+                .row_edges
+                .binary_search_by_key(&(offset + height - 2), |(start, _)| *start)
+                .is_ok()
+        {
+            // Close above an orphan separator, at the last displayed content row.
+            // Keep source offsets unchanged so overlapping pages retain every row.
+            height -= 1;
+        }
+        // Borders without an interior row are not a useful table fragment.
+        if height < 3 {
+            return true;
+        }
+        for (row, line) in self.lines.iter().skip(offset).take(height).enumerate() {
+            let cap = if height > 1 && row == 0 && offset > 0 {
+                Some(self.cap(offset, false))
+            } else if row + 1 == height && offset + height < self.lines.len() {
+                Some(self.cap(offset + height.saturating_sub(2), true))
+            } else {
+                None
+            };
+            let line = cap.as_ref().unwrap_or(line);
+            let row_area = Rect::new(area.x, area.y + row as u16, area.width, 1);
+            if horizontal_offset == 0 {
+                Widget::render(line, row_area, buf);
+            } else {
+                Paragraph::new(line.clone())
+                    .scroll((0, horizontal_offset))
+                    .render(row_area, buf);
+            }
+        }
+        true
+    }
+}
+
+/// Every row supplies only cells that start there; spanned positions are omitted.
+pub(crate) fn render(widths: &[usize], rows: &[Vec<Cell>], palette: &Palette) -> Table {
+    if rows.is_empty() || widths.is_empty() {
+        return Table {
+            lines: Vec::new(),
+            separator: palette.separator,
+            row_edges: Vec::new(),
+        };
+    }
+    let (placed, owners) = place_cells(widths.len(), rows);
+    let mut heights = vec![1; rows.len()];
+    for entry in &placed {
+        if entry.cell.rows == 1 {
+            heights[entry.row] = heights[entry.row].max(entry.cell.lines.len());
+        }
+    }
+    for entry in &placed {
+        let end = entry.row + entry.cell.rows;
+        let available = heights[entry.row..end].iter().sum::<usize>() + entry.cell.rows - 1;
+        heights[end - 1] += entry.cell.lines.len().saturating_sub(available);
+    }
+    let mut boundaries = vec![0];
+    for height in &heights {
+        boundaries.push(boundaries.last().unwrap() + height + 1);
+    }
+    let horizontal = |row: usize, column: usize| {
+        row == 0 || row == rows.len() || owners[row - 1][column] != owners[row][column]
+    };
+    let vertical = |row: usize, column: usize| {
+        column == 0 || column == widths.len() || owners[row][column - 1] != owners[row][column]
+    };
+    let junction = |row: usize, column: usize| {
+        let north = row > 0 && vertical(row - 1, column);
+        let south = row < rows.len() && vertical(row, column);
+        let west = column > 0 && horizontal(row, column - 1);
+        let east = column < widths.len() && horizontal(row, column);
+        let mask =
+            u8::from(north) | u8::from(south) << 1 | u8::from(west) << 2 | u8::from(east) << 3;
+        match mask {
+            15 => "┼",
+            14 => "┬",
+            13 => "┴",
+            11 => "├",
+            7 => "┤",
+            10 => "┌",
+            6 => "┐",
+            9 => "└",
+            5 => "┘",
+            3 => "│",
+            12 => "─",
+            _ => " ",
+        }
+    };
+    let content = |entry: &Placed<'_>, y: usize| {
+        let width = widths[entry.column..entry.column + entry.cell.columns]
+            .iter()
+            .sum::<usize>()
+            + (entry.cell.columns - 1) * COLUMN_SPACING;
+        let height = boundaries[entry.row + entry.cell.rows] - boundaries[entry.row] - 1;
+        let offset = y - boundaries[entry.row] - 1;
+        cell_line(entry.cell, width, offset, height)
+    };
+    let mut lines = Vec::with_capacity(boundaries.last().unwrap() + 1);
+    let separator = palette.separator;
+    for row in 0..=rows.len() {
+        let mut spans = Vec::new();
+        let mut column = 0;
+        while column < widths.len() {
+            spans.push(Span::styled(junction(row, column), separator));
+            if horizontal(row, column) {
+                spans.push(Span::styled("─".repeat(widths[column] + 2), separator));
+                column += 1;
+            } else {
+                let entry = &placed[owners[row][column]];
+                spans.extend(content(entry, boundaries[row]));
+                column += entry.cell.columns;
+            }
+        }
+        spans.push(Span::styled(junction(row, column), separator));
+        lines.push(spans.into());
+        if row == rows.len() {
+            break;
+        }
+        for y in 0..heights[row] {
+            let mut spans = vec![Span::styled("│", separator)];
+            let mut column = 0;
+            while column < widths.len() {
+                let entry = &placed[owners[row][column]];
+                spans.extend(content(entry, boundaries[row] + y + 1));
+                spans.push(Span::styled("│", separator));
+                column += entry.cell.columns;
+            }
+            lines.push(spans.into());
+        }
+    }
+    let mut columns = vec![0];
+    for width in widths {
+        columns.push(columns.last().unwrap() + width + 3);
+    }
+    let row_edges = boundaries
+        .into_iter()
+        .take(rows.len())
+        .enumerate()
+        .map(|(row, start)| {
+            let edges = columns
+                .iter()
+                .enumerate()
+                .filter(|(column, _)| vertical(row, *column))
+                .map(|(_, x)| *x)
+                .collect();
+            (start, edges)
+        })
+        .collect();
+    Table {
+        lines,
+        separator,
+        row_edges,
+    }
+}
+
+fn cell_line(cell: &Cell, width: usize, row: usize, height: usize) -> Vec<Span<'static>> {
+    let padding_top = height.saturating_sub(cell.lines.len()) / 2;
+    let line = row
+        .checked_sub(padding_top)
+        .and_then(|row| cell.lines.get(row))
+        .cloned()
+        .unwrap_or_default();
+    let mut line = crate::line_truncation::truncate_line_with_ellipsis_if_overflow(line, width);
+    let padding = width.saturating_sub(line.width());
+    let left = if cell.right { padding } else { padding / 2 };
+    line.spans.insert(0, Span::from(" ".repeat(left + 1)));
+    line.spans.push(Span::from(" ".repeat(padding - left + 1)));
+    for span in &mut line.spans {
+        span.style = cell.style.patch(line.style).patch(span.style);
+    }
+    line.spans
+}
+
+fn intensity_style(color: Color, level: usize) -> Style {
+    let color = if let Color::Rgb(red, green, blue) = color
+        && let Some(background) = default_bg()
+    {
+        let alpha = if level == 0 {
+            0.15
+        } else {
+            0.5 + level as f32 / 32.0
+        };
+        best_color(blend((red, green, blue), background, alpha))
+    } else {
+        color
+    };
+    let style = Style::default().fg(if level == 0 {
+        color
+    } else {
+        readable_color_on(color, None)
+    });
+    if level <= 5 {
+        style.dim()
+    } else if level >= 12 {
+        style.bold()
+    } else {
+        style
+    }
+}
