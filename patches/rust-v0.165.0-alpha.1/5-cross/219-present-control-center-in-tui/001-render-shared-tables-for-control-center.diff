+    pub(crate) fn render_lines(
+        content: Vec<Box<dyn Renderable>>,
+        width: u16,
+    ) -> Vec<Line<'static>> {
+        let height = content.iter().map(|item| item.desired_height(width)).sum();
+        let mut buffer = Buffer::empty(Rect::new(0, 0, width, height));
+        let mut y = 0;
+        for item in content {
+            let height = item.desired_height(width);
+            item.render(Rect::new(0, y, width, height), &mut buffer);
+            y += height;
+        }
+        buffer
+            .content
+            .chunks_exact(usize::from(width))
+            .map(|row| {
+                let mut spans: Vec<Span<'static>> = Vec::new();
+                let mut continuation = 0;
+                for cell in row {
+                    if continuation > 0 {
+                        continuation -= 1;
+                        continue;
+                    }
+                    continuation = cell.symbol().width().saturating_sub(1);
+                    let style = Style {
+                        fg: (cell.fg != Color::Reset).then_some(cell.fg),
+                        bg: (cell.bg != Color::Reset).then_some(cell.bg),
+                        ..cell.style()
+                    };
+                    if let Some(last) = spans.last_mut().filter(|last| last.style == style) {
+                        last.content.to_mut().push_str(cell.symbol());
+                    } else {
+                        spans.push(Span::styled(cell.symbol().to_owned(), style));
+                    }
+                }
+                while let Some(last) = spans.last_mut() {
+                    last.content = last.content.trim_end().to_owned().into();
+                    if !last.content.is_empty() {
+                        break;
+                    }
+                    spans.pop();
+                }
+                Line::from(spans)
+            })
+            .collect()
+    }
