+use crate::bottom_pane::BottomPaneView;
+use crate::bottom_pane::CancellationEvent;
+use crate::dialog::DialogFrame;
+use crate::motion::MotionMode;
+use crate::motion::ReducedMotionIndicator;
+use crate::motion::activity_indicator;
+use crate::render::renderable::Renderable;
+use codex_app_server_protocol::UsageBuildPhase;
+use codex_app_server_protocol::UsageBuildProgress;
+use ratatui::buffer::Buffer;
+use ratatui::layout::Constraint;
+use ratatui::layout::Layout;
+use ratatui::layout::Rect;
+use ratatui::style::Stylize;
+use ratatui::text::Line;
+use ratatui::widgets::Widget;
+use std::time::Duration;
+use std::time::Instant;
+use tokio::sync::watch;
+
+pub(crate) struct UsageBuildView {
+    started_at: Instant,
+    progress: watch::Receiver<Option<UsageBuildProgress>>,
+    motion: MotionMode,
+    hidden: bool,
+}
+
+impl UsageBuildView {
+    pub(crate) fn new(
+        started_at: Instant,
+        progress: watch::Receiver<Option<UsageBuildProgress>>,
+        motion: MotionMode,
+    ) -> Self {
+        Self {
+            started_at,
+            progress,
+            motion,
+            hidden: false,
+        }
+    }
+}
+
+impl Renderable for UsageBuildView {
+    fn desired_height(&self, _width: u16) -> u16 {
+        8
+    }
+
+    fn render(&self, area: Rect, buf: &mut Buffer) {
+        let frame = DialogFrame::new(area, 1);
+        frame.render(buf);
+        let [title, _, phase_area, files, elapsed] =
+            Layout::vertical([Constraint::Length(1); 5]).areas(frame.body_content());
+        let mut heading = Vec::new();
+        if let Some(indicator) = activity_indicator(
+            Some(self.started_at),
+            self.motion,
+            ReducedMotionIndicator::Hidden,
+        ) {
+            heading.extend([indicator, " ".into()]);
+        }
+        heading.push("Building usage".bold());
+        Line::from(heading).render(title, buf);
+        let progress = self.progress.borrow();
+        let phase = match progress.as_ref().map(|value| value.phase) {
+            None => "Waiting for server",
+            Some(UsageBuildPhase::Waiting) => "Waiting for shared build",
+            Some(UsageBuildPhase::Discovering) => "Discovering session files",
+            Some(UsageBuildPhase::Reading) => "Reading session files",
+            Some(UsageBuildPhase::Reconciling) => "Reconciling session history",
+            Some(UsageBuildPhase::Deduplicating) => "Deduplicating responses",
+            Some(UsageBuildPhase::Aggregating) => "Aggregating usage",
+            Some(UsageBuildPhase::Publishing) => "Publishing report",
+        };
+        Line::from(phase).render(phase_area, buf);
+        if let Some(progress) = progress.as_ref()
+            && let Some(total) = progress.files_total
+        {
+            let label = if progress.phase == UsageBuildPhase::Reading && total > 0 {
+                // Do not round unfinished files up to 100%.
+                let percent =
+                    (u128::from(progress.files_processed) * 100 / u128::from(total)).min(100);
+                format!("Files: {} / {total} ({percent}%)", progress.files_processed)
+            } else {
+                format!("Files: {} / {total}", progress.files_processed)
+            };
+            Line::from(label).render(files, buf);
+        }
+        Line::from(format!(
+            "Elapsed: {:.1}s",
+            self.started_at.elapsed().as_secs_f64()
+        ))
+        .render(elapsed, buf);
+        crate::footer_hint::shortcut("esc", "hide").render(frame.footer(), buf);
+    }
+}
+
+impl BottomPaneView for UsageBuildView {
+    fn is_complete(&self) -> bool {
+        self.hidden || self.progress.has_changed().is_err()
+    }
+
+    fn on_ctrl_c(&mut self) -> CancellationEvent {
+        self.hidden = true;
+        CancellationEvent::Handled
+    }
+
+    fn next_frame_delay(&self) -> Option<Duration> {
+        Some(Duration::from_millis(250))
+    }
+}
+
