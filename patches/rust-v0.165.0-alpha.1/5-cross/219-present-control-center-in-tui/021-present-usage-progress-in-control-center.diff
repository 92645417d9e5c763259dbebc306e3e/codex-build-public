+use super::*;
+use crate::bottom_pane::CenteredView;
+use crate::dialog::DialogStack;
+use crate::tui::FrameRequester;
+use crossterm::event::KeyCode;
+use pretty_assertions::assert_eq;
+
+fn text(view: &dyn Renderable) -> String {
+    let area = Rect::new(0, 0, 72, 14);
+    let mut buffer = Buffer::empty(area);
+    view.render(area, &mut buffer);
+    buffer.content.iter().map(|cell| cell.symbol()).collect()
+}
+
+#[test]
+fn file_progress_is_reading_only_and_unknown_totals_do_not_invent_a_percentage() {
+    let (updates, progress) = watch::channel(None);
+    let view = UsageBuildView::new(Instant::now(), progress, MotionMode::Reduced);
+    let waiting = text(&CenteredView(&view));
+    assert!(waiting.contains("Waiting for server"));
+    assert!(waiting.contains("Elapsed:") && waiting.contains("hide"));
+    assert!(!waiting.contains("Files:") && !waiting.contains('%'));
+    for (phase, processed, total, expected) in [
+        (UsageBuildPhase::Reading, 5, None, None),
+        (UsageBuildPhase::Reading, 0, Some(0), None),
+        (UsageBuildPhase::Reading, 0, Some(3), Some("0%")),
+        (UsageBuildPhase::Reading, 1, Some(3), Some("33%")),
+        (UsageBuildPhase::Reading, 26935, Some(26936), Some("99%")),
+        (UsageBuildPhase::Reading, 3, Some(3), Some("100%")),
+        (UsageBuildPhase::Aggregating, 3, Some(3), None),
+    ] {
+        updates.send_modify(|progress| {
+            *progress = Some(UsageBuildProgress {
+                phase,
+                files_processed: processed,
+                files_total: total,
+            })
+        });
+        let rendered = text(&CenteredView(&view));
+        if let Some(total) = total {
+            assert!(rendered.contains(&format!("Files: {processed} / {total}")));
+        } else {
+            assert!(!rendered.contains("Files:"));
+        }
+        if let Some(percent) = expected {
+            assert!(rendered.contains(percent), "{rendered}");
+        } else {
+            assert!(!rendered.contains('%'), "{rendered}");
+        }
+        assert!(!view.is_complete());
+    }
+    assert!(text(&CenteredView(&view)).contains("Aggregating usage"));
+    drop(updates);
+    assert!(view.is_complete());
+}
+
+#[test]
+fn progress_uses_plain_text_in_the_shared_body_and_a_separate_footer() {
+    for bg in [(0, 0, 0), (245, 245, 245)] {
+        crate::terminal_palette::with_test_default_colors(
+            crate::terminal_probe::DefaultColors {
+                fg: (128, 128, 128),
+                bg,
+            },
+            || {
+                let (_updates, progress) = watch::channel(Some(UsageBuildProgress {
+                    phase: UsageBuildPhase::Reading,
+                    files_processed: 26935,
+                    files_total: Some(26936),
+                }));
+                let view = UsageBuildView::new(Instant::now(), progress, MotionMode::Reduced);
+                for width in [40, 72] {
+                    let area = Rect::new(3, 2, width, view.desired_height(width));
+                    let mut buffer = Buffer::empty(Rect::new(0, 0, width + 6, area.bottom() + 2));
+                    for cell in &mut buffer.content {
+                        cell.set_bg(ratatui::style::Color::Blue);
+                    }
+                    view.render(area, &mut buffer);
+                    let panel = crate::style::user_message_style().bg.unwrap();
+                    let mut rows = Vec::new();
+                    for y in area.top()..area.bottom() {
+                        let expected = if y == area.bottom() - 1 {
+                            ratatui::style::Color::Reset
+                        } else {
+                            panel
+                        };
+                        let mut row = String::new();
+                        for x in area.left()..area.right() {
+                            let cell = &buffer[(x, y)];
+                            assert_eq!(cell.bg, expected);
+                            assert!(!cell.modifier.contains(ratatui::style::Modifier::REVERSED));
+                            row.push_str(cell.symbol());
+                        }
+                        rows.push(row);
+                    }
+                    assert!(
+                        rows.iter()
+                            .any(|row| row.trim() == "Files: 26935 / 26936 (99%)")
+                    );
+                    assert_eq!(rows.last().unwrap().trim(), "esc hide");
+                    assert!(rows.last().unwrap().starts_with("  esc"));
+                    assert!(rows[rows.len() - 2].trim().is_empty());
+                    assert_eq!(buffer[(0, 0)].bg, ratatui::style::Color::Blue);
+                }
+            },
+        );
+    }
+}
+
+#[test]
+fn hiding_keeps_observations_available_and_completion_uses_the_native_dialog_stack() {
+    let (updates, progress) = watch::channel(None);
+    let started_at = Instant::now();
+    let mut dialogs = DialogStack::new(FrameRequester::test_dummy());
+    dialogs.push(Box::new(UsageBuildView::new(
+        started_at,
+        progress,
+        MotionMode::Reduced,
+    )));
+    dialogs.handle_key_event(KeyCode::Esc.into(), None);
+    assert!(dialogs.is_empty());
+    updates.send_modify(|progress| {
+        *progress = Some(UsageBuildProgress {
+            phase: UsageBuildPhase::Reading,
+            files_processed: 2,
+            files_total: Some(4),
+        })
+    });
+    let view = UsageBuildView::new(started_at, updates.subscribe(), MotionMode::Reduced);
+    assert!(text(&CenteredView(&view)).contains("50%"));
+    for width in [0, 1, 7, 20, 72] {
+        for height in [0, 1, 4, 9] {
+            let area = Rect::new(0, 0, width, height);
+            let mut buffer = Buffer::empty(area);
+            CenteredView(&view).render(area, &mut buffer);
+            assert_eq!(buffer.area, area);
+        }
+    }
+    dialogs.push(Box::new(view));
+    drop(updates);
+    assert!(dialogs.pre_draw_tick(Instant::now()));
+    assert!(dialogs.is_empty());
+}
