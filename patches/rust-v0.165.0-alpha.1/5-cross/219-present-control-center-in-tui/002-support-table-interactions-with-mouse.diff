+//! Transient, right-aligned feedback shared by transcript and control-center copies.
+
+use super::CopyStatus;
+use super::worker::CopyResult;
+use crate::footer_hint::first_fitting_line;
+use ratatui::buffer::Buffer;
+use ratatui::layout::Rect;
+use ratatui::style::Stylize;
+use ratatui::text::Line;
+use ratatui::widgets::Widget;
+use std::time::Duration;
+use std::time::Instant;
+
+#[derive(Default)]
+pub(crate) struct CopyFeedback {
+    message: Option<CopyMessage>,
+}
+
+#[derive(Clone, Copy)]
+pub(crate) struct CopyMessage {
+    pub(crate) result: Result<CopyStatus, ()>,
+    pub(crate) characters: usize,
+    expires_at: Option<Instant>,
+}
+
+impl CopyFeedback {
+    pub(crate) fn show(&mut self, result: &CopyResult, characters: usize) {
+        if result == &Ok(CopyStatus::Busy)
+            && self
+                .message
+                .as_ref()
+                .is_some_and(|message| matches!(message.result, Ok(CopyStatus::Pending(_))))
+        {
+            return;
+        }
+        self.message = Some(CopyMessage {
+            result: result.as_ref().copied().map_err(|_| ()),
+            characters,
+            expires_at: (!matches!(result, Ok(CopyStatus::Pending(_))))
+                .then(|| Instant::now() + Duration::from_secs(5)),
+        });
+    }
+
+    pub(crate) fn finish(&mut self, completion: &(u64, CopyResult)) {
+        if let Some(message) = &self.message
+            && let Ok(CopyStatus::Pending(id)) = message.result
+        {
+            if id == completion.0 {
+                self.show(&completion.1, message.characters);
+            } else if id < completion.0 {
+                // A hidden view can miss its result when another surface starts a copy.
+                self.message = None;
+            }
+        }
+    }
+
+    pub(crate) fn is_visible(&self, now: Instant) -> bool {
+        self.message
+            .as_ref()
+            .is_some_and(|message| message.expires_at.is_none_or(|expiry| expiry > now))
+    }
+
+    pub(crate) fn snapshot(&mut self, now: Instant) -> Option<CopyMessage> {
+        if self
+            .message
+            .as_ref()
+            .is_some_and(|message| message.expires_at.is_some_and(|expiry| expiry <= now))
+        {
+            self.message = None;
+        }
+        self.message
+    }
+
+    pub(crate) fn render(
+        &mut self,
+        area: Rect,
+        buffer: &mut Buffer,
+        now: Instant,
+    ) -> Option<Duration> {
+        let message = self.snapshot(now)?;
+        if area.is_empty() {
+            return None;
+        }
+        let line = message.line(area.width.saturating_sub(1));
+        let width = line.width().min(usize::from(area.width)) as u16;
+        let target = Rect::new(
+            area.right().saturating_sub(width + 1).max(area.x),
+            area.y,
+            width,
+            1,
+        );
+        line.render(target, buffer);
+        message.expiry_delay(now)
+    }
+}
+
+impl CopyMessage {
+    pub(crate) fn expiry_delay(&self, now: Instant) -> Option<Duration> {
+        self.expires_at
+            .map(|expiry| expiry.saturating_duration_since(now))
+    }
+
+    pub(crate) fn line(&self, width: u16) -> Line<'static> {
+        let characters = self.characters;
+        let labels = match self.result {
+            Ok(CopyStatus::Confirmed) => [
+                format!("Copied {characters} chars to host clipboard"),
+                format!("Copied {characters} chars"),
+                "Copied".into(),
+            ],
+            Ok(CopyStatus::Pending(_)) => [
+                format!("Copying {characters} chars…"),
+                "Copying…".into(),
+                "Copying…".into(),
+            ],
+            Ok(CopyStatus::Busy) => [
+                "Copy already in progress".into(),
+                "Copy in progress".into(),
+                "Copy busy".into(),
+            ],
+            Ok(CopyStatus::Unconfirmed) => [
+                "Copy sent to terminal · paste to verify".into(),
+                "Copy sent · verify paste".into(),
+                "Copy unconfirmed".into(),
+            ],
+            Err(()) => [
+                "Copy failed · try again".into(),
+                "Copy failed".into(),
+                "Copy failed".into(),
+            ],
+        };
+        let line = first_fitting_line(labels.map(Line::from), width);
+        if self.result.is_err() {
+            line.red()
+        } else {
+            line.fg(crate::style::accent_color())
+        }
+    }
+}
