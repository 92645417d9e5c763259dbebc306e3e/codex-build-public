+    Scroll(isize),
+}
+
+pub(crate) struct TableInteraction {
+    pub(crate) cells: Vec<(Rect, Arc<str>)>,
+    pub(crate) column_offset: u16,
+    feedback: CopyFeedback,
+    frames: FrameRequester,
+    speed: f64,
+    pending_scroll: f64,
+}
+
+impl TableInteraction {
+    pub(crate) fn new(speed: f64, frames: FrameRequester) -> Self {
+        Self {
+            cells: Vec::new(),
+            column_offset: 0,
+            feedback: CopyFeedback::default(),
+            frames,
+            speed,
+            pending_scroll: 0.0,
+        }
+    }
+
+    pub(crate) fn horizontal_key(key: KeyEvent) -> bool {
+        key.kind != KeyEventKind::Release
+            && matches!(key.modifiers, KeyModifiers::CONTROL | KeyModifiers::SHIFT)
+            && matches!(key.code, KeyCode::Left | KeyCode::Right)
+    }
+
+    pub(crate) fn handle_horizontal(&mut self, key: KeyEvent) -> bool {
+        if !Self::horizontal_key(key) {
+            return false;
+        }
+        self.scroll_columns(key.code == KeyCode::Right);
+        true
+    }
+
+    pub(crate) fn scroll_columns(&mut self, right: bool) {
+        self.column_offset = if right {
+            self.column_offset.saturating_add(8)
+        } else {
+            self.column_offset.saturating_sub(8)
+        };
+    }
+
+    pub(crate) fn handle_mouse(
+        &mut self,
+        mouse: MouseEvent,
+        tui: &mut Tui,
+    ) -> Option<TableMouseAction> {
+        let direction = match mouse.kind {
+            MouseEventKind::ScrollUp => -1.0,
+            MouseEventKind::ScrollDown => 1.0,
+            MouseEventKind::Down(MouseButton::Left) if mouse.modifiers.is_empty() => {
+                let (_, text) = self
+                    .cells
+                    .iter()
+                    .find(|(area, _)| area.contains((mouse.column, mouse.row).into()))?;
+                let characters = text.chars().count();
+                let result = tui.clipboard.copy(
+                    Arc::clone(text),
+                    CopyFormat::PlainText,
+                    self.frames.clone(),
+                );
+                self.feedback.show(&result, characters);
+                self.frames.schedule_frame();
+                return Some(TableMouseAction::Copy);
+            }
+            _ => return None,
+        };
+        Some(TableMouseAction::Scroll(self.scroll_rows(direction)))
+    }
+
+    pub(crate) fn scroll_rows(&mut self, direction: f64) -> isize {
+        if self.pending_scroll.signum() != direction {
+            self.pending_scroll = 0.0;
+        }
+        self.pending_scroll += direction * self.speed;
+        // Match native transcript scrolling, including accumulated decimal speeds.
+        let rounded = self.pending_scroll.round();
+        if rounded != 0.0 && (self.pending_scroll - rounded).abs() < 1e-9 {
+            self.pending_scroll = rounded;
+        }
+        let rows = self.pending_scroll as isize;
+        self.pending_scroll = self.pending_scroll.fract();
+        rows
+    }
+
+    pub(crate) fn reset_scroll(&mut self) {
+        self.pending_scroll = 0.0;
+    }
+
+    pub(crate) fn finish_copy(&mut self, completion: &(u64, CopyResult)) {
+        self.feedback.finish(completion);
+    }
+
+    pub(crate) fn render_feedback(&mut self, area: Rect, buffer: &mut Buffer, now: Instant) {
+        if self.feedback.is_visible(now) {
+            Clear.render(area, buffer);
+        }
+        if let Some(delay) = self.feedback.render(area, buffer, now) {
+            self.frames.schedule_frame_in(delay);
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn horizontal_keys_leave_plain_arrows_and_key_release_to_the_page() {
+        let mut interaction = TableInteraction::new(1.0, FrameRequester::test_dummy());
+        for modifiers in [KeyModifiers::CONTROL, KeyModifiers::SHIFT] {
+            assert!(interaction.handle_horizontal(KeyEvent::new(KeyCode::Right, modifiers)));
+            assert_eq!(interaction.column_offset, 8);
+            assert!(interaction.handle_horizontal(KeyEvent::new(KeyCode::Left, modifiers)));
+            assert_eq!(interaction.column_offset, 0);
+            assert!(interaction.handle_horizontal(KeyEvent::new(KeyCode::Left, modifiers)));
+            assert_eq!(interaction.column_offset, 0);
+            assert!(!interaction.handle_horizontal(KeyEvent::new_with_kind(
+                KeyCode::Right,
+                modifiers,
+                KeyEventKind::Release,
+            )));
+        }
+        for modifiers in [
+            KeyModifiers::NONE,
+            KeyModifiers::ALT,
+            KeyModifiers::CONTROL | KeyModifiers::SHIFT,
+        ] {
+            assert!(!interaction.handle_horizontal(KeyEvent::new(KeyCode::Right, modifiers)));
+        }
+        assert_eq!(interaction.column_offset, 0);
+    }
+
+    #[test]
+    fn wheel_accumulates_fractional_rows_and_discards_reversed_or_reset_remainders() {
+        for (speed, steps, rows) in [(0.1, 10, 1), (0.5, 2, 1), (1.5, 2, 3), (3.0, 2, 6)] {
+            let mut mouse = TableInteraction::new(speed, FrameRequester::test_dummy());
+            assert_eq!(
+                (0..steps).map(|_| mouse.scroll_rows(1.0)).sum::<isize>(),
+                rows
+            );
+            assert_eq!(
+                (0..steps).map(|_| mouse.scroll_rows(-1.0)).sum::<isize>(),
+                -rows
+            );
+        }
+        let mut mouse = TableInteraction::new(0.5, FrameRequester::test_dummy());
+        assert_eq!(mouse.scroll_rows(1.0), 0);
+        assert_eq!(mouse.scroll_rows(-1.0), 0);
+        assert_eq!(mouse.scroll_rows(-1.0), -1);
+        assert_eq!(mouse.scroll_rows(1.0), 0);
+        mouse.reset_scroll();
+        assert_eq!(mouse.scroll_rows(1.0), 0);
+        assert_eq!(mouse.scroll_rows(1.0), 1);
+    }
+}
