+use super::*;
+use crate::response_timing::tests::attempt;
+use crate::style::readable_color_on;
+use chrono::TimeZone;
+use pretty_assertions::assert_eq;
+use ratatui::style::Color;
+use ratatui::style::Modifier;
+use ratatui::text::Line;
+use serde_json::json;
+
+fn prices() -> Prices {
+    serde_json::from_value(json!({"served": {
+        "0": {"input": 2.0, "cache_read": 1.0, "cache_write": 3.0, "output": 4.0},
+        "1000": {"input": 4.0, "cache_read": 2.0, "cache_write": 6.0, "output": 8.0}
+    }}))
+    .unwrap()
+}
+
+fn buffer_text(buffer: &Buffer) -> String {
+    buffer.content.iter().map(|cell| cell.symbol()).collect()
+}
+
+fn value(table: &ResponseTable, row: usize, column: ResponseColumn) -> String {
+    table.rows[row][ResponseColumn::ALL
+        .iter()
+        .position(|candidate| *candidate == column)
+        .unwrap()]
+    .lines[0]
+        .to_string()
+}
+
+fn make_table(
+    attempts: &[&ObservedResponse],
+    prices: Option<&Prices>,
+    now: Instant,
+) -> ResponseTable {
+    ResponseTable::new(attempts, prices, &ModelCatalog::new(Vec::new()), now)
+}
+
+fn paint(table: ResponseTable, visible: Range<usize>, width: u16, offset: u16) -> Buffer {
+    let area = Rect::new(
+        0,
+        0,
+        width,
+        (HEADER_HEIGHT + visible.len() * ROW_HEIGHT) as u16,
+    );
+    let mut buffer = Buffer::empty(area);
+    table.render(visible, area, &mut buffer, offset);
+    buffer
+}
+
+fn row_text(buffer: &Buffer, y: u16) -> String {
+    (0..buffer.area.width)
+        .map(|x| buffer[(x, y)].symbol())
+        .collect()
+}
+
+fn assert_header_padding(buffer: &Buffer) {
+    let lines = (0..HEADER_HEIGHT as u16)
+        .map(|row| Line::from(row_text(buffer, row)))
+        .collect::<Vec<_>>();
+    crate::control_center_table::tests::assert_symmetric_headers(&lines);
+}
+
+#[test]
+fn table_preserves_billing_units_unknowns_and_attempt_identity() {
+    let now = Instant::now();
+    let mut row = attempt(7, Some(ResponseAttemptEnd::Completed));
+    row.started_at = chrono::Local
+        .with_ymd_and_hms(2026, 10, 20, 9, 8, 7)
+        .single()
+        .unwrap()
+        .timestamp();
+    row.served_model = Some("served".into());
+    row.sent_payload_bytes = Some(2048);
+    row.response_id = Some("resp_official".into());
+    row.turn_id = Some("original-turn-id".into());
+    let session = row.thread_id.unwrap().to_string();
+    let attempt_id = row.attempt_id.to_string();
+    let mut observed = ObservedResponse::new(row, false, now);
+    let prices = prices();
+    let table = make_table(&[&observed], Some(&prices), now);
+    assert_eq!(table.max_offset(250), 0);
+    assert_eq!(
+        value(&table, 0, ResponseColumn::StartedAt),
+        "2026-10-20 09:08:07"
+    );
+    assert_eq!(value(&table, 0, ResponseColumn::Model), "gpt-5.4");
+    assert_eq!(value(&table, 0, ResponseColumn::ServedModel), "served");
+    assert_eq!(
+        [
+            ResponseColumn::Input,
+            ResponseColumn::Read,
+            ResponseColumn::Write,
+            ResponseColumn::Output,
+            ResponseColumn::Reasoning,
+            ResponseColumn::Hit,
+            ResponseColumn::Tps,
+            ResponseColumn::Cost
+        ]
+        .map(|column| value(&table, 0, column)),
+        [
+            "500", "400", "100", "100", "50", "40.00%", "50.0", "$0.0042"
+        ]
+    );
+    assert_eq!(value(&table, 0, ResponseColumn::Received), "0.5 KiB");
+    assert_eq!(value(&table, 0, ResponseColumn::Sent), "2.0 KiB");
+    assert_eq!(value(&table, 0, ResponseColumn::AttemptId), attempt_id);
+    let displayed = table.rows[0]
+        .iter()
+        .flat_map(|cell| &cell.lines)
+        .map(ToString::to_string)
+        .collect::<Vec<_>>()
+        .join("\n");
+    assert!(!displayed.contains("resp_official"));
+    assert!(!displayed.contains("original-turn-id"));
+    assert!(!displayed.contains(&session));
+    assert_eq!(value(&table, 0, ResponseColumn::Status), "Done");
+    assert_eq!(value(&table, 0, ResponseColumn::Duration), "2.10s");
+    observed.row.tokens.cache_write = None;
+    observed.row.response_id = None;
+    observed.row.turn_id = None;
+    observed.row.thread_id = None;
+    observed.row.ttfb_ms = None;
+    observed.row.ttfc_ms = None;
+    observed.row.tps = None;
+    let unknown = make_table(&[&observed], Some(&prices), now);
+    assert_eq!(value(&unknown, 0, ResponseColumn::Write), "--");
+    assert_eq!(value(&unknown, 0, ResponseColumn::Input), "--");
+    assert_eq!(value(&unknown, 0, ResponseColumn::Cost), "--");
+    assert_eq!(value(&unknown, 0, ResponseColumn::AttemptId), attempt_id);
+    assert_eq!(value(&unknown, 0, ResponseColumn::Ttfb), "--");
+    assert_eq!(value(&unknown, 0, ResponseColumn::Ttfc), "--");
+    assert_eq!(value(&unknown, 0, ResponseColumn::Tps), "--");
+    observed.row.tokens.cache_write = Some(0);
+    observed.row.tokens.input = Some(0);
+    observed.row.tokens.cache_read = Some(0);
+    observed.row.tokens.output = Some(0);
+    observed.row.ttfb_ms = Some(0);
+    observed.row.ttfc_ms = Some(0);
+    observed.row.tps = Some(0.0);
+    let zero = make_table(&[&observed], Some(&prices), now);
+    assert_eq!(value(&zero, 0, ResponseColumn::Input), "0");
+    assert_eq!(value(&zero, 0, ResponseColumn::Write), "0");
+    assert_eq!(value(&zero, 0, ResponseColumn::Hit), "--");
+    assert_eq!(value(&zero, 0, ResponseColumn::Cost), "$0.0000");
