+fn assert_themed_rows() -> Color {
+    let palette = Palette::current();
+    let now = Instant::now();
+    let working = ObservedResponse::new(attempt(1, None), true, now);
+    let mut completed =
+        ObservedResponse::new(attempt(2, Some(ResponseAttemptEnd::Completed)), false, now);
+    completed.row.requested_model = "gpt-5.5".into();
+    completed.row.served_model = Some(completed.row.requested_model.clone());
+    let failed = ObservedResponse::new(attempt(3, Some(ResponseAttemptEnd::Failed)), false, now);
+    let table = make_table(&[&working, &completed, &failed], None, now);
+    let buffer = paint(table, 0..3, 80, 0);
+    assert_eq!(buffer[(0, 5)].bg, buffer[(0, 7)].bg);
+    assert_eq!(buffer[(0, 7)].bg, buffer[(0, 9)].bg);
+    for y in [5, 7, 9] {
+        for x in 0..80 {
+            let cell = &buffer[(x, y)];
+            assert_eq!(cell.modifier.contains(Modifier::ITALIC), y == 9);
+        }
+    }
+    let table = make_table(&[&working, &completed, &failed], None, now);
+    let offset = table.max_offset(80);
+    let scrolled = paint(table, 2..3, 80, offset);
+    assert!((0..80).all(|x| scrolled[(x, 5)].modifier.contains(Modifier::ITALIC)));
+    assert!(!scrolled[(0, 5)].modifier.contains(Modifier::REVERSED));
+    assert!(scrolled.content.iter().all(|cell| cell.bg == Color::Reset));
+    let numeric = make_table(&[&completed], None, now);
+    let input_column = ResponseColumn::ALL
+        .iter()
+        .position(|column| *column == ResponseColumn::Input)
+        .unwrap();
+    let offset = numeric.widths[..input_column]
+        .iter()
+        .map(|width| width + 3)
+        .sum::<usize>() as u16;
+    let input_width = numeric.widths[input_column];
+    let x = (input_width + 1) as u16;
+    let numeric_buffer = paint(numeric, 0..1, 80, offset);
+    assert_eq!(numeric_buffer[(x, 5)].fg, palette.intensity(16).fg.unwrap());
+    let x = 2 + (input_width - "Input".len()) as u16 / 2;
+    assert_eq!(
+        numeric_buffer[(x, 3)].fg,
+        readable_color_on(crate::style::accent_style().fg.unwrap(), None)
+    );
+    let table = make_table(&[&working, &completed, &failed], None, now);
+    let widths = table.widths.clone();
+    let width = table.max_offset(0);
+    let categorical = paint(table, 0..3, width, 0);
+    assert_ne!(palette.model(0).fg, palette.model(1).fg);
+    for (row, column, expected) in [
+        (0, ResponseColumn::Model, palette.model(0)),
+        (1, ResponseColumn::Model, palette.model(1)),
+        (1, ResponseColumn::ServedModel, palette.model(1)),
+        (0, ResponseColumn::Effort, palette.effort),
+        (0, ResponseColumn::Status, palette.attention),
+        (1, ResponseColumn::Status, palette.success),
+        (2, ResponseColumn::Status, palette.failure),
+    ] {
+        let index = ResponseColumn::ALL
+            .iter()
+            .position(|item| *item == column)
+            .unwrap();
+        let start = widths[..index].iter().map(|width| width + 3).sum::<usize>() as u16 + 1;
+        let y = (HEADER_HEIGHT + row * ROW_HEIGHT) as u16;
+        let x = (start..start + widths[index] as u16 + 2)
+            .find(|x| categorical[(*x, y)].symbol() != " ")
+            .unwrap();
+        assert_eq!(categorical[(x, y)].fg, expected.fg.unwrap());
+    }
+    numeric_buffer[(input_width as u16 + 1, 5)].fg
+}
