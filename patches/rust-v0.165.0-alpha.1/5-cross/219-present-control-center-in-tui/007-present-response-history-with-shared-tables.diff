+#[test]
+fn column_shades_recalculate_with_loaded_rows_and_live_time() {
+    let palette = Palette::current();
+    let now = Instant::now();
+    let mut first =
+        ObservedResponse::new(attempt(1, Some(ResponseAttemptEnd::Completed)), false, now);
+    first.row.tokens.input = Some(120);
+    first.row.tokens.cache_read = Some(20);
+    first.row.tokens.cache_write = Some(0);
+    let mut second =
+        ObservedResponse::new(attempt(2, Some(ResponseAttemptEnd::Completed)), false, now);
+    second.row.tokens.input = Some(210);
+    second.row.tokens.cache_read = Some(10);
+    second.row.tokens.cache_write = Some(0);
+    let mut third =
+        ObservedResponse::new(attempt(3, Some(ResponseAttemptEnd::Completed)), false, now);
+    third.row.tokens.input = Some(340);
+    third.row.tokens.cache_read = Some(40);
+    third.row.tokens.cache_write = Some(0);
+    third.row.elapsed_ms = 3100;
+    let working = ObservedResponse::new(attempt(5, None), true, now);
+    let columns = [
+        ResponseColumn::Input,
+        ResponseColumn::Read,
+        ResponseColumn::Duration,
+    ];
+    let indexes = columns.map(|column| {
+        ResponseColumn::ALL
+            .iter()
+            .position(|candidate| *candidate == column)
+            .unwrap()
+    });
+    let table = make_table(&[&first, &second, &third, &working], None, now);
+    for (row, levels) in [[1, 8, 1], [8, 1, 1], [16, 16, 16]].into_iter().enumerate() {
+        for (column, level) in levels.into_iter().enumerate() {
+            assert_eq!(
+                table.rows[row][indexes[column]].style,
+                palette.intensity(level)
+            );
+        }
+    }
+    assert_eq!(table.rows[3][indexes[0]].style.fg, None);
+    assert_eq!(table.rows[3][indexes[2]].style, palette.intensity(1));
+    let mut fourth =
+        ObservedResponse::new(attempt(4, Some(ResponseAttemptEnd::Completed)), false, now);
+    fourth.row.tokens.input = Some(1400);
+    fourth.row.tokens.cache_write = Some(0);
+    let later = now + std::time::Duration::from_secs(2);
+    let updated = make_table(&[&first, &second, &third, &fourth, &working], None, later);
+    assert_eq!(updated.rows[1][indexes[0]].style, palette.intensity(6));
+    assert_eq!(updated.rows[4][indexes[2]].style, palette.intensity(16));
+    assert_eq!(updated.rows[2][indexes[2]].style, palette.intensity(8));
+    let filtered = make_table(&[&second, &third], None, later);
+    assert_eq!(filtered.rows[0][indexes[0]].style, palette.intensity(1));
+    assert_eq!(filtered.rows[1][indexes[0]].style, palette.intensity(16));
+}
