+#[test]
+fn column_bounds_and_status_widths_hold_across_lifecycle_pages_and_filters() {
+    let now = Instant::now();
+    let empty = make_table(&[], None, now);
+    let minimum_width = empty.max_offset(0);
+    assert!(minimum_width <= 250);
+    assert_header_padding(&paint(make_table(&[], None, now), 0..0, minimum_width, 0));
+    let minimum_columns = empty.widths;
+    let maximum_width = ResponseColumn::ALL
+        .iter()
+        .map(|column| column.layout().maximum() + 3)
+        .sum::<usize>()
+        + 1;
+    let mut rows = vec![ObservedResponse::new(attempt(1, None), true, now)];
+    let mut received = attempt(2, None);
+    received.terminal_observed_offset_ms = Some(1000);
+    rows.push(ObservedResponse::new(received, true, now));
+    rows.push(ObservedResponse::new(attempt(3, None), false, now));
+    for (index, end) in [
+        ResponseAttemptEnd::Completed,
+        ResponseAttemptEnd::Incomplete,
+        ResponseAttemptEnd::Failed,
+        ResponseAttemptEnd::Interrupted,
+        ResponseAttemptEnd::Canceled,
+        ResponseAttemptEnd::SetupFailed,
+        ResponseAttemptEnd::SendFailed,
+        ResponseAttemptEnd::TransportClosed,
+        ResponseAttemptEnd::ProgressTimeout,
+        ResponseAttemptEnd::ProtocolError,
+    ]
+    .into_iter()
+    .enumerate()
+    {
+        let mut row = attempt(index as u64 + 4, Some(end));
+        row.requested_model = "long-model-".repeat(20);
+        row.served_model = Some("long-served-model-".repeat(20));
+        row.response_id = Some("resp_".repeat(30));
+        row.turn_id = Some("long-turn-".repeat(20));
+        row.reasoning_effort = Some("very-long-effort".into());
+        row.elapsed_ms = u64::MAX;
+        row.ttfb_ms = Some(u64::MAX);
+        row.ttfc_ms = Some(u64::MAX);
+        row.received_payload_bytes = u64::MAX;
+        row.sent_payload_bytes = Some(u64::MAX);
+        row.tokens.input = Some(u64::MAX);
+        row.tokens.cache_read = Some(0);
+        row.tokens.cache_write = Some(0);
+        row.tokens.output = Some(u64::MAX);
+        row.tokens.reasoning = Some(u64::MAX);
+        row.tps = Some(1e20);
+        rows.push(ObservedResponse::new(row, false, now));
+    }
+    let prices = prices();
+    for loaded in 1..=rows.len() {
+        for filtered in [false, true] {
+            let matching = if filtered {
+                &rows[loaded - 1..loaded]
+            } else {
+                &rows[..loaded]
+            };
+            let matching = matching.iter().collect::<Vec<_>>();
+            let later = now + std::time::Duration::from_secs(1000);
+            for row in 0..matching.len() {
+                let table = make_table(&matching, Some(&prices), later);
+                let status = value(&table, row, ResponseColumn::Status);
+                assert!(status.as_bytes()[0].is_ascii_uppercase());
+                let width = table.max_offset(0);
+                assert!(width >= minimum_width && usize::from(width) <= maximum_width);
+                assert_eq!(table.max_offset(37), width - 37);
+                let widths = table.widths.clone();
+                for ((column, width), minimum) in ResponseColumn::ALL
+                    .iter()
+                    .zip(&widths)
+                    .zip(&minimum_columns)
+                {
+                    assert!(width >= minimum && *width <= column.layout().maximum());
+                    if matches!(
+                        column,
+                        ResponseColumn::StartedAt
+                            | ResponseColumn::AttemptId
+                            | ResponseColumn::Status
+                            | ResponseColumn::Effort
+                    ) {
+                        assert_eq!(width, minimum, "{column:?}: {status}");
+                    }
+                }
+                let body = paint(table, row..row + 1, width, 0);
+                assert_header_padding(&body);
+                let attempt_x = widths[0] as u16 + 5;
+                assert_eq!(
+                    body[(attempt_x, 5)].fg == Color::Red,
+                    matching[row]
+                        .row
+                        .end_reason
+                        .is_some_and(|end| end != ResponseAttemptEnd::Completed)
+                );
+                let mut edge = 0;
+                for cell_width in widths {
+                    assert_eq!(body[(edge, 5)].symbol(), "│");
+                    edge += cell_width as u16 + 3;
+                }
+                assert_eq!(edge + 1, width);
+                assert_eq!(body[(edge, 5)].symbol(), "│");
+                for offset in [0, 8, width - 37] {
+                    let scrolled = paint(
+                        make_table(&matching, Some(&prices), later),
+                        row..row + 1,
+                        37,
+                        offset,
+                    );
+                    for y in 0..scrolled.area.height {
+                        for x in 0..37 {
+                            assert_eq!(scrolled[(x, y)], body[(x + offset, y)]);
+                        }
+                    }
+                }
+            }
+        }
+    }
+}
