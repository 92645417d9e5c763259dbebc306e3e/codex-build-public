+//! Fixed response columns in the shared merged-cell control-center table.
+
+use crate::control_center_table::Cell;
+use crate::control_center_table::Column;
+use crate::control_center_table::Palette;
+use crate::control_center_table::center_left_column;
+use crate::control_center_table::render;
+use crate::control_center_table::shade_columns;
+use crate::control_center_table::widths;
+use crate::line_truncation::truncate_line_with_ellipsis_if_overflow;
+use crate::model_catalog::ModelCatalog;
+use crate::response_timing::ObservedResponse;
+use crate::response_timing::seconds;
+use crate::response_timing::tps;
+use codex_models_manager::model_pricing::Prices;
+use codex_protocol::response_metrics::ResponseAttempt;
+use codex_protocol::response_metrics::ResponseAttemptEnd;
+use codex_protocol::response_metrics::ResponseAttemptStatus;
+use itertools::Itertools;
+use ratatui::buffer::Buffer;
+use ratatui::layout::Rect;
+use ratatui::style::Style;
+use std::ops::Range;
+use std::sync::Arc;
+use std::time::Instant;
+
+pub(crate) const HEADER_HEIGHT: usize = 5;
+pub(crate) const ROW_HEIGHT: usize = 2;
+const STARTED_AT_FORMAT: &str = "%Y-%m-%d %H:%M:%S";
+
+pub(crate) const STATUSES: [ResponseAttemptStatus; 13] = [
+    ResponseAttemptStatus::Working,
+    ResponseAttemptStatus::Received,
+    ResponseAttemptStatus::Unfinished,
+    ResponseAttemptStatus::Completed,
+    ResponseAttemptStatus::Incomplete,
+    ResponseAttemptStatus::Failed,
+    ResponseAttemptStatus::Interrupted,
+    ResponseAttemptStatus::Canceled,
+    ResponseAttemptStatus::SetupFailed,
+    ResponseAttemptStatus::SendFailed,
+    ResponseAttemptStatus::TransportClosed,
+    ResponseAttemptStatus::ProgressTimeout,
+    ResponseAttemptStatus::ProtocolError,
+];
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+enum ResponseColumn {
+    StartedAt,
+    Model,
+    ServedModel,
+    Duration,
+    Received,
+    Input,
+    Read,
+    Write,
+    Output,
+    Reasoning,
+    Hit,
+    Tps,
+    Cost,
+    Ttfb,
+    Ttfc,
+    Effort,
+    Status,
+    AttemptId,
+    Sent,
+}
+
+impl ResponseColumn {
+    const ALL: &[Self] = &[
+        Self::StartedAt,
+        Self::AttemptId,
+        Self::Model,
+        Self::ServedModel,
+        Self::Effort,
+        Self::Status,
+        Self::Duration,
+        Self::Sent,
+        Self::Received,
+        Self::Input,
+        Self::Write,
+        Self::Read,
+        Self::Output,
+        Self::Reasoning,
+        Self::Hit,
+        Self::Tps,
+        Self::Ttfb,
+        Self::Ttfc,
+        Self::Cost,
+    ];
+
+    fn label(self) -> &'static str {
+        match self {
+            Self::StartedAt => "Start time",
+            Self::AttemptId => "Attempt ID",
+            Self::Model => "Requested",
+            Self::ServedModel => "Served",
+            Self::Effort => "Effort",
+            Self::Status => "Status",
+            Self::Duration => "Duration",
+            Self::Sent => "Sent",
+            Self::Received => "Received",
+            Self::Input => "Input",
+            Self::Write => "Write",
+            Self::Read => "Read",
+            Self::Output => "Output",
+            Self::Reasoning => "Reasoning",
+            Self::Hit => "Hit",
+            Self::Tps => "TPS",
+            Self::Ttfb => "TTFB",
+            Self::Ttfc => "TTFC",
+            Self::Cost => "Cost",
+        }
+    }
+
+    /// Bound long labels and exceptional numeric values with the native ellipsis.
+    fn max_width(self) -> usize {
+        match self {
+            Self::StartedAt => 19,
+            Self::Model | Self::ServedModel => 30,
+            Self::Status => STATUSES
+                .into_iter()
+                .map(status_label)
+                .map(str::len)
+                .max()
+                .expect("response statuses"),
+            Self::AttemptId => 36,
+            Self::Effort => 8,
+            Self::Hit => 7,
+            Self::Duration | Self::Ttfb | Self::Ttfc | Self::Tps => 12,
+            Self::Received | Self::Sent | Self::Cost => 16,
+            Self::Input | Self::Read | Self::Write | Self::Output | Self::Reasoning => 10,
+        }
+    }
+
+    fn layout(self) -> Column {
+        let minimum = match self {
+            Self::Model | Self::ServedModel => 12,
+            Self::StartedAt | Self::AttemptId | Self::Status | Self::Effort => self.max_width(),
+            Self::Duration | Self::Ttfb | Self::Ttfc => seconds(0).len(),
+            Self::Received | Self::Sent => payload_size(0).len(),
+            Self::Input | Self::Read | Self::Write | Self::Output | Self::Reasoning => {
+                "0.00K".len()
+            }
+            Self::Hit => "100.00%".len(),
+            Self::Tps => tps(0.0).len(),
+            Self::Cost => "$0.0000".len(),
+        };
+        Column::new(self.label(), minimum, self.max_width())
+    }
+}
+
+/// Format-sized numeric columns, content-sized labels, and shades over all matching rows.
+pub(crate) struct ResponseTable {
+    rows: Vec<Vec<Cell>>,
+    failed: Vec<bool>,
+    widths: Vec<usize>,
+    palette: Palette,
+}
+
+impl ResponseTable {
+    pub(crate) fn new(
+        attempts: &[&ObservedResponse],
+        prices: Option<&Prices>,
+        catalog: &ModelCatalog,
+        now: Instant,
+    ) -> Self {
+        let palette = Palette::current();
+        let failed = attempts
+            .iter()
+            .map(|attempt| is_failed(&attempt.row))
+            .collect();
+        // Catalog order keeps configured model colors steady across pages and filters.
+        let models = catalog
+            .models
+            .iter()
+            .map(|model| model.model.as_str())
+            .chain(
+                attempts
+                    .iter()
+                    .map(|attempt| attempt.row.requested_model.as_str()),
+            )
+            .unique()
+            .collect::<Vec<_>>();
+        let mut rows = attempts
+            .iter()
+            .map(|attempt| {
+                let model_style = palette.model(
+                    models
+                        .iter()
+                        .position(|model| *model == attempt.row.requested_model)
+                        .expect("every requested model is included"),
+                );
+                ResponseColumn::ALL
+                    .iter()
+                    .map(|column| {
+                        cell(
+                            *column,
+                            attempt,
+                            prices,
+                            catalog,
+                            &palette,
+                            model_style,
+                            now,
+                        )
+                    })
+                    .collect()
+            })
+            .collect::<Vec<Vec<Cell>>>();
+        shade_columns(&mut rows, &palette);
+        let columns = ResponseColumn::ALL
+            .iter()
+            .map(|column| column.layout())
+            .collect::<Vec<_>>();
+        let widths = widths(u16::MAX, &columns, &rows);
+        center_left_column(&mut rows, 2, widths[2]);
+        center_left_column(&mut rows, 3, widths[3]);
+        Self {
+            rows,
+            failed,
+            widths,
+            palette,
+        }
+    }
+
+    pub(crate) fn max_offset(&self, width: u16) -> u16 {
+        self.widths
+            .iter()
+            .sum::<usize>()
+            .saturating_add(3 * self.widths.len() + 1)
+            .saturating_sub(usize::from(width))
+            .try_into()
+            .unwrap_or(u16::MAX)
+    }
+
+    pub(crate) fn render(
+        self,
+        visible: Range<usize>,
+        area: Rect,
+        buffer: &mut Buffer,
+        offset: u16,
+    ) -> Vec<(Rect, Arc<str>)> {
+        let mut rows = headers(&self.palette);
+        rows.extend(
+            self.rows
+                .into_iter()
+                .skip(visible.start)
+                .take(visible.len()),
+        );
+        let table = render(&self.widths, &rows, &self.palette);
+        table.render_viewport(area, buffer, 0, offset);
+        for (position, failed) in self
+            .failed
+            .iter()
+            .skip(visible.start)
+            .take(visible.len())
+            .enumerate()
+        {
+            let row_y = HEADER_HEIGHT + position * ROW_HEIGHT;
+            // The viewport replaces a cut-off last content row with a border.
+            if row_y + 1 >= usize::from(area.height) {
+                break;
+            }
+            let y = area.y + row_y as u16;
+            if *failed {
+                // Include padding and separators in the failed row's treatment.
+                buffer.set_style(
+                    Rect::new(area.x, y, area.width, 1),
+                    Style::default().italic(),
+                );
+            }
+        }
+        table.visible_cells(area, 0, offset)
+    }
+}
+
+fn headers(palette: &Palette) -> Vec<Vec<Cell>> {
+    let mut groups = Vec::new();
+    let mut leaves = Vec::new();
+    for column in ResponseColumn::ALL {
+        match column {
+            ResponseColumn::Model => groups.push(palette.header("Models").spanning(1, 2)),
+            ResponseColumn::Sent => groups.push(palette.header("Bytes").spanning(1, 2)),
+            ResponseColumn::Input => groups.push(palette.header("Token usage").spanning(1, 5)),
+            ResponseColumn::ServedModel
+            | ResponseColumn::Received
+            | ResponseColumn::Write
+            | ResponseColumn::Read
+            | ResponseColumn::Output
+            | ResponseColumn::Reasoning => {}
+            _ => groups.push(palette.header(column.label()).spanning(2, 1)),
+        }
+        if matches!(
+            column,
+            ResponseColumn::Model
+                | ResponseColumn::ServedModel
+                | ResponseColumn::Sent
+                | ResponseColumn::Received
+                | ResponseColumn::Input
+                | ResponseColumn::Write
+                | ResponseColumn::Read
+                | ResponseColumn::Output
+                | ResponseColumn::Reasoning
+        ) {
+            leaves.push(palette.header(column.label()));
+        }
+    }
+    vec![groups, leaves]
+}
+
+fn cell(
+    column: ResponseColumn,
+    attempt: &ObservedResponse,
+    prices: Option<&Prices>,
+    catalog: &ModelCatalog,
+    palette: &Palette,
+    model_style: Style,
+    now: Instant,
+) -> Cell {
+    let row = &attempt.row;
+    match column {
+        ResponseColumn::StartedAt => text(
+            chrono::DateTime::from_timestamp(row.started_at, 0)
+                .map(|time| {
+                    time.with_timezone(&chrono::Local)
+                        .format(STARTED_AT_FORMAT)
+                        .to_string()
+                })
+                .unwrap_or_else(|| "--".into()),
+        ),
+        ResponseColumn::Model => {
+            let mut cell = text(catalog.display_name(&row.requested_model));
+            cell.style = model_style;
+            if row
+                .served_model
+                .as_ref()
+                .is_some_and(|model| model != &row.requested_model)
+            {
+                cell.style = cell.style.red();
+            }
+            cell
+        }
+        ResponseColumn::ServedModel => {
+            let mut cell = optional(
+                row.served_model
+                    .as_deref()
+                    .map(|model| catalog.display_name(model)),
+            );
+            if let Some(model) = &row.served_model {
+                let width = text(catalog.display_name(&row.requested_model)).lines[0]
+                    .width()
+                    .min(ResponseColumn::Model.layout().maximum());
+                cell.lines = cell
+                    .lines
+                    .into_iter()
+                    .map(|line| truncate_line_with_ellipsis_if_overflow(line, width))
+                    .collect();
+                cell.style = if model == &row.requested_model {
+                    model_style
+                } else {
+                    model_style.red()
+                };
+            }
+            cell
+        }
+        ResponseColumn::Status => {
+            let (label, style) = state(attempt, palette);
+            Cell {
+                style,
+                ..text(label)
+            }
+        }
+        ResponseColumn::Duration => duration(Some(attempt.elapsed_ms(now))),
+        ResponseColumn::Received => bytes(Some(row.received_payload_bytes)),
+        ResponseColumn::Input => Cell::tokens(
+            match (
+                row.tokens.input,
+                row.tokens.cache_read,
+                row.tokens.cache_write,
+            ) {
+                (Some(input), Some(read), Some(write)) => {
+                    Some(input.saturating_sub(read).saturating_sub(write))
+                }
+                _ => None,
+            },
+        ),
+        ResponseColumn::Read => Cell::tokens(row.tokens.cache_read),
+        ResponseColumn::Write => Cell::tokens(row.tokens.cache_write),
+        ResponseColumn::Output => Cell::tokens(row.tokens.output),
+        ResponseColumn::Reasoning => Cell::tokens(row.tokens.reasoning),
+        ResponseColumn::Hit => {
+            let value = match (row.tokens.input, row.tokens.cache_read) {
+                (Some(input), Some(read)) if input > 0 => Some(read as f64 * 100.0 / input as f64),
+                _ => None,
+            };
+            Cell::value(
+                value,
+                value.map_or_else(|| "--".into(), |value| format!("{value:.2}%")),
+            )
+        }
+        ResponseColumn::Tps => Cell::value(row.tps, row.tps.map_or_else(|| "--".into(), tps)),
+        ResponseColumn::Cost => {
+            let value = cost(row, prices);
+            Cell::value(
+                value,
+                value.map_or_else(|| "--".into(), |usd| format!("${usd:.4}")),
+            )
+        }
+        ResponseColumn::Ttfb => duration(row.ttfb_ms),
+        ResponseColumn::Ttfc => duration(row.ttfc_ms),
+        ResponseColumn::Effort => {
+            let mut cell = optional(row.reasoning_effort.as_deref());
+            if row.reasoning_effort.is_some() {
+                cell.style = palette.effort;
+            }
+            cell
+        }
+        ResponseColumn::AttemptId => {
+            let mut cell = text(row.attempt_id.to_string());
+            if is_failed(row) {
+                cell.style = cell.style.red();
+            }
+            cell
+        }
+        ResponseColumn::Sent => bytes(row.sent_payload_bytes),
+    }
+}
+
+fn is_failed(row: &ResponseAttempt) -> bool {
+    row.end_reason
+        .is_some_and(|reason| reason != ResponseAttemptEnd::Completed)
+}
+
+fn state(attempt: &ObservedResponse, palette: &Palette) -> (&'static str, Style) {
+    let status = attempt.row.status(attempt.is_running());
+    let style = match status {
+        ResponseAttemptStatus::Working
+        | ResponseAttemptStatus::Received
+        | ResponseAttemptStatus::Unfinished
+        | ResponseAttemptStatus::Incomplete
+        | ResponseAttemptStatus::Interrupted
+        | ResponseAttemptStatus::Canceled => palette.attention,
+        ResponseAttemptStatus::Completed => palette.success,
+        ResponseAttemptStatus::Failed
+        | ResponseAttemptStatus::SetupFailed
+        | ResponseAttemptStatus::SendFailed
+        | ResponseAttemptStatus::TransportClosed
+        | ResponseAttemptStatus::ProgressTimeout
+        | ResponseAttemptStatus::ProtocolError => palette.failure,
+    };
+    (status_label(status), style)
+}
+
+pub(crate) fn status_label(status: ResponseAttemptStatus) -> &'static str {
+    match status {
+        ResponseAttemptStatus::Working => "Working",
+        ResponseAttemptStatus::Received => "Received",
+        ResponseAttemptStatus::Unfinished => "Unfinished",
+        ResponseAttemptStatus::Completed => "Done",
+        ResponseAttemptStatus::Incomplete => "Incomplete",
+        ResponseAttemptStatus::Failed => "Failed",
+        ResponseAttemptStatus::Interrupted => "Interrupted",
+        ResponseAttemptStatus::Canceled => "Canceled",
+        ResponseAttemptStatus::SetupFailed => "Setup failed",
+        ResponseAttemptStatus::SendFailed => "Send failed",
+        ResponseAttemptStatus::TransportClosed => "Disconnected",
+        ResponseAttemptStatus::ProgressTimeout => "Timeout",
+        ResponseAttemptStatus::ProtocolError => "Protocol error",
+    }
+}
+
+fn duration(value: Option<u64>) -> Cell {
+    Cell::value(
+        value.map(|value| value as f64 / 1000.0),
+        value.map_or_else(|| "--".into(), seconds),
+    )
+}
+
+fn bytes(value: Option<u64>) -> Cell {
+    Cell::value(
+        value.map(|value| value as f64),
+        value.map_or_else(|| "--".into(), payload_size),
+    )
+}
+
+fn payload_size(value: u64) -> String {
+    format!("{:.1} KiB", value as f64 / 1024.0)
+}
+
+fn text(value: impl Into<String>) -> Cell {
+    Cell::text(value.into().replace(['\r', '\n'], " "))
+}
+
+fn optional(value: Option<&str>) -> Cell {
+    text(value.unwrap_or("--"))
+}
+
+fn cost(row: &ResponseAttempt, prices: Option<&Prices>) -> Option<f64> {
+    let price = prices?.get(row.served_model.as_deref().unwrap_or(&row.requested_model))?;
+    if price.is_zero() {
+        return None;
+    }
+    Some(
+        price
+            .quote(
+                row.tokens.input?,
+                row.tokens.cache_read?,
+                row.tokens.cache_write?,
+                row.tokens.output?,
+            )
+            .usd,
+    )
+}
+
