+        assert!(
+            copied
+                .iter()
+                .all(|(rect, _)| rect.intersection(clipped) == *rect)
+        );
+        let text = render_lines(tables, 200).iter().join("\n");
+        assert!(text.find("Credits").unwrap() < text.find("gpt-5.4").unwrap());
+        assert!(!text.contains("Weekly quotas"));
+        assert!(text.contains("Efficiency"));
+        assert!(text.contains("$2.5000"));
+        let (_, row) = render(&report, 1, 200, &Palette::current());
+        assert_eq!(row, Some(13));
+        let weekly = render_detail(&report, 1, 200, &Palette::current());
+        let detail = &weekly[2];
+        let cells = detail.copyable_cells(area, 0, 0);
+        assert!(
+            cells
+                .iter()
+                .any(|(_, text)| text.as_ref() == "weekly-model")
+        );
+        assert!(!cells.iter().any(|(_, text)| text.as_ref() == "1234567"));
+        assert_eq!(report, original);
+
+        for (details, expected) in [
+            (None, "Period usage unavailable"),
+            (Some(UsageByModel::new()), "No usage in this period"),
+        ] {
+            report.quota[1].model_usage = details;
+            let tables = render_detail(&report, 1, 200, &Palette::current());
+            let cells = tables[2].copyable_cells(area, 0, 0);
+            assert!(cells.iter().any(|(_, text)| text.as_ref() == expected));
+        }
+    }
+}
