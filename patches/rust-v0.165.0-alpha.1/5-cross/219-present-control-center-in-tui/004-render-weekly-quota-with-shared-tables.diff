+use super::cost_cell;
+use super::count;
+use super::number;
+use super::numeric_table;
+use super::price_table;
+use super::usage_table;
+use crate::control_center_table as table;
+use crate::control_center_table::Cell;
+use crate::control_center_table::Column;
+use crate::control_center_table::Palette;
+use crate::control_center_table::Table;
+use crate::control_center_table::descending_rows;
+use crate::render::renderable::Renderable;
+use chrono::DateTime;
+use chrono::FixedOffset;
+use codex_app_server_protocol::UsageCreditPeriod;
+use codex_app_server_protocol::UsageQuotaEstimate as Estimate;
+use codex_app_server_protocol::UsageQuotaStatus as Status;
+use codex_app_server_protocol::UsageReport;
+use ratatui::text::Line;
+
+const DATE_FORMAT: &str = "%Y-%m-%d %H:%M";
+
+pub(super) fn render(
+    report: &UsageReport,
+    selected: usize,
+    width: u16,
+    palette: &Palette,
+) -> (Vec<Box<dyn Renderable>>, Option<usize>) {
+    let weekly = descending_rows(&report.quota, |estimate| {
+        DateTime::parse_from_rfc3339(&estimate.started_at).expect("validated quota timestamp")
+    });
+    let credits = descending_rows(&report.credits, |period| {
+        DateTime::parse_from_rfc3339(&period.started_at).expect("validated credit timestamp")
+    });
+    let timezone = *report.refreshed_at.offset();
+    let credit_table = render_credits(&credits, selected, timezone, width, palette);
+    let weekly_table = render_weekly(
+        &weekly,
+        selected.checked_sub(credits.len()),
+        timezone,
+        width,
+        palette,
+    );
+    let selected_row = credits
+        .get(selected)
+        .map(|_| credit_table.row_offset(selected + 2))
+        .or_else(|| {
+            let index = selected.checked_sub(credits.len())?;
+            weekly.get(index).map(|_| {
+                usize::from(credit_table.desired_height(width))
+                    + 1
+                    + weekly_table.row_offset(index + 2)
+            })
+        });
+    (
+        vec![
+            credit_table.into(),
+            Line::default().into(),
+            weekly_table.into(),
+        ],
+        selected_row,
+    )
+}
+
+pub(super) fn render_detail(
+    report: &UsageReport,
+    selected: usize,
+    width: u16,
+    palette: &Palette,
+) -> Vec<Box<dyn Renderable>> {
+    let timezone = *report.refreshed_at.offset();
+    let (period, models) = if selected < report.credits.len() {
+        let credits = descending_rows(&report.credits, |period| {
+            DateTime::parse_from_rfc3339(&period.started_at).expect("validated credit timestamp")
+        });
+        let period = credits[selected];
+        (
+            render_credits(&[period], 0, timezone, width, palette),
+            period.model_usage.as_ref(),
+        )
+    } else {
+        let weekly = descending_rows(&report.quota, |period| {
+            DateTime::parse_from_rfc3339(&period.started_at).expect("validated quota timestamp")
+        });
+        let period = weekly[selected - report.credits.len()];
+        (
+            render_weekly(&[period], Some(0), timezone, width, palette),
+            period.model_usage.as_ref(),
+        )
+    };
+    let mut tables: Vec<Box<dyn Renderable>> = vec![period.into(), Line::default().into()];
+    match models {
+        Some(models) if !models.is_empty() => {
+            tables.push(usage_table(report, None, models, width, palette).into());
+            tables.push(Line::default().into());
+            tables.push(price_table(report, models, width, palette).into());
+        }
+        other => {
+            let message = if other.is_some() {
+                "No usage in this period"
+            } else {
+                "Period usage unavailable"
+            };
+            let mut cell = Cell::text(message);
+            cell.style = cell.style.dim();
+            tables.push(table::render(&[message.len()], &[vec![cell]], palette).into());
+        }
+    }
+    tables
+}
+
+fn render_weekly(
+    estimates: &[&Estimate],
+    selected: Option<usize>,
+    timezone: FixedOffset,
+    width: u16,
+    palette: &Palette,
+) -> Table {
+    let mut rows: Vec<_> = estimates
+        .iter()
+        .enumerate()
+        .map(|(index, estimate)| {
+            let started = DateTime::parse_from_rfc3339(&estimate.started_at)
+                .expect("validated quota timestamp");
+            let ended = DateTime::parse_from_rfc3339(&estimate.ended_at)
+                .expect("validated quota timestamp");
+            let mut row = vec![
+                Cell::text(if selected == Some(index) { ">" } else { "" }),
+                Cell::number(local_date(started, timezone)),
+                Cell::number(local_date(ended, timezone)),
+                Cell::number(duration((ended - started).num_seconds())),
+                Cell::value(
+                    Some(estimate.used_percent_end),
+                    number(estimate.used_percent_end, 1, "", "%"),
+                ),
+                cost_cell(estimate.observed_cost_usd, true),
+                cost_cell(estimate.unrecorded_cost_usd(), true),
+                cost_cell(estimate.estimated_weekly_cost_usd, true),
+                Cell::text(status_label(estimate.status)),
+                Cell::value(
+                    Some(estimate.sample_count as f64),
+                    count(estimate.sample_count as u64),
+                ),
+            ];
+            if selected == Some(index) {
+                for cell in &mut row {
+                    cell.style = cell.style.italic();
+                }
+            }
+            row
+        })
+        .collect();
+    if rows.is_empty() {
+        rows.push(vec![
+            Cell::text("No historical quota estimate available").spanning(1, 10),
+        ]);
+    }
+    numeric_table(
+        vec![
+            vec![
+                palette.header("").spanning(2, 1),
+                palette.header("Weekly quotas"),
+                palette.header("").spanning(1, 8),
+            ],
+            [
+                "Started",
+                "Ended",
+                "Duration",
+                "Used",
+                "Observed",
+                "Unrecorded",
+                "Estimated",
+                "Status",
+                "Records",
+            ]
+            .into_iter()
+            .map(|label| palette.header(label))
+            .collect(),
+        ],
+        &[
+            Column::new("", 2, 2),
+            date_column("Started"),
+            date_column("Ended"),
+            Column::new("Duration", duration(0).len(), 12),
+            Column::new("Used", "100.0%".len(), 7),
+            Column::new("Observed", "$0.00".len(), 12),
+            Column::new("Unrecorded", "$0.00".len(), 12),
+            Column::new("Estimated", "$0.00".len(), 12),
+            Column::new(
+                "Status",
+                [Status::Completed, Status::Provisional]
+                    .into_iter()
+                    .map(status_label)
+                    .map(str::len)
+                    .max()
+                    .expect("quota statuses"),
+                11,
+            ),
+            Column::new("Records", "0.00K".len(), 7),
+        ],
+        rows,
+        None,
+        width,
+        palette,
+    )
+}
+
+fn render_credits(
+    credits: &[&UsageCreditPeriod],
+    selected: usize,
+    timezone: FixedOffset,
+    width: u16,
+    palette: &Palette,
+) -> Table {
+    let mut rows: Vec<_> = credits
+        .iter()
+        .enumerate()
+        .map(|(index, period)| {
+            let started = DateTime::parse_from_rfc3339(&period.started_at)
+                .expect("validated credit timestamp");
+            let ended =
+                DateTime::parse_from_rfc3339(&period.ended_at).expect("validated credit timestamp");
+            let mut row = vec![
+                Cell::text(if selected == index { ">" } else { "" }),
+                Cell::number(local_date(started, timezone)),
+                Cell::number(local_date(ended, timezone)),
+                Cell::number(duration((ended - started).num_seconds())),
+                Cell::value(
+                    Some(period.used_credits),
+                    format!("{:.2}", period.used_credits),
+                ),
+                cost_cell(period.observed_cost_usd, true),
+                Cell::value(
+                    Some(period.sample_count as f64),
+                    count(period.sample_count as u64),
+                ),
+            ];
+            if selected == index {
+                for cell in &mut row {
+                    cell.style = cell.style.italic();
+                }
+            }
+            row
+        })
+        .collect();
+    if rows.is_empty() {
+        rows.push(vec![
+            Cell::text("No historical credit deductions available").spanning(1, 7),
+        ]);
+    }
+    numeric_table(
+        vec![
+            vec![
+                palette.header("").spanning(2, 1),
+                palette.header("Credits"),
+                palette.header("").spanning(1, 5),
+            ],
+            [
+                "Started", "Ended", "Duration", "Used", "Observed", "Records",
+            ]
+            .into_iter()
+            .map(|label| palette.header(label))
+            .collect(),
+        ],
+        &[
+            Column::new("", 2, 2),
+            date_column("Started"),
+            date_column("Ended"),
+            Column::new("Duration", duration(0).len(), 12),
+            Column::new("Used", "0.00".len(), 9),
+            Column::new("Observed", "$0.00".len(), 12),
+            Column::new("Records", "0.00K".len(), 7),
+        ],
+        rows,
+        None,
+        width,
+        palette,
+    )
+}
+
+fn duration(seconds: i64) -> String {
+    format!(
+        "{}d {:02}:{:02}:{:02}",
+        seconds / 86_400,
+        seconds / 3_600 % 24,
+        seconds / 60 % 60,
+        seconds % 60,
+    )
+}
+
+fn local_date(value: DateTime<FixedOffset>, timezone: FixedOffset) -> String {
+    value
+        .with_timezone(&timezone)
+        .format(DATE_FORMAT)
+        .to_string()
+}
+
+fn date_column(label: &str) -> Column {
+    let width = "0000-00-00 00:00".len();
+    Column::new(label, width, width)
+}
+
+fn status_label(status: Status) -> &'static str {
+    match status {
+        Status::Completed => "Completed",
+        Status::Provisional => "Provisional",
+    }
+}
