+#[tokio::test]
+async fn statistics_copy_complete_wrapped_lines_and_release_the_dialog_while_pending() {
+    use crate::app_event_sender::AppEventSender;
+    use crate::dialog::DialogResources;
+    use crate::pager_overlay::CenterScreen;
+    use crate::pager_overlay::ControlCenter;
+    use crossterm::event::MouseButton;
+    use crossterm::event::MouseEvent;
+    use crossterm::event::MouseEventKind;
+    use ratatui::buffer::Buffer;
+    use ratatui::layout::Rect;
+
+    for screen in [CenterScreen::Responses, CenterScreen::Quotas] {
+        for close_while_pending in [false, true] {
+            let target = format!("{}: 12.34s", "Long requested model name ".repeat(8));
+            let mut app = crate::app::test_support::make_test_app().await;
+            let mut tui = crate::tui::test_support::make_test_tui().unwrap();
+            let mut server = crate::start_embedded_app_server_for_picker(&app.config)
+                .await
+                .unwrap();
+            let (draws, mut drawn) = tokio::sync::broadcast::channel(1);
+            let (started, start_rx) = mpsc::channel();
+            let (release, released) = mpsc::channel();
+            tui.clipboard
+                .start(
+                    FrameRequester::new(draws),
+                    move |text, format, setup| {
+                        setup.begin_delivery().unwrap();
+                        started.send((text.to_owned(), format)).unwrap();
+                        released.recv().unwrap();
+                        (Ok(CopyOutcome::Copied(None)), None)
+                    },
+                    || |_| unreachable!("copy-only backend"),
+                )
+                .unwrap();
+            let (events, _received) = tokio::sync::mpsc::unbounded_channel();
+            let events = AppEventSender::new(events);
+            let mut center = ControlCenter::new(
+                Some(Arc::new(crate::usage::test_report())),
+                DialogResources {
+                    app_event_tx: &events,
+                    keymap: &app.keymap,
+                    frame_requester: &tui.frame_requester(),
+                    vim_enabled: false,
+                },
+                80,
+                1.0,
+                app.chat_widget.model_catalog(),
+            );
+            center.screen = screen;
+            let lines = if screen == CenterScreen::Responses {
+                &center.response_statistics
+            } else {
+                &center.quota_statistics
+            };
+            lines.send_replace(vec![target.clone().into()]);
+            assert!(center.show_statistics(1.0, tui.frame_requester()));
+            app.overlay = Some(Overlay::ControlCenter(Box::new(center)));
+            let render = |app: &mut crate::app::App| {
+                let Some(Overlay::ControlCenter(center)) = &mut app.overlay else {
+                    panic!("retained control center")
+                };
+                let area = Rect::new(0, 0, 80, 24);
+                let mut buffer = Buffer::empty(area);
+                center.render(area, &mut buffer);
+                buffer
+                    .content
+                    .chunks_exact(80)
+                    .map(|row| row.iter().map(|cell| cell.symbol()).collect::<String>())
+                    .collect::<Vec<_>>()
+            };
+            let rows = render(&mut app);
+            assert!(rows.iter().any(|line| line.contains("12.34s")));
+            let (row, column) = rows
+                .iter()
+                .enumerate()
+                .find_map(|(row, line)| {
+                    let start = line.find("Long requested model name")?;
+                    Some((row as u16, line[..start].chars().count() as u16))
+                })
+                .expect("wrapped metric is visible");
+            let click = MouseEvent {
+                kind: MouseEventKind::Down(MouseButton::Left),
+                column,
+                row,
+                modifiers: KeyModifiers::NONE,
+            };
+            let Some(Overlay::ControlCenter(center)) = &mut app.overlay else {
+                unreachable!()
+            };
+            center.show_quit_dialog(
+                Err("cannot quit".into()),
+                DialogResources {
+                    app_event_tx: &events,
+                    keymap: &app.keymap,
+                    frame_requester: &tui.frame_requester(),
+                    vim_enabled: false,
+                },
+            );
+            render(&mut app);
+            app.handle_tui_event(&mut tui, &mut server, TuiEvent::Mouse(click))
+                .await
+                .unwrap();
+            assert!(!tui.clipboard.is_busy());
+            app.handle_tui_event(&mut tui, &mut server, TuiEvent::Key(KeyCode::Esc.into()))
+                .await
+                .unwrap();
+            render(&mut app);
+            app.handle_tui_event(&mut tui, &mut server, TuiEvent::Mouse(click))
+                .await
+                .unwrap();
+            assert_eq!(
+                start_rx.recv_timeout(Duration::from_secs(5)).unwrap(),
+                (target.clone(), CopyFormat::PlainText)
+            );
+            assert!(render(&mut app).iter().any(|line| line.contains(&format!("Copying {} chars", target.chars().count()))));
+            if close_while_pending {
+                app.handle_tui_event(&mut tui, &mut server, TuiEvent::Key(KeyCode::Esc.into()))
+                    .await
+                    .unwrap();
+                assert!(
+                    matches!(&app.overlay, Some(Overlay::ControlCenter(center)) if !center.has_statistics())
+                );
+                assert!(tui.clipboard.is_busy());
+            }
+            release.send(()).unwrap();
+            tokio::time::timeout(Duration::from_secs(5), drawn.recv())
+                .await
+                .unwrap()
+                .unwrap();
+            app.handle_tui_event(&mut tui, &mut server, TuiEvent::FocusLost)
+                .await
+                .unwrap();
+            assert!(!tui.clipboard.is_busy());
+            assert!(start_rx.try_recv().is_err());
+            let rows = render(&mut app);
+            let copied = format!("Copied {} chars to host clipboard", target.chars().count());
+            assert_eq!(
+                rows.iter().any(|line| line.contains(&copied)),
+                !close_while_pending
+            );
+            server.shutdown().await.unwrap();
+        }
+    }
+}
