+#[tokio::test]
+async fn statistics_shortcuts_preserve_page_state_and_use_live_pager_bindings()
+-> crate::app::Result<()> {
+    use codex_app_server_protocol::ResponseTimingReadResponse;
+    use codex_protocol::response_metrics::ResponseModelTiming;
+
+    let mut fixture = Fixture::new().await?;
+    let config =
+        toml::from_str("[list]\nmove_down = 's'\n[pager]\nscroll_down = 'f2'\nclose = 'ctrl-x c'")?;
+    fixture.app.keymap = crate::keymap::RuntimeKeymap::from_config(&config).expect("valid keymap");
+    fixture
+        .app
+        .chat_widget
+        .apply_keymap_update(config, &fixture.app.keymap);
+    fixture.app.open_control_center(&mut fixture.tui);
+    let request_id = fixture.app.usage_request.as_ref().unwrap().id;
+    let report = Arc::new(crate::usage::test_report());
+    fixture
+        .dispatch(AppEvent::UsageLoaded {
+            request_id,
+            result: Ok(UsageReadResponse {
+                report: Arc::clone(&report),
+                refreshed: false,
+            }),
+        })
+        .await?;
+    // Cached statistics remain interactive while the app server is disconnected.
+    fixture.app.reconnect.offline = true;
+    fixture.key(KeyCode::Char('s')).await?;
+    assert!(!fixture.center().has_dialog());
+    fixture
+        .key(KeyEvent::new(KeyCode::Char('2'), KeyModifiers::ALT))
+        .await?;
+    fixture.key(KeyCode::Char('s')).await?;
+    assert!(!fixture.center().has_dialog());
+    fixture.key(KeyCode::Esc).await?;
+    fixture.key(KeyCode::Tab).await?;
+    let thread_id = codex_protocol::ThreadId::new().to_string();
+    let Some(Overlay::ControlCenter(center)) = &mut fixture.app.overlay else {
+        unreachable!()
+    };
+    center.responses.history.models.insert("model-a".into());
+    center.timing = Some(Ok(ResponseTimingReadResponse {
+        models: (0..4)
+            .map(|index| ResponseModelTiming {
+                requested_model: format!("statistics-model-{index}"),
+                successful_attempts: 1,
+                total_attempts: 1,
+                last_tps: Some(index as f64),
+                last_ttfc_ms: Some(0),
+                tps: None,
+                ttfc_ms: None,
+            })
+            .collect(),
+        successful_attempts: 4,
+        total_attempts: 4,
+        persistence_error: None,
+        last_persistence_error: None,
+    }));
+    let request = center
+        .responses
+        .history
+        .set_thread(Some(thread_id.clone()), Instant::now());
+    center.responses.request(request);
+    fixture.key(KeyCode::Left).await?;
+    fixture.key(KeyCode::Right).await?;
+    fixture
+        .key(KeyEvent::new(KeyCode::Right, KeyModifiers::CONTROL))
+        .await?;
+    let before = fixture.text();
+    assert!(before.contains("s statistics"));
+    let column_offset = fixture.center().table_interaction.column_offset;
+    let model = fixture
+        .center()
+        .responses
+        .history
+        .model()
+        .map(str::to_owned);
+    let status = fixture.center().responses.history.status();
+    while fixture.events.try_recv().is_ok() {}
+
+    fixture.key(KeyCode::Char('s')).await?;
+    assert!(!fixture.app.key_chord_matcher.is_pending());
+    assert!(fixture.center().has_statistics());
+    assert!(
+        fixture
+            .app
+            .active_keymap_contexts()
+            .contains(KeymapContext::Pager)
+    );
+    let text = fixture.text();
+    assert!(text.contains("24H total success: 100.00%"), "{text}");
+    assert!(text.contains("F2") || text.contains("f2"), "{text}");
+    fixture.key(KeyCode::Char('s')).await?;
+    assert_eq!(fixture.center().dialogs.len(), 1);
+    fixture.key(KeyCode::End).await?;
+    let text = fixture.text();
+    assert!(text.contains("statistics-model-3"), "{text}");
+    fixture.key(KeyCode::Home).await?;
+    let top = fixture.text();
+    fixture.key(KeyCode::F(2)).await?;
+    assert_ne!(fixture.text(), top);
+    fixture.key(KeyCode::Home).await?;
+    let Some(Overlay::ControlCenter(center)) = &mut fixture.app.overlay else {
+        unreachable!()
+    };
+    center.timing.as_mut().unwrap().as_mut().unwrap().models[0].last_tps = Some(99.0);
+    fixture
+        .app
+        .refresh_control_center_details(&fixture.server, &TuiEvent::Draw);
+    assert!(fixture.text().contains("Last TPS: 99.0"));
+    fixture
+        .key(KeyEvent::new(KeyCode::Char('x'), KeyModifiers::CONTROL))
+        .await?;
+    fixture.key(KeyCode::Char('c')).await?;
+    assert!(!fixture.center().has_dialog());
+    assert!(!fixture.center().has_statistics());
+    assert!(
+        fixture
+            .app
+            .active_keymap_contexts()
+            .contains(KeymapContext::List)
+    );
+    assert_eq!(fixture.center().responses.history.model(), model.as_deref());
+    assert_eq!(fixture.center().responses.history.status(), status);
+    assert_eq!(
+        fixture.center().responses.history.thread_id(),
+        Some(thread_id.as_str())
+    );
+    assert_eq!(
+        fixture.center().table_interaction.column_offset,
+        column_offset
+    );
+    assert_eq!(fixture.text(), before);
+    assert!(fixture.events.try_recv().is_err());
+
+    fixture.key(KeyCode::Tab).await?;
+    fixture
+        .key(KeyEvent::new(KeyCode::Char('0'), KeyModifiers::ALT))
+        .await?;
+    fixture.key(KeyCode::Down).await?;
+    let quotas = fixture.text();
+    assert!(quotas.contains("s statistics"));
+    assert!(quotas.contains("$600.00"), "{quotas}");
+    fixture.key(KeyCode::Char('s')).await?;
+    let text = fixture.text();
+    assert!(text.contains("Credits / $1 API:"), "{text}");
+    assert!(!text.contains("Latest estimated"), "{text}");
+    assert!(text.contains("Average estimated:"), "{text}");
+    assert!(text.contains("Average utilization:"), "{text}");
+    assert!(fixture.center().has_statistics());
+    fixture.key(KeyCode::Esc).await?;
+    assert!(!fixture.center().has_statistics());
+    assert_eq!(fixture.center().screen, CenterScreen::Quotas);
+    assert_eq!(fixture.text(), quotas);
+    assert!(Arc::ptr_eq(fixture.center().report().unwrap(), &report));
+    assert!(fixture.events.try_recv().is_err());
+    fixture.finish().await
+}
