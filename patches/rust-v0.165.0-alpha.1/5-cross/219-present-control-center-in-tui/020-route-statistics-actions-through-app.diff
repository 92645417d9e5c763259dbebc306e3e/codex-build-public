@@ -0,0 +1,249 @@
+//! Full-screen accounting for the selected cached quota or credit period.
+
+use super::PagerView;
+use crate::bottom_pane::BottomPaneView;
+use crate::bottom_pane::CancellationEvent;
+use crate::control_center_table::interaction::TableInteraction;
+use crate::control_center_table::interaction::TableMouseAction;
+use crate::footer_hint;
+use crate::key_hint::KeyBindingListExt;
+use crate::keymap::KeymapContext;
+use crate::keymap::KeymapContextSet;
+use crate::keymap::PagerKeymap;
+use crate::render::renderable::Renderable;
+use crate::tui::FrameRequester;
+use crate::tui::Tui;
+use crate::usage::UsageReport;
+use crossterm::event::KeyEvent;
+use crossterm::event::MouseEvent;
+use ratatui::buffer::Buffer;
+use ratatui::layout::Constraint;
+use ratatui::layout::Layout;
+use ratatui::layout::Margin;
+use ratatui::layout::Rect;
+use ratatui::widgets::Clear;
+use ratatui::widgets::Widget;
+use std::cell::RefCell;
+use std::rc::Rc;
+use std::sync::Arc;
+use std::time::Instant;
+
+pub(super) const QUOTA_DETAIL_VIEW_ID: &str = "control_center_quota_detail";
+
+pub(super) struct QuotaDetailView {
+    report: Arc<UsageReport>,
+    selected: usize,
+    view: PagerView,
+    area: Rect,
+    pub(super) interaction: TableInteraction,
+    done: bool,
+}
+
+impl QuotaDetailView {
+    pub(super) fn new(
+        report: Arc<UsageReport>,
+        selected: usize,
+        keymap: PagerKeymap,
+        mouse_scroll_speed: f64,
+        frames: FrameRequester,
+    ) -> Self {
+        Self {
+            report,
+            selected,
+            view: PagerView::new(Vec::new(), String::new(), 0, keymap),
+            area: Rect::default(),
+            interaction: TableInteraction::new(mouse_scroll_speed, frames),
+            done: false,
+        }
+    }
+
+    fn render(&mut self, area: Rect, buf: &mut Buffer) {
+        self.area = area;
+        Clear.render(area, buf);
+        let [body, footer] = Layout::vertical([Constraint::Min(0), Constraint::Length(1)])
+            .areas(area.inner(Margin::new(2, 0)));
+        self.view.renderables =
+            crate::usage::render_quota_detail(&self.report, self.selected, body.width);
+        self.view.update_last_content_height(body.height);
+        self.view.scroll_offset = self.view.scroll_offset.min(
+            self.view
+                .content_height(body.width)
+                .saturating_sub(usize::from(body.height)),
+        );
+        let widest = self
+            .view
+            .renderables
+            .iter()
+            .map(|table| table.desired_width())
+            .max()
+            .unwrap_or(0);
+        self.interaction.column_offset = self
+            .interaction
+            .column_offset
+            .min(widest.saturating_sub(body.width));
+        self.interaction.cells = self
+            .view
+            .render_content(body, buf, self.interaction.column_offset)
+            .1;
+        footer_hint::shortcut("esc", "back").render(footer, buf);
+        self.interaction
+            .render_feedback(footer, buf, Instant::now());
+    }
+
+    fn handle_key(&mut self, key: KeyEvent) {
+        if self.view.keymap.close.is_pressed(key) {
+            self.done = true;
+        } else if !self.interaction.handle_horizontal(key) {
+            let page = self
+                .view
+                .last_content_height
+                .unwrap_or(0)
+                .saturating_sub(2)
+                .max(1);
+            let keymap = &self.view.keymap;
+            if keymap.scroll_up.is_pressed(key) {
+                self.view.scroll_offset = self.view.scroll_offset.saturating_sub(1);
+            } else if keymap.scroll_down.is_pressed(key) {
+                self.view.scroll_offset = self.view.scroll_offset.saturating_add(1);
+            } else if keymap.page_up.is_pressed(key) {
+                self.view.scroll_offset = self.view.scroll_offset.saturating_sub(page);
+            } else if keymap.page_down.is_pressed(key) {
+                self.view.scroll_offset = self.view.scroll_offset.saturating_add(page);
+            } else if keymap.half_page_up.is_pressed(key) {
+                self.view.scroll_offset = self.view.scroll_offset.saturating_sub(page.div_ceil(2));
+            } else if keymap.half_page_down.is_pressed(key) {
+                self.view.scroll_offset = self.view.scroll_offset.saturating_add(page.div_ceil(2));
+            } else if keymap.jump_top.is_pressed(key) {
+                self.view.scroll_offset = 0;
+            } else if keymap.jump_bottom.is_pressed(key) {
+                self.view.scroll_offset = usize::MAX;
+            }
+        }
+        self.interaction.reset_scroll();
+    }
+
+    pub(super) fn handle_mouse(&mut self, mouse: MouseEvent, tui: &mut Tui) {
+        if !self.area.contains((mouse.column, mouse.row).into()) {
+            return;
+        }
+        if let Some(action) = self.interaction.handle_mouse(mouse, tui) {
+            if let TableMouseAction::Scroll(rows) = action {
+                self.view.scroll_offset = self.view.scroll_offset.saturating_add_signed(rows);
+            }
+            tui.frame_requester().schedule_frame();
+        }
+    }
+}
+
+// DialogStack owns the view; the host's weak reference routes native mouse and clipboard events.
+impl Renderable for Rc<RefCell<QuotaDetailView>> {
+    fn desired_height(&self, _width: u16) -> u16 {
+        u16::MAX
+    }
+
+    fn render(&self, area: Rect, buf: &mut Buffer) {
+        self.borrow_mut().render(area, buf);
+    }
+}
+
+impl BottomPaneView for Rc<RefCell<QuotaDetailView>> {
+    fn keymap_contexts(&self) -> KeymapContextSet {
+        KeymapContextSet::new(KeymapContext::Pager)
+    }
+
+    fn handle_key_event(&mut self, key: KeyEvent) {
+        self.borrow_mut().handle_key(key);
+    }
+
+    fn view_id(&self) -> Option<&'static str> {
+        Some(QUOTA_DETAIL_VIEW_ID)
+    }
+
+    fn is_complete(&self) -> bool {
+        self.borrow().done
+    }
+
+    fn on_ctrl_c(&mut self) -> CancellationEvent {
+        self.borrow_mut().done = true;
+        CancellationEvent::Handled
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::keymap::RuntimeKeymap;
+    use crossterm::event::KeyCode;
+    use crossterm::event::KeyModifiers;
+
+    #[test]
+    fn period_detail_uses_fullscreen_geometry_and_exact_cell_copy() {
+        let mut report = crate::usage::test_report();
+        let mut models = report.rows["2026-09-28"].clone();
+        *models.get_mut("gpt-5.4").unwrap() = codex_app_server_protocol::UsageTotals {
+            tokens: codex_app_server_protocol::UsageTokens {
+                input: 1_234_567,
+                total: 1_234_567,
+                ..Default::default()
+            },
+            ..Default::default()
+        };
+        report.quota[1].model_usage = Some(models);
+        let mut view = QuotaDetailView::new(
+            Arc::new(report),
+            0,
+            RuntimeKeymap::defaults().pager,
+            1.0,
+            FrameRequester::test_dummy(),
+        );
+        let area = Rect::new(3, 2, 204, 32);
+        let mut buffer = Buffer::empty(area);
+        view.render(area, &mut buffer);
+        assert!(
+            view.interaction
+                .cells
+                .iter()
+                .any(|(cell, _)| cell.right() > area.x + 100)
+        );
+        assert!(
+            view.interaction
+                .cells
+                .iter()
+                .any(|(_, text)| text.as_ref() == "1234567")
+        );
+        let narrow = Rect::new(3, 2, 64, 32);
+        view.render(narrow, &mut Buffer::empty(narrow));
+        assert!(
+            view.interaction
+                .cells
+                .iter()
+                .any(|(_, text)| text.as_ref() == "1234567")
+        );
+        assert!(
+            view.interaction
+                .cells
+                .iter()
+                .all(|(cell, _)| cell.intersection(narrow) == *cell)
+        );
+        view.handle_key(KeyEvent::new(KeyCode::Right, KeyModifiers::CONTROL));
+        assert!(view.interaction.column_offset > 0);
+        let short = Rect::new(3, 2, 204, 9);
+        view.render(short, &mut Buffer::empty(short));
+        view.handle_key(KeyCode::End.into());
+        let mut buffer = Buffer::empty(short);
+        view.render(short, &mut buffer);
+        assert!(view.view.scroll_offset > 0);
+        assert!(
+            view.interaction
+                .cells
+                .iter()
+                .any(|(_, text)| text.as_ref() == "Efficiency")
+        );
+        let footer = (short.x..short.right())
+            .map(|x| buffer[(x, short.bottom() - 1)].symbol())
+            .collect::<String>();
+        assert_eq!(footer.trim(), "esc back");
+        view.handle_key(KeyCode::Home.into());
+        assert_eq!(view.view.scroll_offset, 0);
+    }
+}
