+#[tokio::test]
+async fn quota_details_open_with_d_and_restore_the_selected_scrolled_period()
+-> crate::app::Result<()> {
+    let mut fixture = Fixture::new().await?;
+    let config = toml::from_str("[list]\nmove_down = 'd'\n[approval]\ndeny = 'f12'")?;
+    fixture.app.keymap = crate::keymap::RuntimeKeymap::from_config(&config).expect("valid keymap");
+    fixture
+        .app
+        .chat_widget
+        .apply_keymap_update(config, &fixture.app.keymap);
+    fixture.app.open_control_center(&mut fixture.tui);
+    let request_id = fixture.app.usage_request.as_ref().unwrap().id;
+    let mut report = crate::usage::test_report();
+    let models = report.rows["2026-09-28"].clone();
+    let template = report.quota[0].clone();
+    let start = chrono::DateTime::parse_from_rfc3339("2026-01-01T00:00:00Z").unwrap();
+    report.quota = (0..40)
+        .map(|index| {
+            let mut period = template.clone();
+            period.started_at = (start + chrono::Duration::days(index)).to_rfc3339();
+            period.ended_at = (start + chrono::Duration::days(index + 1)).to_rfc3339();
+            period.model_usage = Some(models.clone());
+            period
+        })
+        .collect();
+    let report = Arc::new(report);
+    fixture
+        .dispatch(AppEvent::UsageLoaded {
+            request_id,
+            result: Ok(UsageReadResponse {
+                report: Arc::clone(&report),
+                refreshed: false,
+            }),
+        })
+        .await?;
+    fixture.app.reconnect.offline = true;
+    fixture.key(KeyCode::Char('d')).await?;
+    assert!(!fixture.center().has_dialog());
+    fixture
+        .key(KeyEvent::new(KeyCode::Char('0'), KeyModifiers::ALT))
+        .await?;
+    fixture.text();
+    for _ in 0..34 {
+        fixture.key(KeyCode::Down).await?;
+        fixture.text();
+    }
+    let parent = fixture.text();
+    assert!(parent.contains("d details"));
+    assert!(!parent.contains("gpt-5.4"));
+    assert!(!parent.contains("2026-02-09"));
+    fixture.key(KeyCode::Enter).await?;
+    assert!(!fixture.center().has_dialog());
+    while fixture.events.try_recv().is_ok() {}
+    fixture.key(KeyCode::Char('d')).await?;
+    assert!(fixture.center().has_dialog());
+    assert!(
+        fixture
+            .app
+            .active_keymap_contexts()
+            .contains(KeymapContext::Pager)
+    );
+    let detail = fixture.text();
+    assert!(detail.contains("2026-01-06"), "{detail}");
+    assert!(!detail.contains("2026-01-05"), "{detail}");
+    assert!(detail.contains("gpt-5.4"), "{detail}");
+    assert!(detail.contains("$2.5000"), "{detail}");
+    assert!(detail.contains("Efficiency"), "{detail}");
+    assert_eq!(detail.lines().last(), Some("esc back"));
+    for key in [
+        KeyCode::Char('r'),
+        KeyCode::Char('s'),
+        KeyCode::Tab,
+        KeyCode::Enter,
+    ] {
+        fixture.key(key).await?;
+        assert!(fixture.center().has_dialog(), "{key:?}");
+    }
+    assert_eq!(fixture.center().dialogs.len(), 1);
+    assert!(fixture.events.try_recv().is_err());
+    fixture.key(KeyCode::Esc).await?;
+    assert!(!fixture.center().has_dialog());
+    assert_eq!(fixture.center().screen, CenterScreen::Quotas);
+    assert_eq!(fixture.text(), parent);
+    assert!(Arc::ptr_eq(fixture.center().report().unwrap(), &report));
+    fixture.key(KeyCode::Char('d')).await?;
+    assert_eq!(fixture.text(), detail);
+    // The native pager close binding closes only the detail, not the daemon.
+    fixture.key(KeyCode::Char('q')).await?;
+    assert!(!fixture.center().has_dialog());
+    assert_eq!(fixture.text(), parent);
+    assert!(fixture.events.try_recv().is_err());
+    fixture.key(KeyCode::Char('d')).await?;
+    fixture.key(KeyCode::Esc).await?;
+    assert_eq!(fixture.text(), parent);
+    fixture.finish().await
+}
