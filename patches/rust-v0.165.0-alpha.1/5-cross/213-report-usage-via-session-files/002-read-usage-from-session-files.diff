+use super::*;
+use pretty_assertions::assert_eq;
+use serde_json::json;
+
+#[test]
+fn a_header_without_its_line_ending_remains_an_incomplete_tail() {
+    let directory = tempfile::tempdir().unwrap();
+    let sessions = directory.path().join("sessions");
+    fs::create_dir(&sessions).unwrap();
+    let header = json!({"type":"session_meta","payload":{
+        "id":"thread","history_mode":"paginated"}});
+    fs::write(sessions.join("header.jsonl"), header.to_string()).unwrap();
+    let events = load(directory.path()).unwrap();
+    assert_eq!(events.diagnostics.files, 1);
+    assert_eq!(events.diagnostics.incomplete_tails, 1);
+    assert_eq!(events.diagnostics.malformed_records, 0);
+    assert!(events.events.is_empty());
+}
+
+#[test]
+fn native_billing_preserves_historical_subagent_usage_and_referenced_suffixes() {
+    for (own_start, reference, count, expected) in
+        [(Some(13), None, 1, 28_819), (None, Some(2), 2, 57_638)]
+    {
+        let directory = tempfile::tempdir().unwrap();
+        let root = directory.path().join("sessions");
+        fs::create_dir(&root).unwrap();
+        let header = json!({"type":"session_meta","timestamp":"2026-09-29T00:00:00Z",
+            "payload":{"id":"child","forked_from_id":"unavailable","history_mode":"paginated",
+            "subagent_history_start_ordinal":own_start,
+            "history_base":reference.map(|start| json!({"end_ordinal_exclusive":start}))}});
+        let context = json!({"type":"turn_context","ordinal":4,"payload":{"model":"gpt-5.4-mini"}});
+        let mut text = format!("{header}\n{context}\n");
+        for index in 0..count {
+            let event = json!({"type":"event_msg","ordinal":11+index,"timestamp":"2026-06-22T23:10:14.352Z",
+                "payload":{"type":"token_count","info":{
+                    "last_token_usage":{"input_tokens":28629,"output_tokens":190,"total_tokens":28819},
+                    "total_token_usage":{"input_tokens":28629*(index+1),"output_tokens":190*(index+1),"total_tokens":28819*(index+1)}
+                },"rate_limits":{"plan_type":"pro","primary":{"window_minutes":10080,"used_percent":20.0,"resets_at":1800000000}}}});
+            text.push_str(&format!("{event}\n"));
+        }
+        fs::write(root.join("child.jsonl"), text).unwrap();
+        let events = load(directory.path()).unwrap();
+        assert_eq!(
+            events
+                .events
+                .iter()
+                .map(|event| event.tokens.total)
+                .sum::<u64>(),
+            expected
+        );
+        assert_eq!(events.diagnostics.replayed_events, 0);
+        assert_eq!(events.observations.len(), count);
+        assert_eq!(events.credits.len(), count);
+        assert!(
+            events
+                .events
+                .iter()
+                .all(|event| events.models[event.model] == "gpt-5.4-mini")
+        );
+    }
+}
+
+#[test]
+fn missing_roots_are_empty_but_a_file_in_place_of_a_root_is_an_error() {
+    let directory = tempfile::tempdir().unwrap();
+    assert!(load(directory.path()).unwrap().events.is_empty());
+    fs::write(directory.path().join("sessions"), "").unwrap();
+    assert!(load(directory.path()).is_err());
+}
+
+#[test]
+fn nested_archives_are_read_once_and_active_relative_paths_take_precedence() {
+    let directory = tempfile::tempdir().unwrap();
+    for (relative, id, input) in [
+        ("sessions/2026/09/29/active.jsonl", "active", 10),
+        ("sessions/archives/2026/09/29/active.jsonl", "active", 999),
+        (
+            "sessions/archives/2026/09/29/archived.jsonl",
+            "archived",
+            20,
+        ),
+    ] {
+        let path = directory.path().join(relative);
+        fs::create_dir_all(path.parent().unwrap()).unwrap();
+        let header = json!({"type":"session_meta","payload":{
+            "id":id,"history_mode":"paginated"}});
+        let record = json!({"type":"token_usage_record","timestamp":"2026-09-29T01:00:00Z",
+            "payload":{"thread_id":id,"response_id":"response",
+                "usage":{"input_tokens":input,"total_tokens":input}}});
+        fs::write(path, format!("{header}\n{record}\n")).unwrap();
+    }
+    let events = load(directory.path()).unwrap();
+    assert_eq!(events.diagnostics.files, 2);
+    assert_eq!(events.events.len(), 2);
+    assert_eq!(
+        events
+            .events
+            .iter()
+            .map(|event| event.tokens.input)
+            .sum::<u64>(),
+        30
+    );
+}
+
+#[test]
+fn response_records_use_native_ownership_without_recounting_inherited_totals() {
+    for copied in [false, true] {
+        let directory = tempfile::tempdir().unwrap();
+        let root = directory.path().join("sessions");
+        fs::create_dir(&root).unwrap();
+        let header = json!({"type":"session_meta","timestamp":"2026-09-29T00:00:00Z",
+            "payload":{"id":"child","forked_from_id":"parent","history_mode":"paginated",
+            "subagent_history_start_ordinal":copied.then_some(5),
+            "history_base":(!copied).then(|| json!({"end_ordinal_exclusive":2}))}});
+        let context = json!({"type":"turn_context","ordinal":2,"payload":{"model":"model"}});
+        let mut text = format!("{header}\n{context}\n");
+        for (ordinal, id, input, total) in [(3, "inherited", 100, 100), (5, "owned", 20, 120)] {
+            if !copied && ordinal == 3 {
+                continue;
+            }
+            let record = json!({"type":"token_usage_record","ordinal":ordinal,
+            "timestamp":"2026-09-29T00:00:00Z","payload":{
+                "thread_id":if ordinal == 3 { "parent" } else { "child" },
+                "response_id":id,"usage":{"input_tokens":input,"total_tokens":input}
+            }});
+            let snapshot = json!({"type":"event_msg","ordinal":ordinal+1,
+            "timestamp":"2026-09-29T00:00:00.001Z","payload":{"type":"token_count",
+                "info":{"last_token_usage":{"input_tokens":100,"total_tokens":100},
+                    "total_token_usage":{"input_tokens":total,"total_tokens":total}},
+                "rate_limits":{"plan_type":"pro","primary":{"window_minutes":10080,
+                    "used_percent":20.0,"resets_at":1800000000}}
+            }});
+            text.push_str(&format!("{record}\n{snapshot}\n"));
+        }
+        fs::write(root.join("child.jsonl"), text).unwrap();
+        let events = load(directory.path()).unwrap();
+        assert_eq!(events.events.len(), 1);
+        assert_eq!(events.events[0].tokens.input, 20);
+        assert_eq!(events.diagnostics.replayed_events, usize::from(copied));
+        assert_eq!(events.observations.len(), 1);
+        assert_eq!(events.credits.len(), 1);
+    }
+}
+
+#[test]
+fn old_session_header_does_not_hide_new_incomplete_spending_after_the_baseline() {
+    let directory = tempfile::tempdir().unwrap();
+    let root = directory.path().join("sessions");
+    fs::create_dir(&root).unwrap();
+    let header = json!({"type":"session_meta","ordinal":0,
+    "timestamp":"2026-04-10T06:28:07.717Z","payload":{
+        "id":"resumed","cli_version":"0.119.0-alpha.25","history_mode":"paginated"
+    }});
+    let initial = json!({"type":"event_msg","ordinal":1,
+    "timestamp":"2026-04-10T06:47:05.955Z","payload":{
+        "type":"token_count","info":{
+            "last_token_usage":{"total_tokens":8763},
+            "total_token_usage":{"input_tokens":161874,"output_tokens":1827,"total_tokens":163701}
+        },"rate_limits":{"credits":{"balance":"100.0"}}
+    }});
+    let path = root.join("resumed.jsonl");
+    fs::write(&path, format!("{header}\n{initial}\n")).unwrap();
+    let events = load(directory.path()).unwrap();
+    assert!(events.events.is_empty());
+    assert!(events.credits.is_empty());
+
+    let context = json!({"type":"turn_context","ordinal":2,
+        "timestamp":"2026-10-15T01:00:00Z","payload":{"model":"gpt-5.4"}});
+    let incomplete = json!({"type":"event_msg","ordinal":3,
+    "timestamp":"2026-10-15T01:01:00Z","payload":{
+        "type":"token_count","info":{
+            "last_token_usage":{"total_tokens":8763},
+            "total_token_usage":{"input_tokens":161894,"output_tokens":1832,"total_tokens":163726}
+        },"rate_limits":{"credits":{"balance":"100.0"}}
+    }});
+    fs::write(
+        &path,
+        format!("{header}\n{initial}\n{context}\n{incomplete}\n{incomplete}\n"),
+    )
+    .unwrap();
+    let events = load(directory.path()).unwrap();
+    assert_eq!(events.events.len(), 1);
+    assert_eq!(events.events[0].tokens.input, 20);
+    assert_eq!(events.events[0].tokens.output, 5);
+    assert_eq!(events.events[0].tokens.total, 25);
+    assert_eq!(events.models[events.events[0].model], "gpt-5.4");
+    assert_eq!(events.credits.len(), 1);
+    assert_eq!(events.diagnostics.malformed_records, 0);
+    assert_eq!(events.diagnostics.replayed_events, 0);
+}
