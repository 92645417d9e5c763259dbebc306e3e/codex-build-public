+use super::types::CreditObservation;
+pub(super) use codex_app_server_protocol::UsageCreditPeriod as Period;
+use std::collections::BTreeMap;
+
+const RECENT_DAYS: i64 = 90;
+
+pub(super) fn summarize(
+    costs: &BTreeMap<i64, f64>,
+    observations: &mut Vec<CreditObservation>,
+    now: i64,
+) -> Vec<Period> {
+    let since = now.saturating_sub(RECENT_DAYS * 24 * 60 * 60 * 1_000);
+    observations.retain(|sample| sample.millis >= since && sample.millis <= now);
+    observations.sort_by_key(|sample| sample.millis);
+    let mut periods = Vec::new();
+    let mut current: Option<(Period, f64)> = None;
+    let mut previous: Option<(&CreditObservation, f64)> = None;
+    let mut costs = costs.iter().peekable();
+    let mut cumulative_cost = 0.0;
+    for same_instant in observations.chunk_by(|left, right| left.millis == right.millis) {
+        let sample = &same_instant[0];
+        // Returned balances describe the preceding request, just like quota observations.
+        while let Some((_, cost)) = costs.next_if(|(millis, _)| **millis < sample.millis) {
+            cumulative_cost += cost;
+        }
+        let prior = previous.replace((sample, cumulative_cost));
+        let interval = if same_instant.iter().any(|other| {
+            other.balance != sample.balance || other.quota_exhausted != sample.quota_exhausted
+        }) {
+            // A conflicting instant cannot choose either side of a billing interval.
+            previous = None;
+            None
+        } else {
+            prior.and_then(|(prior, prior_cost)| {
+                prior
+                    .balance
+                    .zip(sample.balance)
+                    .map(|(before, after)| (prior, prior_cost, before, after))
+            })
+        };
+        if let Some((prior, prior_cost, before, after)) = interval {
+            let cost = cumulative_cost - prior_cost;
+            if let Some((period, lowest_balance)) = &mut current {
+                // Concurrent responses can return an older, higher balance. Only a
+                // new low proves additional spending; a plateau is not recovery.
+                if after < *lowest_balance || sample.quota_exhausted {
+                    period.ended_at.clone_from(&sample.timestamp);
+                    period.used_credits += (*lowest_balance - after).max(0.0);
+                    *lowest_balance = lowest_balance.min(after);
+                    period.observed_cost_usd += cost;
+                    period.sample_count += 1;
+                    continue;
+                }
+            } else if after < before {
+                current = Some((
+                    Period {
+                        started_at: prior.timestamp.clone(),
+                        ended_at: sample.timestamp.clone(),
+                        used_credits: before - after,
+                        observed_cost_usd: cost,
+                        model_usage: None,
+                        sample_count: 2,
+                    },
+                    after,
+                ));
+                continue;
+            }
+        }
+        if let Some((period, _)) = current.take() {
+            periods.push(period);
+        }
+    }
+    if let Some((period, _)) = current {
+        periods.push(period);
+    }
+    periods
+}
+
