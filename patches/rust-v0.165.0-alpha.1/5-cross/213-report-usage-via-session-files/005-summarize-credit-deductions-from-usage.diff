+use super::*;
+use pretty_assertions::assert_eq;
+
+const BASE: i64 = 1_790_000_000_000;
+
+fn sample(seconds: i64, balance: Option<f64>) -> CreditObservation {
+    let millis = BASE + seconds * 1_000;
+    CreditObservation {
+        timestamp: chrono::DateTime::from_timestamp_millis(millis)
+            .unwrap()
+            .to_rfc3339(),
+        millis,
+        balance,
+        quota_exhausted: false,
+    }
+}
+
+fn costs(entries: &[(i64, f64)]) -> BTreeMap<i64, f64> {
+    entries
+        .iter()
+        .map(|(seconds, cost)| (BASE + seconds * 1_000, *cost))
+        .collect()
+}
+
+#[test]
+fn credit_only_deductions_use_preceding_costs_and_stop_at_unchanged_or_higher_balances() {
+    let mut observations = [1000.0, 999.75, 998.5, 998.5, 1098.5, 1098.0, 1097.99]
+        .into_iter()
+        .enumerate()
+        .map(|(index, balance)| sample(index as i64 * 10, Some(balance)))
+        .collect();
+    let periods = summarize(
+        &costs(&[
+            (0, 2.0),
+            (10, 3.0),
+            (20, 77.0),
+            (30, 88.0),
+            (40, 4.0),
+            (50, 0.08),
+            (60, 999.0),
+        ]),
+        &mut observations,
+        BASE + 70_000,
+    );
+    assert_eq!(periods.len(), 2);
+    assert_eq!(periods[0].started_at, sample(0, None).timestamp);
+    assert_eq!(periods[0].ended_at, sample(20, None).timestamp);
+    assert_eq!(periods[0].used_credits, 1.5);
+    assert_eq!(periods[0].observed_cost_usd, 5.0);
+    assert_eq!(periods[0].sample_count, 3);
+    assert_eq!(periods[1].started_at, sample(40, None).timestamp);
+    assert_eq!(periods[1].ended_at, sample(60, None).timestamp);
+    assert!((periods[1].used_credits - 0.51).abs() < 1e-9);
+    assert!((periods[1].observed_cost_usd - 4.08).abs() < 1e-9);
+    assert_eq!(periods[1].sample_count, 3);
+}
+
+#[test]
+fn duplicate_delivery_does_not_bridge_missing_or_conflicting_balances() {
+    let mut observations = vec![
+        sample(0, Some(100.0)),
+        sample(10, Some(90.0)),
+        sample(10, Some(90.0)),
+        sample(20, None),
+        sample(30, Some(80.0)),
+        sample(40, Some(79.0)),
+        sample(40, Some(78.0)),
+        sample(50, Some(70.0)),
+        sample(60, Some(69.0)),
+    ];
+    for observation in &mut observations {
+        observation.quota_exhausted = true;
+    }
+    observations.reverse();
+    let periods = summarize(
+        &costs(&[
+            (0, 1.0),
+            (10, 500.0),
+            (20, 500.0),
+            (30, 500.0),
+            (40, 500.0),
+            (50, 2.0),
+        ]),
+        &mut observations,
+        BASE + 70_000,
+    );
+    assert_eq!(periods.len(), 2);
+    assert_eq!(periods[0].used_credits, 10.0);
+    assert_eq!(periods[0].observed_cost_usd, 1.0);
+    assert_eq!(periods[0].sample_count, 2);
+    assert_eq!(periods[1].started_at, sample(50, None).timestamp);
+    assert_eq!(periods[1].used_credits, 1.0);
+    assert_eq!(periods[1].observed_cost_usd, 2.0);
+    assert_eq!(periods[1].sample_count, 2);
+}
+
+#[test]
+fn report_window_does_not_infer_deductions_from_old_or_future_balances() {
+    let mut observations = vec![
+        sample(-91 * 86_400, Some(1000.0)),
+        sample(0, Some(100.0)),
+        sample(10, Some(99.5)),
+        sample(30, Some(10.0)),
+    ];
+    let periods = summarize(
+        &costs(&[(0, 2.0), (10, 999.0)]),
+        &mut observations,
+        BASE + 20_000,
+    );
+    assert_eq!(periods.len(), 1);
+    assert_eq!(periods[0].started_at, sample(0, None).timestamp);
+    assert_eq!(periods[0].ended_at, sample(10, None).timestamp);
+    assert_eq!(periods[0].used_credits, 0.5);
+    assert_eq!(periods[0].observed_cost_usd, 2.0);
+}
+
+#[test]
+fn exhausted_windows_keep_plateaus_and_delayed_balances_until_deductions_stop_after_recovery() {
+    let mut observations: Vec<_> = [
+        (100.0, true),
+        (99.0, true),
+        (99.0, true),
+        (99.5, true),
+        (98.0, true),
+        (98.0, true),
+        (97.0, false),
+        (96.0, false),
+        (96.0, false),
+        (96.0, false),
+        (96.0, true),
+        (95.0, true),
+        (95.0, false),
+    ]
+    .into_iter()
+    .enumerate()
+    .map(|(index, (balance, quota_exhausted))| CreditObservation {
+        quota_exhausted,
+        ..sample(index as i64 * 10, Some(balance))
+    })
+    .collect();
+    let charges = costs(&(0..13).map(|index| (index * 10, 1.0)).collect::<Vec<_>>());
+    let periods = summarize(&charges, &mut observations, BASE + 130_000);
+    assert_eq!(periods.len(), 2);
+    assert_eq!(periods[0].started_at, observations[0].timestamp);
+    assert_eq!(periods[0].ended_at, observations[7].timestamp);
+    assert_eq!(periods[0].used_credits, 4.0);
+    assert_eq!(periods[0].observed_cost_usd, 7.0);
+    assert_eq!(periods[0].sample_count, 8);
+    assert_eq!(periods[1].started_at, observations[10].timestamp);
+    assert_eq!(periods[1].ended_at, observations[11].timestamp);
+    assert_eq!(periods[1].used_credits, 1.0);
+    assert_eq!(periods[1].observed_cost_usd, 1.0);
+
+    observations.truncate(6);
+    let open = summarize(&charges, &mut observations, BASE + 130_000);
+    assert_eq!(open.len(), 1);
+    assert_eq!(open[0].ended_at, observations[5].timestamp);
+    assert_eq!(open[0].used_credits, 2.0);
+    assert_eq!(open[0].observed_cost_usd, 5.0);
+}
