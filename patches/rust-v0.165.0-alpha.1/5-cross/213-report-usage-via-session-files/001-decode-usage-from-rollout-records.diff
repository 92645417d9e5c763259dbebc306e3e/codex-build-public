+++ b/codex-rs/app-server/src/usage/wire_tests.rs
@@ -0,0 +1,571 @@
+use super::*;
+use pretty_assertions::assert_eq;
+use serde_json::Value;
+use serde_json::json;
+
+fn parse_values(values: &[Value]) -> ParsedFile {
+    let text = values
+        .iter()
+        .map(|value| format!("{value}\n"))
+        .collect::<String>();
+    read_lines(std::io::Cursor::new(text), "thread").unwrap()
+}
+
+fn context() -> Value {
+    json!({"type":"turn_context", "payload":{"model":"gpt-5.4", "effort":"high"}})
+}
+fn usage() -> Value {
+    json!({"input_tokens":100,"cached_input_tokens":20,"cache_write_input_tokens":10,
+    "output_tokens":50,"reasoning_output_tokens":30,"total_tokens":150})
+}
+fn snapshot() -> Value {
+    json!({"type":"event_msg","timestamp":"2026-09-29T01:00:00.001Z",
+    "payload":{"type":"token_count","info":{"last_token_usage":usage(),"total_token_usage":usage()}}})
+}
+
+fn response_record(id: &str, usage: Value, at: &str) -> Value {
+    json!({"type":"token_usage_record","timestamp":at,
+        "payload":{"thread_id":"thread","response_id":id,"usage":usage}})
+}
+
+fn reported_usage(input: u64, output: u64) -> Value {
+    json!({"input_tokens":input,"output_tokens":output,"total_tokens":input+output})
+}
+
+fn incomplete_turn(previous_completion: bool, response_records: bool) -> Vec<Value> {
+    let mut values = vec![context()];
+    if previous_completion {
+        if response_records {
+            values.push(response_record(
+                "complete",
+                usage(),
+                "2026-09-29T01:00:00.000Z",
+            ));
+        }
+        values.push(snapshot());
+    }
+    let mut incomplete = snapshot();
+    incomplete["timestamp"] = json!("2026-09-29T01:01:00.001Z");
+    incomplete["payload"]["info"] = json!({
+        "total_token_usage": {
+            "input_tokens": if previous_completion { 120 } else { 20 },
+            "cached_input_tokens": if previous_completion { 20 } else { 0 },
+            "cache_write_input_tokens": if previous_completion { 10 } else { 0 },
+            "output_tokens": if previous_completion { 55 } else { 5 },
+            "total_tokens": if previous_completion { 175 } else { 25 },
+        },
+        "last_token_usage": if previous_completion { usage() } else { reported_usage(0, 0) },
+    });
+    if response_records {
+        values.push(response_record(
+            "incomplete",
+            reported_usage(20, 5),
+            "2026-09-29T01:01:00.000Z",
+        ));
+    }
+    values.extend([incomplete.clone(), incomplete]);
+    values
+}
+
+#[test]
+fn repeated_cumulative_snapshot_does_not_repeat_last_usage() {
+    let parsed = parse_values(&[context(), snapshot(), snapshot()]);
+    assert_eq!(parsed.events.len(), 1);
+    assert_eq!(parsed.events[0].tokens.total, 150);
+}
+
+#[test]
+fn response_record_and_snapshot_are_not_added_together() {
+    let response = response_record("response", usage(), "2026-09-29T01:00:00.000Z");
+    let parsed = parse_values(&[context(), response, snapshot()]);
+    assert_eq!(parsed.events.len(), 1);
+    assert_eq!(parsed.events[0].millis, 1_790_643_600_000);
+    assert!(!parsed.events[0].primary_weekly);
+    assert_eq!(parsed.credits[0].1.millis, 1_790_643_600_000);
