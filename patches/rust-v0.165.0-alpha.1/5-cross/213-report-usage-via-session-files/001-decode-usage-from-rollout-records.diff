+use super::types::CreditObservation;
+use super::types::Observation;
+use super::types::Tokens;
+use chrono::DateTime;
+use codex_protocol::account::PlanType;
+use serde::Deserialize;
+use std::borrow::Cow;
+use std::io::BufRead;
+
+#[derive(Debug)]
+pub(super) struct Event {
+    /// Response arrival owns accounting and paired quota/credit observation time.
+    /// Legacy snapshots without a response record retain their recorded time.
+    pub(super) millis: i64,
+    /// Only a paired Pro-family primary weekly window establishes quota spending ownership.
+    pub(super) primary_weekly: bool,
+    pub(super) model: usize,
+    pub(super) tokens: Tokens,
+    pub(super) response: Option<Box<(String, String)>>,
+}
+
+#[derive(Default)]
+pub(super) struct ParsedFile {
+    pub(super) events: Vec<Event>,
+    pub(super) models: Vec<String>,
+    pub(super) observations: Vec<(usize, Observation)>,
+    pub(super) credits: Vec<(usize, CreditObservation)>,
+    pub(super) first_usage_times: Vec<i64>,
+    pub(super) inherited_events: usize,
+    pub(super) malformed: usize,
+    pub(super) incomplete: usize,
+}
+
+enum PendingRecord {
+    Owned { index: usize, timestamp: String },
+    Inherited,
+}
+
+#[derive(Deserialize)]
+struct Entry<'a> {
+    #[serde(rename = "type")]
+    kind: &'a str,
+    timestamp: Option<&'a str>,
+    #[serde(borrow)]
+    payload: Payload<'a>,
+}
+
+#[derive(Deserialize)]
+struct Payload<'a> {
+    #[serde(rename = "type")]
+    kind: Option<&'a str>,
+    #[serde(borrow)]
+    model: Option<Cow<'a, str>>,
+    #[serde(borrow)]
+    thread_id: Option<Cow<'a, str>>,
+    #[serde(borrow)]
+    response_id: Option<Cow<'a, str>>,
+    usage: Option<WireTokens>,
+    info: Option<Info>,
+    #[serde(borrow)]
+    thread_settings: Option<Settings<'a>>,
+    rate_limits: Option<Limits>,
+}
+
+#[derive(Deserialize)]
+struct Settings<'a> {
+    #[serde(borrow)]
+    model: Option<Cow<'a, str>>,
+}
+
+#[derive(Deserialize)]
+struct Limits {
+    plan_type: Option<PlanType>,
+    primary: Option<Limit>,
+    secondary: Option<Limit>,
+    credits: Option<Credits>,
+}
+
+#[derive(Deserialize)]
+struct Credits {
+    balance: Option<String>,
+}
+
+#[derive(Deserialize)]
+struct Limit {
+    window_minutes: Option<i64>,
+    used_percent: f64,
+    resets_at: Option<i64>,
+}
+
+#[derive(Deserialize)]
+struct Info {
+    total_token_usage: Option<WireTokens>,
+    last_token_usage: Option<WireTokens>,
+}
+
+#[derive(Default, Deserialize)]
+#[serde(default)]
+struct WireTokens {
+    input_tokens: i64,
+    cached_input_tokens: i64,
+    cache_write_input_tokens: i64,
+    output_tokens: i64,
+    reasoning_output_tokens: i64,
+    total_tokens: i64,
+}
+
+impl WireTokens {
+    fn tokens(self) -> Tokens {
+        // Migrated canonical logs can preserve negative provider counters.
+        // Discard that field, not the remaining valid usage.
+        let input = self.input_tokens.max(0) as u64;
+        let output = self.output_tokens.max(0) as u64;
+        let cached = (self.cached_input_tokens.max(0) as u64).min(input);
+        Tokens {
+            input,
+            cached,
+            cache_write: (self.cache_write_input_tokens.max(0) as u64).min(input - cached),
+            output,
+            reasoning: self.reasoning_output_tokens.max(0) as u64,
+            total: if self.total_tokens <= 0 {
+                input.saturating_add(output)
+            } else {
+                self.total_tokens as u64
+            },
+        }
+    }
+}
+
+pub(super) fn timestamp(value: &str) -> Option<i64> {
+    Some(DateTime::parse_from_rfc3339(value).ok()?.timestamp_millis())
+}
+
+pub(super) fn intern_model(models: &mut Vec<String>, model: Cow<'_, str>) -> usize {
+    let text = model.trim();
+    if let Some(index) = models.iter().position(|known| known == text) {
+        return index;
+    }
+    let index = models.len();
+    models.push(if text.len() == model.len() {
+        model.into_owned()
+    } else {
+        text.to_owned()
+    });
+    index
+}
+
+/// Native rollout writers place their discriminants before the potentially large payload.
+/// Other JSON layouts retain the ordinary candidate filter and serde decoder below.
+fn native_accounting_record(line: &[u8]) -> Option<bool> {
+    let mut fields = line
+        .strip_prefix(b"{\"timestamp\":\"")?
+        .splitn(2, |byte| *byte == b',');
+    let timestamp = fields.next()?.strip_suffix(b"\"")?;
+    if timestamp.contains(&b'"') || timestamp.contains(&b'\\') {
+        return None;
+    }
+    let rest = fields.next()?;
+    let rest = if let Some(rest) = rest.strip_prefix(b"\"ordinal\":") {
+        rest.splitn(2, |byte| *byte == b',').nth(1)?
+    } else {
+        rest
+    };
+    let mut fields = rest
+        .strip_prefix(b"\"type\":\"")?
+        .splitn(2, |byte| *byte == b'"');
+    let kind = fields.next()?;
+    let payload = fields.next()?.strip_prefix(b",\"payload\":")?;
+    if kind.contains(&b'\\') {
+        return None;
+    }
+    match kind {
+        b"token_usage_record" | b"turn_context" => Some(true),
+        b"event_msg" => {
+            let mut fields = payload
+                .strip_prefix(b"{\"type\":\"")?
+                .splitn(2, |byte| *byte == b'"');
+            let kind = fields.next()?;
+            if kind.contains(&b'\\') || !matches!(fields.next()?.first(), Some(b',' | b'}')) {
+                return None;
+            }
+            Some(matches!(
+                kind,
+                b"token_count" | b"thread_settings_applied" | b"task_started"
+            ))
+        }
+        _ => Some(false),
+    }
+}
+
+pub(super) fn read_lines(
+    mut reader: impl BufRead,
+    owner_thread_id: &str,
+) -> Result<ParsedFile, super::Error> {
+    let mut line = Vec::new();
+    let mut parsed = ParsedFile::default();
+    let mut previous: Option<(Tokens, Option<Tokens>)> = None;
+    let mut pending_record = None;
+    let mut model = None;
+    let mut next_task_model = None;
+    loop {
+        line.clear();
+        if reader.read_until(b'\n', &mut line)? == 0 {
+            break;
+        }
+        if !line.ends_with(b"\n") {
+            parsed.incomplete += 1;
+            break;
+        }
+        // Most retained bytes are conversation payloads. Their native envelope
+        // can exclude them without decoding and validating that text as UTF-8.
+        let accounting = native_accounting_record(&line);
+        if accounting == Some(false) {
+            continue;
+        }
+        let line = std::str::from_utf8(&line)?;
+        if !accounting.unwrap_or_else(|| {
+            [
+                "token_count",
+                "token_usage_record",
+                "turn_context",
+                "thread_settings_applied",
+                "task_started",
+            ]
+            .iter()
+            .any(|kind| line.contains(kind))
+        }) {
+            continue;
+        }
+        let value: Entry<'_> = match serde_json::from_str(line) {
+            Ok(value) => value,
+            Err(_) => {
+                parsed.malformed += 1;
+                continue;
+            }
+        };
+        let payload = value.payload;
+        match value.kind {
+            "turn_context" => {
+                // A later request cannot associate an earlier standalone record with its quota.
+                pending_record = None;
+                if let Some(recorded) = payload.model.filter(|model| !model.trim().is_empty()) {
+                    model = Some(intern_model(&mut parsed.models, recorded));
+                }
+            }
+            "token_usage_record" => {
+                let (Some(thread_id), Some(response_id), Some(usage), Some((recorded, millis))) = (
+                    payload.thread_id,
+                    payload.response_id,
+                    payload.usage,
+                    value
+                        .timestamp
+                        .and_then(|text| timestamp(text).map(|millis| (text, millis))),
+                ) else {
+                    parsed.malformed += 1;
+                    continue;
+                };
+                let tokens = usage.tokens();
+                if tokens.is_empty() {
+                    continue;
+                }
+                if thread_id.as_ref() != owner_thread_id {
+                    parsed.inherited_events += 1;
+                    pending_record = Some(PendingRecord::Inherited);
+                    continue;
+                }
+                let model_id = model
+                    .unwrap_or_else(|| intern_model(&mut parsed.models, "unknown model".into()));
+                pending_record = Some(PendingRecord::Owned {
+                    index: parsed.events.len(),
+                    timestamp: recorded.to_owned(),
+                });
+                parsed.events.push(Event {
+                    millis,
+                    primary_weekly: false,
+                    model: model_id,
+                    tokens,
+                    response: Some(Box::new((thread_id.into_owned(), response_id.into_owned()))),
+                });
+            }
+            "event_msg" => match payload.kind {
+                Some("task_started") => {
+                    pending_record = None;
+                    model = next_task_model.or(model);
+                }
+                Some("thread_settings_applied") => {
+                    if let Some(settings) = payload.thread_settings {
+                        if payload.thread_id.as_deref() == Some(owner_thread_id)
+                            && let Some(recorded) =
+                                settings.model.filter(|model| !model.trim().is_empty())
+                        {
+                            next_task_model = Some(intern_model(&mut parsed.models, recorded));
+                        }
+                    }
+                }
+                Some("token_count") => {
+                    let Some((recorded, millis)) = value
+                        .timestamp
+                        .and_then(|text| timestamp(text).map(|millis| (text, millis)))
+                    else {
+                        parsed.malformed += 1;
+                        continue;
+                    };
+                    let Some(info) = payload.info else {
+                        continue;
+                    };
+                    let cumulative = info.total_token_usage.map(WireTokens::tokens);
+                    let last = info.last_token_usage.map(WireTokens::tokens);
+                    let advanced = cumulative
+                        .is_none_or(|current| previous.is_none_or(|(total, _)| current != total));
+                    let delta = cumulative.map(|current| {
+                        current.subtract(previous.map(|(total, _)| total).unwrap_or_default())
+                    });
+                    // Official incomplete responses add spending but leave installed last
+                    // usage unchanged. Legacy snapshots otherwise follow ccusage's last-first
+                    // accounting, including skipping context-only last usage after compaction.
+                    let spending_only = match (cumulative, last, previous) {
+                        (Some(current), Some(last), Some((total, previous_last))) => {
+                            current.total > total.total && previous_last == Some(last)
+                        }
+                        (Some(_), Some(last), None) => last.is_empty() && last.total == 0,
+                        _ => false,
+                    };
+                    let tokens = if spending_only {
+                        delta
+                    } else {
+                        last.filter(|_| advanced).or(delta)
+                    };
+                    if let Some(cumulative) = cumulative {
+                        previous = Some((cumulative, last));
+                    }
+                    if let Some(recorded) = payload.model.filter(|model| !model.trim().is_empty()) {
+                        model = Some(intern_model(&mut parsed.models, recorded));
+                    }
+                    let response_record = pending_record.take();
+                    if matches!(response_record, Some(PendingRecord::Inherited)) {
+                        continue;
+                    }
+                    let weekly = payload
+                        .rate_limits
+                        .as_ref()
+                        .filter(|limits| {
+                            matches!(
+                                limits.plan_type,
+                                Some(PlanType::Pro | PlanType::ProLite | PlanType::ProMax)
+                            )
+                        })
+                        .and_then(|limits| limits.primary.as_ref())
+                        .filter(|window| window.window_minutes == Some(10_080));
+                    let primary_weekly = weekly.is_some();
+                    if let Some(PendingRecord::Owned { index, .. }) = &response_record {
+                        parsed.events[*index].primary_weekly = primary_weekly;
+                    }
+                    if (cumulative.is_some() || last.is_some())
+                        && parsed.first_usage_times.len() < 2
+                    {
+                        parsed.first_usage_times.push(millis);
+                    }
+                    let Some(tokens) = tokens.filter(|tokens| !tokens.is_empty()) else {
+                        // Foreground compaction may retain a response record but only recompute
+                        // context here. Keep that charge without inventing a quota observation.
+                        continue;
+                    };
+                    let (event_index, observed_at) =
+                        if let Some(PendingRecord::Owned { index, timestamp }) = response_record {
+                            // Token counts wait for pending tools, but their quota and balance
+                            // were already observed with this response, possibly hours earlier.
+                            // Keep the observation and its carrying charge at the same boundary
+                            // so the measurement still excludes that response's own usage.
+                            (index, timestamp)
+                        } else {
+                            // Missing model metadata is not proof of a default or reviewer backend.
+                            let index = parsed.events.len();
+                            parsed.events.push(Event {
+                                millis,
+                                primary_weekly,
+                                model: model.unwrap_or_else(|| {
+                                    intern_model(&mut parsed.models, "unknown model".into())
+                                }),
+                                tokens,
+                                response: None,
+                            });
+                            (index, recorded.to_owned())
+                        };
+                    let observed_millis = parsed.events[event_index].millis;
+                    let credit_balance = payload
+                        .rate_limits
+                        .as_ref()
+                        .and_then(|limits| limits.credits.as_ref())
+                        .and_then(|credits| credits.balance.as_deref())
+                        .and_then(|balance| balance.parse::<f64>().ok())
+                        .filter(|balance| balance.is_finite());
+                    let quota_exhausted = payload.rate_limits.as_ref().is_some_and(|limits| {
+                        [limits.primary.as_ref(), limits.secondary.as_ref()]
+                            .into_iter()
+                            .flatten()
+                            .any(|window| window.used_percent == 100.0)
+                    });
+                    // Credit deductions are observable even without a weekly quota window.
+                    // Keep missing balances so the report cannot span an unknown interval.
+                    parsed.credits.push((
+                        event_index,
+                        CreditObservation {
+                            timestamp: observed_at.clone(),
+                            millis: observed_millis,
+                            balance: credit_balance,
+                            quota_exhausted,
+                        },
+                    ));
+                    if let Some(weekly) = weekly
+                        && (0.0..=100.0).contains(&weekly.used_percent)
+                        && let Some(resets_at) = weekly.resets_at
+                    {
+                        parsed.observations.push((
+                            event_index,
+                            Observation {
+                                timestamp: observed_at,
+                                millis: observed_millis,
+                                used_percent: weekly.used_percent,
+                                resets_at,
+                                credit_balance,
+                            },
+                        ));
+                    }
+                }
+                _ => {}
+            },
+            _ => {}
+        }
+    }
+    Ok(parsed)
+}
+
