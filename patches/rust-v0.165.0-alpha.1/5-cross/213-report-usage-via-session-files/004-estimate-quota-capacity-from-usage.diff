+#[test]
+fn reset_closes_previous_cycle_and_keeps_current_provisional() {
+    let mut observations = vec![
+        sample(
+            /*seconds*/ 0, /*percent*/ 0.0, /*reset*/ 10_000,
+        ),
+        sample(
+            /*seconds*/ 600, /*percent*/ 100.0, /*reset*/ 10_000,
+        ),
+        sample(
+            /*seconds*/ 700, /*percent*/ 7.0, /*reset*/ 20_000,
+        ),
+        sample(
+            /*seconds*/ 800, /*percent*/ 57.0, /*reset*/ 20_000,
+        ),
+    ];
+    let estimates = estimate(
+        &costs(&[(0, 100.0), (600, 7.0), (700, 50.0), (800, 9.0)]),
+        &mut observations,
+        BASE + 900_000,
+    );
+    assert_eq!(estimates.len(), 2);
+    assert_eq!(estimates[0].status, Status::Completed);
+    assert_eq!(estimates[1].status, Status::Provisional);
+    // Each returned percentage excludes its own request. Charge the request at
+    // the start, not the one at the end, independently for each reset cycle.
+    assert_eq!(estimates[0].observed_cost_usd, 100.0);
+    // The first returned percentage after reset also includes the preceding
+    // request, even though that request still carried the old quota snapshot.
+    assert_eq!(estimates[1].started_at, observations[1].timestamp);
+    assert_eq!(estimates[1].used_percent_start, 0.0);
+    assert_eq!(estimates[1].observed_cost_usd, 57.0);
+    assert_eq!(estimates[1].estimated_weekly_cost_usd, 100.0);
+}
