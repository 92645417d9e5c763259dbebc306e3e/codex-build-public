+    let day = 24 * 60 * 60;
+    let first_new = 3 * day + 4 * 60 * 60;
+    let last_new = 10 * day - 60;
+    let mut observations = vec![
+        sample(-4 * day, 0.0, 3 * day),
+        sample(0, 100.0, 3 * day),
+        sample(first_new, 0.0, 10 * day),
+        sample(last_new, 99.0, 10 * day),
+        sample(10 * day + 10, 0.0, 17 * day),
+    ];
+    let estimates = estimate(
+        &costs(&[
+            (-4 * day, 100.0),
+            (0, 900.0),
+            (first_new, 990.0),
+            (last_new, 9.0),
+        ]),
+        &mut observations,
+        BASE + (10 * day + 20) * 1_000,
+    );
+    assert_eq!(estimates.len(), 2);
+    assert_eq!(estimates[0].observed_cost_usd, 100.0);
+    let current = &estimates[1];
