+#[test]
+fn continuous_intervals_use_plateaus_instead_of_only_the_endpoints() {
+    let mut observations = vec![sample(0, 20.0, 10_000)];
+    let mut charges = Vec::new();
+    let mut previous_cost = 0.0;
+    // True usage starts at 20.9% of a $100 quota. The first and last integer
+    // observations alone suggest $92; averaging intermediate intervals reduces
+    // that endpoint rounding bias without pretending the result is exact.
+    for step in 1..=10 {
+        for cost in [f64::from(step) - 0.8, f64::from(step)] {
+            if cost > 9.2 {
+                break;
+            }
+            let seconds = observations.len() as i64 * 10;
+            charges.push((seconds - 10, cost - previous_cost));
+            observations.push(sample(seconds, (20.9 + cost).floor(), 10_000));
+            previous_cost = cost;
+        }
+    }
+    let estimates = estimate(&costs(&charges), &mut observations, BASE + 900_000);
+    assert_eq!(estimates.len(), 1);
+    assert_eq!(estimates[0].sample_count, observations.len());
+    assert!((estimates[0].observed_cost_usd - 9.2).abs() < 1e-12);
+    let endpoint_estimate = estimates[0].observed_cost_usd * 100.0
+        / (estimates[0].used_percent_end - estimates[0].used_percent_start);
+    assert!((endpoint_estimate - 92.0).abs() < 1e-12);
+    assert!(
+        (estimates[0].estimated_weekly_cost_usd - 100.0).abs()
+            < (endpoint_estimate - 100.0).abs() / 2.0
+    );
+}
