+#[test]
+fn local_record_gaps_and_other_devices_do_not_bias_thousands_of_intact_measurements() {
+    let mut maximum_extra_error = 0.0_f64;
+    for capacity in [100.0, 1500.0, 10_000.0] {
+        for phase in [0.01, 0.49, 0.99] {
+            for pattern in 0..3 {
+                let complete = dense_measurement(capacity, phase, pattern, 0..0, true, None);
+                let complete_error = (complete.estimated_weekly_cost_usd / capacity - 1.0).abs();
+                assert!(complete_error < 0.001);
+                for begin in [64, 1024, 1800, 3072] {
+                    for (length, retain_snapshots, external_percent) in [
+                        (1, false, 0.0),
+                        (1, true, 0.0),
+                        (257, false, 0.0),
+                        (257, true, 0.0),
+                        (700, false, 0.0),
+                        (700, true, 0.0),
+                        (0, true, 1.0),
+                        (0, true, 20.0),
+                        (0, true, 35.0),
+                    ] {
+                        let missing = dense_measurement(
+                            capacity,
+                            phase,
+                            pattern,
+                            begin..begin + length,
+                            retain_snapshots,
+                            (external_percent > 0.0).then_some((begin, external_percent)),
+                        );
+                        assert!(missing.sample_count >= 3000);
+                        if length > 0 {
+                            assert!(missing.observed_cost_usd < complete.observed_cost_usd);
+                        } else {
+                            assert_eq!(missing.observed_cost_usd, complete.observed_cost_usd);
+                            assert_eq!(missing.sample_count, complete.sample_count);
+                        }
+                        assert_eq!(
+                            missing.used_percent_end,
+                            complete.used_percent_end + external_percent
+                        );
+                        // Compare errors against the known capacity. An estimate
+                        // moving across the truth may improve rather than worsen.
+                        let missing_error =
+                            (missing.estimated_weekly_cost_usd / capacity - 1.0).abs();
+                        let extra_error = missing_error - complete_error;
+                        maximum_extra_error = maximum_extra_error.max(extra_error);
+                        assert!(
+                            extra_error < 0.001,
+                            "capacity={capacity} phase={phase} pattern={pattern} gap={begin}..{} snapshots={retain_snapshots} external_percent={external_percent} complete={} missing={} extra_error={extra_error}",
+                            begin + length,
+                            complete.estimated_weekly_cost_usd,
+                            missing.estimated_weekly_cost_usd
+                        );
+                        if length == 700 || external_percent > 0.0 {
+                            let endpoint = 100.0 * missing.observed_cost_usd
+                                / (missing.used_percent_end - missing.used_percent_start);
+                            assert!(missing.estimated_weekly_cost_usd > endpoint);
+                        }
+                    }
+                }
+            }
+        }
+    }
+    eprintln!(
+        "maximum missing-record or other-device extra estimation error: {} percent",
+        100.0 * maximum_extra_error
+    );
+}
