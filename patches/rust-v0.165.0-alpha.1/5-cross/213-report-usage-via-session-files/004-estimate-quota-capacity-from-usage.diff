+#[test]
+fn repeated_unchanged_snapshots_do_not_reweight_a_quota_plateau() {
+    let mut estimates = Vec::new();
+    for repetitions in [1, 30] {
+        let mut observations = Vec::new();
+        let mut charges = Vec::new();
+        let mut spent = 0.0_f64;
+        let mut seconds = 0;
+        for step in 0..=1200 {
+            let percent = (0.49 + spent).floor();
+            let repeats = if (10.0..20.0).contains(&percent) {
+                repetitions
+            } else {
+                1
+            };
+            for _ in 0..repeats {
+                observations.push(sample(seconds, percent, 100_000));
+                seconds += 1;
+            }
+            if step < 1200 {
+                let charge = if step % 7 == 0 { 0.08 } else { 0.04 };
+                charges.push((seconds - 1, charge));
+                spent += charge;
+            }
+        }
+        let result = estimate(
+            &costs(&charges),
+            &mut observations,
+            BASE + (seconds + 1) * 1000,
+        );
+        assert_eq!(result.len(), 1);
+        assert_eq!(result[0].sample_count, observations.len());
+        estimates.push(result[0].estimated_weekly_cost_usd);
+    }
+    assert_eq!(estimates[0], estimates[1]);
+}
