+use std::collections::BTreeMap;
+
+use super::types::Observation;
+pub(super) use codex_app_server_protocol::UsageQuotaEstimate as Estimate;
+pub(super) use codex_app_server_protocol::UsageQuotaStatus as Status;
+
+#[derive(Clone, Copy)]
+struct Point {
+    percent: f64,
+    cost: f64,
+}
+
+/// One continuous measurement with no intervening credit-funded interval.
+struct Segment<'a> {
+    start: &'a Observation,
+    end: &'a Observation,
+    start_cost: f64,
+    observed_cost: f64,
+    plateau_start_cost: f64,
+    points: Vec<Point>,
+    count: usize,
+}
+
+impl<'a> Segment<'a> {
+    fn new(observation: &'a Observation, cumulative_cost: f64, start_percent: f64) -> Self {
+        Self {
+            start: observation,
+            end: observation,
+            start_cost: cumulative_cost,
+            observed_cost: 0.0,
+            plateau_start_cost: 0.0,
+            points: vec![Point {
+                percent: start_percent,
+                cost: 0.0,
+            }],
+            count: 1,
+        }
+    }
+
+    fn observe(&mut self, observation: &'a Observation, cumulative_cost: f64) {
+        let cost = cumulative_cost - self.start_cost;
+        let last = self.points.len() - 1;
+        if observation.used_percent > self.points[last].percent {
+            if last > 0 {
+                // A closed quota plateau supplies both cost boundaries. Its
+                // midpoint does not give densely sampled plateaus extra weight.
+                self.points[last].cost = (self.plateau_start_cost + self.points[last].cost) / 2.0;
+            }
+            self.points.push(Point {
+                percent: observation.used_percent,
+                cost,
+            });
+            self.plateau_start_cost = cost;
+        } else if last > 0 {
+            self.points[last].cost = cost;
+        }
+        self.end = observation;
+        self.observed_cost = cost;
+        self.count += 1;
+    }
+
+    fn span(&self) -> f64 {
+        self.end.used_percent - self.points[0].percent
+    }
+}
+
+fn average_intervals(mut runs: Vec<&[Point]>) -> f64 {
+    let mut previous_count = 0;
+    let mut estimates = Vec::new();
+    loop {
+        estimates.clear();
+        let adjacent_count: usize = runs.iter().map(|points| points.len() - 1).sum();
+        for points in &runs {
+            let mut width = 1;
+            while width < points.len() {
+                // Disjoint blocks at each scale contribute fewer than twice as
+                // many intervals as adjacent pairs, not every overlapping pair.
+                let anchors = points.iter().step_by(width);
+                for (left, right) in anchors.clone().zip(anchors.skip(1)) {
+                    estimates.push(interval_estimate(*left, *right));
+                }
+                width *= 2;
+            }
+        }
+        // Only independent adjacent intervals establish sample adequacy. Runs
+        // only split, so every continuing pass removes at least one interval.
+        if adjacent_count < 8 || adjacent_count == previous_count {
+            return estimates.iter().sum::<f64>() / estimates.len() as f64;
+        }
+        previous_count = adjacent_count;
+        let center = median(&mut estimates);
+        for value in &mut estimates {
+            *value = (*value - center).abs();
+        }
+        // Refit the modified-z-score band after exclusion: otherwise a large
+        // gap widens its own band and masks partially missing edge intervals.
+        let cutoff = 3.5 * median(&mut estimates) / 0.67449;
+        let bounds = center - cutoff..=center + cutoff;
+        runs = runs
+            .into_iter()
+            .flat_map(|points| {
+                points.chunk_by(|left, right| bounds.contains(&interval_estimate(*left, *right)))
+            })
+            .filter(|points| points.len() > 1)
+            .collect();
+    }
+}
+
+fn interval_estimate(start: Point, end: Point) -> f64 {
+    100.0 * (end.cost - start.cost) / (end.percent - start.percent)
+}
+
+fn median(values: &mut [f64]) -> f64 {
+    values.sort_unstable_by(f64::total_cmp);
+    (values[values.len() / 2] + values[(values.len() - 1) / 2]) / 2.0
+}
+
+struct Cycle<'a> {
+    reset_horizon: i64,
+    segments: Vec<Segment<'a>>,
+    current: Option<Segment<'a>>,
+    completed: bool,
+}
+
+impl<'a> Cycle<'a> {
+    fn new(start: &'a Observation, segment: Segment<'a>) -> Self {
+        Self {
+            reset_horizon: start.resets_at,
+            segments: Vec::new(),
+            current: Some(segment),
+            completed: false,
+        }
+    }
+
+    fn end(&self) -> &Observation {
+        self.current
+            .as_ref()
+            .or_else(|| self.segments.last())
+            .expect("a cycle retains its last measurement segment")
+            .end
+    }
+
+    fn end_segment(&mut self) {
+        if let Some(segment) = self.current.take() {
+            self.segments.push(segment);
+        }
+    }
+
+    fn observe(
+        &mut self,
+        sample: &'a Observation,
+        cumulative_cost: f64,
+        credit_balances: Option<(f64, f64)>,
+    ) {
+        if credit_balances.is_some_and(|(before, after)| before != after) {
+            // The balance describes the preceding request. Keep the measurements
+            // before it and exclude this interval, not the rest of the cycle.
+            self.end_segment();
+            self.completed |= sample.used_percent == 100.0
+                && credit_balances.is_some_and(|(before, after)| after < before);
+        }
+        if self.completed || sample.used_percent < self.end().used_percent {
+            return;
+        }
+        match self.current.as_mut() {
+            Some(segment) => segment.observe(sample, cumulative_cost),
+            None => {
+                self.current = Some(Segment::new(sample, cumulative_cost, sample.used_percent));
+            }
+        }
+    }
+
+    fn estimate(&self, status: Status) -> Option<Estimate> {
+        let mut segments = self
+            .segments
+            .iter()
+            .chain(self.current.iter())
+            .filter(|segment| segment.span() > 0.0);
+        let first = segments.next()?;
+        let mut last = first;
+        let mut span = first.span();
+        let mut observed_cost = first.observed_cost;
+        let mut count = first.count;
+        let mut runs = vec![first.points.as_slice()];
+        for segment in segments {
+            last = segment;
+            span += segment.span();
+            observed_cost += segment.observed_cost;
+            count += segment.count;
+            runs.push(segment.points.as_slice());
+        }
+        if span <= 5.0 || observed_cost <= 0.0 {
+            return None;
+        }
+        Some(Estimate {
+            started_at: first.start.timestamp.clone(),
+            ended_at: last.end.timestamp.clone(),
+            used_percent_start: first.points[0].percent,
+            used_percent_end: last.end.used_percent,
+            observed_cost_usd: observed_cost,
+            model_usage: None,
+            estimated_weekly_cost_usd: average_intervals(runs),
+            sample_count: count,
+            status,
+        })
+    }
+}
+
+pub(super) fn estimate(
+    costs: &BTreeMap<i64, f64>,
+    observations: &mut Vec<Observation>,
+    now: i64,
+) -> Vec<Estimate> {
+    observations
+        .retain(|sample| sample.millis <= now && (0.0..=100.0).contains(&sample.used_percent));
+    observations.sort_by(|left, right| {
+        left.millis
+            .cmp(&right.millis)
+            .then_with(|| left.used_percent.total_cmp(&right.used_percent))
+            .then_with(|| left.resets_at.cmp(&right.resets_at))
+    });
+    observations.dedup_by(|left, right| {
+        left.millis == right.millis
+            && left.used_percent == right.used_percent
+            && left.resets_at == right.resets_at
+            && left.credit_balance == right.credit_balance
+    });
+    let mut estimates = Vec::new();
+    let mut cycle: Option<Cycle<'_>> = None;
+    let mut costs = costs.iter().peekable();
+    let mut cumulative_cost = 0.0;
+    let mut previous: Option<(&Observation, f64)> = None;
+    let mut index = 0;
+    while index < observations.len() {
+        let sample = &observations[index];
+        let mut end = index + 1;
+        while end < observations.len() && observations[end].millis == sample.millis {
+            end += 1;
+        }
+        let conflicting = end != index + 1;
+        index = end;
+        if conflicting {
+            continue;
+        }
+        // A response reports quota through the preceding request. Its own usage
+        // enters the next observation, so include the start and exclude the end.
+        while let Some((_, cost)) = costs.next_if(|(millis, _)| **millis < sample.millis) {
+            cumulative_cost += cost;
+        }
+        let Some(current) = cycle.as_mut() else {
+            cycle = Some(Cycle::new(
+                sample,
+                Segment::new(sample, cumulative_cost, sample.used_percent),
+            ));
+            previous = Some((sample, cumulative_cost));
+            continue;
+        };
+        if sample.resets_at < current.reset_horizon.saturating_sub(300) {
+            // An unanchored late snapshot leaves this interval's costs ambiguous.
+            // Retain earlier measurements and resume at the next current-cycle
+            // observation, regardless of how long the snapshot was delayed.
+            current.end_segment();
+            previous = None;
+            continue;
+        }
+        let prior = previous.replace((sample, cumulative_cost));
+        let credit_balances =
+            prior.and_then(|(prior, _)| prior.credit_balance.zip(sample.credit_balance));
+        let credit_changed = credit_balances.is_some_and(|(before, after)| before != after);
+        // Reset time owns cycle identity. A newly observed cycle may already have
+        // spent as much as the last observation from the previous cycle.
+        if sample.resets_at > current.reset_horizon.saturating_add(300) {
+            if let Some(estimate) = current.estimate(Status::Completed) {
+                estimates.push(estimate);
+            }
+            // Only a preceding request inside the new weekly window can supply
+            // its zero baseline. Idle gaps and early resets leave older records
+            // and their costs in the previous cycle.
+            let baseline = prior.filter(|(prior, _)| {
+                !credit_changed
+                    && sample.used_percent > 0.0
+                    && sample.used_percent + 0.5 < current.end().used_percent
+                    && prior.millis.div_euclid(1_000)
+                        >= sample.resets_at.saturating_sub(7 * 24 * 60 * 60)
+            });
+            let segment = if let Some((prior, prior_cost)) = baseline {
+                let mut restored = Segment::new(prior, prior_cost, 0.0);
+                restored.observe(sample, cumulative_cost);
+                restored
+            } else {
+                Segment::new(sample, cumulative_cost, sample.used_percent)
+            };
+            cycle = Some(Cycle::new(sample, segment));
+            continue;
+        }
+        current.observe(sample, cumulative_cost, credit_balances);
+    }
+    if let Some(cycle) = cycle {
+        let status = if cycle.completed {
+            Status::Completed
+        } else {
+            Status::Provisional
+        };
+        if let Some(estimate) = cycle.estimate(status) {
+            estimates.push(estimate);
+        }
+    }
+    estimates
+}
