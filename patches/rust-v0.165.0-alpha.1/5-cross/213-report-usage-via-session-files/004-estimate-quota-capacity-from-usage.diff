+fn dense_measurement(
+    capacity: f64,
+    phase: f64,
+    pattern: usize,
+    missing: std::ops::Range<usize>,
+    retain_snapshots: bool,
+    external_spending: Option<(usize, f64)>,
+) -> Estimate {
+    const RECORDS: usize = 4096;
+    let weights: Vec<f64> = (0..RECORDS)
+        .map(|index| match pattern {
+            0 => 1.0,
+            1 => ((index * 73 + 19) % 127 + 1) as f64,
+            _ => {
+                if index % 997 < 199 {
+                    7.0
+                } else {
+                    1.0
+                }
+            }
+        })
+        .collect();
+    let unit_cost = capacity * 0.52 / weights.iter().sum::<f64>();
+    let mut spent = 0.0;
+    let mut observations = Vec::new();
+    let mut charges = Vec::new();
+    for index in 0..=RECORDS {
+        if retain_snapshots || !missing.contains(&index) {
+            let external_percent = external_spending
+                .filter(|(after, _)| index >= *after)
+                .map_or(0.0, |(_, percent)| percent);
+            observations.push(sample(
+                index as i64,
+                (phase + 100.0 * spent / capacity + external_percent).floor(),
+                10_000,
+            ));
+        }
+        if let Some(weight) = weights.get(index) {
+            let charge = weight * unit_cost;
+            if !missing.contains(&index) {
+                charges.push((index as i64, charge));
+            }
+            spent += charge;
+        }
+    }
+    let mut estimates = estimate(&costs(&charges), &mut observations, BASE + 5_000_000);
+    assert_eq!(estimates.len(), 1);
+    assert_eq!(estimates[0].sample_count, observations.len());
+    estimates.remove(0)
+}
