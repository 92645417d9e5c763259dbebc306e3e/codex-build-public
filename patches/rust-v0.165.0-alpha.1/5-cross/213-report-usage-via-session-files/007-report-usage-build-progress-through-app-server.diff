+
+#[test]
+fn completed_file_progress_includes_skipped_files_and_keeps_accounting_separate() {
+    let home = tempfile::tempdir().unwrap();
+    let sessions = home.path().join("sessions");
+    fs::create_dir(&sessions).unwrap();
+    for index in 0..128 {
+        fs::write(
+            sessions.join(format!("{index}.jsonl")),
+            "{\"type\":\"session_meta\",\"payload\":{\"history_mode\":\"paginated\"}}\n",
+        )
+        .unwrap();
+    }
+    fs::write(
+        sessions.join("linear.jsonl"),
+        "{\"type\":\"session_meta\",\"payload\":{\"history_mode\":\"linear\"}}\n",
+    )
+    .unwrap();
+    fs::write(sessions.join("malformed.jsonl"), "{\n").unwrap();
+    let (progress, observed) = watch::channel(UsageBuildProgress::default());
+    let report = crate::usage::load(home.path(), &progress).unwrap();
+    assert_eq!(
+        *observed.borrow(),
+        UsageBuildProgress {
+            phase: UsageBuildPhase::Publishing,
+            files_processed: 130,
+            files_total: Some(130),
+        }
+    );
+    assert_eq!(report.diagnostics.files, 128);
+    assert_eq!(report.diagnostics.skipped_non_paginated, 1);
+    assert_eq!(report.diagnostics.malformed_records, 1);
+}
+
+#[tokio::test(start_paused = true)]
+async fn progress_is_request_scoped_rate_bounded_and_absent_for_cached_reads() {
+    let home = tempfile::tempdir().unwrap();
+    let service = Arc::new(Service::new(home.path().to_path_buf()));
+    let lock = service.cached.lock().await;
+    let (tx, mut rx) = mpsc::channel(16);
+    let outgoing = Arc::new(OutgoingMessageSender::new(
+        tx,
+        codex_analytics::AnalyticsEventsClient::disabled(),
+    ));
+    let mut readers = Vec::new();
+    for connection in [7, 8] {
+        let service = Arc::clone(&service);
+        let outgoing = Arc::clone(&outgoing);
+        readers.push(tokio::spawn(async move {
+            service
+                .read(
+                    UsageReadParams::default(),
+                    &ConnectionRequestId {
+                        connection_id: ConnectionId(connection),
+                        request_id: RequestId::String(connection.to_string()),
+                    },
+                    &outgoing,
+                )
+                .await
+                .unwrap()
+        }));
+    }
+    tokio::task::yield_now().await;
+    tokio::time::advance(Duration::from_millis(249)).await;
+    assert!(rx.try_recv().is_err());
+    tokio::time::advance(Duration::from_millis(1)).await;
+    let mut connections = Vec::new();
+    for _ in 0..2 {
+        let OutgoingEnvelope::ToConnection {
+            connection_id,
+            message: OutgoingMessage::AppServerNotification(envelope),
+            ..
+        } = rx.recv().await.unwrap()
+        else {
+            panic!("expected targeted progress")
+        };
+        let ServerNotification::UsageBuildProgress(update) = envelope.notification else {
+            panic!("expected usage progress")
+        };
+        assert_eq!(
+            update.request_id,
+            RequestId::String(connection_id.0.to_string())
+        );
+        assert_eq!(update.progress, UsageBuildProgress::default());
+        connections.push(connection_id.0);
+    }
+    connections.sort_unstable();
+    assert_eq!(connections, vec![7, 8]);
+    tokio::time::advance(Duration::from_secs(2)).await;
+    tokio::task::yield_now().await;
+    assert!(rx.try_recv().is_err());
+    drop(lock);
+    let first = readers.remove(0).await.unwrap();
+    let second = readers.remove(0).await.unwrap();
+    assert!(Arc::ptr_eq(&first.report, &second.report));
+    while rx.try_recv().is_ok() {}
+    let cached = service
+        .read(
+            UsageReadParams::default(),
+            &ConnectionRequestId {
+                connection_id: ConnectionId(9),
+                request_id: RequestId::String("cached".into()),
+            },
+            &outgoing,
+        )
+        .await
+        .unwrap();
+    assert!(!cached.refreshed);
+    assert!(rx.try_recv().is_err());
+}
+
