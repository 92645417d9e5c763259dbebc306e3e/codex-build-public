@@ -0,0 +1,48 @@
+use super::Service;
+use super::UsageBuildProgress;
+use super::UsageReadParams;
+use super::UsageReadResponse;
+use crate::outgoing_message::ConnectionRequestId;
+use crate::outgoing_message::OutgoingMessageSender;
+use codex_app_server_protocol::ServerNotification;
+use codex_app_server_protocol::UsageBuildProgressNotification;
+use std::time::Duration;
+use tokio::sync::watch;
+
+impl Service {
+    pub(crate) async fn read(
+        &self,
+        params: UsageReadParams,
+        request: &ConnectionRequestId,
+        outgoing: &OutgoingMessageSender,
+    ) -> Result<UsageReadResponse, String> {
+        let (progress, mut updates) = watch::channel(UsageBuildProgress::default());
+        updates.mark_changed();
+        let report = self.read_report(params, progress);
+        tokio::pin!(report);
+        let period = Duration::from_millis(250);
+        loop {
+            tokio::select! {
+                biased;
+                result = &mut report => return result,
+                () = async {
+                    tokio::time::sleep(period).await;
+                    if updates.has_changed().unwrap_or(false) {
+                        let progress = updates.borrow_and_update().clone();
+                        outgoing.send_server_notification_to_connections(
+                            &[request.connection_id],
+                            ServerNotification::UsageBuildProgress(UsageBuildProgressNotification {
+                                request_id: request.request_id.clone(),
+                                progress,
+                            }),
+                        ).await;
+                    }
+                } => {}
+            }
+        }
+    }
+}
+
+#[cfg(test)]
+#[path = "progress_tests.rs"]
+mod tests;
