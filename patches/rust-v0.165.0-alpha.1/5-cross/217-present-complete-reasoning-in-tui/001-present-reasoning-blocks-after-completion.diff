+#[tokio::test]
+async fn tui_reasoning_deduplicates_across_responses_and_steers_until_next_turn() {
+    let (mut chat, mut events, mut ops) = make_chatwidget_manual(None).await;
+    chat.local_settings.tui.fullscreen_transcript = true;
+    chat.thread_id = Some(ThreadId::new());
+    handle_turn_started(&mut chat, "turn-1");
+    drain_insert_history(&mut events);
+    let first = "**Inspecting code**\n\nOriginal evidence.";
+    handle_agent_reasoning_started(&mut chat, "first");
+    delta(&mut chat, "first", first);
+    assert!(drain_insert_history(&mut events).is_empty());
+    complete(&mut chat, "first");
+    let text = drain_insert_history(&mut events)
+        .iter()
+        .map(|lines| lines_to_single_string(lines))
+        .collect::<String>();
+    assert_eq!(text.matches("Inspecting code").count(), 1);
+    assert!(text.contains("Original evidence."));
+    while ops.try_recv().is_ok() {}
+    chat.submit_user_message(UserMessage::from("Continue this same turn"));
+    assert!(matches!(next_submit_op(&mut ops), Op::UserTurn { .. }));
+    assert!(!chat.input_queue.pending_steers.is_empty());
+    drain_insert_history(&mut events);
+    handle_agent_reasoning_started(&mut chat, "second");
+    delta(
+        &mut chat,
+        "second",
+        "## Inspecting code\n\nOriginal evidence.\n\nNew evidence.",
+    );
+    complete(&mut chat, "second");
+    let text = drain_insert_history(&mut events)
+        .iter()
+        .map(|lines| lines_to_single_string(lines))
+        .collect::<String>();
+    assert!(!text.contains("Inspecting code"));
+    assert!(!text.contains("Original evidence."));
+    assert!(text.contains("New evidence."));
+    handle_agent_reasoning_started(&mut chat, "duplicate");
+    delta(&mut chat, "duplicate", first);
+    complete(&mut chat, "duplicate");
+    assert!(drain_insert_history(&mut events).is_empty());
+    chat.on_task_complete(None, None, false);
+    handle_turn_started(&mut chat, "turn-2");
+    drain_insert_history(&mut events);
+    chat.handle_thread_item(
+        AppServerThreadItem::Reasoning {
+            id: "next-turn-reasoning".into(),
+            summary: vec![first.into()],
+            content: Vec::new(),
+        },
+        "turn-2".into(),
+        ThreadItemRenderSource::Live,
+    );
+    let text = drain_insert_history(&mut events)
+        .iter()
+        .map(|lines| lines_to_single_string(lines))
+        .collect::<String>();
+    assert_eq!(text.matches("Inspecting code").count(), 1);
+    assert!(text.contains("Original evidence."));
+}
