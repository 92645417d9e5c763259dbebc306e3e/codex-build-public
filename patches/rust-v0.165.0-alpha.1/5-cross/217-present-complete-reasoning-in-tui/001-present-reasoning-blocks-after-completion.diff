+        let (mut chat, mut events, _ops) = make_chatwidget_manual(None).await;
+        chat.local_settings.tui.fullscreen_transcript = true;
+        chat.on_task_started();
+        drain_insert_history(&mut events);
+        if !replay {
+            handle_agent_reasoning_started(&mut chat, "complete-reasoning");
+        }
+        chat.handle_thread_item(
+            AppServerThreadItem::Reasoning {
+                id: "complete-reasoning".into(),
+                summary: vec![
+                    "**First paragraph**\n\nSecond paragraph".into(),
+                    "First paragraph\n\nSecond paragraph\n\nThird paragraph".into(),
+                ],
+                content: Vec::new(),
+            },
+            "turn-1".into(),
+            if replay {
+                ThreadItemRenderSource::Replay(ReplayKind::ThreadSnapshot)
+            } else {
+                ThreadItemRenderSource::Live
+            },
+        );
+        assert_eq!(
+            chat.bottom_pane.status_widget().unwrap().header(),
+            "Working"
+        );
+        chat.restore_reasoning_status_header();
+        assert_eq!(
+            chat.bottom_pane.status_widget().unwrap().header(),
+            "Working"
+        );
+        let text = drain_insert_history(&mut events)
+            .iter()
+            .map(|lines| lines_to_single_string(lines))
+            .collect::<String>();
+        assert!(text.lines().all(|line| line.starts_with("▌ ")));
+        for paragraph in ["First paragraph", "Second paragraph", "Third paragraph"] {
+            assert_eq!(text.matches(paragraph).count(), 1);
+        }
+        outputs.push(text);
+    }
+    assert_eq!(outputs[0], outputs[1]);
+    insta::assert_snapshot!(outputs[0]);
+}
