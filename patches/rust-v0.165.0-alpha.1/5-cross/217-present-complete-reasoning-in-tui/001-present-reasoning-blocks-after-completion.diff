+use super::*;
+use crate::history_cell::HistoryCell;
+use crate::history_cell::HistoryRenderMode;
+use pretty_assertions::assert_eq;
+
+#[test]
+fn complete_blocks_share_a_turn_cache_without_losing_novel_paragraphs() {
+    let mut seen = BTreeSet::new();
+    let first = new_visible_reasoning_block(
+        [
+            "**Inspecting code**\n\nFirst paragraph.",
+            "First paragraph.\n\nNew evidence.",
+        ],
+        Path::new("/tmp"),
+        &mut seen,
+    );
+    let second = new_visible_reasoning_block(
+        ["## Inspecting code\n\nFirst paragraph.\n\nMore evidence."],
+        Path::new("/tmp"),
+        &mut seen,
+    );
+    assert_eq!(
+        first.markdown_source().matches("First paragraph.").count(),
+        1
+    );
+    assert_eq!(second.markdown_source(), "More evidence.");
+    assert!(first.markdown_source().starts_with("**Inspecting code**"));
+    for width in [32, 80] {
+        for mode in [HistoryRenderMode::Rich, HistoryRenderMode::Raw] {
+            let lines = first.display_lines_for_mode(width, mode);
+            let text = lines
+                .iter()
+                .map(ToString::to_string)
+                .collect::<Vec<_>>()
+                .join("\n");
+            assert!(lines.iter().all(|line| line.to_string().starts_with("▌ ")));
+            assert!(lines.iter().all(|line| line.width() <= usize::from(width)));
+            assert!(lines.iter().any(|line| line.to_string() == "▌ "));
+            assert!(!first.markdown_source().contains('▌'));
+            if width == 80 && mode == HistoryRenderMode::Rich {
+                insta::assert_snapshot!(text);
+            }
+        }
+    }
+    seen.clear();
+    assert_eq!(
+        unique_blocks("## Inspecting code", &mut seen),
+        "## Inspecting code"
+    );
+}
+
+#[test]
+fn title_placeholders_keep_their_position_without_removing_literal_comments() {
+    let cell = new_visible_reasoning_block(
+        [
+            "**First title**\n\n<!-- -->",
+            "First title\n\nBody paragraph",
+            "**Second title**\n\n<!-- -->",
+            "Literal paragraph <!-- -->",
+            "<!-- -->",
+        ],
+        Path::new("/tmp"),
+        &mut BTreeSet::new(),
+    );
+    let source = cell.markdown_source();
+    assert_eq!(source.matches("First title").count(), 1);
+    assert_eq!(source.matches("<!-- -->").count(), 1);
+    assert!(source.contains("Literal paragraph <!-- -->"));
+    assert!(source.find("First title").unwrap() < source.find("Body paragraph").unwrap());
+    assert!(source.find("Body paragraph").unwrap() < source.find("Second title").unwrap());
+    insta::assert_snapshot!(
+        cell.display_lines(80)
+            .iter()
+            .map(ToString::to_string)
+            .collect::<Vec<_>>()
+            .join("\n")
+    );
+}
+
+#[test]
+fn structured_markdown_and_distinct_links_stay_whole() {
+    let source = "Repeated.\n\nRepeated.\n\n- Repeated.\n- Repeated.\n\n```text\nRepeated.\n\nRepeated.\n```\n\n[Link](one)\n\n[Link](two)\n\n---";
+    let mut seen = BTreeSet::new();
+    let actual = unique_blocks(source, &mut seen);
+    assert_eq!(actual.matches("Repeated.").count(), 5);
+    assert!(actual.contains("- Repeated.\n- Repeated."));
+    assert!(actual.contains("```text\nRepeated.\n\nRepeated.\n```"));
+    assert!(actual.contains("[Link](one)"));
+    assert!(actual.contains("[Link](two)"));
+    assert!(unique_blocks(source, &mut seen).is_empty());
+}
+
+#[test]
+fn heading_syntax_does_not_change_title_identity() {
+    let mut seen = BTreeSet::new();
+    assert_eq!(
+        unique_blocks("# Inspecting code", &mut seen),
+        "# Inspecting code"
+    );
+    assert!(unique_blocks("Inspecting code\n===", &mut seen).is_empty());
+    assert!(unique_blocks("**Inspecting code**", &mut seen).is_empty());
+    assert_eq!(unique_blocks("# C#", &mut seen), "# C#");
+    assert_eq!(unique_blocks("# C", &mut seen), "# C");
+    assert!(unique_blocks("## C# ##", &mut seen).is_empty());
+}
