+
+pub(crate) fn new_visible_reasoning_block<S: AsRef<str>>(
+    parts: impl IntoIterator<Item = S>,
+    cwd: &Path,
+    seen: &mut BTreeSet<String>,
+) -> Box<ReasoningSummaryCell> {
+    let mut content = String::new();
+    for part in parts {
+        let part = part.as_ref().trim();
+        // An empty summary body must not discard its title. Literal comments
+        // inside a real paragraph remain part of the original Markdown source.
+        let part = if part == "<!-- -->" {
+            ""
+        } else if let Some(after_open) = part.strip_prefix("**")
+            && let Some(close) = after_open.find("**")
+            && close > 0
+            && part[close + 4..].trim() == "<!-- -->"
+        {
+            &part[..close + 4]
+        } else {
+            part
+        };
+        if !part.is_empty() {
+            if !content.is_empty() {
+                content.push_str("\n\n");
+            }
+            content.push_str(part);
+        }
+    }
+    Box::new(ReasoningSummaryCell::new(
+        String::new(),
+        unique_blocks(&content, seen),
+        cwd,
+        false,
+    ))
+}
+
+fn unique_blocks(source: &str, seen: &mut BTreeSet<String>) -> String {
+    let mut depth = 0usize;
+    let mut block = None;
+    let mut retained = String::with_capacity(source.len());
+    let mut cursor = 0;
+    for (event, range) in Parser::new(source).into_offset_iter() {
+        let completed = match event {
+            Event::Start(tag) => {
+                if depth == 0 {
+                    block = Some((range.start, matches!(tag, Tag::Heading { .. })));
+                }
+                depth += 1;
+                None
+            }
+            Event::End(_) => {
+                depth -= 1;
+                if depth == 0 { block.take() } else { None }
+            }
+            _ if depth == 0 => Some((range.start, false)),
+            _ => None,
+        };
+        let Some((start, heading)) = completed else {
+            continue;
+        };
+        let text = source[start..range.end].trim();
+        let text = if heading {
+            if let Some((title, underline)) = text.rsplit_once('\n')
+                && underline.trim().chars().all(|c| c == '=' || c == '-')
+            {
+                title.trim()
+            } else {
+                let title = text.trim_start_matches('#').trim_start();
+                let without_closing = title.trim_end_matches('#');
+                if without_closing.ends_with(char::is_whitespace) {
+                    without_closing.trim_end()
+                } else {
+                    title
+                }
+            }
+        } else {
+            text
+        };
+        // Title spelling does not change identity. Lists and fenced code remain
+        // whole blocks, retaining repeated lines within a novel structure.
+        let key = text
+            .strip_prefix("**")
+            .and_then(|text| text.strip_suffix("**"))
+            .filter(|text| !text.contains("**"))
+            .unwrap_or(text);
+        if !seen.insert(key.to_owned()) {
+            retained.push_str(&source[cursor..start]);
+            cursor = range.end;
+        }
+    }
+    retained.push_str(&source[cursor..]);
+    retained.trim().to_owned()
+}
