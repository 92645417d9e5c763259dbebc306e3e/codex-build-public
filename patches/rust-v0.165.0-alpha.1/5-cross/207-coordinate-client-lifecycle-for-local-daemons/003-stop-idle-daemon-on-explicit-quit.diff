+#[tokio::test]
+async fn shutdown_response_wait_preserves_graceful_order_and_forced_exit() {
+    use super::outgoing_message::ConnectionId;
+    use super::outgoing_message::ConnectionRequestId;
+    use super::outgoing_message::OutgoingEnvelope;
+    use super::outgoing_message::OutgoingMessageSender;
+    use codex_app_server_protocol::DaemonShutdownResponse;
+    use codex_app_server_protocol::DaemonShutdownStatus;
+    use codex_app_server_protocol::RequestId;
+
+    for force in [false, true] {
+        let admission = TurnAdmission::default();
+        let (tx, mut rx) = tokio::sync::mpsc::channel(1);
+        let outgoing =
+            OutgoingMessageSender::new(tx, codex_analytics::AnalyticsEventsClient::disabled());
+        let mut shutdown = ShutdownState {
+            response_write: Some(Box::pin(async move {
+                outgoing
+                    .send_response_and_wait(
+                        ConnectionRequestId {
+                            connection_id: ConnectionId(1),
+                            request_id: RequestId::Integer(1),
+                        },
+                        DaemonShutdownResponse {
+                            status: DaemonShutdownStatus::Accepted,
+                        },
+                    )
+                    .await
+            })),
+            ..Default::default()
+        };
+        shutdown.on_signal(ShutdownSignal::Forceable, 1, 0, &admission);
+        assert!(
+            futures::poll!(shutdown.response_write.as_mut().expect("pending response"))
+                .is_pending()
+        );
+        let OutgoingEnvelope::ToConnection {
+            write_complete_tx, ..
+        } = rx.try_recv().expect("queued shutdown response")
+        else {
+            panic!("expected targeted response");
+        };
+        assert!(matches!(shutdown.update(0, 0, 1), ShutdownAction::Noop));
+
+        if force {
+            shutdown.on_signal(ShutdownSignal::Forceable, 1, 0, &admission);
+            assert!(matches!(shutdown.update(0, 0, 1), ShutdownAction::Finish));
+            assert!(
+                futures::poll!(shutdown.response_write.as_mut().expect("pending response"))
+                    .is_pending()
+            );
+        } else {
+            write_complete_tx
+                .expect("write acknowledgment")
+                .send(())
+                .unwrap();
+            assert!(shutdown.response_write.take().unwrap().await);
+            assert!(matches!(shutdown.update(0, 0, 1), ShutdownAction::Finish));
+        }
+    }
+}
