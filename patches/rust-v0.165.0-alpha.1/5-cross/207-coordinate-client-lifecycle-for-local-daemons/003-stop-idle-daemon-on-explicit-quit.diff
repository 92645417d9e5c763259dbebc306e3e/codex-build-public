@@ -0,0 +1,33 @@
+use crate::JsonSchema;
+use crate::TS;
+use serde::Deserialize;
+use serde::Serialize;
+
+/// Shut down a managed local daemon only when this is its last client and all sessions are idle.
+#[derive(Serialize, Deserialize, Debug, Clone, Default, PartialEq, Eq, JsonSchema, TS)]
+#[serde(rename_all = "camelCase")]
+#[ts(export_to = "v2/")]
+pub struct DaemonShutdownParams {
+    /// Check the same eligibility rules without closing admission or stopping the daemon.
+    /// A later shutdown request rechecks eligibility rather than reserving this result.
+    #[serde(default, skip_serializing_if = "std::ops::Not::not")]
+    pub check_only: bool,
+}
+
+#[derive(Serialize, Deserialize, Debug, Clone, PartialEq, Eq, JsonSchema, TS)]
+#[serde(rename_all = "camelCase")]
+#[ts(export_to = "v2/")]
+pub struct DaemonShutdownResponse {
+    pub status: DaemonShutdownStatus,
+}
+
+/// A refused shutdown leaves both the client connection and the daemon running.
+/// In check-only mode, Accepted reports current eligibility without shutting down.
+#[derive(Serialize, Deserialize, Debug, Clone, Copy, PartialEq, Eq, JsonSchema, TS)]
+#[serde(rename_all = "camelCase")]
+#[ts(export_to = "v2/")]
+pub enum DaemonShutdownStatus {
+    Accepted,
+    OtherClients,
+    Busy,
+}
