+
+#[test]
+fn failed_response_retains_usage_without_treating_error_text_as_content() {
+    let usage = json!({"input_tokens": 100, "input_tokens_details": {"cached_tokens": 80},
+        "output_tokens": 12, "output_tokens_details": {"reasoning_tokens": 5}});
+    let observation = observe(json!({"type": "response.failed", "response": {
+        "id": "r1", "status": "failed", "model": "served-model", "usage": usage,
+        "error": {"code": "failure", "message": "not model output"}
+    }}));
+    assert_eq!(observation.terminal, Some(ResponseAttemptEnd::Failed));
+    assert!(!observation.has_content);
+    assert_eq!(observation.usage, Some(usage));
+    assert_eq!(observation.served_model.as_deref(), Some("served-model"));
+}
+
+#[test]
+fn model_progress_recognizes_native_content_without_counting_control_fields() {
+    for item in [
+        json!({"type": "message", "content": [{"type": "output_text", "text": "answer"}]}),
+        json!({"type": "reasoning", "summary": [{"type": "summary_text", "text": "reason"}]}),
+        json!({"type": "reasoning", "encrypted_content": "opaque"}),
+        json!({"type": "function_call", "arguments": "{}"}),
+        json!({"type": "function_call", "encrypted_function_args": ["opaque"]}),
+        json!({"type": "custom_tool_call", "input": "command"}),
+        json!({"type": "compaction", "encrypted_content": "opaque"}),
+    ] {
+        assert!(observe(json!({"type": "response.output_item.done", "item": item})).has_content);
+        assert!(
+            observe(json!({"type": "response.completed", "response": {"output": [item]}}))
+                .has_content
+        );
+    }
+    for payload in [
+        json!({"type": "response.created", "response": {"id": "r1"}}),
+        json!({"type": "codex.response.metadata", "headers": {"openai-model": "model"}}),
+        json!({"type": "codex.rate_limits", "rate_limits": {"secondary": {
+            "used_percent": 12.5, "window_minutes": 10080, "reset_at": 1704074400
+        }}}),
+        json!({"type": "response.output_item.added", "item": {"type": "function_call", "name": "tool", "arguments": ""}}),
+        json!({"type": "response.output_text.delta", "delta": ""}),
+        json!({"type": "error", "error": {"message": "failure"}}),
+    ] {
+        assert!(!observe(payload).has_content);
+    }
+    for payload in [
+        json!({"type": "response.output_text.delta", "delta": "a"}),
+        json!({"type": "response.reasoning_summary_text.delta", "delta": "b"}),
+        json!({"type": "response.function_call_arguments.delta", "delta": "{"}),
+        json!({"type": "response.custom_tool_call_input.done", "input": "command"}),
+        json!({"type": "response.content_part.done", "part": {"type": "refusal", "refusal": "declined"}}),
+    ] {
+        assert!(observe(payload).has_content);
+    }
+}
