+use super::*;
+use pretty_assertions::assert_eq;
+
+fn sample(started_at: i64, tps: Option<f64>, ttfc_ms: Option<u64>) -> ResponseTimingSample {
+    ResponseTimingSample {
+        attempt_id: Uuid::now_v7(),
+        revision: 1,
+        requested_model: "model".into(),
+        started_at,
+        end_reason: Some(ResponseAttemptEnd::Completed),
+        tps,
+        ttfc_ms,
+    }
+}
+
+#[test]
+fn last_generation_expires_at_the_shared_diagnostic_retention_boundary() {
+    let mut window = TimingWindow::default();
+    let now = 100_000;
+    window.insert(sample(now, Some(20.0), Some(200)), now);
+    let boundary = window.summary(now + DIAGNOSTIC_RETENTION_SECONDS);
+    assert_eq!(boundary.models.len(), 1);
+    assert_eq!(boundary.models[0].last_tps, Some(20.0));
+    assert_eq!(boundary.models[0].last_ttfc_ms, Some(200));
+    assert_eq!(boundary.models[0].tps, None);
+    assert_eq!(boundary.models[0].ttfc_ms, None);
+    assert!(
+        window
+            .summary(now + DIAGNOSTIC_RETENTION_SECONDS + 1)
+            .models
+            .is_empty()
+    );
+}
+
+#[test]
+fn late_arrivals_preserve_unknown_zero_and_time_window_boundaries() {
+    let mut window = TimingWindow::default();
+    let now = 100_000;
+    let since = now - TIMING_WINDOW_SECONDS;
+    assert_eq!(window.summary(now), ResponseTimingReadResponse::default());
+    window.insert(sample(now, Some(20.0), Some(200)), now);
+    window.insert(sample(now - 1, None, Some(0)), now);
+    window.insert(sample(now - 2, None, Some(400)), now);
+    window.insert(sample(since, Some(0.0), None), now);
+    window.insert(sample(since - 1, Some(1_000_000.0), Some(1_000_000)), now);
+    window.insert(sample(now + 1, Some(1_000_000.0), Some(1_000_000)), now);
+    let summary = window.summary(now);
+    assert_eq!(summary.models.len(), 1);
+    assert_eq!(
+        summary.models[0].tps,
+        Some(ResponseTimingSummary {
+            sample_count: 2,
+            p50: 10.0,
+            slow: 1.0
+        })
+    );
+    assert_eq!(
+        summary.models[0].ttfc_ms,
+        Some(ResponseTimingSummary {
+            sample_count: 3,
+            p50: 200.0,
+            slow: 380.0
+        })
+    );
+    // No new response is needed to expire the oldest sample.
+    assert_eq!(
+        window.summary(now + 1).models[0].tps,
+        Some(ResponseTimingSummary {
+            sample_count: 1,
+            p50: 20.0,
+            slow: 20.0,
+        })
+    );
+    let expired = window.summary(now + TIMING_WINDOW_SECONDS + 1);
+    assert_eq!(expired.models[0].tps, None);
+    assert_eq!(expired.models[0].ttfc_ms, None);
+}
+
+#[test]
+fn startup_restore_merges_live_samples_once_and_expires_equal_values_independently() {
+    let mut window = TimingWindow::default();
+    let now = 100_000;
+    let live = sample(now - 1, Some(10.0), Some(100));
+    let live_id = live.attempt_id;
+    window.insert(live, now);
+    window.restore(
+        vec![
+            sample(now, Some(20.0), Some(200)),
+            ResponseTimingSample {
+                attempt_id: live_id,
+                revision: 1,
+                requested_model: "model".into(),
+                started_at: now - 1,
+                end_reason: Some(ResponseAttemptEnd::Completed),
+                tps: Some(10.0),
+                ttfc_ms: Some(100),
+            },
+            sample(now - TIMING_WINDOW_SECONDS, Some(10.0), Some(100)),
+        ],
+        now,
+    );
+    assert_eq!(
+        window.summary(now).models[0].tps,
+        Some(ResponseTimingSummary {
+            sample_count: 3,
+            p50: 10.0,
+            slow: 10.0,
+        })
+    );
+    let summary = window.summary(now + 1);
+    assert_eq!(
+        summary.models[0].tps,
+        Some(ResponseTimingSummary {
+            sample_count: 2,
+            p50: 15.0,
+            slow: 10.5
+        })
+    );
+    assert_eq!(
+        summary.models[0].ttfc_ms,
+        Some(ResponseTimingSummary {
+            sample_count: 2,
+            p50: 150.0,
+            slow: 195.0
+        })
+    );
+}
+
+#[test]
+fn models_keep_separate_distributions_and_latest_metrics_after_window_expiry() {
+    let mut window = TimingWindow::default();
+    let now = 100_000;
+    let mut older = sample(now - 1, Some(10.0), Some(100));
+    older.requested_model = "Model-X".into();
+    let mut outside = sample(now - TIMING_WINDOW_SECONDS - 1, Some(5.0), Some(500));
+    outside.requested_model = "model-x".into();
+    let mut latest = sample(now, Some(30.0), Some(300));
+    latest.requested_model = "Model-X".into();
+    window.insert(latest, now);
+    window.insert(older, now);
+    window.restore(vec![outside], now);
+    assert_eq!(
+        window.summary(now).models,
+        vec![
+            ResponseModelTiming {
+                requested_model: "Model-X".into(),
+                successful_attempts: 2,
+                total_attempts: 2,
+                last_tps: Some(30.0),
+                last_ttfc_ms: Some(300),
+                tps: Some(ResponseTimingSummary {
+                    sample_count: 2,
+                    p50: 20.0,
+                    slow: 11.0
+                }),
+                ttfc_ms: Some(ResponseTimingSummary {
+                    sample_count: 2,
+                    p50: 200.0,
+                    slow: 290.0
+                }),
+            },
+            ResponseModelTiming {
+                requested_model: "model-x".into(),
+                successful_attempts: 0,
+                total_attempts: 0,
+                last_tps: Some(5.0),
+                last_ttfc_ms: Some(500),
+                tps: None,
+                ttfc_ms: None,
+            },
+        ]
+    );
+    let mut unknown = sample(now, None, Some(0));
+    unknown.requested_model = "Model-X".into();
+    window.insert(unknown, now);
+    let expired = window.summary(now + TIMING_WINDOW_SECONDS + 1);
+    assert_eq!(expired.models.len(), 1);
+    assert_eq!(expired.models[0].requested_model, "Model-X");
+    assert_eq!(expired.models[0].last_tps, None);
+    assert_eq!(expired.models[0].last_ttfc_ms, Some(0));
+    assert_eq!(expired.models[0].tps, None);
+    assert_eq!(expired.models[0].ttfc_ms, None);
+}
