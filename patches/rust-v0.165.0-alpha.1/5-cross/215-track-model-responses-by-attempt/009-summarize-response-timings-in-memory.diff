+#[tokio::test]
+async fn rolling_timings_restore_beyond_recent_records_then_update_only_from_live_observations() {
+    let home = tempfile::tempdir().unwrap();
+    let (metrics, history, runtime) = recording(home.path()).await;
+    let started_at = chrono::Utc::now().timestamp();
+    for output in 0..=RECENT_RESPONSE_LIMIT {
+        let sent = Instant::now();
+        let attempt = metrics.start(context(), sent, started_at);
+        attempt.sent(sent);
+        attempt.received(
+            ResponseObservation {
+                usage: Some(json!({"output_tokens": output})),
+                terminal: Some(ResponseAttemptEnd::Failed),
+                ..Default::default()
+            },
+            sent + Duration::from_secs(1),
+        );
+    }
+    assert_eq!(history.notification_snapshot().len(), 250);
+    let expected = ResponseTimingReadResponse {
+        models: vec![ResponseModelTiming {
+            requested_model: "model".into(),
+            successful_attempts: 0,
+            total_attempts: 251,
+            last_tps: Some(250.0),
+            last_ttfc_ms: None,
+            tps: Some(ResponseTimingSummary {
+                sample_count: 251,
+                p50: 125.0,
+                slow: 12.5,
+            }),
+            ttfc_ms: None,
+        }],
+        total_attempts: 251,
+        ..Default::default()
+    };
+    assert_eq!(history.timing_summary().await, expected);
+    history.flush().await.unwrap();
+    history.shutdown().await.unwrap();
+    runtime.close().await;
+    let (restored_metrics, reopened, restored_runtime) = recording(home.path()).await;
+    assert_eq!(reopened.timing_summary().await, expected);
+    let mut disk_only = history.notification_snapshot()[0].clone();
+    disk_only.attempt_id = Uuid::now_v7();
+    disk_only.tps = Some(1_000_000.0);
+    restored_runtime
+        .response_history()
+        .write(&disk_only)
+        .await
+        .unwrap();
+    // Refreshes cannot pull a second copy of the database window.
+    assert_eq!(reopened.timing_summary().await, expected);
+    let sent = Instant::now();
+    let attempt = restored_metrics.start(context(), sent, started_at);
+    attempt.sent(sent);
+    attempt.received(
+        ResponseObservation {
+            usage: Some(json!({"output_tokens": 251})),
+            terminal: Some(ResponseAttemptEnd::Failed),
+            ..Default::default()
+        },
+        sent + Duration::from_secs(1),
+    );
+    let updated = reopened.timing_summary().await;
+    assert_eq!(
+        updated.models[0].tps,
+        Some(ResponseTimingSummary {
+            sample_count: 252,
+            p50: 125.5,
+            slow: 12.55,
+        })
+    );
+    assert_eq!(updated.models[0].last_tps, Some(251.0));
+    assert_eq!(
+        (updated.successful_attempts, updated.total_attempts),
+        (0, 252)
+    );
+    reopened.flush().await.unwrap();
+}
