+#[test]
+fn outcome_counts_follow_revisions_and_expire_without_new_requests() {
+    let mut window = TimingWindow::default();
+    let now = 100_000;
+    window.insert(
+        sample(now - TIMING_WINDOW_SECONDS, Some(10.0), Some(100)),
+        now,
+    );
+    let mut incomplete = sample(now, Some(50.0), Some(500));
+    incomplete.requested_model = "other-model".into();
+    incomplete.end_reason = Some(ResponseAttemptEnd::Incomplete);
+    window.insert(incomplete, now);
+    let attempt_id = Uuid::now_v7();
+    let update = |revision, end_reason| ResponseTimingSample {
+        attempt_id,
+        revision,
+        requested_model: "model".into(),
+        started_at: now,
+        end_reason,
+        tps: Some(20.0),
+        ttfc_ms: Some(200),
+    };
+    window.insert(update(1, None), now);
+    window.insert(update(1, None), now);
+    let working = window.summary(now);
+    assert_eq!(
+        (working.successful_attempts, working.total_attempts),
+        (1, 3)
+    );
+    assert_eq!(
+        (
+            working.models[0].successful_attempts,
+            working.models[0].total_attempts
+        ),
+        (1, 2)
+    );
+    assert_eq!(working.models[0].last_tps, Some(10.0));
+    assert_eq!(working.models[0].tps.as_ref().unwrap().sample_count, 1);
+    window.insert(update(3, Some(ResponseAttemptEnd::Completed)), now);
+    let completed = window.summary(now);
+    assert_eq!(
+        (completed.successful_attempts, completed.total_attempts),
+        (2, 3)
+    );
+    assert_eq!(
+        (
+            completed.models[0].successful_attempts,
+            completed.models[0].total_attempts
+        ),
+        (2, 2)
+    );
+    assert_eq!(completed.models[0].last_tps, Some(20.0));
+    assert_eq!(completed.models[0].tps.as_ref().unwrap().sample_count, 2);
+    window.restore(
+        vec![
+            update(2, None),
+            update(3, Some(ResponseAttemptEnd::Completed)),
+        ],
+        now,
+    );
+    window.insert(update(1, None), now);
+    assert_eq!(window.summary(now), completed);
+    let expired_boundary = window.summary(now + 1);
+    assert_eq!(
+        (
+            expired_boundary.successful_attempts,
+            expired_boundary.total_attempts
+        ),
+        (1, 2)
+    );
+    assert_eq!(
+        expired_boundary.models[0]
+            .tps
+            .as_ref()
+            .unwrap()
+            .sample_count,
+        1
+    );
+    let expired_window = window.summary(now + TIMING_WINDOW_SECONDS + 1);
+    assert_eq!(
+        (
+            expired_window.successful_attempts,
+            expired_window.total_attempts
+        ),
+        (0, 0)
+    );
+    assert!(
+        expired_window
+            .models
+            .iter()
+            .all(|model| model.tps.is_none() && model.ttfc_ms.is_none())
+    );
+    assert_eq!(expired_window.models[0].last_tps, Some(20.0));
+}
