@@ -0,0 +1,252 @@
+//! Compact rolling samples and sorted metric values, independent of full-record retention.
+
+use codex_protocol::response_metrics::ResponseAttemptEnd;
+use codex_protocol::response_metrics::ResponseModelTiming;
+use codex_protocol::response_metrics::ResponseTimingReadResponse;
+use codex_protocol::response_metrics::ResponseTimingSummary;
+use codex_state::DIAGNOSTIC_RETENTION_SECONDS;
+use codex_state::ResponseTimingSample;
+use std::collections::BTreeMap;
+use std::collections::btree_map::Entry;
+use uuid::Uuid;
+
+pub(super) const TIMING_WINDOW_SECONDS: i64 = 24 * 60 * 60;
+
+#[derive(Debug, Default)]
+pub(super) struct TimingWindow {
+    models: BTreeMap<String, ModelTimings>,
+}
+
+#[derive(Debug, Default)]
+struct ModelTimings {
+    last: Option<ResponseTimingSample>,
+    samples: BTreeMap<(i64, Uuid), WindowSample>,
+    successful_attempts: u64,
+    tps: Distribution,
+    ttfc_ms: Distribution,
+}
+
+/// The map owns identity and start time; only ended attempts contribute timing values.
+#[derive(Debug, Clone, Copy)]
+struct WindowSample {
+    revision: u64,
+    successful: bool,
+    tps: Option<f64>,
+    ttfc_ms: Option<u64>,
+}
+
+impl From<&ResponseTimingSample> for WindowSample {
+    fn from(sample: &ResponseTimingSample) -> Self {
+        Self {
+            revision: sample.revision,
+            successful: sample.end_reason == Some(ResponseAttemptEnd::Completed),
+            tps: sample.end_reason.and(sample.tps),
+            ttfc_ms: sample.end_reason.and(sample.ttfc_ms),
+        }
+    }
+}
+
+impl TimingWindow {
+    pub(super) fn insert(&mut self, sample: ResponseTimingSample, now: i64) {
+        self.models
+            .entry(sample.requested_model.clone())
+            .or_default()
+            .insert(sample, now);
+    }
+
+    pub(super) fn restore(&mut self, samples: Vec<ResponseTimingSample>, now: i64) {
+        for sample in samples {
+            self.models
+                .entry(sample.requested_model.clone())
+                .or_default()
+                .retain(sample, now);
+        }
+        for model in self.models.values_mut() {
+            model
+                .samples
+                .retain(|(started_at, _), _| *started_at >= now - TIMING_WINDOW_SECONDS);
+            model.sort();
+        }
+    }
+
+    pub(super) fn summary(&mut self, now: i64) -> ResponseTimingReadResponse {
+        self.models.retain(|_, model| {
+            model.expire(now);
+            model.last.is_some() || !model.samples.is_empty()
+        });
+        ResponseTimingReadResponse {
+            models: self
+                .models
+                .iter()
+                .map(|(name, model)| ResponseModelTiming {
+                    requested_model: name.clone(),
+                    successful_attempts: model.successful_attempts,
+                    total_attempts: model.samples.len() as u64,
+                    last_tps: model.last.as_ref().and_then(|last| last.tps),
+                    last_ttfc_ms: model.last.as_ref().and_then(|last| last.ttfc_ms),
+                    tps: model.tps.summary(0.05),
+                    ttfc_ms: model.ttfc_ms.summary(0.95),
+                })
+                .collect(),
+            successful_attempts: self
+                .models
+                .values()
+                .map(|model| model.successful_attempts)
+                .sum(),
+            total_attempts: self
+                .models
+                .values()
+                .map(|model| model.samples.len() as u64)
+                .sum(),
+            persistence_error: None,
+            last_persistence_error: None,
+        }
+    }
+}
+
+impl ModelTimings {
+    fn retain(&mut self, sample: ResponseTimingSample, now: i64) {
+        if (now - TIMING_WINDOW_SECONDS..=now).contains(&sample.started_at) {
+            let values = WindowSample::from(&sample);
+            self.samples
+                .entry((sample.started_at, sample.attempt_id))
+                .and_modify(|current| {
+                    if values.revision > current.revision {
+                        *current = values;
+                    }
+                })
+                .or_insert(values);
+        }
+        self.update_last(sample);
+    }
+
+    fn insert(&mut self, sample: ResponseTimingSample, now: i64) {
+        self.expire(now);
+        if (now - TIMING_WINDOW_SECONDS..=now).contains(&sample.started_at) {
+            let values = WindowSample::from(&sample);
+            let previous = match self.samples.entry((sample.started_at, sample.attempt_id)) {
+                Entry::Vacant(entry) => {
+                    entry.insert(values);
+                    None
+                }
+                Entry::Occupied(mut entry) => {
+                    if entry.get().revision >= values.revision {
+                        return;
+                    }
+                    Some(entry.insert(values))
+                }
+            };
+            if let Some(previous) = previous {
+                self.remove_values(previous);
+            }
+            self.successful_attempts += u64::from(values.successful);
+            self.tps.insert(values.tps);
+            self.ttfc_ms.insert(values.ttfc_ms.map(|ms| ms as f64));
+        }
+        self.update_last(sample);
+    }
+
+    fn update_last(&mut self, sample: ResponseTimingSample) {
+        if sample.end_reason.is_some()
+            && self.last.as_ref().is_none_or(|last| {
+                (sample.attempt_id, sample.revision) > (last.attempt_id, last.revision)
+            })
+        {
+            self.last = Some(sample);
+        }
+    }
+
+    fn sort(&mut self) {
+        // Bulk restore sorts once; live arrivals only insert their individual values.
+        self.successful_attempts = self
+            .samples
+            .values()
+            .filter(|sample| sample.successful)
+            .count() as u64;
+        self.tps.values = self
+            .samples
+            .values()
+            .filter_map(|sample| sample.tps)
+            .collect();
+        self.ttfc_ms.values = self
+            .samples
+            .values()
+            .filter_map(|sample| sample.ttfc_ms.map(|ms| ms as f64))
+            .collect();
+        self.tps.values.sort_unstable_by(f64::total_cmp);
+        self.ttfc_ms.values.sort_unstable_by(f64::total_cmp);
+    }
+
+    fn expire(&mut self, now: i64) {
+        if self
+            .last
+            .as_ref()
+            .is_some_and(|last| last.started_at < now - DIAGNOSTIC_RETENTION_SECONDS)
+        {
+            self.last = None;
+        }
+        let since = now - TIMING_WINDOW_SECONDS;
+        while self
+            .samples
+            .first_key_value()
+            .is_some_and(|((started_at, _), _)| *started_at < since)
+        {
+            let (_, sample) = self.samples.pop_first().expect("expired timing sample");
+            self.remove_values(sample);
+        }
+    }
+
+    fn remove_values(&mut self, sample: WindowSample) {
+        self.successful_attempts -= u64::from(sample.successful);
+        self.tps.remove(sample.tps);
+        self.ttfc_ms.remove(sample.ttfc_ms.map(|ms| ms as f64));
+    }
+}
+
+#[derive(Debug, Default)]
+struct Distribution {
+    values: Vec<f64>,
+}
+
+impl Distribution {
+    fn insert(&mut self, value: Option<f64>) {
+        if let Some(value) = value {
+            let index = self
+                .values
+                .binary_search_by(|probe| probe.total_cmp(&value))
+                .unwrap_or_else(|index| index);
+            self.values.insert(index, value);
+        }
+    }
+
+    fn remove(&mut self, value: Option<f64>) {
+        if let Some(value) = value {
+            let index = self
+                .values
+                .binary_search_by(|probe| probe.total_cmp(&value))
+                .expect("retained timing value");
+            self.values.remove(index);
+        }
+    }
+
+    fn summary(&self, slow_fraction: f64) -> Option<ResponseTimingSummary> {
+        if self.values.is_empty() {
+            return None;
+        }
+        let percentile = |fraction: f64| {
+            let position = (self.values.len() - 1) as f64 * fraction;
+            let lower = position.floor() as usize;
+            let upper = position.ceil() as usize;
+            self.values[lower] + (self.values[upper] - self.values[lower]) * position.fract()
+        };
+        Some(ResponseTimingSummary {
+            sample_count: self.values.len() as u64,
+            p50: percentile(0.50),
+            slow: percentile(slow_fraction),
+        })
+    }
+}
+
+#[cfg(test)]
+#[path = "timing_tests.rs"]
+mod tests;
