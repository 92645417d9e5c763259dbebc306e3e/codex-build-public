@@ -0,0 +1,145 @@
+use super::*;
+use crate::app_event_sender::AppEventSender;
+use crate::bottom_pane::MultiSelectItem;
+use crate::bottom_pane::MultiSelectPicker;
+use crate::bottom_pane::SelectionItem;
+use crate::bottom_pane::SelectionViewParams;
+use crate::bottom_pane::custom_prompt_view::CustomPromptView;
+use crate::dialog::DialogResources;
+use crate::keymap::RuntimeKeymap;
+use crate::render::renderable::Renderable;
+use crate::terminal_palette::with_test_default_colors;
+use crate::terminal_probe::DefaultColors;
+use crate::tui::FrameRequester;
+use pretty_assertions::assert_eq;
+use ratatui::style::Color;
+
+#[test]
+fn frame_separates_the_shaded_body_from_the_terminal_footer() {
+    for background in [(0, 0, 0), (255, 255, 255)] {
+        with_test_default_colors(
+            DefaultColors {
+                fg: (160, 160, 160),
+                bg: background,
+            },
+            || {
+                let viewport = Rect::new(3, 2, 20, 10);
+                let area = Rect::new(5, 3, 14, 7);
+                let mut buffer = Buffer::empty(viewport);
+                for cell in &mut buffer.content {
+                    cell.set_symbol("x")
+                        .set_bg(Color::Blue)
+                        .set_diff_option(CellDiffOption::AlwaysUpdate);
+                }
+                let frame = DialogFrame::new(area, 2);
+                assert_eq!(frame.body(), Rect::new(5, 3, 14, 5));
+                assert_eq!(frame.body_content(), Rect::new(7, 4, 10, 3));
+                assert_eq!(frame.footer(), Rect::new(7, 8, 12, 2));
+                assert_eq!(DialogFrame::footer_width(area.width), frame.footer().width);
+                frame.render(&mut buffer);
+                let panel = crate::style::user_message_style().bg.unwrap();
+                for y in viewport.top()..viewport.bottom() {
+                    for x in viewport.left()..viewport.right() {
+                        let cell = &buffer[(x, y)];
+                        let inside = area.contains((x, y).into());
+                        assert_eq!(cell.symbol(), if inside { " " } else { "x" });
+                        let expected = if frame.body().contains((x, y).into()) {
+                            panel
+                        } else if inside {
+                            Color::Reset
+                        } else {
+                            Color::Blue
+                        };
+                        assert_eq!(cell.bg, expected);
+                        assert_eq!(cell.diff_option, CellDiffOption::AlwaysUpdate);
+                    }
+                }
+            },
+        );
+    }
+}
+
+#[test]
+fn frame_clips_small_viewports_and_retains_footer_width_without_a_body() {
+    for width in [0, 1, 2, 3, 4, 20] {
+        for height in [0, 1, 2, 3, 9] {
+            for footer_height in [0, 1, 3] {
+                let area = Rect::new(7, 5, width, height);
+                let frame = DialogFrame::new(area, footer_height);
+                let mut buffer = Buffer::empty(area);
+                frame.render(&mut buffer);
+                assert_eq!(buffer.area, area);
+                assert_eq!(frame.body().width, width);
+                assert_eq!(frame.footer().width, width.saturating_sub(2));
+                assert_eq!(frame.body().height + frame.footer().height, height);
+                assert_eq!(frame.body_content().width, width.saturating_sub(4));
+            }
+        }
+    }
+}
+
+#[test]
+fn selection_and_text_dialogs_share_body_and_footer_surfaces() {
+    with_test_default_colors(
+        DefaultColors {
+            fg: (240, 240, 240),
+            bg: (0, 0, 0),
+        },
+        || {
+            let (tx, _rx) = tokio::sync::mpsc::unbounded_channel();
+            let app_event_tx = AppEventSender::new(tx);
+            let keymap = RuntimeKeymap::defaults();
+            let frame_requester = FrameRequester::test_dummy();
+            let resources = DialogResources {
+                app_event_tx: &app_event_tx,
+                keymap: &keymap,
+                frame_requester: &frame_requester,
+                vim_enabled: false,
+            };
+            let selection = resources.selection_view(SelectionViewParams {
+                title: Some("Settings".into()),
+                items: vec![SelectionItem {
+                    name: "Close".into(),
+                    ..Default::default()
+                }],
+                ..SelectionViewParams::picker()
+            });
+            let prompt = resources.text_prompt(CustomPromptView::new(
+                "Alias".into(),
+                "Enter alias".into(),
+                String::new(),
+                None,
+                Box::new(|_| {}),
+            ));
+            let multi_selection =
+                MultiSelectPicker::builder("Notifications".into(), None, app_event_tx.clone())
+                    .items(vec![MultiSelectItem {
+                        id: "completion".into(),
+                        name: "Turn completion".into(),
+                        enabled: true,
+                        ..Default::default()
+                    }])
+                    .list_keymap(keymap.list.clone())
+                    .build();
+            for view in [&selection as &dyn Renderable, &prompt, &multi_selection] {
+                let area = Rect::new(7, 3, 60, 12);
+                let mut buffer = Buffer::empty(area);
+                for cell in &mut buffer.content {
+                    cell.set_bg(Color::Blue);
+                }
+                view.render(area, &mut buffer);
+                assert_eq!(
+                    buffer[(area.x, area.y)].bg,
+                    crate::style::user_message_style().bg.unwrap()
+                );
+                for x in area.left()..area.right() {
+                    assert_eq!(buffer[(x, area.bottom() - 1)].bg, Color::Reset);
+                }
+                let footer = (area.left()..area.right())
+                    .map(|x| buffer[(x, area.bottom() - 1)].symbol())
+                    .collect::<String>();
+                assert!(footer.starts_with("  ") && footer.contains("esc"));
+            }
+        },
+    );
+}
