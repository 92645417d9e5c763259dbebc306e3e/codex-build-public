diff --git a/codex-rs/tui/src/dialog/frame.rs b/codex-rs/tui/src/dialog/frame.rs
new file mode 100644
--- /dev/null
+++ b/codex-rs/tui/src/dialog/frame.rs
@@ -0,0 +1,59 @@
+//! Shared dialog surfaces; views retain their content and interaction policies.
+
+use crate::render::Insets;
+use crate::render::RectExt;
+use ratatui::buffer::Buffer;
+use ratatui::buffer::CellDiffOption;
+use ratatui::layout::Constraint;
+use ratatui::layout::Layout;
+use ratatui::layout::Rect;
+
+pub(crate) struct DialogFrame {
+    body: Rect,
+    footer: Rect,
+}
+
+impl DialogFrame {
+    pub(crate) fn new(area: Rect, footer_height: u16) -> Self {
+        let [body, footer] =
+            Layout::vertical([Constraint::Fill(1), Constraint::Length(footer_height)]).areas(area);
+        Self { body, footer }
+    }
+
+    pub(crate) fn body(&self) -> Rect {
+        self.body
+    }
+
+    pub(crate) fn body_content(&self) -> Rect {
+        self.body.inset(Insets::vh(1, 2))
+    }
+
+    pub(crate) fn footer(&self) -> Rect {
+        self.footer.inset(Insets::tlbr(0, 2, 0, 0))
+    }
+
+    pub(crate) fn footer_width(width: u16) -> u16 {
+        width.saturating_sub(2)
+    }
+
+    pub(crate) fn render(&self, buf: &mut Buffer) {
+        for area in [self.body, self.footer] {
+            let visible = area.intersection(buf.area);
+            for y in visible.top()..visible.bottom() {
+                for x in visible.left()..visible.right() {
+                    let cell = &mut buf[(x, y)];
+                    let always_update = cell.diff_option == CellDiffOption::AlwaysUpdate;
+                    cell.reset();
+                    if always_update {
+                        cell.set_diff_option(CellDiffOption::AlwaysUpdate);
+                    }
+                }
+            }
+        }
+        buf.set_style(self.body, crate::style::user_message_style());
+    }
+}
+
+#[cfg(test)]
+#[path = "frame_tests.rs"]
+mod tests;
