+use crate::SESSIONS_SUBDIR;
+use codex_protocol::protocol::SessionStorageRecoveryEvent;
+use std::path::Path;
+use tokio::io::AsyncWriteExt;
+
+/// Rescue remains independent of the failed file and of the normal rollout discovery format.
+pub(crate) async fn save(
+    original_path: &Path,
+    jsonl: String,
+    home: &Path,
+    harness: &Path,
+) -> SessionStorageRecoveryEvent {
+    let mut recovery = SessionStorageRecoveryEvent {
+        original_path: original_path.to_path_buf(),
+        saved_path: None,
+        write_errors: Vec::new(),
+        jsonl,
+    };
+    // A fragment must not be scanned as another billable or resumable session. The bytes
+    // remain plain JSONL; only its filename distinguishes it from a complete rollout.
+    let name = format!("recovery-{}.jsonl.recovery", uuid::Uuid::new_v4());
+    for root in [home, harness] {
+        let directory = root.join(SESSIONS_SUBDIR);
+        let path = directory.join(&name);
+        let result: std::io::Result<()> = async {
+            tokio::fs::create_dir_all(&directory).await?;
+            let mut file = tokio::fs::OpenOptions::new()
+                .create_new(true)
+                .write(true)
+                .open(&path)
+                .await?;
+            file.write_all(recovery.jsonl.as_bytes()).await?;
+            file.flush().await?;
+            file.sync_all().await
+        }
+        .await;
+        match result {
+            Ok(()) => {
+                recovery.saved_path = Some(path);
+                break;
+            }
+            Err(error) => recovery
+                .write_errors
+                .push(format!("{}: {error}", path.display())),
+        }
+    }
+    recovery
+}
