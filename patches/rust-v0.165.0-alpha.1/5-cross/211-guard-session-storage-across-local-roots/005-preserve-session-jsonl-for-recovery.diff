+        if blocked < 2 {
+            let path = recovery.saved_path.unwrap();
+            let root = if blocked == 0 {
+                home.path()
+            } else {
+                harness.path()
+            };
+            assert_eq!(path.parent(), Some(root.join(SESSIONS_SUBDIR).as_path()));
+            assert_eq!(std::fs::read_to_string(&path).unwrap(), jsonl);
+            assert_ne!(path.extension(), Some(std::ffi::OsStr::new("jsonl")));
+            if blocked == 0 {
+                assert!(!harness.path().join(SESSIONS_SUBDIR).exists());
+            }
+        } else {
+            assert!(recovery.saved_path.is_none());
+            assert!(recovery.write_errors[0].contains(home.path().to_str().unwrap()));
+            assert!(recovery.write_errors[1].contains(harness.path().to_str().unwrap()));
+        }
+    }
+}
