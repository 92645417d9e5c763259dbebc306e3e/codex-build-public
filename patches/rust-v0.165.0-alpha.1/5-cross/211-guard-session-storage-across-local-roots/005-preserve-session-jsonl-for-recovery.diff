+#[derive(Serialize, Deserialize, Debug, Clone, PartialEq, JsonSchema, TS)]
+#[serde(rename_all = "camelCase")]
+#[ts(export_to = "v2/")]
+pub struct SessionStorageRecoveryNotification {
+    pub thread_id: String,
+    pub recovery: codex_protocol::protocol::SessionStorageRecoveryEvent,
+}
+
+#[cfg(test)]
+mod storage_recovery_tests {
+    use super::*;
+    use crate::ServerNotification;
+    use codex_protocol::protocol::SessionStorageRecoveryEvent;
+    use pretty_assertions::assert_eq;
+
+    #[test]
+    fn raw_jsonl_survives_notification_serialization_without_a_second_format() {
+        let jsonl = "{\"timestamp\":\"2026-10-24T00:00:00.000Z\",\"ordinal\":9,\"type\":\"event_msg\",\"payload\":{\"text\":\"a\\nb\"}}\n";
+        let notification =
+            ServerNotification::SessionStorageRecovery(SessionStorageRecoveryNotification {
+                thread_id: "thread".into(),
+                recovery: SessionStorageRecoveryEvent {
+                    original_path: "/home/sessions/original.jsonl".into(),
+                    saved_path: None,
+                    write_errors: vec!["home unavailable".into(), "harness unavailable".into()],
+                    jsonl: jsonl.into(),
+                },
+            });
+        let wire = serde_json::to_value(&notification).unwrap();
+        assert_eq!(wire["method"], "thread/storageRecovery");
+        assert_eq!(wire["params"]["recovery"]["jsonl"], jsonl);
+        let decoded: ServerNotification = serde_json::from_value(wire).unwrap();
+        let ServerNotification::SessionStorageRecovery(decoded) = decoded else {
+            panic!("storage recovery notification");
+        };
+        assert_eq!(decoded.recovery.jsonl, jsonl);
+        assert_eq!(decoded.thread_id, "thread");
+        assert_eq!(decoded.recovery.write_errors.len(), 2);
+    }
+}
+
