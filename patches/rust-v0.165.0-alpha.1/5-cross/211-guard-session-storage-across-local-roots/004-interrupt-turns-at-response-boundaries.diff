+                )
+                .await;
+            let rollout = attach_thread_persistence(Arc::get_mut(&mut session).unwrap()).await;
+            let (submissions, rx_sub) = async_channel::bounded(1);
+            let loop_task = tokio::spawn(submission_loop(
+                Arc::clone(&session),
+                Arc::clone(&context.config),
+                rx_sub,
+            ));
+            session
+                .spawn_task(
+                    Arc::clone(&context),
+                    vec![TurnInput::UserInput {
+                        metadata: Default::default(),
+                        content: vec![UserInput::Text {
+                            text: "finish this response".into(),
+                            text_elements: Vec::new(),
+                        }],
+                        client_id: None,
+                    }],
+                    RegularTask::new(),
+                )
+                .await;
+            tokio::time::timeout(Duration::from_secs(10), async {
+                loop {
+                    match events.recv().await.unwrap().msg {
+                        EventMsg::AgentMessage(message)
+                            if message.message == "before storage failure" =>
+                        {
+                            break;
+                        }
+                        EventMsg::Error(error) => panic!("response startup failed: {error:?}"),
+                        _ => {}
+                    }
+                }
+            })
+            .await
+            .expect("first response item");
+
+            if failure == "writer" {
+                tokio::fs::remove_file(&rollout).await.unwrap();
+                assert!(session.flush_rollout().await.is_err());
+            } else {
+                let capacity = LocalStorageCapacity {
+                    home_available_bytes: if failure == "home" {
+                        0
+                    } else {
+                        MIN_AVAILABLE_BYTES
+                    },
+                    harness_available_bytes: if failure == "harness" {
+                        0
+                    } else {
+                        MIN_AVAILABLE_BYTES
+                    },
+                };
+                session
+                    .request_storage_stop(capacity_failure(capacity).unwrap())
+                    .await;
+            }
+            tokio::time::timeout(Duration::from_secs(5), async {
+                loop {
+                    match events.recv().await.unwrap().msg {
+                        EventMsg::Warning(warning)
+                            if warning.message.contains("Waiting for the current response") =>
+                        {
+                            break;
+                        }
+                        EventMsg::TurnComplete(_)
+                        | EventMsg::TurnAborted(_)
+                        | EventMsg::ShutdownComplete => {
+                            panic!("storage failure truncated an active response");
+                        }
+                        _ => {}
+                    }
+                }
+            })
+            .await
+            .expect("deferred stop warning");
+            assert!(!loop_task.is_finished());
+            assert!(session.storage_guard.has_active_responses());
+            assert!(
+                session
+                    .begin_storage_response(&context.config)
+                    .await
+                    .is_err()
+            );
+
+            let mut release_response = Some(release_response);
+            if interrupt {
+                submissions
+                    .send(super::super::Submission {
+                        turn_extension_init: None,
+                        id: "interrupt-storage-wait".into(),
+                        op: Op::Interrupt,
+                        parent_turn_id: None,
+                        root_turn_id: None,
+                        residency_guard: None,
+                        message_delivery: None,
+                        dispatch_complete: None,
+                        trace: None,
+                    })
+                    .await
+                    .unwrap();
+            } else {
+                release_response.take().unwrap().send(()).unwrap();
+            }
+            let mut errors = Vec::new();
+            let mut aborted = Vec::new();
+            let mut saw_after = false;
+            tokio::time::timeout(Duration::from_secs(10), async {
+                loop {
+                    match events.recv().await.unwrap().msg {
+                        EventMsg::AgentMessage(message)
+                            if message.message == "after storage failure" =>
+                        {
+                            saw_after = true
+                        }
+                        EventMsg::Error(error) => errors.push(error),
+                        EventMsg::TurnAborted(event) => aborted.push(event),
+                        EventMsg::TurnComplete(_) => {
+                            panic!("failed storage must not complete the turn")
+                        }
+                        EventMsg::ShutdownComplete => break,
+                        _ => {}
+                    }
+                }
+            })
+            .await
+            .expect("response boundary stops the session");
+            loop_task.await.unwrap();
+            assert_eq!(saw_after, !interrupt);
+            assert_eq!(errors.len(), 1);
+            assert_eq!(aborted.len(), 1);
+            assert_eq!(aborted[0].error.as_ref(), Some(&errors[0]));
+            assert!(submissions.is_closed());
+            assert!(!session.storage_guard.has_active_responses());
+            assert_eq!(server.single_connection().len(), 1);
+            if failure == "writer" {
+                assert!(!rollout.exists());
+            } else if !interrupt {
+                assert!(
+                    tokio::fs::read_to_string(&rollout)
+                        .await
+                        .unwrap()
+                        .contains("after storage failure")
+                );
+            }
+            if let Some(release) = release_response {
+                let _ = release.send(());
+            }
+        }
+    }
+}
