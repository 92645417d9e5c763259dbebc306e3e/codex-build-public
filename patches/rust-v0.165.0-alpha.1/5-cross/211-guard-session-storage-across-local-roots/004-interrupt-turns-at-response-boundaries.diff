+        );
+        let coordinator = Arc::new(codex_rollout::WriterLockCoordinator::new(
+            &turn_context.config.codex_harness,
+        ));
+        let _writer = coordinator
+            .acquire(session.thread_id)
+            .expect("failed writer released");
+        assert_eq!(
+            tokio::fs::read(&path)
+                .await
