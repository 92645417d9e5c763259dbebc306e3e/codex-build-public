new file mode 100644
--- /dev/null
+++ b/codex-rs/core/src/session/storage_guard.rs
@@ -0,0 +1,210 @@
+//! Storage failures close admission immediately and cancel the session after active responses drain.
+
+use super::Session;
+use crate::config::Config;
+use crate::disk_capacity::LocalStorageCapacity;
+use codex_protocol::error::CodexErr;
+use codex_protocol::error::Result as CodexResult;
+use codex_protocol::protocol::CodexErrorInfo;
+use codex_protocol::protocol::ErrorEvent;
+use codex_protocol::protocol::Event;
+use codex_protocol::protocol::EventMsg;
+use codex_protocol::protocol::WarningEvent;
+use std::time::Duration;
+use tokio::sync::watch;
+
+const MIN_AVAILABLE_BYTES: u64 = 1024 * 1024 * 1024;
+
+#[derive(Default)]
+struct StorageState {
+    error: Option<ErrorEvent>,
+    active_responses: usize,
+}
+
+pub(super) struct StorageGuard {
+    state: watch::Sender<StorageState>,
+}
+
+impl Default for StorageGuard {
+    fn default() -> Self {
+        Self {
+            state: watch::channel(StorageState::default()).0,
+        }
+    }
+}
+
+impl StorageGuard {
+    pub(super) fn failure(&self) -> Option<ErrorEvent> {
+        self.state.borrow().error.clone()
+    }
+
+    pub(super) fn has_active_responses(&self) -> bool {
+        self.state.borrow().active_responses != 0
+    }
+
+    fn request_stop(&self, error: ErrorEvent) -> bool {
+        self.state.send_if_modified(|state| {
+            if state.error.is_some() {
+                return false;
+            }
+            state.error = Some(error);
+            true
+        })
+    }
+
+    fn begin_response(&self) -> Option<StorageResponseGuard> {
+        self.state
+            .send_if_modified(|state| {
+                if state.error.is_some() {
+                    return false;
+                }
+                state.active_responses += 1;
+                true
+            })
+            .then(|| StorageResponseGuard {
+                state: self.state.clone(),
+            })
+    }
+
+    async fn wait_for_failure(&self) {
+        let mut state = self.state.subscribe();
+        let _failure = state
+            .wait_for(|state| state.error.is_some())
+            .await
+            .expect("storage guard retains its sender");
+    }
+
+    async fn wait_for_responses(&self) {
+        let mut state = self.state.subscribe();
+        let _idle = state
+            .wait_for(|state| state.active_responses == 0)
+            .await
+            .expect("storage guard retains its sender");
+    }
+}
+
+/// Covers one request through its terminal response and accounting, but not subsequent tools.
+#[must_use]
+pub(crate) struct StorageResponseGuard {
+    state: watch::Sender<StorageState>,
+}
+
+impl Drop for StorageResponseGuard {
+    fn drop(&mut self) {
+        self.state.send_modify(|state| state.active_responses -= 1);
+    }
+}
+
+pub(super) fn storage_error(cause: String) -> ErrorEvent {
+    ErrorEvent {
+        misalignment: None,
+        message: format!(
+            "{cause} This session cannot continue. Fix the storage problem and reopen the session."
+        ),
+        codex_error_info: Some(CodexErrorInfo::Other),
+    }
+}
+
+fn capacity_failure(capacity: LocalStorageCapacity) -> Option<ErrorEvent> {
+    let mut insufficient = Vec::new();
+    for (root, available) in [
+        ("CODEX_HOME", capacity.home_available_bytes),
+        ("CODEX_HARNESS", capacity.harness_available_bytes),
+    ] {
+        if available < MIN_AVAILABLE_BYTES {
+            insufficient.push(format!(
+                "{root} has {available} bytes available, below 1 GiB"
+            ));
+        }
+    }
+    (!insufficient.is_empty()).then(|| storage_error(format!("{}.", insufficient.join("; "))))
+}
+
+impl Session {
+    pub(crate) fn storage_failure(&self) -> Option<ErrorEvent> {
+        self.storage_guard
+            .failure()
+            .or_else(|| self.rollout_failure())
+    }
+
+    async fn request_storage_stop(&self, error: ErrorEvent) {
+        if self.storage_guard.request_stop(error.clone())
+            && self.storage_guard.has_active_responses()
+        {
+            let id = self
+                .state
+                .lock()
+                .await
+                .last_started_turn_id
+                .clone()
+                .unwrap_or_else(super::new_submission_id);
+            self.deliver_event_raw(Event {
+                id,
+                msg: EventMsg::Warning(WarningEvent {
+                    message: format!(
+                        "{} Waiting for the current response to finish before stopping.",
+                        error.message
+                    ),
+                }),
+            })
+            .await;
+        }
+    }
+
+    async fn check_storage_capacity(&self, config: &Config) {
+        let failure = match LocalStorageCapacity::read(&config.codex_home, &config.codex_harness) {
+            Ok(capacity) => capacity_failure(capacity),
+            Err(error) => Some(storage_error(error.to_string())),
+        };
+        if let Some(error) = failure {
+            self.request_storage_stop(error).await;
+        }
+    }
+
+    pub(crate) async fn begin_storage_response(
+        &self,
+        config: &Config,
+    ) -> CodexResult<StorageResponseGuard> {
+        if let Some(error) = self.storage_failure() {
+            self.request_storage_stop(error).await;
+            return Err(CodexErr::TurnAborted);
+        }
+        self.check_storage_capacity(config).await;
+        self.storage_guard
+            .begin_response()
+            .ok_or(CodexErr::TurnAborted)
+    }
+
+    pub(crate) async fn wait_for_storage_stop(&self) {
+        if self.storage_guard.failure().is_none() {
+            tokio::select! {
+                _ = self.storage_guard.wait_for_failure() => {}
+                _ = self.wait_for_rollout_failure() => {
+                    let error = self.rollout_failure().expect("writer failure retains its error");
+                    self.request_storage_stop(error).await;
+                }
+            }
+        }
+        self.storage_guard.wait_for_responses().await;
+    }
+
+    pub(crate) async fn monitor_storage_for_turn(&self, config: &Config) {
+        let mut interval = tokio::time::interval(Duration::from_secs(1));
+        interval.set_missed_tick_behavior(tokio::time::MissedTickBehavior::Skip);
+        loop {
+            tokio::select! {
+                biased;
+                _ = self.wait_for_storage_stop() => return,
+                _ = interval.tick() => {
+                    if self.storage_failure().is_none() {
+                        self.check_storage_capacity(config).await;
+                    }
+                }
+            }
+        }
+    }
+}
+
