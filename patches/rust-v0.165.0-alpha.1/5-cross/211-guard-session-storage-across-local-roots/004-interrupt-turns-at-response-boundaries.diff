+#[test]
+fn capacity_threshold_checks_each_root_without_rounding() {
+    for (home, harness, expected) in [
+        (MIN_AVAILABLE_BYTES, MIN_AVAILABLE_BYTES, None),
+        (MIN_AVAILABLE_BYTES + 1, MIN_AVAILABLE_BYTES, None),
+        (
+            MIN_AVAILABLE_BYTES - 1,
+            MIN_AVAILABLE_BYTES,
+            Some("CODEX_HOME"),
+        ),
+        (
+            MIN_AVAILABLE_BYTES,
+            MIN_AVAILABLE_BYTES - 1,
+            Some("CODEX_HARNESS"),
+        ),
+        (0, MIN_AVAILABLE_BYTES, Some("CODEX_HOME")),
+        (MIN_AVAILABLE_BYTES, 0, Some("CODEX_HARNESS")),
+    ] {
+        let failure = capacity_failure(LocalStorageCapacity {
+            home_available_bytes: home,
+            harness_available_bytes: harness,
+        });
+        match expected {
+            Some(root) => assert!(failure.unwrap().message.contains(root)),
+            None => assert!(failure.is_none()),
+        }
+    }
+    let failure = capacity_failure(LocalStorageCapacity {
+        home_available_bytes: 0,
+        harness_available_bytes: 0,
+    })
+    .unwrap();
+    assert!(failure.message.contains("CODEX_HOME"));
+    assert!(failure.message.contains("CODEX_HARNESS"));
+}
+
+#[test]
+fn capacity_read_failures_identify_the_unreadable_root() {
+    let root = tempfile::tempdir().unwrap();
+    let missing = root.path().join("missing");
+    for (home, harness, label) in [
+        (missing.as_path(), root.path(), "Codex home"),
+        (root.path(), missing.as_path(), "Codex harness"),
+    ] {
+        let error = LocalStorageCapacity::read(home, harness).unwrap_err();
+        assert_eq!(error.kind(), std::io::ErrorKind::NotFound);
+        assert!(error.to_string().contains(label));
+    }
+}
+
+#[tokio::test]
+async fn stopping_closes_admission_but_waits_for_all_existing_responses() {
+    let guard = StorageGuard::default();
+    let first = guard.begin_response().unwrap();
+    let second = guard.begin_response().unwrap();
+    let error = storage_error("storage failure".into());
+    assert!(guard.request_stop(error.clone()));
+    assert!(!guard.request_stop(storage_error("later failure".into())));
+    assert_eq!(guard.failure(), Some(error));
+    assert!(guard.begin_response().is_none());
+    assert!(guard.wait_for_responses().now_or_never().is_none());
+    drop(first);
+    assert!(guard.wait_for_responses().now_or_never().is_none());
+    drop(second);
+    assert!(guard.wait_for_responses().now_or_never().is_some());
+    assert!(guard.begin_response().is_none());
+}
+
