+#[tokio::test]
+async fn rollout_failure_stops_waiting_turn_and_closes_session() {
+    struct WaitingTask {
+        started: Arc<Notify>,
+        write: Arc<Notify>,
+        stopped: CancellationToken,
+    }
+
+    impl SessionTask for WaitingTask {
+        fn kind(&self) -> TaskKind {
+            TaskKind::Regular
+        }
+
+        fn span_name(&self) -> &'static str {
+            "session_task.persistence_failure"
+        }
+
+        async fn run(
+            self: Arc<Self>,
+            session: Arc<Session>,
+            _ctx: Arc<TurnContext>,
+            _input: Vec<TurnInput>,
+            _cancellation_token: CancellationToken,
+        ) -> SessionTaskResult {
+            let _stopped = self.stopped.clone().drop_guard();
+            self.started.notify_one();
+            self.write.notified().await;
+            // The same failure must stop a task whether it originates inside the task or in
+            // a concurrent producer while this task is waiting for a tool or user response.
+            let _ = session.flush_rollout().await;
+            std::future::pending().await
+        }
+    }
+
+    for write_from_task in [false, true] {
+        let home = tempfile::tempdir().expect("session home");
+        let (mut session, turn_context, events) =
+            make_session_and_context_with_auth_config_home_and_rx(
+                CodexAuth::from_api_key("Test API Key"),
+                Vec::new(),
+                home.path(),
+                |_config| {},
+            )
+            .await;
+        let path =
+            attach_thread_persistence(Arc::get_mut(&mut session).expect("unique session")).await;
+        let started = Arc::new(Notify::new());
+        let write = Arc::new(Notify::new());
+        let stopped = CancellationToken::new();
+        session
+            .spawn_task(
+                Arc::clone(&turn_context),
+                Vec::new(),
+                WaitingTask {
+                    started: Arc::clone(&started),
+                    write: Arc::clone(&write),
+                    stopped: stopped.clone(),
+                },
+            )
+            .await;
+        tokio::time::timeout(StdDuration::from_secs(2), started.notified())
+            .await
+            .expect("task started");
+        let (submissions, rx_sub) = async_channel::bounded(1);
+        let loop_task = tokio::spawn(submission_loop(
+            Arc::clone(&session),
+            Arc::clone(&turn_context.config),
+            rx_sub,
+        ));
+
+        let original = tokio::fs::read(&path).await.expect("original rollout");
+        let replacement = home.path().join("replacement.jsonl");
+        tokio::fs::write(&replacement, &original)
+            .await
+            .expect("replacement rollout");
+        tokio::fs::rename(&replacement, &path)
+            .await
+            .expect("replace outside writer lock");
+        if write_from_task {
+            write.notify_one();
+        } else {
+            assert!(session.flush_rollout().await.is_err());
+        }
+
+        let mut errors = Vec::new();
+        let mut aborted = Vec::new();
+        tokio::time::timeout(StdDuration::from_secs(5), async {
+            loop {
+                let event = events.recv().await.expect("session event");
+                match event.msg {
+                    EventMsg::Error(error) => errors.push(error),
+                    EventMsg::TurnAborted(event) => aborted.push(event),
+                    EventMsg::TurnComplete(_) => {
+                        panic!("failed persistence must not complete the turn")
+                    }
+                    EventMsg::ShutdownComplete => break,
+                    _ => {}
+                }
+            }
+        })
+        .await
+        .expect("persistence failure must stop a waiting turn immediately");
+        tokio::time::timeout(StdDuration::from_secs(2), loop_task)
+            .await
+            .expect("submission loop stopped")
+            .expect("submission loop joined");
+
+        assert_eq!(errors.len(), 1);
+        assert!(
+            errors[0]
+                .message
+                .contains("Failed to save the conversation")
+        );
+        assert!(errors[0].message.contains("outside its writer"));
+        assert_eq!(aborted.len(), 1);
+        assert_eq!(
+            aborted[0].turn_id.as_deref(),
+            Some(turn_context.sub_id.as_str())
+        );
+        assert_eq!(aborted[0].error.as_ref(), Some(&errors[0]));
+        assert!(
+            stopped.is_cancelled(),
+            "the pending task future must be dropped"
+        );
+        assert!(session.active_turn.lock().await.is_none());
+        assert!(session.state.lock().await.shutting_down);
+        assert!(
