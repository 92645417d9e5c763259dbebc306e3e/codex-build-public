diff --git a/codex-rs/core/src/disk_capacity.rs b/codex-rs/core/src/disk_capacity.rs
new file mode 100644
--- /dev/null
+++ b/codex-rs/core/src/disk_capacity.rs
@@ -0,0 +1,75 @@
+//! Usable filesystem capacity shared by Doctor, session protection and display consumers.
+
+use std::ffi::CString;
+use std::io;
+use std::mem::MaybeUninit;
+use std::os::unix::ffi::OsStrExt;
+use std::path::Path;
+
+/// Usable bytes on the effective Codex home and harness filesystems.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub struct LocalStorageCapacity {
+    pub home_available_bytes: u64,
+    pub harness_available_bytes: u64,
+}
+
+impl LocalStorageCapacity {
+    pub fn read(home: &Path, harness: &Path) -> io::Result<Self> {
+        let home_available_bytes = available_space(home).map_err(|error| {
+            io::Error::new(
+                error.kind(),
+                format!("failed to read Codex home disk capacity: {error}"),
+            )
+        })?;
+        let harness_available_bytes = available_space(harness).map_err(|error| {
+            io::Error::new(
+                error.kind(),
+                format!("failed to read Codex harness disk capacity: {error}"),
+            )
+        })?;
+        Ok(Self {
+            home_available_bytes,
+            harness_available_bytes,
+        })
+    }
+}
+
+pub fn available_space(path: &Path) -> io::Result<u64> {
+    let path = CString::new(path.as_os_str().as_bytes())
+        .map_err(|_| io::Error::new(io::ErrorKind::InvalidInput, "path contains NUL"))?;
+    let mut stats = MaybeUninit::<libc::statvfs>::uninit();
+    // The C path is NUL-terminated and stats points to writable, correctly aligned storage.
+    if unsafe { libc::statvfs(path.as_ptr(), stats.as_mut_ptr()) } != 0 {
+        return Err(io::Error::last_os_error());
+    }
+    // A successful statvfs initialized the complete structure.
+    let stats = unsafe { stats.assume_init() };
+    if stats.f_files > 0 && stats.f_favail == 0 {
+        return Ok(0);
+    }
+    u64::try_from(u128::from(stats.f_bavail) * u128::from(stats.f_frsize))
+        .map_err(|_| io::Error::other("available disk space exceeds u64"))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn reads_existing_home_and_preserves_unavailable_capacity() {
+        let home = tempfile::tempdir().unwrap();
+        assert!(available_space(home.path()).is_ok());
+        assert_eq!(
+            available_space(&home.path().join("missing"))
+                .unwrap_err()
+                .kind(),
+            io::ErrorKind::NotFound
+        );
+        assert_eq!(
+            available_space(Path::new("invalid\0path"))
+                .unwrap_err()
+                .kind(),
+            io::ErrorKind::InvalidInput
+        );
+    }
+}
