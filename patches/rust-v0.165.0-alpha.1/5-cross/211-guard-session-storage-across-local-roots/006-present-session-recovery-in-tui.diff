@@ -0,0 +1,93 @@
+//! Keep recovery bytes separate from the visible diagnostic so every copy is appendable JSONL.
+
+use super::*;
+use codex_protocol::protocol::SessionStorageRecoveryEvent;
+
+pub(crate) fn new_session_recovery(recovery: SessionStorageRecoveryEvent) -> WarningHistoryCell {
+    let mut lines = vec![
+        Line::from(
+            "• Session stopped after a history write failure. Recovery JSONL is retained in warnings for copying.",
+        ),
+        Line::from(format!("Original: {}", recovery.original_path.display())),
+    ];
+    lines.push(Line::from(match recovery.saved_path {
+        Some(path) => format!("Recovery saved: {}", path.display()),
+        None => "Recovery could not be saved to either storage root.".into(),
+    }));
+    lines.extend(recovery.write_errors.into_iter().map(Line::from));
+    // Native warning identity includes the rescue destination or attempted paths, so separate
+    // failures of the same original file cannot merge their distinct JSONL fragments.
+    let key = lines
+        .iter()
+        .map(ToString::to_string)
+        .collect::<Vec<_>>()
+        .join("\n");
+    let style = crate::style::status_style(crate::style::StatusTone::Attention);
+    WarningHistoryCell {
+        server_version_notice: false,
+        visible_in_transcript: true,
+        key,
+        diagnostic: recovery.jsonl,
+        details: PrefixedWrappedHistoryCell::new(Text::from(lines).style(style), "", "  "),
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use pretty_assertions::assert_eq;
+
+    #[test]
+    fn recovery_is_visible_but_copy_contains_only_the_exact_jsonl() {
+        let jsonl = "{\"ordinal\":9,\"text\":\"a\\nb\"}\n{\"ordinal\":10}\n";
+        for saved in [false, true] {
+            let cell = new_session_recovery(SessionStorageRecoveryEvent {
+                original_path: "/sessions/original.jsonl".into(),
+                saved_path: saved.then(|| "/sessions/rescue.jsonl.recovery".into()),
+                write_errors: vec!["home unavailable".into()],
+                jsonl: jsonl.into(),
+            });
+            for mode in [HistoryRenderMode::Rich, HistoryRenderMode::Raw] {
+                let lines = cell.display_lines_for_mode(80, mode);
+                let visible = lines
+                    .iter()
+                    .map(ToString::to_string)
+                    .collect::<Vec<_>>()
+                    .join("\n");
+                assert!(visible.starts_with("• "));
+                assert!(visible.contains("Session stopped"));
+                assert!(visible.contains("home unavailable"));
+                assert!(visible.contains("Original: /sessions/original.jsonl"));
+                assert!(!visible.contains(jsonl));
+            }
+            assert_eq!(cell.warning_entries()[0].details, jsonl);
+            assert_eq!(cell.warning_keys().len(), 1);
+        }
+    }
+
+    #[test]
+    fn separate_rescues_of_one_original_file_keep_their_payloads_separate() {
+        for saved in [false, true] {
+            let cells: Vec<std::sync::Arc<dyn HistoryCell>> = ["first", "second"]
+                .into_iter()
+                .map(|name| {
+                    std::sync::Arc::new(new_session_recovery(SessionStorageRecoveryEvent {
+                        original_path: "/sessions/original.jsonl".into(),
+                        saved_path: saved
+                            .then(|| format!("/sessions/{name}.jsonl.recovery").into()),
+                        write_errors: if saved {
+                            Vec::new()
+                        } else {
+                            vec![format!("/sessions/{name}.jsonl.recovery: disk full")]
+                        },
+                        jsonl: format!("{{\"record\":\"{name}\"}}\n"),
+                    })) as std::sync::Arc<dyn HistoryCell>
+                })
+                .collect();
+            let entries = warning_entries(&cells);
+            assert_eq!(entries.len(), 2);
+            assert_eq!(entries[0].details, "{\"record\":\"first\"}\n");
+            assert_eq!(entries[1].details, "{\"record\":\"second\"}\n");
+        }
+    }
+}
