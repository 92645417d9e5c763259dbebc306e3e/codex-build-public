+use super::*;
+use crate::app::tests::make_test_app_with_channels;
+use crate::app::tests::test_thread_session;
+use crate::chatwidget::ReplayKind;
+use crate::clipboard_copy::CopyFormat;
+use codex_app_server_client::AppServerEvent;
+use codex_app_server_protocol::SessionStorageRecoveryNotification;
+use codex_app_server_protocol::ThreadClosedNotification;
+use codex_protocol::protocol::SessionStorageRecoveryEvent;
+use pretty_assertions::assert_eq;
+
+fn recovery(thread_id: ThreadId, saved: bool, jsonl: &str) -> ServerNotification {
+    ServerNotification::SessionStorageRecovery(SessionStorageRecoveryNotification {
+        thread_id: thread_id.to_string(),
+        recovery: SessionStorageRecoveryEvent {
+            original_path: "/sessions/original.jsonl".into(),
+            saved_path: saved.then(|| "/sessions/rescue.jsonl.recovery".into()),
+            write_errors: if saved {
+                Vec::new()
+            } else {
+                vec!["home full".into(), "harness full".into()]
+            },
+            jsonl: jsonl.into(),
+        },
+    })
+}
+
+#[tokio::test]
+async fn live_recovery_copies_inactive_threads_regardless_of_disk_result_but_replay_does_not()
+-> Result<()> {
+    let (mut app, mut events, _) = make_test_app_with_channels().await;
+    let server = crate::start_embedded_app_server_for_picker(&app.config).await?;
+    let primary = ThreadId::new();
+    app.enqueue_primary_thread_session(
+        test_thread_session(primary, app.config.cwd.to_path_buf()),
+        Vec::new(),
+    )
+    .await?;
+    let jsonl = "{\"ordinal\":9,\"text\":\"a\\nb\"}\n{\"ordinal\":10}\n";
+    while events.try_recv().is_ok() {}
+    let unrelated = ThreadId::new();
+    app.handle_app_server_event(
+        &server,
+        AppServerEvent::ServerNotification(Box::new(recovery(unrelated, false, jsonl))),
+    )
+    .await;
+    assert!(!app.thread_event_channels.contains_key(&unrelated));
+    assert!(
+        !std::iter::from_fn(|| events.try_recv().ok())
+            .any(|event| matches!(event, AppEvent::CopySelection { .. }))
+    );
+    for saved in [false, true] {
+        while events.try_recv().is_ok() {}
+        let background = ThreadId::new();
+        app.ensure_thread_channel(background);
+        let notification = recovery(background, saved, jsonl);
+        app.handle_app_server_event(
+            &server,
+            AppServerEvent::ServerNotification(Box::new(notification.clone())),
+        )
+        .await;
+        let copies = std::iter::from_fn(|| events.try_recv().ok())
+            .filter_map(|event| match event {
+                AppEvent::CopySelection { text, format, .. } => Some((text, format)),
+                _ => None,
+            })
+            .collect::<Vec<_>>();
+        assert_eq!(copies.len(), 1);
+        assert_eq!(copies[0].0.as_ref(), jsonl);
+        assert_eq!(copies[0].1, CopyFormat::PlainText);
+        assert_eq!(app.active_thread_id, Some(primary));
+        let channel = app
+            .thread_event_channels
+            .get(&background)
+            .expect("inactive recovery retained");
+        assert!(channel.store.lock().await.buffer.iter().any(|event| matches!(event,
+            ThreadBufferedEvent::Notification(notification) if matches!(notification.as_ref(), ServerNotification::SessionStorageRecovery(_))
+        )));
+
+        app.chat_widget
+            .handle_server_notification(notification, Some(ReplayKind::ThreadSnapshot));
+        let replay = std::iter::from_fn(|| events.try_recv().ok()).collect::<Vec<_>>();
+        assert!(
+            !replay
+                .iter()
+                .any(|event| matches!(event, AppEvent::CopySelection { .. }))
+        );
+        let cells: Vec<Arc<dyn HistoryCell>> = replay
+            .into_iter()
+            .filter_map(|event| match event {
+                AppEvent::InsertHistoryCell(cell) => Some(Arc::from(cell)),
+                _ => None,
+            })
+            .collect();
+        assert!(
+            history_cell::warning_entries(&cells)
+                .iter()
+                .any(|entry| entry.details == jsonl)
+        );
+        app.chat_widget.open_warnings(&cells);
+        app.chat_widget
+            .handle_key_event(KeyEvent::new(KeyCode::Char('o'), KeyModifiers::CONTROL));
+        let copied = std::iter::from_fn(|| events.try_recv().ok())
+            .filter_map(|event| match event {
+                AppEvent::CopyWarning(text) => Some(text),
+                _ => None,
+            })
+            .collect::<Vec<_>>();
+        assert_eq!(copied, vec![jsonl.to_string()]);
+        app.chat_widget.handle_key_event(KeyCode::Esc.into());
+    }
+    server.shutdown().await?;
+    Ok(())
+}
+
+#[tokio::test]
+async fn recovery_close_retains_the_view_and_explicit_exit_still_closes() -> Result<()> {
+    let (mut app, mut events, _) = make_test_app_with_channels().await;
+    let thread_id = ThreadId::new();
+    app.enqueue_primary_thread_session(
+        test_thread_session(thread_id, app.config.cwd.to_path_buf()),
+        Vec::new(),
+    )
+    .await?;
+    let mut tui = crate::tui::test_support::make_test_tui()?;
+    app.drain_active_thread_events_until(&mut tui, Instant::now() + Duration::from_secs(1))
+        .await?;
+    while events.try_recv().is_ok() {}
+    app.enqueue_thread_notification(thread_id, recovery(thread_id, false, "{\"ordinal\":9}\n"))
+        .await?;
+    let close = ServerNotification::ThreadClosed(ThreadClosedNotification {
+        thread_id: thread_id.to_string(),
+    });
+    app.enqueue_thread_notification(thread_id, close.clone())
+        .await?;
+    app.drain_active_thread_events_until(&mut tui, Instant::now() + Duration::from_secs(1))
+        .await?;
+    let retained = std::iter::from_fn(|| events.try_recv().ok()).collect::<Vec<_>>();
+    assert!(
+        !retained
+            .iter()
+            .any(|event| matches!(event, AppEvent::Exit(_)))
+    );
+    assert!(retained.iter().any(|event| matches!(event,
+        AppEvent::InsertHistoryCell(cell) if cell.warning_entries().iter().any(|entry| entry.details == "{\"ordinal\":9}\n")
+    )));
+    assert_eq!(app.active_thread_id, Some(thread_id));
+    {
+        let mut store = app.thread_event_channels[&thread_id].store.lock().await;
+        store.rebase_buffer_after_session_refresh();
+        assert!(store.buffer.iter().any(|event| matches!(event,
+            ThreadBufferedEvent::Notification(notification) if matches!(notification.as_ref(), ServerNotification::SessionStorageRecovery(_))
+        )));
+    }
+    app.pending_shutdown_exit_thread_id = Some(thread_id);
+    app.enqueue_thread_notification(thread_id, close).await?;
+    app.drain_active_thread_events_until(&mut tui, Instant::now() + Duration::from_secs(1))
+        .await?;
+    assert!(
+        std::iter::from_fn(|| events.try_recv().ok())
+            .any(|event| matches!(event, AppEvent::Exit(ExitMode::Immediate)))
+    );
+    Ok(())
+}
