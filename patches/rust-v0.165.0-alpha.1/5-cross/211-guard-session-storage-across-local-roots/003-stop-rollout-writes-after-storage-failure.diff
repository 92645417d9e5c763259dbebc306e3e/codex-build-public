+#[tokio::test]
+async fn external_rollout_changes_stop_writes_without_reopening() -> std::io::Result<()> {
+    for change in ["replace", "delete", "truncate", "append", "rewrite"] {
+        let home = TempDir::new().expect("temp dir");
+        let config = test_config(home.path());
+        let rollout_path = home.path().join("rollout.jsonl");
+        write_paginated_rollout(&rollout_path, ThreadId::new(), &[1])?;
+        let original = fs::read(&rollout_path)?;
+        let recorder =
+            RolloutRecorder::new(&config, RolloutRecorderParams::resume(rollout_path.clone()))
+                .await?;
+        let mut failure = recorder.failure_receiver();
+
+        match change {
+            "replace" => {
+                let replacement = home.path().join("replacement.jsonl");
+                fs::write(&replacement, &original)?;
+                fs::rename(replacement, &rollout_path)?;
+            }
+            "delete" => fs::remove_file(&rollout_path)?,
+            "truncate" => {
+                File::create(&rollout_path)?;
+            }
+            "append" => {
+                File::options()
+                    .append(true)
+                    .open(&rollout_path)?
+                    .write_all(b"{}\n")?;
+            }
+            "rewrite" => {
+                // Preserve length and mtime; the native change time still exposes this edit.
+                let modified = fs::metadata(&rollout_path)?.modified()?;
+                let mut changed = original.clone();
+                changed[0] = b'[';
+                fs::write(&rollout_path, changed)?;
+                File::open(&rollout_path)?
+                    .set_times(fs::FileTimes::new().set_modified(modified))?;
+            }
+            _ => unreachable!(),
+        }
+        let externally_changed = fs::read(&rollout_path).ok();
+        recorder
+            .record_canonical_items(&[agent_message_item("must-not-append")])
+            .await?;
+        let error = recorder.flush().await.expect_err(change);
+        assert!(failure.borrow_and_update().is_some(), "{change}");
+        assert_eq!(fs::read(&rollout_path).ok(), externally_changed, "{change}");
+
+        fs::write(&rollout_path, &original)?;
+        assert_eq!(
+            recorder.flush().await.unwrap_err().to_string(),
+            error.to_string(),
+            "{change}"
+        );
+        assert_eq!(fs::read(&rollout_path)?, original, "{change}");
+        recorder.discard().await?;
+    }
+    Ok(())
+}
