+use anyhow::Result;
+use app_test_support::TestAppServer;
+use codex_app_server_protocol::ClientRequest;
+use codex_app_server_protocol::RequestId;
+use codex_app_server_protocol::TelegramCommandParams;
+use codex_app_server_protocol::TelegramCommandResponse;
+use codex_app_server_protocol::TelegramNotificationKind;
+use pretty_assertions::assert_eq;
+use std::collections::BTreeSet;
+
+#[tokio::test]
+async fn telegram_rpc_reads_selects_and_disables_only_its_shared_configuration() -> Result<()> {
+    let home = tempfile::tempdir()?;
+    let settings_path = home.path().join("integrations.json");
+    let saved = r#"{"proxy":{"enabled":false,"selected":"retained","entries":[{"alias":"retained","url":"http://127.0.0.1:8080"}]},"telegram":{"bot_token":"bot-secret","chat_id":"chat-secret","notifications":["needsInput"]}}"#;
+    std::fs::write(&settings_path, saved)?;
+    let mut server = TestAppServer::builder()
+        .with_codex_home(home.path())
+        .build_initialized()
+        .await?;
+    let loaded: TelegramCommandResponse = server
+        .request(|request_id| ClientRequest::TelegramCommand {
+            request_id,
+            params: TelegramCommandParams::Read {},
+        })
+        .await?;
+    assert!(loaded.configured);
+    assert_eq!(
+        loaded.notifications,
+        BTreeSet::from([TelegramNotificationKind::NeedsInput])
+    );
+    let wire = serde_json::to_string(&loaded)?;
+    for secret in ["bot-secret", "chat-secret"] {
+        assert!(!wire.contains(secret));
+    }
+    let rejected_id = server
+        .send_request(
+            "telegram/command",
+            Some(serde_json::json!({"kind": "read", "text": "unexpected"})),
+        )
+        .await?;
+    let rejected = tokio::time::timeout(
+        std::time::Duration::from_secs(10),
+        server.read_stream_until_error_message(RequestId::Integer(rejected_id)),
+    )
+    .await??;
+    assert_eq!(rejected.error.code, -32600);
+    assert_eq!(std::fs::read_to_string(&settings_path)?, saved);
+    let kinds = BTreeSet::from([
+        TelegramNotificationKind::CodexRelease,
+        TelegramNotificationKind::ModelChanges,
+    ]);
+    for notification in &kinds {
+        let _: TelegramCommandResponse = server
+            .request(|request_id| ClientRequest::TelegramCommand {
+                request_id,
+                params: TelegramCommandParams::SetNotification {
+                    notification: *notification,
+                    enabled: true,
+                },
+            })
+            .await?;
+    }
+    let selected: TelegramCommandResponse = server
+        .request(|request_id| ClientRequest::TelegramCommand {
+            request_id,
+            params: TelegramCommandParams::SetNotification {
+                notification: TelegramNotificationKind::NeedsInput,
+                enabled: false,
+            },
+        })
+        .await?;
+    assert_eq!(selected.notifications, kinds);
+    let disabled: TelegramCommandResponse = server
+        .request(|request_id| ClientRequest::TelegramCommand {
+            request_id,
+            params: TelegramCommandParams::Disable {},
+        })
+        .await?;
+    assert_eq!(disabled, TelegramCommandResponse::default());
+    let persisted: serde_json::Value = serde_json::from_slice(&std::fs::read(settings_path)?)?;
+    assert!(persisted["telegram"].is_null());
+    assert_eq!(persisted["proxy"]["selected"], "retained");
+    assert_eq!(
+        persisted["proxy"]["entries"][0]["url"],
+        "http://127.0.0.1:8080"
+    );
+    assert!(server.shutdown_gracefully().await?.success());
+    Ok(())
+}
