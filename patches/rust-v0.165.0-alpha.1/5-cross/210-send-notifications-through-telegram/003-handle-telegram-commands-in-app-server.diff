+#[tokio::test]
+async fn dropping_processor_releases_its_background_owner() {
+    let home = tempfile::tempdir().unwrap();
+    let server = MockServer::start().await;
+    let (processor, _models, _github) = processor(&server, home.path(), None);
+    let inner = Arc::downgrade(&processor.inner);
+    drop(processor);
+    tokio::time::timeout(Duration::from_secs(5), async {
+        while inner.upgrade().is_some() {
+            tokio::task::yield_now().await;
+        }
+    })
+    .await
+    .expect("worker owner released on drop");
+}
