+    let server = MockServer::start().await;
+    Mock::given(method("POST"))
+        .and(path("/bot123:secret/sendMessage"))
+        .respond_with(ResponseTemplate::new(200).set_body_json(json!({"ok": true})))
+        .expect(3)
+        .mount(&server)
+        .await;
+    let (processor, _models, _github) = processor(&server, home.path(), None);
+    let notifications = BTreeSet::from([
+        TelegramNotificationKind::TurnCompletion,
+        TelegramNotificationKind::NeedsInput,
+    ]);
+    let configured = processor
+        .command(TelegramCommandParams::Configure {
+            setup: TelegramSetup {
+                bot_token: "123:secret".into(),
+                chat_id: "chat".into(),
+                notifications: notifications.clone(),
+            },
+        })
+        .await
+        .unwrap();
+    assert!(configured.configured);
+    assert_eq!(configured.notifications, notifications);
+    assert!(
+        !serde_json::to_string(&configured)
+            .unwrap()
+            .contains("secret")
+    );
+    for duration_ms in [29_999, 30_000] {
+        processor
+            .command(TelegramCommandParams::Completion {
+                text: "turn complete".into(),
+                duration_ms,
+            })
+            .await
+            .unwrap();
+    }
+    let input = TelegramCommandParams::NeedsInput {
+        text: "approval required".into(),
+        notification_id: "approval-1".into(),
+    };
+    processor.command(input.clone()).await.unwrap();
+    processor.command(input).await.unwrap();
+    for notification in notifications {
+        processor
+            .command(TelegramCommandParams::SetNotification {
+                notification,
+                enabled: false,
+            })
+            .await
+            .unwrap();
+    }
