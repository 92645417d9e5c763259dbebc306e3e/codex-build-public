@@ -0,0 +1,386 @@
+use codex_app_server_protocol::GithubRelease;
+use codex_app_server_protocol::GithubStatus;
+use codex_app_server_protocol::JSONRPCErrorError;
+use codex_app_server_protocol::ModelChange;
+use codex_app_server_protocol::ModelChangedNotification;
+use codex_app_server_protocol::TelegramCommandParams;
+use codex_app_server_protocol::TelegramCommandResponse;
+use codex_app_server_protocol::TelegramNotificationKind;
+use codex_http_client::HttpClientFactory;
+use semver::Version;
+use std::collections::VecDeque;
+use std::sync::Arc;
+use tokio::sync::Mutex;
+use tokio::sync::broadcast;
+use tokio::sync::watch;
+use tokio::task::JoinHandle;
+use tokio_util::sync::CancellationToken;
+
+use crate::error_code::internal_error;
+use crate::error_code::invalid_params;
+use crate::integrations::IntegrationsStore;
+use crate::integrations::TelegramConfig;
+use crate::integrations::default_completion_min_duration_ms;
+use crate::telegram_http::Destination;
+use crate::telegram_http::TelegramHttp;
+
+pub(crate) struct TelegramProcessor {
+    inner: Arc<Inner>,
+    cancel: CancellationToken,
+    _task: JoinHandle<()>,
+}
+
+struct Inner {
+    store: Arc<IntegrationsStore>,
+    http: TelegramHttp,
+    recent: Mutex<VecDeque<String>>,
+    releases: Mutex<ReleaseBaselines>,
+    github: watch::Receiver<Option<GithubStatus>>,
+}
+
+#[derive(Default)]
+struct ReleaseBaselines {
+    stable: Option<Version>,
+    prerelease: Option<Version>,
+}
+
+impl ReleaseBaselines {
+    fn from_status(status: Option<&GithubStatus>) -> Self {
+        Self {
+            stable: status
+                .and_then(|status| status.latest_release.as_ref())
+                .map(release_version),
+            prerelease: status
+                .and_then(|status| status.latest_prerelease.as_ref())
+                .map(release_version),
+        }
+    }
+}
+
+impl TelegramProcessor {
+    pub(crate) fn new(
+        store: Arc<IntegrationsStore>,
+        factory: HttpClientFactory,
+        models: broadcast::Receiver<ModelChangedNotification>,
+        github: watch::Receiver<Option<GithubStatus>>,
+    ) -> Self {
+        Self::with_http(store, TelegramHttp::new(factory), models, github)
+    }
+
+    fn with_http(
+        store: Arc<IntegrationsStore>,
+        http: TelegramHttp,
+        mut models: broadcast::Receiver<ModelChangedNotification>,
+        mut github: watch::Receiver<Option<GithubStatus>>,
+    ) -> Self {
+        let baselines = ReleaseBaselines::from_status(github.borrow().as_ref());
+        let inner = Arc::new(Inner {
+            store,
+            http,
+            recent: Mutex::new(VecDeque::new()),
+            releases: Mutex::new(baselines),
+            github: github.clone(),
+        });
+        let cancel = CancellationToken::new();
+        let worker_inner = Arc::clone(&inner);
+        let worker_cancel = cancel.clone();
+        let task = tokio::spawn(async move {
+            tokio::select! {
+                _ = worker_cancel.cancelled() => {},
+                _ = async {
+                    loop {
+                        tokio::select! {
+                            change = models.recv() => match change {
+                                Ok(change) => {
+                                    if worker_inner.notify_models(&change).await.is_err() {
+                                        tracing::warn!("Telegram model notification failed");
+                                    }
+                                }
+                                Err(broadcast::error::RecvError::Lagged(skipped)) => {
+                                    tracing::warn!(skipped, "Telegram model subscription lagged");
+                                }
+                                Err(broadcast::error::RecvError::Closed) => break,
+                            },
+                            changed = github.changed() => {
+                                if changed.is_err() {
+                                    break;
+                                }
+                                let status = github.borrow_and_update().clone();
+                                if let Some(status) = status
+                                    && worker_inner.notify_releases(&status).await.is_err()
+                                {
+                                    tracing::warn!("Telegram release notification failed");
+                                }
+                            },
+                        }
+                    }
+                } => {},
+            }
+        });
+        Self {
+            inner,
+            cancel,
+            _task: task,
+        }
+    }
+
+    pub(crate) fn shutdown(&self) {
+        self.cancel.cancel();
+    }
+
+    pub(crate) async fn command(
+        &self,
+        params: TelegramCommandParams,
+    ) -> Result<TelegramCommandResponse, JSONRPCErrorError> {
+        let mut message = None;
+        match params {
+            TelegramCommandParams::Read {} => {}
+            TelegramCommandParams::Configure { setup } => {
+                if self.inner.store.telegram().is_some() {
+                    return Err(invalid_params("configuration already exists"));
+                }
+                let config = TelegramConfig {
+                    bot_token: setup.bot_token.trim().to_owned(),
+                    chat_id: setup.chat_id.trim().to_owned(),
+                    notifications: setup.notifications,
+                    completion_min_duration_ms: default_completion_min_duration_ms(),
+                };
+                config
+                    .validate()
+                    .map_err(|error| invalid_params(error.to_string()))?;
+                self.inner
+                    .send(&config, "Codex notifications are connected.")
+                    .await
+                    .map_err(|_| internal_error("Bot delivery test failed"))?;
+                let mut releases = self.inner.releases.lock().await;
+                self.inner
+                    .store
+                    .set_telegram(Some(config))
+                    .await
+                    .map_err(storage_error)?;
+                *releases = ReleaseBaselines::from_status(self.inner.github.borrow().as_ref());
+                message = Some("Bot delivery passed; configuration saved.".to_owned());
+            }
+            TelegramCommandParams::SetNotification {
+                notification,
+                enabled,
+            } => {
+                let mut releases = self.inner.releases.lock().await;
+                let mut config = self.inner.store.telegram().ok_or_else(disabled)?;
+                let newly_enabled = if enabled {
+                    config.notifications.insert(notification)
+                } else {
+                    config.notifications.remove(&notification);
+                    false
+                };
+                self.inner
+                    .store
+                    .set_telegram(Some(config))
+                    .await
+                    .map_err(storage_error)?;
+                if newly_enabled {
+                    let current =
+                        ReleaseBaselines::from_status(self.inner.github.borrow().as_ref());
+                    match notification {
+                        TelegramNotificationKind::CodexRelease => releases.stable = current.stable,
+                        TelegramNotificationKind::CodexPrerelease => {
+                            releases.prerelease = current.prerelease
+                        }
+                        TelegramNotificationKind::TurnCompletion
+                        | TelegramNotificationKind::NeedsInput
+                        | TelegramNotificationKind::ModelChanges => {}
+                    }
+                }
+            }
+            TelegramCommandParams::Disable {} => {
+                let mut releases = self.inner.releases.lock().await;
+                self.inner
+                    .store
+                    .set_telegram(None)
+                    .await
+                    .map_err(storage_error)?;
+                *releases = ReleaseBaselines::from_status(self.inner.github.borrow().as_ref());
+            }
+            TelegramCommandParams::NeedsInput {
+                text,
+                notification_id,
+            } => {
+                let text = notification_message(text)?;
+                let config = self.inner.store.telegram().ok_or_else(disabled)?;
+                if config
+                    .notifications
+                    .contains(&TelegramNotificationKind::NeedsInput)
+                {
+                    self.inner.deliver(&config, notification_id, text).await?;
+                }
+            }
+            TelegramCommandParams::Completion { text, duration_ms } => {
+                let text = notification_message(text)?;
+                let config = self.inner.store.telegram().ok_or_else(disabled)?;
+                if config
+                    .notifications
+                    .contains(&TelegramNotificationKind::TurnCompletion)
+                    && duration_ms >= config.completion_min_duration_ms
+                {
+                    self.inner.deliver(&config, text.clone(), text).await?;
+                }
+            }
+        }
+        let mut result = response(self.inner.store.telegram());
+        result.message = message;
+        Ok(result)
+    }
+}
+
+impl Drop for TelegramProcessor {
+    fn drop(&mut self) {
+        self.shutdown();
+    }
+}
+
+impl Inner {
+    async fn deliver(
+        &self,
+        config: &TelegramConfig,
+        key: String,
+        text: String,
+    ) -> Result<(), JSONRPCErrorError> {
+        let mut recent = self.recent.lock().await;
+        if recent.contains(&key) {
+            return Ok(());
+        }
+        self.send(config, &text)
+            .await
+            .map_err(|_| internal_error("Telegram delivery failed"))?;
+        recent.push_back(key);
+        if recent.len() > 128 {
+            recent.pop_front();
+        }
+        Ok(())
+    }
+
+    async fn send(&self, config: &TelegramConfig, text: &str) -> Result<(), ()> {
+        self.http
+            .send(Destination(&config.bot_token, &config.chat_id), text)
+            .await
+    }
+
+    async fn notify_models(&self, notification: &ModelChangedNotification) -> Result<(), ()> {
+        let Some(config) = self.store.telegram().filter(|config| {
+            config
+                .notifications
+                .contains(&TelegramNotificationKind::ModelChanges)
+        }) else {
+            return Ok(());
+        };
+        let mut text = String::from("Codex model changes");
+        for change in &notification.changes {
+            let (label, slug) = match change {
+                ModelChange::Added { slug } => ("Added: ", slug),
+                ModelChange::Removed { slug } => ("Removed: ", slug),
+            };
+            text.push('\n');
+            text.push_str(label);
+            text.push_str(slug);
+        }
+        self.send(&config, &text).await
+    }
+
+    async fn notify_releases(&self, status: &GithubStatus) -> Result<(), ()> {
+        let mut releases = self.releases.lock().await;
+        let config = self.store.telegram();
+        let stable = self
+            .notify_release(
+                config.as_ref().filter(|config| {
+                    config
+                        .notifications
+                        .contains(&TelegramNotificationKind::CodexRelease)
+                }),
+                &mut releases.stable,
+                status.latest_release.as_ref(),
+                "stable",
+            )
+            .await;
+        let prerelease = self
+            .notify_release(
+                config.as_ref().filter(|config| {
+                    config
+                        .notifications
+                        .contains(&TelegramNotificationKind::CodexPrerelease)
+                }),
+                &mut releases.prerelease,
+                status.latest_prerelease.as_ref(),
+                "prerelease",
+            )
+            .await;
+        stable.and(prerelease)
+    }
+
+    async fn notify_release(
+        &self,
+        config: Option<&TelegramConfig>,
+        baseline: &mut Option<Version>,
+        release: Option<&GithubRelease>,
+        channel: &str,
+    ) -> Result<(), ()> {
+        let Some(release) = release else {
+            return Ok(());
+        };
+        let version = release_version(release);
+        if baseline
+            .as_ref()
+            .is_some_and(|previous| version <= *previous)
+        {
+            return Ok(());
+        }
+        if let (Some(config), Some(previous)) = (config, baseline.as_ref()) {
+            self.send(
+                config,
+                &format!(
+                    "Codex update available\nPrevious: {previous}\nLatest: {version}\nChannel: {channel}\n{}",
+                    release.url,
+                ),
+            )
+            .await?;
+        }
+        *baseline = Some(version);
+        Ok(())
+    }
+}
+
+fn release_version(release: &GithubRelease) -> Version {
+    release
+        .version
+        .parse()
+        .expect("GitHub publishes semantic versions")
+}
+
+fn response(config: Option<TelegramConfig>) -> TelegramCommandResponse {
+    match config {
+        Some(config) => TelegramCommandResponse {
+            configured: true,
+            notifications: config.notifications,
+            message: None,
+        },
+        None => TelegramCommandResponse::default(),
+    }
+}
+
+fn notification_message(value: String) -> Result<String, JSONRPCErrorError> {
+    if value.trim().is_empty() || value.len() > 4096 {
+        return Err(invalid_params("invalid Telegram message"));
+    }
+    Ok(value)
+}
+
+fn disabled() -> JSONRPCErrorError {
+    invalid_params("Telegram is not configured")
+}
+
+fn storage_error(_: std::io::Error) -> JSONRPCErrorError {
+    internal_error("Telegram configuration operation failed")
+}
+
