+#[tokio::test]
+async fn release_channels_are_silent_initially_and_retry_failures_independently() {
+    let home = tempfile::tempdir().unwrap();
+    let selected = [
+        TelegramNotificationKind::CodexRelease,
+        TelegramNotificationKind::CodexPrerelease,
+    ];
+    save(home.path(), &selected).await;
+    let server = MockServer::start().await;
+    Mock::given(method("POST"))
+        .and(path("/bot123:secret/sendMessage"))
+        .respond_with(DeliverySequence(AtomicUsize::new(0)))
+        .expect(3)
+        .mount(&server)
+        .await;
+    let (processor, _models, github) =
+        processor(&server, home.path(), Some(status("1.0.0", "1.1.0-alpha.1")));
+    assert!(server.received_requests().await.unwrap().is_empty());
+    let updated = status("1.1.0", "1.2.0-alpha.1");
+    github.send_replace(Some(updated.clone()));
+    wait_for_requests(&server, 2).await;
+    {
+        let releases = processor.inner.releases.lock().await;
+        assert_eq!(releases.stable, Some(Version::new(1, 0, 0)));
+        assert_eq!(releases.prerelease, Some("1.2.0-alpha.1".parse().unwrap()));
+    }
+    github.send_replace(None);
+    processor
+        .command(TelegramCommandParams::SetNotification {
+            notification: TelegramNotificationKind::ModelChanges,
+            enabled: true,
+        })
+        .await
+        .unwrap();
+    github.send_replace(Some(updated));
+    wait_for_requests(&server, 3).await;
+    assert_eq!(
+        processor.inner.releases.lock().await.stable,
+        Some(Version::new(1, 1, 0))
+    );
+    let requests = server.received_requests().await.unwrap();
+    let messages: Vec<Value> = requests
+        .iter()
+        .map(|request| serde_json::from_slice(&request.body).unwrap())
+        .collect();
+    assert!(
+        messages[0]["text"]
+            .as_str()
+            .unwrap()
+            .contains("Channel: stable")
+    );
+    assert!(
+        messages[1]["text"]
+            .as_str()
+            .unwrap()
+            .contains("Channel: prerelease")
+    );
+    assert!(
+        messages[2]["text"]
+            .as_str()
+            .unwrap()
+            .contains("Channel: stable")
+    );
+}
