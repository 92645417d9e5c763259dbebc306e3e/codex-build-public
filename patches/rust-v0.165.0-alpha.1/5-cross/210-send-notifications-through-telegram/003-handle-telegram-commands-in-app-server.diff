+        .await
+        .unwrap();
+    assert_eq!(
+        processor
+            .command(TelegramCommandParams::Read {})
+            .await
+            .unwrap(),
+        TelegramCommandResponse::default()
+    );
+    let saved = IntegrationsStore::load(home.path()).unwrap();
+    assert!(saved.telegram().is_none());
+    assert_eq!(saved.github().unwrap().token, "retained-github");
