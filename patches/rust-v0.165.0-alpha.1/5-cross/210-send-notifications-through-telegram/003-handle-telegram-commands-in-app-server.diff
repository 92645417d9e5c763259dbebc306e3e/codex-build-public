+#[tokio::test]
+async fn setting_reads_bypass_busy_telegram_rpc_queue_and_mutations_still_wait() -> Result<()> {
+    let home = tempfile::tempdir()?;
+    let config = Arc::new(
+        ConfigBuilder::default()
+            .codex_home(home.path().to_path_buf())
+            .loader_overrides(LoaderOverrides::without_managed_config_for_tests())
+            .build()
+            .await?,
+    );
+    let auth = AuthManager::shared_from_config(config.as_ref(), false).await?;
+    let (processor, mut outgoing) = build_test_processor(config, auth).await;
+    let session = Arc::new(ConnectionSessionState::new(ConnectionOrigin::Stdio));
+    processor
+        .process_request(
+            TEST_CONNECTION_ID,
+            serde_json::from_value(json!({
+                "id": 1, "method": "initialize", "params": {
+                    "clientInfo": {"name": "telegram-settings-test", "version": "1"}
+                }
+            }))?,
+            &AppServerTransport::Stdio,
+            Arc::clone(&session),
+        )
+        .await;
+    let _: InitializeResponse = read_response(&mut outgoing, 1).await;
+
+    let command = ClientRequest::TelegramCommand {
+        request_id: RequestId::Integer(10),
+        params: TelegramCommandParams::Disable {},
+    };
+    let (key, access) = RequestSerializationQueueKey::from_scope(
+        TEST_CONNECTION_ID,
+        command.serialization_scope().expect("serialized mutations"),
+    );
+    let (started_tx, started_rx) = oneshot::channel();
+    let (release_tx, release_rx) = oneshot::channel();
+    processor
+        .request_serialization_queues
+        .enqueue_background(key, access, async move {
+            started_tx.send(()).unwrap();
+            release_rx.await.unwrap();
+        })
+        .await;
+    timeout(Duration::from_secs(1), started_rx).await??;
+    processor
+        .process_request(
+            TEST_CONNECTION_ID,
+            serde_json::from_value(json!({
+                "id": 2, "method": "telegram/command", "params": {"kind": "read"}
+            }))?,
+            &AppServerTransport::Stdio,
+            Arc::clone(&session),
+        )
+        .await;
+    let read: TelegramCommandResponse =
+        timeout(Duration::from_secs(1), read_response(&mut outgoing, 2)).await?;
+    assert_eq!(read, TelegramCommandResponse::default());
+    processor
+        .process_client_request(
+            TEST_CONNECTION_ID,
+            ClientRequest::TelegramCommand {
+                request_id: RequestId::Integer(3),
+                params: TelegramCommandParams::Read {},
+            },
+            Arc::clone(&session),
+            &AtomicBool::new(true),
+            CancellationToken::new(),
+        )
+        .await;
+    let read: TelegramCommandResponse =
+        timeout(Duration::from_secs(1), read_response(&mut outgoing, 3)).await?;
+    assert_eq!(read, TelegramCommandResponse::default());
+    processor
+        .process_request(
+            TEST_CONNECTION_ID,
+            serde_json::from_value(json!({
+                "id": 4, "method": "telegram/command", "params": {"kind": "disable"}
+            }))?,
+            &AppServerTransport::Stdio,
+            session,
+        )
+        .await;
+    assert!(
+        timeout(
+            Duration::from_millis(50),
+            read_response::<TelegramCommandResponse>(&mut outgoing, 4)
+        )
+        .await
+        .is_err()
+    );
+    release_tx.send(()).unwrap();
+    let disabled: TelegramCommandResponse = read_response(&mut outgoing, 4).await;
+    assert_eq!(disabled, TelegramCommandResponse::default());
+    processor.shutdown_threads().await;
+    processor.drain_background_tasks().await;
+    Ok(())
+}
