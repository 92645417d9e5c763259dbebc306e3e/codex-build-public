+async fn setup_selection_duration_and_deduplication_preserve_shared_settings() {
+    let home = tempfile::tempdir().unwrap();
+    std::fs::write(
+        home.path().join("integrations.json"),
+        r#"{"github":{"token":"retained-github","check_interval_hours":20}}"#,
