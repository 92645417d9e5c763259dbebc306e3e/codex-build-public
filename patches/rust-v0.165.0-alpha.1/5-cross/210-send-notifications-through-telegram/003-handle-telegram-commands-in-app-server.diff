+use super::*;
+use codex_app_server_protocol::TelegramSetup;
+use codex_http_client::OutboundProxyPolicy;
+use pretty_assertions::assert_eq;
+use serde_json::Value;
+use serde_json::json;
+use std::collections::BTreeSet;
+use std::path::Path;
+use std::sync::atomic::AtomicUsize;
+use std::sync::atomic::Ordering;
+use std::time::Duration;
+use url::Url;
+use wiremock::Mock;
+use wiremock::MockServer;
+use wiremock::Respond;
+use wiremock::ResponseTemplate;
+use wiremock::matchers::method;
+use wiremock::matchers::path;
+
+fn config(notifications: &[TelegramNotificationKind]) -> TelegramConfig {
+    TelegramConfig {
+        bot_token: "123:secret".into(),
+        chat_id: "chat".into(),
+        notifications: notifications.iter().copied().collect(),
+        completion_min_duration_ms: 30_000,
+    }
+}
+
+fn processor(
+    server: &MockServer,
+    home: &Path,
+    status: Option<GithubStatus>,
+) -> (
+    TelegramProcessor,
+    broadcast::Sender<ModelChangedNotification>,
+    watch::Sender<Option<GithubStatus>>,
+) {
+    let store = Arc::new(IntegrationsStore::load(home).unwrap());
+    let (models, model_events) = broadcast::channel(16);
+    let (github, github_events) = watch::channel(status);
+    let processor = TelegramProcessor::with_http(
+        store,
+        TelegramHttp::with_url(
+            HttpClientFactory::new(OutboundProxyPolicy::ReqwestDefault),
+            Url::parse(&server.uri()).unwrap(),
+        ),
+        model_events,
+        github_events,
+    );
+    (processor, models, github)
+}
+
+async fn save(home: &Path, notifications: &[TelegramNotificationKind]) {
+    Arc::new(IntegrationsStore::load(home).unwrap())
+        .set_telegram(Some(config(notifications)))
+        .await
+        .unwrap();
+}
+
+fn status(stable: &str, prerelease: &str) -> GithubStatus {
+    let release = |version: &str| GithubRelease {
+        version: version.into(),
+        url: format!("https://example.invalid/{version}"),
+    };
+    GithubStatus {
