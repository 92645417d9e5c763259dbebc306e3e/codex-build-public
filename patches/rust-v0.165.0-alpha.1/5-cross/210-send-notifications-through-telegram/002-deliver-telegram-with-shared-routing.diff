+use super::*;
+use codex_http_client::OutboundProxyPolicy;
+use pretty_assertions::assert_eq;
+use serde_json::Value;
+use serde_json::json;
+use wiremock::Mock;
+use wiremock::MockServer;
+use wiremock::ResponseTemplate;
+use wiremock::matchers::method;
+use wiremock::matchers::path;
+
+fn client(server: &MockServer) -> TelegramHttp {
+    TelegramHttp::with_url(
+        HttpClientFactory::new(OutboundProxyPolicy::ReqwestDefault),
+        Url::parse(&server.uri()).expect("mock URL"),
+    )
+}
+
+#[tokio::test]
+async fn telegram_posts_the_selected_destination_and_message() {
+    let server = MockServer::start().await;
+    Mock::given(method("POST"))
+        .and(path("/bot123:secret/sendMessage"))
+        .respond_with(ResponseTemplate::new(200).set_body_json(json!({"ok": true})))
+        .expect(1)
+        .mount(&server)
+        .await;
+    client(&server)
+        .send(Destination("123:secret", "chat-1"), "hello\nworld")
+        .await
+        .expect("Telegram send");
+    let requests = server.received_requests().await.expect("requests");
+    let body: Value = serde_json::from_slice(&requests[0].body).expect("Telegram JSON");
+    assert_eq!(body, json!({"chat_id": "chat-1", "text": "hello\nworld"}));
+}
+
+#[tokio::test]
+async fn secret_bearing_telegram_requests_do_not_follow_redirects() {
+    let server = MockServer::start().await;
+    Mock::given(method("POST"))
+        .and(path("/bot123:secret/sendMessage"))
+        .respond_with(
+            ResponseTemplate::new(307)
+                .insert_header("location", format!("{}/redirected", server.uri())),
+        )
+        .expect(1)
+        .mount(&server)
+        .await;
+    Mock::given(path("/redirected"))
+        .respond_with(ResponseTemplate::new(200).set_body_json(json!({"ok": true})))
+        .expect(0)
+        .mount(&server)
+        .await;
+    assert!(
+        client(&server)
+            .send(Destination("123:secret", "chat"), "notice")
+            .await
+            .is_err()
+    );
+}
+
+#[tokio::test]
+async fn telegram_rejects_oversized_response_bodies() {
+    let server = MockServer::start().await;
+    Mock::given(method("POST"))
+        .and(path("/bot123:secret/sendMessage"))
+        .respond_with(ResponseTemplate::new(200).set_body_json(json!({
+            "ok": true,
+            "padding": "x".repeat(RESPONSE_LIMIT),
+        })))
+        .expect(1)
+        .mount(&server)
+        .await;
+    assert!(
+        client(&server)
+            .send(Destination("123:secret", "chat"), "notice")
+            .await
+            .is_err()
+    );
+}
+
+#[tokio::test]
+async fn telegram_requires_http_and_api_success() {
+    for response in [
+        ResponseTemplate::new(403).set_body_json(json!({"ok": true})),
+        ResponseTemplate::new(200).set_body_json(json!({"ok": false})),
+        ResponseTemplate::new(200).set_body_string("invalid"),
+    ] {
+        let server = MockServer::start().await;
+        Mock::given(method("POST"))
+            .and(path("/bot123:secret/sendMessage"))
+            .respond_with(response)
+            .expect(1)
+            .mount(&server)
+            .await;
+        assert!(
+            client(&server)
+                .send(Destination("123:secret", "chat"), "notice")
+                .await
+                .is_err()
+        );
+    }
+}
