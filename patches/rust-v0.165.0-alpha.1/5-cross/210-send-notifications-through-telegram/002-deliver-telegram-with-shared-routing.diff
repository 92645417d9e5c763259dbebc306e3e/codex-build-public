+use codex_http_client::ClientRouteClass;
+use codex_http_client::HttpClientFactory;
+use codex_http_client::RouteAwareClientPool;
+use serde::Deserialize;
+use serde::Serialize;
+use std::time::Duration;
+use url::Url;
+
+const TIMEOUT: Duration = Duration::from_secs(10);
+const RESPONSE_LIMIT: usize = 4096;
+
+pub(crate) struct TelegramHttp {
+    pool: RouteAwareClientPool,
+    base: Url,
+}
+
+pub(crate) struct Destination<'a>(pub(crate) &'a str, pub(crate) &'a str);
+
+#[derive(Serialize)]
+struct SendMessage<'a> {
+    chat_id: &'a str,
+    text: &'a str,
+}
+
+#[derive(Deserialize)]
+struct SendResult {
+    ok: bool,
+}
+
+impl TelegramHttp {
+    pub(crate) fn new(factory: HttpClientFactory) -> Self {
+        Self {
+            pool: RouteAwareClientPool::new_without_redirects_or_request_logging(
+                factory,
+                ClientRouteClass::Other,
+            ),
+            base: Url::parse("https://api.telegram.org").expect("valid Telegram URL"),
+        }
+    }
+
+    #[cfg(test)]
+    pub(crate) fn with_url(factory: HttpClientFactory, base: Url) -> Self {
+        Self {
+            base,
+            ..Self::new(factory)
+        }
+    }
+
+    pub(crate) async fn send(&self, to: Destination<'_>, text: &str) -> Result<(), ()> {
+        let mut url = self.base.clone();
+        url.path_segments_mut()
+            .map_err(|_| ())?
+            .clear()
+            .push(&format!("bot{}", to.0))
+            .push("sendMessage");
+        let mut response = self
+            .pool
+            .post(url)
+            .timeout(TIMEOUT)
+            .json(&SendMessage {
+                chat_id: to.1,
+                text,
+            })
+            .send()
+            .await
+            .map_err(|_| ())?;
+        if response.status().as_u16() != 200 {
+            return Err(());
+        }
+        let mut body = Vec::new();
+        while let Some(chunk) = response.chunk().await.map_err(|_| ())? {
+            if chunk.len() > RESPONSE_LIMIT.saturating_sub(body.len()) {
+                return Err(());
+            }
+            body.extend_from_slice(&chunk);
+        }
+        let result: SendResult = serde_json::from_slice(&body).map_err(|_| ())?;
+        result.ok.then_some(()).ok_or(())
+    }
+}
