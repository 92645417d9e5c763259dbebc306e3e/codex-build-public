+#[tokio::test]
+async fn model_request_hooks_inherit_the_captured_local_environment() -> Result<()> {
+    skip_if_no_network!(Ok(()));
+    let server = start_mock_server().await;
+    mount_sse_once(&server, responses::sse_completed("complete")).await;
+    let test = test_codex()
+        .with_pre_build_hook(|home| {
+            let mut hooks = serde_json::Map::new();
+            for event in ["PreModelRequest", "PostModelRequest"] {
+                let output = home.join(format!("{event}.env"));
+                hooks.insert(
+                    event.into(),
+                    json!([{"hooks": [{
+                        "type": "command",
+                        "command": format!("env > '{}'", output.display()),
+                    }]}]),
+                );
+            }
+            fs::write(home.join("hooks.json"), json!({"hooks": hooks}).to_string())
+                .expect("write model request hooks");
+        })
+        .with_config(trust_discovered_hooks)
+        .build(&server)
+        .await?;
+    let mut local = core_test_support::test_codex::local(test.config.cwd.clone());
+    let mut config =
+        core_test_support::test_codex::environment_config_for_selection(&test.config, &local);
+    let expected = [
+        "PROJECT_SCRATCH_ROOT",
+        "PROJECT_RUNTIME_ROOT",
+        "PROJECT_PERSISTENT_ROOT",
+        "REPOS_ROOT",
+        "SKILLS_ROOT",
+        "SKILLS_SCRATCH_ROOT",
+    ]
+    .into_iter()
+    .map(|name| {
+        let root = test.codex_home_path().join("local-roots").join(name);
+        fs::create_dir_all(&root)?;
+        Ok((name.to_owned(), root.to_string_lossy().into_owned()))
+    })
+    .collect::<Result<HashMap<_, _>>>()?;
+    config.shell_environment_policy.inherited_environment = expected.clone();
+    local.config = codex_protocol::protocol::EnvironmentConfigState::Ready(config);
+    test.submit_turn_with_environments("respond", Some(vec![local]))
+        .await?;
+    for event in ["PreModelRequest", "PostModelRequest"] {
+        let environment = fs::read_to_string(test.codex_home_path().join(format!("{event}.env")))?;
+        for (name, value) in &expected {
+            assert!(
+                environment
+                    .lines()
+                    .any(|line| line == format!("{name}={value}")),
+                "{event} did not inherit {name}={value}"
+            );
+        }
+    }
+    Ok(())
+}
