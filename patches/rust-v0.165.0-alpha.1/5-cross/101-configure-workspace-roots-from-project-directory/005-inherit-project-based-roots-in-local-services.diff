+#[test]
+fn scoped_stdio_variables_preserve_explicit_and_remote_sources() {
+    let config: McpServerConfig = serde_json::from_value(serde_json::json!({
+        "command": "server",
+        "env": { "PROJECT_RUNTIME_ROOT": "/explicit/runtime" },
+        "env_vars": [
+            "PROJECT_SCRATCH_ROOT",
+            "PROJECT_RUNTIME_ROOT",
+            { "name": "PROJECT_PERSISTENT_ROOT", "source": "remote" }
+        ]
+    }))
+    .unwrap();
+    let roots = std::collections::HashMap::from([
+        ("PROJECT_SCRATCH_ROOT".into(), "/first/scratch".into()),
+        ("PROJECT_RUNTIME_ROOT".into(), "/first/runtime".into()),
+        ("PROJECT_PERSISTENT_ROOT".into(), "/first/persistent".into()),
+        ("SKILLS_ROOT".into(), "/unrequested/skills".into()),
+    ]);
+    let first =
+        EffectiveMcpServer::from_host_config(config.clone()).with_local_process_environment(&roots);
+    let codex_config::McpServerTransportConfig::Stdio { env, .. } = &first.config().transport
+    else {
+        panic!("stdio configuration");
+    };
+    assert_eq!(
+        env.as_ref().unwrap(),
+        &std::collections::HashMap::from([
+            ("PROJECT_SCRATCH_ROOT".into(), "/first/scratch".into()),
+            ("PROJECT_RUNTIME_ROOT".into(), "/explicit/runtime".into()),
+        ])
+    );
+    let next = EffectiveMcpServer::from_host_config(config).with_local_process_environment(
+        &std::collections::HashMap::from([("PROJECT_SCRATCH_ROOT".into(), "/next/scratch".into())]),
+    );
+    let runtime = runtime_context();
+    assert!(
+        !connection_identity(&first, &runtime)
+            .has_same_connection_config(&connection_identity(&next, &runtime))
+    );
+}
