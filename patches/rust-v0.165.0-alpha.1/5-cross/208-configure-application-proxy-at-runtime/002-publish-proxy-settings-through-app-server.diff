diff --git a/codex-rs/app-server-protocol/src/protocol/v2/proxy.rs b/codex-rs/app-server-protocol/src/protocol/v2/proxy.rs
new file mode 100644
--- /dev/null
+++ b/codex-rs/app-server-protocol/src/protocol/v2/proxy.rs
@@ -0,0 +1,106 @@
+use crate::JsonSchema;
+use crate::ProxyConfig;
+use crate::TS;
+use serde::Deserialize;
+use serde::Serialize;
+
+#[derive(Clone, Debug, Deserialize, Eq, JsonSchema, PartialEq, Serialize, TS)]
+#[serde(rename_all = "camelCase")]
+#[ts(export_to = "v2/")]
+pub struct ProxyReadResponse {
+    pub config: ProxyConfig,
+    pub generation: u64,
+    pub active_alias: Option<String>,
+    pub active_address: Option<String>,
+}
+
+#[derive(Clone, Debug, Deserialize, Eq, JsonSchema, PartialEq, Serialize, TS)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+#[ts(export_to = "v2/")]
+pub struct ProxyWriteParams {
+    pub config: ProxyConfig,
+}
+
+#[derive(Clone, Debug, Deserialize, Eq, JsonSchema, PartialEq, Serialize, TS)]
+#[serde(rename_all = "camelCase")]
+#[ts(export_to = "v2/")]
+pub struct ProxyWriteResponse {
+    pub config: ProxyConfig,
+    pub generation: u64,
+    pub active_alias: Option<String>,
+    pub active_address: Option<String>,
+}
+
+#[derive(Clone, Debug, Deserialize, Eq, JsonSchema, PartialEq, Serialize, TS)]
+#[serde(rename_all = "camelCase")]
+#[ts(export_to = "v2/")]
+pub struct ProxyUpdatedNotification {
+    pub generation: u64,
+    pub active_alias: Option<String>,
+    pub active_address: Option<String>,
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::ClientRequest;
+    use crate::ProxyDefinition;
+    use crate::RequestId;
+    use crate::ServerNotification;
+    use pretty_assertions::assert_eq;
+    use serde_json::json;
+
+    #[test]
+    fn proxy_wire_uses_declared_methods_and_redacts_credentials_in_debug() {
+        let config = ProxyConfig {
+            enabled: true,
+            selected: Some("lan".to_string()),
+            entries: vec![ProxyDefinition {
+                alias: "lan".to_string(),
+                url: "https://user:secret@proxy.test:8443".to_string(),
+            }],
+        };
+        assert!(!format!("{config:?}").contains("secret"));
+        let request = ClientRequest::ProxyWrite {
+            request_id: RequestId::Integer(7),
+            params: ProxyWriteParams {
+                config: config.clone(),
+            },
+        };
+        assert_eq!(
+            serde_json::to_value(request).expect("write request"),
+            json!({
+                "id": 7, "method": "proxy/write", "params": {"config": config}
+            })
+        );
+        let read = ClientRequest::ProxyRead {
+            request_id: RequestId::Integer(8),
+            params: None,
+        };
+        assert_eq!(
+            serde_json::to_value(read).expect("read request"),
+            json!({
+                "id": 8, "method": "proxy/read"
+            })
+        );
+        let notification = ServerNotification::ProxyUpdated(ProxyUpdatedNotification {
+            generation: 3,
+            active_alias: Some("lan".to_string()),
+            active_address: Some("proxy.test:8443".to_string()),
+        });
+        assert_eq!(
+            serde_json::to_value(notification).expect("notification"),
+            json!({
+                "method": "proxy/updated", "params": {
+                    "generation": 3, "activeAlias": "lan", "activeAddress": "proxy.test:8443"
+                }
+            })
+        );
+        assert!(
+            serde_json::from_value::<ProxyWriteParams>(json!({
+                "config": config, "unexpected": true
+            }))
+            .is_err()
+        );
+    }
+}
