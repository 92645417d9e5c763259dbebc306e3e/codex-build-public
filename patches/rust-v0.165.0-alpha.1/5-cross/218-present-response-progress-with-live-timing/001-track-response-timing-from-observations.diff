+use super::*;
+use codex_app_server_protocol::ResponseAttemptsReadResponse;
+use codex_protocol::ThreadId;
+use codex_protocol::response_metrics::ResponseAttemptEnd;
+use codex_protocol::response_metrics::ResponseTokenCounts;
+use pretty_assertions::assert_eq;
+use std::time::Duration;
+use uuid::Uuid;
+
+pub(crate) fn attempt(id: u64, end: Option<ResponseAttemptEnd>) -> ResponseAttempt {
+    ResponseAttempt {
+        attempt_id: Uuid::from_u128(u128::from(id)),
+        revision: id * 10,
+        thread_id: Some(ThreadId::try_from(Uuid::from_u128(1).to_string()).unwrap()),
+        turn_id: Some("turn-1".into()),
+        response_id: None,
+        request_kind: "generation".into(),
+        requested_model: "gpt-5.4".into(),
+        served_model: None,
+        reasoning_effort: Some("high".into()),
+        started_at: 1_700_000_000,
+        ttfb_ms: Some(300),
+        ttfc_ms: Some(400),
+        terminal_observed_offset_ms: end.map(|_| 2000),
+        elapsed_ms: 2100,
+        sent_payload_bytes: None,
+        received_payload_bytes: 500,
+        end_reason: end,
+        tokens: if end.is_some() {
+            ResponseTokenCounts {
+                input: Some(1000),
+                cache_read: Some(400),
+                cache_write: Some(100),
+                output: Some(100),
+                reasoning: Some(50),
+            }
+        } else {
+            ResponseTokenCounts::default()
+        },
+        tps: end.map(|_| 50.0),
+    }
+}
+
+pub(crate) fn page(rows: Vec<ResponseAttempt>) -> ResponseAttemptsReadResponse {
+    ResponseAttemptsReadResponse {
+        last_generation: None,
+        active_attempt_ids: rows
+            .iter()
+            .filter(|row| row.end_reason.is_none() && row.terminal_observed_offset_ms.is_none())
+            .map(|row| row.attempt_id)
+            .collect(),
+        models: rows
+            .iter()
+            .map(|row| row.requested_model.clone())
+            .collect::<std::collections::BTreeSet<_>>()
+            .into_iter()
+            .collect(),
+        data: rows,
+        next_cursor: None,
+        persistence_error: None,
+        last_persistence_error: None,
+    }
+}
+
+#[test]
+fn live_clock_is_monotonic_and_receipt_freezes_before_output_delivery() {
+    let start = Instant::now();
+    let mut observed = ObservedResponse::new(attempt(1, None), true, start);
+    assert!(observed.is_receiving());
+    assert_eq!(observed.progress().receive_label(), "Received 0.5KiB");
+    let later = start + Duration::from_secs(5);
+    assert_eq!(observed.elapsed_ms(later), 7100);
+    let mut update = attempt(1, None);
+    update.revision += 1;
+    update.elapsed_ms = 6000;
+    observed.update(ObservedResponse::new(update.clone(), true, later));
+    assert_eq!(observed.elapsed_ms(later), 7100);
+    update.revision += 1;
+    update.terminal_observed_offset_ms = Some(2500);
+    update.elapsed_ms = 2600;
+    observed.update(ObservedResponse::new(update, true, later));
+    assert!(!observed.is_running());
+    assert_eq!(observed.elapsed_ms(later + Duration::from_secs(100)), 2600);
+    observed.update(ObservedResponse::new(attempt(1, None), true, later));
+    assert!(!observed.is_running());
+    let historical = ObservedResponse::new(attempt(2, None), false, start);
+    assert_eq!(historical.elapsed_ms(later), 2100);
+}
+
+#[test]
+fn scalar_performance_formatters_preserve_precision_and_optional_values() {
+    for (ttfc, rate, expected_ttfc, expected_tps) in [
+        (Some(10), Some(0.1), Some("0.01s"), Some("0.1")),
+        (Some(1279), Some(123.456), Some("1.28s"), Some("123.5")),
+        (Some(0), Some(0.0), Some("0.00s"), Some("0.0")),
+        (None, Some(0.0), None, Some("0.0")),
+        (Some(0), None, Some("0.00s"), None),
+        (None, None, None, None),
+    ] {
+        assert_eq!(ttfc.map(seconds).as_deref(), expected_ttfc);
+        assert_eq!(rate.map(tps).as_deref(), expected_tps);
+    }
+}
+
+#[test]
+fn stale_pages_cannot_stop_newer_live_observations() {
+    let requested = Instant::now();
+    let received = requested + Duration::from_secs(1);
+    let mut view = ResponseTiming::default();
+    view.update(attempt(1, None), true, received);
+    view.snapshot(attempt(1, None), false, requested, received);
+    assert!(view.latest().unwrap().is_running());
+    let refreshed = received + Duration::from_secs(1);
+    view.snapshot(attempt(1, None), false, refreshed, refreshed);
+    assert!(!view.latest().unwrap().is_running());
+    assert_eq!(
+        view.latest()
+            .unwrap()
+            .elapsed_ms(refreshed + Duration::from_secs(60)),
+        2100
+    );
+}
