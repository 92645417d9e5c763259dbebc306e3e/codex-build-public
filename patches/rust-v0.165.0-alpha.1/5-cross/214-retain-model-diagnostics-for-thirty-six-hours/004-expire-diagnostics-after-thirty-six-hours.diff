+#[tokio::test]
+async fn keeps_the_full_thirty_six_hour_window() {
+    let ages = [0, 36 * 60 * 60, 36 * 60 * 60 + 1];
+    let (pool, directory) = database_with_logs(&ages).await;
+    for age in ages {
+        insert_response(&pool, NOW - age).await;
+    }
+    prune_diagnostics(&pool, NOW).await.unwrap();
+    assert_eq!(retained_ages(&pool).await, vec![0, 36 * 60 * 60]);
+    let response_ages: Vec<i64> =
+        sqlx::query_scalar("SELECT ? - started_at FROM responses ORDER BY started_at DESC")
+            .bind(NOW)
+            .fetch_all(&pool)
+            .await
+            .unwrap();
+    assert_eq!(response_ages, vec![0, 36 * 60 * 60]);
+    pool.close().await;
+    tokio::fs::remove_dir_all(directory).await.unwrap();
+}
