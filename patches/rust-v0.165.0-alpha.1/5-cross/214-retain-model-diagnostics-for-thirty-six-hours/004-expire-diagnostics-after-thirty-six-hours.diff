+async fn prune_diagnostics(pool: &SqlitePool, now: i64) -> anyhow::Result<()> {
+    prune_logs(pool, now).await?;
+    sqlx::query("DELETE FROM responses WHERE started_at < ?")
+        .bind(now.saturating_sub(DIAGNOSTIC_RETENTION_SECONDS))
+        .execute(pool)
+        .await?;
+    Ok(())
+}
+
+async fn prune_logs(pool: &SqlitePool, now: i64) -> anyhow::Result<()> {
+    sqlx::query("DELETE FROM logs WHERE ts < ?")
+        .bind(now.saturating_sub(DIAGNOSTIC_RETENTION_SECONDS))
+        .execute(pool)
+        .await?;
+    if LOG_RETENTION_CAPS_ENABLED {
+        prune_by_age_and_size(pool, now, LOG_DATABASE_BUDGET_BYTES).await?;
+    }
+    Ok(())
+}
