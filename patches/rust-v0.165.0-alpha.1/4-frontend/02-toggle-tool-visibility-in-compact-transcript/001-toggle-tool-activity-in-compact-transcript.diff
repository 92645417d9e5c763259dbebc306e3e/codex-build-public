+fn compact_tool_toggle_keeps_detailed_source_and_releases_held_layout() {
+    let cells: Vec<Arc<dyn HistoryCell>> = vec![Arc::new(Cell {
+        hideable: true,
+        mutable: true,
+        ..Cell::default()
+    })];
+    let mut view = TranscriptView::default();
+    assert!(view.current_layout(&cells, 0).unwrap().text().is_empty());
+    view.toggle_tool_calls_visible();
+    let shown = view.current_layout(&cells, 0).unwrap();
+    assert_eq!(shown.text(), "tick 0");
+    let key = EntryKey::cell(&cells[0]);
+    let mut snapshot = view.capture_snapshot(&cells);
+    snapshot.pinned.insert(key, shown);
+    view.held_reading = Some(snapshot);
+    assert_eq!(view.layout(&cells, 0).unwrap().text(), "tick 0");
+    view.toggle_tool_calls_visible();
+    assert!(view.held_reading.is_none());
+    assert!(view.layout(&cells, 0).unwrap().text().is_empty());
+    view.toggle_tool_calls_visible();
+    let area = Rect::new(0, 0, 32, 6);
+    view.render(area, &mut Buffer::empty(area), &cells);
+    assert!(view.begin_select_mode(&cells));
+    assert!(view.has_active_interaction());
+    view.toggle_tool_calls_visible();
+    assert!(!view.has_active_interaction());
+    assert!(view.held_reading.is_none());
+    assert!(view.layout(&cells, 0).unwrap().text().is_empty());
+    view.set_presentation(/*detailed*/ true, HistoryRenderMode::Rich);
+    assert_eq!(view.current_layout(&cells, 0).unwrap().text(), "tick 0");
+    view.set_presentation(/*detailed*/ false, HistoryRenderMode::Rich);
+    view.begin_search();
+    assert!(view.current_layout(&cells, 0).unwrap().text().is_empty());
+    assert_eq!(
+        view.entry_layout(&cells, 0, /*full_content*/ true)
