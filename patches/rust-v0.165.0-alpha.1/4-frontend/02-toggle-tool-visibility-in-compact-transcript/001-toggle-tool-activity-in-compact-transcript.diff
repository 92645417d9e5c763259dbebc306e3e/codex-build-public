+#[tokio::test]
+async fn visible_warning_preserves_status_refresh_and_resize_without_duplicate_diagnostics()
+-> Result<()> {
+    let (mut app, mut app_server, mut tui, thread_id, request_id) =
+        app_with_pending_thread_usage().await?;
+    // TUI preferences survive a launch without alternate-screen ownership.
+    // A visible warning is intervening history, not an invisible status-tail fixture.
+    assert!(app.local_settings.tui.fullscreen_transcript);
+    assert!(!tui.is_owned_screen());
+    let status = Arc::clone(app.transcript_cells.last().expect("status card"));
+    let original = app
+        .last_thread_usage_status_cell
+        .as_ref()
+        .expect("tracked status")
+        .lines
+        .clone();
+    let message = "diagnostic\nRemediation details";
+    app.insert_history_cell(
+        &mut tui,
+        Box::new(history_cell::new_warning_event(message.into())),
+    );
+    let warning = Arc::clone(app.transcript_cells.last().expect("retained warning"));
+    let entries = history_cell::warning_entries(&app.transcript_cells);
+    assert_eq!(entries.len(), 1);
+    assert_eq!(entries[0].details, message);
+    assert_eq!(warning.display_lines(80), warning.transcript_lines(80));
+    assert_eq!(warning.live_raw_lines(), warning.raw_lines());
+    assert!(!warning.is_hideable_tool_call());
+    assert!(pending_history_text(&tui).contains("! diagnostic"));
+
+    let screen_size = Size::new(/*width*/ 52, /*height*/ 24);
+    tui.terminal.last_known_screen_size = screen_size;
+    let viewport = Rect::new(0, 21, screen_size.width, 3);
+    tui.terminal.set_viewport_area(viewport);
+    app.reflow_transcript_now(&mut tui, screen_size.into())?;
+    let resized = &app
+        .last_thread_usage_status_cell
+        .as_ref()
+        .expect("rebased status")
+        .lines;
+    assert_ne!(&original, resized);
+    assert!(Arc::ptr_eq(
+        &warning,
+        &app.last_rendered_history_tail
+            .as_ref()
+            .expect("warning remains the rendered tail")
+            .cell
+            .upgrade()
+            .unwrap()
+    ));
+    assert_eq!(
+        history_cell::warning_entries(&app.transcript_cells),
+        entries
+    );
+    assert_eq!(
+        pending_history_text(&tui).matches("! diagnostic").count(),
+        1
+    );
+
+    // Model the settled viewport after native replay, as in the unobstructed tail test.
+    tui.terminal.set_viewport_area(viewport);
+    app.handle_event(
+        &mut tui,
+        &mut app_server,
+        successful_thread_usage(thread_id, request_id),
+    )
+    .await?;
+    let pending = pending_history_text(&tui);
+    assert_eq!(pending.matches("50 credits").count(), 1, "{pending}");
+    assert_eq!(pending.matches("! diagnostic").count(), 1, "{pending}");
+    assert_eq!(app.transcript_cells.len(), 2);
+    assert!(Arc::ptr_eq(&warning, &app.transcript_cells[1]));
+    assert_eq!(
+        history_cell::warning_entries(&app.transcript_cells),
+        entries
+    );
+    assert!(lines_to_single_string(&status.display_lines(52)).contains("50 credits"));
+    assert!(!app.transcript_reflow.has_pending_reflow());
+    app_server.shutdown().await?;
+    Ok(())
+}
