+/// Resolve the configured editor command, falling back to `VISUAL` then `EDITOR`.
+pub(crate) fn resolve_editor_command(
+    configured: Option<&str>,
+) -> std::result::Result<Vec<String>, EditorError> {
+    let environment_command;
+    let raw = match configured {
+        Some(raw) => raw,
+        None => {
+            environment_command = env::var("VISUAL")
+                .or_else(|_| env::var("EDITOR"))
+                .map_err(|_| EditorError::MissingEditor)?;
+            environment_command.as_str()
         }
     };
+    let parts = shlex::split(raw).ok_or(EditorError::ParseFailed)?;
     if parts.is_empty() {
         return Err(EditorError::EmptyCommand);
     }
