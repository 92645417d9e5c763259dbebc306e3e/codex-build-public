+#[tokio::test]
+async fn account_credit_balance_uses_only_the_status_account_read() {
+    let (mut chat, _rx, _ops) = make_chatwidget_manual(/*model_override*/ None).await;
+    chat.local_settings.tui.status_line = Some(vec!["credit-balance".into()]);
+    let mut other = credit_balance_snapshot(Some("999"), true, false);
+    other.limit_id = Some("other-model".into());
+    chat.on_rate_limit_snapshot(Some(other));
+    assert!(chat.bottom_pane.status_line_text().is_none());
+    assert_eq!(
+        status_preview_line(&mut chat, &[StatusLineItem::CreditBalance]),
+        "13 credits"
+    );
+    chat.on_rate_limit_snapshot(Some(credit_balance_snapshot(Some("12.5"), true, false)));
+    chat.on_rolling_rate_limit_snapshot(credit_balance_snapshot(Some("3"), true, false));
+    assert_eq!(
+        chat.bottom_pane.status_line_text().as_deref(),
+        Some("13 credits")
+    );
+    assert_eq!(
+        status_preview_line(&mut chat, &[StatusLineItem::CreditBalance]),
+        "13 credits"
+    );
+    let mut missing = credit_balance_snapshot(None, true, false);
+    missing.credits = None;
+    chat.on_rate_limit_snapshot(Some(missing));
+    assert!(chat.bottom_pane.status_line_text().is_none());
+    assert_eq!(
+        status_preview_line(&mut chat, &[StatusLineItem::CreditBalance]),
+        "13 credits"
+    );
