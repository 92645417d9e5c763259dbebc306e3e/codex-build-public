+#[tokio::test]
+async fn account_credit_balance_respects_defaults_and_explicit_selection_without_queries() {
+    let (mut chat, mut rx, mut ops) = make_chatwidget_manual(/*model_override*/ None).await;
+    chat.thread_id = Some(ThreadId::new());
+    chat.has_codex_backend_auth = true;
+    chat.plan_type = Some(PlanType::Business);
+    chat.local_settings.tui.status_line = None;
+    assert!(
+        chat.configured_status_line_items()
+            .contains(&"credit-balance".to_string())
+    );
+    chat.on_rate_limit_snapshot(Some(credit_balance_snapshot(Some("12.5"), true, false)));
+    assert!(
+        chat.bottom_pane
+            .status_line_text()
+            .expect("default status line")
+            .contains("13 credits")
+    );
+    for _ in 0..3 {
+        chat.refresh_status_surfaces();
+        chat.status_surface_preview_data();
+        chat.refresh_thread_usage_if_settlement_due();
+    }
+    for configured in [vec!["current-dir".to_string()], Vec::new()] {
+        chat.local_settings.tui.status_line = Some(configured.clone());
+        assert_eq!(chat.configured_status_line_items(), configured);
+        chat.refresh_status_line();
+        assert!(
+            !chat
+                .bottom_pane
+                .status_line_text()
+                .is_some_and(|line| line.contains("credits"))
+        );
+    }
+    assert!(chat.bottom_pane.status_line_text().is_none());
+    assert!(ops.try_recv().is_err());
+    while let Ok(event) = rx.try_recv() {
+        assert!(!matches!(
+            event,
+            AppEvent::RefreshThreadUsage { .. }
+                | AppEvent::RefreshRateLimits { .. }
+                | AppEvent::CodexOp(_)
+        ));
+    }
+}
