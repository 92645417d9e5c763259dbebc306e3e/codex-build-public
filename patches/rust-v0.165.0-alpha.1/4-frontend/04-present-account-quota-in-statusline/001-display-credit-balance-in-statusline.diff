+fn credit_balance_snapshot(
+    balance: Option<&str>,
+    has_credits: bool,
+    unlimited: bool,
+) -> RateLimitSnapshot {
+    RateLimitSnapshot {
+        limit_id: None,
+        limit_name: None,
+        normal_model_slug: None,
+        primary: None,
+        secondary: None,
+        credits: Some(codex_app_server_protocol::CreditsSnapshot {
+            has_credits,
+            unlimited,
+            balance: balance.map(str::to_string),
+        }),
+        individual_limit: None,
+        spend_control_reached: None,
+        plan_type: None,
+        rate_limit_reached_type: None,
+    }
+}
+
+#[tokio::test]
+async fn account_credit_balance_preview_uses_examples_or_live_values() {
+    for fullscreen in [false, true] {
+        let (mut chat, _rx, _ops) = make_chatwidget_manual(/*model_override*/ None).await;
+        chat.local_settings.tui.fullscreen_transcript = fullscreen;
+        chat.local_settings.tui.status_line = Some(vec!["credit-balance".into()]);
+        assert_eq!(
+            status_preview_line(&mut chat, &[StatusLineItem::CreditBalance]),
+            "13 credits"
+        );
+        for (balance, has_credits, unlimited, expected) in [
+            (Some("12.5"), true, false, Some("13 credits")),
+            (Some(" 12.4 "), true, false, Some("12 credits")),
+            (Some("1000"), true, false, Some("1000 credits")),
+            (
+                Some("9223372036854775807"),
+                true,
+                false,
+                Some("9223372036854775807 credits"),
+            ),
+            (Some("0.4"), true, false, Some("0 credits")),
+            (None, true, false, Some("Available")),
+            (Some("-1"), true, false, Some("Available")),
+            (Some("NaN"), true, false, Some("Available")),
+            (None, true, true, Some("Unlimited")),
+            (None, false, true, Some("Unlimited")),
+            (Some("80"), false, false, None),
+        ] {
+            chat.on_rate_limit_snapshot(Some(credit_balance_snapshot(
+                balance,
+                has_credits,
+                unlimited,
+            )));
+            for colors in [false, true] {
+                chat.local_settings.tui.status_line_use_colors = colors;
+                chat.refresh_status_line();
+                assert_eq!(chat.bottom_pane.status_line_text().as_deref(), expected);
+                let preview = chat
+                    .status_surface_preview_data()
+                    .status_line_for_items([StatusLineItem::CreditBalance], colors);
+                let live = crate::bottom_pane::status_line_from_segments(
+                    chat.status_line_value_for_item(StatusLineItem::CreditBalance)
+                        .map(|value| (StatusLineItem::CreditBalance, value)),
+                    colors,
+                    chat.thread_id,
+                    crate::bottom_pane::StatusLineDetails::default(),
+                );
+                if expected.is_some() {
+                    assert_eq!(preview, live);
+                } else {
+                    assert!(live.is_none());
+                    assert_eq!(preview.map(line_text), Some("13 credits".to_string()));
+                }
+            }
+            chat.add_status_output(
+                /*refreshing_rate_limits*/ false, /*request_id*/ None,
+            );
+            let status = chat
+                .transcript
+                .last_status_copy_targets
+                .as_ref()
+                .expect("status copy source")
+                .handle
+                .copy_text();
+            let credit_row = status.lines().find(|line| line.contains("Credits:"));
+            match expected {
+                Some(value) => assert!(
+                    credit_row
+                        .expect("account credits in /status")
+                        .contains(value)
+                ),
+                None => assert!(credit_row.is_none()),
+            }
+        }
+        chat.on_rate_limit_snapshot(None);
+        assert!(chat.bottom_pane.status_line_text().is_none());
+        assert_eq!(
+            status_preview_line(&mut chat, &[StatusLineItem::CreditBalance]),
+            "13 credits"
+        );
+    }
+}
